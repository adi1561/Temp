import React, { useState, useRef, useEffect } from "react";
import {
  Box, Button, Typography, CircularProgress, Table, TableBody,
  TableCell, TableContainer, TableHead, TableRow, Paper,
  TablePagination, Dialog, DialogTitle, DialogContent, IconButton,
  Tooltip, DialogActions, Chip, Divider, Stack, useTheme
} from "@mui/material";
import {
  PlayArrow as PlayArrowIcon,
  Close as CloseIcon,
  Assessment as SummaryIcon,
  Replay as RetryIcon,
  Visibility as ViewIcon,
  CheckCircle as SuccessIcon,
  Error as FailedIcon,
  Schedule as PendingIcon,
  InfoOutlined as InfoIcon
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const TRIGGER_API_URL = "/PS/airflow/trigger";
const INITIAL_DATA_URL = "/PS/process/processes/data/7";
const SUMMARY_BASE_URL = "/CM/lho-transfers/summary/";

export default function TransferDataLho() {
  const theme = useTheme();
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  // Table & Pagination
  const [tableData, setTableData] = useState([]);
  const [isInitialLoading, setIsInitialLoading] = useState(true);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  // Dialogs
  const [summaryOpen, setSummaryOpen] = useState(false);
  const [summaryData, setSummaryData] = useState([]);
  const [summaryLoading, setSummaryLoading] = useState(false);
  
  // Stages Feature
  const [stagesOpen, setStagesOpen] = useState(false);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [activeStage, setActiveStage] = useState(null);

  const fetchInitialData = async () => {
    setIsInitialLoading(true);
    try {
      const response = await callApi(INITIAL_DATA_URL, null, "GET");
      if (isMounted.current && response && response.initialData) {
        setTableData(response.initialData.map(item => ({ 
          ...item, 
          isLatest: true, 
          runVersion: item.runId || 1 
        })));
      }
    } catch (error) {
      showSnackBar("Failed to load process data", "error");
    } finally {
      if (isMounted.current) setIsInitialLoading(false);
    }
  };

  useEffect(() => {
    isMounted.current = true;
    fetchInitialData();
    return () => { isMounted.current = false; };
  }, []);

  const handleOpenStages = (process) => {
    setSelectedProcess(process);
    setActiveStage(process.stages?.[0] || null);
    setStagesOpen(true);
  };

  const getStatusChip = (status) => {
    switch (status) {
      case 1: return <Chip label="In Progress" color="primary" variant="outlined" size="small" />;
      case 2: return <Chip label="Success" color="success" size="small" />;
      case 3: return <Chip label="Fail" color="error" size="small" />;
      default: return <Chip label="Unknown" variant="outlined" size="small" />;
    }
  };

  return (
    <Box p={3}>
      <TableContainer component={Paper} elevation={2}>
        <Table>
          <TableHead>
            <TableRow sx={{ bgcolor: theme.palette.action.hover }}>
              <TableCell align="center"><strong>Process Run ID</strong></TableCell>
              <TableCell align="center"><strong>Stage Status</strong></TableCell>
              <TableCell align="center"><strong>Process ID</strong></TableCell>
              <TableCell align="center"><strong>ETL Date</strong></TableCell>
              <TableCell align="center"><strong>Process Type</strong></TableCell>
              <TableCell align="center"><strong>Action</strong></TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {tableData.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage).map((row) => (
              <TableRow key={row.processRunId} hover>
                <TableCell align="center">{row.processRunId}</TableCell>
                <TableCell align="center">{getStatusChip(row.status)}</TableCell>
                <TableCell align="center">{row.processId}</TableCell>
                <TableCell align="center">{row.etlDate}</TableCell>
                <TableCell align="center">{row.processType}</TableCell>
                <TableCell align="center">
                  <Stack direction="row" spacing={1} justifyContent="center">
                    <Tooltip title="View Details">
                      <IconButton size="small" onClick={() => handleOpenStages(row)} color="primary">
                        <ViewIcon />
                      </IconButton>
                    </Tooltip>
                    <Tooltip title="Get Summary">
                      <span>
                        <IconButton size="small" disabled={row.status !== 2}>
                          <SummaryIcon />
                        </IconButton>
                      </span>
                    </Tooltip>
                    <Tooltip title="Retry">
                      <span>
                        <IconButton size="small" disabled={!row.isLatest || row.status === 1}>
                          <RetryIcon />
                        </IconButton>
                      </span>
                    </Tooltip>
                  </Stack>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ---------------- STAGES DIALOG (VERTICAL TIMELINE) ---------------- */}
      <Dialog 
        open={stagesOpen} 
        onClose={() => setStagesOpen(false)} 
        maxWidth="md" 
        fullWidth
        PaperProps={{ sx: { borderRadius: 2 } }}
      >
        <DialogTitle sx={{ 
          m: 0, p: 2, 
          display: 'flex', 
          justifyContent: 'space-between', 
          alignItems: 'center',
          borderBottom: `1px solid ${theme.palette.divider}`
        }}>
          <Typography variant="h6" fontWeight="600">
            Transfer To LHO – Process Details
          </Typography>
          <IconButton onClick={() => setStagesOpen(false)} size="small">
            <CloseIcon />
          </IconButton>
        </DialogTitle>

        <DialogContent sx={{ p: 0, display: 'flex', height: '60vh' }}>
          {/* LEFT SIDE: SCROLLABLE STAGES LIST */}
          <Box sx={{ 
            width: '40%', 
            borderRight: `1px solid ${theme.palette.divider}`,
            overflowY: 'auto',
            bgcolor: theme.palette.action.hover,
            p: 2
          }}>
            <Stack spacing={0}>
              {selectedProcess?.stages?.map((stage, idx) => (
                <Box 
                  key={stage.stageId} 
                  onClick={() => setActiveStage(stage)}
                  sx={{ 
                    display: 'flex', 
                    position: 'relative', 
                    pb: 3, 
                    cursor: 'pointer',
                    '&:hover': { opacity: 0.8 }
                  }}
                >
                  {/* Timeline Connector Line */}
                  {idx !== selectedProcess.stages.length - 1 && (
                    <Box sx={{ 
                      position: 'absolute', 
                      left: 11, top: 24, bottom: 0, 
                      width: '2px', 
                      bgcolor: theme.palette.divider 
                    }} />
                  )}
                  
                  {/* Status Icon */}
                  <Box sx={{ mr: 2, zIndex: 1, bgcolor: theme.palette.action.hover }}>
                    {stage.stageStatus === 2 ? <SuccessIcon color="success" fontSize="small" /> : 
                     stage.stageStatus === 3 ? <FailedIcon color="error" fontSize="small" /> : 
                     <PendingIcon color="primary" fontSize="small" />}
                  </Box>

                  {/* Stage Label */}
                  <Box sx={{ 
                    flex: 1, 
                    p: 1, 
                    borderRadius: 1,
                    bgcolor: activeStage?.stageId === stage.stageId ? theme.palette.primary.main : 'transparent',
                    color: activeStage?.stageId === stage.stageId ? theme.palette.primary.contrastText : 'text.primary'
                  }}>
                    <Typography variant="body2" fontWeight={activeStage?.stageId === stage.stageId ? "700" : "400"}>
                      {stage.stageId.replace(/_/g, ' ').toUpperCase()}
                    </Typography>
                    <Typography variant="caption" sx={{ 
                      color: activeStage?.stageId === stage.stageId ? 'inherit' : 'text.secondary',
                      opacity: 0.8
                    }}>
                      {stage.stageStatus === 2 ? "Completed" : stage.stageStatus === 3 ? "Failed" : "In Progress"}
                    </Typography>
                  </Box>
                </Box>
              ))}
            </Stack>
          </Box>

          {/* RIGHT SIDE: SELECTED STAGE DETAILS */}
          <Box sx={{ flex: 1, p: 3, overflowY: 'auto' }}>
            {activeStage ? (
              <Stack spacing={3}>
                <Box display="flex" alignItems="center" gap={1}>
                  <InfoIcon color="primary" />
                  <Typography variant="subtitle1" fontWeight="bold">Stage Metrics</Typography>
                </Box>

                <Divider />

                <Box display="grid" gridTemplateColumns="1fr 1fr" gap={2}>
                  <Box>
                    <Typography variant="caption" color="text.secondary">Start Time</Typography>
                    <Typography variant="body2">{new Date(activeStage.startTime).toLocaleString()}</Typography>
                  </Box>
                  <Box>
                    <Typography variant="caption" color="text.secondary">End Time</Typography>
                    <Typography variant="body2">
                      {activeStage.endTime ? new Date(activeStage.endTime).toLocaleString() : 'In Progress'}
                    </Typography>
                  </Box>
                  <Box>
                    <Typography variant="caption" color="text.secondary">Triggered By</Typography>
                    <Typography variant="body2">{activeStage.stageSource || 'System'}</Typography>
                  </Box>
                </Box>

                <Paper variant="outlined" sx={{ p: 2, bgcolor: theme.palette.background.default }}>
                  <Typography variant="caption" color="text.secondary" gutterBottom display="block">
                    Execution Remarks
                  </Typography>
                  <Typography variant="body2">
                    {activeStage.stageRemarks || "No specific remarks provided for this stage."}
                  </Typography>
                </Paper>
              </Stack>
            ) : (
              <Box display="flex" justifyContent="center" alignItems="center" height="100%">
                <Typography color="text.secondary">Select a stage to view execution data.</Typography>
              </Box>
            )}
          </Box>
        </DialogContent>
      </Dialog>
    </Box>
  );
}
