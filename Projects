import React, { useState, useRef, useEffect } from "react";
import {
  Box, Button, Typography, CircularProgress, Table, TableBody,
  TableCell, TableContainer, TableHead, TableRow, Paper,
  TablePagination, Dialog, DialogTitle, DialogContent, IconButton,
  Tooltip, DialogActions, Chip, Divider, Stack
} from "@mui/material";
import {
  PlayArrow as PlayArrowIcon,
  Close as CloseIcon,
  Assessment as SummaryIcon,
  Replay as RetryIcon,
  Visibility as ViewIcon, // Eye icon for stages
  CheckCircle as SuccessIcon,
  Error as FailedIcon,
  Schedule as PendingIcon
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// --- API Constants ---
const TRIGGER_API_URL = "/PS/airflow/trigger";
const INITIAL_DATA_URL = "/PS/process/processes/data/7";
const SUMMARY_BASE_URL = "/CM/lho-transfers/summary/";

export default function TransferDataLho() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  // Main Table States
  const [tableData, setTableData] = useState([]);
  const [isInitialLoading, setIsInitialLoading] = useState(true);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  // Dialog States
  const [summaryOpen, setSummaryOpen] = useState(false);
  const [summaryData, setSummaryData] = useState([]);
  const [summaryLoading, setSummaryLoading] = useState(false);
  
  // Stages Dialog States
  const [stagesOpen, setStagesOpen] = useState(false);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [activeStage, setActiveStage] = useState(null);

  const fetchInitialData = async () => {
    setIsInitialLoading(true);
    try {
      const response = await callApi(INITIAL_DATA_URL, null, "GET");
      if (isMounted.current && response && response.initialData) {
        setTableData(response.initialData.map(item => ({ ...item, isLatest: true, runVersion: item.runId || 1 })));
      }
    } catch (error) {
      showSnackBar("Failed to load process data", "error");
    } finally {
      if (isMounted.current) setIsInitialLoading(false);
    }
  };

  useEffect(() => {
    isMounted.current = true;
    fetchInitialData();
    return () => { isMounted.current = false; };
  }, []);

  const handleViewStages = (process) => {
    setSelectedProcess(process);
    setActiveStage(process.stages?.[0] || null);
    setStagesOpen(true);
  };

  const getStatusChip = (status) => {
    switch (status) {
      case 1: return <Chip label="In Progress" color="primary" variant="outlined" size="small" />;
      case 2: return <Chip label="Success" color="success" size="small" />;
      case 3: return <Chip label="Fail" color="error" size="small" />;
      default: return <Chip label="Unknown" variant="outlined" size="small" />;
    }
  };

  return (
    <Box p={3}>
      <TableContainer component={Paper}>
        <Table>
          <TableHead>
            <TableRow>
              <TableCell align="center"><strong>Process Run ID</strong></TableCell>
              <TableCell align="center"><strong>Stage Status</strong></TableCell>
              <TableCell align="center"><strong>Process ID</strong></TableCell>
              <TableCell align="center"><strong>ETL Date</strong></TableCell>
              <TableCell align="center"><strong>Process Type</strong></TableCell>
              <TableCell align="center"><strong>Action</strong></TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {tableData.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage).map((row, index) => (
              <TableRow key={row.processRunId}>
                <TableCell align="center">{row.processRunId}</TableCell>
                <TableCell align="center">{getStatusChip(row.status)}</TableCell>
                <TableCell align="center">{row.processId}</TableCell>
                <TableCell align="center">{row.etlDate}</TableCell>
                <TableCell align="center">{row.processType}</TableCell>
                <TableCell align="center">
                  <Stack direction="row" spacing={1} justifyContent="center">
                    <Tooltip title="View Stages">
                      <IconButton size="small" onClick={() => handleViewStages(row)}>
                        <ViewIcon sx={{ color: '#5e35b1' }} />
                      </IconButton>
                    </Tooltip>
                    <Tooltip title="Get Summary">
                      <span>
                        <IconButton size="small" disabled={row.status !== 2} onClick={() => {}}>
                          <SummaryIcon />
                        </IconButton>
                      </span>
                    </Tooltip>
                  </Stack>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ---------------- PROCESS DETAILS (STAGES) DIALOG ---------------- */}
      <Dialog open={stagesOpen} onClose={() => setStagesOpen(false)} maxWidth="md" fullWidth>
        <DialogTitle sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '1px solid #e0e0e0' }}>
          <Typography variant="h6" sx={{ fontWeight: 'bold', color: '#311b92' }}>
            {selectedProcess?.processType} – Process Details
          </Typography>
          <IconButton onClick={() => setStagesOpen(false)}><CloseIcon /></IconButton>
        </DialogTitle>

        <DialogContent sx={{ p: 0, display: 'flex', minHeight: '500px' }}>
          {/* Left Panel: Vertical Stepper/Stages */}
          <Box sx={{ width: '35%', borderRight: '1px solid #e0e0e0', p: 2, bgcolor: '#fcfaff' }}>
            <Stack spacing={0}>
              {selectedProcess?.stages?.map((stage, idx) => (
                <Box key={idx} sx={{ display: 'flex', position: 'relative', pb: 4 }}>
                  {/* Vertical Line */}
                  {idx !== selectedProcess.stages.length - 1 && (
                    <Box sx={{ position: 'absolute', left: 14, top: 30, bottom: 0, width: '2px', bgcolor: '#e0e0e0' }} />
                  )}
                  
                  {/* Icon */}
                  <Box sx={{ mr: 2, zIndex: 1 }}>
                    {stage.stageStatus === 2 ? <SuccessIcon color="success" /> : 
                     stage.stageStatus === 3 ? <FailedIcon color="error" /> : 
                     <PendingIcon color="primary" />}
                  </Box>

                  {/* Stage Label/Button */}
                  <Box sx={{ flex: 1 }}>
                    <Button 
                      variant={activeStage?.stageId === stage.stageId ? "contained" : "text"}
                      fullWidth
                      size="small"
                      sx={{ 
                        justifyContent: 'flex-start', 
                        textTransform: 'none',
                        borderRadius: '20px',
                        py: 0.8,
                        color: activeStage?.stageId === stage.stageId ? 'white' : '#666',
                        backgroundColor: activeStage?.stageId === stage.stageId ? '#5e35b1' : 'transparent',
                        '&:hover': { backgroundColor: activeStage?.stageId === stage.stageId ? '#4527a0' : '#f3e5f5' }
                      }}
                      onClick={() => setActiveStage(stage)}
                    >
                      {stage.stageId.replace(/_/g, ' ').toUpperCase()}
                    </Button>
                    <Typography variant="caption" sx={{ ml: 1, color: stage.stageStatus === 3 ? 'error.main' : 'text.secondary' }}>
                      {stage.stageStatus === 2 ? "Completed" : stage.stageStatus === 3 ? "Failed" : "In Progress"}
                    </Typography>
                  </Box>
                </Box>
              ))}
            </Stack>
          </Box>

          {/* Right Panel: Stage Details Card */}
          <Box sx={{ flex: 1, p: 4, bgcolor: '#f5f5f5' }}>
            {activeStage ? (
              <Paper sx={{ p: 3, borderRadius: '15px', boxShadow: 'none', border: '1px solid #e0e0e0' }}>
                <Stack direction="row" alignItems="center" spacing={2} mb={4}>
                  <Box sx={{ p: 1, bgcolor: '#ede7f6', borderRadius: '50%' }}><PendingIcon sx={{ color: '#5e35b1' }} /></Box>
                  <Typography variant="h6" fontWeight="bold">Stage Details</Typography>
                </Stack>

                <Stack spacing={3}>
                  <Stack direction="row" spacing={4}>
                    <Box>
                      <Typography variant="caption" color="text.secondary">Start Time</Typography>
                      <Typography variant="body2" fontWeight="500">{new Date(activeStage.startTime).toLocaleString()}</Typography>
                    </Box>
                    <Box>
                      <Typography variant="caption" color="text.secondary">End Time</Typography>
                      <Typography variant="body2" fontWeight="500">
                        {activeStage.endTime ? new Date(activeStage.endTime).toLocaleString() : '---'}
                      </Typography>
                    </Box>
                  </Stack>

                  <Box>
                    <Typography variant="caption" color="text.secondary">Triggered By</Typography>
                    <Typography variant="body2" fontWeight="500">{activeStage.stageSource || 'System'}</Typography>
                  </Box>

                  <Box sx={{ p: 2, bgcolor: '#fafafa', borderRadius: '8px', border: '1px solid #eeeeee' }}>
                    <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Remarks</Typography>
                    <Typography variant="body2" color="text.primary">
                      {activeStage.stageRemarks || "No remarks available for this stage."}
                    </Typography>
                  </Box>
                </Stack>
              </Paper>
            ) : (
              <Box display="flex" justifyContent="center" alignItems="center" height="100%">
                <Typography color="text.secondary">Select a stage to view details</Typography>
              </Box>
            )}
          </Box>
        </DialogContent>
      </Dialog>
    </Box>
  );
}
