@Slf4j
@RestController
@RequestMapping("/api/lho-transfers")
@RequiredArgsConstructor
public class LhoTransferController {

    private final CommonMasterService service;


    @PostMapping("/search")
    public ResponseEntity<ApiResponse<PaginatedResponseDto<CommonRequestDto>>> searchLhoTransfers(
            @RequestBody SearchRequest request) {
        log.info("Received request to search LHO Transfers");
        PaginatedResponseDto<CommonRequestDto> response = service.searchLhoTransfers(request);
        return ResponseEntity.ok(ApiResponse.success(response, "LHO Transfers fetched successfully"));
