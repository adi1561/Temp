    @Transactional
    public Object getOrGenerateLhoSummary(Long id) {
        log.info("Processing LHO Summary request for ID: {}", id);

        // --- STEP 1: CHECK CACHE TABLE ---
        Optional<LhoTransferSummary> cached = lhoSummaryRepository.findById(id);
        if (cached.isPresent()) {
            log.info("Cache Hit: Returning summary from LHO_TRANSFER_SUMMARY for ID: {}", id);
            try {
                // Deserialize the CLOB string back to a Map to ensure proper JSON formatting
                return objectMapper.readValue(cached.get().getPayload(),
                        new TypeReference<Map<String, BigDecimal>>() {});
            } catch (Exception e) {
                log.error("Error parsing cached summary JSON: {}", e.getMessage());
                // Fallback: if parsing fails, return the raw payload
                return cached.get().getPayload();
            }
        }

        // --- STEP 2: CACHE MISS - AGGREGATE FROM P_L_TRANSFER ---
        log.info("Cache Miss: Aggregating 10,000+ rows from P_L_TRANSFER for ID: {}", id);
        List<Object[]> aggregatedData = plTransferRepository.getAggregatedSummary();

        if (aggregatedData.isEmpty()) {
            log.warn("No data found in P_L_TRANSFER to generate summary.");
            return Collections.emptyMap();
        }

        // --- STEP 3: MAP DATA WITH HIGH PRECISION (BigDecimal) ---
        // Using String keys and BigDecimal values to prevent scientific notation (e.g., 1.1E8)
        Map<String, BigDecimal> summaryMap = new HashMap<>();

        for (Object[] row : aggregatedData) {
            String branchCode = String.valueOf(row[0]);

            // Extract the sum and force 4 decimal places without precision loss
            BigDecimal totalPL = (row[1] != null)
                    ? new BigDecimal(row[1].toString()).setScale(2, RoundingMode.HALF_UP)
                    : BigDecimal.ZERO.setScale(2, RoundingMode.HALF_UP);

            summaryMap.put(branchCode, totalPL);
        }

        // --- STEP 4: PERSIST TO CACHE & RETURN ---
        try {
            // Convert Map to JSON String for CLOB storage
            String jsonPayload = objectMapper.writeValueAsString(summaryMap);

            LhoTransferSummary summaryEntity = LhoTransferSummary.builder()
                    .id(id)
                    .payload(jsonPayload)
                    .build();

            lhoSummaryRepository.save(summaryEntity);
            log.info("Successfully generated and cached summary for ID: {}", id);

            return summaryMap;
        } catch (Exception e) {
            log.error("Failed to serialize summary to JSON: {}", e.getMessage());
            throw new RuntimeException("Error during LHO Summary persistence.");
        }
    }



