package com.tcs.fincore.CommonRequestService.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.Map;

@Slf4j
@Component
@RequiredArgsConstructor
public class LhoTransferStrategy implements RequestTypeStrategy {

    private final KafkaEventPublisherService kafkaEventPublisherService;
    private final ObjectMapper objectMapper;
    private final JdbcTemplate jdbcTemplate;

    @Override
    public RequestType getRequestType() {
        return RequestType.YEAR_END_PROFIT_TRANSFER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        log.info("Processing Approval for LHO Transfer Batch: {}", request.getTargetId());

        switch (request.getChangeType()) {
            case ADD: // Or UPDATE, depending on what your frontend sends
                handleLhoApproval(request);
                break; // <-- NEVER FORGET THIS BREAK!
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " not supported.");
        }
    }

    private void handleLhoApproval(CommonReq request) throws JsonProcessingException {
        log.info("Constructing tailored Kafka payload for targetId: {}", request.getTargetId());

        JsonNode originalPayload = objectMapper.readTree(request.getPayload());
        Long processRunId = originalPayload.has("processRunId") ? originalPayload.get("processRunId").asLong() : null;
        
        Map<String, Object> customKafkaPayload = new HashMap<>();
        customKafkaPayload.put("requestId" , request.getId());
        customKafkaPayload.put("processRunId", processRunId);
        customKafkaPayload.put("processId", 12);
        customKafkaPayload.put("user", request.getExecutorId());
        customKafkaPayload.put("remarks", request.getExecutorRemarks());

        String finalPayloadString = objectMapper.writeValueAsString(customKafkaPayload);

        kafkaEventPublisherService.publishLhoTransferEvent(request.getTargetId(), request.getId(), finalPayloadString);

        // Ensures the status is locked to QUEUE in the DB
        request.setReqStatus(RequestStatus.QUEUE);
        request.setExecutionRemarks("Event sent to Kafka. Request is in QUEUE.");

        log.info("Batch {} placed in QUEUE successfully.", request.getTargetId());
    }

    /**
     * Intercepts the 'else' block from RequestServiceImpl.
     * Routes QUEUE to Approval logic, and REJECTED to Database cleanup.
     */
    @Override
    public void processRejection(CommonReq request) {
        
        // 1. INTERCEPT THE "QUEUE" STATUS
        if (RequestStatus.QUEUE.equals(request.getReqStatus())) {
            log.info("Intercepted QUEUE status in processRejection. Routing to Kafka Publisher...");
            try {
                handleLhoApproval(request);
                return; // Exit method early so we don't run deletion logic
            } catch (JsonProcessingException e) {
                log.error("Failed to parse JSON while routing QUEUE request: {}", request.getId(), e);
                throw new RuntimeException("Failed to process QUEUE payload", e);
            }
        }
        
        // 2. PROCESS THE ACTUAL "REJECTED" STATUS
        if (RequestStatus.REJECTED.equals(request.getReqStatus())) {
            log.info("Processing actual Rejection for Batch: {}. Clearing P_L_TRANSFER table.", request.getTargetId());

            try {
                JsonNode payloadNode = objectMapper.readTree(request.getPayload());
                
                if (!payloadNode.has("etlDate") || payloadNode.get("etlDate").isNull()) {
                     throw new IllegalArgumentException("CRITICAL: etlDate is missing. Cannot safely delete records.");
                }
                
                String etlDate = payloadNode.get("etlDate").asText(); 
                
                // Safe, parameter-bound SQL to prevent SQL injection and syntax errors
                String sql = "DELETE FROM P_L_TRANSFER WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')";
                int rowsAffected = jdbcTemplate.update(sql, etlDate);

                log.info("Successfully cleared {} rows for rejected request: {}", rowsAffected, request.getId());

            } catch (Exception e) {
                log.error("CRITICAL: Failed to clear table during rejection of request: {}", request.getId(), e);
                throw new RuntimeException("Failed to clear table on rejection", e);
            }
        }
    }
}
