3. Core Logic Service (AsciiGenerationService.java)
This service handles the heavy lifting using a helper class to parse the rules.
package com.example.ascii.service;

import com.example.ascii.entity.AsciiConfig;
import com.example.ascii.repository.AsciiConfigRepository;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

@Service
@Slf4j
public class AsciiGenerationService {

    private final AsciiConfigRepository configRepo;

    public AsciiGenerationService(AsciiConfigRepository configRepo) {
        this.configRepo = configRepo;
    }

    public String generateReport(String reportId, String inputPathStr, String branchCode) throws Exception {
        log.info("Starting generation for Report: {}", reportId);

        // 1. Fetch Config
        AsciiConfig config = configRepo.findById(reportId)
                .orElseThrow(() -> new RuntimeException("Config not found for: " + reportId));

        Path inputPath = Paths.get(inputPathStr);
        if (!Files.exists(inputPath)) throw new IOException("Input file not found");

        List<String> lines = Files.readAllLines(inputPath);
        List<String> outputLines = new ArrayList<>();

        // 2. Generate Header
        String dateStr = LocalDate.now().format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        String headerPad = String.format("%5s", branchCode).replace(' ', '0'); // L pad 5
        String header = config.getOutputFirstLine() + headerPad + dateStr;
        outputLines.add(header);

        // 3. Process Body
        List<String> bufferedItems = new ArrayList<>();
        int batchSize = config.getOutputPerLineHead();

        for (String line : lines) {
            String[] columns = line.split("\\|", -1);
            
            // Validate Row (Gatekeeper)
            if (!isValidRow(columns, config)) continue;

            // Process Items based on '5and1' or '3' logic
            List<ProcessingItem> itemsToProcess = extractAmountColumns(columns, config);
            
            for (ProcessingItem item : itemsToProcess) {
                String processedAscii = processSingleItem(item.head, item.amount, item.colIndex, config);
                bufferedItems.add(processedAscii);

                if (bufferedItems.size() == batchSize) {
                    outputLines.add(String.join("", bufferedItems));
                    bufferedItems.clear();
                }
            }
        }
        
        // Flush remaining buffer
        if (!bufferedItems.isEmpty()) {
            outputLines.add(String.join("", bufferedItems));
        }

        // 4. Generate Footer
        if (config.getOutputEndLine() != null && !config.getOutputEndLine().isEmpty()) {
            outputLines.add(config.getOutputEndLine());
        }

        // 5. Write File
        String outputFileName = "GENERATED_" + reportId + config.getFileType();
        Path outputPath = inputPath.getParent().resolve(outputFileName);
        Files.write(outputPath, outputLines);
        
        return outputPath.toString();
    }

    // --- Helper Logic ---

    private boolean isValidRow(String[] cols, AsciiConfig config) {
        int idx = config.getInputHeadCol() - 1;
        if (cols.length <= idx) return false;
        String head = cols[idx].trim();
        if (head.isEmpty()) return false;
        return Pattern.compile(config.getInputHeadRegex()).matcher(head).find();
    }

    private String processSingleItem(String head, BigDecimal amount, int colIndex, AsciiConfig config) {
        // 1. Apply Logic (e.g., /1000)
        amount = RuleParser.applyMathLogic(amount, head, colIndex, config.getOutputAmtColLogic());
        
        // 2. Apply Decimal/Rounding
        amount = RuleParser.applyDecimalLogic(amount, head, colIndex, config.getOutputAmtDecimal());
        
        // 3. Format Amount (Padding)
        String amountStr = RuleParser.applyAmountPadding(amount, head, colIndex, config.getOutputAmtColPad());
        
        // 4. Handle Sign
        String signedAmount = RuleParser.applySign(amountStr, amount, head, colIndex, config.getOutputAmtSign());
        
        // 5. Pad Head
        String headPadded = RuleParser.applyHeadPadding(head, config.getOutputHeadColPad());

        return headPadded + signedAmount;
    }

    private List<ProcessingItem> extractAmountColumns(String[] cols, AsciiConfig config) {
        List<ProcessingItem> items = new ArrayList<>();
        String head = cols[config.getInputHeadCol() - 1].trim();
        String seq = config.getAmountColSeq();

        if (seq.contains("else")) {
            // "5else6" logic
            String[] parts = seq.split("else");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                if (idx < cols.length && !cols[idx].trim().isEmpty()) {
                    items.add(new ProcessingItem(head, parseAmount(cols[idx]), idx + 1));
                    return items; // Return only the first valid one found
                }
            }
            // If all failed, default to first option with 0
            items.add(new ProcessingItem(head, BigDecimal.ZERO, Integer.parseInt(parts[0].trim())));
        } else if (seq.contains("and")) {
            // "5and1" logic
            String[] parts = seq.split("and");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
            }
        } else {
            // Simple "3" logic
            int idx = Integer.parseInt(seq.trim()) - 1;
            items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
        }
        return items;
    }
    
    private BigDecimal parseAmount(String[] cols, int idx) {
        if (idx >= cols.length) return BigDecimal.ZERO;
        return parseAmount(cols[idx]);
    }

    private BigDecimal parseAmount(String val) {
        try {
            return new BigDecimal(val.trim().replace(",", ""));
        } catch (Exception e) {
            return BigDecimal.ZERO;
        }
    }
    
    private static class ProcessingItem {
        String head; BigDecimal amount; int colIndex;
        ProcessingItem(String h, BigDecimal a, int c) { head = h; amount = a; colIndex = c; }
    }
}

4. Rule Parser Utility (RuleParser.java)
This class parses the bracket notation [Regex][Col][Logic].
package com.example.ascii.service;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RuleParser {

    private static final Pattern RULE_PATTERN = Pattern.compile("\\[(.*?)\\]\\[(.*?)\\]\\[(.*?)\\]");

    public static BigDecimal applyMathLogic(BigDecimal amount, String head, int colIdx, String logicConfig) {
        if (logicConfig == null) return amount;
        String logic = findMatchingRule(head, colIdx, logicConfig); // returns "/(1000)" or "*(-1)"
        
        if (logic == null) return amount;

        if (logic.contains("/")) {
            BigDecimal divisor = new BigDecimal(logic.replaceAll("[^0-9.]", ""));
            return amount.divide(divisor, 6, RoundingMode.HALF_UP);
        } else if (logic.contains("*")) {
            BigDecimal multiplier = new BigDecimal(logic.replace("*", "").replace("(", "").replace(")", ""));
            return amount.multiply(multiplier);
        }
        return amount;
    }

    public static BigDecimal applyDecimalLogic(BigDecimal amount, String head, int colIdx, String decimalConfig) {
        if (decimalConfig == null) return amount;
        String rule = findMatchingRule(head, colIdx, decimalConfig);
        if (rule == null) return amount;

        // "2" -> 2 decimal places
        // "floor", "ceil"
        if (rule.equalsIgnoreCase("floor")) return amount.setScale(0, RoundingMode.FLOOR);
        if (rule.equalsIgnoreCase("ceil")) return amount.setScale(0, RoundingMode.CEILING);
        if (rule.equalsIgnoreCase("round")) return amount.setScale(0, RoundingMode.HALF_UP);
        
        try {
            int scale = Integer.parseInt(rule);
            return amount.setScale(scale, RoundingMode.HALF_UP);
        } catch (NumberFormatException e) {
            return amount;
        }
    }

    public static String applyAmountPadding(BigDecimal amount, String head, int colIdx, String padConfig) {
        // Default format if no rule found
        if (padConfig == null) return amount.toPlainString();
        String rule = findMatchingRule(head, colIdx, padConfig); // e.g., "16,2" or "18"

        if (rule == null) return amount.toPlainString();

        if (rule.contains(",")) {
            // "16,2" -> 16 total chars, 2 decimal places
            String[] parts = rule.split(",");
            int totalLen = Integer.parseInt(parts[0]);
            int decimalLen = Integer.parseInt(parts[1]);
            
            BigDecimal scaled = amount.setScale(decimalLen, RoundingMode.HALF_UP);
            String raw = scaled.toPlainString(); // "123.45"
            
            return padLeft(raw, totalLen, '0');
        } else {
            // "18" -> Treat as integer (strip decimal point)
            int totalLen = Integer.parseInt(rule);
            String raw = amount.toBigInteger().toString(); // Strip decimal
            return padLeft(raw, totalLen, '0');
        }
    }

    public static String applySign(String formattedAmt, BigDecimal originalAmt, String head, int colIdx, String signConfig) {
        if (signConfig == null) return formattedAmt;
        String rule = findMatchingRule(head, colIdx, signConfig);
        
        if ("NO_SIGN".equalsIgnoreCase(rule)) return formattedAmt;
        if ("SHOW_SIGN".equalsIgnoreCase(rule)) {
            return formattedAmt + (originalAmt.compareTo(BigDecimal.ZERO) >= 0 ? "+" : "-");
        }
        // Default: If negative, append -
        if (originalAmt.compareTo(BigDecimal.ZERO) < 0) {
            return formattedAmt + "-";
        }
        return formattedAmt;
    }

    public static String applyHeadPadding(String head, String padConfig) {
        // "5L0" -> Length 5, Left, Char '0'
        if (padConfig == null) return head;
        
        int len = Integer.parseInt(padConfig.substring(0, padConfig.length() - 2));
        char direction = padConfig.charAt(padConfig.length() - 2);
        char padChar = padConfig.charAt(padConfig.length() - 1);
        
        // Handle "6R " (space)
        if (padConfig.endsWith("\" \"")) padChar = ' ';

        if (direction == 'L') return padLeft(head, len, padChar);
        return padRight(head, len, padChar);
    }

    // --- Internal Helpers ---

    private static String findMatchingRule(String head, int colIdx, String configStr) {
        if (configStr == null || configStr.isEmpty()) return null;
        
        String[] rules = configStr.split("\\|");
        for (String rule : rules) {
            Matcher m = RULE_PATTERN.matcher(rule);
            if (m.find()) {
                String headRegex = m.group(1); // "^S\d"
                String colReq = m.group(2);    // "3"
                String logic = m.group(3);     // "/1000"

                boolean colMatch = colReq.isEmpty() || colReq.equals(String.valueOf(colIdx));
                boolean headMatch = Pattern.compile(headRegex).matcher(head).find();

                if (colMatch && headMatch) {
                    return logic;
                }
            }
        }
        return null;
    }

    private static String padLeft(String str, int len, char pad) {
        if (str.length() >= len) return str;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < len - str.length(); i++) sb.append(pad);
        sb.append(str);
        return sb.toString();
    }
    
    private static String padRight(String str, int len, char pad) {
        if (str.length() >= len) return str;
        StringBuilder sb = new StringBuilder(str);
        for (int i = 0; i < len - str.length(); i++) sb.append(pad);
        return sb.toString();
    }
}

5. Controller (AsciiController.java)
package com.example.ascii.controller;

import com.example.ascii.service.AsciiGenerationService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/ascii")
public class AsciiController {

    @Autowired
    private AsciiGenerationService service;

    @PostMapping("/generate")
    public ResponseEntity<String> generate(
            @RequestParam String reportId,
            @RequestParam String filePath,
            @RequestParam String branchCode) {
        try {
            String outPath = service.generateReport(reportId, filePath, branchCode);
            return ResponseEntity.ok("File generated: " + outPath);
        } catch (Exception e) {
            e.printStackTrace();
            return ResponseEntity.internalServerError().body("Error: " + e.getMessage());
        }
    }
}

Key Design Decisions:
 * RuleParser Utility: I moved the messy parsing of string logic ([regex][col][val]) into a static utility. This keeps the Service clean and testable.
 * Flexible Column Logic: The extractAmountColumns method handles 3, 3else4, and 3and4 natively, abstracting that complexity away from the main loop.
 * BigDecimal: Used everywhere for financial accuracy.
 * Extensibility: If you need a new operation (e.g., square), you only edit RuleParser.java, not the main service loop.
 * Performance: Regex patterns are compiled on the fly. For massive scale (millions of rows), you would cache these Pattern objects in a Map<String, Pattern> to avoid recompiling them for every row.
