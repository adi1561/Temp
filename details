@Override
public void processRejection(CommonReq request) {
    log.info("Processing Rejection for Year End Batch. Extracting etlDate to clear P_L_TRANSFER table.");

    try {
        // 1. Extract the etlDate from the JSON payload
        JsonNode payloadNode = objectMapper.readTree(request.getPayload());
        
        // Safety check to ensure we don't accidentally delete everything if the date is missing
        if (!payloadNode.has("etlDate") || payloadNode.get("etlDate").isNull()) {
             throw new IllegalArgumentException("CRITICAL: etlDate is missing from the payload. Cannot safely delete records.");
        }
        
        String etlDate = payloadNode.get("etlDate").asText(); // Gets "2026-03-05"
        log.info("Extracted etlDate: {}. Preparing to execute DELETE operation.", etlDate);

        // 2. Write the Safe SQL Query (Fixed syntax: removed "TABLE", changed "==" to "=")
        // Using TRUNC ensures we match the date exactly, ignoring any HH:MM:SS timestamps in the DB
        String sql = "DELETE FROM P_L_TRANSFER WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')";

        // 3. Execute using .update() which safely injects the etlDate into the '?'
        int rowsAffected = jdbcTemplate.update(sql, etlDate);

        log.info("Successfully cleared {} rows from P_L_TRANSFER table for rejected request: {} for date: {}", 
                 rowsAffected, request.getId(), etlDate);

    } catch (Exception e) {
        log.error("CRITICAL: Failed to clear P_L_TRANSFER table during rejection of request: {}", request.getId(), e);
        throw new RuntimeException("Failed to clear table on rejection", e);
    }
}
