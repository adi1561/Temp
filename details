package com.tcs.fincore.CommonMasterService.repository;

import com.tcs.fincore.CommonMasterService.model.PLTransfer;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import java.util.List;

public interface PLTransferRepository extends JpaRepository<PLTransfer, Long> {

    /**
     * Returns aggregated rows grouped by Circle Name.
     * DB does the math and joins with CIRCLE_MASTER to fetch the actual string name.
     * Uses LPAD to match the NUMBER(5) column to the VARCHAR2(5) column safely.
     * Uses LEFT JOIN to ensure no financial data is lost even if master data is missing.
     */
    @Query(value = "SELECT cm.CIRCLE_NAME, SUM(pl.PROFIT_LOSS) " +
            "FROM P_L_TRANSFER pl " +
            "LEFT JOIN CIRCLE_MASTER cm " +
            "ON cm.BRANCH_CODE = LPAD(pl.CIRCLE_BRANCH_CODE, 5, '0') " +
            "GROUP BY cm.CIRCLE_NAME", nativeQuery = true)
    List<Object[]> getAggregatedSummary();
}

