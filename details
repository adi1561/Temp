    @Override
    public PaginatedResponseDto<CommonRequestDto> searchLhoTransfers(SearchRequest request) {
        log.info("Searching Common Requests for REQ_TYPE: LHO_TRANSFER");

        // Set up Pagination & Sorting
        Sort.Direction direction = (request.getSortOrder() != null && request.getSortOrder().equalsIgnoreCase("DESC"))
                ? Sort.Direction.DESC : Sort.Direction.ASC;
        String sortField = (request.getSortField() != null) ? request.getSortField() : "requestDate";

        PageRequest pageRequest = PageRequest.of(request.getPage(), request.getSize(), Sort.by(direction, sortField));

        // Business Rule: Hard filter for LHO_TRANSFER
        Specification<CommonRequest> lhoTypeSpec = (root, query, cb) ->
                cb.equal(root.get("requestType"), "LHO_TRANSFER");

        // Combine with dynamic UI filters using your GenericSpecification
        Specification<CommonRequest> finalSpec = lhoTypeSpec.and(GenericSpecification.build(request.getFilters()));

        Page<CommonRequest> page = commonRequestRepository.findAll(finalSpec, pageRequest);

        if (page.isEmpty()) {
            throw new NoDataFoundException("No LHO Transfer records found.");
        }

        List<CommonRequestDto> dtoList = page.getContent().stream()
                .map(this::mapToRequestDto)
                .toList();

        return new PaginatedResponseDto<>(
                page.getNumber(),
                page.getTotalPages(),
                page.getSize(),
                page.getTotalElements(),
                direction.name(),
                dtoList
        );
    }

    @Override
    public CommonRequestDto getLhoTransferById(Long id) {
        CommonRequest entity = commonRequestRepository.findById(id)
                .orElseThrow(() -> new NoDataFoundException("Request " + id + " not found."));

        // Enforce type check for security
        if (!"LHO_TRANSFER".equalsIgnoreCase(entity.getRequestType())) {
            throw new IllegalArgumentException("Access Denied: Record is not an LHO Transfer.");
        }

        return mapToRequestDto(entity);
    }

    /**
     * Helper Mapper: Entity to DTO
     */
    private CommonRequestDto mapToRequestDto(CommonRequest entity) {
        return CommonRequestDto.builder()
                .id(entity.getId())
                .requestType(entity.getRequestType())
                .changeType(entity.getChangeType())
                .status(entity.getStatus())
                .requestDate(entity.getRequestDate())
                .creatorId(entity.getCreatorId())
                .creatorRemarks(entity.getCreatorRemarks())
                .executionDate(entity.getExecutionDate())
                .executionRemarks(entity.getExecutionRemarks())
                .executorId(entity.getExecutorId())
                .executorRemarks(entity.getExecutorRemarks())
                .payload(entity.getPayload())
                .targetId(entity.getTargetId())
                .build();
    }

    @Override
    @Transactional
    public Object getOrGenerateLhoSummary(Long id) {
        log.info("Processing LHO Summary request for ID: {}", id);

        // --- STEP 1: CACHE CHECK ---
        Optional<LhoTransferSummary> cached = lhoSummaryRepository.findById(id);
        if (cached.isPresent()) {
            try {
                JsonNode node = objectMapper.readTree(cached.get().getPayload());
                // Check if it's the new structure and has a valid totalAmount
                if (node.has("circleWiseDetails") && node.get("totalAmount").asDouble() != 0) {
                    return objectMapper.treeToValue(node, LhoSummaryResponseDto.class);
                }
            } catch (Exception e) {
                log.warn("Refreshing cache for ID: {}", id);
            }
        }

        // --- STEP 2: AGGREGATE USING NEW JOIN QUERY ---
        List<Object[]> aggregatedData = plTransferRepository.getAggregatedSummary();
        if (aggregatedData.isEmpty()) {
            return LhoSummaryResponseDto.builder()
                    .totalAmount(BigDecimal.ZERO.setScale(2, RoundingMode.HALF_UP))
                    .totalRecordCount(0)
                    .circleWiseDetails(Collections.emptyMap())
                    .build();
        }

        // --- STEP 3: MAPPING & CALCULATION ---
        Map<String, BigDecimal> summaryMap = new HashMap<>();
        BigDecimal runningTotal = BigDecimal.ZERO;

        for (Object[] row : aggregatedData) {
            // row[0] is now the CIRCLE_NAME from the database (or null if LEFT JOIN missed)
            String circleName = (row[0] != null) ? String.valueOf(row[0]) : "UNKNOWN_CIRCLE";

            // Convert with high precision
            BigDecimal totalPL = (row[1] != null)
                    ? new BigDecimal(row[1].toString())
                    : BigDecimal.ZERO;

            runningTotal = runningTotal.add(totalPL);

            // Put the Circle Name and the Balance into the map
            summaryMap.put(circleName, totalPL.setScale(2, RoundingMode.HALF_UP));
        }

        // --- STEP 4: CONSTRUCT RESPONSE ---
        LhoSummaryResponseDto responseDto = LhoSummaryResponseDto.builder()
                .totalAmount(runningTotal.setScale(2, RoundingMode.HALF_UP))
                .totalRecordCount(summaryMap.size()) // Count of unique circles
                .circleWiseDetails(summaryMap)
                .build();

        // --- STEP 5: PERSIST ---
        try {
            String jsonPayload = objectMapper.writeValueAsString(responseDto);
            LhoTransferSummary summaryEntity = LhoTransferSummary.builder()
                    .id(id)
                    .payload(jsonPayload)
                    .build();

            lhoSummaryRepository.save(summaryEntity);
            return responseDto;
        } catch (Exception e) {
            log.error("Serialization failed: {}", e.getMessage());
            throw new RuntimeException("Error persisting LHO Summary.");
        }
    }


    @Override
    public YearEndTransferEligibilityDto checkYearEndProfitTransferEligibility() {
        log.info("Evaluating eligibility for YEAR_END_PROFIT_TRANSFER...");

        // Check if ANY request exists that is either in Queue ('Q') or Accepted ('A')
        boolean isAlreadyProcessingOrCompleted = commonRequestRepository.existsByRequestTypeAndStatusIn(
                "YEAR_END_PROFIT_TRANSFER",
                List.of("Q", "A") // Using modern Java List.of()
        );

        // Business Rule: If it exists in Q or A, return false (not eligible). Otherwise true.
        boolean isEligible = !isAlreadyProcessingOrCompleted;

        log.info("Year End Profit Transfer Eligibility: {}", isEligible);

        return YearEndTransferEligibilityDto.builder()
                .isEligible(isEligible)
                .build();
    }



