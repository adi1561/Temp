This method now handles the case-insensitive "V" and "TCS" prefixes followed by exactly 7 digits.
private boolean isValidUserId(String userId) {
    if (userId == null) return false;
    // Normalize to lowercase for easy checking of 'v' and 'tcs'
    String id = userId.toLowerCase();
    
    // Pattern 1: Exactly 7 digits (e.g., 1015698)
    if (id.matches("^\\d{7}$")) return true;
    
    // Pattern 2: 'v' (case-insensitive) + 7 digits (e.g., V1015698)
    if (id.matches("^v\\d{7}$")) return true;
    
    // Pattern 3: 'tcs' (case-insensitive) + 7 digits (e.g., TCS1015698)
    if (id.matches("^tcs\\d{7}$")) return true;

    return false;
}

