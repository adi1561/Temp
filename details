  const handleOpenSummary = (row) => {
    const safeParse = (jsonString) => {
      try {
        return jsonString ? JSON.parse(jsonString) : {};
      } catch (e) {
        console.error("JSON Parsing Error:", e);
        return {};
      }
    };

    const stageBalComp = row?.stages?.find(
      (s) => s.stageId === "balance_Compare_generated",
    );
    const stageSiba = row?.stages?.find(
      (s) => s.stageId === "intr_summary_calculated",
    );
    const stageSuspense = row?.stages?.find(
      (s) => s.stageId === "cntr_summary_calculated",
    );

    if (
      !stageBalComp?.summary &&
      !stageSiba?.summary &&
      !stageSuspense?.summary
    ) {
      snackbar("Summary not available", "warning");
      return;
    }

    const differenceSummary = safeParse(stageBalComp?.summary);
    const sibaSummary = safeParse(stageSiba?.summary);
    const suspenseSummary = safeParse(stageSuspense?.summary);

    const recondate =
      differenceSummary?.date ??
      sibaSummary?.date ??
      suspenseSummary?.date ??
      "";

    setSummaryMeta(row);

    setSummaryData({
      RECON_RUN_DATE: recondate,
      // FIX: It now checks if the single API returned the arrays under specific keys
      // before falling back to the generic '.summary' array.
      differenceSummary: differenceSummary?.differenceSummary || differenceSummary?.summary || [],
      sibaSummary: sibaSummary?.sibaSummary || differenceSummary?.sibaSummary || sibaSummary?.summary || [],
      suspenseSummary: suspenseSummary?.suspenseSummary || differenceSummary?.suspenseSummary || suspenseSummary?.summary || [],
      stages: row?.stages || [],
    });
  };
