    @Override
    public void processRejection(CommonReq request) {
        
        if (RequestStatus.QUEUE.equals(request.getReqStatus())) {
            log.info("Intercepted QUEUE status in processRejection. Routing to Approval Logic...");
            handleLhoApproval(request);
            return;
        }
        
        if (RequestStatus.REJECTED.equals(request.getReqStatus())) {
            log.info("Processing Rejection for Batch: {}. Clearing related tables.", request.getTargetId());

            try {
                JsonNode payloadNode = objectMapper.readTree(request.getPayload());
                
                if (!payloadNode.has("etlDate") || payloadNode.get("etlDate").isNull()) {
                     throw new IllegalArgumentException("CRITICAL: etlDate is missing. Cannot safely delete records.");
                }
                
                String etlDate = payloadNode.get("etlDate").asText(); 
                
                // --- OPTIMIZATION: Maintainable List of Tables ---
                List<String> tablesToClear = List.of(
                        "P_L_TRANSFER", 
                        "YOUR_SECOND_TABLE_NAME", 
                        "YOUR_THIRD_TABLE_NAME"
                );

                int totalRowsDeleted = 0;

                // Iterate through the tables and execute the delete
                for (String tableName : tablesToClear) {
                    // Note: Because table names are hardcoded in the List above, concatenating them here is 100% safe from SQL injection.
                    String sql = "DELETE FROM " + tableName + " WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')";
                    
                    int rowsAffected = jdbcTemplate.update(sql, etlDate);
                    totalRowsDeleted += rowsAffected;
                    
                    log.info("Deleted {} rows from {}", rowsAffected, tableName);
                }

                log.info("Successfully cleared a total of {} rows across {} tables for rejected request {}", 
                         totalRowsDeleted, tablesToClear.size(), request.getId());

            } catch (Exception e) {
                log.error("CRITICAL: Failed to clear tables during rejection of request: {}", request.getId(), e);
                // The @Transactional annotation will roll back ALL table deletions if any single table fails
                throw new RuntimeException("Failed to clear tables on rejection", e);
            }
        }
    }
