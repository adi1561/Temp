@Override
@Transactional
public Object getOrGenerateLhoSummary(Long id) {
    log.info("Processing LHO Summary request for ID: {}", id);

    // --- STEP 1: CHECK CACHE TABLE ---
    Optional<LhoTransferSummary> cached = lhoSummaryRepository.findById(id);
    if (cached.isPresent()) {
        log.info("Cache Hit: Checking summary structure for ID: {}", id);
        try {
            // Attempt to read as the new DTO structure
            JsonNode node = objectMapper.readTree(cached.get().getPayload());
            
            // If the cached JSON is the OLD Map structure (starts with a circle code), 
            // we re-calculate to fix the cache on the fly.
            if (!node.has("circleWiseDetails")) {
                log.info("Old cache format detected. Re-aggregating for ID: {}", id);
            } else {
                return objectMapper.treeToValue(node, LhoSummaryResponseDto.class);
            }
        } catch (Exception e) {
            log.warn("Cache parsing issue for ID {}: {}. Re-generating...", id, e.getMessage());
        }
    }

    // --- STEP 2: AGGREGATE DATA ---
    List<Object[]> aggregatedData = plTransferRepository.getAggregatedSummary();

    if (aggregatedData.isEmpty()) {
        log.warn("No data found to generate summary.");
        return LhoSummaryResponseDto.builder()
                .totalAmount(BigDecimal.ZERO.setScale(2, RoundingMode.HALF_UP))
                .totalRecordCount(0)
                .circleWiseDetails(Collections.emptyMap())
                .build();
    }

    // --- STEP 3: CALCULATE TOTALS AND MAP DETAILS ---
    Map<String, BigDecimal> summaryMap = new HashMap<>();
    BigDecimal totalAmount = BigDecimal.ZERO;

    for (Object[] row : aggregatedData) {
        String branchCode = String.valueOf(row[0]);
        BigDecimal totalPL = (row[1] != null)
                ? new BigDecimal(row[1].toString()).setScale(2, RoundingMode.HALF_UP)
                : BigDecimal.ZERO.setScale(2, RoundingMode.HALF_UP);

        summaryMap.put(branchCode, totalPL);
        totalAmount = totalAmount.add(totalPL); // Increment Total Amount
    }

    // --- STEP 4: CONSTRUCT THE FULL RESPONSE ---
    LhoSummaryResponseDto responseDto = LhoSummaryResponseDto.builder()
            .totalAmount(totalAmount.setScale(2, RoundingMode.HALF_UP))
            .totalRecordCount(summaryMap.size()) // Size is the count of circles
            .circleWiseDetails(summaryMap)
            .build();

    // --- STEP 5: PERSIST AND RETURN ---
    try {
        String jsonPayload = objectMapper.writeValueAsString(responseDto);

        LhoTransferSummary summaryEntity = LhoTransferSummary.builder()
                .id(id)
                .payload(jsonPayload)
                .build();

        lhoSummaryRepository.save(summaryEntity);
        log.info("Successfully generated summary with Total: {} and Count: {}", totalAmount, summaryMap.size());

        return responseDto;
    } catch (Exception e) {
        log.error("Failed to serialize summary to JSON: {}", e.getMessage());
        throw new RuntimeException("Error during LHO Summary persistence.");
    }
}
