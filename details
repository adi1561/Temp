@Service
@RequiredArgsConstructor
@Slf4j
public class LhoTransferServiceImpl implements LhoTransferService {

    private final ProfitLossService profitLossService;
    private final RequestService requestService; // Inject Central Service

    @Override
    @Transactional
    public CommonReq createLhoTransferRequest(String batchId, String triggeredByUserId, String token) {
        // 1. Fetch Real Data
        List<ProfitLossSummaryDto> summaryList = profitLossService.getCircleWiseSummary();

        // 2. Calculate Totals
        BigDecimal totalAmount = summaryList.stream()
                .map(ProfitLossSummaryDto::getTotalProfitLoss)
                .reduce(BigDecimal.ZERO, BigDecimal::add);

        // 3. Build Payload DTO
        LhoTransferPayloadDto payload = LhoTransferPayloadDto.builder()
                .batchId(batchId)
                .processDate(LocalDate.now())
                .totalRecordCount(summaryList.size())
                .totalAmount(totalAmount)
                .circleWiseDetails(summaryList)
                .build();

        // 4. Wrap into CreateRequestDto
        CreateRequestDto createDto = new CreateRequestDto();
        createDto.setRequestType(RequestType.LHO_TRANSFER);
        createDto.setChangeType(ChangeType.ADD);
        createDto.setPayload(payload);

        // 5. Delegate to Central Service (Handles DB Save & Notifications)
        return requestService.createRequest(createDto, triggeredByUserId, token);
    }
}

Summary of Component Architecture
 * Maker: Calls the updated LhoTransferServiceImpl, which sends a CreateRequestDto to the RequestService.
 * RequestService: Saves the request as PENDING and triggers a notification.
 * Checker: Calls updateRequestStatus.
 * Strategy: The central system finds the LhoTransferStrategy and executes the process approval logic.
