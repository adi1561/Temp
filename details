package com.tcs.fincore.CommonRequestService.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Component;

import java.util.Map;

@Slf4j
@Component
@RequiredArgsConstructor
public class LhoTransferStrategy implements RequestTypeStrategy {

    private final ObjectMapper objectMapper;
    private final JdbcTemplate jdbcTemplate;

    @Override
    public RequestType getRequestType() {
        return RequestType.YEAR_END_PROFIT_TRANSFER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        log.info("Processing Approval for Year End Profit Transfer Batch: {}", request.getTargetId());

        switch (request.getChangeType()) {
            case ADD:
            case UPDATE:
                handleLhoApproval(request);
                break;
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " not supported.");
        }
    }

    private void handleLhoApproval(CommonReq request) {


        log.info("Executing standard approval logic for targetId: {}", request.getTargetId());


        // Finalize the status in the database
        request.setReqStatus(RequestStatus.QUEUE);
        request.setExecutionRemarks("Approval logic executed locally. Request moved to QUEUE.");

        log.info("Batch {} processed and placed in QUEUE successfully.", request.getTargetId());
    }

    /**
     * Intercepts the 'else' block from RequestServiceImpl.
     * Routes QUEUE to Approval logic, and REJECTED to Database cleanup.
     */



    @Override
    public void processRejection(CommonReq request) {

        if (RequestStatus.QUEUE.equals(request.getReqStatus())) {
            log.info("Intercepted QUEUE status. Routing to Approval Logic...");
            return;
        }

        if (RequestStatus.REJECTED.equals(request.getReqStatus())) {
            log.info("Processing Rejection for Batch: {}.", request.getTargetId());

            try {
                JsonNode payloadNode = objectMapper.readTree(request.getPayload());
                if (!payloadNode.has("etlDate") || payloadNode.get("etlDate").isNull()) {
                    throw new IllegalArgumentException("CRITICAL: etlDate is missing.");
                }

                // 1. Extract the date string from JSON
                String etlDateValue = payloadNode.get("etlDate").asText();

                // 2. Map each table to its EXACT date column name based on your schema
                Map<String, String> tablesAndColumns = Map.of(
                        "P_L_TRANSFER", "TRANSFER_DATE",
                        "P_L_TRANSFER_BALANCE", "BALANCE_DATE",      // Used BALANCE_DATE based on your DDL!
                        "P_L_TRANSFER_TRANSACTIONS", "TRANSACTION_DATE"
                );

                int totalRowsDeleted = 0;

                // 3. Iterate through the Map
                for (Map.Entry<String, String> entry : tablesAndColumns.entrySet()) {
                    String tableName = entry.getKey();
                    String columnName = entry.getValue();

                    // 4. Inject both the Table Name and the Column Name dynamically
                    String sql = String.format("DELETE FROM %s WHERE TRUNC(%s) = TO_DATE(?, 'YYYY-MM-DD')", tableName, columnName);

                    // 5. Execute the query using the etlDateValue
                    int rowsAffected = jdbcTemplate.update(sql, etlDateValue);
                    totalRowsDeleted += rowsAffected;

                    log.info("Deleted {} rows from {} (using column {}) for ETL Date: {}",
                            rowsAffected, tableName, columnName, etlDateValue);
                }

                log.info("Successfully cleared a total of {} rows across {} tables", totalRowsDeleted, tablesAndColumns.size());

            } catch (Exception e) {
                log.error("CRITICAL: Failed to clear tables for request: {}", request.getId(), e);
                throw new RuntimeException("Failed to clear tables on rejection", e);
            }
        }
    }



package com.tcs.fincore.CommonRequestService.service.strategy;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.springframework.beans.factory.annotation.Value;

import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.kafka.support.SendResult;
import org.springframework.stereotype.Service;

import java.util.Map;
import java.util.concurrent.CompletableFuture;

@Slf4j
@Service
@RequiredArgsConstructor
public class KafkaEventPublisherService {

    private final KafkaTemplate<String, String> kafkaTemplate;

    @Value("${app.kafka.topics.lho-transfer:lho-airflow-topic}")
    private String lhoTopic;



    public void publishLhoTransferEvent(String targetId, Long requestId, String payload) {
        log.info("Attempting to publish LHO Transfer event for targetId: {} to topic: {}", targetId, lhoTopic);

        // 1. Create a ProducerRecord
        ProducerRecord<String, String> record = new ProducerRecord<>(lhoTopic, targetId, payload);

        // 2. Add your custom header to the record
        record.headers().add("requestId", String.valueOf(requestId).getBytes());

        // 3. Send it once
        CompletableFuture<SendResult<String, String>> future = kafkaTemplate.send(record);

        future.whenComplete((result, exception) -> {
            if (exception == null) {
                log.info("Successfully published! Target ID: {} | Topic: {} | Offset: {}",
                        targetId, lhoTopic, result.getRecordMetadata().offset());
            } else {
                log.error("CRITICAL: Failed to publish for Target ID: {}. Error: {}",
                        targetId, exception.getMessage());
            }
        });
    }
