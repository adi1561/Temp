package com.tcs.fincore.CommonMasterService.service.impl;

import com.tcs.fincore.CommonMasterService.dto.YearEndTransferEligibilityDto;
import com.tcs.fincore.CommonMasterService.repository.CommonRequestRepository;
import com.tcs.fincore.CommonMasterService.service.CommonMasterService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.List;

@Slf4j
@Service
@RequiredArgsConstructor
public class CommonMasterServiceImpl implements CommonMasterService {

    private final CommonRequestRepository commonRequestRepository;
    
    // ... your existing methods ...

    @Override
    public YearEndTransferEligibilityDto checkYearEndProfitTransferEligibility() {
        log.info("Evaluating eligibility for YEAR_END_PROFIT_TRANSFER...");

        // Check if ANY request exists that is either in Queue ('Q') or Accepted ('A')
        boolean isAlreadyProcessingOrCompleted = commonRequestRepository.existsByRequestTypeAndStatusIn(
                "YEAR_END_PROFIT_TRANSFER",
                List.of("Q", "A") // Using modern Java List.of()
        );

        // Business Rule: If it exists in Q or A, return false (not eligible). Otherwise true.
        boolean isEligible = !isAlreadyProcessingOrCompleted;
        
        log.info("Year End Profit Transfer Eligibility: {}", isEligible);

        return YearEndTransferEligibilityDto.builder()
                .isEligible(isEligible)
                .build();
    }
}

