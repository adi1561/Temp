CREATE TABLE ASCII_CONFIG (
    REPORT_ID               VARCHAR2(50) PRIMARY KEY, -- 'nwsa'
    FILE_TYPE               VARCHAR2(10),             -- Extension e.g., '.txt'
    INPUT_FILE_NAME         VARCHAR2(100),            -- Input file name/pattern
    OUTPUT_FIRST_LINE       VARCHAR2(100),            -- Fixed Header Prefix
    OUTPUT_END_LINE         VARCHAR2(100),            -- Fixed Footer text
    
    -- INPUT IDENTIFICATION
    INPUT_HEAD_COL          NUMBER,                   -- Column index (1-based) for Head
    INPUT_HEAD_REGEX        VARCHAR2(200),            -- Regex to identify valid rows
    
    -- PROCESSING RULES
    OUTPUT_HEAD_COL_PAD     VARCHAR2(50),             -- e.g., '5L0', '6R '
    AMOUNT_COL_SEQ          VARCHAR2(50),             -- '3', '5else6', '5and1'
    
    -- COMPLEX LOGIC COLUMNS (Pipe separated rules: [Regex][Col][Logic])
    OUTPUT_AMT_COL_LOGIC    VARCHAR2(4000),           -- e.g. ["^S"][3][/(1000)]
    OUTPUT_AMT_DECIMAL      VARCHAR2(4000),           -- e.g. ["^.*"][3][2] (2 decimal places)
    OUTPUT_AMT_COL_PAD      VARCHAR2(4000),           -- e.g. ["^.*"][3][16,2]
    OUTPUT_AMT_SIGN         VARCHAR2(4000),           -- e.g. ["^.*"][3][NO_SIGN]
    
    OUTPUT_PER_LINE_HEAD    NUMBER,                   -- Batch size per line
    CREATED_DATE            TIMESTAMP DEFAULT SYSDATE
);

COMMENT ON COLUMN ASCII_CONFIG.OUTPUT_HEAD_COL_PAD IS 'Format: Length + Direction(L/R) + Char. E.g. 5L0 = 5 chars, Left Pad with 0';
COMMENT ON COLUMN ASCII_CONFIG.AMOUNT_COL_SEQ IS 'Logic: 3 (Col 3), 5else6 (Col 5 if valid else 6), 5and1 (Col 5 then Col 1)';
COMMENT ON COLUMN ASCII_CONFIG.OUTPUT_AMT_COL_LOGIC IS 'Format: [HeadRegex][ColIndex][Operation]. Ops: /1000, *(-1)';

