  const handleOpenSummary = (row) => {
    const safeParse = (jsonString) => {
      try {
        return jsonString ? JSON.parse(jsonString) : null;
      } catch (e) {
        console.error("JSON Parsing Error:", e);
        return null;
      }
    };

    // 1. Identify the single source of truth (the stage holding the JSON payload)
    const mainStage = row?.stages?.find(
      (s) => s.stageId === "balance_Compare_generated" 
    );

    if (!mainStage?.summary) {
      snackbar("Summary not available", "warning");
      return;
    }

    // 2. Parse the payload exactly ONCE
    const payload = safeParse(mainStage.summary) || {};

    setSummaryMeta(row);

    // 3. Map the data directly to your state using the EXACT keys from the backend
    setSummaryData({
      RECON_RUN_DATE: payload.date || "",
      
      // Standard practice: map strictly to the expected backend keys
      differenceSummary: payload.differenceSummary || [],
      sibaSummary: payload.sibaSummary || [],
      suspenseSummary: payload.suspenseSummary || [],
      
      stages: row?.stages || [],
    });
  };
