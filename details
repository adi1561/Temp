import React, { useState, useRef, useEffect, useCallback } from "react";
import {
  Box,
  Button,
  Typography,
  CircularProgress,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  TablePagination,
  Dialog,
  DialogTitle,
  DialogContent,
  IconButton,
  Tooltip,
  DialogActions,
  Chip,
  useTheme,
} from "@mui/material";
import {
  PlayArrow as PlayArrowIcon,
  Close as CloseIcon,
  Assessment as SummaryIcon,
  Inbox as NoDataIcon,
  Download as DownloadIcon, // Added for Excel button
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";

// --- API Constants ---
const TRIGGER_API_URL = "/PS/airflow/trigger";
const INITIAL_DATA_URL = "/PS/process/processes/data/7";
const SUMMARY_BASE_URL = "/CM/lho-transfers/summary/";
const CREATE_REQUEST_URL = "/CR/create-request";
const DOWNLOAD_URL = "/RS/reports/generate/base64";

export default function YearEndProfitTransferTab1() {
  const theme = useTheme();
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  // Table & Loading States
  const [isTransferring, setIsTransferring] = useState(false);
  const [tableData, setTableData] = useState([]);
  const [totalElements, setTotalElements] = useState(0);
  const [isInitialLoading, setIsInitialLoading] = useState(true);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  // Summary & Submission States
  const [summaryOpen, setSummaryOpen] = useState(false);
  const [summaryData, setSummaryData] = useState([]);
  const [summaryTotals, setSummaryTotals] = useState({
    totalAmount: 0,
    totalRecordCount: 0,
  });
  const [summaryLoading, setSummaryLoading] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);

  const [rowContext, setRowContext] = useState({
    processRunId: null,
    processId: null,
    runId: null,
  });

  const getTodayFormatted = () => new Date().toISOString().split("T")[0];

  const formatProcessTime = (dateString) => {
    if (!dateString) return "-";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
    })
      .format(date)
      .replace(",", "");
  };

  /**
   * DATA FETCHING
   */
  const fetchInitialData = useCallback(
    async (isPolling = false) => {
      if (!isPolling) setIsInitialLoading(true);
      try {
        const paginatedUrl = `${INITIAL_DATA_URL}`;
        const response = await callApi(paginatedUrl, null, "GET");
        if (isMounted.current && response) {
          setTableData(response.initialData || []);
          setTotalElements(
            response.totalElements || response.initialData?.length || 0,
          );
        }
      } catch (error) {
        if (!isPolling && error !== undefined) {
          const errorMessage = error?.message || "Failed to load process data";
          showSnackBar(errorMessage, "error");
        }
      } finally {
        if (isMounted.current && !isPolling) setIsInitialLoading(false);
      }
    },
    [callApi, showSnackBar],
  );

  useEffect(() => {
    isMounted.current = true;
    fetchInitialData();
    return () => {
      isMounted.current = false;
    };
  }, [fetchInitialData, page, rowsPerPage]);

  useEffect(() => {
    const pollInterval = setInterval(() => {
      fetchInitialData(true);
    }, 10000);

    return () => clearInterval(pollInterval);
  }, [fetchInitialData, page, rowsPerPage]);

  const handleTransferLho = async () => {
    setIsTransferring(true);
    const payload = {
      dagId: "cbs_wrap_dag",
      processId: 7,
      remarks: "testing 1",
    };

    try {
      await callApi(TRIGGER_API_URL, payload, "POST");
      showSnackBar("LHO Transfer triggered successfully", "success");
      fetchInitialData();
    } catch (error) {
      const errorMessage = error?.message || "Failed to trigger LHO Transfer";
      showSnackBar(errorMessage, "warning");
    } finally {
      setIsTransferring(false);
    }
  };

  const handleSubmitLhoRequest = async () => {
    setIsSubmitting(true);
    const finalRequestPayload = {
      requestType: "YEAR_END_PROFIT_TRANSFER",
      changeType: "ADD",
      targetId: null,
      payload: {
        processRunId: rowContext.processRunId,
        processId: rowContext.processId,
        batchId: String(rowContext.runId),
        date: getTodayFormatted(),
        totalAmount: summaryTotals.totalAmount,
        totalRecordCount: summaryTotals.totalRecordCount,
        circleWiseDetails: summaryData.map((item) => ({
          transferDate: getTodayFormatted(),
          circleName: item.circleName,
          totalProfitLoss: Number(item.totalProfitLoss),
        })),
      },
    };

    try {
      await callApi(CREATE_REQUEST_URL, finalRequestPayload, "POST");
      showSnackBar("LHO Transfer Request Submitted Successfully", "success");
      setSummaryOpen(false);
    } catch (error) {
      const errorMessage =
        error?.message || "Submission failed. Check network/payload";
      showSnackBar(errorMessage, "warning");
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleGetSummary = async (row) => {
    setSummaryOpen(true);
    setSummaryLoading(true);
    setRowContext({
      processRunId: row.processRunId,
      processId: row.processId,
      runId: row.runId,
    });

    try {
      const response = await callApi(
        `${SUMMARY_BASE_URL}${row.processRunId}`,
        null,
        "GET",
      );

      // Navigate through the new response structure
      const responseData = response?.data || {};
      const rawMap = responseData.circleWiseDetails || {};

      setSummaryTotals({
        totalAmount: responseData.totalAmount || 0,
        totalRecordCount: responseData.totalRecordCount || 0,
      });

      // Mapped name to circleName
      setSummaryData(
        Object.entries(rawMap).map(([name, balance]) => ({
          circleName: name,
          totalProfitLoss: balance,
        })),
      );
    } catch (error) {
      const errorMessage = error?.message || "Could not fetch summary data";
      showSnackBar(errorMessage, "error");
    } finally {
      setSummaryLoading(false);
    }
  };

  const handleDownload = async () => {
    try {
      const payload = {
        reportType: "profit_transfer_report",
        date: "31-03-2026"
      };
      const responseData = await callApi(DOWNLOAD_URL, payload, "POST");
      const { reportName, reportDate, excelBase64 } = responseData;

      if (!excelBase64) {
        showSnackBar("Failed to download file", "error");
        return;
      }

      let fileName = reportName + "_" + reportDate;
      downloadFile(responseData?.excelBase64, "excel", fileName, true);
    } catch (err) {
      console.error(err);
      showSnackBar("Error while downloading file", "error");
    }
  };

  const getStatusChip = (s) => {
    if (s === 1)
      return (
        <Chip
          label="In Progress"
          color="primary"
          variant="outlined"
          size="small"
        />
      );
    if (s === 2) return <Chip label="Profit Calculated" color="success" size="small" />;
    if (s === 3) return <Chip label="Failed" color="error" size="small" />;
    return <Chip label="Unknown" variant="outlined" size="small" />;
  };

  // Check if any process is currently running
  const isAnyProcessRunning = tableData.some((row) => row.status === 2);

  return (
    <Box p={3} width="100%">
      {/* Header Action */}
      <Box display="flex" justifyContent="flex-end" mb={2}>
        <Button
          variant="contained"
          startIcon={
            isTransferring ? (
              <CircularProgress size={20} color="inherit" />
            ) : (
              <PlayArrowIcon />
            )
          }
          onClick={handleTransferLho}
          disabled={isTransferring || isInitialLoading || isAnyProcessRunning}
        >
          {isTransferring ? "Transferring..." : "Transfer LHO"}
        </Button>
      </Box>

      {/* Main Table */}
      <TableContainer component={Paper}>
        <Table>
          <TableHead sx={{ bgcolor: theme.palette.action.hover }}>
            <TableRow>
              <TableCell align="center">
                <strong>Process Name</strong>
              </TableCell>
              <TableCell align="center">
                <strong>Profit Calulation</strong>
              </TableCell>
              <TableCell align="center">
                <strong>Start Time</strong>
              </TableCell>
              <TableCell align="center">
                <strong>End Time</strong>
              </TableCell>
              <TableCell align="center">
                <strong>Action</strong>
              </TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {isInitialLoading ? (
              <TableRow>
                <TableCell colSpan={5} align="center" sx={{ py: 6 }}>
                  <CircularProgress size={40} />
                </TableCell>
              </TableRow>
            ) : tableData.length === 0 ? (
              <TableRow>
                <TableCell colSpan={5} align="center" sx={{ py: 6 }}>
                  <NoDataIcon
                    sx={{ fontSize: 48, color: "text.disabled", mb: 1 }}
                  />
                  <Typography variant="body1" color="text.secondary">
                    There is no data to show.
                  </Typography>
                </TableCell>
              </TableRow>
            ) : (
              tableData
                .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
                .map((row) => (
                  <TableRow key={row.processRunId}>
                    <TableCell align="center">{row.processType}</TableCell>
                    <TableCell align="center">
                      {getStatusChip(row.status)}
                    </TableCell>
                    <TableCell align="center">
                      {formatProcessTime(row.processStartTime)}
                    </TableCell>
                    <TableCell align="center">
                      {formatProcessTime(row.processEndTime)}
                    </TableCell>
                    <TableCell align="center">
                      <Tooltip
                        title={
                          row.status === 2 ? "Get Summary" : "Not Available"
                        }
                      >
                        <span>
                          <IconButton
                            size="small"
                            disabled={row.status !== 2}
                            onClick={() => handleGetSummary(row)}
                            color="primary"
                          >
                            <SummaryIcon />
                          </IconButton>
                        </span>
                      </Tooltip>
                    </TableCell>
                  </TableRow>
                ))
            )}
          </TableBody>
        </Table>
        <TablePagination
          component="div"
          count={totalElements}
          page={page}
          onPageChange={(e, p) => setPage(p)}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={(e) => {
            setRowsPerPage(parseInt(e.target.value, 10));
            setPage(0);
          }}
        />
      </TableContainer>

      {/* --- SUMMARY DIALOG --- */}
      <Dialog
        open={summaryOpen}
        onClose={() => setSummaryOpen(false)}
        fullWidth
        maxWidth="sm"
      >
        <DialogTitle sx={{ m: 0, p: 2 }}>
          Circle Wise Summary
          <IconButton
            onClick={() => setSummaryOpen(false)}
            sx={{ position: "absolute", right: 8, top: 8 }}
          >
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent dividers>
          {summaryLoading ? (
            <Box display="flex" justifyContent="center" py={5}>
              <CircularProgress />
            </Box>
          ) : (
            <>
              <TableContainer component={Paper} sx={{ maxHeight: 400 }}>
                <Table size="small" stickyHeader>
                  <TableHead>
                    <TableRow>
                      <TableCell
                        align="left"
                        sx={{ bgcolor: theme.palette.action.hover }}
                      >
                        <strong>Circle Name</strong>
                      </TableCell>
                      {/* Changed to align Right */}
                      <TableCell
                        align="right"
                        sx={{ bgcolor: theme.palette.action.hover }}
                      >
                        <strong>Balance</strong>
                      </TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {summaryData.map((row, idx) => (
                      <TableRow key={idx}>
                        <TableCell align="left">{row.circleName}</TableCell>
                        {/* Changed to align Right */}
                        <TableCell align="right" sx={{ fontWeight: "bold" }}>
                          {Number(row.totalProfitLoss).toLocaleString("en-IN", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                          })}
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            </>
          )}
        </DialogContent>
        <DialogActions sx={{ p: 2, justifyContent: "space-between" }}>
          <Button
            variant="outlined"
            startIcon={<DownloadIcon />}
            onClick={handleDownload}
            disabled={summaryData.length === 0}
          >
            Download Excel
          </Button>

          <Button
            variant="contained"
            disabled={summaryData.length === 0 || isSubmitting}
            onClick={handleSubmitLhoRequest}
            startIcon={
              isSubmitting && <CircularProgress size={16} color="inherit" />
            }
          >
            {isSubmitting ? "Submitting..." : "Submit Request"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}

import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  Typography,
  Tooltip,
  IconButton,
} from "@mui/material";
import useApi from "../../hooks/useApi";
import CancelIcon from "@mui/icons-material/Cancel";
import VisibilityIcon from "@mui/icons-material/Visibility";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import BlockFlippedIcon from "@mui/icons-material/BlockFlipped";
import GppBadIcon from "@mui/icons-material/GppBad";
import InfoIcon from "@mui/icons-material/Info";
import { DataGridStyles } from "./YearEndProfitTransferStyles";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import {
  getPermissions,
  timeStampFormatter,
} from "../../utils/CommonUtilities";
import CustomChip from "../../utils/CustomChip";
import { COMMON_REQ_SCREEN_CONFIGS } from "../common/CommonConstants";
import ViewRequestDialog from "../common/ViewRequestDailog";

export default function YearEndProfitTransferTab2() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const requestType = selectedMenuItem?.requestType || "";
  const permissions = getPermissions(selectedMenuItem);
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const screenConfig = COMMON_REQ_SCREEN_CONFIGS[selectedMenuItem?.id];
  const { processViewData } = screenConfig || {};

  function CustomNoRowsOverlay() {
    return (
      <Stack height="100%" alignItems="center" justifyContent="center">
        <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
        <Typography variant="h6">No Segment Requests Found</Typography>
        <Typography>You have not created any Segment requests.</Typography>
      </Stack>
    );
  }

  const fetchData = useCallback(async () => {
    const payload = { requestType };
    const response = await callApi("/CR/my-requests", payload, "POST");
    if (response?.data) {
      const result = response.data.map((row) => {
        let parsedPayload = row.payload ? row.payload : {};
        parsedPayload = {
          ...parsedPayload,
          ...row,
        };

        return {
          ...parsedPayload,
        };
      });

      setRows(result);
    } else {
      setRows([]);
    }
  }, [callApi, requestType]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        remarks: "User canceled this Request",
      };

      const response = await callApi("/CR/cancel-request", payload, "PATCH");
      if (response?.success) {
        showSnackBar(
          `Request Id ${requestId} Cancelled Successfully.`,
          "success",
        );
      } else {
        showSnackBar(
          response?.message
            ? response?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.error(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = (data) => {
    console.log(data);
    const view = processViewData ? processViewData(data) : data;
    console.log(view);
    delete view.payload.ShowDownload;
    setViewData(view);
    setViewOpen(true);
  };

  const columns = useMemo(
    () => [
      { field: "id", headerName: "Request Id", flex: 0.5 },
      {
        field: "Name",
        headerName: "Process Name",
        flex: 0.8,
        sortable: true,
        renderCell: () => "Year End Profit Transfer",
      },
      {
        field: "reqDate",
        headerName: "Requested Date",
        flex: 1,
        align: "center",
        headerAlign: "center",
        filterable: false,
        disableColumnMenu: true,
        renderCell: (params) => timeStampFormatter(params.value),
      },
      {
        field: "reqStatus",
        headerName: "Status",
        flex: 1,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            sx={{
              color:
                params.value === "REJECTED"
                  ? "error.main"
                  : params.value === "ACCEPTED"
                    ? "success.dark"
                    : "warning.main",
              fontWeight: "bold",
            }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.light",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.light",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.6,
        justifyContent: "center",
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          return (
            <Stack
              direction="row"
              spacing={1}
              justifyContent="center"
              alignItems="center"
              sx={{ ml: 2, mt: 0.5 }}
            >
              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    // color="primary"
                    onClick={() => handleViewClick(params.row)}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {params.row.reqStatus === "PENDING" && permissions.cancel && (
                <Tooltip title={"Cancel Request"}>
                  <IconButton
                    onClick={() => {
                      setConfirmDialog(true);
                      setRequestId(params.row.id);
                    }}
                  >
                    <CancelIcon fontSize="inherit" />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [permissions.cancel, permissions.view],
  );

  const filteredColumns = useMemo(() => {
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions]);

  return (
    <Box p={3}>
      <DataGridStyles
        rows={rows}
        columns={filteredColumns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          // sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
        }}
        getRowId={(row) => row.id}
        slots={{
          noRowsOverlay: CustomNoRowsOverlay,
        }}
      />

      {/* View Request Dialog */}
      <ViewRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* Cancel Dialog */}
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          Cancel Request ID: {requestId}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}




