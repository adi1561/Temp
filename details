}
class Derived extends Base {
    int x = 20;
    void show() { System.out.println("Derived: " + x); }
    void display() { System.out.println(super.x); }
}
public class Main {
    public static void main(String[] args) {
        Base obj = new Derived();
        obj.show();
        ((Derived) obj).display();
    }
}
