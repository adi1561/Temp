@Override
@Transactional
public Object getOrGenerateLhoSummary(Long id) {
    log.info("Processing LHO Summary request for ID: {}", id);

    // --- STEP 1: CACHE CHECK ---
    Optional<LhoTransferSummary> cached = lhoSummaryRepository.findById(id);
    if (cached.isPresent()) {
        try {
            JsonNode node = objectMapper.readTree(cached.get().getPayload());
            // Check if it's the new structure and has a valid totalAmount
            if (node.has("circleWiseDetails") && node.get("totalAmount").asDouble() != 0) {
                return objectMapper.treeToValue(node, LhoSummaryResponseDto.class);
            }
        } catch (Exception e) {
            log.warn("Refreshing cache for ID: {}", id);
        }
    }

    // --- STEP 2: AGGREGATE ---
    List<Object[]> aggregatedData = plTransferRepository.getAggregatedSummary();
    if (aggregatedData.isEmpty()) {
        return LhoSummaryResponseDto.builder()
                .totalAmount(BigDecimal.ZERO.setScale(2, RoundingMode.HALF_UP))
                .totalRecordCount(0)
                .circleWiseDetails(Collections.emptyMap())
                .build();
    }

    // --- STEP 3: MAPPING & CALCULATION ---
    Map<String, BigDecimal> summaryMap = new HashMap<>();
    BigDecimal runningTotal = BigDecimal.ZERO; // Use a fresh variable

    for (Object[] row : aggregatedData) {
        String branchCode = String.valueOf(row[0]);
        
        // Convert with high precision
        BigDecimal totalPL = (row[1] != null)
                ? new BigDecimal(row[1].toString())
                : BigDecimal.ZERO;

        // CRITICAL FIX: Reassign the addition result back to the variable
        runningTotal = runningTotal.add(totalPL);
        
        summaryMap.put(branchCode, totalPL.setScale(2, RoundingMode.HALF_UP));
    }

    // --- STEP 4: CONSTRUCT RESPONSE ---
    LhoSummaryResponseDto responseDto = LhoSummaryResponseDto.builder()
            .totalAmount(runningTotal.setScale(2, RoundingMode.HALF_UP))
            .totalRecordCount(summaryMap.size())
            .circleWiseDetails(summaryMap)
            .build();

    // --- STEP 5: PERSIST ---
    try {
        String jsonPayload = objectMapper.writeValueAsString(responseDto);
        LhoTransferSummary summaryEntity = LhoTransferSummary.builder()
                .id(id)
                .payload(jsonPayload)
                .build();

        lhoSummaryRepository.save(summaryEntity);
        return responseDto;
    } catch (Exception e) {
        log.error("Serialization failed: {}", e.getMessage());
        throw new RuntimeException("Error persisting LHO Summary.");
    }
}
