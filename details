import React, { useState, useRef, useEffect } from "react";
import {
  Box, Button, Typography, CircularProgress, Table, TableBody,
  TableCell, TableContainer, TableHead, TableRow, Paper,
  TablePagination, Dialog, DialogTitle, DialogContent, IconButton,
  Tooltip, DialogActions
} from "@mui/material";
import {
  PlayArrow as PlayArrowIcon,
  Close as CloseIcon,
  Assessment as SummaryIcon,
  Replay as RetryIcon,
  RestartAlt as RestartIcon
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const TRIGGER_API_URL = "/PS/airflow/trigger";
const INITIAL_DATA_URL = "/PS/process/processes/data/7";
const SUMMARY_BASE_URL = "/YE/yearend/summary/";

export default function TransferDataLho() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  const [isTransferring, setIsTransferring] = useState(false);
  const [tableData, setTableData] = useState([]);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  const [summaryOpen, setSummaryOpen] = useState(false);
  const [summaryData, setSummaryData] = useState([]); 
  const [summaryLoading, setSummaryLoading] = useState(false);
  const [currentSelectedId, setCurrentSelectedId] = useState(null);

  const [summaryPage, setSummaryPage] = useState(0);
  const [summaryRowsPerPage, setSummaryRowsPerPage] = useState(5);

  // ---------------- MOCK DATA FOR TESTING ----------------
  const dummyInitialData = [
    {
      processRunId: 370,
      processId: 7,
      etlDate: "2025-11-21",
      runId: 2,
      processType: "Transfer To LHO",
      isLatest: true,
      runVersion: 1
    },
    {
      processRunId: 368,
      processId: 7,
      etlDate: "2025-11-21",
      runId: 1,
      processType: "Transfer To LHO",
      isLatest: true,
      runVersion: 1
    }
  ];

  const fetchInitialData = async () => {
    try {
      // Attempting API call
      const response = await callApi(INITIAL_DATA_URL, null, "GET");
      if (isMounted.current && response && response.initialData) {
        const formattedData = response.initialData.map(item => ({
          ...item,
          isLatest: true,
          runVersion: 1
        }));
        setTableData(formattedData);
      } else {
        // Fallback to dummy data if response is empty
        setTableData(dummyInitialData);
      }
    } catch (error) {
      console.warn("Server down. Loading dummy testing data.");
      setTableData(dummyInitialData);
    }
  };

  useEffect(() => {
    isMounted.current = true;
    fetchInitialData();
    return () => { isMounted.current = false; };
  }, []);

  // ---------------- ACTION HANDLERS ----------------

  const handleTransferLho = async () => {
    setIsTransferring(true);
    try {
      await callApi(TRIGGER_API_URL, { dagId: "cbs_wrap_dag", processId: 7 }, "POST");
      showSnackBar("LHO Transfer triggered", "success");
    } catch (error) {
      showSnackBar("Trigger failed (Mock mode active)", "info");
    } finally {
      setIsTransferring(false);
    }
  };

  const handleGetSummary = async (processRunId) => {
    setSummaryOpen(true);
    setSummaryLoading(true);
    setCurrentSelectedId(processRunId);
    
    try {
      const response = await callApi(`${SUMMARY_BASE_URL}${processRunId}`, null, "GET");
      const rawMap = response?.data || { 
        "3971": 111755000.0000, 
        "4002": 0.0000, 
        "3978": 71610000.0000 
      }; // Dummy Map if server is down

      const formattedSummary = Object.entries(rawMap).map(([code, balance]) => ({
        circleBranchCode: code,
        totalProfitLoss: balance
      }));

      setSummaryData(formattedSummary);
    } catch (error) {
      // Dummy summary data for UI testing
      const mockSummary = { "3971": 111755000.0000, "4002": 0.0000 };
      setSummaryData(Object.entries(mockSummary).map(([code, bal]) => ({ 
        circleBranchCode: code, totalProfitLoss: bal 
      })));
    } finally {
      setSummaryLoading(false);
    }
  };

  const handleRetry = (row, index) => {
    const updatedTable = [...tableData];
    updatedTable[index].isLatest = false;

    const nextRunNumber = (row.runVersion || 1) + 1;
    const newRow = {
      ...row,
      processRunId: row.processRunId + 1, 
      runId: nextRunNumber,
      runVersion: nextRunNumber,
      isLatest: true,
      processType: `${row.processType} (Run ${nextRunNumber})`
    };

    updatedTable.splice(index + 1, 0, newRow);
    setTableData(updatedTable);
    showSnackBar(`Retry run ${nextRunNumber} generated locally`, "success");
  };

  const handleRestart = () => {
    fetchInitialData();
    showSnackBar("Local state reset", "info");
  };

  return (
    <Box p={3} width="100%">
      <Box display="flex" justifyContent="flex-end" mb={2}>
        <Button
          variant="contained"
          startIcon={isTransferring ? <CircularProgress size={20} color="inherit" /> : <PlayArrowIcon />}
          onClick={handleTransferLho}
          disabled={isTransferring}
        >
          {isTransferring ? "Transferring..." : "Transfer LHO"}
        </Button>
      </Box>

      <TableContainer component={Paper}>
        <Table>
          <TableHead>
            <TableRow>
              <TableCell align="center"><strong>Process Run ID</strong></TableCell>
              <TableCell align="center"><strong>Process ID</strong></TableCell>
              <TableCell align="center"><strong>ETL Date</strong></TableCell>
              <TableCell align="center"><strong>Process Type</strong></TableCell>
              <TableCell align="center"><strong>Action</strong></TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {tableData
              .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
              .map((row, index) => (
                <TableRow key={row.processRunId}>
                  <TableCell align="center">{row.processRunId}</TableCell>
                  <TableCell align="center">{row.processId}</TableCell>
                  <TableCell align="center">{row.etlDate}</TableCell>
                  <TableCell align="center">{row.processType}</TableCell>
                  <TableCell align="center">
                    <Box display="flex" justifyContent="center" gap={1}>
                      <Tooltip title="Get Summary">
                        <IconButton size="small" onClick={() => handleGetSummary(row.processRunId)}>
                          <SummaryIcon />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title="Retry">
                        <span>
                          <IconButton 
                            size="small" 
                            disabled={!row.isLatest} 
                            onClick={() => handleRetry(row, index + (page * rowsPerPage))}
                          >
                            <RetryIcon />
                          </IconButton>
                        </span>
                      </Tooltip>
                      <Tooltip title="Restart">
                        <IconButton size="small" onClick={handleRestart}>
                          <RestartIcon />
                        </IconButton>
                      </Tooltip>
                    </Box>
                  </TableCell>
                </TableRow>
              ))}
          </TableBody>
        </Table>
        <TablePagination
          component="div"
          count={tableData.length}
          page={page}
          onPageChange={(e, newPage) => setPage(newPage)}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={(e) => {
            setRowsPerPage(parseInt(e.target.value, 10));
            setPage(0);
          }}
          rowsPerPageOptions={[10, 25, 50]}
        />
      </TableContainer>

      {/* SUMMARY DIALOG remains as per previous optimized version */}
      <Dialog open={summaryOpen} onClose={() => setSummaryOpen(false)} fullWidth maxWidth="sm">
        <DialogTitle>
          Circle Wise Summary (ID: {currentSelectedId})
          <IconButton onClick={() => setSummaryOpen(false)} sx={{ position: 'absolute', right: 8, top: 8 }}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent dividers>
          {summaryLoading ? (
            <Box display="flex" justifyContent="center" py={5}><CircularProgress /></Box>
          ) : (
            <>
              <TableContainer component={Paper} sx={{ mb: 1 }}>
                <Table size="small">
                  <TableHead>
                    <TableRow>
                      <TableCell align="center"><strong>Circle Branch Code</strong></TableCell>
                      <TableCell align="center"><strong>Balance</strong></TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {summaryData.length > 0 ? (
                      summaryData
                        .slice(summaryPage * summaryRowsPerPage, summaryPage * summaryRowsPerPage + summaryRowsPerPage)
                        .map((row, index) => (
                          <TableRow key={index}>
                            <TableCell align="center">{row.circleBranchCode}</TableCell>
                            <TableCell align="center">
                              {Number(row.totalProfitLoss).toLocaleString('en-IN', {
                                minimumFractionDigits: 4,
                                maximumFractionDigits: 4
                              })}
                            </TableCell>
                          </TableRow>
                        ))
                    ) : (
                      <TableRow><TableCell colSpan={2} align="center">No Data Available</TableCell></TableRow>
                    )}
                  </TableBody>
                </Table>
              </TableContainer>
              <TablePagination
                component="div"
                count={summaryData.length}
                page={summaryPage}
                onPageChange={(e, p) => setSummaryPage(p)}
                rowsPerPage={summaryRowsPerPage}
                onRowsPerPageChange={(e) => setSummaryRowsPerPage(parseInt(e.target.value, 10))}
                rowsPerPageOptions={[5, 10]}
              />
            </>
          )}
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button variant="outlined" onClick={() => setSummaryOpen(false)}>Close</Button>
          <Button variant="contained" onClick={() => { showSnackBar("Submitted Successfully", "success"); setSummaryOpen(false); }}>
            Submit Summary
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
