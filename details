Update the Repository (ProfitLossRepository.java):
package com.fincore.YearEndService.Repository;

import com.fincore.YearEndService.DTO.IProfitLossSummary;
import com.fincore.YearEndService.Model.ProfitLossTransfer;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface ProfitLossRepository extends JpaRepository<ProfitLossTransfer, Long> {

    // Updated to use the native LEFT JOIN query to fetch CIRCLE_NAME
    @Query(value = "SELECT cm.CIRCLE_NAME as circleName, " +
            "SUM(p.PROFIT_LOSS) as totalProfitLoss " +
            "FROM PROFIT_LOSS_TRANSFER p " +
            "LEFT JOIN CIRCLE_MASTER cm ON cm.BRANCH_CODE = LPAD(p.CIRCLE_BRANCH_CODE, 5, '0') " +
            "GROUP BY cm.CIRCLE_NAME", nativeQuery = true)
    List<IProfitLossSummary> findProfitLossSummaryGroupedByCircle();
}

Once you update these DTOs and restart your Spring Boot application, your POST request will map the JSON perfectly, and you will see "circleName": "MUMBAI METRO" saved beautifully into the PAYLOAD column in your COMMON_REQ table without any null values!
