    @Override
    public void processRejection(CommonReq request) {
        
        // 1. INTERCEPT THE "QUEUE" STATUS (Because RequestServiceImpl routes it here)
        if (RequestStatus.QUEUE.equals(request.getReqStatus())) {
            log.info("Intercepted QUEUE status in processRejection. Routing to Approval Logic...");
            handleLhoApproval(request);
            return; // Exit early
        }
        
        // 2. PROCESS THE ACTUAL "REJECTED" STATUS
        if (RequestStatus.REJECTED.equals(request.getReqStatus())) {
            log.info("Processing Rejection for Batch: {}. Clearing related tables.", request.getTargetId());

            try {
                JsonNode payloadNode = objectMapper.readTree(request.getPayload());
                
                if (!payloadNode.has("etlDate") || payloadNode.get("etlDate").isNull()) {
                     throw new IllegalArgumentException("CRITICAL: etlDate is missing. Cannot safely delete records.");
                }
                
                String etlDate = payloadNode.get("etlDate").asText(); 
                
                // Define the SQL statements for all 3 tables
                // (Assuming they all use TRANSFER_DATE as the column. Change the column name if needed!)
                String sql1 = "DELETE FROM P_L_TRANSFER WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')";
                String sql2 = "DELETE FROM YOUR_SECOND_TABLE_NAME WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')"; 
                String sql3 = "DELETE FROM YOUR_THIRD_TABLE_NAME WHERE TRUNC(TRANSFER_DATE) = TO_DATE(?, 'YYYY-MM-DD')"; 

                // Execute the deletions sequentially
                int rowsAffected1 = jdbcTemplate.update(sql1, etlDate);
                int rowsAffected2 = jdbcTemplate.update(sql2, etlDate);
                int rowsAffected3 = jdbcTemplate.update(sql3, etlDate);

                log.info("Successfully cleared data for rejected request {}. Rows deleted -> P_L_TRANSFER: {}, Table2: {}, Table3: {}", 
                         request.getId(), rowsAffected1, rowsAffected2, rowsAffected3);

            } catch (Exception e) {
                log.error("CRITICAL: Failed to clear tables during rejection of request: {}", request.getId(), e);
                // Throwing this ensures the @Transactional annotation rolls back ALL deletions if any single one fails
                throw new RuntimeException("Failed to clear tables on rejection", e);
            }
        }
    }
