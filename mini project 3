🧠 4. The Service (The Logic Fix) 🛠️
Package: org.example.demo1.service
Here is the clean loop logic.
package org.example.demo1.service;

import org.example.demo1.dto.OrderRequest;
import org.example.demo1.dto.OrderResponse;
import org.example.demo1.model.FoodItem;
import org.example.demo1.model.FoodOrder;
import org.example.demo1.repository.OrderRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class OrderService {

    @Autowired
    private OrderRepo orderRepo;

    public OrderResponse createOrder(OrderRequest request) {

        // 1. Create Parent
        FoodOrder order = new FoodOrder();
        order.setCustomerName(request.getCustomerName());
        order.setDeliveryAddress(request.getDeliveryAddress());

        // 2. Attach the List (Critical Step!)
        order.setItems(request.getItems());

        // 3. Calculate Total (The Loop)
        double calculatedTotal = 0;
        
        // "For every 'item' inside the list..."
        for (FoodItem item : request.getItems()) {
            calculatedTotal = calculatedTotal + item.getPrice();
        }
        
        order.setTotalAmount(calculatedTotal);

        // 4. Save (Saves Order AND Items)
        FoodOrder savedOrder = orderRepo.save(order);

        // 5. Convert to Response
        OrderResponse response = new OrderResponse();
        response.setOrderId(savedOrder.getId());
        response.setCustomerName(savedOrder.getCustomerName());
        response.setTotalAmount(savedOrder.getTotalAmount());
        response.setStatus("PREPARING");

        return response;
    }
}

🚦 5. The Controller
Package: org.example.demo1.controller
package org.example.demo1.controller;

import org.example.demo1.dto.OrderRequest;
import org.example.demo1.dto.OrderResponse;
import org.example.demo1.service.OrderService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
public class OrderController {

    @Autowired
    private OrderService orderService;

    @PostMapping("/order")
    public ResponseEntity<OrderResponse> placeOrder(@RequestBody OrderRequest request) {
        OrderResponse response = orderService.createOrder(request);
        return new ResponseEntity<>(response, HttpStatus.CREATED);
    }
}

