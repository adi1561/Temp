    private RedisTemplate<String, byte[]> redisTemplate;

    @Autowired
    @Lazy
    private VoucherBulkValidationService self;

    // ==================================================================================
    // 1. REDIS STATE MANAGEMENT
    // ==================================================================================
    private void saveStatusToRedis(String reqId, BulkUploadStateDto state) {
        try {
            byte[] json = objectMapper.writeValueAsBytes(state);
            redisTemplate.opsForValue().set("BULK_STATUS_" + reqId, json, 2, TimeUnit.HOURS);
        } catch (JsonProcessingException e) {
            log.error("SERIALIZATION_FAIL | ReqID: {} | Status: Object mapping error", reqId);
        } catch (DataAccessException e) {
            log.error("REDIS_WRITE_FAIL | ReqID: {} | Status: Connection/Persistence failure", reqId);
        }
    }
    private BulkUploadStateDto getStatusFromRedis(String reqId) {
        try {
            byte[] json = redisTemplate.opsForValue().get("BULK_STATUS_" + reqId);
            if (json == null) return null;
            return objectMapper.readValue(json, BulkUploadStateDto.class);
        } catch (IOException | DataAccessException e) {
            log.error("REDIS_READ_FAIL | ReqID: {} | Type: {}", reqId, e.getClass().getSimpleName());
            return null;
        }
    }

    public BulkUploadStateDto getState(String reqId) {
        return getStatusFromRedis(reqId);
    }

    public byte[] getFileBytes(String reqId, String type) {
        try {
            return redisTemplate.opsForValue().get("FILE_" + reqId + "_" + type);
        } catch (DataAccessException e) {
            log.error("FILE_FETCH_FAIL | ReqID: {} | Type: {} | Error: Redis access failure", reqId, type);
            return null;
        }
    }

    public List<ExcelRowData> getValidRowsFromCache(String requestId) {
        long start = System.currentTimeMillis();

        // 1. Fetch metadata
        byte[] metaBytes = redisTemplate.opsForValue().get("DATA_META_" + requestId);
        if (metaBytes == null) {
            throw new CustomExceptions.CacheExpiredException("Validation data expired (TTL 1 Hour). Please re-upload.");
        }

        try {
            Map<String, Object> meta = objectMapper.readValue(metaBytes, new TypeReference<>() {});
            int totalChunks = (int) meta.get("totalChunks");
            int totalRows = (int) meta.get("totalRows");

            List<ExcelRowData> allRows = new ArrayList<>(totalRows);

            // 2. Fetch and decompress each chunk
            for (int i = 0; i < totalChunks; i++) {
                byte[] compressedChunk = redisTemplate.opsForValue().get("DATA_CHUNK_" + requestId + "_" + i);
                if (compressedChunk == null) {
                    throw new CustomExceptions.CacheExpiredException("Missing data chunk " + i + ". Please re-upload.");
                }

                try (GZIPInputStream gis = new GZIPInputStream(new ByteArrayInputStream(compressedChunk))) {
                    List<ExcelRowData> chunkRows = objectMapper.readValue(gis, new TypeReference<List<ExcelRowData>>() {});
                    allRows.addAll(chunkRows);
                }
            }

            log.info("CACHE_RETRIEVAL_SUCCESS | ReqID: {} | Rows: {} | Duration: {}ms",
                    requestId, allRows.size(), (System.currentTimeMillis() - start));
            return allRows;

        } catch (IOException | DataAccessException e) {
            log.error("DECOMPRESSION_FAIL | ReqID: {} | Status: Chunked stream corrupted", requestId);
            throw new CustomExceptions.FileProcessingException("Failed to reconstruct cached data", e);
        }
    }

    // ==================================================================================
    // 2. STREAMING INITIALIZATION & ASYNC LOOP
    // ==================================================================================

    public String initiateValidation(InputStream fileStream, String filename, LocalDate postingDate ) throws IOException {

        String reqId = UUID.randomUUID().toString();



        if (filename == null || (!filename.toLowerCase().endsWith(".csv") &&
                !filename.toLowerCase().endsWith(".txt") &&
                !filename.toLowerCase().endsWith(".xlsx"))) {
            log.error("UPLOAD_SECURITY_DENIED | Status: Invalid file extension");
            throw new CustomExceptions.FileProcessingException("Unsupported file type.");
        }

        String requestId = UUID.randomUUID().toString();
        Path tempFile = Files.createTempFile("UPLOAD_" + requestId + "_", ".tmp");

        try {
            Files.copy(fileStream, tempFile, StandardCopyOption.REPLACE_EXISTING);
        } catch (IOException e) {
            log.error("TEMP_FILE_CREATE_FAIL | ReqID: {} | Status: Disk IO failure", requestId);
            throw new CustomExceptions.FileProcessingException("Failed to secure uploaded file on disk.");
        }


        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1);
        state.setMessage("Initializing Upload...");
        state.setTotalRows(0);
        saveStatusToRedis(requestId, state);

        log.info("VALIDATION_INIT | ReqID: {} | Status: Temporary storage allocated", requestId);
        self.processAsync(requestId, tempFile.toString(), filename, postingDate);
        return requestId;
    }

    @Async("bulkExecutor")
    public void processAsync(String requestId, String tempFilePath, String filename, LocalDate postingDate) {
        MDC.put("requestId", requestId);
        long startTime = System.currentTimeMillis();
        File tempFile = new File(tempFilePath);

        try {
            updateState(requestId, s -> s.setMessage("Parsing File..."));

            ParsingResult parsingResult;
            boolean isCsv = filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"));

            try (InputStream is = new FileInputStream(tempFile)) {
                // Preserving your exact logic to switch between CSV and Excel parsing
                parsingResult = isCsv ? parseCsvStream(is, postingDate) : parseExcelStream(is, postingDate);
            }

            List<ExcelRowData> parsedRows = parsingResult.rows;

            if (parsedRows == null || parsedRows.isEmpty()) {
                throw new CustomExceptions.InvalidDataException("File data is empty. No transaction rows found.");
            }

            updateState(requestId, s -> {
                s.setTotalRows(parsedRows.size());
                s.setMessage("Validating Formats...");
            });

            // STAGE 1: FORMAT CHECK (Preserved Logic)
            runFormatCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Format Validation Failed", 1, parsingResult.hasProductColumn);
                return;
            }

            // STAGE 2: DATABASE CHECK (Preserved Logic)
            updateState(requestId, s -> {
                s.setCurrentStage(2);
                s.setMessage("Checking Database...");
            });
            runDbCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Database Validation Failed", 2, parsingResult.hasProductColumn);
                return;
            }

            // STAGE 3: BALANCE CHECK (Preserved Logic)
            updateState(requestId, s -> {
                s.setCurrentStage(3);
                s.setMessage("Checking Balances...");
            });
            runBalanceCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Debit/Credit Balance Mismatch", 3, parsingResult.hasProductColumn);
                return;
            }

            log.info("VALIDATION_SUCCESS | ReqID: {} | Duration: {}ms", requestId, (System.currentTimeMillis() - startTime));
            completeRequest(requestId, parsedRows, postingDate, isCsv, parsingResult.hasProductColumn);

        }
        // --- ALL ORIGINAL CATCH BLOCKS RESTORED EXACTLY ---
        catch (CustomExceptions.InvalidDataException e) {
            log.warn("EMPTY_DATA_REJECTED | ReqID: {} | Reason: {}", requestId, e.getMessage());
            handleAsyncCrash(requestId, e.getMessage());
        }
        catch (FileNotFoundException e) {
            handleAsyncCrash(requestId, "System Error: File not found in temporary storage.");
        } catch (IOException e) {
            handleAsyncCrash(requestId, "System Error: Failed to read file content.");
        } catch (DateTimeParseException e) {
            log.error("DATE_PARSING_FAIL | ReqID: {} | Status: Invalid row date format", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Incorrect date format detected in rows.");
        } catch (NumberFormatException e) {
            log.error("AMOUNT_PARSING_FAIL | ReqID: {} | Status: Numeric format error", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Non-numeric values found in amount column.");
        } catch (DataAccessException e) {
            log.error("REDIS_OR_DB_UNAVAILABLE | ReqID: {} | Status: Backend connection failure", requestId);
            handleAsyncCrash(requestId, "System temporarily unavailable. Please try again later.");
        } catch (NullPointerException | ArrayIndexOutOfBoundsException e) {
            log.error("INTERNAL_LOGIC_ERROR | ReqID: {} | Type: {}", requestId, e.getClass().getSimpleName());
            handleAsyncCrash(requestId, "Internal system failure during processing.");
        }
        catch (Throwable t) {
            log.error("FATAL_SYSTEM_ERROR | ReqID: {} | Type: {}", requestId, t.getClass().getSimpleName(), t);
            handleAsyncCrash(requestId, "A critical system error occurred during processing.");
        }
        finally {
            if (tempFile.exists() && !tempFile.delete()) {
                log.warn("CLEANUP_WARN | Path: {} | Status: Temp file purge failed", tempFilePath);
            }
            MDC.clear();
        }
    }
    private void handleAsyncCrash(String requestId, String message) {
        log.error("ASYNC_PROCESS_CRASH | ReqID: {} | Reason: {}", requestId, message);
        updateState(requestId, s -> {
            s.setStatus("ERROR");
            s.setMessage(message);
            s.setHasErrorFile(false);
        });
    }


    private String padBranch(String branch) {
        if (branch == null || branch.trim().isEmpty()) return "";
        String b = branch.trim();
        if (b.length() < 5) {
            return String.format("%5s", b).replace(' ', '0');
        }
        return b;
    }


    // ==================================================================================
    // 3. PARSING LOGIC
    // ==================================================================================
    /**
     * Rule 3: Preserves original CSV parsing logic.
     * Handles both '01' System formats (14 columns) and Standard manual formats.
     */
    private ParsingResult parseCsvStream(InputStream is, LocalDate postingDate) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        boolean hasProductCol = false;

        try (BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
            String line;
            int i = 0;
            while ((line = br.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] c = line.split(",", -1);

                // Header skipping logic (Safely ignores the '*' characters)
                if (i == 0) {
                    String h = c.length > 0 ? c[0].trim().toLowerCase() : "";
                    if (h.contains("branch") || h.contains("batch")) {
                        i++; continue;
                    }
                }

                ExcelRowData d = new ExcelRowData();
                d.rowIndex = i++;
                String col0Clean = c.length > 0 ? c[0].replace("\uFEFF", "").trim() : "";
                d.sysSite = col0Clean;

                // Logic for System Format (01)
                if ("01".equals(col0Clean) && c.length > 8) {
                    d.isSystemFormat = true;
                    if (c.length > 1) d.sysDate = c[1].trim();
                    if (c.length > 2) d.sysYear = c[2].trim();
                    if (c.length > 3) d.sysPeriod = c[3].trim();
                    if (c.length > 4) d.branch = padBranch(c[4]);
                    if (c.length > 5) d.currency = c[5].trim().toUpperCase();
                    if (c.length > 6) d.cgl = c[6].trim();
                    parseAmount(d, (c.length > 7) ? c[7].trim() : "", (c.length > 8) ? c[8].trim() : "");
                    if (c.length > 9) d.remarks = c[9].trim();

                    if (c.length > 10) {
                        String rawProd = c[10].trim();
                        d.productCode = rawProd;
                        if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                            hasProductCol = true;
                        }
                    } else {
                        d.productCode = "";
                    }

                    if (c.length < 14) {
                        d.formatErrors.add("Invalid CSV columns");
                    } else {
                        validateSystemColumns(d, d.sysSite, d.sysDate, d.sysYear, d.sysPeriod, c[11].trim(), c[12].trim(), c[13].trim(), postingDate);
                    }
                }
                // Logic for Standard Format
                // The ERRORS column is at index 7, which means it is safely ignored!
                else {
                    if (c.length > 0) d.branch = padBranch(c[0]);
                    if (c.length > 1) d.currency = c[1].trim().toUpperCase();
                    if (c.length > 2) d.cgl = c[2].trim();
                    parseAmount(d, (c.length > 3) ? c[3].trim() : "", (c.length > 4) ? c[4].trim() : "");

                    // Index 5 is strictly Remarks
                    if (c.length > 5) d.remarks = c[5].trim();

                    // Index 6 is strictly Product Code
                    if (c.length > 6) {
                        String rawProd = c[6].trim();
                        d.productCode = rawProd;
                        if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                            hasProductCol = true;
                        }
                    } else {
                        d.productCode = "";
                    }
                }
                list.add(d);
            }
        }
        return new ParsingResult(list, hasProductCol);
    }

    private ParsingResult parseExcelStream(InputStream is, LocalDate postingDate) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        boolean hasProductCol = false;
        DataFormatter fmt = new DataFormatter();

        try (Workbook wb = com.github.pjfanning.xlsx.StreamingReader.builder()
                .rowCacheSize(100)
                .bufferSize(4096)
                .open(is)) {

            Sheet sheet = wb.getSheetAt(0);
            for (Row r : sheet) {
                if (isRowEmpty(r)) continue;

                // Header skipping logic (Safely ignores the '*' characters)
                if (r.getRowNum() == 0) {
                    String h = fmt.formatCellValue(r.getCell(0)).toLowerCase();
                    if (h.contains("branch") || h.contains("batch")) continue;
                }

                ExcelRowData d = new ExcelRowData();
                d.rowIndex = r.getRowNum();
                String col0 = parseCode(r.getCell(0), fmt);

                if (("01".equals(col0) || "1".equals(col0)) && r.getLastCellNum() > 8) {
                    d.isSystemFormat = true;
                    d.sysSite = col0;
                    d.sysDate = parseCode(r.getCell(1), fmt);
                    d.sysYear = parseCode(r.getCell(2), fmt);
                    d.sysPeriod = parseCode(r.getCell(3), fmt);
                    d.branch = padBranch(parseCode(r.getCell(4), fmt));
                    d.currency = fmt.formatCellValue(r.getCell(5)).trim().toUpperCase();
                    d.cgl = parseCode(r.getCell(6), fmt);
                    parseAmount(d, fmt.formatCellValue(r.getCell(7)), fmt.formatCellValue(r.getCell(8)));
                    d.remarks = fmt.formatCellValue(r.getCell(9)).trim();

                    Cell prodCell = r.getCell(10);
                    String rawProd = (prodCell != null) ? parseCode(prodCell, fmt).trim() : "";
                    d.productCode = rawProd;
                    if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                        hasProductCol = true;
                    }

                    validateSystemColumns(d, col0, d.sysDate, d.sysYear, d.sysPeriod,
                            parseCode(r.getCell(11), fmt), parseCode(r.getCell(12), fmt), parseCode(r.getCell(13), fmt), postingDate);
                }
                // Logic for Standard Format
                // The ERRORS column is at index 7, which means it is safely ignored!
                else {
                    d.branch = padBranch(col0);
                    d.currency = fmt.formatCellValue(r.getCell(1)).trim().toUpperCase();
                    d.cgl = parseCode(r.getCell(2), fmt);
                    parseAmount(d, fmt.formatCellValue(r.getCell(3)), fmt.formatCellValue(r.getCell(4)));

                    // Index 5 is strictly Remarks
                    d.remarks = fmt.formatCellValue(r.getCell(5)).trim();

                    // Index 6 is strictly Product Code
                    Cell prodCell = r.getCell(6);
                    String rawProd = (prodCell != null) ? parseCode(prodCell, fmt).trim() : "";
                    d.productCode = rawProd;
                    if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                        hasProductCol = true;
                    }
                }
                list.add(d);
            }
        } catch (Exception e) {
            log.error("EXCEL_STREAM_PARSE_FAIL | Reason: {}", e.getMessage());
            throw new IOException("Failed to stream Excel content: " + e.getMessage());
        }

        return new ParsingResult(list, hasProductCol);
    }

    /**
     * Rule 4: Amount parsing logic.
     * Ensures Dr/Cr detection and scale validation without changing numeric values.
     */
    private void parseAmount(ExcelRowData d, String amountRaw, String typeRaw) {
        try {
            String amtClean = (amountRaw == null) ? "" : amountRaw.trim();
            if (amtClean.contains("-") || amtClean.contains("(") || amtClean.contains(")"))
                d.formatErrors.add("Amount cannot be negative");
            String clean = CLEAN_AMOUNT_REGEX.matcher(amtClean).replaceAll("");
            if (clean.isEmpty()) { d.amount = BigDecimal.ZERO; return; }
            BigDecimal v = new BigDecimal(clean);
            if (v.signum() < 0) d.formatErrors.add("Amount cannot be negative");

            d.txnType = (typeRaw != null) ? typeRaw.trim().toUpperCase() : "";

            d.amount = v;
        } catch (NumberFormatException | ArithmeticException e) {
            d.amount = BigDecimal.ZERO;
            d.formatErrors.add("Invalid numeric format");
        }
    }

    // ==================================================================================
    // 4. VALIDATION STAGES
    // ==================================================================================

    private void runFormatCheck(List<ExcelRowData> rows) {
         rows.parallelStream().forEach(d -> {

            // 1. Safely grab the value, remove all spaces, and make it uppercase
            String rawType = (d.txnType != null) ? d.txnType.trim().toUpperCase() : "";

            // 2. Check the cleaned value and instantly standardize it to full words
            if (rawType.equals("CR") || rawType.equals("CREDIT")) {
                d.txnType = "Credit";
            }
            else if (rawType.equals("DR") || rawType.equals("DEBIT")) {
                d.txnType = "Debit";
            }
            else {
                synchronized(d.formatErrors) {
                    d.formatErrors.add("Transaction type must be 'CR' or 'DR' (Case insensitive).");
                }
            }


            // Amount
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) <= 0) {
                synchronized(d.formatErrors) { d.formatErrors.add("Amount must be greater than 0."); }
            } else {
                if (d.amount.precision() > 20 || d.amount.scale() > 4) {
                    synchronized(d.formatErrors) { d.formatErrors.add("Exceeded maximum digits or decimal places."); }
                } else if ("INR".equalsIgnoreCase(d.currency) && d.amount.stripTrailingZeros().scale() > 2) {
                    synchronized(d.formatErrors) { d.formatErrors.add("Exceeded maximum digits or decimal places."); }
                }
            }


            // Product Code
            if (d.productCode != null && !d.productCode.isEmpty() && !d.productCode.equals("A") && !d.productCode.matches("^[0-9]{1,8}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("Product code must be up to 8 digits or left blank."); }
            }

            // Remarks (Alphanumeric and single spaces only, matching frontend regex)
            if (d.remarks == null || d.remarks.trim().length() < 2 || d.remarks.trim().length() > 30) {
                synchronized(d.formatErrors) { d.formatErrors.add("Remarks must be 2-30 characters."); }
            } else if (!d.remarks.matches("^[a-zA-Z0-9 ]+$") || d.remarks.contains("  ")) {
                synchronized(d.formatErrors) { d.formatErrors.add("Only alphabets and numbers are allowed."); }
            }

            // Currency
            if (d.currency == null || d.currency.length() != 3) {
                synchronized(d.formatErrors) { d.formatErrors.add("Currency code must be exactly 3 characters."); }
            }

            // CGL (Strictly 10 digits)
            if (d.cgl == null || d.cgl.isEmpty()) {
                synchronized(d.formatErrors) { d.formatErrors.add("CGL is mandatory."); }
            } else if (!d.cgl.matches("^[0-9]{10}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("CGL must be exactly 10 digits."); }
            }

            // Branch (Strictly 5 alphanumeric characters)
            if (d.branch == null || d.branch.trim().isEmpty()) {
                synchronized(d.formatErrors) { d.formatErrors.add("Branch code is mandatory."); }
            } else if (!d.branch.matches("^[a-zA-Z0-9]{5}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("Branch code must be exactly 5 alphanumeric characters."); }
            }
        });
    }

    private void runDbCheck(List<ExcelRowData> rows) {
        Set<String> validBranches = validationMasterService.getAllActiveBranches();
        Set<String> validCurrs = validationMasterService.getAllActiveCurrencies();
        Set<String> validCgls = validationMasterService.getAllActiveCgls();

        rows.parallelStream().forEach(d -> {
            if (d.branch != null && !d.branch.isEmpty() && !validBranches.contains(d.branch))
                d.dbErrors.add("Branch is inactive or not found: " + d.branch);
            if (d.currency != null && !d.currency.isEmpty() && !validCurrs.contains(d.currency))
                d.dbErrors.add("Currency is inactive or not found: " + d.currency);
            if (d.cgl != null && !d.cgl.isEmpty() && !validCgls.contains(d.cgl))
                d.dbErrors.add("CGL is inactive or not found: " + d.cgl);
        });
    }

    /**
     * Rule 5: Balance Integrity Logic.
     * Uses LongAdder with 10^4 scale shift to perform precise integer arithmetic
     * on parallel streams, preventing floating-point drift in large batches.
     */
    private void runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, AtomicReference<BigDecimal>> balanceMap = new ConcurrentHashMap<>();
        ConcurrentHashMap<String, Boolean> branchHasDebit = new ConcurrentHashMap<>();
        ConcurrentHashMap<String, Boolean> branchHasCredit = new ConcurrentHashMap<>();

        // Pass 1: Aggregate totals and check for presence
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.currency == null || d.cgl == null || d.amount == null || d.txnType == null) return;

            // Track Debit/Credit Presence per Branch
            if ("Debit".equalsIgnoreCase(d.txnType)) branchHasDebit.put(d.branch, true);
            if ("Credit".equalsIgnoreCase(d.txnType)) branchHasCredit.put(d.branch, true);

            // Calculate Balance Groupings
            boolean isCredit = "Credit".equalsIgnoreCase(d.txnType);
            BigDecimal finalVal = isCredit ? d.amount.negate() : d.amount;

            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String balKey = d.branch + "_" + d.currency + "_" + type;

            // Thread-safe BigDecimal addition without scaling or overflow risks
            balanceMap.computeIfAbsent(balKey, k -> new AtomicReference<>(BigDecimal.ZERO))
                    .updateAndGet(curr -> curr.add(finalVal));
        });

        // Pass 2: Apply the simple, generic error messages to the rows
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.currency == null || d.cgl == null || d.amount == null || d.txnType == null) return;

            Boolean hasDeb = branchHasDebit.getOrDefault(d.branch, false);
            Boolean hasCred = branchHasCredit.getOrDefault(d.branch, false);

            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String balKey = d.branch + "_" + d.currency + "_" + type;
            AtomicReference<BigDecimal> adder = balanceMap.get(balKey);

            synchronized (d.balErrors) {
                // 1. Debit/Credit Presence Check
                if ((!hasDeb || !hasCred) && !d.balErrors.contains("Branch must have at least one Debit and one Credit entry.")) {
                    d.balErrors.add("Branch must have at least one Debit and one Credit entry.");
                }

                // 2. Balance Math Check (Using BigDecimal's compareTo)
                if (adder != null && adder.get().compareTo(BigDecimal.ZERO) != 0 && !d.balErrors.contains("Branch, Currency, and CGL-wise balance mismatch.")) {
                    d.balErrors.add("Branch, Currency, and CGL-wise balance mismatch.");
                }
            }
        });
    }

    private void validateSystemColumns(ExcelRowData d, String c0, String cDate, String cYear, String cMonth, String c11, String c12, String c13, LocalDate postingDate) {
        if (!"01".equals(c0)) d.formatErrors.add("Site must be '01'.");

        try {
            if (cDate == null || cDate.trim().length() != 8) {
                d.formatErrors.add("Invalid date format. Expected: ddMMyyyy.");
            } else {
                LocalDate parsedDate = LocalDate.parse(cDate.trim(), SYSTEM_DATE_FMT);

                if (!parsedDate.equals(postingDate)) d.formatErrors.add("Date does not match the current posting date.");

                String expectedYear = (parsedDate.getMonthValue() >= 4) ? String.valueOf(parsedDate.getYear()) : String.valueOf(parsedDate.getYear() - 1);
                String expectedMonth = String.format("%02d", (parsedDate.getMonthValue() >= 4) ? (parsedDate.getMonthValue() - 3) : (parsedDate.getMonthValue() + 9));

                if (cYear == null || !cYear.trim().equals(expectedYear)) d.formatErrors.add("Invalid financial year. Expected: " + expectedYear);
                if (cMonth == null || !cMonth.trim().equals(expectedMonth)) d.formatErrors.add("Invalid financial month. Expected: " + expectedMonth);
            }
        } catch (DateTimeParseException e) {
            d.formatErrors.add("Invalid calendar date.");
        }

        if (c11 == null || !"B".equalsIgnoreCase(c11.trim())) d.formatErrors.add("Column 12 must be 'B'.");
        if (c12 == null || !"C".equalsIgnoreCase(c12.trim())) d.formatErrors.add("Column 13 must be 'C'.");
        if (c13 == null || !"D".equalsIgnoreCase(c13.trim())) d.formatErrors.add("Column 14 must be 'D'.");
    }

    // ==================================================================================
    // 5. STORAGE & UTILS
    // ==================================================================================

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProductColumn) throws IOException {
        log.warn("VALIDATION_FAILED | ReqID: {} | Reason: {}", reqId, msg);
        byte[] excel = generateErrorExcelFast(rows, hasProductColumn);
        redisTemplate.opsForValue().set("FILE_" + reqId + "_ERROR", excel, 30, TimeUnit.MINUTES);
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv , boolean hasProductColumn) throws IOException {
        saveRowsToRedis(reqId, rows);
        if (!isCsv) {
            byte[] csv = generateSuccessCsv(rows, pDate);
            redisTemplate.opsForValue().set("FILE_" + reqId + "_SUCCESS", csv, 30, TimeUnit.MINUTES);
        }
        List<Map<String, Object>> preview = rows.stream().limit(2000).map(this::mapToPreview).collect(Collectors.toList());
        updateState(reqId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(!isCsv);
            s.setHasProductColumn(hasProductColumn);
            try {
                s.setPreviewDataJson(objectMapper.writeValueAsString(preview));
            } catch (JsonProcessingException ignored) {}
        });
    }

    private synchronized void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        // 1. Always pull the freshest state from Redis to avoid "Stale Object" overwrites
        BulkUploadStateDto state = getStatusFromRedis(requestId);
        if (state == null) {
            state = new BulkUploadStateDto();
            state.setRequestId(requestId);
        }

        // 2. Apply the update (e.g., changing status, incrementing counts, or setting total rows)
        updater.accept(state);

        // 3. Persist the updated object back to Redis immediately
        saveStatusToRedis(requestId, state);
    }


    private void saveRowsToRedis(String requestId, List<ExcelRowData> rows) {
        if (rows == null || rows.isEmpty()) return;

        try {
            int chunkSize = 5000;
            int totalRows = rows.size();
            int totalChunks = (int) Math.ceil((double) totalRows / chunkSize);

            // 1. Save chunks individually to prevent memory spikes
            for (int i = 0; i < totalChunks; i++) {
                int start = i * chunkSize;
                int end = Math.min(start + chunkSize, totalRows);
                List<ExcelRowData> chunk = rows.subList(start, end);

                try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
                     GZIPOutputStream gos = new GZIPOutputStream(baos)) {
                    objectMapper.writeValue(gos, chunk);
                    gos.finish();

                    String chunkKey = "DATA_CHUNK_" + requestId + "_" + i;
                    redisTemplate.opsForValue().set(chunkKey, baos.toByteArray(), 1, TimeUnit.HOURS);
                }
            }

            // 2. Save metadata so the retrieval service knows how many chunks to fetch
            Map<String, Object> meta = new HashMap<>();
            meta.put("totalChunks", totalChunks);
            meta.put("totalRows", totalRows);

            byte[] metaBytes = objectMapper.writeValueAsBytes(meta);
            redisTemplate.opsForValue().set("DATA_META_" + requestId, metaBytes, 1, TimeUnit.HOURS);

            log.info("CACHE_DATA_SAVED | ReqID: {} | TotalRows: {} | Chunks: {}", requestId, totalRows, totalChunks);

        } catch (IOException | DataAccessException e) {
            log.error("CACHE_SAVE_FAILURE | ReqID: {} | Status: Chunked persistence error", requestId);
            throw new CustomExceptions.RedisOperationException("Failed to cache large dataset", e);
        }
    }

    private byte[] generateSuccessCsv(List<ExcelRowData> rows, LocalDate postingDate) {
        StringBuilder csv = new StringBuilder(rows.size() * 100);

        // 1. Date Format: Set to dd/MM/yyyy (e.g., 25/03/2026)
        DateTimeFormatter slashDateFmt = DateTimeFormatter.ofPattern("ddMMyyyy");
        DateTimeFormatter noSlashDateFmt = DateTimeFormatter.ofPattern("ddMMyyyy");

        String defaultDateStr = postingDate.format(slashDateFmt);
        String year = (postingDate.getMonthValue() >= 4) ? String.valueOf(postingDate.getYear()) : String.valueOf(postingDate.getYear() - 1);
        String month = String.format("%02d", (postingDate.getMonthValue() >= 4) ? (postingDate.getMonthValue() - 3) : (postingDate.getMonthValue() + 9));

        for (ExcelRowData row : rows) {

            // Format system dates or fallback to default date with slashes
            String cDate = defaultDateStr;
            if (row.isSystemFormat && row.sysDate != null && row.sysDate.length() == 8) {
                try {
                    cDate = LocalDate.parse(row.sysDate, noSlashDateFmt).format(slashDateFmt);
                } catch (Exception e) {
                    cDate = defaultDateStr;
                }
            }

            String cYear = row.isSystemFormat ? row.sysYear : year;
            String cMonth = row.isSystemFormat ? row.sysPeriod : month;

            // 2. Branch Padding: Exactly 5 digits with leading zeros (e.g., "56" -> "00056")
            String col5 = String.format("%5s", row.branch).replace(' ', '0');
            String col6 = (row.currency == null || row.currency.isEmpty()) ? "INR" : row.currency;

            // 3. Amount 16.4 Padding: 16 integer digits, 4 decimal digits
            // setScale(4) ensures 1100.34 mathematically becomes 1100.3400
            String plainAmt = row.amount.abs().setScale(4, RoundingMode.HALF_UP).toPlainString();
            int dotIndex = plainAmt.indexOf('.');
            String intPart = (dotIndex == -1) ? plainAmt : plainAmt.substring(0, dotIndex);
            String decPart = (dotIndex == -1) ? "0000" : plainAmt.substring(dotIndex + 1);

            // Padds the integer part to exactly 16 zeroes
            String col8 = String.format("%16s", intPart).replace(' ', '0') + "." + decPart;

            // 4. TXN Type: Strictly Uppercase DR / CR
            String col9 = "Credit".equalsIgnoreCase(row.txnType) ? "CR" : "DR";

            String col10 = (row.remarks != null) ? row.remarks.replace(",", " ") : "";
            String col11 = (row.productCode == null || row.productCode.trim().isEmpty()) ? "A" : row.productCode.trim();

            csv.append("01,").append(cDate).append(",").append(cYear).append(",").append(cMonth).append(",")
                    .append(col5).append(",").append(col6).append(",").append(row.cgl).append(",").append(col8).append(",")
                    .append(col9).append(",").append(col10).append(",").append(col11).append(",B,C,D\n");
        }
        return csv.toString().getBytes(StandardCharsets.UTF_8);
    }
    private byte[] generateErrorExcelFast(List<ExcelRowData> rows, boolean includeProduct) throws IOException {
        SXSSFWorkbook workbook = new SXSSFWorkbook(100);

        try {
            Sheet sheet = workbook.createSheet("Error Report");
            CellStyle errStyle = workbook.createCellStyle();
            Font f = workbook.createFont(); f.setColor(IndexedColors.RED.getIndex()); errStyle.setFont(f);

            boolean isSystem = rows.stream().anyMatch(r -> r.isSystemFormat);

            Row h = sheet.createRow(0);
            List<String> headerList = new ArrayList<>();

            if (isSystem) {
                headerList.addAll(Arrays.asList("Site", "Date", "Year", "Month", "Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks"));
                headerList.add("Product Code"); // Always render to lock column indices
            } else {
                // Sequence matching parser perfectly. Asterisks included.
                headerList.addAll(Arrays.asList("Branch*", "Currency*", "CGL*", "Amount*", "Type*", "Remarks*", "Product Code"));
            }

            // ERRORS is always safely pushed to the end (Index 7)
            headerList.add("ERRORS");

            for (int i = 0; i < headerList.size(); i++) h.createCell(i).setCellValue(headerList.get(i));

            int idx = 1;
            for (ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                int col = 0;
                if (isSystem) {
                    r.createCell(col++).setCellValue(sanitize(d.sysSite));
                    r.createCell(col++).setCellValue(sanitize(d.sysDate));
                    r.createCell(col++).setCellValue(sanitize(d.sysYear));
                    r.createCell(col++).setCellValue(sanitize(d.sysPeriod));
                    r.createCell(col++).setCellValue(sanitize(d.branch));
                    r.createCell(col++).setCellValue(sanitize(d.currency));
                    r.createCell(col++).setCellValue(sanitize(d.cgl));
                    r.createCell(col++).setCellValue(d.amount != null ? d.amount.stripTrailingZeros().toPlainString() : "");
                    r.createCell(col++).setCellValue(sanitize(d.txnType));
                    r.createCell(col++).setCellValue(sanitize(d.remarks));
                    r.createCell(col++).setCellValue(sanitize(d.productCode));
                } else {
                    r.createCell(col++).setCellValue(sanitize(d.branch));
                    r.createCell(col++).setCellValue(sanitize(d.currency));
                    r.createCell(col++).setCellValue(sanitize(d.cgl));
                    r.createCell(col++).setCellValue(d.amount != null ? d.amount.stripTrailingZeros().toPlainString() : "");
                    r.createCell(col++).setCellValue(sanitize(d.txnType));
                    r.createCell(col++).setCellValue(sanitize(d.remarks));
                    r.createCell(col++).setCellValue(sanitize(d.productCode));
                }

                Cell c = r.createCell(col);
                if (d.hasErrors()) { c.setCellValue(d.getAllErrors()); c.setCellStyle(errStyle); }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            return out.toByteArray();
        } finally {
            workbook.dispose();
            workbook.close();
        }
    }


    private String sanitize(String value) {
        if (value == null) return "";
        if (value.startsWith("=") || value.startsWith("+") || value.startsWith("-") || value.startsWith("@")) return "'" + value;
        return value;
    }
    public byte[] generateTemplateBytes() throws IOException {
        try (SXSSFWorkbook wb = new SXSSFWorkbook()) {
            Sheet sheet = wb.createSheet("Journal Template");
            Row row = sheet.createRow(0);

            // Updated exact names, sequence, and mandatory asterisks
            String[] headers = {"Branch*", "Currency*", "CGL*", "Amount*", "Type*", "Product Code" , "Remarks*"};

            for (int i = 0; i < headers.length; i++) {
                Cell cell = row.createCell(i);
                cell.setCellValue(headers[i]);
                sheet.setColumnWidth(i, 4000);
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            wb.write(out);
            return out.toByteArray();
        }
    }

    private String parseCode(Cell c, DataFormatter f) {
        if (c == null) return "";
        if (c.getCellType() == CellType.NUMERIC) return BigDecimal.valueOf(c.getNumericCellValue()).toPlainString().split("\\.")[0];
        return f.formatCellValue(c).trim();
    }

    private boolean isRowEmpty(Row r) {
        if (r == null) return true;
        for (int c = r.getFirstCellNum(); c < r.getLastCellNum(); c++)
            if (r.getCell(c) != null && r.getCell(c).getCellType() != CellType.BLANK && !r.getCell(c).toString().trim().isEmpty()) return false;
        return true;
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>();
        m.put("id", r.rowIndex); m.put("branch", r.branch); m.put("currency", r.currency);
        m.put("cgl", r.cgl); m.put("amount", r.amount != null ? r.amount.toString() : "");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }

    private static class ParsingResult {
        List<ExcelRowData> rows; boolean hasProductColumn;
        public ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) { this.rows = rows; this.hasProductColumn = hasProductColumn; }
    }


    @JsonIgnoreProperties(ignoreUnknown = true)
    @JsonFormat(shape = JsonFormat.Shape.ARRAY)
    @JsonPropertyOrder({
            "rowIndex", "branch", "currency", "cgl", "txnType", "remarks",
            "productCode", "amount", "isSystemFormat", "sysSite", "sysDate",
            "sysYear", "sysPeriod", "formatErrors", "dbErrors", "balErrors"
    })
    public static class ExcelRowData {

        @JsonProperty("0") // rowIndex
        public int rowIndex;

        @JsonProperty("1") // branch
        public String branch = "";

        @JsonProperty("2") // currency
        public String currency = "";

        @JsonProperty("3") // cgl
        public String cgl = "";

        @JsonProperty("4") // txnType
        public String txnType = "";

        @JsonProperty("5") // remarks
        public String remarks = "";

        @JsonProperty("6") // productCode
        public String productCode = "";

        @JsonProperty("7") // amount
        public BigDecimal amount;

        @JsonProperty("8") // isSystemFormat
        public boolean isSystemFormat = false;

        @JsonProperty("9") // sysSite
        public String sysSite = "";

        @JsonProperty("10") // sysDate
        public String sysDate = "";

        @JsonProperty("11") // sysYear
        public String sysYear = "";

        @JsonProperty("12") // sysPeriod
        public String sysPeriod = "";

        // Validation Lists (Indices 13, 14, 15)
        @JsonProperty("13")
        public final List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());

        @JsonProperty("14")
        public final List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());

        @JsonProperty("15")
        public final List<String> balErrors = Collections.synchronizedList(new ArrayList<>());

        public boolean hasErrors() {
            return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty();
        }

        @JsonIgnore
        public String getAllErrors() {
            List<String> all = new ArrayList<>(formatErrors);
            all.addAll(dbErrors);
            all.addAll(balErrors);
            return String.join("; ", all);
        }
    }
