### 4. Inline Action Remarks & Button Layout
We will change the bottom action bar from a stacked column into a single horizontal row, and shrink the text box back to a normal, single-line input.
**FIND your entire <DialogActions> block at the very bottom of the Modal (around line 1250) and REPLACE IT ENTIRELY with this:**
```javascript
          {/* --- STICKY BOTTOM ACTION BAR (INLINE DESIGN) --- */}
          <DialogActions sx={{ p: 3, backgroundColor: "#f8fafc", borderTop: "1px solid", borderColor: "divider", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            {(() => {
              const isWorkflowFinished = viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED" || viewingBatchState === "REJECTED";
              const isActionDisabled = isViewingSelfCreated || isWorkflowFinished;

              return (
                <>
                  {/* Left Side: Security Notice OR Remarks Input */}
                  <Box sx={{ flexGrow: 1, mr: 4 }}>
                    {isViewingSelfCreated && !isWorkflowFinished ? (
                      <Typography variant="body2" color="error.main" fontWeight="bold">
                        * Security Violation: You cannot approve or reject your own request.
                      </Typography>
                    ) : isWorkflowFinished ? (
                      <Typography variant="body2" color="text.secondary" fontWeight="bold">
                        * Workflow processing is complete for this batch.
                      </Typography>
                    ) : (
                      <TextField
                        fullWidth
                        size="small"
                        required
                        label="Action Remarks (Max 30 chars)"
                        placeholder="Type remarks here..."
                        value={executorRemarks}
                        onChange={(e) => handleRemarksChange(e, setExecutorRemarks)}
                        disabled={isSubmitting}
                        inputProps={{ maxLength: 30 }}
                        error={executorRemarks.length > 0 && !isRemarksValid(executorRemarks)}
                        sx={{ backgroundColor: 'white', maxWidth: 400 }} // Restricts width so it doesn't look overly stretched
                      />
                    )}
                  </Box>

                  {/* Right Side: Action Buttons */}
                  <Stack direction="row" spacing={2} alignItems="center">
                    <Button
                      variant="contained"
                      color="error"
                      disabled={isActionDisabled || !isRemarksValid(executorRemarks) || isSubmitting}
                      onClick={() => handleSubmitAction("REJECTED")}
                      sx={{ minWidth: 120, fontWeight: 'bold' }}
                    >
                      {submittingAction === "REJECTED" ? <CircularProgress size={20} color="inherit" /> : "Reject"}
                    </Button>

                    <Button
                      variant="contained"
                      color="success"
                      disabled={isActionDisabled || !isRemarksValid(executorRemarks) || isSubmitting}
                      onClick={() => handleSubmitAction("ACCEPTED")}
                      sx={{ minWidth: 120, fontWeight: 'bold' }}
                    >
                      {submittingAction === "ACCEPTED" ? <CircularProgress size={20} color="inherit" /> : "Accept"}
                    </Button>
                  </Stack>
                </>
              );
            })()}
          </DialogActions>

