package com.tcs.fincore.controller;

import com.tcs.fincore.service.GenericReportService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/reports")
public class NwsaController {

    @Autowired
    private GenericReportService reportService;

    // Read the path from application.properties
    @Value("${app.input.file.path}")
    private String configuredFilePath;

    @PostMapping("/nwsa/generate")
    public ResponseEntity<String> generateNwsaReport() {
        try {
            System.out.println(">>> Controller Triggered <<<");
            System.out.println("Using Configured Path: " + configuredFilePath);

            if (configuredFilePath == null || configuredFilePath.isEmpty()) {
                return ResponseEntity.badRequest().body("❌ Error: Path not found in application.properties");
            }

            // Call service with the variable path
            String outputFilePath = reportService.generateReport("nwsa", configuredFilePath);
            
            return ResponseEntity.ok("✅ SUCCESS! Report Generated at: " + outputFilePath);

        } catch (Exception e) {
            e.printStackTrace();
            return ResponseEntity.internalServerError().body("❌ FAILED: " + e.getMessage());
        }
    }
}

