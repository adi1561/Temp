This is a classic parsing issue.
The Problem:
Your configuration string uses brackets inside brackets: ["...[0-9]..."].
The simple regex \[(.*?)\] stops at the first ] it finds. So, when it sees [0-9], it thinks the rule block has ended, cutting off your regex in the middle.
The Fix:
We need to update RuleParser.java to specifically look for the quotes "" that you added. By matching ["regex"] instead of just [regex], we can safely ignore the brackets inside your regex.
Here is the corrected RuleParser.java.
Updated Utility: RuleParser.java
I have updated RULE_PATTERN to \\["(.*?)"\\]\\[(.*?)\\]\\[(.*?)\\]. This effectively tells Java: "Find the content strictly between [" and "]", allowing your internal brackets to exist safely.
package com.example.ascii.service;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RuleParser {

    // OLD (Broken): Pattern.compile("\\[(.*?)\\]\\[(.*?)\\]\\[(.*?)\\]");
    
    // NEW (Fixed): Matches ["Regex"][Col][Logic]
    // strictly looks for quotes inside the first bracket to handle nested brackets like [0-9]
    private static final Pattern RULE_PATTERN = Pattern.compile("\\[\"(.*?)\"\\]\\[(.*?)\\]\\[(.*?)\\]");

    public static BigDecimal applyMathLogic(BigDecimal amount, String head, int colIdx, String logicConfig) {
        if (logicConfig == null) return amount;
        String logic = findMatchingRule(head, colIdx, logicConfig); 
        
        if (logic == null) return amount;

        if (logic.contains("/")) {
            BigDecimal divisor = new BigDecimal(logic.replaceAll("[^0-9.]", ""));
            return amount.divide(divisor, 6, RoundingMode.HALF_UP);
        } else if (logic.contains("*")) {
            BigDecimal multiplier = new BigDecimal(logic.replace("*", "").replace("(", "").replace(")", ""));
            return amount.multiply(multiplier);
        }
        return amount;
    }

    public static BigDecimal applyDecimalLogic(BigDecimal amount, String head, int colIdx, String decimalConfig) {
        if (decimalConfig == null) return amount;
        String rule = findMatchingRule(head, colIdx, decimalConfig);
        if (rule == null) return amount;

        if (rule.equalsIgnoreCase("floor")) return amount.setScale(0, RoundingMode.FLOOR);
        if (rule.equalsIgnoreCase("ceil")) return amount.setScale(0, RoundingMode.CEILING);
        if (rule.equalsIgnoreCase("round")) return amount.setScale(0, RoundingMode.HALF_UP);
        
        try {
            int scale = Integer.parseInt(rule);
            return amount.setScale(scale, RoundingMode.HALF_UP);
        } catch (NumberFormatException e) {
            return amount;
        }
    }

    public static String applyAmountPadding(BigDecimal amount, String head, int colIdx, String padConfig) {
        if (padConfig == null) return amount.toPlainString();
        String rule = findMatchingRule(head, colIdx, padConfig);

        if (rule == null) return amount.toPlainString();

        if (rule.contains(",")) {
            // "16,2" format
            String[] parts = rule.split(",");
            int totalLen = Integer.parseInt(parts[0]);
            int decimalLen = Integer.parseInt(parts[1]);
            
            BigDecimal scaled = amount.setScale(decimalLen, RoundingMode.HALF_UP);
            String raw = scaled.toPlainString(); 
            
            return padLeft(raw, totalLen, '0');
        } else {
            // "18" format (Integer padding)
            int totalLen = Integer.parseInt(rule);
            String raw = amount.toBigInteger().toString(); 
            return padLeft(raw, totalLen, '0');
        }
    }

    public static String applySign(String formattedAmt, BigDecimal originalAmt, String head, int colIdx, String signConfig) {
        if (signConfig == null) return formattedAmt;
        String rule = findMatchingRule(head, colIdx, signConfig);
        
        if ("NO_SIGN".equalsIgnoreCase(rule)) return formattedAmt;
        
        if ("SHOW_SIGN".equalsIgnoreCase(rule)) {
            return formattedAmt + (originalAmt.compareTo(BigDecimal.ZERO) >= 0 ? "+" : "-");
        }
        
        if (originalAmt.compareTo(BigDecimal.ZERO) < 0) {
            return formattedAmt + "-";
        }
        return formattedAmt;
    }

    public static String applyHeadPadding(String head, String padConfig) {
        if (padConfig == null || padConfig.length() < 3) return head;
        
        int len = Integer.parseInt(padConfig.substring(0, padConfig.length() - 2));
        char direction = padConfig.charAt(padConfig.length() - 2);
        char padChar = padConfig.charAt(padConfig.length() - 1);
        
        if (padConfig.endsWith("\" \"")) padChar = ' ';

        if (direction == 'L') return padLeft(head, len, padChar);
        return padRight(head, len, padChar);
    }

    // --- Internal Helpers ---

    private static String findMatchingRule(String head, int colIdx, String configStr) {
        if (configStr == null || configStr.isEmpty()) return null;
        
        String[] rules = configStr.split("\\|");
        
        for (String rule : rules) {
            Matcher m = RULE_PATTERN.matcher(rule);
            
            // Because we used explicit quotes in regex, we don't get stuck on internal brackets
            if (m.find()) {
                String headRegex = m.group(1); // The Regex (content inside quotes)
                String colReq = m.group(2);    // The Column Index
                String logic = m.group(3);     // The Logic Value

                boolean colMatch = colReq.isEmpty() || colReq.equals(String.valueOf(colIdx));
                
                // Using lookingAt() for consistency with Service logic, 
                // or find() if you want it to appear anywhere. 
                // Given your requirements, lookingAt() (Start of string) is usually safer for Heads.
                boolean headMatch = Pattern.compile(headRegex).matcher(head).lookingAt();

                if (colMatch && headMatch) {
                    return logic;
                }
            }
        }
        return null;
    }

    private static String padLeft(String str, int len, char pad) {
        if (str.length() >= len) return str;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < len - str.length(); i++) sb.append(pad);
        sb.append(str);
        return sb.toString();
    }
    
    private static String padRight(String str, int len, char pad) {
        if (str.length() >= len) return str;
        StringBuilder sb = new StringBuilder(str);
        for (int i = 0; i < len - str.length(); i++) sb.append(pad);
        return sb.toString();
    }
}

Database Data Check
Since we updated the Java code to expect quotes "" around the regex, your database must strictly follow that format.
Ensure your DB update looks exactly like this (notice the quotes inside the first brackets):
UPDATE ASCII_CONFIG SET 
    OUTPUT_AMT_DECIMAL = '["^[ALS][0-9].*|^N[A-Z].*"][3][2]|["^.*"][4][2]',
    OUTPUT_AMT_COL_PAD = '["^[ALS][0-9].*|^N[A-Z].*"][3][16,2]|["^.*"][4][16,2]'
WHERE ID = 101;
COMMIT;

With this change, the parser will correctly extract ^[ALS][0-9].*|^N[A-Z].* as the regex and apply the padding rules correctly.
