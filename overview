A. Rule Parser Utility (RuleParser.java)
Crucial Change: The regex pattern now includes \" to handle the quoted strings from the DB.
package com.example.ascii.service;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RuleParser {

    // FIXED REGEX: Look for ["..."] to handle internal brackets safely
    private static final Pattern RULE_PATTERN = Pattern.compile("\\[\"(.*?)\"\\]\\[(.*?)\\]\\[(.*?)\\]");

    public static BigDecimal applyMathLogic(BigDecimal amount, String head, int colIdx, String logicConfig) {
        if (logicConfig == null) return amount;
        String logic = findMatchingRule(head, colIdx, logicConfig); 
        if (logic == null) return amount;

        if (logic.contains("/")) {
            BigDecimal divisor = new BigDecimal(logic.replaceAll("[^0-9.]", ""));
            return amount.divide(divisor, 6, RoundingMode.HALF_UP);
        } else if (logic.contains("*")) {
            BigDecimal multiplier = new BigDecimal(logic.replace("*", "").replace("(", "").replace(")", ""));
            return amount.multiply(multiplier);
        }
        return amount;
    }

    public static BigDecimal applyDecimalLogic(BigDecimal amount, String head, int colIdx, String decimalConfig) {
        if (decimalConfig == null) return amount;
        String rule = findMatchingRule(head, colIdx, decimalConfig);
        if (rule == null) return amount;
        try {
            return amount.setScale(Integer.parseInt(rule), RoundingMode.HALF_UP);
        } catch (Exception e) { return amount; }
    }

    public static String applyAmountPadding(BigDecimal amount, String head, int colIdx, String padConfig) {
        if (padConfig == null) return amount.toPlainString();
        String rule = findMatchingRule(head, colIdx, padConfig);
        if (rule == null) return amount.toPlainString();

        if (rule.contains(",")) {
            // "19,2" -> Total Length 19, Decimal 2
            String[] parts = rule.split(",");
            int totalLen = Integer.parseInt(parts[0]);
            int decimalLen = Integer.parseInt(parts[1]);
            
            BigDecimal scaled = amount.setScale(decimalLen, RoundingMode.HALF_UP);
            String raw = scaled.toPlainString(); 
            
            return padLeft(raw, totalLen, '0');
        } else {
            // "18" -> Integer padding
            int totalLen = Integer.parseInt(rule);
            String raw = amount.toBigInteger().toString(); 
            return padLeft(raw, totalLen, '0');
        }
    }

    public static String applySign(String fmtAmt, BigDecimal origAmt, String head, int colIdx, String signConfig) {
        if (signConfig == null) return fmtAmt;
        String rule = findMatchingRule(head, colIdx, signConfig);
        
        // POS_0 Logic: Positive -> "0", Negative -> "-"
        if ("POS_0".equalsIgnoreCase(rule)) {
            return fmtAmt + (origAmt.compareTo(BigDecimal.ZERO) >= 0 ? "0" : "-");
        }
        
        if ("SHOW_SIGN".equalsIgnoreCase(rule)) {
            return fmtAmt + (origAmt.compareTo(BigDecimal.ZERO) >= 0 ? "+" : "-");
        }
        
        if (!"NO_SIGN".equalsIgnoreCase(rule) && origAmt.compareTo(BigDecimal.ZERO) < 0) {
            return fmtAmt + "-";
        }
        return fmtAmt;
    }

    public static String applyHeadPadding(String head, String padConfig) {
        if (padConfig == null || padConfig.length() < 3) return head;
        int len = Integer.parseInt(padConfig.substring(0, padConfig.length() - 2));
        char dir = padConfig.charAt(padConfig.length() - 2);
        char pad = padConfig.endsWith("\" \"") ? ' ' : padConfig.charAt(padConfig.length() - 1);
        return dir == 'L' ? padLeft(head, len, pad) : padRight(head, len, pad);
    }

    // --- Helper to find the right rule for the current Head/Column ---
    private static String findMatchingRule(String head, int colIdx, String configStr) {
        if (configStr == null) return null;
        for (String rule : configStr.split("\\|")) {
            Matcher m = RULE_PATTERN.matcher(rule);
            if (m.find()) {
                String headRegex = m.group(1); // Content inside quotes
                String colReq = m.group(2);    // Column Index
                String logic = m.group(3);     // Logic

                boolean colMatch = colReq.isEmpty() || colReq.equals(String.valueOf(colIdx));
                // Use lookingAt() to avoid partial matches
                boolean headMatch = Pattern.compile(headRegex).matcher(head).lookingAt();

                if (colMatch && headMatch) return logic;
            }
        }
        return null;
    }

    private static String padLeft(String str, int len, char pad) {
        StringBuilder sb = new StringBuilder();
        while (sb.length() + str.length() < len) sb.append(pad);
        return sb.append(str).toString();
    }
    private static String padRight(String str, int len, char pad) {
        StringBuilder sb = new StringBuilder(str);
        while (sb.length() < len) sb.append(pad);
        return sb.toString();
    }
}

B. Service Logic (AsciiGenerationService.java)
This keeps the logic robust, reads the path from properties, and uses strict filtering.
package com.example.ascii.service;

import com.example.ascii.entity.AsciiConfig;
import com.example.ascii.repository.AsciiConfigRepository;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

@Service
@Slf4j
public class AsciiGenerationService {

    private final AsciiConfigRepository configRepo;

    @Value("${app.input.file.path}")
    private String configuredFilePath;

    public AsciiGenerationService(AsciiConfigRepository configRepo) {
        this.configRepo = configRepo;
    }

    public String generateReport(Long id) throws Exception {
        log.info("Starting generation for Config ID: {}", id);

        // 1. Fetch Config
        AsciiConfig config = configRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Config not found for ID: " + id));

        // 2. Read File
        Path inputPath = Paths.get(configuredFilePath);
        if (!Files.exists(inputPath)) {
            throw new IOException("Input file not found at: " + configuredFilePath);
        }

        List<String> lines = Files.readAllLines(inputPath);
        HeaderInfo headerInfo = parseHeaderFromInput(lines);
        
        List<String> outputLines = new ArrayList<>();

        // 3. Output Header
        String branchPadded = String.format("%5s", headerInfo.branchCode).replace(' ', '0');
        String dateFormatted = headerInfo.reportDate.replace("/", ""); 
        String header = config.getOutputFirstLine() + branchPadded + dateFormatted + "F";
        outputLines.add(header);

        // 4. Process Body
        List<String> bufferedItems = new ArrayList<>();
        int batchSize = config.getOutputPerLineHead();

        for (String line : lines) {
            String[] columns = line.split("\\|", -1);
            
            // Strictly check regex (Avoid "STATE BANK" etc.)
            if (!isValidRow(columns, config)) continue;

            List<ProcessingItem> itemsToProcess = extractAmountColumns(columns, config);
            
            for (ProcessingItem item : itemsToProcess) {
                String processedAscii = processSingleItem(item.head, item.amount, item.colIndex, config);
                bufferedItems.add(processedAscii);

                if (bufferedItems.size() == batchSize) {
                    outputLines.add(String.join("", bufferedItems));
                    bufferedItems.clear();
                }
            }
        }
        
        if (!bufferedItems.isEmpty()) {
            outputLines.add(String.join("", bufferedItems));
        }

        // 5. Footer
        if (config.getOutputEndLine() != null && !config.getOutputEndLine().isEmpty()) {
            outputLines.add(config.getOutputEndLine());
        }

        // 6. Write File
        String outputFileName = "GENERATED_" + config.getReportId() + config.getFileType();
        Path outputPath = inputPath.getParent().resolve(outputFileName);
        Files.write(outputPath, outputLines);
        
        return outputPath.toString();
    }

    private boolean isValidRow(String[] cols, AsciiConfig config) {
        if (cols.length < 2) return false;
        int idx = config.getInputHeadCol() - 1;
        if (cols.length <= idx) return false;
        
        String head = cols[idx].trim();
        if (head.isEmpty()) return false;
        
        // Strict start-of-string check
        return Pattern.compile(config.getInputHeadRegex()).matcher(head).lookingAt();
    }

    private String processSingleItem(String head, BigDecimal amount, int colIndex, AsciiConfig config) {
        amount = RuleParser.applyMathLogic(amount, head, colIndex, config.getOutputAmtColLogic());
        amount = RuleParser.applyDecimalLogic(amount, head, colIndex, config.getOutputAmtDecimal());
        String amountStr = RuleParser.applyAmountPadding(amount, head, colIndex, config.getOutputAmtColPad());
        String signedAmount = RuleParser.applySign(amountStr, amount, head, colIndex, config.getOutputAmtSign());
        String headPadded = RuleParser.applyHeadPadding(head, config.getOutputHeadColPad());
        return headPadded + signedAmount;
    }

    // (Keeping existing helpers for extracting columns and parsing headers...)
    private HeaderInfo parseHeaderFromInput(List<String> lines) {
        HeaderInfo info = new HeaderInfo();
        info.branchCode = "00000"; info.reportDate = "01012026";
        for (String line : lines) {
            if (line.contains("BRANCH ::")) {
                Matcher m = Pattern.compile("BRANCH :: (\\d+)").matcher(line);
                if (m.find()) info.branchCode = m.group(1);
            }
            if (line.contains("REPORT DATE ::")) {
                Matcher m = Pattern.compile("REPORT DATE :: (\\S+)").matcher(line);
                if (m.find()) info.reportDate = m.group(1);
            }
        }
        return info;
    }

    private List<ProcessingItem> extractAmountColumns(String[] cols, AsciiConfig config) {
        List<ProcessingItem> items = new ArrayList<>();
        String head = cols[config.getInputHeadCol() - 1].trim();
        String seq = config.getAmountColSeq();

        if (seq.contains("else")) {
            String[] parts = seq.split("else");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                if (idx < cols.length && !cols[idx].trim().isEmpty()) {
                    items.add(new ProcessingItem(head, parseAmount(cols[idx]), idx + 1));
                    return items;
                }
            }
            items.add(new ProcessingItem(head, BigDecimal.ZERO, Integer.parseInt(parts[0].trim())));
        } else if (seq.contains("and")) {
            String[] parts = seq.split("and");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
            }
        } else {
            int idx = Integer.parseInt(seq.trim()) - 1;
            items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
        }
        return items;
    }

    private BigDecimal parseAmount(String[] cols, int idx) {
        if (idx >= cols.length) return BigDecimal.ZERO;
        return parseAmount(cols[idx]);
    }
    private BigDecimal parseAmount(String val) {
        try { return new BigDecimal(val.trim().replace(",", "")); } catch (Exception e) { return BigDecimal.ZERO; }
    }
    private static class ProcessingItem { String head; BigDecimal amount; int colIndex; ProcessingItem(String h, BigDecimal a, int c) { head=h; amount=a; colIndex=c; } }
    private static class HeaderInfo { String branchCode; String reportDate; }
}

C. Controller (AsciiController.java)
package com.example.ascii.controller;

import com.example.ascii.dto.ReportRequest;
import com.example.ascii.service.AsciiGenerationService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/ascii")
public class AsciiController {

    @Autowired
    private AsciiGenerationService service;

    @PostMapping("/generate")
    public ResponseEntity<String> generate(@RequestBody ReportRequest request) {
        try {
            if (request.getId() == null) return ResponseEntity.badRequest().body("Error: 'id' is missing");
            String outPath = service.generateReport(request.getId());
            return ResponseEntity.ok("Success! File generated at: " + outPath);
        } catch (Exception e) {
            e.printStackTrace();
            return ResponseEntity.internalServerError().body("Error: " + e.getMessage());
        }
    }
}

