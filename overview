package com.tcs.fincore.entity;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;
import lombok.Data;

@Entity
// 👇 UPDATE THIS LINE TO MATCH YOUR EXACT DB TABLE NAME
@Table(name = "GENERIC_REPORT_CONFIG") 
@Data
public class ReportConfig {

    @Id
    @Column(name = "REPORT")
    private String report;
    
    @Column(name = "TYPE")
    private String type;
    
    @Column(name = "INPUT_FILE_NAME")
    private String inputFileName;
    
    @Column(name = "OUTPUT_FIRST_LINE")
    private String outputFirstLine;

    @Column(name = "OUTPUT_END_LINE")
    private String outputEndLine;

    @Column(name = "INPUT_HEAD_COL")
    private Integer inputHeadCol;

    @Column(name = "INPUT_HEAD_LOGIC")
    private String inputHeadLogic;

    @Column(name = "OUTPUT_HEAD_COLUMN_PADDING")
    private String outputHeadColumnPadding;

    @Column(name = "INPUT_AMOUNT_COLUMN")
    private String inputAmountColumn;

    @Column(name = "OUTPUT_AMOUNT_LOGIC")
    private String outputAmountLogic;

    @Column(name = "OUTPUT_AMOUNT_DECIMAL")
    private Integer outputAmountDecimal;

    @Column(name = "OUTPUT_AMOUNT_COLUMN_PADDING")
    private String outputAmountColumnPadding;

    @Column(name = "OUTPUT_PER_LINE_HEAD")
    private Integer outputPerLineHead;
    
    @Column(name = "OUTPUT_SIGN_LOGIC")
    private String outputSignLogic;
}
