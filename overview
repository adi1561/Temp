    private HeaderInfo parseHeaderFromInput(List<String> lines) {
        HeaderInfo info = new HeaderInfo();
        // Default values
        info.branchCode = "00000"; 
        info.reportDate = "01012026"; 

        // Regex patterns to look for (Case Insensitive)
        // 1. Branch Patterns: Matches "BRANCH :: 123" or "Branch:: 123"
        Pattern branchPattern = Pattern.compile("(?i)(?:BRANCH|Branch)\\s*::\\s*(\\d+)");

        // 2. Date Patterns: Matches "REPORT DATE ::" or "Current Year Date::"
        // We capture the value part (\S+)
        Pattern datePattern1 = Pattern.compile("REPORT DATE\\s*::\\s*(\\S+)");
        Pattern datePattern2 = Pattern.compile("Current Year Date\\s*::\\s*(\\S+)");

        for (String line : lines) {
            // --- FIND BRANCH ---
            Matcher mBranch = branchPattern.matcher(line);
            if (mBranch.find()) {
                info.branchCode = mBranch.group(1);
            }

            // --- FIND DATE ---
            Matcher mDate1 = datePattern1.matcher(line);
            if (mDate1.find()) {
                info.reportDate = normalizeDate(mDate1.group(1));
            }
            
            Matcher mDate2 = datePattern2.matcher(line);
            if (mDate2.find()) {
                info.reportDate = normalizeDate(mDate2.group(1));
            }
        }
        return info;
    }

2. New Helper: normalizeDate
Add this small helper method to your Service class. It ensures that no matter how the date comes in (2025-12-14 or 14/12/2025), it always returns 14122025.
    private String normalizeDate(String rawDate) {
        if (rawDate == null) return "01012026";
        
        // Handle "YYYY-MM-DD" (2025-12-14) -> Convert to DDMMYYYY
        if (rawDate.contains("-")) {
            String[] parts = rawDate.split("-");
            if (parts.length == 3) {
                // parts[0]=2025, parts[1]=12, parts[2]=14
                return parts[2] + parts[1] + parts[0]; 
            }
        }
        
        // Handle "DD/MM/YYYY" (14/12/2025) -> Remove slashes
        if (rawDate.contains("/")) {
            return rawDate.replace("/", "");
        }
        
        // If it's already clean or unknown format, return as is
        return rawDate;
    }

