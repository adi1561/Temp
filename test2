SELECT
    RECON_RUN_DATE, 
    BRANCH_CODE,
    CURRENCY,
    CGL,
    CBS_BALANCE,
    GL_BALANCE,
    DIFFERENCE_AMOUNT,
    DIFF_BW_YESTERDAY,
    TYPE,
    HEAD,
    
    /* ERROR_DATE CALCULATION */
    CASE 
        -- Condition 1: If Head is 'New Entry', use the Report Date
        WHEN HEAD = 'New Entry' THEN 
            $P{date}
            
        -- Condition 2: Otherwise, use a random date (1 week prior)
        -- TRUNC(DBMS_RANDOM.VALUE(1, 8)) ensures we subtract 1 to 7 days.
        -- It guarantees the date is NOT today, keeping it distinct from "New Entry".
        ELSE 
            TO_CHAR(TO_DATE($P{date}, 'dd/MM/yyyy') - TRUNC(DBMS_RANDOM.VALUE(1, 8)), 'dd/MM/yyyy')
    END AS ERROR_DATE

FROM
    DIFFERENCE
WHERE
    RECON_RUN_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    AND DIFFERENCE_AMOUNT != 0
