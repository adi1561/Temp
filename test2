package com.fincore.YearEndService.Service;

import com.fincore.YearEndService.DTO.ProfitLossSummaryDto;
import com.fincore.YearEndService.Repository.IProfitLossSummary;
import com.fincore.YearEndService.Repository.ProfitLossRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@Slf4j
public class ProfitLossServiceImpl implements ProfitLossService {

    private final ProfitLossRepository repository;

    @Override
    public List<ProfitLossSummaryDto> getCircleWiseSummary() {
        log.info("Fetching circle-wise profit/loss summary from database");

        // 1. Call the repository which now returns the Interface Projection
        List<IProfitLossSummary> results = repository.findProfitLossSummaryGroupedByCircle();

        // 2. Map the Projection results to your ProfitLossSummaryDto
        // This keeps your Controller happy without changing its return type
        return results.stream()
                .map(projection -> new ProfitLossSummaryDto(
                        projection.getTransferDate(),
                        projection.getCircleBranchCode(),
                        projection.getTotalProfitLoss()
                ))
                .collect(Collectors.toList());
    }
}
