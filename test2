package com.fincore.YearEndService.Service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.YearEndService.DTO.LhoTransferPayload;
import com.fincore.YearEndService.DTO.ProfitLossSummaryDto;
import com.fincore.YearEndService.Exception.PayloadProcessingException;
import com.fincore.YearEndService.Exception.ResourceNotFoundException;
import com.fincore.YearEndService.Model.ChangeType;
import com.fincore.YearEndService.Model.CommonReq;
import com.fincore.YearEndService.Model.RequestStatus;
import com.fincore.YearEndService.Repository.CommonRequestRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.ArrayList;
import java.util.List;

@Service
@RequiredArgsConstructor
@Slf4j
public class LhoTransferServiceImpl implements LhoTransferService {

    private final CommonRequestRepository commonRequestRepository;
    private final NotificationWriterService notificationWriterService;
    private final ObjectMapper objectMapper;
    
    // INJECTING YOUR EXISTING SERVICE
    private final ProfitLossService profitLossService;

    private static final String LHO_REQ_TYPE = "LHO_TRANSFER";

    @Override
    @Transactional
    public CommonReq createLhoTransferRequest(String batchId, String triggeredByUserId) {
        log.info("Generating LHO Transfer Request for Batch: {}", batchId);

        // 1. Fetch Real Data using YOUR ProfitLossService
        List<ProfitLossSummaryDto> summaryList = profitLossService.getCircleWiseSummary();

        // 2. Validate Data (If empty, we might want to throw error or create empty request)
        if (summaryList == null || summaryList.isEmpty()) {
            // Optional: If you want to force DUMMY data for testing when DB is empty:
            log.warn("No data found in ProfitLossService. Using DUMMY data for testing.");
            summaryList = getDummyProfitLossData(); 
            // OR throw new ResourceNotFoundException("No Profit/Loss data found.");
        }

        // 3. Calculate Totals for the Header
        BigDecimal totalAmount = summaryList.stream()
                .map(ProfitLossSummaryDto::getTotalProfitLoss)
                .reduce(BigDecimal.ZERO, BigDecimal::add);

        // 4. Build the Payload Object
        LhoTransferPayload payload = LhoTransferPayload.builder()
                .batchId(batchId)
                .processDate(LocalDate.now())
                .totalRecordCount(summaryList.size())
                .totalAmount(totalAmount)
                .circleWiseDetails(summaryList) // Directly setting your DTO list
                .build();

        // 5. Create Entity
        CommonReq request = new CommonReq();
        request.setCreatorId(triggeredByUserId);
        request.setReqType(LHO_REQ_TYPE);
        request.setChangeType(ChangeType.ADD);
        request.setReqStatus(RequestStatus.PENDING);
        request.setTargetId(batchId);
        request.setReqDate(LocalDateTime.now(ZoneId.of("Asia/Kolkata")));

        // 6. Serialize Payload
        try {
            request.setPayload(objectMapper.writeValueAsString(payload));
        } catch (Exception e) {
            log.error("Failed to serialize payload for batch: {}", batchId, e);
            throw new PayloadProcessingException("Error processing JSON payload", e);
        }

        // 7. Save
        CommonReq savedReq = commonRequestRepository.save(request);
        log.info("Saved LHO Request ID: {}", savedReq.getId());

        // 8. Notification
        try {
            notificationWriterService.createNotification(
                    null,
                    "LHO_CHECKER",
                    "New LHO Transfer Request (Batch: " + batchId + ")",
                    "/lho-approval",
                    savedReq.getId().toString(),
                    "YearEndService"
            );
        } catch (Exception e) {
            log.warn("Notification failed, but request saved.");
        }

        return savedReq;
    }

    @Override
    public List<CommonReq> getPendingLhoRequests() {
        return commonRequestRepository.findByReqStatusAndReqType(
                RequestStatus.PENDING,
                LHO_REQ_TYPE
        );
    }

    /**
     * Helper to generate DUMMY data that matches YOUR ProfitLossSummaryDto structure.
     * Used only if the real service returns empty list during testing.
     */
    private List<ProfitLossSummaryDto> getDummyProfitLossData() {
        List<ProfitLossSummaryDto> dummyList = new ArrayList<>();
        
        // Matches your DTO: LocalDate, Integer circleCode, BigDecimal amount
        dummyList.add(new ProfitLossSummaryDto(LocalDate.now(), 101, new BigDecimal("50000.00")));
        dummyList.add(new ProfitLossSummaryDto(LocalDate.now(), 102, new BigDecimal("75000.50")));
        dummyList.add(new ProfitLossSummaryDto(LocalDate.now(), 103, new BigDecimal("-12000.00"))); // Loss scenario
        
        return dummyList;
    }
}

