SELECT
    RECON_RUN_DATE, 
    BRANCH_CODE,
    CURRENCY,
    CGL,
    CBS_BALANCE,
    GL_BALANCE,
    DIFFERENCE_AMOUNT,
    DIFF_BW_YESTERDAY,
    TYPE,
    HEAD,
    
    /* ERROR_DATE LOGIC BASED ON 'TYPE' COLUMN */
    CASE 
        -- Condition 1: If TYPE is 'New Entry', use the Input Date
        WHEN TYPE = 'New Entry' THEN 
            $P{date}
            
        -- Condition 2: All other Types, use Random Date (1-7 days back)
        -- Strictly excludes today to keep 'New Entry' unique
        ELSE 
            TO_CHAR(TO_DATE($P{date}, 'dd/MM/yyyy') - TRUNC(DBMS_RANDOM.VALUE(1, 8)), 'dd/MM/yyyy')
    END AS ERROR_DATE

FROM
    DIFFERENCE
WHERE
    RECON_RUN_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    AND DIFFERENCE_AMOUNT != 0
