SELECT
    T1.BALANCE_DATE AS FOUND_DATE,
    T1.BRANCH_CODE,
    T1.CGL,
    T1.CURRENCY,
    T1.BALANCE AS TODAY_BALANCE,
    COALESCE(T2.BALANCE, 0) AS YESTERDAY_BALANCE
FROM
    GL_BALANCE T1
-- Join to find the record for the day BEFORE T1
LEFT JOIN
    GL_BALANCE T2 ON T1.BRANCH_CODE = T2.BRANCH_CODE 
    AND T1.CURRENCY = T2.CURRENCY 
    AND T1.CGL = T2.CGL
    AND T2.BALANCE_DATE = T1.BALANCE_DATE - 1
WHERE
    -- Filter 1: Restrict to your specific CGL list
    T1.CGL IN (
        '1111111111', '1111111112', '1260505001', '2148505001', '1260505003',
        '1148505004', '1148505005', '1148505006', '1148505007', '1148505010',
        '1148505012', '1148505014', '1148505020', '2148505004', '2148505006',
        '2148505007', '2148505010', '2148505011', '2148505014', '2148505016',
        '2148505018', '2148505019', '2148505021', '2148505022', '2148505024',
        '2148505033', '2148505035', '1260505002'
    )
    -- Filter 2: The Logic You Are Testing
    -- Today is NOT 0
    AND T1.BALANCE <> 0
    -- Yesterday IS 0 (or didn't exist)
    AND COALESCE(T2.BALANCE, 0) = 0
ORDER BY
    T1.BALANCE_DATE DESC
