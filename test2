2. GlBalance.java (The Entity)
Purpose: Maps the columns. I removed @GeneratedValue. This is now a "Passive" entity—it reads what exists but doesn't try to generate IDs.
package com.fincore.entity;

import jakarta.persistence.*;
import java.math.BigDecimal;
import java.time.LocalDate;
import lombok.Data;
import lombok.NoArgsConstructor;

@Entity
@Table(name = "GL_BALANCE", schema = "FINCORE")
@Data
@NoArgsConstructor
public class GlBalance {

    @Id
    @Column(name = "ID")
    // No generation strategy defined. 
    // This is safe because we are only reading, not inserting.
    private Long id;

    @Column(name = "BALANCE_DATE")
    private LocalDate balanceDate;

    @Column(name = "BRANCH_CODE")
    private String branchCode;

    @Column(name = "CURRENCY")
    private String currency;

    @Column(name = "CGL")
    private String cgl;

    @Column(name = "BALANCE")
    private BigDecimal balance;

    @Column(name = "INR_BALANCE")
    private BigDecimal inrBalance;
}

