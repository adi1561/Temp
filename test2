    @PostMapping(value = "/bulk-validate-init", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<Map<String, String>> initiateBulkValidation(
            @RequestParam("file") MultipartFile file,
            @RequestParam("postingDate") String postingDate) {

        try {
            // 1. Parse Date
            LocalDate pDate = LocalDate.parse(postingDate);

            // 2. Call Service with InputStream (Fixes "incompatible types" error & OOM)
            String requestId = journalBulkValidationService.initiateValidation(
                    file.getInputStream(),
                    file.getOriginalFilename(),
                    pDate
            );

            // 3. Return Request ID
            Map<String, String> response = new HashMap<>();
            response.put("requestId", requestId);
            response.put("status", "PROCESSING");
            return ResponseEntity.ok(response);

        } catch (IOException e) {
            log.error("IO Error during file upload", e);
            return ResponseEntity.internalServerError()
                    .body(Collections.singletonMap("message", "File Upload Failed: " + e.getMessage()));
        } catch (Exception e) {
            log.error("Init Error", e);
            return ResponseEntity.badRequest()
                    .body(Collections.singletonMap("message", "Error: " + e.getMessage()));
        }
    }

List of Validations Implemented (Excel & CSV)
 * Format Validations:
   * Amount: Cannot be null, zero, or negative. Max precision 16.4. (For INR: Max 2 decimal places).
   * Date (System Format): Must be ddMMyyyy and match the posting date.
   * Financial Year/Month: Must match calculations based on the date.
   * Product Code: Must be exactly 8 digits OR empty.
   * Remarks: Mandatory, max 30 chars.
   * Currency: Must be exactly 3 chars.
   * CGL: Must be exactly 10 digits.
   * Branch: Mandatory.
 * Structure Validations:
   * CSV: Column 0 must be "01" (System) or Branch (Normal). System format must have exactly 14 columns.
   * Excel: Checks for header row skipping. Checks for "01" in the first cell (supports string and numeric types).
   * Security: BOM Removal (CSV), Empty Row check (Excel).
 * Database Validations:
   * Branch must exist and be Active (STATUS=1).
   * Currency must exist and be Active (FLAG=1).
   * CGL must exist and be Active (STATUS=1).
 * Balance Validation:
   * Sum of Debits must equal Sum of Credits for each Branch + Currency + Account Type group. (Memo vs Normal accounts balanced separately).
