package org.example.demo1.Service;


import org.example.demo1.DTO.BillRequest;
import org.example.demo1.DTO.BillResponse;
import org.example.demo1.Models.Bill;
import org.example.demo1.Models.Item;
import org.example.demo1.Repository.BillRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class BillService {

    @Autowired
    private BillRepository billRepository;



    private double total = 0;
    private double discount = 0;


    private BillResponse createBill(BillRequest billRequest) {

        Bill bill =  new Bill();
        bill.setCustomerName(billRequest.getCustomerName());
        bill.setItems(billRequest.getItems());

        for(Item item : billRequest.getItems()) {

            total += item.getPrice();

            if(item.getCategory() == "FRUITS") {
                discount += total * 0.10;

            } else if (item.getCategory() == "ELECTRONICS") {
                discount += total * 0.50;
            }
            else {
                discount += 0;
            }
        }

       double finalAmount = total - discount;

        bill.setTotalAmount(total);

        bill.setFinalAmount(finalAmount);
        bill.setDiscountedAmount(discount);

        Bill savedOrders = billRepository.save(bill);

        BillResponse billResponse = new BillResponse();

        billResponse.setBillId(savedOrders.getId());
        billResponse.setCustomerName(savedOrders.getCustomerName());
        billResponse.setTotalAmount(savedOrders.getTotalAmount());
        billResponse.setDiscountedAmount(savedOrders.getDiscountedAmount());
        billResponse.setFinalAmount(savedOrders.getFinalAmount());

        return billResponse;






    }
}


