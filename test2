package com.fincore.ReportService.controller;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.service.DifferenceService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDate;

@RestController
@RequestMapping("/api/differences")
public class DifferenceController {

    @Autowired
    private DifferenceService service;

    // Original API
    @GetMapping
    public ResponseEntity<Page<DifferenceDTO>> getDifferences(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size
    ) {
        return ResponseEntity.ok(service.getAllDifferences(page, size));
    }

    // New API 1: Filter by Date
    @GetMapping("/search-by-date")
    public ResponseEntity<Page<DifferenceDTO>> getDifferencesByDate(
            @RequestParam("reconDate") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate reconDate,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size
    ) {
        return ResponseEntity.ok(service.getDifferencesByDate(reconDate, page, size));
    }

    // New API 2: Composite Filter
    @GetMapping("/search-detailed")
    public ResponseEntity<Page<DifferenceDTO>> getDifferencesDetailed(
            @RequestParam("reconDate") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate reconDate,
            @RequestParam("branchCode") String branchCode,
            @RequestParam("currency") String currency,
            @RequestParam("cgl") String cgl,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size
    ) {
        return ResponseEntity.ok(
            service.getDifferencesByComposite(reconDate, branchCode, currency, cgl, page, size)
        );
    }
}

