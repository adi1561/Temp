SELECT
    HEAD,
    /* Count how many are 'New Entry' */
    COUNT(
        CASE
            WHEN TYPE = 'New Entry' THEN 1
        END
    ) AS NEW_ENTRY,
    
    /* Count Total rows for this Head */
    COUNT(HEAD) AS TOTAL_COUNT
FROM
    DIFFERENCE
WHERE
    /* Filter 1: Date Match */
    RECON_RUN_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    
    /* Filter 2: Non-Zero Difference */
    AND DIFFERENCE_AMOUNT != 0
    
    /* Filter 3: CGL Master Check */
    AND CGL IN (SELECT CGL_NUMBER FROM CGL_MASTER WHERE BAL_COMPARE='1')
    
    /* Filter 4: Specific CGL IDs */
    AND CGL IN ('1002500701','1047030604','2006070601','1204505001')

GROUP BY
    HEAD
