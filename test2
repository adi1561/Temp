Here is the updated code structure implementing the two new APIs you requested.
As a Senior Engineer, I have ensured that:
 * Separation of Concerns: The filtering logic is handled in the Repository using JPQL to project directly into the DTO (avoiding fetching full Entities just to map them later).
 * Pagination: Both new endpoints support standard Spring Data pagination.
 * Type Safety: We use LocalDate with @DateTimeFormat to ensure the API handles dates correctly.
1. Repository (DifferenceRepository.java)
We add two new queries. Note that we continue to use the SELECT new ... DTO constructor syntax to ensure efficiency and exclude the ID as requested.
package com.fincore.ReportService.repository;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.model.Difference;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.time.LocalDate;

@Repository
public interface DifferenceRepository extends JpaRepository<Difference, Long> {

    // Existing "Find All" Query
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
    """)
    Page<DifferenceDTO> findAllAsDto(Pageable pageable);

    // 1. Filter by Date Only
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
        WHERE d.reconRunDate = :date
    """)
    Page<DifferenceDTO> findByDate(@Param("date") LocalDate date, Pageable pageable);

    // 2. Multi-field Filter (Date + Branch + Currency + CGL)
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
        WHERE d.reconRunDate = :date
        AND d.branchCode = :branchCode
        AND d.currency = :currency
        AND d.cgl = :cgl
    """)
    Page<DifferenceDTO> findByCompositeFilter(
            @Param("date") LocalDate date,
            @Param("branchCode") String branchCode,
            @Param("currency") String currency,
            @Param("cgl") String cgl,
            Pageable pageable
    );
}

2. Service (DifferenceService.java)
We add methods to expose these repository queries.
package com.fincore.ReportService.service;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.repository.DifferenceRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;

@Service
public class DifferenceService {

    @Autowired
    private DifferenceRepository repository;

    @Transactional(readOnly = true)
    public Page<DifferenceDTO> getAllDifferences(int page, int size) {
        // Sort by ID is fine even if ID isn't in the DTO, as long as the Entity has it
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("id"));
        return repository.findAllAsDto(pageRequest);
    }

    @Transactional(readOnly = true)
    public Page<DifferenceDTO> getDifferencesByDate(LocalDate date, int page, int size) {
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("id"));
        return repository.findByDate(date, pageRequest);
    }

    @Transactional(readOnly = true)
    public Page<DifferenceDTO> getDifferencesByComposite(
            LocalDate date, String branch, String currency, String cgl, int page, int size) {
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("id"));
        return repository.findByCompositeFilter(date, branch, currency, cgl, pageRequest);
    }
}

