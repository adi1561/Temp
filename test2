package com.fincore.ReportService.repository;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.model.Difference;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;
import java.time.LocalDate;

@Repository
public interface DifferenceRepository extends JpaRepository<Difference, Long> {

    // 1. Find All (Projects to DTO, excludes ID)
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
    """)
    Page<DifferenceDTO> findAllAsDto(Pageable pageable);

    // 2. Filter by Date
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
        WHERE d.reconRunDate = :date
    """)
    Page<DifferenceDTO> findByDate(@Param("date") LocalDate date, Pageable pageable);

    // 3. Filter by Date + Branch + Currency + CGL
    @Query("""
        SELECT new com.fincore.ReportService.dto.DifferenceDTO(
            d.reconRunDate, d.branchCode, d.currency, d.cgl,
            d.cbsBalance, d.glBalance, d.differenceAmount,
            d.diffBwYesterday, d.type, d.head, d.FIRST_ERROR_DATE
        )
        FROM Difference d
        WHERE d.reconRunDate = :date
        AND d.branchCode = :branchCode
        AND d.currency = :currency
        AND d.cgl = :cgl
    """)
    Page<DifferenceDTO> findByCompositeFilter(
            @Param("date") LocalDate date,
            @Param("branchCode") String branchCode,
            @Param("currency") String currency,
            @Param("cgl") String cgl,
            Pageable pageable
    );
}

