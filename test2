import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Button,
  Stack,
  Typography,
  CircularProgress
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import {
  PlayArrow as PlayArrowIcon,
  Info as InfoIcon
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// --- API Constants ---
// Updated to your YearEndService endpoint
const TRIGGER_API_URL = "/api/lho-transfer/trigger";

const styles = {
  mainContainer: {
    padding: 3,
    width: "100%",
    backgroundColor: "background.default",
    display: "flex",
    flexDirection: "column",
  },
  headerContainer: {
    display: "flex",
    justifyContent: "flex-end", // Align button to top right
    marginBottom: 2,
  },
  dataGridContainer: {
    height: 600,
    width: "100%",
    backgroundColor: "background.paper",
    boxShadow: 2,
    borderRadius: 2,
    border: 1,
    borderColor: "divider",
    "& .MuiDataGrid-columnHeaders": {
      backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08),
      fontWeight: "bold",
      fontSize: "0.95rem",
    },
    "& .MuiDataGrid-row:hover": {
      backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.04),
    },
  },
};

function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No Data Available</Typography>
    </Stack>
  );
}

export default function TransferDataLho() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  // State
  const [isTransferring, setIsTransferring] = useState(false);
  const [rows, setRows] = useState([]); 
  const [userId, setUserId] = useState(null);

  useEffect(() => {
    isMounted.current = true;
    
    // --- Extract UserId from Storage ---
    try {
      const authData = localStorage.getItem("persist:auth") || sessionStorage.getItem("persist:auth");
      if (authData) {
        const parsedAuth = JSON.parse(authData);
        // User field is stringified in your persist structure
        if (parsedAuth.user) {
          const userData = JSON.parse(parsedAuth.user);
          if (userData.userId) {
            setUserId(userData.userId);
          }
        }
      }
    } catch (error) {
      console.error("Error parsing user from storage:", error);
    }

    return () => {
      isMounted.current = false;
    };
  }, []);

  const handleTransferLho = async () => {
    if (!userId) {
      showSnackBar("User ID not found. Please log in again.", "error");
      return;
    }

    setIsTransferring(true);

    // The backend uses the token to get the ID, but we keep batchId in payload
    const payload = {
        "batchId": "BATCH_2023_001"
    };

    try {
      // The callApi utility usually attaches the token from storage automatically
      await callApi(TRIGGER_API_URL, payload, "POST");
      
      if (isMounted.current) {
        showSnackBar("LHO Transfer Request Generated Successfully", "success");
        // Optionally fetch pending list here to update the grid
        fetchPendingRequests();
      }
    } catch (error) {
      if (isMounted.current) {
        showSnackBar("Failed to trigger LHO Transfer", "error");
      }
    } finally {
      if (isMounted.current) setIsTransferring(false);
    }
  };

  const fetchPendingRequests = async () => {
    try {
      const response = await callApi("/api/lho-transfer/pending", null, "GET");
      if (isMounted.current && response.success) {
        setRows(response.data || []);
      }
    } catch (error) {
      console.error("Failed to fetch pending requests", error);
    }
  };

  // Run fetch on mount
  useEffect(() => {
    fetchPendingRequests();
  }, []);

  const columns = [
    {
      field: "id",
      headerName: "Req ID",
      width: 100,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "targetId",
      headerName: "Batch ID",
      flex: 1,
      minWidth: 150,
      align: "left",
      headerAlign: "left",
    },
    {
      field: "reqStatus",
      headerName: "Status",
      width: 150,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontWeight: 'bold' }}>
           {params.value === 'P' ? 'PENDING' : params.value}
        </Typography>
      )
    },
    {
        field: "reqDate",
        headerName: "Created Date",
        width: 200,
        renderCell: (params) => new Date(params.value).toLocaleString()
    }
  ];

  return (
    <Box sx={styles.mainContainer}>
      {/* Top Right Button Section */}
      <Box sx={styles.headerContainer}>
        <Button
          variant="contained"
          color="primary"
          startIcon={isTransferring ? <CircularProgress size={20} color="inherit" /> : <PlayArrowIcon />}
          onClick={handleTransferLho}
          disabled={isTransferring}
        >
          {isTransferring ? "Processing..." : "Transfer LHO"}
        </Button>
      </Box>

      <DataGrid
        rows={rows}
        columns={columns}
        loading={isTransferring}
        getRowId={(row) => row.id}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25]}
        disableColumnResize
        rowHeight={52}
        initialState={{
          pagination: { paginationModel: { page: 0, pageSize: 10 } },
        }}
        slots={{ noRowsOverlay: CustomNoRowsOverlay }}
        sx={styles.dataGridContainer}
      />
    </Box>
  );
}
