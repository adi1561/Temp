package org.example.demo1.Service;

import org.example.demo1.Models.JobApplicationModel;
import org.example.demo1.Repository.JobApplicationRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.Optional;


@Service
public class JobApplicationSerImp implements IJobApplicationService{

    @Autowired
    private JobApplicationRepo jobApplicationRepo;

    public boolean containsSubstring(String inputString, String targetSubstring) {

        return inputString.contains(targetSubstring);
    }



    @Override
    public JobApplicationModel createEntry(JobApplicationModel jobApplicationModel) throws RuntimeException{

        Optional<JobApplicationModel> result  = jobApplicationRepo.findByEmail(jobApplicationModel.getEmail());

        if(result.isPresent()) {
            throw new DuplicateApplicationException("You have already applied!");

        }
        String SkillSet = "Java";

        if(!containsSubstring(jobApplicationModel.getTechStack().toUpperCase() , SkillSet.toUpperCase())) {
            throw  new SkillMismatchException("We only hire Java developers.");

        }

        if(jobApplicationModel.getExperience() < 3 && jobApplicationModel.getExpectedSalary() > 50000) {
            throw new SalaryExpectationException("Salary too high for entry-level.");
        }

        return jobApplicationRepo.save(jobApplicationModel);



    }
}


