2. SQL Insert Data Script (For 'nwsa')
This inserts the exact logic you described:
 * Regex: Matches A, L, S followed by a digit OR N followed by a letter.
 * Amount Logic: Checks column 3 first, else column 4.
 * Calc Logic: Divides by 1000 for heads starting with L, A, S, or N.
 * Format: 16 digits total, 2 decimal places.
<!-- end list -->
INSERT INTO REPORT_CONFIG (
    REPORT_CODE, 
    FILE_TYPE, 
    OUTPUT_FILE_PATTERN, 
    INPUT_HEAD_COL_INDEX, 
    INPUT_HEAD_REGEX, 
    OUTPUT_HEAD_PADDING, 
    INPUT_AMOUNT_COL_LOGIC, 
    OUTPUT_AMOUNT_CALC_LOGIC, 
    OUTPUT_AMOUNT_FORMAT, 
    OUTPUT_AMOUNT_PADDING, 
    OUTPUT_ITEMS_PER_LINE, 
    OUTPUT_SIGN_LOGIC
) VALUES (
    'nwsa',
    '.CWP',
    'BWEP1',
    1,
    '^[ALS][0-9].*|^N[A-Z].*',
    '5 Lpad 0',
    '3 else 4',
    '^L|^A|^S|^N / 1000',
    '16,2',
    4,
    4,
    'No'
);

COMMIT;

