package org.example.demo1.Service;


import org.example.demo1.DTO.StudentRequest;
import org.example.demo1.DTO.StudentResponse;
import org.example.demo1.Models.IDCard;
import org.example.demo1.Models.Student;
import org.example.demo1.Repository.StudentRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class StudentService {


    @Autowired
    private StudentRepo studentRepo;


    public StudentResponse CreateStudent(StudentRequest studentRequest) {

        Student student = new Student();

        student.setStudentName(studentRequest.getStudentName());
        student.setEmail(studentRequest.getEmail());

        IDCard idCard = new IDCard();

        idCard.setCardNumber(studentRequest.getIdCard().getCardNumber());
        idCard.setExpiryDate(studentRequest.getIdCard().getExpiryDate());

        student.setIdCard(idCard);


        student.setCertificates(studentRequest.getCertificates());


        StudentResponse studentResponse = new StudentResponse();

        Student saved = studentRepo.save(student);

        StudentResponse response = new StudentResponse();

        response.setStudentId(saved.getId());
        response.setStudentName(saved.getStudentName());
        response.setIdCardNumber(saved.getIdCard().getCardNumber());
        response.setTotalCertificates(saved.getCertificates().size());
        response.setStatus("ADMITTED");
        return response;

    }


