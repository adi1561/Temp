4. GlBalanceRepository.java (The Speed Optimization)
Purpose: Uses a constructor expression to fetch DTOs directly, skipping the heavy Entity loading process.
package com.fincore.repository;

import com.fincore.dto.GlBalanceDTO;
import com.fincore.entity.GlBalance;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

@Repository
public interface GlBalanceRepository extends JpaRepository<GlBalance, Long> {

    @Query("""
        SELECT new com.fincore.dto.GlBalanceDTO(
            b.balanceDate, 
            b.branchCode, 
            b.currency, 
            b.cgl, 
            b.balance, 
            b.inrBalance
        ) 
        FROM GlBalance b
    """)
    Page<GlBalanceDTO> findAllAsDto(Pageable pageable);
}

5. GlBalanceService.java
Purpose: Handles the transaction.
package com.fincore.service;

import com.fincore.dto.GlBalanceDTO;
import com.fincore.repository.GlBalanceRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class GlBalanceService {

    @Autowired
    private GlBalanceRepository repository;

    @Transactional(readOnly = true)
    public Page<GlBalanceDTO> getAllBalances(int page, int size) {
        PageRequest pageRequest = PageRequest.of(page, size);
        return repository.findAllAsDto(pageRequest);
    }
}

6. GlBalanceController.java (The API Endpoint)
package com.fincore.controller;

import com.fincore.dto.GlBalanceDTO;
import com.fincore.service.GlBalanceService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/v1/balances")
public class GlBalanceController {

    @Autowired
    private GlBalanceService service;

    @GetMapping
    public ResponseEntity<Page<GlBalanceDTO>> getBalances(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int size
    ) {
        return ResponseEntity.ok(service.getAllBalances(page, size));
    }
}

