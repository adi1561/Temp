package com.fincore.YearEndService.Controller;

import com.fincore.YearEndService.DTO.ApiResponse;
import com.fincore.YearEndService.Model.CommonReq;
import com.fincore.YearEndService.Service.LhoTransferService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import java.util.Base64;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/lho-transfer")
@RequiredArgsConstructor
@Slf4j
public class LhoTransferController {

    private final LhoTransferService lhoTransferService;
    private final ObjectMapper objectMapper;

    @PostMapping("/trigger")
    public ResponseEntity<ApiResponse<CommonReq>> triggerLhoProcess(
            @RequestHeader("Authorization") String token,
            @RequestBody Map<String, String> payload
    ) {
        String batchId = payload.get("batchId");
        
        // --- DYNAMIC USER EXTRACTION ---
        // Extracting userId from the JWT Token provided in the header
        String userId = extractUserIdFromToken(token);
        
        log.info("Trigger received for Batch: {} from User: {}", batchId, userId);

        CommonReq request = lhoTransferService.createLhoTransferRequest(batchId, userId);

        return ResponseEntity.ok(ApiResponse.success(request, "LHO Transfer Request Generated Successfully"));
    }

    /**
     * Helper to decode the JWT and get userId without needing a full Security filter setup
     */
    private String extractUserIdFromToken(String token) {
        try {
            // Remove "Bearer " prefix
            String actualToken = token.replace("Bearer ", "");
            String[] chunks = actualToken.split("\\.");
            Base64.Decoder decoder = Base64.getUrlDecoder();
            
            // The payload is the second chunk
            String payload = new String(decoder.decode(chunks[1]));
            JsonNode node = objectMapper.readTree(payload);
            
            // Matches the "userId" key in your frontend example
            return node.get("userId").asText(); 
        } catch (Exception e) {
            log.error("Failed to extract userId from token", e);
            return "SYSTEM"; // Fallback
        }
    }

    @GetMapping("/pending")
    public ResponseEntity<ApiResponse<List<CommonReq>>> getPendingRequests() {
        List<CommonReq> requests = lhoTransferService.getPendingLhoRequests();
        return ResponseEntity.ok(ApiResponse.success(requests));
    }
}
