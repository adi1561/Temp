    private String reportCode;
    
    @Column(name = "FILE_TYPE")
    private String fileType;
    
    @Column(name = "OUTPUT_FILE_PATTERN")
    private String outputFilePattern;

    @Column(name = "INPUT_HEAD_COL_INDEX")
    private Integer inputHeadColIndex;

    @Column(name = "INPUT_HEAD_REGEX")
    private String inputHeadRegex;

    @Column(name = "OUTPUT_HEAD_PADDING")
    private String outputHeadPadding;

    @Column(name = "INPUT_AMOUNT_COL_LOGIC")
    private String inputAmountColLogic;

    @Column(name = "OUTPUT_AMOUNT_CALC_LOGIC")
    private String outputAmountCalcLogic;

    @Column(name = "OUTPUT_AMOUNT_FORMAT")
    private String outputAmountFormat;

    @Column(name = "OUTPUT_AMOUNT_PADDING")
    private Integer outputAmountPadding;

    @Column(name = "OUTPUT_ITEMS_PER_LINE")
    private Integer outputItemsPerLine;
    
    @Column(name = "OUTPUT_SIGN_LOGIC")
    private String outputSignLogic;
