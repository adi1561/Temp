        jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", msg, batchId);
        progressService.sendProgress(batchId, executorId, 0, "FAILED", msg);
    }

