     * Logic: Passes the prefix to the repository which uses 'LIKE branch%'
     */
    @Override
    public Page<JournalRequest> searchPendingByBranchPrefix(String branchPrefix, Pageable pageable) {
        log.info("SEARCH_BRANCH_STARTING_WITH | Prefix: {}", branchPrefix);
        return journalRequestRepository.findByBranchCodeStartingWithAndRequestStatus(
