        return journalRequestService.updateRequestStatus(dto, jwtUtil.getUserIdFromToken(token), jwtUtil.getUserRoleFromToken(token))
                .orElseThrow(() -> new CustomExceptions.FileProcessingException("Request Update Failed"));
    }

