/**
 * Exposes endpoints for searching Common General Ledger (CGL) master data.
 * Updated to use "Starts With" logic for professional financial filtering.
 */
@RestController
@RequestMapping("/api/cgl-journal")
@RequiredArgsConstructor
@Slf4j
public class CglController {

    private final CglService cglService;

    /**
     * Endpoint to search for CGLs by prefix.
     * Logic: Implements prefix matching (REQ_CGL LIKE 'query%') for high performance.
     */
    @GetMapping("/search")
    public ResponseEntity<List<CglDto>> searchCgl(
            @RequestParam(value = "query", required = false, defaultValue = "") String query) {

        if (query == null || query.trim().isEmpty()) {
            return ResponseEntity.ok(Collections.emptyList());
        }

        log.info("CGL_CONTROLLER_PREFIX_SEARCH | Action: Filtering CGLs starting with: {}", query);

        // Service layer uses the repository's findBy...StartingWith logic
        List<CglDto> results = cglService.searchCgls(query.trim());
        return ResponseEntity.ok(results);
    }
}



