/**
 * Centralizes error management to ensure consistent, secure API responses.
 * Refactored to eliminate generic Exception catching and provide descriptive
 */
@RestControllerAdvice
@Slf4j
public class GlobalExceptionHandler {

    /**
     * [cite_start]Handles JSR-303 validation failures for @Valid request payloads
     */
    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ResponseEntity<ApiErrorResponseDto> handleValidation(MethodArgumentNotValidException ex, HttpServletRequest request) {
        // Build error list without logging potentially sensitive field values[span_1](end_span)
                List<ApiErrorResponseDto.ValidationError> errors = ex.getBindingResult().getFieldErrors().stream()
                .map(err -> ApiErrorResponseDto.ValidationError.builder()
                        .field(err.getField())
                        .message(err.getDefaultMessage())
                        .build())
                .collect(Collectors.toList());

        log.warn("VALIDATION_FAILED | Path: {} | Errors: {}", request.getRequestURI(), errors.size());
        return buildResponse(HttpStatus.BAD_REQUEST, "Validation Failed", "Input validation error", request.getRequestURI(), errors);
    }

    /**
     * [span_2](start_span)Handles cases where the uploaded file exceeds the maximum configured size.[span_2](end_span)
     */
    @ExceptionHandler(MaxUploadSizeExceededException.class)
    public ResponseEntity<ApiErrorResponseDto> handleMaxSize(MaxUploadSizeExceededException ex, HttpServletRequest request) {
        log.error("FILE_TOO_LARGE | Path: {} | Details: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.PAYLOAD_TOO_LARGE, "File Too Large", "Maximum upload size exceeded", request.getRequestURI(), null);
    }

    /**
     * [span_3](start_span)Handles business logic failures during file parsing or data extraction.[span_3](end_span)
     */
    @ExceptionHandler(CustomExceptions.FileProcessingException.class)
    public ResponseEntity<ApiErrorResponseDto> handleFileProcessing(CustomExceptions.FileProcessingException ex, HttpServletRequest request) {
        log.error("FILE_PROCESS_ERROR | Path: {} | Message: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.BAD_REQUEST, "File Error", ex.getMessage(), request.getRequestURI(), null);
    }

    /**
     * [span_4](start_span)Handles concurrency conflicts, such as duplicate batch creation attempts.[span_4](end_span)
     */
    @ExceptionHandler({CustomExceptions.ConcurrencyLockException.class, IllegalStateException.class})
    public ResponseEntity<ApiErrorResponseDto> handleConcurrency(RuntimeException ex, HttpServletRequest request) {
        log.warn("CONCURRENCY_CONFLICT | Path: {} | Message: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.CONFLICT, "Operation Conflict", ex.getMessage(), request.getRequestURI(), null);
    }

    /**
     * [span_5](start_span)Handles requests for missing entities or resources.[span_5](end_span)
     */
    @ExceptionHandler(ResourceNotFoundException.class)
    public ResponseEntity<ApiErrorResponseDto> handleNotFound(ResourceNotFoundException ex, HttpServletRequest request) {
        log.info("RESOURCE_NOT_FOUND | Path: {} | Resource: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.NOT_FOUND, "Not Found", ex.getMessage(), request.getRequestURI(), null);
    }

    /**
     * [span_6](start_span)Handles cases where cached validation data has expired (TTL 1 Hour).[span_6](end_span)
     */
    @ExceptionHandler(CustomExceptions.CacheExpiredException.class)
    public ResponseEntity<ApiErrorResponseDto> handleCacheExpired(CustomExceptions.CacheExpiredException ex, HttpServletRequest request) {
        log.warn("CACHE_EXPIRED | Path: {} | Details: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.GONE, "Session Expired", ex.getMessage(), request.getRequestURI(), null);
    }

    /**
     * [cite_start]Handles database constraint violations specifically. [cite: 162-163]
     */
    @ExceptionHandler(DataIntegrityViolationException.class)
    public ResponseEntity<ApiErrorResponseDto> handleSqlIntegrity(DataIntegrityViolationException ex, HttpServletRequest request) {
        // Do not log the raw exception object to prevent leaking SQL schema details
        log.error("DB_INTEGRITY_VIOLATION | Path: {} | Type: Constraint violation", request.getRequestURI());
        return buildResponse(HttpStatus.CONFLICT, "Data Integrity Error", "Constraint violation or duplicate entry.", request.getRequestURI(), null);
    }

    /**
     * [cite_start]Handles technical database communication failures. [cite: 164-165]
     */
    @ExceptionHandler(DataAccessException.class)
    public ResponseEntity<ApiErrorResponseDto> handleDbError(DataAccessException ex, HttpServletRequest request) {
        log.error("DATABASE_ACCESS_FAIL | Path: {} | Error: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "Database Error", "A database error occurred.", request.getRequestURI(), null);
    }

    /**
     * Handles Input/Output stream failures specifically (e.g., file upload interruptions).
     */
    @ExceptionHandler(IOException.class)
    public ResponseEntity<ApiErrorResponseDto> handleIoException(IOException ex, HttpServletRequest request) {
        log.error("IO_STREAM_FAILURE | Path: {} | Reason: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "IO Error", "Failed to process file stream.", request.getRequestURI(), null);
    }

    /**
     * Final safety net for unexpected runtime failures.
     * [cite_start]Replaces the generic Exception handler to ensure only technical runtimes are caught. [cite: 166-167]
     */
    @ExceptionHandler(RuntimeException.class)
    public ResponseEntity<ApiErrorResponseDto> handleGeneralRuntime(RuntimeException ex, HttpServletRequest request) {
        log.error("UNEXPECTED_RUNTIME_FAIL | Path: {} | Type: {}", request.getRequestURI(), ex.getClass().getSimpleName());
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "Internal Server Error", "An unexpected error occurred.", request.getRequestURI(), null);
    }

    /**
     * [cite_start]Utility to build standardized response DTO. [cite: 168-169]
     */
    private ResponseEntity<ApiErrorResponseDto> buildResponse(HttpStatus status, String error, String message, String path, List<ApiErrorResponseDto.ValidationError> validationErrors) {
        ApiErrorResponseDto response = ApiErrorResponseDto.builder()
                .timestamp(LocalDateTime.now())
                .status(status.value())
                .error(error)
                .message(message)
                .path(path)
                .validationErrors(validationErrors)
                .build();
        return new ResponseEntity<>(response, status);
    }
}

