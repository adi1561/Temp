    @Override
    @Transactional
    public List<JournalRequest> createBatchRequest(BatchRequestDto dto, String creatorId, Integer creatorRole) throws JsonProcessingException {
        String batchId = sequenceService.getNextBatchId();
        Timestamp ts = Timestamp.valueOf(LocalDateTime.now());

        List<JournalRequest> entities = new ArrayList<>();
        BigDecimal totalDebit = BigDecimal.ZERO;
        BigDecimal totalCredit = BigDecimal.ZERO;
        int rowIndex = 1;

        for (BatchRequestDto.JournalRequestRow row : dto.getRows()) {
            JournalRequest entity = new JournalRequest();
            entity.setRequestStatus(RequestStatus.PENDING);
            entity.setRequestDate(LocalDateTime.now());
            entity.setCreatorId(creatorId);
            entity.setCreatorRole(creatorRole);
            entity.setBatchId(batchId);
            entity.setCommonBatchRemarks(dto.getCommonBatchRemarks());

            String journalId = batchId + "-" + rowIndex;
            entity.setJournalId(journalId);
            entity.setBranchCode(row.getBranch());
            entity.setCurrency(row.getCurrency());
            entity.setCgl(row.getCgl());

            BigDecimal amount = row.getAmount();
            entity.setAmount(amount);
            entity.setCsvDate(row.getCsvDate() != null ? row.getCsvDate() : LocalDate.now());
            entity.setNarration(row.getRemarks());
            entity.setProductCode(row.getProductType());

            Map<String, Object> payloadMap = new HashMap<>();
            payloadMap.put("csvDate", entity.getCsvDate().toString());
            payloadMap.put("branch", row.getBranch());
            payloadMap.put("currency", row.getCurrency());
            payloadMap.put("cgl", row.getCgl());
            payloadMap.put("amount", amount);
            payloadMap.put("productType", row.getProductType());
            payloadMap.put("remarks", row.getRemarks());
            payloadMap.put("arFlag", "A");
            payloadMap.put("acClassification", "A");
            payloadMap.put("batchId", batchId);
            payloadMap.put("journalId", journalId);
            payloadMap.put("commonBatchRemarks", dto.getCommonBatchRemarks());
            payloadMap.put("transactionCount", rowIndex);

            entity.setPayload(objectMapper.writeValueAsString(payloadMap));

            if (amount.compareTo(BigDecimal.ZERO) < 0) totalCredit = totalCredit.add(amount.abs());
            else totalDebit = totalDebit.add(amount.abs());

            entities.add(entity);
            rowIndex++;
        }

        List<JournalRequest> savedEntities = journalRequestRepository.saveAll(entities);

        String sumSql = "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
        jdbcTemplate.update(sumSql, batchId, creatorId, ts, dto.getCommonBatchRemarks(), entities.size(), totalDebit, totalCredit, "PENDING");

        logAudit(creatorId, "CREATE_SUCCESS", "BATCH_MANUAL", "Manual Batch " + batchId + " Created");
        sendNotification(creatorId, null, "Manual Batch " + batchId + " created successfully.", batchId);

        return savedEntities;
    }


    // --- Overrides ---
    @Override public Page<JournalRequest> getRequestsByBatchIdPaginated(String b, Pageable p) { return journalRequestRepository.findByBatchIdPaginated(b, p); }
    @Override public List<JournalRequest> getRequestsByBatchId(String b) { return journalRequestRepository.findByBatchId(b); }
    @Override public List<JournalRequest> getMyRequests(String u) { return new ArrayList<>(); }
//    @Override public List<JournalRequest> getPendingRequests(String u, Integer r) { return new ArrayList<>(); }
    /**
     * FETCH ALL PENDING REQUESTS
     * Replaces the empty placeholder to provide a default view for the search screen.
     */
    @Override
    public List<JournalRequest> getPendingRequests(String userId, Integer roleId) {
        return journalRequestRepository.findByRequestStatus(RequestStatus.PENDING);
    }
    @Override public List<JournalRequestStatusDto> getJournalRequestStatusList() { return new ArrayList<>(); }
    @Override @Transactional public void cancelMyRequest(Long r, String u) { journalRequestRepository.deleteById(r); }
    @Override @Transactional public void cancelMyRequestsByBatchId(String b, String u) { cancelMyRequestsByBatchIdAsync(b, u); }
    @Override @Transactional public void cancelMyRequestsByJournalPrefixes(List<String> l, String u) { journalRequestRepository.deleteJournalsNative(l, u); }
