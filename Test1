    // ==================================================================================
    // 1. REDIS STATE MANAGEMENT
    // ==================================================================================
    private void saveStatusToRedis(String reqId, BulkUploadStateDto state) {
        try {
            byte[] json = objectMapper.writeValueAsBytes(state);
            redisTemplate.opsForValue().set("BULK_STATUS_" + reqId, json, 2, TimeUnit.HOURS);
        } catch (JsonProcessingException e) {
            log.error("SERIALIZATION_FAIL | ReqID: {}", reqId);
        } catch (DataAccessException e) {
            log.error("REDIS_WRITE_FAIL | ReqID: {}", reqId);
        }
    }
    private BulkUploadStateDto getStatusFromRedis(String reqId) {
        try {
            byte[] json = redisTemplate.opsForValue().get("BULK_STATUS_" + reqId);
            if (json == null) return null;
            return objectMapper.readValue(json, BulkUploadStateDto.class);
        } catch (IOException | DataAccessException e) {
            return null;
        }
    }

    public BulkUploadStateDto getState(String reqId) {
        return getStatusFromRedis(reqId);
    }

    public byte[] getFileBytes(String reqId, String type) {
        try {
            return redisTemplate.opsForValue().get("FILE_" + reqId + "_" + type);
        } catch (DataAccessException e) {
            return null;
        }
    }

    public List<ExcelRowData> getValidRowsFromCache(String requestId) {
        byte[] metaBytes = redisTemplate.opsForValue().get("DATA_META_" + requestId);
        if (metaBytes == null) {
            throw new CustomExceptions.CacheExpiredException("Validation data expired. Please re-upload.");
        }

        try {
            Map<String, Object> meta = objectMapper.readValue(metaBytes, new TypeReference<>() {});
            int totalChunks = (int) meta.get("totalChunks");
            int totalRows = (int) meta.get("totalRows");
            List<ExcelRowData> allRows = new ArrayList<>(totalRows);

            for (int i = 0; i < totalChunks; i++) {
                byte[] compressedChunk = redisTemplate.opsForValue().get("DATA_CHUNK_" + requestId + "_" + i);
                try (GZIPInputStream gis = new GZIPInputStream(new ByteArrayInputStream(compressedChunk))) {
                    List<ExcelRowData> chunkRows = objectMapper.readValue(gis, new TypeReference<List<ExcelRowData>>() {});
                    allRows.addAll(chunkRows);
                }
            }
            return allRows;
        } catch (IOException | DataAccessException e) {
            throw new CustomExceptions.FileProcessingException("Failed to reconstruct cached data", e);
        }
    }

    // ==================================================================================
    // 2. STREAMING INITIALIZATION & ASYNC LOOP
    // ==================================================================================

    public String initiateValidation(InputStream fileStream, String filename, LocalDate postingDate) throws IOException {
        if (filename == null || (!filename.toLowerCase().endsWith(".csv") &&
                !filename.toLowerCase().endsWith(".txt") &&
                !filename.toLowerCase().endsWith(".xlsx"))) {
            throw new CustomExceptions.FileProcessingException("Unsupported file type.");
        }

        String requestId = UUID.randomUUID().toString();
        Path tempFile = Files.createTempFile("UPLOAD_" + requestId + "_", ".tmp");
        Files.copy(fileStream, tempFile, StandardCopyOption.REPLACE_EXISTING);

        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1);
        state.setMessage("Initializing Upload...");
        saveStatusToRedis(requestId, state);

        self.processAsync(requestId, tempFile.toString(), filename, postingDate);
        return requestId;
    }

    @Async("bulkExecutor")
    public void processAsync(String requestId, String tempFilePath, String filename, LocalDate postingDate) {
        MDC.put("requestId", requestId);
        File tempFile = new File(tempFilePath);

        try {
            updateState(requestId, s -> s.setMessage("Parsing File..."));
            ParsingResult parsingResult;
            boolean isCsv = filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"));

            try (InputStream is = new FileInputStream(tempFile)) {
                parsingResult = isCsv ? parseCsvStream(is, postingDate) : parseExcelStream(is, postingDate);
            }

            List<ExcelRowData> parsedRows = parsingResult.rows;
            if (parsedRows == null || parsedRows.isEmpty()) {
                throw new CustomExceptions.InvalidDataException("File data is empty.");
            }

            updateState(requestId, s -> {
                s.setTotalRows(parsedRows.size());
                s.setMessage("Validating Formats...");
            });

            runFormatCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Format Validation Failed", 1, parsingResult.hasProductColumn);
                return;
            }

            updateState(requestId, s -> { s.setCurrentStage(2); s.setMessage("Checking Database..."); });
            runDbCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Database Validation Failed", 2, parsingResult.hasProductColumn);
                return;
            }

            updateState(requestId, s -> { s.setCurrentStage(3); s.setMessage("Checking Balances..."); });
            runBalanceCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Balance Mismatch", 3, parsingResult.hasProductColumn);
                return;
            }

            completeRequest(requestId, parsedRows, postingDate, isCsv, parsingResult.hasProductColumn);

        } catch (Exception e) {
            handleAsyncCrash(requestId, e.getMessage());
        } finally {
            if (tempFile.exists()) tempFile.delete();
            MDC.clear();
        }
    }

    private void handleAsyncCrash(String requestId, String message) {
        updateState(requestId, s -> {
            s.setStatus("ERROR");
            s.setMessage(message);
        });
    }

    // ==================================================================================
    // 3. UPDATED EXCEL STREAMING (FIXES NoSuchMethodError)
    // ==================================================================================

    private ParsingResult parseExcelStream(InputStream is, LocalDate postingDate) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        final boolean[] hasProductCol = {false};

        try (OPCPackage pkg = OPCPackage.open(is)) {
            ReadOnlySharedStringsTable strings = new ReadOnlySharedStringsTable(pkg);
            XSSFReader xssfReader = new XSSFReader(pkg);
            StylesTable styles = xssfReader.getStylesTable();
            XSSFReader.SheetIterator iter = (XSSFReader.SheetIterator) xssfReader.getSheetsData();

            if (iter.hasNext()) {
                try (InputStream sheetStream = iter.next()) {
                    XMLReader sheetParser = XMLHelper.newXMLReader();

                    // Corrected: XSSFSheetXMLHandler (Native POI Event API)
                    XSSFSheetXMLHandler handler = new XSSFSheetXMLHandler(styles, strings, new XSSFSheetXMLHandler.SheetContentsHandler() {
                        private ExcelRowData currentRow;
                        private Map<Integer, String> rowValues = new HashMap<>();

                        @Override
                        public void startRow(int rowNum) {
                            currentRow = new ExcelRowData();
                            currentRow.rowIndex = rowNum;
                            rowValues.clear();
                        }

                        @Override
                        public void cell(String cellRef, String val, org.apache.poi.xssf.usermodel.XSSFComment comment) {
                            int colIdx = new org.apache.poi.ss.util.CellReference(cellRef).getCol();
                            rowValues.put(colIdx, val);
                        }

                        @Override
                        public void endRow(int rowNum) {
                            // Header skip logic
                            if (rowNum == 0) {
                                String h = rowValues.getOrDefault(0, "").toLowerCase();
                                if (h.contains("branch") || h.contains("batch")) return;
                            }
                            
                            if (rowValues.isEmpty()) return;
                            
                            // Apply your original "01" vs "Standard" logic
                            applyBusinessMapping(currentRow, rowValues, hasProductCol, postingDate);
                            list.add(currentRow);
                        }
                    }, false);

                    sheetParser.setContentHandler(handler);
                    sheetParser.parse(new InputSource(sheetStream));
                }
            }
        } catch (Exception e) {
            log.error("EXCEL_EVENT_PARSE_FAIL | Reason: {}", e.getMessage());
            throw new IOException("Failed to parse Excel using Event API", e);
        }
        return new ParsingResult(list, hasProductCol[0]);
    }

    private void applyBusinessMapping(ExcelRowData d, Map<Integer, String> values, boolean[] hasProduct, LocalDate postingDate) {
        String col0 = values.getOrDefault(0, "").trim();
        d.sysSite = col0;

        // ORIGINAL BUSINESS LOGIC PRESERVED
        if ("01".equals(col0) || "1".equals(col0)) {
            d.isSystemFormat = true;
            d.sysDate = values.getOrDefault(1, "");
            d.sysYear = values.getOrDefault(2, "");
            d.sysPeriod = values.getOrDefault(3, "");
            d.branch = values.getOrDefault(4, "");
            d.currency = values.getOrDefault(5, "").toUpperCase();
            d.cgl = values.getOrDefault(6, "");
            parseAmount(d, values.getOrDefault(7, ""), values.getOrDefault(8, ""));
            d.remarks = values.getOrDefault(9, "");
            String rawProd = values.getOrDefault(10, "");
            d.productCode = rawProd;
            if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) hasProduct[0] = true;

            validateSystemColumns(d, col0, d.sysDate, d.sysYear, d.sysPeriod, 
                values.getOrDefault(11, ""), values.getOrDefault(12, ""), values.getOrDefault(13, ""), postingDate);
        } else {
            d.branch = col0;
            d.currency = values.getOrDefault(1, "").toUpperCase();
            d.cgl = values.getOrDefault(2, "");
            parseAmount(d, values.getOrDefault(3, ""), values.getOrDefault(4, ""));
            d.remarks = values.getOrDefault(5, "");
            String rawProd = values.getOrDefault(6, "");
            d.productCode = rawProd;
            if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) hasProduct[0] = true;
        }
    }

    // ==================================================================================
    // 4. CSV PARSER (Preserved exactly)
    // ==================================================================================
    private ParsingResult parseCsvStream(InputStream is, LocalDate postingDate) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        boolean hasProductCol = false;
        try (BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
            String line; int i = 0;
            while ((line = br.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] c = line.split(",", -1);
                if (i == 0 && c[0].toLowerCase().contains("branch")) { i++; continue; }
                ExcelRowData d = new ExcelRowData(); d.rowIndex = i++;
                String c0 = c[0].replace("\uFEFF", "").trim(); d.sysSite = c0;

                if ("01".equals(c0)) {
                    d.isSystemFormat = true;
                    if (c.length > 6) { d.sysDate=c[1].trim(); d.sysYear=c[2].trim(); d.sysPeriod=c[3].trim(); d.branch=c[4].trim(); d.currency=c[5].trim().toUpperCase(); d.cgl=c[6].trim(); }
                    parseAmount(d, c.length > 7 ? c[7].trim() : "", c.length > 8 ? c[8].trim() : "");
                    if (c.length > 9) d.remarks = c[9].trim();
                    if (c.length > 10) {
                        d.productCode = c[10].trim();
                        if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProductCol = true;
                    }
                    if (c.length != 14) d.formatErrors.add("Invalid CSV columns (Expected 14)");
                    else validateSystemColumns(d, c0, d.sysDate, d.sysYear, d.sysPeriod, c[11].trim(), c[12].trim(), c[13].trim(), postingDate);
                } else {
                    if (c.length > 2) { d.branch=c[0].trim(); d.currency=c[1].trim().toUpperCase(); d.cgl=c[2].trim(); }
                    parseAmount(d, c.length > 3 ? c[3].trim() : "", c.length > 4 ? c[4].trim() : "");
                    if (c.length > 5) d.remarks = c[5].trim();
                    if (c.length > 6) {
                        d.productCode = c[6].trim();
                        if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProductCol = true;
                    }
                }
                list.add(d);
            }
        }
        return new ParsingResult(list, hasProductCol);
    }

    private void parseAmount(ExcelRowData d, String amountRaw, String typeRaw) {
        try {
            String amtClean = (amountRaw == null) ? "" : amountRaw.trim();
            if (amtClean.contains("-") || amtClean.contains("(") || amtClean.contains(")")) d.formatErrors.add("Amount cannot be negative");
            String clean = CLEAN_AMOUNT_REGEX.matcher(amtClean).replaceAll("");
            if (clean.isEmpty()) { d.amount = BigDecimal.ZERO; return; }
            BigDecimal v = new BigDecimal(clean);
            boolean isCredit = typeRaw != null && (typeRaw.toUpperCase().contains("C") || typeRaw.toUpperCase().contains("CR"));
            d.txnType = isCredit ? "Credit" : "Debit";
            d.amount = v;
        } catch (Exception e) { d.amount = BigDecimal.ZERO; d.formatErrors.add("Invalid numeric format"); }
    }

    // ==================================================================================
    // 5. VALIDATION STAGES (Preserved)
    // ==================================================================================
    private void runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) d.formatErrors.add("Amount cannot be Zero");
            if (d.productCode != null && !d.productCode.isEmpty() && !d.productCode.equals("A") && !PRODUCT_CODE_REGEX.matcher(d.productCode).matches())
                d.formatErrors.add("Product Code must be 8 digits");
            if (d.remarks == null || d.remarks.trim().isEmpty()) d.formatErrors.add("Remarks is Mandatory");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("CGL must be 10 digits");
        });
    }

    private void runDbCheck(List<ExcelRowData> rows) {
        Set<String> vBranches = validationMasterService.getAllActiveBranches();
        Set<String> vCurrs = validationMasterService.getAllActiveCurrencies();
        Set<String> vCgls = validationMasterService.getAllActiveCgls();
        rows.parallelStream().forEach(d -> {
            if (!vBranches.contains(d.branch)) d.dbErrors.add("Branch Inactive: " + d.branch);
            if (!vCurrs.contains(d.currency)) d.dbErrors.add("Currency Inactive: " + d.currency);
            if (!vCgls.contains(d.cgl)) d.dbErrors.add("CGL Inactive: " + d.cgl);
        });
    }

    private void runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(d -> {
            BigDecimal val = "Credit".equals(d.txnType) ? d.amount.negate() : d.amount;
            String type = (d.cgl != null && d.cgl.startsWith("5")) ? "MEMO" : "NORMAL";
            String key = d.branch + "_" + d.currency + "_" + type;
            balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val.multiply(new BigDecimal("10000")).longValue());
        });
        rows.parallelStream().forEach(d -> {
            String key = d.branch + "_" + d.currency + "_" + (d.cgl.startsWith("5") ? "MEMO" : "NORMAL");
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(adder.sum()).divide(new BigDecimal("10000"), 4, RoundingMode.HALF_UP);
                synchronized (d.balErrors) { if (d.balErrors.isEmpty()) d.balErrors.add("Balance Mismatch: " + diff.toPlainString()); }
            }
        });
    }

    private void validateSystemColumns(ExcelRowData d, String c0, String cDate, String cYear, String cMonth, String c11, String c12, String c13, LocalDate postingDate) {
        try {
            LocalDate parsedDate = LocalDate.parse(cDate.trim(), SYSTEM_DATE_FMT);
            if (!parsedDate.equals(postingDate)) d.formatErrors.add("Date Mismatch");
            String eYear = (parsedDate.getMonthValue() >= 4) ? String.valueOf(parsedDate.getYear()) : String.valueOf(parsedDate.getYear() - 1);
            if (!cYear.trim().equals(eYear)) d.formatErrors.add("Invalid Year");
        } catch (Exception e) { d.formatErrors.add("Invalid Date"); }
    }

    // ==================================================================================
    // 6. FINISHERS & STORAGE
    // ==================================================================================

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProduct) throws IOException {
        updateState(reqId, s -> {
            s.setStatus("ERROR"); s.setMessage(msg); s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count()); s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv, boolean hasProduct) throws IOException {
        saveRowsToRedis(reqId, rows);
        updateState(reqId, s -> {
            s.setCurrentStage(4); s.setStatus("SUCCESS"); s.setMessage("Validation Successful");
            s.setHasProductColumn(hasProduct);
        });
    }

    private void saveRowsToRedis(String requestId, List<ExcelRowData> rows) {
        try {
            int chunkSize = 5000; int totalRows = rows.size();
            int totalChunks = (int) Math.ceil((double) totalRows / chunkSize);
            for (int i = 0; i < totalChunks; i++) {
                int start = i * chunkSize; int end = Math.min(start + chunkSize, totalRows);
                try (ByteArrayOutputStream baos = new ByteArrayOutputStream(); GZIPOutputStream gos = new GZIPOutputStream(baos)) {
                    objectMapper.writeValue(gos, rows.subList(start, end)); gos.finish();
                    redisTemplate.opsForValue().set("DATA_CHUNK_" + requestId + "_" + i, baos.toByteArray(), 1, TimeUnit.HOURS);
                }
            }
            Map<String, Object> meta = new HashMap<>(); meta.put("totalChunks", totalChunks); meta.put("totalRows", totalRows);
            redisTemplate.opsForValue().set("DATA_META_" + requestId, objectMapper.writeValueAsBytes(meta), 1, TimeUnit.HOURS);
        } catch (Exception e) { log.error("CACHE_SAVE_FAIL | ReqID: {}", requestId); }
    }

    private synchronized void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        BulkUploadStateDto state = getStatusFromRedis(requestId);
        if (state == null) { state = new BulkUploadStateDto(); state.setRequestId(requestId); }
        updater.accept(state); saveStatusToRedis(requestId, state);
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>(); m.put("id", r.rowIndex); m.put("branch", r.branch);
        m.put("currency", r.currency); m.put("cgl", r.cgl); m.put("amount", r.amount != null ? r.amount.toString() : "");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }

    private static class ParsingResult {
        List<ExcelRowData> rows; boolean hasProductColumn;
        public ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) { this.rows = rows; this.hasProductColumn = hasProductColumn; }
    }

    @JsonIgnoreProperties(ignoreUnknown = true)
    @JsonFormat(shape = JsonFormat.Shape.ARRAY)
    public static class ExcelRowData {
        @JsonProperty("0") public int rowIndex;
        @JsonProperty("1") public String branch = "";
        @JsonProperty("2") public String currency = "";
        @JsonProperty("3") public String cgl = "";
        @JsonProperty("4") public String txnType = "";
        @JsonProperty("5") public String remarks = "";
        @JsonProperty("6") public String productCode = "";
        @JsonProperty("7") public BigDecimal amount;
        @JsonProperty("8") public boolean isSystemFormat = false;
        @JsonProperty("9") public String sysSite = "";
        @JsonProperty("10") public String sysDate = "";
        @JsonProperty("11") public String sysYear = "";
        @JsonProperty("12") public String sysPeriod = "";
        @JsonProperty("13") public final List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());
        @JsonProperty("14") public final List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());
        @JsonProperty("15") public final List<String> balErrors = Collections.synchronizedList(new ArrayList<>());
        public boolean hasErrors() { return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty(); }
        @JsonIgnore public String getAllErrors() {
            List<String> all = new ArrayList<>(formatErrors); all.addAll(dbErrors); all.addAll(balErrors);
            return String.join("; ", all);
        }
    }
