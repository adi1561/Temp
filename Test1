            log.error("PROCESS_ABORTED | ReqID: {} | ErrorType: {} | Message: {}", 
                      requestId, e.getClass().getSimpleName(), e.getMessage());
            updateState(requestId, s -> {
                s.setStatus("ERROR");
                s.setMessage("Critical system failure during processing");
            });
        } finally {
            if (tempFile.exists()) tempFile.delete();
            MDC.clear();
        }
    }

    private void parseAmount(ExcelRowData d, String amountRaw, String typeRaw) {
        try {
            String clean = CLEAN_AMOUNT_REGEX.matcher(amountRaw != null ? amountRaw : "").replaceAll("");
            if (clean.isEmpty()) {
                d.amount = BigDecimal.ZERO;
                return;
            }
            BigDecimal v = new BigDecimal(clean);
            boolean isCredit = typeRaw != null && (typeRaw.toUpperCase().contains("C") || typeRaw.toUpperCase().contains("CR"));
            d.txnType = isCredit ? "Credit" : "Debit";
            d.amount = v;
        } catch (NumberFormatException | ArithmeticException e) {
            log.warn("DATA_ENTRY_ERROR | Row: {} | Field: AMOUNT | Status: NON_NUMERIC", d.rowIndex);
            d.amount = BigDecimal.ZERO;
        }
    }

    private void validateSystemColumns(ExcelRowData d, String c0, String cDate, String cYear, String cMonth, String c11, String c12, String c13, LocalDate postingDate) {
        try {
            LocalDate parsedDate = LocalDate.parse(cDate.trim(), SYSTEM_DATE_FMT);
            if (!parsedDate.equals(postingDate)) d.formatErrors.add("Posting Date Mismatch");
        } catch (DateTimeParseException | NullPointerException e) {
            log.warn("DATA_ENTRY_ERROR | Row: {} | Field: SYSTEM_DATE | Status: INVALID_FORMAT", d.rowIndex);
            d.formatErrors.add("Invalid Date Format (Expected ddMMyyyy)");
        }
    }

    private void saveRowsToRedis(String requestId, List<ExcelRowData> rows) {
        long start = System.currentTimeMillis();
        try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
             GZIPOutputStream gos = new GZIPOutputStream(baos)) {
            objectMapper.writeValue(gos, rows);
            gos.finish();
            byte[] compressed = baos.toByteArray();
            redisTemplate.opsForValue().set("DATA_" + requestId, compressed, 1, TimeUnit.HOURS);
            log.info("CACHE_STORE_SUCCESS | ReqID: {} | Rows: {} | ByteSize: {} | Duration: {}ms", 
                     requestId, rows.size(), compressed.length, (System.currentTimeMillis() - start));
        } catch (IOException | DataAccessException e) {
            log.error("CACHE_STORE_FAIL | ReqID: {} | Action: PERSIST_ROWS | Reason: {}", requestId, e.getMessage());
        }
    }

    private ParsingResult parseCsvStream(InputStream is, LocalDate pDate) throws IOException { 
        List<ExcelRowData> list = new ArrayList<>();
        boolean hasProductCol = false;
        try (BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
            String line;
            int i = 0;
            while ((line = br.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] c = line.split(",", -1);
                if (i == 0) {
                    String h = c.length > 0 ? c[0].trim().toLowerCase() : "";
                    if ((h.contains("branch") || h.contains("batch")) && !h.equals("01")) { i++; continue; }
                }
                ExcelRowData d = new ExcelRowData();
                d.rowIndex = i++;
                String col0 = c.length > 0 ? c[0].replace("\uFEFF", "").trim() : "";
                d.sysSite = col0;
                if ("01".equals(col0)) {
                    d.isSystemFormat = true;
                    if (c.length > 4) d.branch = c[4].trim();
                    if (c.length > 5) d.currency = c[5].trim().toUpperCase();
                    if (c.length > 6) d.cgl = c[6].trim();
                    parseAmount(d, c.length > 7 ? c[7].trim() : "", c.length > 8 ? c[8].trim() : "");
                    if (c.length > 9) d.remarks = c[9].trim();
                    if (c.length > 10) { d.productCode = c[10].trim(); hasProductCol = true; }
                    validateSystemColumns(d, col0, c.length > 1 ? c[1].trim() : "", c.length > 2 ? c[2].trim() : "", c.length > 3 ? c[3].trim() : "", c.length > 11 ? c[11].trim() : "", c.length > 12 ? c[12].trim() : "", c.length > 13 ? c[13].trim() : "", pDate);
                } else {
                    if (c.length > 0) d.branch = c[0].trim();
                    if (c.length > 1) d.currency = c[1].trim().toUpperCase();
                    if (c.length > 2) d.cgl = c[2].trim();
                    parseAmount(d, c.length > 3 ? c[3].trim() : "", c.length > 4 ? c[4].trim() : "");
                    if (c.length > 5) d.remarks = c[5].trim();
                    if (c.length > 6) { d.productCode = c[6].trim(); hasProductCol = true; }
                }
                if (d.productCode.isEmpty()) d.productCode = "A";
                list.add(d);
            }
        }
        return new ParsingResult(list, hasProductCol);
    }

    private ParsingResult parseExcelStream(InputStream is, LocalDate pDate) throws IOException { try (Workbook wb = new XSSFWorkbook(is)) { return parseSheet(wb.getSheetAt(0), pDate); } }
    
    private ParsingResult parseSheet(Sheet sheet, LocalDate postingDate) {
        List<ExcelRowData> list = new ArrayList<>();
        DataFormatter fmt = new DataFormatter();
        boolean hasProductCol = false;
        for (Row r : sheet) {
            if (isRowEmpty(r)) continue;
            if (r.getRowNum() == 0) {
                String h = fmt.formatCellValue(r.getCell(0)).toLowerCase();
                if ((h.contains("branch") || h.contains("batch")) && !h.equals("01")) continue;
            }
            ExcelRowData d = new ExcelRowData();
            d.rowIndex = r.getRowNum();
            String col0 = parseCode(r.getCell(0), fmt);
            if ("01".equals(col0) || "1".equals(col0)) {
                d.isSystemFormat = true;
                d.sysSite = col0;
                d.branch = parseCode(r.getCell(4), fmt);
                d.currency = fmt.formatCellValue(r.getCell(5)).trim().toUpperCase();
                d.cgl = parseCode(r.getCell(6), fmt);
                parseAmount(d, fmt.formatCellValue(r.getCell(7)), fmt.formatCellValue(r.getCell(8)));
                d.remarks = fmt.formatCellValue(r.getCell(9)).trim();
                if (r.getLastCellNum() > 10) { d.productCode = parseCode(r.getCell(10), fmt); hasProductCol = true; }
                validateSystemColumns(d, col0, parseCode(r.getCell(1), fmt), parseCode(r.getCell(2), fmt), parseCode(r.getCell(3), fmt), parseCode(r.getCell(11), fmt), parseCode(r.getCell(12), fmt), parseCode(r.getCell(13), fmt), postingDate);
            } else {
                d.branch = col0;
                d.currency = fmt.formatCellValue(r.getCell(1)).trim().toUpperCase();
                d.cgl = parseCode(r.getCell(2), fmt);
                parseAmount(d, fmt.formatCellValue(r.getCell(3)), fmt.formatCellValue(r.getCell(4)));
                d.remarks = fmt.formatCellValue(r.getCell(5)).trim();
                if (r.getLastCellNum() > 6) { d.productCode = parseCode(r.getCell(6), fmt); hasProductCol = true; }
            }
            if (d.productCode == null || d.productCode.isEmpty()) d.productCode = "A";
            list.add(d);
        }
        return new ParsingResult(list, hasProductCol);
    }

    private void runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) d.formatErrors.add("Amount cannot be Zero");
            if (d.remarks == null || d.remarks.trim().isEmpty()) d.formatErrors.add("Remarks Mandatory");
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Currency must be 3 chars");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("CGL must be 10 digits");
            if (d.branch == null || d.branch.isEmpty()) d.formatErrors.add("Branch Mandatory");
        });
    }

    private void runDbCheck(List<ExcelRowData> rows) {
        Set<String> validBranches = validationMasterService.getAllActiveBranches();
        Set<String> validCurrs = validationMasterService.getAllActiveCurrencies();
        Set<String> validCgls = validationMasterService.getAllActiveCgls();
        rows.parallelStream().forEach(d -> {
            if (!validBranches.contains(d.branch)) d.dbErrors.add("Invalid Branch");
            if (!validCurrs.contains(d.currency)) d.dbErrors.add("Invalid Currency");
            if (!validCgls.contains(d.cgl)) d.dbErrors.add("Invalid CGL");
        });
    }

    private void runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(d -> {
            if (d.amount != null) {
                BigDecimal val = "Credit".equals(d.txnType) ? d.amount.negate() : d.amount;
                String type = (d.cgl != null && d.cgl.startsWith("5")) ? "MEMO" : "NORMAL";
                String key = d.branch + "_" + d.currency + "_" + type;
                balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val.multiply(new BigDecimal("10000")).longValue());
            }
        });
        rows.parallelStream().forEach(d -> {
            String type = (d.cgl != null && d.cgl.startsWith("5")) ? "MEMO" : "NORMAL";
            String key = d.branch + "_" + d.currency + "_" + type;
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                if (d.balErrors.isEmpty()) d.balErrors.add(type + " Balance Mismatch detected");
            }
        });
    }

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProd) throws IOException {
        log.warn("VALIDATION_REJECTED | ReqID: {} | Stage: {} | Reason: {}", reqId, stage, msg);
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv) throws IOException {
        saveRowsToRedis(reqId, rows);
        updateState(reqId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Data Validated Successfully");
            s.setHasSuccessFile(!isCsv);
        });
    }

    private void updateState(String reqId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        BulkUploadStateDto state = getStatusFromRedis(reqId);
        if (state != null) { updater.accept(state); saveStatusToRedis(reqId, state); }
    }

    private String parseCode(Cell c, DataFormatter f) { if (c == null) return ""; if (c.getCellType() == CellType.NUMERIC) return BigDecimal.valueOf(c.getNumericCellValue()).toPlainString().split("\\.")[0]; return f.formatCellValue(c).trim(); }
    private boolean isRowEmpty(Row r) { if (r == null) return true; for (int c = r.getFirstCellNum(); c < r.getLastCellNum(); c++) if (r.getCell(c) != null && r.getCell(c).getCellType() != CellType.BLANK && !r.getCell(c).toString().trim().isEmpty()) return false; return true; }

    private static class ParsingResult {
        List<ExcelRowData> rows;
        boolean hasProductColumn;
        ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) { this.rows = rows; this.hasProductColumn = hasProductColumn; }
    }

