package org.example.demo1.Service;


import org.example.demo1.DTO.AccountRequest;
import org.example.demo1.DTO.AccountResponce;
import org.example.demo1.Models.Account;
import org.example.demo1.Repository.AccountRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.Random;

@Service
public class AccountService {

    @Autowired
    private AccountRepo accountRepo;
    public static long generateRandomTenDigitNumber() {
        long min = 1000000000L;
        long max = 9999999999L;

        Random random = new Random();

        long range = max - min + 1;
        long randomNumber = (long) (random.nextDouble() * range) + min;


        return randomNumber;
    }
    public AccountResponce createAccount(AccountRequest accountRequest) {

        Account account = new Account();

        if(accountRequest.getIntialDeposite() < 1000) {
            throw  new InvalidAmountException("Minimum deposit is 1000");
        }
        else {
            account.setBalance(accountRequest.getIntialDeposite());
        }

        account.setOwnerName(accountRequest.getOwnerName());

        account.setAccountNumber(generateRandomTenDigitNumber());

        if(accountRequest.getPin().length() <= 4) {
            throw new InvalidPinException("Pin must be 4 digits");
        }
        else {
            account.setPin(accountRequest.getPin());

        }

        Account savedData = accountRepo.save(account);

        AccountResponce accountResponce = new AccountResponce();

        accountResponce.setAccountNumber(savedData.getAccountNumber());
        accountResponce.setOwnerName(savedData.getOwnerName());
        accountResponce.setBalance(savedData.getBalance());

        return accountResponce;



    }


}



