    private byte[] generateErrorExcelFast(List<ExcelRowData> rows, boolean includeProduct) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) {
            Sheet sheet = workbook.createSheet("Error Report");
            CellStyle errStyle = workbook.createCellStyle();
            Font f = workbook.createFont();
            f.setColor(IndexedColors.RED.getIndex());
            errStyle.setFont(f);
            Row h = sheet.createRow(0);

            List<String> headerList = new ArrayList<>(Arrays.asList("Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks"));
            if (includeProduct) headerList.add("Product");
            headerList.add("ERRORS");

            if (rows.stream().anyMatch(r -> r.isSystemFormat))
                headerList.addAll(0, Arrays.asList("Site", "Date", "Year", "Month"));

            for (int i = 0; i < headerList.size(); i++) h.createCell(i).setCellValue(headerList.get(i));

            int idx = 1;
            boolean isSystem = rows.stream().anyMatch(r -> r.isSystemFormat);
            for (ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                int col = 0;
                if (isSystem) {
                    r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.sysSite));
                    r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.sysDate));
                    r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.sysYear));
                    r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.sysPeriod));
                }
                r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.branch));
                r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.currency));
                r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.cgl));
                r.createCell(col++).setCellValue(d.amount != null ? d.amount.toString() : "");
                r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.txnType));
                r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.remarks));

                if (includeProduct) r.createCell(col++).setCellValue(sanitizeForCsvInjection(d.productCode));

                Cell c = r.createCell(col);
                if (d.hasErrors()) {
                    c.setCellValue(d.getAllErrors());
                    c.setCellStyle(errStyle);
                }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            return out.toByteArray();
        }
    }

    private String sanitizeForCsvInjection(String value) {
        if (value == null) return "";
        if (value.startsWith("=") || value.startsWith("+") || value.startsWith("-") || value.startsWith("@")) {
            return "'" + value;
        }
        return value;
    }

