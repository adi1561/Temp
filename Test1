private void saveStatusToRedis(String reqId, BulkUploadStateDto state) {
        try {
            byte[] json = objectMapper.writeValueAsBytes(state);
            redisTemplate.opsForValue().set("BULK_STATUS_" + reqId, json, 2, TimeUnit.HOURS);
        } catch (JsonProcessingException e) {
            log.error("SERIALIZATION_ERROR | ReqID: {} | Component: BULK_STATUS | Reason: Failed to serialize state DTO", reqId);
        } catch (RedisSystemException | DataAccessException e) {
            log.error("REDIS_STORAGE_FAILURE | ReqID: {} | Component: BULK_STATUS | Status: CRITICAL", reqId);
        }
    }


