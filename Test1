{/* LEFT COLUMN */}
<LeftCol>
  {/* SPLIT LOGIC: We take the title and split it at the dash */}
  <BigHeading variant="h1">
    {(content?.hero?.welcomeTitle || "").split(" - ")[0]}
  </BigHeading>

  {/* Only show this if there is text after the dash */}
  {content?.hero?.welcomeTitle?.includes(" - ") && (
    <SubHeadingText>
      {content?.hero?.welcomeTitle.split(" - ")[1]}
    </SubHeadingText>
  )}

  {/* Main long description text */}
  <SubText>
    {content?.hero?.subText}
  </SubText>

  {/* Legal Warning Section - Using a smaller font for professional hierarchy */}
  <Box sx={{ mt: 4 }}>
    <BigHeading sx={{ fontSize: 20, mb: 1 }}>
      {content?.legal?.title}
    </BigHeading>
    <FeatureList>
      {content?.legal?.items.map((item, idx) => (
        <FeatureItem key={idx}>
          <Bullet /> {item}
        </FeatureItem>
      ))}
    </FeatureList>
  </Box>
</LeftCol>
