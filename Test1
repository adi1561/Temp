package org.example.demo1.Service;


import org.example.demo1.DTO.AuthorRequest;
import org.example.demo1.DTO.AuthorResponse;
import org.example.demo1.ExceptionHandling.AuthorNotFoundException;
import org.example.demo1.ExceptionHandling.InvalidEmailException;
import org.example.demo1.Models.Author;
import org.example.demo1.Repository.AuthorRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class AuthService {

    @Autowired
    private AuthorRepo authorRepo;

    public AuthorResponse createAuther(AuthorRequest authorRequest) {

        boolean InvalidEmail = false;
        if(authorRequest.getEmail().contains("@")) {
            InvalidEmail =true;
        }
        else {
            InvalidEmail = false;
        }

        if(InvalidEmail) {

            throw new InvalidEmailException("Email is not Valid");

        }


        Author author = new Author();
        author.setName(authorRequest.getName());
        author.setEmail(authorRequest.getEmail());
        author.setBooksList(authorRequest.getBook());


        Author savedData = authorRepo.save(author);


        AuthorResponse authorResponse = new AuthorResponse();

        authorResponse.setAuthorId(savedData.getId());
        authorResponse.setName(savedData.getName());
        authorResponse.setTotalBooks(savedData.getBooksList().size());

        return authorResponse;


    }

    public Author findAuthor(Long id) {

        Author author = authorRepo.findById(id).orElseThrow(() -> new AuthorNotFoundException("Author not found"));
        return author;
    }


}


