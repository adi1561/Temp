package com.fincore.JournalService.Controllers;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.fincore.JournalService.Dto.BranchDto;
import com.fincore.JournalService.Service.BranchService;

import java.util.Collections;
import java.util.List;
import java.util.Map;

/**
 * PRODUCTION READY: Branch Controller
 * Exposes endpoints for branch master data retrieval and search.
 * Mappings and logic are preserved exactly as in the original implementation.
 */
@RestController
@RequestMapping("/api/branches-journal")
@RequiredArgsConstructor
@Slf4j
public class BranchController {

    private final BranchService branchService;

    /**
     * Endpoint to retrieve a complete map of branch codes to branch names.
     * [cite_start]Logic preserved: Delegates directly to BranchService. [cite: 46-47]
     */
    @GetMapping("/map")
    public Map<String, String> getBranchMap() {
        log.info("BRANCH_CONTROLLER_MAP_REQUEST | Action: Fetching all active branch mappings");
        return branchService.getBranchCodeAndNameMap();
    }

    /**
     * Endpoint to perform a search for branches based on a query string.
     * [cite_start]Logic preserved: Returns an empty list immediately if the query is blank. [cite: 47-48]
     */
    @GetMapping("/search")
    public List<BranchDto> searchBranches(@RequestParam String query) {
        // Descriptive log for search initiation without logging PII
        log.info("BRANCH_CONTROLLER_SEARCH_INIT | QueryLength: {}", (query != null ? query.length() : 0));

        if (query == null || query.trim().isEmpty()) {
            return Collections.emptyList();
        }
     
        return branchService.searchBranches(query);
    }
}
