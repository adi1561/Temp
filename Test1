spring:
  application:
    name: nwsa-variance
  data:
    redis:
      host: localhost
      port: 6379

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics

hadoop:
  fs:
    # 1. Force Local Mode
    uri: file:///
    user: hadoop-user
    
    # 2. CRITICAL FIX: Force these to be empty to override any hidden defaults
    nameservice: "" 
    ha:
      namenodes: ""

nwsa:
  # 3. Ensure this matches the 'uri' schema above
  report-root: file:///D:/reports
  date-pattern: ddMMyyyy
  bank-filename-pattern: nwsa_report_{date}.psv
  branch-filename-pattern: nwsa_report_{branchCode}_{date}.psv
  failed-threshold-crore: 500
  output-dir: ./output
