package org.apache.hadoop.io.nativeio;

import java.io.File;
import java.io.FileDescriptor;
import java.io.IOException;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.util.NativeCodeLoader;

/**
 * A PATCHED version of NativeIO to fix the "UnsatisfiedLinkError" on Windows 
 * without needing hadoop.dll.
 */
public class NativeIO {
    public static class POSIX {
        public static void chmod(String path, int mode) throws IOException {}
        public static void posix_fadvise(FileDescriptor fd, long offset, long len, int flags) throws NativeIOException {}
    }

    public static class Windows {
        // This is the specific method that was failing. We force it to return true.
        public static boolean access0(String path, int requestedAccess) {
            return true;
        }

        public static void extend(FileDescriptor fd, long off) throws IOException {}
        
        // Mock method to satisfy compilation
        public static String getOwner(FileDescriptor fd) throws IOException { return "User"; }
    }

    // --- Core Logic ---

    private static boolean nativeLoaded = false;
    private static boolean workaroundNonThreadSafePasswdCalls = false;

    static {
        // We pretend the native library loaded successfully
        nativeLoaded = true;
    }

    public static boolean isAvailable() {
        return nativeLoaded;
    }

    /**
     * THIS IS THE CRITICAL FIX.
     * Instead of calling the native method, we just check if the file exists using Java IO.
     */
    public static boolean access(String path, AccessRight desiredAccess) throws IOException {
        // On Windows, just return true (allow access) to bypass the DLL requirement
        if (System.getProperty("os.name").toLowerCase().contains("win")) {
            return true;
        }
        // Fallback for non-Windows (shouldn't be reached if only used locally)
        return new File(path).exists();
    }

    public static void copyFileUnbuffered(File src, File dst) throws IOException {
        // Simple fallback
        java.nio.file.Files.copy(src.toPath(), dst.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
    }

    public static void chmod(String filename, int mode) throws IOException {
        // No-op on Windows
    }

    // Enums needed for the signature
    public enum AccessRight {
        ACCESS_READ, ACCESS_WRITE, ACCESS_EXECUTE;
        public int accessRight() { return 0; }
    }
    
    public static class NativeIOException extends IOException {
        private static final long serialVersionUID = 1L;
        public NativeIOException(String msg) { super(msg); }
    }
}
