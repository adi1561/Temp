package org.example.demo1.Service;

import org.example.demo1.DTO.OrderRequest;
import org.example.demo1.DTO.OrderResponce;
import org.example.demo1.Models.FoodOrder;
import org.example.demo1.Repository.OrderRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class OrderService {

    @Autowired
    private OrderRepo orderRepo;



    public OrderResponce createOrder(OrderRequest orderRequest) {

        FoodOrder foodOrder = new FoodOrder();

        foodOrder.setCustomerName(orderRequest.getCustomerName());
        foodOrder.setDeliveryAddress(orderRequest.getDeliveryAddress());
        double total = 0;

        for(int i=0; i<orderRequest.getItems().size(); i++) {
             total  +=   orderRequest.getItems().getFirst().getPrice();
        }

        foodOrder.setTotalAmount(total);

        FoodOrder savedData = orderRepo.save(foodOrder);

        OrderResponce orderResponce = new OrderResponce();
        orderResponce.setOrderId(savedData.getId());
        orderResponce.setCustomerName(savedData.getCustomerName());
        orderResponce.setTotalAmount(savedData.getTotalAmount());
        orderResponce.setStatus("PREPARING");


        return orderResponce;
    }



}
