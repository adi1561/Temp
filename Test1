    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchProcessing(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        MDC.put("batchId", batchId);
        
        try {
            // 1. Fetch Creator ID
            String creatorId = jdbcTemplate.queryForObject("SELECT CREATOR_ID FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", String.class, batchId);
            
            // 2. SECURITY VALIDATION: Maker-Checker Rule
            [span_0](start_span)[span_1](start_span)[span_2](start_span)// Prevents a user from approving their own batch [cite: 701-703]
            if (executorId.equalsIgnoreCase(creatorId) && RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                log.error("SECURITY_VIOLATION | User: {} attempted to self-approve batch: {}", executorId, batchId);
                throw new IllegalStateException("Security Rule Violated: Maker cannot be the Checker.");
            }

            progressService.sendProgress(batchId, executorId, 20, "PROCESSING", "Executing Approval Logic...");

            if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                [cite_start]// Logic for Oracle Procedure remains preserved [cite: 705-712]
                jdbcTemplate.execute("{call PROCESS_JOURNAL_BATCH(?, ?, ?, ?, ?)}", (CallableStatementCallback<Void>) cs -> {
                    cs.setString(1, batchId);
                    cs.setString(2, executorId);
                    cs.setString(3, dto.getRemarks());
                    cs.setString(4, "A");
                    cs.registerOutParameter(5, -10); 
                    cs.execute();
                    return null;
                });

                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ACCEPTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);

                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Approved Successfully");
                sendNotification(executorId, null, "You approved Batch " + batchId, batchId);
                sendNotification(creatorId, null, "Your Batch " + batchId + " has been ACCEPTED.", batchId);

            } else if (RequestStatus.REJECTED.equals(dto.getStatus())) {
                [cite_start]// Reject logic preserved [cite: 722-723]
                jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ?, EXECUTION_DATE = SYSDATE WHERE BATCH_ID = ? AND REQ_STATUS = 'P'",
                        executorId, dto.getRemarks(), batchId);
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);
                
                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Rejected");
                sendNotification(creatorId, null, "Your Batch " + batchId + " was REJECTED.", batchId);
            }

        } catch (DataAccessException | RuntimeException e) {
            log.error("BATCH_PROCESS_FAIL | Batch: {} | Error: {}", batchId, e.getMessage());
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", "System error during processing", batchId);
            progressService.sendProgress(batchId, executorId, 0, "FAILED", "System Error");
        } finally {
            MDC.clear();
        }
    }

    /**
     * SECURITY REFACTOR: JSON Safety
     * [cite_start]Uses Map and ObjectMapper to prevent JSON Injection [cite: 757-759]
     */
    private String buildJsonPayloadFast(JournalBulkValidationService.ExcelRowData row, BigDecimal amount, LocalDate pDate, String bId, String jId, String rem, int cnt, DateTimeFormatter fmt) {
        try {
            Map<String, Object> payload = new LinkedHashMap<>();
            payload.put("csvDate", pDate.format(fmt));
            payload.put("branch", row.branch);
            payload.put("currency", row.currency);
            payload.put("cgl", row.cgl);
            payload.put("amount", amount);
            payload.put("productType", row.productCode != null ? row.productCode : "A");
            payload.put("remarks", row.remarks != null ? row.remarks : "");
            payload.put("arFlag", "A");
            payload.put("acClassification", "A");
            payload.put("batchId", bId);
            payload.put("journalId", jId);
            payload.put("commonBatchRemarks", rem != null ? rem : "");
            payload.put("transactionCount", cnt);

            return objectMapper.writeValueAsString(payload);
        } catch (JsonProcessingException e) {
            log.error("JSON_SERIALIZATION_FAIL | Batch: {} | Journal: {}", bId, jId);
            return "{}";
        }
    }

