package com.fincore.JournalService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.serializer.StringRedisSerializer;

/**
 * PRODUCTION READY: Redis Configuration
 * Configures templates to handle compressed binary data (GZIP).
 * This strategy prevents Out-Of-Memory (OOM) errors by offloading large 
 * validation datasets to Redis rather than keeping them in the application heap.
 */
@Configuration
@Slf4j
public class RedisConfig {

    /**
     * Configures a RedisTemplate specifically for byte array values.
     * Uses String serialization for keys to ensure they are readable in the Redis CLI,
     * while keeping values as raw bytes to avoid the overhead of standard Java serialization.
     */
    @Bean(name = "byteArrayRedisTemplate")
    public RedisTemplate<String, byte[]> byteArrayRedisTemplate(RedisConnectionFactory connectionFactory) {
        log.info("REDIS_CONFIG_INIT | Initializing ByteArrayRedisTemplate for binary data storage");

        RedisTemplate<String, byte[]> template = new RedisTemplate<>();
        template.setConnectionFactory(connectionFactory);

        // Keys are Strings (e.g., "DATA_UUID") for easy debugging and TTL management
        template.setKeySerializer(new StringRedisSerializer());

        // Values are kept as raw Byte Arrays (GZIP Compressed) to maximize performance
        template.setEnableDefaultSerializer(false);

        log.info("REDIS_CONFIG_SUCCESS | ByteArrayRedisTemplate configured with StringKeySerializer and disabled value serialization");
        
        return template;
    }
}
