}

package org.example.demo1.Service;


import org.example.demo1.DTO.EmpRequest;
import org.example.demo1.Models.ContractEmployee;
import org.example.demo1.Models.Employee;
import org.example.demo1.Models.FullTimeEmployee;
import org.example.demo1.Repository.EmpRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class EmpoService {

    @Autowired
    private EmpRepo empRepo;

    public Employee createNotification(EmpRequest empRequest) {

           if(empRequest.getType().equals("FullTimeEmployee")) {


               FullTimeEmployee fullTimeEmployee = new FullTimeEmployee();
               fullTimeEmployee.setAnnualSalary(empRequest.getAnnualSalary());
               fullTimeEmployee.setMonthlyBonus(empRequest.getMonthlyBonus());
           }
           else if(empRequest.getType().equals("ContractEmployee")) {
               ContractEmployee contractEmployee = new ContractEmployee();
               contractEmployee.setContractDurationMonths(empRequest.getContractDurationMonths());
               contractEmployee.setDepartment(empRequest.getDepartment());
           }

        Employee savedData = new Employee();

        savedData.setFullName(empRequest.getFullName());
        savedData.setDepartment(empRequest.getDepartment());

       return  empRepo.save(savedData);
        
        
    }



}

