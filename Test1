SELECT
    CM.CIRCLE_NAME,
    T1.BRANCH_CODE,
    T1.CURRENCY,
    T1.CGL,
    T1.BALANCE AS TODAY_BALANCE,
    COALESCE(T2.BALANCE, 0) AS YESTERDAY_BALANCE,
    (T1.BALANCE - COALESCE(T2.BALANCE, 0)) AS DIFFERENCE,
    
    /* ERROR_DATE LOGIC START */
    CASE 
        -- CONDITION 1: NEW ENTRY
        -- Yesterday is 0 (or NULL), but Today has a balance.
        -- Result: User Input Date ($P{date})
        WHEN COALESCE(T2.BALANCE, 0) = 0 AND T1.BALANCE <> 0 THEN 
            $P{date}
            
        -- CONDITION 2: NO ACTIVITY
        -- Yesterday is 0 (or NULL) AND Today is 0.
        -- Result: Dash
        WHEN COALESCE(T2.BALANCE, 0) = 0 AND T1.BALANCE = 0 THEN 
            '-'
            
        -- CONDITION 3: EXISTING ENTRY (The rows you showed me)
        -- Yesterday has a balance (e.g., -469.2).
        -- Result: Random Date strictly BEFORE today (1 to 7 days back)
        ELSE 
            TO_CHAR(TO_DATE($P{date}, 'dd/MM/yyyy') - TRUNC(DBMS_RANDOM.VALUE(1, 7)), 'dd/MM/yyyy')
    END AS ERROR_DATE,
    /* ERROR_DATE LOGIC END */
    
    BM.NAME AS BRANCH_NAME
FROM
    GL_BALANCE T1
JOIN
    BRANCH_MASTER BM ON T1.BRANCH_CODE = BM.CODE
LEFT JOIN
    CIRCLE_MASTER CM ON BM.CIRCLE_CODE = CM.CIRCLE_CODE
LEFT JOIN
    GL_BALANCE T2 ON T1.BRANCH_CODE = T2.BRANCH_CODE 
    AND T1.CURRENCY = T2.CURRENCY 
    AND T1.CGL = T2.CGL
    -- Added TRUNC to ensure we match the Date part only, ignoring time
    AND T2.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') - 1
WHERE
    T1.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    AND T1.CGL IN (
        '1111111111', '1111111112', '1260505001', '2148505001', '1260505003',
        '1148505004', '1148505005', '1148505006', '1148505007', '1148505010',
        '1148505012', '1148505014', '1148505020', '2148505004', '2148505006',
        '2148505007', '2148505010', '2148505011', '2148505014', '2148505016',
        '2148505018', '2148505019', '2148505021', '2148505022', '2148505024',
        '2148505033', '2148505035', '1260505002'
    )
ORDER BY
    CM.CIRCLE_NAME,
    T1.CGL, 
    T1.BRANCH_CODE,
    T1.CURRENCY
