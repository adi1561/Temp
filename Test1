package com.fincore.ReportService.config;

import java.io.IOException;
import java.net.URI;
import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.FileSystem;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;

@org.springframework.context.annotation.Configuration
public class HdfsConfig {

    @Bean
    public FileSystem fileSystem(@Value("${nwsa.hdfs-uri:}") String hdfsUri) throws IOException {
        Configuration conf = new Configuration();
        // If URI is empty, it loads defaults (core-site.xml) or local fs
        if (hdfsUri == null || hdfsUri.isBlank()) {
            return FileSystem.get(conf);
        }
        return FileSystem.get(URI.create(hdfsUri), conf);
    }
}
