package com.fincore.JournalService.Controller;

import com.fincore.JournalService.Dto.BulkUploadStateDto;
import com.fincore.JournalService.Service.JournalBulkValidationService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.ByteArrayResource;
import org.springframework.core.io.Resource;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.IOException;
import java.time.LocalDate;

/**
 * PRODUCTION READY: Journal Bulk Validation Controller
 * Exposes endpoints for managing large-scale journal file uploads and processing status.
 * Adheres to secure logging standards (no PII) and specific exception handling.
 */
@RestController
@RequestMapping("/api/v1/journal-validation")
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationController {

    private final JournalBulkValidationService bulkValidationService;

    /**
     * Endpoint to upload a Journal file (CSV/Excel) for multi-stage validation.
     * Starts an asynchronous background process and returns a unique Request ID.
     */
    @PostMapping("/upload")
    public ResponseEntity<String> uploadFile(
            @RequestParam("file") MultipartFile file,
            @RequestParam("postingDate") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate postingDate) {

        // Log receipt of request using metadata rather than file content
        log.info("UPLOAD_REQUEST_RECEIVED | FileName: {} | FileSize: {} bytes | PostingDate: {}", 
                 file.getOriginalFilename(), file.getSize(), postingDate);

        try {
            String requestId = bulkValidationService.initiateValidation(
                    file.getInputStream(), 
                    file.getOriginalFilename(), 
                    postingDate
            );
            return ResponseEntity.ok(requestId);

        } catch (IOException e) {
            // Specific exception for stream/IO failures
            log.error("UPLOAD_STREAM_FAILURE | FileName: {} | Reason: {}", file.getOriginalFilename(), e.getMessage());
            return ResponseEntity.internalServerError().body("Failed to read uploaded file stream.");
        }
    }

    /**
     * Polls the current processing state of a validation request.
     * Returns a DTO containing the current stage, progress percentage, and status.
     */
    @GetMapping("/status/{requestId}")
    public ResponseEntity<BulkUploadStateDto> getStatus(@PathVariable String requestId) {
        BulkUploadStateDto state = bulkValidationService.getState(requestId);
        if (state == null) {
            log.warn("STATUS_NOT_FOUND | ReqID: {}", requestId);
            return ResponseEntity.notFound().build();
        }
        return ResponseEntity.ok(state);
    }

    /**
     * Downloads the generated Excel error report if validation failed.
     */
    @GetMapping("/report/error/{requestId}")
    public ResponseEntity<Resource> getErrorReport(@PathVariable String requestId) {
        byte[] data = bulkValidationService.getFileBytes(requestId, "ERROR");
        if (data == null) {
            log.warn("ERROR_REPORT_NOT_FOUND | ReqID: {}", requestId);
            return ResponseEntity.notFound().build();
        }

        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"error_report_" + requestId + ".xlsx\"")
                .contentType(MediaType.APPLICATION_OCTET_STREAM)
                .body(new ByteArrayResource(data));
    }

    /**
     * Downloads the generated CSV success file for system integration.
     */
    @GetMapping("/report/success/{requestId}")
    public ResponseEntity<Resource> getSuccessFile(@PathVariable String requestId) {
        byte[] data = bulkValidationService.getFileBytes(requestId, "SUCCESS");
        if (data == null) {
            log.warn("SUCCESS_FILE_NOT_FOUND | ReqID: {}", requestId);
            return ResponseEntity.notFound().build();
        }

        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"processed_data_" + requestId + ".csv\"")
                .contentType(MediaType.TEXT_PLAIN)
                .body(new ByteArrayResource(data));
    }

    /**
     * Provides an Excel template for the correct Journal upload format.
     */
    @GetMapping("/template")
    public ResponseEntity<Resource> getTemplate() {
        try {
            byte[] data = bulkValidationService.generateTemplateBytes();
            return ResponseEntity.ok()
                    .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"journal_upload_template.xlsx\"")
                    .contentType(MediaType.APPLICATION_OCTET_STREAM)
                    .body(new ByteArrayResource(data));
        } catch (IOException e) {
            log.error("TEMPLATE_GENERATION_FAIL | Reason: {}", e.getMessage());
            return ResponseEntity.internalServerError().build();
        }
    }
}
