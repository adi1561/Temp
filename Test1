package com.fincore.repository;

import com.fincore.dto.DifferenceDTO;
import com.fincore.entity.Difference;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

@Repository
public interface DifferenceRepository extends JpaRepository<Difference, Long> {

    // QUERY UPDATED: Uses 'Difference' entity and 'DifferenceDTO'
    @Query("""
        SELECT new com.fincore.dto.DifferenceDTO(
            d.reconRunDate,
            d.branchCode,
            d.currency,
            d.cgl,
            d.cbsBalance,
            d.glBalance,
            d.differenceAmount,
            d.diffBwYesterday,
            d.type,
            d.head
        )
        FROM Difference d
    """)
    Page<DifferenceDTO> findAllAsDto(Pageable pageable);
}

5. The Service: DifferenceService.java
