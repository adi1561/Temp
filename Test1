package com.fincore.JournalService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.annotation.EnableCaching;
import org.springframework.cache.concurrent.ConcurrentMapCacheManager;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * PRODUCTION READY: Cache Configuration
 * Enables Spring's annotation-driven cache management (@Cacheable).
 * Specifically configures the manager for permission and notification routing metadata 
 * to minimize database overhead during high-volume batch processing.
 */
@Configuration
@EnableCaching
@Slf4j
public class CacheConfig {

    /**
     * Initializes the ConcurrentMapCacheManager.
     * Logic preserved: Specifically creates the 'notification_configs' cache bucket 
     * used by the PermissionConfigService.
     */
    @Bean
    public ConcurrentMapCacheManager cacheManager() {
        log.info("CACHE_CONFIG_INIT | Initializing ConcurrentMapCacheManager for 'notification_configs'");
        
        ConcurrentMapCacheManager cacheManager = new ConcurrentMapCacheManager("notification_configs");
        
        log.info("CACHE_CONFIG_SUCCESS | Cache bucket 'notification_configs' is now active and ready for lookups");
        return cacheManager;
    }
}
