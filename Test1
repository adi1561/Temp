package org.example.demo1.Service;


import org.example.demo1.DTO.PatientRequest;
import org.example.demo1.DTO.PatientResponce;
import org.example.demo1.Models.Patient;
import org.example.demo1.Repository.PatientRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class PatientService {


    @Autowired
    private PatientRepo patientRepo;

    public PatientResponce createPatient(PatientRequest patientRequest) {

        Patient patient = new Patient();

        patient.setName(patientRequest.getName());
        patient.setDisease(patientRequest.getDisease());
        patient.setRoomNumber(patientRequest.getRoomNumber());
        patient.setPrivateNotes(patientRequest.getPrivateNotes());

        Patient savedData = patientRepo.save(patient);

        PatientResponce patientResponce = new PatientResponce();

        patientResponce.setName(savedData.getName());
        patientResponce.setRoomNumber(savedData.getRoomNumber());
        patientResponce.setStatus(savedData.getStatus());

        return patientResponce;


    }



}


