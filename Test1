UPDATE ASCII_CONFIG 
SET 
    -- 1. Allow A, N, S, or Digits (Fixing the "too strict" 5-digit rule)
    INPUT_HEAD_REGEX = '^[ANS0-9].*',

    -- 2. Decimal Logic: 
    -- First apply [2] to everything (Standard for A).
    -- Then, IF starts with S or N, force [0] (Override).
    OUTPUT_AMT_DECIMAL = '["^.*"][5][2]|["^.*"][1][2]|["^[SN].*"][5][0]|["^[SN].*"][1][0]',

    -- 3. Padding Logic:
    -- First apply [19,2] to everything (Standard for A).
    -- Then, IF starts with S or N, force [19,0] (Override).
    OUTPUT_AMT_COL_PAD = '["^.*"][5][19,2]|["^.*"][1][19,2]|["^[SN].*"][5][19,0]|["^[SN].*"][1][19,0]'

WHERE ID = 103;

COMMIT;
