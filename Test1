@Service
public class ProductService {

    @Autowired
    private ProductRepo productRepo;

    public Product findProduct(OrderRequest orderRequest) {

        // 1. Validate Negative Quantity
        if(orderRequest.getQuantity() <= 0) {
            throw new InvalidQuantityException("Please Enter the Valid Quantity");
        }

        // 2. Find Product (SAFE WAY)
        // If ID is wrong, this throws the exception and STOPS the code right here.
        Product product = productRepo.findById(orderRequest.getProductId())
                .orElseThrow(() -> new ProductNotFoundException("Product is not found !!"));

        // 3. Check Stock
        if(product.getStock() < orderRequest.getQuantity()) {
            // Throw OutOfStock, not InvalidQuantity
            throw new OutOfStockException("We only have " + product.getStock() + " items left.");
        }

        // 4. Update the EXISTING Product (Don't create a new one!)
        int newStock = product.getStock() - orderRequest.getQuantity();
        product.setStock(newStock);

        // 5. Save and Return
        return productRepo.save(product);
    }
}
