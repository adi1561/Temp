SELECT
	GL_BALANCE.BRANCH_CODE,
	GL_BALANCE.CURRENCY,
	GL_BALANCE.CGL,
	GL_BALANCE.BALANCE,
	BRANCH_MASTER.NAME AS BRANCH_NAME
FROM
	GL_BALANCE
JOIN
	BRANCH_MASTER ON GL_BALANCE.BRANCH_CODE = BRANCH_MASTER.CODE
WHERE
	GL_BALANCE.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') and GL_BALANCE.CGL IN ( '1106505001' ,  '1106505002')
	and balance != 0.0
ORDER BY
	 CGL, CURRENCY, GL_BALANCE.BRANCH_CODE
