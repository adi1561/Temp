package org.example.demo1.Service;

import org.example.demo1.Models.UserModel;
import org.example.demo1.Repository.UserRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import java.util.Optional;

@Service
public class UserServiceImp implements  IUserService{

    @Autowired
    private UserRepo userRepo;

    @Override
    public ResponseEntity<?> CreateUser(UserModel userModel) {


        Optional<UserModel> result = userRepo.findByName(userModel.getName());
        if(result.isPresent()) {
            return new ResponseEntity<UserModel>(  result.get(), HttpStatus.BAD_REQUEST);
        }
        else  if(userModel.getAge() < 18 ){
            return new ResponseEntity<String>("Age is Restricted" ,  HttpStatus.BAD_REQUEST);
        }
        else {
            userRepo.save(userModel);
            return new ResponseEntity<UserModel>(HttpStatus.CREATED);
        }


    }
}


package org.example.demo1.Service;

import org.example.demo1.Models.UserModel;
import org.springframework.http.ResponseEntity;
