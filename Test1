package com.fincore.JournalService.Controllers;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.fincore.JournalService.Dto.BranchDto;
import com.fincore.JournalService.Service.BranchService;

import java.util.Collections;
import java.util.List;
import java.util.Map;

/**
 * Exposes endpoints for branch master data retrieval and search.
 * Rule 3: Mappings and logic are preserved exactly as in the original implementation.
 * Updated: Standardized to use ResponseEntity for production consistency.
 */
@RestController
@RequestMapping("/api/branches-journal")
@RequiredArgsConstructor
@Slf4j
public class BranchController {

    private final BranchService branchService;

    /**
     * Endpoint to retrieve a complete map of branch codes to branch names.
     * Logic preserved: Delegates directly to BranchService via ResponseEntity.
     */
    @GetMapping("/map")
    public ResponseEntity<Map<String, String>> getBranchMap() {
        log.info("BRANCH_CONTROLLER_MAP_REQUEST | Action: Fetching all active branch mappings");
        Map<String, String> branchMap = branchService.getBranchCodeAndNameMap();
        return ResponseEntity.ok(branchMap);
    }

    /**
     * Endpoint to perform a search for branches based on a query string.
     * Logic preserved: Returns an empty list immediately if the query is blank.
     */
    @GetMapping("/search")
    public ResponseEntity<List<BranchDto>> searchBranches(@RequestParam String query) {
        log.info("BRANCH_CONTROLLER_SEARCH_INIT | QueryLength: {}", (query != null ? query.length() : 0));

        if (query == null || query.trim().isEmpty()) {
            // Rule 3: Preserving the existing "empty list" logic for blank queries
            return ResponseEntity.ok(Collections.emptyList());
        }

        List<BranchDto> results = branchService.searchBranches(query);
        return ResponseEntity.ok(results);
    }
}


package com.fincore.JournalService.Controllers;

import com.fincore.JournalService.Dto.CglDto;
import com.fincore.JournalService.Service.CglService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.Collections;
import java.util.List;

/**
 * Exposes endpoints for searching Common General Ledger (CGL) master data.
 * Mappings and logic are preserved exactly as in the original implementation.
 */
@RestController
@RequestMapping("/api/cgl-journal")
@RequiredArgsConstructor
@Slf4j
public class CglController {

    private final CglService cglService;

    /**
     * Endpoint to search for CGLs by number or description.
     * Logic preserved: Returns a list of CGLs matching the query.
     */


    @GetMapping("/search")
    public ResponseEntity<List<CglDto>> searchCgl(@RequestParam(value = "query", required = false, defaultValue = "") String query) {
        if (query == null || query.trim().isEmpty()) {
            return ResponseEntity.ok(Collections.emptyList());
        }

        log.info("CGL_CONTROLLER_SEARCH_INIT | Query: {}", query);
        List<CglDto> results = cglService.searchCgls(query);
        return ResponseEntity.ok(results);
    }

}


