/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted =
    !stage.stageStatus || stage.stageStatus === StageStatus.NOT_STARTED;
  const started = stage.stageStatus === StageStatus.STARTED;
  const error = stage.stageStatus === StageStatus.ERROR;
  const completed = stage.stageStatus === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
      ? "Started"
      : error
        ? "Failed"
        : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stageIcon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">
          {stage.stageTitle || "Unknown"}
        </Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button size="small" o variant="contained" onClick={onClick}>
            <VisibilityOutlinedIcon fontSize="small" sx={{ mr: 1 }} />
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  const stepperRef = useRef(null);

  useEffect(() => {
    // Small delay ensures the Dialog transition is finished and DOM is ready
    const timer = setTimeout(() => {
      const activeElement = stepperRef.current?.querySelector(
        `[data-step="${activeStep}"]`,
      );
      if (activeElement) {
        activeElement.scrollIntoView({
          behavior: "smooth",
          block: "center", // Focuses the item in the middle of the scrollable area
        });
      }
    }, 200);

    return () => clearTimeout(timer);
  }, [activeStep]);
  return (
    <Box ref={stepperRef}>
      <Stepper orientation="vertical" nonLinear>
        {stageDetails.map((stage, index) => {
          const active = index === activeStep;

          return (
            <Step
              key={index}
              active
              data-step={index}
              sx={(theme) =>
                active
                  ? {
                      backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                      position: "relative",
                      "&::after": {
                        content: '""',
                        position: "absolute",
                        right: -8,
                        top: 0,
                        width: 8,
                        height: "100%",
                        backgroundColor: theme.palette.divider,
                      },
                    }
                  : {}
              }
            >
              <Box
                sx={(theme) =>
                  active
                    ? {
                        backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                        position: "relative",
                        "&::after": {
                          content: '""',
                          position: "absolute",
                          right: -8,
                          top: 0,
                          width: 8,
                          height: "100%",
                          backgroundColor: theme.palette.divider,
                        },
                      }
                    : {}
                }
              >
                <ProcessStepContent
                  stage={stage}
                  active={active}
                  onClick={() => onStageClick(index)}
                />
              </Box>
            </Step>
          );
        })}
      </Stepper>
    </Box>
  );
};

