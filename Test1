@PostMapping("/create-batch")
public ResponseEntity<?> createBatch(@Valid @RequestBody JournalBatchRequestDto request) {
    // If Spring reaches this line, you are 100% guaranteed the payload 
    // exactly matches your strict frontend rules.
    
