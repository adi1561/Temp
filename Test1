package com.fincore.JournalService.Service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.JournalService.Models.Notifications;
import com.fincore.JournalService.Repository.NotificationRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataAccessException;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

/**
 * Service for persisting system alerts and user notifications.
 * Uses REQUIRES_NEW to ensure notifications commit independently of batch transactions,
 * which is required for successful delivery during asynchronous processing.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class NotificationWriterService {

    private final NotificationRepository notificationRepository;
    
    // NEW: Inject Redis and Jackson for live broadcasting
    private final StringRedisTemplate stringRedisTemplate;
    private final ObjectMapper objectMapper;

    // NEW: Define the live notification topic
    @Value("${notification.alert.topic:notifications:alerts}")
    private String alertTopic;

    /**
     * Persists a notification event and broadcasts it to Redis for real-time UI updates.
     * Propagation set to REQUIRES_NEW to support @Async callers and ensure
     * visibility regardless of the parent transaction status.
     * * @param userId Targeted user ID (null for broadcast)
     * @param targetRole Targeted role (null for direct user)
     * @param message The alert content
     * @param linkUrl Redirect URL for the frontend
     * @param aggregateId Reference ID (e.g., Batch ID)
     * @param eventSource Service identifier
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void createNotification(String userId, String targetRole, String message, String linkUrl, String aggregateId, String eventSource) {

        // Validation: Ensure we have at least one recipient type
        if (userId == null && targetRole == null) {
            log.warn("NOTIFICATION_SKIPPED | Reason: Recipient missing | AggregateID: {}", aggregateId);
            return;
        }

        // Validation: Ensure message is not blank
        if (message == null || message.isBlank()) {
            log.error("NOTIFICATION_VALIDATION_FAIL | Status: BLANK_MESSAGE | AggregateID: {}", aggregateId);
            throw new IllegalArgumentException("Notification message content is required.");
        }

        try {
            Notifications notification = Notifications.builder()
                    .userId(userId)
                    .targetRole(targetRole)
                    .message(message)
                    .linkUrl(linkUrl)
                    .aggregateId(aggregateId)
                    .eventSource(eventSource)
                    .build();

            // 1. Save to Database
            Notifications savedNotification = notificationRepository.save(notification);

            // 2. NEW: Broadcast to Redis so the Frontend receives it in real-time
            try {
                String jsonPayload = objectMapper.writeValueAsString(savedNotification);
                stringRedisTemplate.convertAndSend(alertTopic, jsonPayload);
            } catch (JsonProcessingException e) {
                log.error("NOTIFICATION_BROADCAST_FAIL | AggregateID: {} | Reason: JSON Serialization failed", aggregateId);
            }

            // Logging metadata only to satisfy PII requirements
            if (userId != null) {
                log.info("NOTIFICATION_SAVED_AND_BROADCAST | Type: DIRECT | UserID: {} | Ref: {}", userId, aggregateId);
            } else {
                log.info("NOTIFICATION_SAVED_AND_BROADCAST | Type: BROADCAST | Role: {} | Ref: {}", targetRole, aggregateId);
            }

        } catch (DataAccessException e) {
            // Catching specific Spring DAO exception for DB issues
            log.error("NOTIFICATION_DB_FAIL | AggregateID: {} | Reason: Database persistence failure", aggregateId);
            throw e;
        }
    }
}
