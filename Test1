package com.tcs.fincore.CommonRequestService.service.kafka;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.CommonRequestService.repository.CommonRequestRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Optional;

@Slf4j
@Service
@RequiredArgsConstructor
public class LhoKafkaConsumerService {

    private final CommonRequestRepository commonRequestRepository;
    private final ObjectMapper objectMapper;

    /**
     * TOPIC 1: trigger-events-responce-one
     * Logic: If Fail -> PENDING. If Success -> Do Nothing (just log).
     */
    @KafkaListener(
            topics = "trigger-events-responce-one",
            groupId = "${spring.kafka.consumer.group-id:fincore-group}"
    )
    @Transactional
    public void consumeResponseOne(String message) {
        log.info("Received event on Topic 1 (trigger-events-responce-one): {}", message);
        
        try {
            JsonNode payload = objectMapper.readTree(message);
            Long requestId = extractRequestId(payload);
            boolean isSuccess = evaluateSuccess(payload);

            if (requestId == null) return;

            if (isSuccess) {
                log.info("Topic 1 Success received for Request ID: {}. Doing nothing. Record remains in QUEUE.", requestId);
                // DO NOTHING per requirements
            } else {
                log.warn("Topic 1 Failure received for Request ID: {}. Reverting to PENDING.", requestId);
                updateRequestStatus(requestId, RequestStatus.PENDING, "Topic 1 reported failure. Reverted to PENDING.");
            }

        } catch (Exception e) {
            log.error("Error processing Topic 1 message: {}", message, e);
        }
    }

    /**
     * TOPIC 2: trigger-events-responce-two
     * Logic: If Success -> ACCEPTED. If Fail -> PENDING.
     */
    @KafkaListener(
            topics = "trigger-events-responce-two",
            groupId = "${spring.kafka.consumer.group-id:fincore-group}"
    )
    @Transactional
    public void consumeResponseTwo(String message) {
        log.info("Received event on Topic 2 (trigger-events-responce-two): {}", message);

        try {
            JsonNode payload = objectMapper.readTree(message);
            Long requestId = extractRequestId(payload);
            boolean isSuccess = evaluateSuccess(payload);

            if (requestId == null) return;

            if (isSuccess) {
                log.info("Topic 2 Success received for Request ID: {}. Marking as ACCEPTED.", requestId);
                updateRequestStatus(requestId, RequestStatus.ACCEPTED, "Topic 2 reported success. Fully ACCEPTED.");
            } else {
                log.warn("Topic 2 Failure received for Request ID: {}. Reverting to PENDING.", requestId);
                updateRequestStatus(requestId, RequestStatus.PENDING, "Topic 2 reported failure. Reverted to PENDING.");
            }

        } catch (Exception e) {
            log.error("Error processing Topic 2 message: {}", message, e);
        }
    }

    // --- HELPER METHODS ---

    private Long extractRequestId(JsonNode payload) {
        if (payload.has("requestId") && !payload.get("requestId").isNull()) {
            return payload.get("requestId").asLong();
        }
        log.error("Kafka event ignored: Missing 'requestId' in payload.");
        return null;
    }

    /**
     * Helper to determine if the event indicates success.
     * Looks for boolean "success", "isSuccess", or string "status" == "success".
     */
    private boolean evaluateSuccess(JsonNode payload) {
        if (payload.has("success")) return payload.get("success").asBoolean();
        if (payload.has("isSuccess")) return payload.get("isSuccess").asBoolean();
        
        if (payload.has("status")) {
            String statusStr = payload.get("status").asText().toLowerCase();
            return statusStr.contains("success") || statusStr.equals("true");
        }
        return false; // Default to false if we can't determine
    }

    private void updateRequestStatus(Long requestId, RequestStatus newStatus, String remarks) {
        Optional<CommonReq> requestOpt = commonRequestRepository.findById(requestId);
        
        if (requestOpt.isPresent()) {
            CommonReq request = requestOpt.get();
            request.setReqStatus(newStatus);
            request.setExecutionRemarks(remarks);
            commonRequestRepository.save(request);
            log.info("Database updated: Request ID {} is now {}", requestId, newStatus);
        } else {
            log.error("Database update failed: Could not find Request ID {} in COMMON_REQ table.", requestId);
        }
    }
}

