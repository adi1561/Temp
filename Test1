package org.example.demo1.Repository;

import org.example.demo1.Models.Product;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

@Repository
public interface ProductRepo extends JpaRepository<Product, Long> {
    int findByStock(int stock);
}
package org.example.demo1.Service;


import org.example.demo1.DTO.OrderRequest;
import org.example.demo1.ExceptionHandling.InvalidQuantityException;
import org.example.demo1.ExceptionHandling.ProductNotFoundException;
import org.example.demo1.Models.Product;
import org.example.demo1.Repository.ProductRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.Optional;

@Service
public class ProductService {


    @Autowired
    private ProductRepo productRepo;


    public Product FindProduct(OrderRequest orderRequest) {

        if(orderRequest.getQuantity() < 0) {
            throw new InvalidQuantityException("Please Enter the Valid Quantity");
        }





      Optional<Product> finding = productRepo.findById(orderRequest.getProductId());

        if(finding.get().getStock() < orderRequest.getQuantity()) {
            throw new InvalidQuantityException("Please Enter valid Quntity");
        }

        if(finding.isPresent()) {
            System.out.println("Product Found");
        }
        else {
            throw new ProductNotFoundException("Product is not found !!");

        }

        Product product = new Product();
        product.setId(orderRequest.getProductId());
        product.setStock(orderRequest.getQuantity());
        Product saved  = productRepo.save(product);

        return saved;




    }






}



