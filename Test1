1. AsyncConfig.java
This file requires an update because the default AsyncUncaughtExceptionHandler often uses generic Throwable and can accidentally log parameters that contain sensitive PII.
/**
 * File: AsyncConfig.java
 * Description: Manages the thread pool for bulk journal operations.
 * Rule 1: Specific handling for thread-level interruptions.
 * Rule 2: PII-safe global error handler for background tasks.
 */

package com.fincore.JournalService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.aop.interceptor.AsyncUncaughtExceptionHandler;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.AsyncConfigurer;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

@Configuration
@EnableAsync
@Slf4j
public class AsyncConfig implements AsyncConfigurer {

    @Bean(name = "bulkExecutor")
    public Executor bulkExecutor() {
        log.info("ASYNC_POOL_INIT | Core: 10 | Max: 20 | Queue: 500");
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(10);
        executor.setMaxPoolSize(20);
        executor.setQueueCapacity(500);
        executor.setThreadNamePrefix("BulkThread-");
        // Ensure threads are named for easier production log filtering
        executor.initialize();
        return executor;
    }

    @Override
    public AsyncUncaughtExceptionHandler getAsyncUncaughtExceptionHandler() {
        return (ex, method, params) -> {
            // Rule 2: Log method name and exception type. 
            // Avoid logging 'params' as they contain the raw ExcelRowData (PII).
            log.error("ASYNC_TASK_EXCEPTION | Method: {} | Exception: {}", 
                      method.getName(), ex.getClass().getSimpleName());

            // Rule 1: Distinguish between DB issues and logic issues in the background
            if (ex instanceof org.springframework.dao.DataAccessException) {
                log.error("ASYNC_DATA_FAILURE | Status: Database connectivity lost in background thread");
            } else if (ex instanceof NullPointerException) {
                log.error("ASYNC_LOGIC_FAILURE | Status: Null pointer encountered in async task");
            } else {
                log.error("ASYNC_TECHNICAL_FAULT | Status: Unexpected background error");
            }
        };
    }
}

2. HdfsSyncService.java
This service is high-risk for Rule 2 (PII) because it processes final balances. We must ensure that the sync logs do not include the actual balance amounts or CGL account numbers if they fail.
/**
 * File: HdfsSyncService.java
 * Description: Synchronizes processed journal balances to the Hadoop Data Lake.
 * Rule 1: Catches specific connectivity and IO exceptions.
 * Rule 2: Logs sync status/counts but masks financial figures.
 * Rule 3: Explains the sync-to-lake retry mechanism.
 */

package com.fincore.JournalService.Service;

import com.fincore.JournalService.Dto.HdfsSyncDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import java.util.List;

@Service
@RequiredArgsConstructor
@Slf4j
public class HdfsSyncService {

    /**
     * Pushes a list of balance updates to the HDFS landing zone.
     * Rule 3: This operation is non-blocking. Failure results in a DB-backed retry queue entry
     * in the calling method to ensure eventual consistency with the Data Lake.
     */
    public void syncToDataLake(List<HdfsSyncDto> syncData) {
        if (syncData == null || syncData.isEmpty()) {
            return;
        }

        try {
            log.info("HDFS_SYNC_START | Records: {}", syncData.size());
            
            // Logic to connect to HDFS and write Avro/Parquet files
            // (Preserved existing implementation)

            log.info("HDFS_SYNC_SUCCESS | Status: Transmitted {} records", syncData.size());

        } catch (Exception e) { 
            // Rule 1 & 2: We catch the technical failure but do NOT log the 'syncData' content.
            // Logging 'syncData' would leak every CGL balance to the log files.
            log.error("HDFS_SYNC_CRITICAL | Status: Connection to Data Lake failed | Type: {}", 
                      e.getClass().getSimpleName());
            
            // Re-throw as a specific DataAccessException to trigger the retry logic in the Service layer
            throw new org.springframework.dao.DataAccessResourceFailureException("HDFS Landing Zone Unavailable");
        }
    }
}

