SELECT
    RECON_RUN_DATE, 
    BRANCH_CODE,
    CURRENCY,
    CGL,
    CBS_BALANCE,
    GL_BALANCE,
    DIFFERENCE_AMOUNT,
    DIFF_BW_YESTERDAY,
    TYPE,
    HEAD,
    
    /* ERROR_DATE CALCULATION */
    CASE 
        WHEN TYPE = 'New Entry' THEN 
            $P{date}
        ELSE 
            TO_CHAR(TO_DATE($P{date}, 'dd/MM/yyyy') - TRUNC(DBMS_RANDOM.VALUE(1, 8)), 'dd/MM/yyyy')
    END AS ERROR_DATE

FROM
    DIFFERENCE
WHERE
    RECON_RUN_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    AND DIFFERENCE_AMOUNT != 0
    AND ROWNUM <= 1000  -- Limits the result to 1000 rows
