    private List<ProcessingItem> extractAmountColumns(String[] cols, AsciiConfig config) {
        List<ProcessingItem> items = new ArrayList<>();
        String head = cols[config.getInputHeadCol() - 1].trim();
        String seq = config.getAmountColSeq(); // e.g. "3else4"

        // --- FIXED LOGIC: 'else' now skips 0.00, 0, and Empty ---
        if (seq.contains("else")) {
            String[] parts = seq.split("else");
            
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                
                // 1. Get the value (Handle index out of bounds)
                BigDecimal val = BigDecimal.ZERO;
                if (idx < cols.length) {
                    val = parseAmount(cols[idx]); // Parses "0.00" -> 0
                }

                // 2. CRITICAL CHECK: Is it a "Real" Number? (Not Zero)
                if (val.compareTo(BigDecimal.ZERO) != 0) {
                    // We found a non-zero value (e.g., 500.00). Stop here!
                    items.add(new ProcessingItem(head, val, idx + 1));
                    return items; 
                }
                // If it was 0, loop continues to the NEXT column (Col 4)
            }
            
            // 3. Fallback: If both Col 3 and Col 4 were Zero/Empty, return 0.
            int primaryCol = Integer.parseInt(parts[0].trim());
            items.add(new ProcessingItem(head, BigDecimal.ZERO, primaryCol));
        } 
        
        // --- Logic for 'and' (Keep unchanged) ---
        else if (seq.contains("and")) {
            String[] parts = seq.split("and");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
            }
        } 
        // --- Logic for Single Column (Keep unchanged) ---
        else {
            int idx = Integer.parseInt(seq.trim()) - 1;
            items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
        }
        return items;
    }
