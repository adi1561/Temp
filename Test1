    private static class ParsingResult {
        List<ExcelRowData> rows;
        boolean hasProductColumn;

        public ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) {
            this.rows = rows;
            this.hasProductColumn = hasProductColumn;
