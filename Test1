package com.tcs.fincore.CommonRequestService.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import com.tcs.fincore.CommonRequestService.repository.LhoMasterRepository; // Replace with your actual repository

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.stereotype.Component;

@Slf4j
@Component
@RequiredArgsConstructor
public class LhoTransferStrategy implements RequestTypeStrategy {

    // 1. Inject your Repository and Spring's native KafkaTemplate directly
    private final LhoMasterRepository lhoMasterRepository; 
    private final KafkaTemplate<String, Object> kafkaTemplate;
    private final ObjectMapper objectMapper;

    // Define your Kafka topic (consider moving to application.yml and injecting via @Value)
    private static final String LHO_KAFKA_TOPIC = "lho-transfer-events";

    @Override
    public RequestType getRequestType() {
        return RequestType.LHO_TRANSFER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        log.info("Processing Approval for LHO Transfer Batch: {}", request.getTargetId());

        switch (request.getChangeType()) {
            case ADD:
                handleLhoApproval(request);
                break;
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " not supported for LHO.");
        }
    }

    private void handleLhoApproval(CommonReq request) throws JsonProcessingException {
        log.info("Executing master table updates for LHO targetId: {}", request.getTargetId());
        
        // 2. Extract payload if needed to update the master table
        // LhoPayloadDto payload = objectMapper.readValue(request.getPayload(), LhoPayloadDto.class);
        
        // 3. Update the database directly using the repository
        // Example: lhoMasterRepository.updateTransferStatus(request.getTargetId(), "FINALIZED");
        
        // 4. Fire the Kafka Event
        log.info("Publishing Kafka event to topic {} for targetId: {}", LHO_KAFKA_TOPIC, request.getTargetId());
        
        // Sending a simple message. (Key = targetId, Value = Action or Payload)
        kafkaTemplate.send(LHO_KAFKA_TOPIC, request.getTargetId(), "LHO_TRANSFER_APPROVED");
        
        log.info("LHO Transfer Batch {} successfully approved and finalized.", request.getTargetId());
    }
}
