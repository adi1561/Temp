UPDATE ASCII_CONFIG 
SET 
    -- 1. Input Regex: Accept any valid alphanumeric Head
    INPUT_HEAD_REGEX = '^[A-Z0-9].*',

    -- 2. Decimal Logic:
    -- First: Apply [2] decimals to EVERYTHING (Default).
    -- Then: IF Head starts with S or N, force [0] decimals (Override).
    -- Regex changed to ["^[SN].*"] which catches S..., NXY..., etc.
    OUTPUT_AMT_DECIMAL = '["^.*"][3][2]|["^[SN].*"][3][0]',

    -- 3. Padding Logic:
    -- First: Format EVERYTHING to 19 chars with 2 decimals (Default).
    -- Then: IF Head starts with S or N, force 19 chars with 0 decimals (Override).
    OUTPUT_AMT_COL_PAD = '["^.*"][3][19,2]|["^[SN].*"][3][19,0]'

WHERE ID = 101;

COMMIT;
