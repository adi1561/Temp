package com.fincore.entity;

import jakarta.persistence.*;
import java.math.BigDecimal;
import java.time.LocalDate;
import lombok.Data;
import lombok.NoArgsConstructor;

@Entity
@Table(name = "DIFFERENCE", schema = "FINCORE")
@Data
@NoArgsConstructor
public class Difference {

    @Id
    @Column(name = "ID")
    private Long id;

    @Column(name = "RECON_RUN_DATE")
    private LocalDate reconRunDate;

    @Column(name = "BRANCH_CODE", length = 5)
    private String branchCode;

    @Column(name = "CURRENCY", length = 3)
    private String currency;

    @Column(name = "CGL", length = 10)
    private String cgl;

    @Column(name = "CBS_BALANCE", precision = 25, scale = 4)
    private BigDecimal cbsBalance;

    @Column(name = "GL_BALANCE", precision = 25, scale = 4)
    private BigDecimal glBalance;

    @Column(name = "DIFFERENCE_AMOUNT", precision = 25, scale = 4)
    private BigDecimal differenceAmount;

    @Column(name = "DIFF_BW_YESTERDAY", precision = 25, scale = 4)
    private BigDecimal diffBwYesterday;

    @Column(name = "TYPE", length = 40)
    private String type;

    @Column(name = "HEAD", length = 30)
    private String head;
}

