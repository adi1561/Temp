public Employee createEmployee(EmpRequest empRequest) {
    // 1. Declare the parent reference (Empty for now)
    Employee employeeToSave;

    if (empRequest.getType().equals("FullTimeEmployee")) {
        FullTimeEmployee ft = new FullTimeEmployee();
        ft.setAnnualSalary(empRequest.getAnnualSalary());
        ft.setMonthlyBonus(empRequest.getMonthlyBonus());
        employeeToSave = ft; // Point the parent reference to the Child
    } 
    else if (empRequest.getType().equals("ContractEmployee")) {
        ContractEmployee ce = new ContractEmployee();
        ce.setContractDurationMonths(empRequest.getContractDurationMonths());
        ce.setHourlyRate(empRequest.getHourlyRate());
        employeeToSave = ce; // Point the parent reference to the Child
    } 
    else {
        throw new RuntimeException("Invalid Type");
    }

    // 2. Set common fields on the object we just created
    employeeToSave.setFullName(empRequest.getFullName());
    employeeToSave.setDepartment(empRequest.getDepartment());

    // 3. Save the specific Child object through the Parent Repository
    return empRepo.save(employeeToSave); 
}
