      fontSize: "0.95rem",
    },
    "& .MuiDataGrid-row:hover": {
      backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.04),
    },
  },
  tableContainer: { height: 450, border: 1, borderColor: "divider", mt: 1 },
  fixedContentBox: {
    height: 500,
    display: "flex",
    flexDirection: "column",
    justifyContent: "space-between",
  },
  tableHeaderCell: {
