package com.tcs.fincore.CommonRequestService.service.kafka;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.CommonRequestService.repository.CommonRequestRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Optional;

@Slf4j
@Service
@RequiredArgsConstructor
public class LhoKafkaConsumerService {

    private final CommonRequestRepository commonRequestRepository;
    private final ObjectMapper objectMapper;

    /**
     * Listens to the SUCCESS topic.
     * Updates the request status to ACCEPTED.
     */
    @KafkaListener(
            topics = "${app.kafka.topics.lho-success:lho-airflow-success-topic}",
            groupId = "${spring.kafka.consumer.group-id:fincore-group}"
    )
    @Transactional
    public void consumeSuccessEvent(String message) {
        log.info("Received SUCCESS event from Kafka: {}", message);
        processIncomingEvent(message, RequestStatus.ACCEPTED, "Airflow processing completed successfully.");
    }

    /**
     * Listens to the FAILURE topic.
     * Reverts the request status back to PENDING.
     */
    @KafkaListener(
            topics = "${app.kafka.topics.lho-failure:lho-airflow-failure-topic}",
            groupId = "${spring.kafka.consumer.group-id:fincore-group}"
    )
    @Transactional
    public void consumeFailureEvent(String message) {
        log.error("Received FAILURE event from Kafka: {}", message);
        processIncomingEvent(message, RequestStatus.PENDING, "Airflow processing failed. Reverted to PENDING.");
    }

    /**
     * Core logic to extract ID, find the entity, and update the status.
     */
    private void processIncomingEvent(String message, RequestStatus targetStatus, String defaultRemark) {
        try {
            JsonNode payload = objectMapper.readTree(message);

            if (!payload.has("ID") || payload.get("ID").isNull()) {
                log.warn("Kafka event ignored: Missing 'ID' field in payload.");
                return;
            }

            Long requestId = payload.get("ID").asLong();
            Optional<CommonReq> requestOpt = commonRequestRepository.findById(requestId);

            if (requestOpt.isPresent()) {
                CommonReq request = requestOpt.get();
                
                // Update the status based on which topic it came from
                request.setReqStatus(targetStatus);
                
                // If Airflow sends specific error remarks back, we can capture them here. Otherwise, use default.
                String remarks = payload.has("responseRemarks") ? payload.get("responseRemarks").asText() : defaultRemark;
                request.setExecutionRemarks(remarks);

                commonRequestRepository.save(request);
                log.info("Successfully updated Request ID: {} to status: {}", requestId, targetStatus);
                
            } else {
                log.warn("Kafka event ignored: No CommonReq found with ID: {}", requestId);
            }

        } catch (Exception e) {
            log.error("Failed to parse or process incoming Kafka event. Message: {}", message, e);
        }
    }
}

