    // ==================================================================================
    // 1. ASYNC BATCH CREATION (PARALLEL OPTIMIZATION)
    // ==================================================================================

    @Override
    @Transactional
    public String createBatchFromCacheAsync(String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        String lockKey = "LOCK_REQ_" + requestId;
        Boolean acquired;

        try {
            // FIX: Removed RedisSystemException as DataAccessException covers it (Resolved Red IDE Error)
            acquired = redisTemplate.opsForValue().setIfAbsent(lockKey, new byte[0], 5, TimeUnit.MINUTES);
        } catch (DataAccessException e) {
            log.error("REDIS_LOCK_FAIL | ReqID: {} | Error: {}", requestId, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Distributed lock service unavailable", e);
        }

        if (Boolean.FALSE.equals(acquired)) {
            log.warn("CONCURRENCY_LOCKED | ReqID: {} | Duplicate batch creation attempt", requestId);
            throw new CustomExceptions.ConcurrencyLockException("Batch creation is already in progress for this Request ID.");
        }

        try {
            String batchId = sequenceService.getNextBatchId();
            progressService.sendProgress(batchId, creatorId, 0, "PROCESSING", "Initializing Batch Creation...");
            // Use 'self' to ensure Spring Proxy handles the @Async call correctly
            self.executeAsyncBatchCreation(batchId, requestId, commonRemarks, creatorId, creatorRole);
            return batchId;
        } catch (DataAccessException e) {
            redisTemplate.delete(lockKey);
            log.error("SEQUENCE_GEN_FAIL | ReqID: {} | Message: {}", requestId, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Batch ID sequence", e);
        }
    }

    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchCreation(String batchId, String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        MDC.put("batchId", batchId);
        MDC.put("user", creatorId);
        MDC.put("action", "CREATE");

        log.info("ASYNC_BATCH_START | Batch: {} | Source: {}", batchId, requestId);
        long start = System.currentTimeMillis();

        try {
            progressService.sendProgress(batchId, creatorId, 5, "PROCESSING", "Preparing Data...");

            // 1. Fetch from Redis
            List<JournalBulkValidationService.ExcelRowData> cachedRows = journalBulkValidationService.getValidRowsFromCache(requestId);
            if (cachedRows == null || cachedRows.isEmpty()) {
                logAudit(creatorId, "CREATE_FAIL", "BATCH_ASYNC", "Cache Expired for " + batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired or empty.");
                return;
            }

            // 2. Prepare Parallel Execution
            int totalRows = cachedRows.size();
            int batchSize = 5000; // Optimal size for Oracle high-volume batch inserts

            List<CompletableFuture<Void>> futures = new ArrayList<>();
            LongAdder totalDebit = new LongAdder();
            LongAdder totalCredit = new LongAdder();

            AtomicInteger completedChunks = new AtomicInteger(0);
            int totalChunks = (int) Math.ceil((double) totalRows / batchSize);

            // 3. Submit Chunks for Raw JDBC Insertion
            for (int i = 0; i < totalRows; i += batchSize) {
                final int startIdx = i;
                final int endIdx = Math.min(i + batchSize, totalRows);
                final List<JournalBulkValidationService.ExcelRowData> chunk = cachedRows.subList(startIdx, endIdx);

                CompletableFuture<Void> future = CompletableFuture.runAsync(() ->
                                processChunkRaw(chunk, batchId, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit), bulkExecutor)
                        .thenRun(() -> {
                            int done = completedChunks.incrementAndGet();
                            int percent = 5 + (done * 90 / totalChunks);
                            progressService.sendProgress(batchId, creatorId, percent, "PROCESSING",
                                    String.format("Created %d/%d records...", Math.min(done * batchSize, totalRows), totalRows));
                        });
                futures.add(future);
            }

            // Wait for all JDBC threads to complete
            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            // 5. Insert Master Record into Oracle
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            String sumSql = "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
            jdbcTemplate.update(sumSql, batchId, creatorId, ts, commonRemarks, totalRows,
                    BigDecimal.valueOf(totalDebit.sum()), BigDecimal.valueOf(totalCredit.sum()), "PENDING");

            // 6. Cleanup & Notify
            redisTemplate.delete("DATA_" + requestId);
            redisTemplate.delete("LOCK_REQ_" + requestId);
            logAudit(creatorId, "CREATE_SUCCESS", "BATCH_ASYNC", "Successfully created batch " + batchId);

            progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Batch Created Successfully");
            sendNotification(creatorId, null, "Batch " + batchId + " created successfully.", batchId);

            NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
            if (config != null) {
                String msg = String.format("New Batch %s by %s requires approval.", batchId, creatorId);
                sendNotification(creatorId, config.getTargetRoles(), msg, batchId);
            }

            log.info("BATCH_CREATION_FINISHED | Batch: {} | TotalRows: {} | Duration: {}ms", batchId, totalRows, System.currentTimeMillis() - start);

        } catch (CustomExceptions.CacheExpiredException e) {
            log.error("CACHE_ERROR | Batch: {} | Cache data lost in Redis", batchId);
            handleAsyncFailure(batchId, creatorId, requestId, "Data cache expired. Please re-upload.");
        } catch (CompletionException | DataAccessException e) {
            log.error("DATABASE_ERROR | Batch: {} | Failed to persist records", batchId, e);
            handleAsyncFailure(batchId, creatorId, requestId, "Database persistence failed. Try again.");
        } catch (RuntimeException e) {
            log.error("CRITICAL_SYSTEM_FAIL | Batch: {} | Error: {}", batchId, e.getMessage());
            handleAsyncFailure(batchId, creatorId, requestId, "Unexpected system error during creation.");
        } finally {
            MDC.clear();
        }
    }

    private void handleAsyncFailure(String batchId, String creatorId, String requestId, String message) {
        cleanupFailedBatch(batchId);
        redisTemplate.delete("LOCK_REQ_" + requestId);
        jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", message, batchId);
        progressService.sendProgress(batchId, creatorId, 0, "FAILED", message);
    }

    /**
     * RAW JDBC INSERT (Logic fully preserved)
     * Direct connection for high-performance batch execution, bypassing JPA overhead.
     */
    private void processChunkRaw(List<JournalBulkValidationService.ExcelRowData> chunk, String batchId, String commonRemarks, String creatorId, Integer creatorRole, int globalOffset, LongAdder debit, LongAdder credit) {
        String sql = "INSERT INTO JOURNAL_REQUEST (REQ_ID, REQ_STATUS, REQ_DATE, CREATOR_ID, CREATOR_ROLE, BATCH_ID, JOURNAL_ID, COMMON_BATCH_REMARKS, PAYLOAD, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_CSV_DATE, REQ_NARRATION, REQ_PRODUCT) VALUES (JOURNAL_REQUEST_SEQ.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

        try (Connection conn = dataSource.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            conn.setAutoCommit(false);
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            final DateTimeFormatter jsonFmt = DateTimeFormatter.ISO_DATE;

            for (int i = 0; i < chunk.size(); i++) {
                JournalBulkValidationService.ExcelRowData r = chunk.get(i);
                int globalIdx = globalOffset + i + 1;
                String jId = batchId + "-" + globalIdx;

                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                boolean isCredit = "Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType);
                BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                if (isCredit) credit.add(absAmt.longValue());
                else debit.add(absAmt.longValue());

                LocalDate rDate = LocalDate.now();
                if (r.isSystemFormat && r.sysDate != null && r.sysDate.length() == 8) {
                    try { rDate = LocalDate.parse(r.sysDate, DateTimeFormatter.ofPattern("ddMMyyyy")); }
                    catch (DateTimeParseException ignored) {}
                }

                ps.setString(1, "P");
                ps.setTimestamp(2, ts);
                ps.setString(3, creatorId);
                ps.setInt(4, creatorRole != null ? creatorRole : 0);
                ps.setString(5, batchId);
                ps.setString(6, jId);
                ps.setString(7, commonRemarks);
                ps.setString(8, buildJsonPayloadFast(r, signedAmt, rDate, batchId, jId, commonRemarks, globalIdx, jsonFmt));
                ps.setString(9, r.branch);
                ps.setString(10, r.currency);
                ps.setString(11, r.cgl);
                ps.setBigDecimal(12, signedAmt);
                ps.setDate(13, java.sql.Date.valueOf(rDate));
                ps.setString(14, r.remarks);
                ps.setString(15, r.productCode);

                ps.addBatch();
            }
            ps.executeBatch();
            conn.commit();
        } catch (SQLException e) {
            log.error("JDBC_SQL_FAIL | Batch: {} | Offset: {} | SQLState: {}", batchId, globalOffset, e.getSQLState());
            throw new CustomExceptions.DatabaseOperationException("Failed to persist batch chunk due to SQL error", e);
        }
    }

    private void cleanupFailedBatch(String batchId) {
        try {
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);
            jdbcTemplate.update("DELETE FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", batchId);
        } catch (DataAccessException e) {
            log.warn("CLEANUP_WARN | Batch: {} | Failed to purge partial data", batchId);
        }
    }

    // ==================================================================================
    // 2. ASYNC APPROVAL (Oracle Procedure & HDFS SYNC)
    // ==================================================================================

    @Override
    @Transactional
    public void processBulkRequestsAsync(BulkProcessJournalRequestDto dto, String executorId, Integer executorRole) {
        String lockSql = "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS = 'PENDING'";
        int updated = jdbcTemplate.update(lockSql, dto.getBatchId());

        if (updated == 0) {
            log.warn("APPROVAL_LOCK_FAIL | Batch: {} | Race condition detected", dto.getBatchId());
            throw new IllegalStateException("Batch is already being processed or is not in PENDING status.");
        }

        progressService.sendProgress(dto.getBatchId(), executorId, 0, "PROCESSING", "Approval Queued...");
        self.executeAsyncBatchProcessing(dto, executorId);
    }

    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchProcessing(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        MDC.put("batchId", batchId);
        MDC.put("user", executorId);
        long start = System.currentTimeMillis();

        try {
            String creatorId = jdbcTemplate.queryForObject("SELECT CREATOR_ID FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", String.class, batchId);
            progressService.sendProgress(batchId, executorId, 20, "PROCESSING", "Executing Oracle Core Business Logic...");

            if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                // 1. Trigger Oracle PL/SQL Parallel Processing
                List<HdfsSyncDto> syncData = jdbcTemplate.execute(
                        "{call PROCESS_JOURNAL_BATCH(?, ?, ?, ?, ?)}",
                        (CallableStatementCallback<List<HdfsSyncDto>>) cs -> {
                            cs.setString(1, batchId);
                            cs.setString(2, executorId);
                            cs.setString(3, dto.getRemarks());
                            cs.setString(4, "A");
                            cs.registerOutParameter(5, -10); // Oracle Cursor
                            cs.execute();

                            List<HdfsSyncDto> list = new ArrayList<>();
                            try (ResultSet rs = (ResultSet) cs.getObject(5)) {
                                while (rs.next()) {
                                    list.add(new HdfsSyncDto(
                                            rs.getString("BRANCH"), rs.getString("CURRENCY"), rs.getString("CGL"),
                                            rs.getDate("BAL_DATE").toLocalDate(),
                                            rs.getBigDecimal("NEW_BALANCE"), rs.getBigDecimal("NEW_INR_BALANCE")
                                    ));
                                }
                            }
                            return list;
                        }
                );

                // 2. Finalize Master Table Status
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ACCEPTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);

                // 3. SYNC TO HDFS DATA LAKE (Now Active)
                try {
                    hdfsSyncService.syncToDataLake(syncData);
                } catch (RuntimeException hdfsEx) {
                    log.error("HDFS_SYNC_FAIL | Batch: {} | Queuing for background retry", batchId);
                    jdbcTemplate.update("INSERT INTO HDFS_SYNC_RETRY_QUEUE (BATCH_ID, STATUS) VALUES (?, 'PENDING')", batchId);
                }

                // 4. Notifications
                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Approved Successfully");
                sendNotification(executorId, null, "You approved Batch " + batchId, batchId);
                if (creatorId != null && !creatorId.equals(executorId)) {
                    sendNotification(creatorId, null, "Your Batch " + batchId + " has been ACCEPTED.", batchId);
                }
                logAudit(executorId, "APPROVE_SUCCESS", "BATCH_ASYNC", "Batch " + batchId + " Accepted");

            } else if (RequestStatus.REJECTED.equals(dto.getStatus())) {
                // Reject Rows and Summary
                jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ?, EXECUTION_DATE = SYSDATE WHERE BATCH_ID = ? AND REQ_STATUS = 'P'",
                        executorId, dto.getRemarks(), batchId);

                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);

                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Rejected");
                sendNotification(executorId, null, "You rejected Batch " + batchId, batchId);
                if (creatorId != null && !creatorId.equals(executorId)) {
                    sendNotification(creatorId, null, "Your Batch " + batchId + " was REJECTED.", batchId);
                }
                logAudit(executorId, "REJECT_SUCCESS", "BATCH_ASYNC", "Batch " + batchId + " Rejected");
            }
            log.info("BATCH_PROCESSING_DONE | Batch: {} | Status: {} | Duration: {}ms", batchId, dto.getStatus(), System.currentTimeMillis() - start);

        } catch (DataAccessException e) {
            log.error("PROCEDURE_EXEC_FAIL | Batch: {} | DB error", batchId, e);
            handleAsyncApprovalError(batchId, executorId, "Database execution error during approval.");
        } catch (RuntimeException e) {
            log.error("ASYNC_PROCESS_CRASH | Batch: {} | Error: {}", batchId, e.getMessage());
            handleAsyncApprovalError(batchId, executorId, "Internal system failure during processing.");
        } finally {
            MDC.clear();
        }
    }

    private void handleAsyncApprovalError(String batchId, String executorId, String msg) {
        jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", msg, batchId);
        progressService.sendProgress(batchId, executorId, 0, "FAILED", msg);
    }

    // ==================================================================================
    // 3. ASYNC DELETION (PL/SQL Integration)
    // ==================================================================================

    @Override
    @Transactional
    public void cancelMyRequestsByBatchIdAsync(String batchId, String userId) {
        int updated = jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS IN ('PENDING', 'ERROR')", batchId);
        if (updated == 0) {
            log.warn("DELETE_LOCK_FAIL | Batch: {} | Already being purged", batchId);
            throw new IllegalStateException("Batch is already being processed or deleted.");
        }
        progressService.sendProgress(batchId, userId, 0, "PROCESSING", "Purging Batch Data...");
        self.executeAsyncBatchCancellation(batchId, userId);
    }

    @Override
    @Async("bulkExecutor")
    public void executeAsyncBatchCancellation(String batchId, String userId) {
        MDC.put("batchId", batchId);
        MDC.put("user", userId);
        long start = System.currentTimeMillis();

        try {
            progressService.sendProgress(batchId, userId, 20, "PROCESSING", "Purging Data Rows...");
            jdbcTemplate.execute("{call PURGE_JOURNAL_BATCH(?, ?)}", (CallableStatementCallback<Object>) cs -> {
                cs.setString(1, batchId);
                cs.setString(2, userId);
                cs.execute();
                return null;
            });

            logAudit(userId, "CANCEL_SUCCESS", "BATCH_ASYNC", "Purged Batch " + batchId);
            progressService.sendProgress(batchId, userId, 100, "COMPLETED", "Batch Deleted");
            sendNotification(userId, null, "Batch " + batchId + " deleted successfully.", batchId);
            log.info("BATCH_PURGE_COMPLETE | Batch: {} | Duration: {}ms", batchId, System.currentTimeMillis() - start);

        } catch (DataAccessException e) {
            log.error("PURGE_DB_ERROR | Batch: {} | SQLState: {}", batchId, e.getMessage());
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", "Deletion Failed on Database", batchId);
            progressService.sendProgress(batchId, userId, 0, "FAILED", "Delete Failed: System error");
        } finally {
            MDC.clear();
        }
    }

