/**
 * Handles high-performance streaming parsing and multi-stage validation.
 * Optimized for 500,000 records using POI Event API and Redis Chunking.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private static final Pattern CLEAN_AMOUNT_REGEX = Pattern.compile("[^0-9.]");
    private static final Pattern PRODUCT_CODE_REGEX = Pattern.compile("^\\d{8}$");
    private static final Pattern CGL_FORMAT_REGEX = Pattern.compile("^\\d{10}$");
    private static final DateTimeFormatter SYSTEM_DATE_FMT = DateTimeFormatter.ofPattern("ddMMyyyy");

    private final ValidationMasterService validationMasterService;
    private final ObjectMapper objectMapper;

    @Autowired
    @Qualifier("byteArrayRedisTemplate")
    private RedisTemplate<String, byte[]> redisTemplate;

    @Autowired
    @Lazy
    private JournalBulkValidationService self;

    // ==================================================================================
    // 1. STATE & REDIS MANAGEMENT
    // ==================================================================================

    private synchronized void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        BulkUploadStateDto state = getStatusFromRedis(requestId);
        if (state == null) {
            state = new BulkUploadStateDto();
            state.setRequestId(requestId);
        }
        updater.accept(state);
        saveStatusToRedis(requestId, state);
    }

    private void saveStatusToRedis(String reqId, BulkUploadStateDto state) {
        try {
            byte[] json = objectMapper.writeValueAsBytes(state);
            redisTemplate.opsForValue().set("BULK_STATUS_" + reqId, json, 2, TimeUnit.HOURS);
        } catch (Exception e) {
            log.error("REDIS_STATE_FAIL | ReqID: {}", reqId);
        }
    }

    private BulkUploadStateDto getStatusFromRedis(String reqId) {
        try {
            byte[] json = redisTemplate.opsForValue().get("BULK_STATUS_" + reqId);
            return json == null ? null : objectMapper.readValue(json, BulkUploadStateDto.class);
        } catch (Exception e) { return null; }
    }

    private void saveRowsToRedis(String requestId, List<ExcelRowData> rows) {
        if (rows == null || rows.isEmpty()) return;
        try {
            int chunkSize = 5000;
            int totalRows = rows.size();
            int totalChunks = (int) Math.ceil((double) totalRows / chunkSize);

            for (int i = 0; i < totalChunks; i++) {
                int start = i * chunkSize;
                int end = Math.min(start + chunkSize, totalRows);
                List<ExcelRowData> chunk = rows.subList(start, end);

                try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
                     GZIPOutputStream gos = new GZIPOutputStream(baos)) {
                    objectMapper.writeValue(gos, chunk);
                    gos.finish();
                    redisTemplate.opsForValue().set("DATA_CHUNK_" + requestId + "_" + i, baos.toByteArray(), 1, TimeUnit.HOURS);
                }
            }
            Map<String, Object> meta = new HashMap<>();
            meta.put("totalChunks", totalChunks);
            meta.put("totalRows", totalRows);
            redisTemplate.opsForValue().set("DATA_META_" + requestId, objectMapper.writeValueAsBytes(meta), 1, TimeUnit.HOURS);
        } catch (Exception e) {
            log.error("REDIS_CHUNK_SAVE_FAIL | ReqID: {}", requestId);
        }
    }

    public List<ExcelRowData> getValidRowsFromCache(String requestId) {
        byte[] metaBytes = redisTemplate.opsForValue().get("DATA_META_" + requestId);
        if (metaBytes == null) throw new CustomExceptions.CacheExpiredException("Data expired.");
        try {
            Map<String, Object> meta = objectMapper.readValue(metaBytes, new TypeReference<>() {});
            int totalChunks = (int) meta.get("totalChunks");
            List<ExcelRowData> allRows = new ArrayList<>((int) meta.get("totalRows"));

            for (int i = 0; i < totalChunks; i++) {
                byte[] chunk = redisTemplate.opsForValue().get("DATA_CHUNK_" + requestId + "_" + i);
                try (GZIPInputStream gis = new GZIPInputStream(new ByteArrayInputStream(chunk))) {
                    allRows.addAll(objectMapper.readValue(gis, new TypeReference<List<ExcelRowData>>() {}));
                }
            }
            return allRows;
        } catch (Exception e) { throw new CustomExceptions.FileProcessingException("Cache Retrieval Failed", e); }
    }

    // ==================================================================================
    // 2. MAIN ASYNC FLOW
    // ==================================================================================

    public String initiateValidation(InputStream fileStream, String filename, LocalDate postingDate) throws IOException {
        String requestId = UUID.randomUUID().toString();
        Path tempFile = Files.createTempFile("UPLOAD_" + requestId + "_", ".tmp");
        Files.copy(fileStream, tempFile, StandardCopyOption.REPLACE_EXISTING);

        updateState(requestId, s -> {
            s.setStatus("PROCESSING");
            s.setMessage("File Received...");
        });

        self.processAsync(requestId, tempFile.toString(), filename, postingDate);
        return requestId;
    }

    @Async("bulkExecutor")
    public void processAsync(String requestId, String tempFilePath, String filename, LocalDate postingDate) {
        MDC.put("requestId", requestId);
        File tempFile = new File(tempFilePath);
        try {
            updateState(requestId, s -> s.setMessage("Parsing File..."));
            ParsingResult result;
            boolean isCsv = filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt");
            
            try (InputStream is = new FileInputStream(tempFile)) {
                result = isCsv ? parseCsvStream(is, postingDate) : parseExcelStream(is, postingDate);
            }

            List<ExcelRowData> rows = result.rows;
            updateState(requestId, s -> s.setTotalRows(rows.size()));

            // Stage 1: Format
            updateState(requestId, s -> s.setMessage("Validating Formats..."));
            runFormatCheck(rows);
            if (rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, rows, "Format Validation Failed", 1, result.hasProductColumn);
                return;
            }

            // Stage 2: Database
            updateState(requestId, s -> { s.setCurrentStage(2); s.setMessage("Checking Database..."); });
            runDbCheck(rows);
            if (rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, rows, "Database Validation Failed", 2, result.hasProductColumn);
                return;
            }

            // Stage 3: Balance
            updateState(requestId, s -> { s.setCurrentStage(3); s.setMessage("Checking Balances..."); });
            runBalanceCheck(rows);
            if (rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, rows, "Balance Mismatch", 3, result.hasProductColumn);
                return;
            }

            completeRequest(requestId, rows, postingDate, isCsv, result.hasProductColumn);
        } catch (Exception e) {
            handleAsyncCrash(requestId, e.getMessage());
        } finally {
            if (tempFile.exists()) tempFile.delete();
            MDC.clear();
        }
    }

    // ==================================================================================
    // 3. EXCEL EVENT PARSER (FIXES NoSuchMethodError)
    // ==================================================================================

    private ParsingResult parseExcelStream(InputStream is, LocalDate postingDate) throws Exception {
        List<ExcelRowData> list = new ArrayList<>();
        final boolean[] hasProduct = {false};

        try (OPCPackage pkg = OPCPackage.open(is)) {
            ReadOnlySharedStringsTable strings = new ReadOnlySharedStringsTable(pkg);
            XSSFReader xssfReader = new XSSFReader(pkg);
            StylesTable styles = xssfReader.getStylesTable();
            XSSFReader.SheetIterator iter = (XSSFReader.SheetIterator) xssfReader.getSheetsData();

            if (iter.hasNext()) {
                try (InputStream sheetStream = iter.next()) {
                    XMLReader sheetParser = XMLHelper.newXMLReader();
                    XSSFSheetXMLHandler handler = new XSSFSheetXMLHandler(styles, strings, new XSSFSheetXMLHandler.SheetContentsHandler() {
                        private ExcelRowData currentRow;
                        private Map<Integer, String> colMap = new HashMap<>();

                        @Override public void startRow(int rowNum) { currentRow = new ExcelRowData(); currentRow.rowIndex = rowNum; colMap.clear(); }
                        @Override public void cell(String cellRef, String val, org.apache.poi.xssf.usermodel.XSSFComment comment) {
                            int colIdx = new org.apache.poi.ss.util.CellReference(cellRef).getCol();
                            colMap.put(colIdx, val);
                        }
                        @Override public void endRow(int rowNum) {
                            if (rowNum == 0 && colMap.getOrDefault(0, "").toLowerCase().contains("branch")) return;
                            if (colMap.isEmpty()) return;
                            applyMapping(currentRow, colMap, hasProduct, postingDate);
                            list.add(currentRow);
                        }
                    }, false);
                    sheetParser.setContentHandler(handler);
                    sheetParser.parse(new InputSource(sheetStream));
                }
            }
        }
        return new ParsingResult(list, hasProduct[0]);
    }

    private void applyMapping(ExcelRowData d, Map<Integer, String> colMap, boolean[] hasProduct, LocalDate postingDate) {
        String col0 = colMap.getOrDefault(0, "").trim();
        d.sysSite = col0;
        if ("01".equals(col0) || "1".equals(col0)) {
            d.isSystemFormat = true;
            d.sysDate = colMap.getOrDefault(1, "");
            d.sysYear = colMap.getOrDefault(2, "");
            d.sysPeriod = colMap.getOrDefault(3, "");
            d.branch = colMap.getOrDefault(4, "");
            d.currency = colMap.getOrDefault(5, "").toUpperCase();
            d.cgl = colMap.getOrDefault(6, "");
            parseAmount(d, colMap.getOrDefault(7, ""), colMap.getOrDefault(8, ""));
            d.remarks = colMap.getOrDefault(9, "");
            d.productCode = colMap.getOrDefault(10, "");
            if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProduct[0] = true;
            validateSystemColumns(d, col0, d.sysDate, d.sysYear, d.sysPeriod, colMap.getOrDefault(11, ""), colMap.getOrDefault(12, ""), colMap.getOrDefault(13, ""), postingDate);
        } else {
            d.branch = col0;
            d.currency = colMap.getOrDefault(1, "").toUpperCase();
            d.cgl = colMap.getOrDefault(2, "");
            parseAmount(d, colMap.getOrDefault(3, ""), colMap.getOrDefault(4, ""));
            d.remarks = colMap.getOrDefault(5, "");
            d.productCode = colMap.getOrDefault(6, "");
            if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProduct[0] = true;
        }
    }

    // ==================================================================================
    // 4. CSV PARSER (PRESERVED)
    // ==================================================================================

    private ParsingResult parseCsvStream(InputStream is, LocalDate postingDate) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        boolean hasProduct = false;
        try (BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
            String line; int i = 0;
            while ((line = br.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] c = line.split(",", -1);
                if (i == 0 && c[0].toLowerCase().contains("branch")) { i++; continue; }
                ExcelRowData d = new ExcelRowData(); d.rowIndex = i++;
                String c0 = c[0].replace("\uFEFF", "").trim();
                d.sysSite = c0;
                if ("01".equals(c0)) {
                    d.isSystemFormat = true;
                    if (c.length > 6) { d.sysDate=c[1]; d.sysYear=c[2]; d.sysPeriod=c[3]; d.branch=c[4]; d.currency=c[5].toUpperCase(); d.cgl=c[6]; }
                    parseAmount(d, c.length > 7 ? c[7] : "", c.length > 8 ? c[8] : "");
                    d.remarks = c.length > 9 ? c[9] : "";
                    d.productCode = c.length > 10 ? c[10] : "";
                    if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProduct = true;
                    if (c.length != 14) d.formatErrors.add("Invalid columns (Expected 14)");
                    else validateSystemColumns(d, c0, d.sysDate, d.sysYear, d.sysPeriod, c[11], c[12], c[13], postingDate);
                } else {
                    if (c.length > 2) { d.branch=c[0]; d.currency=c[1].toUpperCase(); d.cgl=c[2]; }
                    parseAmount(d, c.length > 3 ? c[3] : "", c.length > 4 ? c[4] : "");
                    d.remarks = c.length > 5 ? c[5] : "";
                    d.productCode = c.length > 6 ? c[6] : "";
                    if (!d.productCode.isEmpty() && !"A".equalsIgnoreCase(d.productCode)) hasProduct = true;
                }
                list.add(d);
            }
        }
        return new ParsingResult(list, hasProduct);
    }

    private void parseAmount(ExcelRowData d, String amtRaw, String typeRaw) {
        try {
            String clean = CLEAN_AMOUNT_REGEX.matcher(amtRaw).replaceAll("");
            if (clean.isEmpty()) { d.amount = BigDecimal.ZERO; return; }
            d.amount = new BigDecimal(clean);
            boolean isCr = typeRaw != null && (typeRaw.toUpperCase().contains("C"));
            d.txnType = isCr ? "Credit" : "Debit";
        } catch (Exception e) { d.amount = BigDecimal.ZERO; d.formatErrors.add("Invalid Amount"); }
    }

    // ==================================================================================
    // 5. VALIDATION RULES (PRESERVED)
    // ==================================================================================

    private void runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.amount == null || d.amount.signum() <= 0) d.formatErrors.add("Amount must be > 0");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("CGL must be 10 digits");
            if (d.remarks == null || d.remarks.isEmpty()) d.formatErrors.add("Remarks mandatory");
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Invalid Currency");
        });
    }

    private void runDbCheck(List<ExcelRowData> rows) {
        Set<String> branches = validationMasterService.getAllActiveBranches();
        Set<String> cgls = validationMasterService.getAllActiveCgls();
        rows.parallelStream().forEach(d -> {
            if (!branches.contains(d.branch)) d.dbErrors.add("Branch Inactive: " + d.branch);
            if (!cgls.contains(d.cgl)) d.dbErrors.add("CGL Inactive: " + d.cgl);
        });
    }

    private void runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> map = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(d -> {
            BigDecimal val = "Credit".equals(d.txnType) ? d.amount.negate() : d.amount;
            String key = d.branch + "_" + d.currency + "_" + (d.cgl.startsWith("5") ? "MEMO" : "NORMAL");
            map.computeIfAbsent(key, k -> new LongAdder()).add(val.multiply(new BigDecimal("10000")).longValue());
        });
        rows.parallelStream().forEach(d -> {
            String key = d.branch + "_" + d.currency + "_" + (d.cgl.startsWith("5") ? "MEMO" : "NORMAL");
            if (map.get(key).sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(map.get(key).sum()).divide(new BigDecimal("10000"), 4, RoundingMode.HALF_UP);
                synchronized(d.balErrors) { if(d.balErrors.isEmpty()) d.balErrors.add("Balance Mismatch: " + diff.toPlainString()); }
            }
        });
    }

    private void validateSystemColumns(ExcelRowData d, String c0, String cDate, String cYear, String cMonth, String c11, String c12, String c13, LocalDate postingDate) {
        try {
            LocalDate pDate = LocalDate.parse(cDate, SYSTEM_DATE_FMT);
            if (!pDate.equals(postingDate)) d.formatErrors.add("Date Mismatch");
        } catch (Exception e) { d.formatErrors.add("Invalid Date"); }
        if (!"B".equalsIgnoreCase(c11)) d.formatErrors.add("Col 12 must be B");
    }

    // ==================================================================================
    // 6. FINISHERS
    // ==================================================================================

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv, boolean hasProduct) {
        saveRowsToRedis(reqId, rows);
        updateState(reqId, s -> {
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasProductColumn(hasProduct);
        });
    }

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProduct) {
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void handleAsyncCrash(String requestId, String message) {
        updateState(requestId, s -> { s.setStatus("ERROR"); s.setMessage(message); });
    }

    private static class ParsingResult {
        List<ExcelRowData> rows; boolean hasProductColumn;
        public ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) { this.rows = rows; this.hasProductColumn = hasProductColumn; }
    }

    @JsonIgnoreProperties(ignoreUnknown = true)
    @JsonFormat(shape = JsonFormat.Shape.ARRAY)
    public static class ExcelRowData {
        @JsonProperty("0") public int rowIndex;
        @JsonProperty("1") public String branch = "";
        @JsonProperty("2") public String currency = "";
        @JsonProperty("3") public String cgl = "";
        @JsonProperty("4") public String txnType = "";
        @JsonProperty("5") public String remarks = "";
        @JsonProperty("6") public String productCode = "";
        @JsonProperty("7") public BigDecimal amount;
        @JsonProperty("8") public boolean isSystemFormat = false;
        @JsonProperty("9") public String sysSite = "";
        @JsonProperty("10") public String sysDate = "";
        @JsonProperty("11") public String sysYear = "";
        @JsonProperty("12") public String sysPeriod = "";
        @JsonProperty("13") public final List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());
        @JsonProperty("14") public final List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());
        @JsonProperty("15") public final List<String> balErrors = Collections.synchronizedList(new ArrayList<>());
        public boolean hasErrors() { return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty(); }
    }
}
