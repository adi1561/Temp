package com.tcs.fincore.CommonRequestService.dto;

import com.fasterxml.jackson.annotation.JsonInclude;
import lombok.Getter;

import java.time.Instant;

/**
 * A generic API response container used for standardizing responses across the application.
 * It includes fields for success status, a message, data payload, and a timestamp.
 * The {@code @JsonInclude(JsonInclude.Include.NON_NULL)} annotation ensures that
 * any fields with a null value are not included in the JSON output, optimizing the payload size.
 *
 * @param <T> The type of the data payload contained within the response.
 */
@Getter
@JsonInclude(JsonInclude.Include.NON_NULL) // Don't include null fields in the JSON response
public class ApiResponse<T> {

    /**
     * Indicates whether the API operation was successful.
     */
    private final boolean success;

    /**
     * A descriptive message regarding the outcome of the operation.
     */
    private final String message;

    /**
     * The actual data payload returned by the successful operation.
     * This field is null for error responses.
     */
    private final T data;

    /**
     * The timestamp indicating when the response was generated (in UTC).
     */
    private final Instant timestamp;

    /**
     * Private constructor to enforce the use of static factory methods for creating instances.
     * The timestamp is automatically set to the current time upon instantiation.
     *
     * @param success The success status of the operation.
     * @param message A descriptive message.
     * @param data The data payload.
     */
    private ApiResponse(boolean success, String message, T data) {
        this.success = success;
        this.message = message;
        this.data = data;
        this.timestamp = Instant.now();
    }

    /**
     * Factory method to create a successful API response with a custom message.
     *
     * @param <T> The type of the data payload.
     * @param data The data payload to be returned.
     * @param message A custom success message.
     * @return A successful ApiResponse instance.
     */
    public static <T> ApiResponse<T> success(T data, String message) {
        return new ApiResponse<>(true, message, data);
    }

    /**
     * Factory method to create a successful API response with a default message.
     *
     * @param <T> The type of the data payload.
     * @param data The data payload to be returned.
     * @return A successful ApiResponse instance with the default message "Operation completed successfully.".
     */
    public static <T> ApiResponse<T> success(T data) {
        return new ApiResponse<>(true, "Operation completed successfully.", data);
    }

    /**
     * Factory method to create an error API response.
     * The data payload is set to null, and the success status is false.
     *
     * @param <T> The type of the expected data payload (generic type inference).
     * @param message A descriptive error message.
     * @return An error ApiResponse instance.
     */
    public static <T> ApiResponse<T> error(String message) {
        return new ApiResponse<>(false, message, null);
    }
}

package com.tcs.fincore.CommonRequestService.dto;

import java.util.Date;

import com.fasterxml.jackson.annotation.JsonFormat;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonTypeName;
import com.tcs.fincore.CommonRequestService.dto.payload.KeyablePayload;

import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import lombok.Data;

/**
 * Data Transfer Object (DTO) representing the payload for a Branch request
 * within the CommonRequestService. This class is used for data validation and
 * serialization/deserialization of branch information. It implements
 * {@link KeyablePayload} to define how to extract a unique identifier (key) for
 * the payload.
 */
@Data
@JsonTypeName("BRANCH") // Specifies the type discriminator name for JSON serialization/deserialization
public class BranchRequestPayloadDTO implements KeyablePayload {

	/**
	 * Unique identifier/code for the branch. Must not be null.
	 */
	@NotNull(message = "Code cannot be null.")
	private String code;

	/**
	 * The name of the branch. Must not be null and must be between 1 and 50
	 * characters in length.
	 */
	@NotNull(message = "Name cannot be null")
	@Size(min = 1, max = 50, message = "Name length must be between 1 and 50")
	private String name;

	/**
	 * The circle code associated with the branch's location. Must not be null and
	 * must be exactly 5 characters in length.
	 */
	@NotNull(message = "Circle Code cannot be null")
	@Size(min = 5, max = 5, message = "Circle Code length must be between 5 and 5")
	private String circleCode;
	/**
	 * The circle name associated with the branch's location.
	 * Must not be null
	 */
	@NotNull(message = "Circle Code cannot be null")
	private String circleName;

	/**
	 * The state where the branch is located. Must not be null and must be between 1
	 * and 50 characters in length.
	 */
	@NotNull(message = "State cannot be null")
	@Size(min = 1, max = 50, message = "State length must be between 1 and 50")
	private String state;

	/**
	 * The name of the state where the branch is located. Must not be null and must
	 * be between 1
	 * and 50 characters in length.
	 */
	@NotNull(message = "State name cannot be null")
	private String stateName;

	/**
	 * The city where the branch is located. Must not be null and must be between 1
	 * and 50 characters in length.
	 */
	@Size(min = 1, max = 50, message = "City length must be between 1 and 50")
	private String city;

	/**
	 * The physical address of the branch. Must not be null and must be between 1
	 * and 50 characters in length.
	 */
	@Size(min = 1, max = 50, message = "Address length must be between 1 and 50")
	private String address;

	/**
	 * The postal identification number (PIN code) for the branch's location. Must
	 * not be null and must be exactly 6 characters in length.
	 */
	@Size(min = 6, max = 6, message = "Pincode length must be 6")
	private String pinCode;

	/**
	 * The main contact phone number for the branch. Must not be null and must be
	 * exactly 10 characters in length.
	 */
	@NotNull(message = "Phone Number cannot be null")
	@Size(min = 12, max = 12, message = "Phone Number length must be 12")
	private String phoneNumber;

	/**
	 * The official email ID for the branch. Must not be null and must be between 5
	 * and 50 characters in length.
	 */
	@NotNull(message = "Email ID cannot be null")
	@Size(min = 5, max = 50, message = "Email ID length must be between 5 and 50")
	private String emailId;

	/**
	 * The N-M-R (likely Network-Module-Region or similar internal code) code. Must
	 * not be null and must be between 3 and 50 characters in length.
	 */
	@NotNull(message = "N-M-R Code cannot be null")
	@Size(min = 3, max = 50, message = "N-M-R Code length must be between 3 and 50")
	private String nmrCode;

	/**
	 * The operational status of the branch (active/inactive). Must not be null.
	 */
	@NotNull(message = "Status cannot be null")
	private Boolean status;

	/**
	 * The date the branch was opened. Must not be null and is formatted as
	 * "dd/MM/yyyy" in JSON.
	 */
	@JsonFormat(pattern = "dd/MM/yyyy")
	@NotNull(message = "Open Date cannot be null")
	private Date openDate;

	/**
	 * The date the branch was closed (if applicable). Formatted as "dd/MM/yyyy" in
	 * JSON.
	 */
	@JsonFormat(pattern = "dd/MM/yyyy")
	private Date closeDate;

	/**
	 * The date the branch was merged (if applicable). Formatted as "dd/MM/yyyy" in
	 * JSON.
	 */
	@JsonFormat(pattern = "dd/MM/yyyy")
	private Date mergeDate;

	/**
	 * The code of the branch this branch was merged with (if applicable). Must be
	 * exactly 5 characters in length if provided.
	 */
	@Size(min = 5, max = 5, message = "Merged with Branch length must be 5")
	private String mergedWithBranch;

	/**
	 * The date of the last change or update to branch information. Formatted as
	 * "dd/MM/yyyy" in JSON.
	 */
	@JsonFormat(pattern = "dd/MM/yyyy")
	private Date lastChangeDate;

	/**
	 * Flag indicating Central Processing Centre status. Must not be null.
	 */
	@NotNull(message = "CPC Flag cannot be null")
	private Boolean cpcFlag;

	/**
	 * Flag indicating eligibility for food credits. Must not be null.
	 */
	@NotNull(message = "Food Credit Flag cannot be null")
	private Boolean foodCreditFlag;

	/**
	 * Flag indicating Currency Chest functionality. Must not be null.
	 */
	@NotNull(message = "Curr Chest Flag cannot be null")
	private Boolean currChestFlag;

	/**
	 * The type of branch. Must not be null, must be exactly 1 character, and can
	 * only be 'A' or 'M'.
	 */
	@NotNull(message = "Branch Type cannot be null")
	@Size(min = 1, max = 1, message = "Blength must be 1")
	@Pattern(regexp = "[AM]", message = "Branch Type can only be A or M")
	private String branchType;

	/**
	 * Retrieves the unique key for this payload, which is the branch code. This
