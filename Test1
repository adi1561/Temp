# ==========================================
# 1. KAFKA BROKER CONNECTION (Mandatory)
# ==========================================
# Replace localhost:9092 with the actual IP address provided by your DevOps/Airflow team
spring.kafka.bootstrap-servers=localhost:9092

# ==========================================
# 2. PRODUCER SERIALIZATION (Mandatory)
# ==========================================
# This tells Spring Boot how to convert your Java Strings into network bytes
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.apache.kafka.common.serialization.StringSerializer

# ==========================================
# 3. PRODUCER RELIABILITY (Recommended for Banking/Finance)
# ==========================================
# 'all' means the producer will wait for all Kafka replicas to acknowledge the message.
# This guarantees no LHO Transfer events are lost if a broker crashes.
spring.kafka.producer.acks=all
# How many times to retry sending if there is a network blip
spring.kafka.producer.retries=3

# ==========================================
# 4. CUSTOM TOPIC CONFIGURATION
# ==========================================
# The topic your publisher will send the LHO Transfer event to
app.kafka.topics.lho-transfer=lho-airflow-topic
