import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Stack,
  Typography,
} from "@mui/material";
import { useState, useEffect, useCallback } from "react";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const REMARKS_REGEX = /^(?!.* {2})[a-zA-Z0-9\s/&(),.-]*$/;

const ActionConfirmDialog = ({
  open,
  actionType,
  processName = "",
  onConfirm,
  onClose,
}) => {
  const [remarks, setRemarks] = useState("");
  const showSnackBar = useCustomSnackbar();

  useEffect(() => {
    if (open) setRemarks("");
  }, [open]);

  const titleMap = {
    start: "Start Process",
    stop: "Stop Process",
    restart: "Restart Process",
    finishEod: "Finish EOD",
    accept: "Accept Summary",
    reject: "Reject Summary",
  };

  const handleRemarksChange = useCallback(
    (e) => {
      const value = e.target.value;
      if (value && !/^[A-Za-z0-9]$/.test(value[0])) {
        showSnackBar("Should not start with special character", "error");
        return;
      }

      if (value && !/^[A-Za-z0-9]$/.test(value[0])) {
        showSnackBar("Should not start with special character", "error");
        return;
      }

      const error = REMARKS_REGEX.test(value)
        ? ""
        : "Invalid Format, Only alphabets, numbers, spaces(single spaces only between words) and ,()&/-. are allowed!";
      if (error) {
        showSnackBar(error, "warning");
        return;
      }

      setRemarks(value);
    },
    [showSnackBar],
  );

  const handleConfirmClick = () => {
    // 1. Validation logic for rejection
    if (remarks.trim().length < 5) {
      showSnackBar(
        "Please provide minimum 5 characters remarks before rejecting",
        "warning",
      );
      return;
    }

    // 2. Execute confirmation if validation passes
    onConfirm(remarks);
  };

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle>
        <b>{titleMap[actionType]}</b>
      </DialogTitle>

      <DialogContent dividers>
        <Stack spacing={2}>
          <Typography>
            Are you sure you want to {titleMap[actionType]}
            {processName && (
              <>
                {" "}
                for <b>{processName}</b>
              </>
            )}
            ?
          </Typography>

          <TextField
            label="Remarks *"
            placeholder="Enter remarks"
            multiline
            rows={4}
            value={remarks}
            fullWidth
            required
            onChange={handleRemarksChange}
            margin="dense"
            slotProps={{
              htmlInput: {
                maxLength: 200,
              },
            }}
            helperText={
              remarks?.length !== 0 && remarks?.length < 5
                ? "Enter at least 5 characters"
                : "Allowed 5-200 characters (alphabets, numbers, spaces,()&,/-.)"
            }
            error={remarks?.length !== 0 && remarks?.length < 5}
          />
        </Stack>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>

        <Button
          variant="contained"
          disabled={!remarks.trim() || remarks.trim().length < 5}
          onClick={handleConfirmClick}
        >
          Confirm
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ActionConfirmDialog;



import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Box,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";

import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

/* ------------------ INITIAL STEP RESOLVER ------------------ */
const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex(
    (s) => s.stageStatus === StageStatus.STARTED,
  );
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.stageStatus === StageStatus.ERROR);
  if (error !== -1) return error;

  const completed = stages
    .map((s, i) => (s.stageStatus === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  return completed.length ? completed[completed.length - 1] : 0;
};

/* ------------------ MAIN DIALOG ------------------ */
const ProcessDetailsDialog = ({
  process,
  isCurrentDate,
  onClose,
  onStart,
  onStop,
  permissions = {},
}) => {
  const stages = useMemo(() => process?.stages || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    setActiveStep(resolveInitialActiveStep(stages));
  }, [stages]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.stageStatus;

  return (
    <Dialog
      open={!!process}
      onClose={onClose}
      fullWidth
      maxWidth="lg"
      PaperProps={{
        sx: { height: "74vh" },
      }}
    >
      {/* ---------- HEADER ---------- */}
      <DialogTitle sx={{ pr: 6 }}>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      {/* ---------- BODY ---------- */}
      <DialogContent
        dividers
        sx={{
          p: 0,
          display: "grid",
          gridTemplateColumns: "280px 1fr",
          height: "100%",
        }}
      >
        {/* LEFT – SCROLLABLE STEPPER */}
        <Box
          sx={{
            borderRight: "1px solid",
            borderColor: "divider",
            overflowY: "auto",
            px: 2,
            py: 1,
          }}
        >
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />
        </Box>

        {/* RIGHT – FIXED CONTENT */}
        <Box sx={{ p: 3 }}>
          <StageDetails stage={stages[activeStep]} />
        </Box>
      </DialogContent>

      {/* ---------- FOOTER ---------- */}
      {isCurrentDate && (permissions.start || permissions.stop) && (
        <DialogActions>
          {permissions.start && lastStatus !== StageStatus.STARTED && (
            <Button
              startIcon={<RestartAltIcon />}
              onClick={() => onStart(process)}
            >
              Restart
            </Button>
          )}

          {permissions.stop && lastStatus === StageStatus.STARTED && (
            <Button
              color="error"
              startIcon={<StopIcon />}
              onClick={() => onStop(process)}
            >
              Stop
            </Button>
          )}
        </DialogActions>
      )}
    </Dialog>
  );
};

export default ProcessDetailsDialog;


import React, { useMemo, forwardRef } from "react";
import {
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
} from "@mui/material";
import { TABLE_CONFIG } from "../util/ProcessSummaryTableConfig";

/* ================= FORMAT ================= */

const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : num || "—";

/* ================= COMPONENT ================= */

const DynamicSummaryTable = forwardRef(
  ({ summaryType = "BALANCE", data }, ref) => {
    /* ================= USE DEFAULT DATA IF EMPTY ================= */

    const safeData = useMemo(() => {
      if (!data || data.length === 0) {
        return [];
      }
      return data;
    }, [data]);

    /* ================= GET CONFIG ================= */

    const config = useMemo(() => {
      return (
        TABLE_CONFIG[summaryType] || {
          columns: [],
          totalFields: [],
        }
      );
    }, [summaryType]); // Only re-calculates if summaryType changes

    /* ================= TOTAL CALCULATION ================= */

    const totals = useMemo(() => {
      const result = {};

      config?.totalFields.forEach((field) => {
        result[field] = safeData.reduce(
          (sum, row) => sum + (Number(row[field]) || 0),
          0,
        );
      });

      return result;
    }, [safeData, config]);

    /* ================= EMPTY CHECK ================= */

    if (!config?.columns) {
      return (
        <Box p={2}>
          <Typography color="text.secondary">
            No table configuration found
          </Typography>
        </Box>
      );
    }

    /* ================= RENDER ================= */

    return (
      <TableContainer component={Paper} ref={ref}>
        <Table size="small">
          {/* HEADER */}

          <TableHead>
            <TableRow>
              {config?.columns.map((col) => (
                <TableCell
                  key={col.field}
                  align={col.align}
                  sx={{ fontWeight: 700 }}
                >
                  {col.label}
                </TableCell>
              ))}
            </TableRow>
          </TableHead>

          {/* BODY */}

          <TableBody>
            {safeData.map((row, index) => (
              <TableRow key={index}>
                {config?.columns.map((col) => (
                  <TableCell key={col.field} align={col.align}>
                    {col.align === "right"
                      ? formatAmount(row[col.field])
                      : row[col.field] || "—"}
                    {/* {row[col.field] || "—"} */}
                  </TableCell>
                ))}
              </TableRow>
            ))}

            {/* TOTAL ROW */}

            {config?.totalFields.length > 0 && (
              <TableRow sx={{ bgcolor: "#f5f5f5" }}>
                {config?.columns.map((col, index) => {
                  if (index === 0)
                    return (
                      <TableCell key={col.field}>
                        <b>TOTAL</b>
                      </TableCell>
                    );

                  if (totals[col.field] !== undefined)
                    return (
                      <TableCell key={col.field} align="right">
                        <b>{formatAmount(totals[col.field])}</b>
                      </TableCell>
                    );

                  return <TableCell key={col.field} />;
                })}
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>
    );
  },
);

export default DynamicSummaryTable;



