package com.tcs.fincore.CommonRequestService.service.strategy;

// 1. Corrected Import
import org.springframework.kafka.support.SendResult; 

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.kafka.core.KafkaTemplate;

import java.util.concurrent.CompletableFuture;

@Slf4j
@Service
@RequiredArgsConstructor
public class KafkaEventPublisherService {

    private final KafkaTemplate<String, String> kafkaTemplate;

    @Value("${app.kafka.topics.lho-transfer}")
    private String lhoTopic;

    /**
     * Triggers an event to the configured Kafka topic.
     * @param targetId The unique identifier (used as the Kafka Key for ordered processing)
     * @param payload  The actual JSON string or data to send
     */
    public void publishLhoTransferEvent(String targetId, String payload) {
        log.info("Attempting to publish LHO Transfer event for targetId: {} to topic: {}", targetId, lhoTopic);

        CompletableFuture<SendResult<String, String>> future = kafkaTemplate.send(lhoTopic, targetId, payload);

        // Async callback to handle success or failure without blocking the main thread
        future.whenComplete((result, exception) -> {
            if (exception != null) {
                log.error("Failed to send Kafka event for targetId: {}. Reason: {}", targetId, exception.getMessage());
            } else {
                log.info("Successfully published Kafka event. Topic: {}, Partition: {}, Offset: {}",
                        result.getRecordMetadata().topic(),
                        result.getRecordMetadata().partition(),
                        result.getRecordMetadata().offset());
            }
        });
    }
}
