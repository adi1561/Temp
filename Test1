package com.tcs.fincore.AsciiGenerationService.Controller;

import com.tcs.fincore.AsciiGenerationService.Service.YsaGenerationService;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api") // This is the base URL
public class YsaController {

    private final YsaGenerationService ysaService;

    public YsaController(YsaGenerationService ysaService) {
        this.ysaService = ysaService;
    }

    // method = GET so you can easily hit it from a Browser
    @GetMapping("/generate-ysa") 
    public ResponseEntity<String> triggerGeneration() {
        try {
            System.out.println("Received request to generate YSA report...");
            
            // 1. Call the service
            String outputFilePath = ysaService.processYsaReport();
            
            // 2. Return success message
            return ResponseEntity.ok("SUCCESS: File generated at " + outputFilePath);
            
        } catch (Exception e) {
            e.printStackTrace();
            return ResponseEntity.internalServerError().body("FAILED: " + e.getMessage());
        }
    }
}
