## Real World Example - User Session

```java
@Service
public class SessionService {

    @Autowired
    private RedisTemplate<String, Object> redisTemplate;

    // Store session when user logs in
    public void createSession(String sessionId, User user) {

        HashOperations<String, String, Object> ops =
                        redisTemplate.opsForHash();

        String key = "session:" + sessionId;

        ops.put(key, "userId",   user.getId());
        ops.put(key, "username", user.getName());
        ops.put(key, "role",     user.getRole());

        // Session expires in 30 min
        redisTemplate.expire(key, Duration.ofMinutes(30));
    }

    // Get session on each request
    public Map<String, Object> getSession(String sessionId) {
        HashOperations<String, String, Object> ops =
                        redisTemplate.opsForHash();

        return ops.entries("session:" + sessionId);
    }

    // Extend session on activity
    public void extendSession(String sessionId) {
        redisTemplate.expire("session:" + sessionId,
                             Duration.ofMinutes(30));
    }

    // Delete session on logout
    public void deleteSession(String sessionId) {
        redisTemplate.delete("session:" + sessionId);
    }
}
```

