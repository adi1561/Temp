package com.fincore.ReportService.dto;

import jakarta.validation.constraints.NotNull;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDate;

@Data
@NoArgsConstructor
@AllArgsConstructor
public class DifferenceSearchDto {
    @NotNull(message = "From Date is required")
    private LocalDate fromDate;
    private LocalDate toDate;
    private String branchCode;
    private String currency;
    private String cgl;

    public LocalDate getEffectiveToDate() {
        return (toDate == null) ? fromDate : toDate;
    }
}

2. The Mapper (Single Responsibility)
Instead of writing new DTO(...) inside a SQL query (which couples the DB layer to the View layer), we use a Mapper.
DifferenceMapper.java
package com.fincore.ReportService.mapper;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.model.Difference;
import org.springframework.stereotype.Component;

@Component
public class DifferenceMapper {

    public DifferenceDTO toDto(Difference entity) {
        if (entity == null) {
            return null;
        }
        return DifferenceDTO.builder()
                .reconRunDate(entity.getReconRunDate())
                .branchCode(entity.getBranchCode())
                .currency(entity.getCurrency())
                .cgl(entity.getCgl())
                .cbsBalance(entity.getCbsBalance())
                .glBalance(entity.getGlBalance())
                .differenceAmount(entity.getDifferenceAmount())
                .diffBwYesterday(entity.getDiffBwYesterday())
                .type(entity.getType())
                .head(entity.getHead())
                .firstErrorDate(entity.getFIRST_ERROR_DATE())
                .build();
    }
}

3. Repository & Specification (Open/Closed Principle)
We remove the complex @Query string. We use JpaSpecificationExecutor to build dynamic queries programmatically.
DifferenceRepository.java
package com.fincore.ReportService.repository;

import com.fincore.ReportService.model.Difference;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.JpaSpecificationExecutor;
import org.springframework.stereotype.Repository;

@Repository
public interface DifferenceRepository extends JpaRepository<Difference, Long>, JpaSpecificationExecutor<Difference> {
    // No manual @Query needed. 
    // JpaSpecificationExecutor provides findAll(Specification, Pageable)
}

DifferenceSpecifications.java
This class encapsulates the query logic. If you need to add a filter, you add it here, keeping the Service clean.
package com.fincore.ReportService.repository.spec;

import com.fincore.ReportService.dto.DifferenceSearchDto;
import com.fincore.ReportService.model.Difference;
import io.micrometer.common.util.StringUtils;
import org.springframework.data.jpa.domain.Specification;
import jakarta.persistence.criteria.Predicate;
import java.util.ArrayList;
import java.util.List;

public class DifferenceSpecifications {

    public static Specification<Difference> withDynamicSearch(DifferenceSearchDto criteria) {
        return (root, query, cb) -> {
            List<Predicate> predicates = new ArrayList<>();

            // Date Range (Mandatory based on logic)
            if (criteria.getFromDate() != null) {
                predicates.add(cb.between(
                        root.get("reconRunDate"), 
                        criteria.getFromDate(), 
                        criteria.getEffectiveToDate()
                ));
            }

            // Optional Filters
            if (StringUtils.isNotBlank(criteria.getBranchCode())) {
                predicates.add(cb.equal(root.get("branchCode"), criteria.getBranchCode()));
            }
            if (StringUtils.isNotBlank(criteria.getCurrency())) {
                predicates.add(cb.equal(root.get("currency"), criteria.getCurrency()));
            }
            if (StringUtils.isNotBlank(criteria.getCgl())) {
                predicates.add(cb.equal(root.get("cgl"), criteria.getCgl()));
            }

            return cb.and(predicates.toArray(new Predicate[0]));
        };
    }
}

4. Service Interface & Implementation (Dependency Inversion)
IDifferenceService.java
package com.fincore.ReportService.service;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.dto.DifferenceSearchDto;
import org.springframework.data.domain.Page;

public interface IDifferenceService {
    Page<DifferenceDTO> getAllDifferences(int page, int size);
    Page<DifferenceDTO> searchDifferences(DifferenceSearchDto criteria, int page, int size);
}

DifferenceServiceImpl.java
package com.fincore.ReportService.service.impl;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.dto.DifferenceSearchDto;
import com.fincore.ReportService.mapper.DifferenceMapper;
import com.fincore.ReportService.model.Difference;
import com.fincore.ReportService.repository.DifferenceRepository;
import com.fincore.ReportService.repository.spec.DifferenceSpecifications;
import com.fincore.ReportService.service.IDifferenceService;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor // Generates constructor for final fields (Constructor Injection)
public class DifferenceServiceImpl implements IDifferenceService {

    private final DifferenceRepository repository;
    private final DifferenceMapper mapper;

    @Override
    @Transactional(readOnly = true)
    public Page<DifferenceDTO> getAllDifferences(int page, int size) {
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("id"));
        Page<Difference> entities = repository.findAll(pageRequest);
        
        // Convert Entity Page -> DTO Page
        return entities.map(mapper::toDto);
    }

    @Override
    @Transactional(readOnly = true)
    public Page<DifferenceDTO> searchDifferences(DifferenceSearchDto criteria, int page, int size) {
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("id"));

        // Use Specification to fetch Entities
        Page<Difference> entities = repository.findAll(
                DifferenceSpecifications.withDynamicSearch(criteria), 
                pageRequest
        );

        // Convert Entity Page -> DTO Page
        return entities.map(mapper::toDto);
    }
}

5. Controller (Clean & Decoupled)
The controller now relies on the interface and performs simple validation delegation.
DifferenceController.java
package com.fincore.ReportService.controller;

import com.fincore.ReportService.dto.DifferenceDTO;
import com.fincore.ReportService.dto.DifferenceSearchDto;
import com.fincore.ReportService.service.IDifferenceService;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/differences")
@RequiredArgsConstructor // Constructor Injection (Better than @Autowired field injection)
public class DifferenceController {

    private final IDifferenceService service;

    @GetMapping
    public ResponseEntity<Page<DifferenceDTO>> getDifferences(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size
    ) {
        return ResponseEntity.ok(service.getAllDifferences(page, size));
    }

    @PostMapping("/search")
    public ResponseEntity<Page<DifferenceDTO>> searchDifferences(
            @Valid @RequestBody DifferenceSearchDto criteria,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "100") int size
    ) {
        Page<DifferenceDTO> result = service.searchDifferences(criteria, page, size);

        if (result.isEmpty()) {
            return ResponseEntity.noContent().build();
        }
        return ResponseEntity.ok(result);
    }
}

Why this is better:
 * Readability: The Service class is no longer cluttered with logic about checking if strings are empty or null. That moved to DifferenceSpecifications.
 * Maintainability: If you change the database table structure, you only update the Mapper and Entity. You don't have to hunt down specific JPQL strings in the repository.
 * Testability: You can now unit test the Mapper in isolation, the Specification logic in isolation, and the Service flow using mocks effortlessly.
