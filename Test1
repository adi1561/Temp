**Replace that specific execution section with this resilient version:**
```java
        // ... (existing cache checks) ...

        String lockKey = "LOCK_REQ_" + requestId;
        Boolean acquired = redisTemplate.opsForValue().setIfAbsent(lockKey, "LOCKED", 60, TimeUnit.MINUTES);
        
        if (Boolean.FALSE.equals(acquired)) {
            log.warn("BATCH_LOCK_REJECTED | RequestId: {} is already processing.", requestId);
            throw new CustomExceptions.DuplicateRequestException("This batch is currently being processed.");
        }

        try {
            // Attempt to hand off to the asynchronous background worker
            executeAsyncBatchCreation(batchId, requestId, requestDto.getCommonBatchRemarks(), creatorId, creatorRole);
        } catch (org.springframework.core.task.TaskRejectedException e) {
            // FIX: If the thread pool is completely full, release the lock immediately!
            redisTemplate.delete(lockKey);
            log.error("SYSTEM_OVERLOAD | Batch: {} | Status: Thread pool rejected the task. Lock released.", batchId);
            throw new CustomExceptions.BatchProcessingException("System is currently under heavy load. Please try submitting your batch again in a few minutes.");
        } catch (Exception e) {
            // Failsafe for any other unexpected synchronous errors during submission
            redisTemplate.delete(lockKey);
            log.error("SYSTEM_FAULT | Batch: {} | Status: Unexpected error before async execution. Lock released.", batchId);
            throw new CustomExceptions.BatchProcessingException("An internal error occurred while starting the batch.");
        }

        // ... return response ...

```
