            updateState(requestId, s -> {
                s.setTotalRows(parsingResult.rows.size());
                s.setMessage("Executing Format Validation...");
            });

            runFormatCheck(parsingResult.rows);
            if (parsingResult.rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsingResult.rows, "Structural Validation Failed", 1, parsingResult.hasProductColumn);
                return;
            }

            updateState(requestId, s -> {
                s.setCurrentStage(2);
                s.setMessage("Verifying Master Data References...");
            });

            runDbCheck(parsingResult.rows);
            if (parsingResult.rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsingResult.rows, "Referential Integrity Failed", 2, parsingResult.hasProductColumn);
