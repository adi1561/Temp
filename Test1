  // --- UPDATED LOGIC ---
  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      const selected = e.target.files[0];
      const fileName = selected.name.toLowerCase();

      // 1. Define allowed extensions
      const allowedExtensions = [".xlsx", ".xls", ".csv", ".txt"];

      // 2. Check if the file ends with one of the allowed extensions
      const isValid = allowedExtensions.some((ext) => fileName.endsWith(ext));

      if (!isValid) {
        // 3. Show Snackbar Error
        showSnackBar(
          "Invalid file type! Only .xlsx, .csv, and .txt files are allowed.",
          "error"
        );
        
        // 4. Clear the input value so the same file can be selected again if needed (triggers change)
        if (fileInputRef.current) {
          fileInputRef.current.value = "";
        }
        
        // 5. STOP execution. Do not setFile, do not reset status.
        return; 
      }

      // --- EXISTING SUCCESS LOGIC ---
      setFile(selected);
      setIsCsvFile(
        fileName.endsWith(".csv") || fileName.endsWith(".txt")
      );
      setResultStatus(null);
      setResultMsg("");
      setValidationStage(0);
      setPreviewRows([]);
      setAutoDlTriggered(false);
      setIsProcessing(false);
      setDownloadMsg("Downloading Error Report...");
    }
  };
