            }

            updateState(requestId, s -> {
                s.setCurrentStage(3);
                s.setMessage("Checking Debit/Credit Balances...");
            });

            runBalanceCheck(parsingResult.rows);
            if (parsingResult.rows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsingResult.rows, "Accounting Balance Mismatch", 3, parsingResult.hasProductColumn);
                return;
