SELECT
    GT.BRANCH_CODE,
    GT.CURRENCY,
    GT.CGL,

    SUM(GT.DEBIT_AMOUNT + GT.CREDIT_AMOUNT) AS BALANCE,

    BM.NAME AS BRANCH_NAME

FROM GL_TRANSACTIONS GT

LEFT JOIN BRANCH_MASTER BM
    ON GT.BRANCH_CODE = BM.CODE

WHERE TRUNC(GT.TRANSACTION_DATE) =
      TO_DATE('21-11-25','DD-MM-RR')

  AND GT.CGL IN ('1106505001', '1106505002')

GROUP BY
    GT.BRANCH_CODE,
    GT.CURRENCY,
    GT.CGL,
    BM.NAME

ORDER BY
    GT.CGL,
    GT.CURRENCY,
    GT.BRANCH_CODE;