    private List<ProcessingItem> extractAmountColumns(String[] cols, AsciiConfig config) {
        List<ProcessingItem> items = new ArrayList<>();
        String head = cols[config.getInputHeadCol() - 1].trim();
        String seq = config.getAmountColSeq(); // e.g., "3else4"

        // --- NEW LOGIC: "else" skips Zero, Null, and Empty ---
        if (seq.contains("else")) {
            String[] parts = seq.split("else");
            
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                
                // 1. Safe Parse: Handles Null, Empty, Spaces, "0", "0.00" -> Returns BigDecimal
                BigDecimal val = parseAmount(cols, idx);

                // 2. CHECK: Is this value NON-ZERO?
                if (val.compareTo(BigDecimal.ZERO) != 0) {
                    // Found a "Real" number! Take it and stop looking.
                    items.add(new ProcessingItem(head, val, idx + 1));
                    return items; 
                }
            }
            
            // 3. Fallback: If loop finishes and everything was 0/Null, return 0 from the FIRST column in the list.
            int firstColIdx = Integer.parseInt(parts[0].trim()) - 1;
            items.add(new ProcessingItem(head, BigDecimal.ZERO, firstColIdx + 1));
        } 
        
        // --- Standard Logic (AND / Single Column) ---
        else if (seq.contains("and")) {
            String[] parts = seq.split("and");
            for (String part : parts) {
                int idx = Integer.parseInt(part.trim()) - 1;
                items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
            }
        } else {
            int idx = Integer.parseInt(seq.trim()) - 1;
            items.add(new ProcessingItem(head, parseAmount(cols, idx), idx + 1));
        }
        return items;
    }
