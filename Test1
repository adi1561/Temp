package org.apache.hadoop.io.nativeio; // <--- THIS PACKAGE IS CRITICAL

import java.io.File;
import java.io.FileDescriptor;
import java.io.IOException;

/**
 * PATCH for Windows: Bypasses the need for hadoop.dll
 */
public class NativeIO {
    public static class POSIX {
        public static void chmod(String path, int mode) throws IOException {}
    }

    public static class Windows {
        // This method causes the crash. We override it to always return true.
        public static boolean access0(String path, int requestedAccess) {
            return true; 
        }

        public static void extend(FileDescriptor fd, long off) throws IOException {}
        public static String getOwner(FileDescriptor fd) throws IOException { return "User"; }
    }

    // --- Core Logic ---
    private static boolean nativeLoaded = false;

    static {
        // Prevent loading the real native library
        nativeLoaded = true;
    }

    public static boolean isAvailable() {
        return nativeLoaded;
    }

    public static boolean access(String path, AccessRight desiredAccess) throws IOException {
        return true; // Bypass permission checks
    }

    public static void copyFileUnbuffered(File src, File dst) throws IOException {
        java.nio.file.Files.copy(src.toPath(), dst.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
    }

    public static void chmod(String filename, int mode) throws IOException {}

    public enum AccessRight {
        ACCESS_READ, ACCESS_WRITE, ACCESS_EXECUTE;
        public int accessRight() { return 0; }
    }
}
