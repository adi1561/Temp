package com.fincore.ReportService.service;


import com.fincore.ReportService.config.NwsaProperties;
import com.fincore.ReportService.domain.BankVariance;
import com.fincore.ReportService.domain.BranchVariance;
import com.fincore.ReportService.domain.NwsaRow;
import com.fincore.ReportService.domain.VarianceReport;
import com.fincore.ReportService.hdfs.FileSystemClient;
import com.fincore.ReportService.parser.PsvParser;
import com.fincore.ReportService.util.BranchMetadataReader;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.io.InputStream;
import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

@Service
public class VarianceComputationService {

    private static final BigDecimal CRORE_MULTIPLIER = new BigDecimal("10000000");

    private final NwsaProperties props;
    private final FileSystemClient fs;
    private final PsvParser parser;
    private final BranchMetadataReader branchMetadataReader;

    public VarianceComputationService(NwsaProperties props,
                                      FileSystemClient fs,
                                      PsvParser parser,
                                      BranchMetadataReader branchMetadataReader) {
        this.props = props;
        this.fs = fs;
        this.parser = parser;
        this.branchMetadataReader = branchMetadataReader;
    }

    public VarianceReport generate(LocalDate today, LocalDate yesterday) throws IOException {
        Map<String, NwsaRow> todayBank = readBankRows(today);
        Map<String, NwsaRow> yesterdayBank = readBankRows(yesterday);

        BigDecimal threshold = props.failedThresholdCrore().multiply(CRORE_MULTIPLIER);
        List<BankVariance> failedHeads = new ArrayList<>();

        Set<String> union = new HashSet<>(todayBank.keySet());
        union.addAll(yesterdayBank.keySet());

        for (String head : union) {
            NwsaRow t = todayBank.get(head);
            NwsaRow y = yesterdayBank.get(head);
            BigDecimal tAmt = t != null ? t.innerAmount() : BigDecimal.ZERO;
            BigDecimal yAmt = y != null ? y.innerAmount() : BigDecimal.ZERO;
            BigDecimal diff = tAmt.subtract(yAmt).abs();
            if (diff.compareTo(threshold) > 0) {
                String desc = t != null ? t.description() : (y != null ? y.description() : "");
                failedHeads.add(new BankVariance(head, desc, tAmt, yAmt, diff));
            }
        }

        failedHeads.sort(Comparator.comparing(BankVariance::difference).reversed());
        Map<String, List<BranchVariance>> branchDetails = computeBranchDetails(today, yesterday, failedHeads);
        return new VarianceReport(today, yesterday, failedHeads, branchDetails);
    }

    private Map<String, NwsaRow> readBankRows(LocalDate date) throws IOException {
        String path = bankPath(date);
        Map<String, NwsaRow> rows = new HashMap<>(4096);
        try (InputStream in = fs.open(path)) {
            parser.streamRows(in, row -> rows.put(row.headCode(), row));
        }
        return rows;
    }

    private Map<String, List<BranchVariance>> computeBranchDetails(
            LocalDate today,
            LocalDate yesterday,
            List<BankVariance> failedHeads
    ) throws IOException {
        Set<String> failed = failedHeads.stream().map(BankVariance::headCode).collect(java.util.stream.Collectors.toSet());
        Map<String, List<BranchVariance>> result = new LinkedHashMap<>();
        failedHeads.forEach(fh -> result.put(fh.headCode(), new ArrayList<>()));

        String todayDir = branchRoot(today);
        List<String> branches = fs.listDirectories(todayDir).sorted().toList();

        for (String branchCode : branches) {
            String todayPath = branchPath(today, branchCode);
            String yesterdayPath = branchPath(yesterday, branchCode);
            if (!fs.exists(todayPath) || !fs.exists(yesterdayPath)) {
                continue;
            }

            Map<String, NwsaRow> todayRows = readFiltered(todayPath, failed);
            Map<String, NwsaRow> yesterdayRows = readFiltered(yesterdayPath, failed);
            String branchName = branchMetadataReader.readBranchName(todayPath, branchCode);

            for (String head : failed) {
                NwsaRow t = todayRows.get(head);
                NwsaRow y = yesterdayRows.get(head);
                BigDecimal tAmt = t != null ? t.innerAmount() : BigDecimal.ZERO;
                BigDecimal yAmt = y != null ? y.innerAmount() : BigDecimal.ZERO;
                BigDecimal diff = tAmt.subtract(yAmt).abs();
                result.get(head).add(new BranchVariance(branchCode, branchName, head, tAmt, yAmt, diff));
            }
        }

        result.values().forEach(list -> list.sort(Comparator.comparing(BranchVariance::difference).reversed()));
        return result;
    }

    private Map<String, NwsaRow> readFiltered(String path, Set<String> failedHeads) throws IOException {
        Map<String, NwsaRow> rows = new HashMap<>();
        try (InputStream in = fs.open(path)) {
            parser.streamRows(in, row -> {
                if (failedHeads.contains(row.headCode())) {
                    rows.put(row.headCode(), row);
                }
            });
        }
        return rows;
    }

    private String bankPath(LocalDate date) {
        String dateToken = date.format(props.formatter());
        return "%s/%s/nwsa_report/%s".formatted(
                props.reportRoot(),
                dateToken,
                props.bankFilenamePattern().replace("{date}", dateToken));
    }

    private String branchRoot(LocalDate date) {
        return "%s/%s/nwsa_report".formatted(props.reportRoot(), date.format(props.formatter()));
    }

    private String branchPath(LocalDate date, String branchCode) {
        String dateToken = date.format(props.formatter());
        return "%s/%s/nwsa_report/%s/%s".formatted(
                props.reportRoot(),
                dateToken,
                branchCode,
                props.branchFilenamePattern().replace("{branchCode}", branchCode).replace("{date}", dateToken));
    }
}

package com.fincore.ReportService.util;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

import com.fincore.ReportService.hdfs.FileSystemClient;
import org.springframework.stereotype.Component;

@Component
public class BranchMetadataReader {

    private final FileSystemClient fs;

    public BranchMetadataReader(FileSystemClient fs) {
        this.fs = fs;
    }

    public String readBranchName(String filePath, String defaultCode) {
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(fs.open(filePath), StandardCharsets.UTF_8))) {
            for (int i = 0; i < 30; i++) {
                String line = reader.readLine();
                if (line == null) {
                    break;
                }
                String normalized = line.trim();
                if (normalized.startsWith("BRANCH ::")) {
                    int idx = normalized.indexOf('-');
                    if (idx > -1 && idx + 1 < normalized.length()) {
                        return normalized.substring(idx + 1).trim();
                    }
                }
            }
        } catch (IOException ignored) {
        }
        return defaultCode;
    }
}


