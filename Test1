UPDATE ASCII_CONFIG 
SET 
    -- 1. DECIMAL LOGIC:
    -- First: Apply [ceil] (Math logic).
    -- Next: Apply [2] decimals to EVERYTHING (Default for A/L).
    -- Finally: If Head is S or NXY, force [0] decimals (Override to remove .00).
    OUTPUT_AMT_DECIMAL = '["^S\d{1,3}$|^NXY\d{2}$"][3][ceil]|["^.*"][3][2]|["^S\d{1,3}$|^NXY\d{2}$"][3][0]',

    -- 2. PADDING LOGIC:
    -- First: Format EVERYTHING to 19 chars with 2 decimals (Default).
    -- Finally: If Head is S or NXY, re-format to 19 chars with 0 decimals (Override).
    -- NOTICE THE [19,0] HERE!
    OUTPUT_AMT_COL_PAD = '["^.*"][3][19,2]|["^S\d{1,3}$|^NXY\d{2}$"][3][19,0]'

WHERE ID = 101;

COMMIT;
