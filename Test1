SELECT
    CM.CIRCLE_NAME,
    T1.BRANCH_CODE,
    T1.CURRENCY,
    T1.CGL,
    T1.BALANCE AS TODAY_BALANCE,
    T2.BALANCE AS YESTERDAY_BALANCE,
    (T1.BALANCE - COALESCE(T2.BALANCE, 0)) AS DIFFERENCE,
    BM.NAME AS BRANCH_NAME
FROM
    GL_BALANCE T1
JOIN
    BRANCH_MASTER BM ON T1.BRANCH_CODE = BM.CODE
LEFT JOIN
    CIRCLE_MASTER CM ON BM.CIRCLE_CODE = CM.CIRCLE_CODE
LEFT JOIN
    GL_BALANCE T2 ON T1.BRANCH_CODE = T2.BRANCH_CODE 
    AND T1.CURRENCY = T2.CURRENCY 
    AND T1.CGL = T2.CGL
    AND T2.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') - 1
WHERE
    T1.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') 
    AND T1.CGL IN (
        '1111111111',
        '1111111112',
        '1260505001',
        '2148505001',
        '1260505003',
        '1148505004',
        '1148505005',
        '1148505006',
        '1148505007',
        '1148505010',
        '1148505012',
        '1148505014',
        '1148505020',
        '2148505004',
        '2148505006',
        '2148505007',
        '2148505010',
        '2148505011',
        '2148505014',
        '2148505016',
        '2148505018',
        '2148505019',
        '2148505021',
        '2148505022',
        '2148505024',
        '2148505033',
        '2148505035',
        '1260505002'
    )
ORDER BY
    CM.CIRCLE_NAME, -- Added sorting by Circle Name first for better report grouping
    T1.CGL, 
    T1.BRANCH_CODE,
    T1.CURRENCY
