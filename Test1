    @Override
    @Transactional
    public Object createBatch(JournalBatchRequestDto requestDto) {
        
        List<JournalEntity> entitiesToSave = new ArrayList<>();
        String batchId = generateBatchId(); // Your existing batch ID logic

        // Loop through the validated DTO
        for (JournalRowDto rowDto : requestDto.getRows()) {
            JournalEntity entity = new JournalEntity(); // Your database entity
            
            // Map the simple strings
            entity.setBatchId(batchId);
            entity.setBranchCode(rowDto.getBranch());
            entity.setCurrency(rowDto.getCurrency());
            entity.setCgl(rowDto.getCgl());
            entity.setProductCode(rowDto.getProductType());
            entity.setRemarks(rowDto.getRemarks());
            entity.setArFlag(rowDto.getArFlag());
            
            // CRITICAL STEP: Convert the clean String from React into a Database BigDecimal
            entity.setAmount(new BigDecimal(rowDto.getAmount())); 
            
            entitiesToSave.add(entity);
        }

        // Save to Oracle
        journalRepository.saveAll(entitiesToSave);

