    // --- CHANGED: Added String runId to parameters ---
    public void publishLhoTransferEvent(String targetId, Long requestId, String runId, Object payload) {
        log.info("Attempting to publish LHO Transfer event for targetId: {} to topic: {}", targetId, lhoTopic);

        // 1. Create a ProducerRecord using the Object payload
        ProducerRecord<String, Object> record = new ProducerRecord<>(lhoTopic, targetId, payload);

        // 2. Add your custom header to the record (using StandardCharsets to be safe)
        record.headers().add("requestId", String.valueOf(requestId).getBytes(java.nio.charset.StandardCharsets.UTF_8));
        
        // --- ADDED: Attach runId to headers for traceability ---
        if (runId != null) {
            record.headers().add("runId", runId.getBytes(java.nio.charset.StandardCharsets.UTF_8));
        }

        // 3. Send it once
        CompletableFuture<SendResult<String, Object>> future = kafkaTemplate.send(record);

        future.whenComplete((result, exception) -> {
            if (exception == null) {
                // --- CHANGED: Added runId to the success log ---
                log.info("Successfully published! Target ID: {} | Topic: {} | Run ID: {} | Offset: {}",
                        targetId, lhoTopic, runId, result.getRecordMetadata().offset());
            } else {
                log.error("CRITICAL: Failed to publish for Target ID: {}. Error: {}",
                        targetId, exception.getMessage());
            }
        });
    }

