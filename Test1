This is the perfect next step! Stripping out the PAYLOAD CLOB column will drastically reduce your database storage costs, speed up your API responses (since Java doesn't have to serialize massive JSON strings), and reduce CPU load on the frontend.
We will do this in three safe steps: decoupling React, decoupling Java, and then finally dropping the column in Oracle.
### Step 1: Update React (fetchBatchDetailsPaginated)
We need to tell the frontend to completely ignore the payload and instead map the native relational fields that Spring Boot is already sending (like reqBranchCode, reqAmount, etc.).
**File:** JournalRequestApproval.js
Replace your fetchBatchDetailsPaginated function with this clean, payload-free version:
```javascript
  const fetchBatchDetailsPaginated = async (batchId, page, size) => {
    setDetailLoading(true);
    try {
      const res = await callApi(
        `/JS/journals/by-batch-paginated/${batchId}?page=${page}&size=${size}`,
        null,
        "GET"
      );
      
      const contentArray = res?.content || (Array.isArray(res) ? res : []);
      
      if (contentArray && isMounted.current) {
        setDetailTotalCount(res?.totalElements || contentArray.length || 0);
        const journalGroups = new Map();
        
        contentArray.forEach((req, index) => {
          try {
            // ✅ DECOUPLED: No more JSON.parse(req.payload)!
            
            const jId = req.journalId || req.id || `UNKNOWN-${index}`;
            const prefix = String(jId).split("-")[0];
            
            // ✅ Read directly from the relational entity fields
            const amount = parseFloat(req.reqAmount) || 0;
            
            const row = {
              ...req,
              journalPrefix: prefix,
              amount: Math.abs(amount),
              transactionType: amount < 0 ? "Credit" : "Debit",
              
              // ✅ Map the DB columns to simple names so your UI table doesn't break
              branch: req.reqBranchCode,
              currency: req.reqCurrency,
              cgl: req.reqCgl,
              remarks: req.reqNarration,
              product: req.reqProduct,
              date: req.reqCsvDate
            };
            
            if (!journalGroups.has(prefix)) journalGroups.set(prefix, []);
            journalGroups.get(prefix).push(row);
            
          } catch (e) {
            console.error("Failed to map row details:", req, e);
          }
        });
        setBatchDetails(Array.from(journalGroups.values()));
      }
    } catch (e) {
      if (isMounted.current) showSnackBar("Failed to load details", "error");
    } finally {
      if (isMounted.current) setDetailLoading(false);
    }
  };

```
