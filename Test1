package com.tcs.fincore.CommonRequestService.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.stereotype.Component;

@Slf4j
@Component
@RequiredArgsConstructor
public class LhoTransferStrategy implements RequestTypeStrategy {

    // Inject KafkaTemplate directly
    private final KafkaTemplate<String, String> kafkaTemplate;

    // Best practice: Externalize your topic name to application.yml 
    // Fallback to "lho-transfer-events" if not found in properties
    @Value("${app.kafka.topics.lho-transfer:lho-transfer-events}")
    private String lhoTopic;

    @Override
    public RequestType getRequestType() {
        return RequestType.LHO_TRANSFER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        log.info("Processing Approval for LHO Transfer Batch: {}", request.getTargetId());

        switch (request.getChangeType()) {
            case ADD:
                handleLhoApproval(request);
                break;
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " not supported for LHO.");
        }
    }

    private void handleLhoApproval(CommonReq request) {
        log.info("Triggering Kafka event to topic '{}' for LHO targetId: {}", lhoTopic, request.getTargetId());
        
        // Publish the event. 
        // We use targetId as the Kafka Message Key to ensure ordered processing for the same targetId.
        // We pass the JSON payload so the consuming service has all the data it needs to act.
        kafkaTemplate.send(lhoTopic, request.getTargetId(), request.getPayload());
        
        log.info("Kafka event successfully dispatched for LHO Transfer Batch {}.", request.getTargetId());
    }
}
