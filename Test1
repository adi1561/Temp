SELECT 
    BM.CODE as BRANCH_CODE, 
    BM.NAME as BRANCH_NAME, 
    BM.CIRCLE_CODE as CODE_IN_BRANCH_TABLE, 
    CM.CIRCLE_NAME as MAPPED_NAME
FROM 
    BRANCH_MASTER BM
LEFT JOIN 
    CIRCLE_MASTER CM ON BM.CIRCLE_CODE = CM.CIRCLE_CODE
WHERE 
    BM.CODE IN (SELECT DISTINCT BRANCH_CODE FROM GL_BALANCE WHERE BALANCE_DATE = TO_DATE('20/09/2025', 'dd/MM/yyyy'));
