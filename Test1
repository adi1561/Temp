UPDATE ASCII_CONFIG 
SET 
    -- 1. Remove SHOW_SIGN so positive numbers don't get a '+'
    -- Setting it to NULL uses the default: "No sign for positive, '-' for negative"
    OUTPUT_AMT_SIGN = NULL,

    -- 2. Ensure Padding applies to Col 5 and Col 1 (19 chars, 0 decimals)
    OUTPUT_AMT_COL_PAD = '["^.*"][5][19,0]|["^.*"][1][19,0]',

    -- 3. Ensure Decimal logic applies to Col 5 and Col 1
    OUTPUT_AMT_DECIMAL = '["^.*"][5][down]|["^.*"][1][down]'

WHERE ID = 104;

COMMIT;
