package com.fincore.repository;

import com.fincore.dto.GlTransactionDTO;
import com.fincore.entity.GlTransaction;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

@Repository
public interface GlTransactionRepository extends JpaRepository<GlTransaction, Long> {

    // IMPORTANT: The order of fields inside 'new DTO(...)' must match 
    // the order in GlTransactionDTO.java exactly.
    @Query("""
        SELECT new com.fincore.dto.GlTransactionDTO(
            t.reconRunDate,
            t.branchCode,
            t.currency,
            t.cgl,
            t.cbsBalance,
            t.glBalance,
            t.differenceAmount,
            t.diffBwYesterday,
            t.type,
            t.head
        )
        FROM GlTransaction t
    """)
    Page<GlTransactionDTO> findAllAsDto(Pageable pageable);
}

5. The Service (GlTransactionService.java)
Updated: Uses the new Repository and DTO.
package com.fincore.service;

import com.fincore.dto.GlTransactionDTO;
import com.fincore.repository.GlTransactionRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class GlTransactionService {

    @Autowired
    private GlTransactionRepository repository;

    @Transactional(readOnly = true)
    public Page<GlTransactionDTO> getAllTransactions(int page, int size) {
        // Sort by Recon Run Date descending (latest first)
        PageRequest pageRequest = PageRequest.of(page, size, Sort.by("reconRunDate").descending());
        return repository.findAllAsDto(pageRequest);
    }
}

