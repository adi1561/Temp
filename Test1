FROM bde2020/hive:2.3.2-postgresql-metastore
USER root

# Create spark user with UID 185 (if not already present)
RUN id -u spark >/dev/null 2>&1 || \
    useradd -u 185 -m -s /bin/bash spark

# Copy hive-site.xml
COPY hive-site.xml /opt/hive/conf/hive-site.xml

# Set permissions and ownership
RUN chown spark:spark /opt/hive/conf/hive-site.xml && \
    chmod 644 /opt/hive/conf/hive-site.xml

# Switch back to spark user
USER spark



