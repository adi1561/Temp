package com.fincore.ReportService.report;

import com.fincore.ReportService.config.NwsaProperties;
import com.fincore.ReportService.domain.BankVariance;
import com.fincore.ReportService.domain.BranchVariance;
import com.fincore.ReportService.domain.VarianceReport;
import lombok.extern.slf4j.Slf4j;
import net.sf.jasperreports.engine.JasperCompileManager;
import net.sf.jasperreports.engine.JasperExportManager;
import net.sf.jasperreports.engine.JasperFillManager;
import net.sf.jasperreports.engine.JasperPrint;
import net.sf.jasperreports.engine.JasperReport;
import net.sf.jasperreports.engine.data.JRBeanCollectionDataSource;
import org.springframework.core.io.ClassPathResource;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Component
@Slf4j
public class VarianceReportExporter {

    private final NwsaProperties properties;

    public VarianceReportExporter(NwsaProperties properties) {
        this.properties = properties;
    }

    public ExportResult export(VarianceReport report) throws IOException {
        Path baseDir = Path.of(properties.outputDir());
        Files.createDirectories(baseDir);
        String suffix = report.today().format(DateTimeFormatter.BASIC_ISO_DATE) + "_vs_"
                + report.yesterday().format(DateTimeFormatter.BASIC_ISO_DATE);

        Path csv = baseDir.resolve("nwsa_variance_" + suffix + ".csv");
        writeCsv(report, csv);

        Path pdf = baseDir.resolve("nwsa_variance_" + suffix + ".pdf");
        writePdf(report, pdf);

        return new ExportResult(csv.toString(), pdf.toString());
    }

    private void writeCsv(VarianceReport report, Path path) throws IOException {
        List<String> lines = new ArrayList<>();
        lines.add("SECTION,BANK_HEAD_CODE,DESCRIPTION,TODAY_BALANCE,YESTERDAY_BALANCE,DIFFERENCE,BRANCH_CODE,BRANCH_NAME");

        for (BankVariance bank : report.bankSummary()) {
            lines.add("BANK,%s,%s,%s,%s,%s,,".formatted(
                    bank.headCode(), sanitize(bank.description()), bank.todayBalance(), bank.yesterdayBalance(), bank.difference()));

            for (BranchVariance branch : report.branchDetailsByHead().getOrDefault(bank.headCode(), List.of())) {
                lines.add("BRANCH,%s,%s,%s,%s,%s,%s,%s".formatted(
                        branch.headCode(), sanitize(bank.description()), branch.todayBalance(), branch.yesterdayBalance(), branch.difference(),
                        branch.branchCode(), sanitize(branch.branchName())));
            }
        }
        Files.write(path, lines);
        log.info("CSV Report generated: {}", path);
    }

    private void writePdf(VarianceReport report, Path path) {
        try {
            // Ensure this file exists in src/main/resources/jasper/nwsa_variance.jrxml
            JasperReport jasperReport = JasperCompileManager.compileReport(
                    new ClassPathResource("jasper/nwsa_variance.jrxml").getInputStream());
            
            Map<String, Object> params = new HashMap<>();
            params.put("today", report.today().toString());
            params.put("yesterday", report.yesterday().toString());
            
            List<VarianceRowView> rows = flatten(report);
            JasperPrint print = JasperFillManager.fillReport(jasperReport, params, new JRBeanCollectionDataSource(rows));
            
            JasperExportManager.exportReportToPdfFile(print, path.toString());
            log.info("PDF Report generated: {}", path);
            
        } catch (Exception ex) {
            log.error("FAILED to generate PDF report. Check JRXML path and dependencies.", ex);
        }
    }

    private List<VarianceRowView> flatten(VarianceReport report) {
        List<VarianceRowView> rows = new ArrayList<>();
        for (BankVariance bank : report.bankSummary()) {
            rows.add(new VarianceRowView("BANK", bank.headCode(), bank.description(), null,
                    bank.todayBalance(), bank.yesterdayBalance(), bank.difference()));

            for (BranchVariance branch : report.branchDetailsByHead().getOrDefault(bank.headCode(), List.of())) {
                rows.add(new VarianceRowView("BRANCH", bank.headCode(), bank.description(),
                        branch.branchCode() + " - " + branch.branchName(),
                        branch.todayBalance(), branch.yesterdayBalance(), branch.difference()));
            }
        }
        return rows;
    }

    private String sanitize(String value) {
        return value == null ? "" : value.replace(",", " ");
    }

    public record ExportResult(String csvPath, String pdfPath) {}

    // Public record needed for JasperReports reflection
    public record VarianceRowView(
            String section,
            String headCode,
            String description,
            String branch,
            BigDecimal today,
            BigDecimal yesterday,
            BigDecimal difference
    ) {}
}

