package com.fincore.JournalService.Service.impl;

import com.fincore.JournalService.Models.JournalRequest;
import com.fincore.JournalService.Models.enums.RequestStatus;
import com.fincore.JournalService.Repository.JournalRequestRepository;
import com.fincore.JournalService.Service.JournalRequestService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import java.util.List;

@Service
public class JournalRequestServiceImpl implements JournalRequestService {

    @Autowired
    private JournalRequestRepository repository;

    /**
     * SEARCH BY BRANCH (STARTS WITH)
     * Calls the repository to find pending requests starting with the specific branch code.
     */
    public Page<JournalRequest> searchPendingByBranchPrefix(String branchPrefix, int page, int size) {
        Pageable pageable = PageRequest.of(page, size);
        // Note: We pass the raw prefix; Spring Data JPA handles the 'prefix%' logic.
        return repository.findByReqBranchCodeStartingWithAndRequestStatus(
                branchPrefix, 
                RequestStatus.PENDING, 
                pageable
        );
    }

    /**
     * SEARCH BY CGL (STARTS WITH)
     * Calls the repository to find pending requests starting with the specific CGL code.
     */
    public Page<JournalRequest> searchPendingByCglPrefix(String cglPrefix, int page, int size) {
        Pageable pageable = PageRequest.of(page, size);
        return repository.findByReqCglStartingWithAndRequestStatus(
                cglPrefix, 
                RequestStatus.PENDING, 
                pageable
        );
    }

    // ... [Preserve all other existing methods like findPendingBatchSummaries, processBulk, etc.] ...
}

```
