package com.fincore.ReportService.config;

import lombok.extern.slf4j.Slf4j;
import org.apache.hadoop.fs.FileSystem;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import java.io.IOException;
import java.net.URI;

@Configuration
@Slf4j
public class HadoopConfig {

    // --- Common Properties ---
    @Value("${hadoop.fs.user}")
    private String hadoopUser;

    // --- Simple Mode Property ---
    @Value("${hadoop.fs.uri:#{null}}")
    private String simpleFsUri;

    // --- HA Mode Properties ---
    @Value("${hadoop.fs.nameservice:#{null}}")
    private String nameservice;

    @Value("${hadoop.fs.ha.namenodes:#{null}}")
    private String nnIds;

    @Value("${hadoop.fs.ha.nn1.rpc:#{null}}")
    private String nn1Rpc;

    @Value("${hadoop.fs.ha.nn2.rpc:#{null}}")
    private String nn2Rpc;

    @Value("${hadoop.fs.ha.nn3.rpc:#{null}}")
    private String nn3Rpc;

    @Bean
    public FileSystem fileSystem() {
        org.apache.hadoop.conf.Configuration config = new org.apache.hadoop.conf.Configuration();

        // 1. Common Robustness Settings (Apply to both modes)
        config.set("ipc.client.connect.timeout", "5000"); // 5s connection timeout
        config.set("ipc.client.rpc-timeout.ms", "30000"); // 30s RPC timeout
        config.set("fs.hdfs.impl.disable.cache", "true"); // Prevent singleton lifecycle issues in Spring

        URI targetUri;

        // 2. Decide Mode: HA vs Simple
        if (nameservice != null && !nameservice.isBlank()) {
            // --- HIGH AVAILABILITY (HA) MODE ---
            log.info("Configuring HDFS in HA Mode for Nameservice: {}", nameservice);

            String authority = "hdfs://" + nameservice;
            config.set("fs.defaultFS", authority);
            config.set("dfs.nameservices", nameservice);
            config.set("dfs.ha.namenodes." + nameservice, nnIds); // e.g., "nn1,nn2,nn3"

            // Set RPC addresses safely
            if (nn1Rpc != null) config.set("dfs.namenode.rpc-address." + nameservice + ".nn1", nn1Rpc);
            if (nn2Rpc != null) config.set("dfs.namenode.rpc-address." + nameservice + ".nn2", nn2Rpc);
            if (nn3Rpc != null) config.set("dfs.namenode.rpc-address." + nameservice + ".nn3", nn3Rpc);

            // Failover Provider (Hedging)
            config.set("dfs.client.failover.proxy.provider." + nameservice,
                    "org.apache.hadoop.hdfs.server.namenode.ha.RequestHedgingProxyProvider");

            // HA Specific Robustness
            config.set("ipc.client.connect.max.retries.on.timeouts", "3");
            config.set("dfs.client.failover.max.attempts", "10");

            targetUri = URI.create(authority);

        } else {
            // --- SIMPLE / SINGLE NODE MODE ---
            if (simpleFsUri == null || simpleFsUri.isBlank()) {
                throw new IllegalStateException("Invalid HDFS Config: Neither 'nameservice' (for HA) nor 'uri' (for Simple) was provided.");
            }
            log.info("Configuring HDFS in Simple Mode to: {}", simpleFsUri);

            config.set("fs.defaultFS", simpleFsUri);
            // Optional: Disable permission checks for local dev if needed
            // config.set("dfs.client.use.datanode.hostname", "true");

            targetUri = URI.create(simpleFsUri);
        }

        // 3. Create FileSystem
        try {
            return FileSystem.get(targetUri, config, hadoopUser);
        } catch (IOException | InterruptedException e) {
            log.error("CRITICAL: Failed to connect to HDFS. URI: {}, User: {}", targetUri, hadoopUser, e);
            throw new RuntimeException("Could not initialize Hadoop FileSystem", e);
        }
    }
}


