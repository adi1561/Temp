package com.fincore.JournalService.Controller;

import com.fincore.JournalService.Models.JournalRequest;
import com.fincore.JournalService.Service.JournalRequestService;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/JS/journals")
@RequiredArgsConstructor
public class JournalRequestController {

    private final JournalRequestService journalRequestService;

    /**
     * DYNAMIC PREFIX SEARCH
     * Endpoint: GET /JS/journals/search-pending
     * Parameters: branch (optional), cgl (optional), page, size
     * Logic: Implements "Starts With" matching for Authorization screen filtering.
     */
    @GetMapping("/search-pending")
    public ResponseEntity<Page<JournalRequest>> searchPendingRequests(
            @RequestParam(required = false) String branch,
            @RequestParam(required = false) String cgl,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "10") int size) {
        
        Pageable pageable = PageRequest.of(page, size);

        // Prioritize Branch search if both are provided
        if (branch != null && !branch.trim().isEmpty()) {
            return ResponseEntity.ok(journalRequestService.searchPendingByBranchPrefix(branch.trim(), pageable));
        } 
        
        // Fallback to CGL search
        if (cgl != null && !cgl.trim().isEmpty()) {
            return ResponseEntity.ok(journalRequestService.searchPendingByCglPrefix(cgl.trim(), pageable));
        }

        // Default: Return all pending requests if no search criteria provided
        return ResponseEntity.ok(journalRequestService.getRequestsByStatus("PENDING", pageable));
    }
}
