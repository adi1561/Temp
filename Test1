
package org.example.demo1;

// Interface defining the strategy

interface RiderMatcher {
    void match(String riderLocation);
}

// Concrete strategy: Bike
class Bike implements RiderMatcher {
    @Override
    public void match(String riderLocation) {
        System.out.println("Bike rider mode matched for location: " + riderLocation);
    }
}

// Concrete strategy: Car (corrected class name)
class Car implements RiderMatcher {
    @Override
    public void match(String riderLocation) {
        System.out.println("Car rider is matching for location: " + riderLocation);
    }
}

// Context class using the strategy
class RapidoService {
    private final RiderMatcher riderMatcher;

    public RapidoService(RiderMatcher riderMatcher) {
        this.riderMatcher = riderMatcher;
    }

    public void matchRider(String location) {
        riderMatcher.match(location);
    }
}

// Main class with main method (corrected name and added execution)
public class Strategy {
    public static void main(String[] args) {
        // Use Bike strategy
        RapidoService service = new RapidoService(new Bike());
        service.matchRider("Central Avenue");

        // Switch to Car strategy
        service.matchRider("Downtown");
    }
}

