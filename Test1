    private void handleAsyncFailure(String batchId, String creatorId, String requestId, String message) {
        try {
            // 1. Delete orphaned journal request rows only so GL stays balanced
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);

            // 2. UPSERT the master record back to PENDING and WIPE the error remarks (NULL)
            int updated = jdbcTemplate.update(
                    "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'PENDING', EXECUTOR_REMARKS = NULL WHERE BATCH_ID = ?",
                    batchId);

            // If master record doesn't exist yet, insert it clean
            if (updated == 0) {
                jdbcTemplate.update(
                        "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, BATCH_STATUS, EXECUTOR_REMARKS, REQ_DATE) VALUES (?, 'PENDING', NULL, SYSTIMESTAMP)",
                        batchId);
            }
        } catch (DataAccessException e) {
            log.error("CLEANUP_CRITICAL_FAIL | Batch: {} | Cannot record failure state", batchId);
        }
        progressService.sendProgress(batchId, creatorId, 0, "FAILED", message);
    }

