    // 5. STORAGE & UTILS
    // ==================================================================================

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProductColumn) throws IOException {
        log.warn("VALIDATION_FAILED | ReqID: {} | Reason: {}", reqId, msg);
        byte[] excel = generateErrorExcelFast(rows, hasProductColumn);
        redisTemplate.opsForValue().set("FILE_" + reqId + "_ERROR", excel, 30, TimeUnit.MINUTES);
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv , boolean hasProductColumn) throws IOException {
        saveRowsToRedis(reqId, rows);
        if (!isCsv) {
            byte[] csv = generateSuccessCsv(rows, pDate);
            redisTemplate.opsForValue().set("FILE_" + reqId + "_SUCCESS", csv, 30, TimeUnit.MINUTES);
        }
        List<Map<String, Object>> preview = rows.stream().limit(2000).map(this::mapToPreview).collect(Collectors.toList());
        updateState(reqId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(!isCsv);
            s.setHasProductColumn(hasProductColumn);
            try {
                s.setPreviewDataJson(objectMapper.writeValueAsString(preview));
            } catch (JsonProcessingException ignored) {}
        });
    }

    private synchronized void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        // 1. Always pull the freshest state from Redis to avoid "Stale Object" overwrites
        BulkUploadStateDto state = getStatusFromRedis(requestId);
        if (state == null) {
            state = new BulkUploadStateDto();
            state.setRequestId(requestId);
        }

        // 2. Apply the update (e.g., changing status, incrementing counts, or setting total rows)
        updater.accept(state);

        // 3. Persist the updated object back to Redis immediately
        saveStatusToRedis(requestId, state);
    }


    private void saveRowsToRedis(String requestId, List<ExcelRowData> rows) {
        if (rows == null || rows.isEmpty()) return;

        try {
            int chunkSize = 5000;
            int totalRows = rows.size();
            int totalChunks = (int) Math.ceil((double) totalRows / chunkSize);

            // 1. Save chunks individually to prevent memory spikes
            for (int i = 0; i < totalChunks; i++) {
                int start = i * chunkSize;
                int end = Math.min(start + chunkSize, totalRows);
                List<ExcelRowData> chunk = rows.subList(start, end);

                try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
                     GZIPOutputStream gos = new GZIPOutputStream(baos)) {
                    objectMapper.writeValue(gos, chunk);
                    gos.finish();

                    String chunkKey = "DATA_CHUNK_" + requestId + "_" + i;
                    redisTemplate.opsForValue().set(chunkKey, baos.toByteArray(), 1, TimeUnit.HOURS);
                }
            }

            // 2. Save metadata so the retrieval service knows how many chunks to fetch
            Map<String, Object> meta = new HashMap<>();
            meta.put("totalChunks", totalChunks);
            meta.put("totalRows", totalRows);

            byte[] metaBytes = objectMapper.writeValueAsBytes(meta);
            redisTemplate.opsForValue().set("DATA_META_" + requestId, metaBytes, 1, TimeUnit.HOURS);

            log.info("CACHE_DATA_SAVED | ReqID: {} | TotalRows: {} | Chunks: {}", requestId, totalRows, totalChunks);

        } catch (IOException | DataAccessException e) {
            log.error("CACHE_SAVE_FAILURE | ReqID: {} | Status: Chunked persistence error", requestId);
            throw new CustomExceptions.RedisOperationException("Failed to cache large dataset", e);
        }
    }

    private byte[] generateSuccessCsv(List<ExcelRowData> rows, LocalDate postingDate) {
        StringBuilder csv = new StringBuilder(rows.size() * 100);
        DateTimeFormatter ddMMyyyy = DateTimeFormatter.ofPattern("ddMMyyyy");
        String col2 = postingDate.format(ddMMyyyy);
        String year = (postingDate.getMonthValue() >= 4) ? String.valueOf(postingDate.getYear()) : String.valueOf(postingDate.getYear() - 1);
        String month = String.format("%02d", (postingDate.getMonthValue() >= 4) ? (postingDate.getMonthValue() - 3) : (postingDate.getMonthValue() + 9));

        for (ExcelRowData row : rows) {
            String cDate = row.isSystemFormat ? row.sysDate : col2;
            String cYear = row.isSystemFormat ? row.sysYear : year;
            String cMonth = row.isSystemFormat ? row.sysPeriod : month;
            String col5 = String.format("%5s", row.branch).replace(' ', '0');
            String col6 = (row.currency == null || row.currency.isEmpty()) ? "INR" : row.currency;

            String plainAmt = row.amount.abs().setScale(4, RoundingMode.HALF_UP).toPlainString();
            int dotIndex = plainAmt.indexOf('.');
            String intPart = (dotIndex == -1) ? plainAmt : plainAmt.substring(0, dotIndex);
            String decPart = (dotIndex == -1) ? "0000" : plainAmt.substring(dotIndex + 1);
            String col8 = String.format("%16s", intPart).replace(' ', '0') + "." + decPart;

            String col9 = "Credit".equalsIgnoreCase(row.txnType) ? "Cr" : "Dr";
            String col10 = (row.remarks != null) ? row.remarks.replace(",", " ") : "";

            String col11 = (row.productCode == null || row.productCode.trim().isEmpty()) ? "A" : row.productCode.trim();

            csv.append("01,").append(cDate).append(",").append(cYear).append(",").append(cMonth).append(",")
                    .append(col5).append(",").append(col6).append(",").append(row.cgl).append(",").append(col8).append(",")
                    .append(col9).append(",").append(col10).append(",").append(col11).append(",B,C,D\n");
        }
        return csv.toString().getBytes(StandardCharsets.UTF_8);
    }
    private byte[] generateErrorExcelFast(List<ExcelRowData> rows, boolean includeProduct) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) {
            Sheet sheet = workbook.createSheet("Error Report");
            CellStyle errStyle = workbook.createCellStyle();
            Font f = workbook.createFont(); f.setColor(IndexedColors.RED.getIndex()); errStyle.setFont(f);

            Row h = sheet.createRow(0);
            List<String> headerList = new ArrayList<>(Arrays.asList("Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks"));
            if (includeProduct) headerList.add("Product");
            headerList.add("ERRORS");
            if (rows.stream().anyMatch(r -> r.isSystemFormat)) headerList.addAll(0, Arrays.asList("Site", "Date", "Year", "Month"));
            for (int i = 0; i < headerList.size(); i++) h.createCell(i).setCellValue(headerList.get(i));

            int idx = 1;
            boolean isSystem = rows.stream().anyMatch(r -> r.isSystemFormat);
            for (ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                int col = 0;
                if (isSystem) {
                    r.createCell(col++).setCellValue(sanitize(d.sysSite));
                    r.createCell(col++).setCellValue(sanitize(d.sysDate));
                    r.createCell(col++).setCellValue(sanitize(d.sysYear));
                    r.createCell(col++).setCellValue(sanitize(d.sysPeriod));
                }
                r.createCell(col++).setCellValue(sanitize(d.branch));
                r.createCell(col++).setCellValue(sanitize(d.currency));
                r.createCell(col++).setCellValue(sanitize(d.cgl));
                r.createCell(col++).setCellValue(d.amount != null ? d.amount.toString() : "");
                r.createCell(col++).setCellValue(sanitize(d.txnType));
                r.createCell(col++).setCellValue(sanitize(d.remarks));
                if (includeProduct) r.createCell(col++).setCellValue(sanitize(d.productCode));
                Cell c = r.createCell(col);
                if (d.hasErrors()) { c.setCellValue(d.getAllErrors()); c.setCellStyle(errStyle); }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            return out.toByteArray();
        }
    }

    private String sanitize(String value) {
        if (value == null) return "";
        if (value.startsWith("=") || value.startsWith("+") || value.startsWith("-") || value.startsWith("@")) return "'" + value;
        return value;
    }

    public byte[] generateTemplateBytes() throws IOException {
        try (SXSSFWorkbook wb = new SXSSFWorkbook()) {
            Sheet sheet = wb.createSheet("Journal Template");
            Row row = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks", "Product"};
            for (int i = 0; i < headers.length; i++) {
                Cell cell = row.createCell(i); cell.setCellValue(headers[i]); sheet.setColumnWidth(i, 4000);
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            wb.write(out);
            return out.toByteArray();
        }
    }

    private String parseCode(Cell c, DataFormatter f) {
        if (c == null) return "";
        if (c.getCellType() == CellType.NUMERIC) return BigDecimal.valueOf(c.getNumericCellValue()).toPlainString().split("\\.")[0];
        return f.formatCellValue(c).trim();
    }

    private boolean isRowEmpty(Row r) {
        if (r == null) return true;
        for (int c = r.getFirstCellNum(); c < r.getLastCellNum(); c++)
            if (r.getCell(c) != null && r.getCell(c).getCellType() != CellType.BLANK && !r.getCell(c).toString().trim().isEmpty()) return false;
        return true;
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>();
        m.put("id", r.rowIndex); m.put("branch", r.branch); m.put("currency", r.currency);
        m.put("cgl", r.cgl); m.put("amount", r.amount != null ? r.amount.toString() : "");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }

    private static class ParsingResult {
        List<ExcelRowData> rows; boolean hasProductColumn;
        public ParsingResult(List<ExcelRowData> rows, boolean hasProductColumn) { this.rows = rows; this.hasProductColumn = hasProductColumn; }
    }


    @JsonIgnoreProperties(ignoreUnknown = true)
    @JsonFormat(shape = JsonFormat.Shape.ARRAY)
    @JsonPropertyOrder({
            "rowIndex", "branch", "currency", "cgl", "txnType", "remarks",
            "productCode", "amount", "isSystemFormat", "sysSite", "sysDate",
            "sysYear", "sysPeriod", "formatErrors", "dbErrors", "balErrors"
    })
    public static class ExcelRowData {

        @JsonProperty("0") // rowIndex
        public int rowIndex;

        @JsonProperty("1") // branch
        public String branch = "";

        @JsonProperty("2") // currency
        public String currency = "";

        @JsonProperty("3") // cgl
        public String cgl = "";

        @JsonProperty("4") // txnType
        public String txnType = "";

        @JsonProperty("5") // remarks
        public String remarks = "";

        @JsonProperty("6") // productCode
        public String productCode = "";

        @JsonProperty("7") // amount
        public BigDecimal amount;

        @JsonProperty("8") // isSystemFormat
        public boolean isSystemFormat = false;

        @JsonProperty("9") // sysSite
        public String sysSite = "";

        @JsonProperty("10") // sysDate
        public String sysDate = "";

        @JsonProperty("11") // sysYear
        public String sysYear = "";

        @JsonProperty("12") // sysPeriod
        public String sysPeriod = "";

        // Validation Lists (Indices 13, 14, 15)
        @JsonProperty("13")
        public final List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());

        @JsonProperty("14")
        public final List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());

        @JsonProperty("15")
        public final List<String> balErrors = Collections.synchronizedList(new ArrayList<>());

        public boolean hasErrors() {
            return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty();
        }

        @JsonIgnore
        public String getAllErrors() {
            List<String> all = new ArrayList<>(formatErrors);
            all.addAll(dbErrors);
            all.addAll(balErrors);
            return String.join("; ", all);
        }
    }
