    // ==================================================================================
    // 1. ASYNC BATCH CREATION (PARALLEL OPTIMIZATION)
    // ==================================================================================

    @Override
    @Transactional
    public String createBatchFromCacheAsync(String requestId, String commonRemarks, String creatorId, Integer creatorRole) throws IOException {
        String lockKey = "LOCK_REQ_" + requestId;
        
        try {
            Boolean acquired = redisTemplate.opsForValue().setIfAbsent(lockKey, new byte[0], 5, TimeUnit.MINUTES);
            if (Boolean.FALSE.equals(acquired)) {
                log.warn("CONCURRENCY_LOCK | ReqID: {} | Reason: Duplicate creation attempt blocked", requestId);
                throw new CustomExceptions.ConcurrencyLockException("Batch creation is already in progress.");
            }
        } catch (DataAccessException e) {
            log.error("REDIS_LOCK_FAIL | ReqID: {} | Error: {}", requestId, e.getMessage());
        }

        try {
            String batchId = sequenceService.getNextBatchId();
            progressService.sendProgress(batchId, creatorId, 0, "PROCESSING", "Initializing Batch Creation...");
            self.executeAsyncBatchCreation(batchId, requestId, commonRemarks, creatorId, creatorRole);
            return batchId;
        } catch (DataAccessException e) {
            redisTemplate.delete(lockKey);
            log.error("SEQUENCE_FETCH_FAIL | ReqID: {} | Error: {}", requestId, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Batch ID", e);
        }
    }

    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchCreation(String batchId, String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        MDC.put("batchId", batchId);
        MDC.put("user", creatorId);
        
        log.info("BATCH_CREATE_ASYNC_START | Batch: {} | Source: {}", batchId, requestId);

        try {
            progressService.sendProgress(batchId, creatorId, 5, "PROCESSING", "Preparing Data...");
            List<ExcelRowData> cachedRows = journalBulkValidationService.getValidRowsFromCache(requestId);
            
            if (cachedRows == null || cachedRows.isEmpty()) {
                logAudit(creatorId, "CREATE_FAIL", "BATCH_ASYNC", "Cache Expired for " + batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired.");
                return;
            }

            int totalRows = cachedRows.size();
            int batchSize = 5000; // Optimal for Oracle JDBC
            int totalChunks = (int) Math.ceil((double) totalRows / batchSize);
            
            List<CompletableFuture<Void>> futures = new ArrayList<>();
            LongAdder totalDebit = new LongAdder();
            LongAdder totalCredit = new LongAdder();
            AtomicInteger completedChunks = new AtomicInteger(0);

            for (int i = 0; i < totalRows; i += batchSize) {
                final int startIdx = i;
                final int endIdx = Math.min(i + batchSize, totalRows);
                final List<ExcelRowData> chunk = cachedRows.subList(startIdx, endIdx);

                CompletableFuture<Void> future = CompletableFuture.runAsync(() ->
                                processChunkRaw(chunk, batchId, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit), bulkExecutor)
                        .thenRun(() -> {
                            int done = completedChunks.incrementAndGet();
                            int percent = 5 + (done * 90 / totalChunks);
                            progressService.sendProgress(batchId, creatorId, percent, "PROCESSING", 
                                    String.format("Created %d/%d records...", (done * chunk.size()), totalRows));
                        });
                futures.add(future);
            }

            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            // Insert Master Summary Record
            jdbcTemplate.update("INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                    batchId, creatorId, Timestamp.valueOf(LocalDateTime.now()), commonRemarks, totalRows,
                    BigDecimal.valueOf(totalDebit.sum()), BigDecimal.valueOf(totalCredit.sum()), "PENDING");

            redisTemplate.delete("DATA_" + requestId);
            redisTemplate.delete("LOCK_REQ_" + requestId);
            
            progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Batch Created Successfully");
            sendNotification(creatorId, null, "Batch " + batchId + " created successfully.", batchId);

            NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
            if (config != null) {
                sendNotification(creatorId, config.getTargetRoles(), "New Batch " + batchId + " requires approval.", batchId);
            }

            log.info("BATCH_CREATE_SUCCESS | Batch: {} | TotalRows: {}", batchId, totalRows);

        } catch (DataAccessException | RuntimeException e) {
            log.error("BATCH_CREATE_CRASH | Batch: {} | Error: {}", batchId, e.getMessage());
            cleanupFailedBatch(batchId);
            String uiMsg = "Failed to create batch due to system error.";
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", uiMsg, batchId);
            progressService.sendProgress(batchId, creatorId, 0, "FAILED", uiMsg);
        } finally {
            MDC.clear();
        }
    }

    private void processChunkRaw(List<ExcelRowData> chunk, String batchId, String commonRemarks, String creatorId, Integer creatorRole, int offset, LongAdder debit, LongAdder credit) {
        String sql = "INSERT INTO JOURNAL_REQUEST (REQ_ID, REQ_STATUS, REQ_DATE, CREATOR_ID, CREATOR_ROLE, BATCH_ID, JOURNAL_ID, COMMON_BATCH_REMARKS, PAYLOAD, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_CSV_DATE, REQ_NARRATION, REQ_PRODUCT) VALUES (JOURNAL_REQUEST_SEQ.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
        
        try (Connection conn = dataSource.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            conn.setAutoCommit(false);
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            DateTimeFormatter jsonFmt = DateTimeFormatter.ISO_DATE;

            for (int i = 0; i < chunk.size(); i++) {
                ExcelRowData r = chunk.get(i);
                int globalIdx = offset + i + 1;
                String jId = batchId + "-" + globalIdx;
                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                boolean isCredit = "Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType);
                BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                if (isCredit) credit.add(absAmt.longValue()); else debit.add(absAmt.longValue());

                ps.setString(1, "P");
                ps.setTimestamp(2, ts);
                ps.setString(3, creatorId);
                ps.setInt(4, creatorRole != null ? creatorRole : 0);
                ps.setString(5, batchId);
                ps.setString(6, jId);
                ps.setString(7, commonRemarks);
                ps.setString(8, buildJsonPayloadFast(r, signedAmt, LocalDate.now(), batchId, jId, commonRemarks, globalIdx, jsonFmt));
                ps.setString(9, r.branch);
                ps.setString(10, r.currency);
                ps.setString(11, r.cgl);
                ps.setBigDecimal(12, signedAmt);
                ps.setDate(13, java.sql.Date.valueOf(LocalDate.now()));
                ps.setString(14, r.remarks);
                ps.setString(15, r.productCode);
                ps.addBatch();
            }
            ps.executeBatch();
            conn.commit();
        } catch (SQLException e) {
            log.error("JDBC_BATCH_FAIL | Batch: {} | Offset: {} | Error: {}", batchId, offset, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to persist chunk", e);
        }
    }

    // ==================================================================================
    // 2. ASYNC APPROVAL (With Parallel DB & HDFS Retry)
    // ==================================================================================

    @Override
    @Transactional
    public void processBulkRequestsAsync(BulkProcessJournalRequestDto dto, String executorId, Integer executorRole) {
        try {
            int updated = jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS = 'PENDING'", dto.getBatchId());
            if (updated == 0) {
                throw new IllegalStateException("Batch already queued or processed.");
            }
            progressService.sendProgress(dto.getBatchId(), executorId, 0, "PROCESSING", "Approval Queued...");
            self.executeAsyncBatchProcessing(dto, executorId);
        } catch (DataAccessException e) {
            log.error("BATCH_LOCK_FAIL | Batch: {} | Error: {}", dto.getBatchId(), e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to queue batch for processing", e);
        }
    }

    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchProcessing(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        MDC.put("batchId", batchId);
        
        try {
            String creatorId = jdbcTemplate.queryForObject("SELECT CREATOR_ID FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", String.class, batchId);
            progressService.sendProgress(batchId, executorId, 20, "PROCESSING", "Processing on Database...");

            if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                jdbcTemplate.execute("{call PROCESS_JOURNAL_BATCH(?, ?, ?, ?, ?)}", (CallableStatementCallback<Void>) cs -> {
                    cs.setString(1, batchId);
                    cs.setString(2, executorId);
                    cs.setString(3, dto.getRemarks());
                    cs.setString(4, "A");
                    cs.registerOutParameter(5, -10); // Oracle Cursor
                    cs.execute();
                    return null;
                });

                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ACCEPTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);

                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Approved Successfully");
                sendNotification(executorId, null, "You approved Batch " + batchId, batchId);
                if (creatorId != null) sendNotification(creatorId, null, "Your Batch " + batchId + " has been ACCEPTED.", batchId);

            } else if (RequestStatus.REJECTED.equals(dto.getStatus())) {
                jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ?, EXECUTION_DATE = SYSDATE WHERE BATCH_ID = ? AND REQ_STATUS = 'P'",
                        executorId, dto.getRemarks(), batchId);
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                        executorId, dto.getRemarks(), batchId);
                
                progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Rejected");
                if (creatorId != null) sendNotification(creatorId, null, "Your Batch " + batchId + " was REJECTED.", batchId);
            }
        } catch (DataAccessException | RuntimeException e) {
            log.error("BATCH_PROCESS_FAIL | Batch: {} | Error: {}", batchId, e.getMessage());
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", "System error during processing", batchId);
            progressService.sendProgress(batchId, executorId, 0, "FAILED", "System Error");
        } finally {
            MDC.clear();
        }
    }

    // ==================================================================================
    // 3. ASYNC DELETION (Purge Logic)
    // ==================================================================================

    @Override
    @Transactional
    public void cancelMyRequestsByBatchIdAsync(String batchId, String userId) {
        int updated = jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS IN ('PENDING', 'ERROR')", batchId);
        if (updated == 0) {
            throw new IllegalStateException("Batch is already being processed or deleted.");
        }
        progressService.sendProgress(batchId, userId, 0, "PROCESSING", "Deleting Batch...");
        self.executeAsyncBatchCancellation(batchId, userId);
    }

    @Override
    @Async("bulkExecutor")
    public void executeAsyncBatchCancellation(String batchId, String userId) {
        MDC.put("batchId", batchId);
        try {
            jdbcTemplate.execute("{call PURGE_JOURNAL_BATCH(?, ?)}", (CallableStatementCallback<Void>) cs -> {
                cs.setString(1, batchId);
                cs.setString(2, userId);
                cs.execute();
                return null;
            });
            progressService.sendProgress(batchId, userId, 100, "COMPLETED", "Batch Deleted");
            sendNotification(userId, null, "Batch " + batchId + " deleted successfully.", batchId);
        } catch (DataAccessException e) {
            log.error("BATCH_PURGE_FAIL | Batch: {} | Error: {}", batchId, e.getMessage());
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", "Delete failed", batchId);
            progressService.sendProgress(batchId, userId, 0, "FAILED", "Purge Failed");
        } finally {
            MDC.clear();
        }
    }

    // ==================================================================================
