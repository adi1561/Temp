import java.time.LocalDate;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/v1/nwsa-variance")
public class VarianceController {

    private final VarianceComputationService service;
    private final VarianceReportExporter exporter;
    private final NwsaProperties props;
    private final ReportStatusCache statusCache;

    public VarianceController(VarianceComputationService service,
                              VarianceReportExporter exporter,
                              NwsaProperties props,
                              ReportStatusCache statusCache) {
        this.service = service;
        this.exporter = exporter;
        this.props = props;
        this.statusCache = statusCache;
    }

    @PostMapping("/generate")
    public GenerateResponse generate(@Valid @RequestBody GenerateRequest request) throws IOException {
        LocalDate today = LocalDate.parse(request.today(), props.formatter());
        LocalDate yesterday = LocalDate.parse(request.yesterday(), props.formatter());
        String key = "nwsa:" + today + ":" + yesterday;
        statusCache.mark(key, "IN_PROGRESS");
        VarianceReport report = service.generate(today, yesterday);
        VarianceReportExporter.ExportResult files = exporter.export(report);
        statusCache.mark(key, "SUCCESS");
        return new GenerateResponse("SUCCESS", files.csvPath(), files.pdfPath(), report.bankSummary().size());
    }
}



