    @Scheduled(fixedDelay = 300000)
    public void retryFailedHdfsSyncs() {
        String lockKey = "SYSTEM_LOCK_HDFS_RECOVERY";
        
        try {
            // Attempt to acquire lock for 4 minutes (expires safely before the next 5-min cycle)
            Boolean acquired = stringRedisTemplate.opsForValue().setIfAbsent(lockKey, "LOCKED", 4, java.util.concurrent.TimeUnit.MINUTES);
            
            if (Boolean.FALSE.equals(acquired)) {
                log.debug("HDFS_RECOVERY_SKIPPED | Status: Another node is currently processing the queue.");
                return;
            }

            // 1. Fetch PENDING batches
            String fetchSql = "SELECT BATCH_ID FROM HDFS_SYNC_RETRY_QUEUE WHERE STATUS = 'PENDING' AND RETRY_COUNT < 5";
            List<String> failedBatches;
            try {
                failedBatches = oracleJdbcTemplate.query(fetchSql, (rs, rowNum) -> rs.getString("BATCH_ID"));
            } catch (DataAccessException e) {
                log.error("HDFS_RECOVERY_QUERY_FAIL | Error fetching pending retries from Oracle: {}", e.getMessage());
                return;
            }

            if (failedBatches.isEmpty()) {
                return;
            }

            log.info("HDFS RECOVERY: Found {} failed batches. Starting self-healing...", failedBatches.size());
            for (String batchId : failedBatches) {
                try {
                    processRetry(batchId);
                } catch (DataAccessException e) {
                    log.error("HDFS_RECOVERY_DB_ERROR | Batch: {} | Persistence error: {}", batchId, e.getMessage());
                    incrementRetryCount(batchId);
                } catch (CustomExceptions.DatabaseOperationException e) {
                    log.error("HDFS_RECOVERY_LOGIC_ERROR | Batch: {} | Logic failure: {}", batchId, e.getMessage());
                    incrementRetryCount(batchId);
                }
            }
        } catch (org.springframework.data.redis.RedisConnectionFailureException e) {
            log.error("HDFS_RECOVERY_REDIS_FAIL | Cannot acquire distributed lock. Skipping cycle to prevent race conditions.");
        } finally {
            // Guarantee the lock is released when the task finishes, allowing the next cycle to run smoothly
            stringRedisTemplate.delete(lockKey);
        }
    }

```
This implementation guarantees that out of 5 running containers, 4 will hit the HDFS_RECOVERY_SKIPPED return block, and exactly 1 container will actually push the data to the Hive server.
