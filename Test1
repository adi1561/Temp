}

📂 3. The DTOs (Handling Input)
We need a way to tell the API which one we are creating.
package org.adesh.vehicle.DTO;

import lombok.Data;

@Data
public class VehicleRequestDto {
    private String type; // "CAR" or "TRUCK"
    private String manufacturer;
    private String model;
    
    // Specific fields (Optional depending on type)
    private Integer seatingCapacity; 
    private Double payloadCapacity;
}

📂 4. The Service (The Logic)
This is where we decide which object to create.
package org.adesh.vehicle.Service;

import org.adesh.vehicle.DTO.VehicleRequestDto;
import org.adesh.vehicle.Model.Car;
import org.adesh.vehicle.Model.Truck;
import org.adesh.vehicle.Model.Vehicle;
import org.adesh.vehicle.Repository.VehicleRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class VehicleService {

    @Autowired
    private VehicleRepository vehicleRepository;

    public Vehicle addVehicle(VehicleRequestDto dto) {
        Vehicle vehicle;

        // 1. Check the TYPE string to decide the Strategy (Object)
        if ("CAR".equalsIgnoreCase(dto.getType())) {
            Car car = new Car();
            car.setSeatingCapacity(dto.getSeatingCapacity());
            vehicle = car; // Assign to Parent Reference
        } else if ("TRUCK".equalsIgnoreCase(dto.getType())) {
            Truck truck = new Truck();
            truck.setPayloadCapacity(dto.getPayloadCapacity());
            vehicle = truck; // Assign to Parent Reference
        } else {
            throw new RuntimeException("Unknown Vehicle Type");
        }

        // 2. Set common fields
        vehicle.setManufacturer(dto.getManufacturer());
        vehicle.setModel(dto.getModel());

        // 3. Save (Hibernate automatically handles the Discriminator Column)
        return vehicleRepository.save(vehicle);
    }
}

📂 5. The Controller
package org.adesh.vehicle.Controller;

import org.adesh.vehicle.DTO.VehicleRequestDto;
import org.adesh.vehicle.Model.Vehicle;
import org.adesh.vehicle.Service.VehicleService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/vehicles")
public class VehicleController {

    @Autowired
    private VehicleService vehicleService;

    @PostMapping
    public Vehicle createVehicle(@RequestBody VehicleRequestDto dto) {
        return vehicleService.addVehicle(dto);
    }
}

