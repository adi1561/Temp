UPDATE ASCII_CONFIG 
SET 
    -- 1. MATH: Apply /1000 to EVERYTHING in Column 4 (Regex "^.*" matches all)
    OUTPUT_AMT_COL_LOGIC = '["^.*"][4][/1000]',

    -- 2. DECIMAL: Apply standard 'round' (HALF_UP) to EVERYTHING in Column 4
    -- This matches Oracle's ROUND() function perfectly.
    OUTPUT_AMT_DECIMAL = '["^.*"][4][round]',

    -- 3. PADDING: Standard 19-char padding
    OUTPUT_AMT_COL_PAD = '["^.*"][4][19,0]',

    -- 4. SIGN: No sign
    OUTPUT_AMT_SIGN = '["^.*"][4][NO_SIGN]'

WHERE ID = 102;

COMMIT;

