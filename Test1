import React, { useState, useEffect, useCallback } from "react";
import {
  Box,
  Typography,
  Grid,
  TextField,
  Button,
  Paper,
  IconButton,
  MenuItem,
  CircularProgress,
  Autocomplete,
  Tooltip,
  Checkbox,
  FormControlLabel,
  Chip,
  Stack,
  FormHelperText
} from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";
import { debounce } from "lodash";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const initialRowState = {
  id: Date.now(),
  branch: null,
  currency: "",
  cgl: null,
  amount: "",
  txnType: "",
  remarks: "",
  productCode: "",
};

const formatBigIntForDisplay = (val) => {
  if (typeof val !== "bigint") {
    val = BigInt(val || 0);
  }
  const str = val.toString().padStart(5, "0");
  const integer = str.slice(0, -4);
  const fractional = str.slice(-4);
  return `${integer || "0"}.${fractional}`;
};

export default function JournalPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [rows, setRows] = useState([initialRowState]);
  const [currencyOptions, setCurrencyOptions] = useState([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [commonBatchRemarks, setCommonBatchRemarks] = useState("");
  const [postingDate, setPostingDate] = useState("");
  const [checked, setChecked] = useState(false);

  // States to control search dropdown visibility to prevent empty tray on focus
  const [branchInputValues, setBranchInputValues] = useState({});
  const [cglInputValues, setCglInputValues] = useState({});

  const [branchSearch, setBranchSearch] = useState({
    loadingId: null,
    options: [],
  });
  const [cglSearch, setCglSearch] = useState({ 
    loadingId: null, 
    options: [] 
  });

  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        const dateResponse = await callApi(
          "/JS/journals/current-posting-date",
          null,
          "GET"
        );

        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            const formattedDate = `${day}-${month}-${year}`;
            setPostingDate(formattedDate);
          } catch (e) { 
            setPostingDate(dateResponse);
          }
        } else {
          showSnackBar("Failed to load official posting date.", "error");
          setPostingDate("Error");
        }

        const currencyResponse = await callApi("/CM/common-master/currency", null, "GET");
        if (currencyResponse?.success && Array.isArray(currencyResponse.data)) {
          const uniqueCurrencies = [...new Set(currencyResponse.data)];
          setCurrencyOptions(uniqueCurrencies);
        } else {
          showSnackBar("Failed to load currencies.", "error");
        }
      } catch (error) {
        showSnackBar("An error occurred while loading page data.", "error");
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);

  // Professional input filtering logic
  const filterRemarks = (val) => {
    // Allows only a-z, A-Z, 0-9 and spaces
    return val.replace(/[^a-zA-Z0-9 ]/g, "");
  };

  const isRemarksLengthValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];

    if (
      !lastRow.branch ||
      !lastRow.currency ||
      !lastRow.cgl ||
      !lastRow.amount ||
      !lastRow.txnType
    ) {
      showSnackBar(
        "Please fill all required fields (*) in the current row before adding a new one.",
        "warning"
      );
      return;
    }

    const newRow = {
      ...initialRowState,
      id: Date.now(),
      remarks: checked ? commonBatchRemarks : "",
    };
    setRows([...rows, newRow]);
  };
  
  const handleRemarksSyncChange = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);

    if (isChecked) {
      setRows(rows.map((row) => ({ ...row, remarks: commonBatchRemarks })));
    } else {
      setRows(rows.map((row) => ({ ...row, remarks: "" })));
    }
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) {
      setRows(rows.filter((row) => row.id !== id));
      // Cleanup input value tracking
      const newBranchInputs = { ...branchInputValues };
      delete newBranchInputs[id];
      setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues };
      delete newCglInputs[id];
      setCglInputValues(newCglInputs);
    } else {
      showSnackBar("Cannot delete the first row.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    const newRows = rows.map((row) => {
      if (row.id === id) {
        return { ...row, [field]: value };
      }
      return row;
    });
    setRows(newRows);
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length === 0) {
        setBranchSearch({ loadingId: null, options: [] });
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(
          `/JS/branches-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );
        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        setBranchSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length === 0) {
        setCglSearch({ loadingId: null, options: [] });
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));
      try { 
        const response = await callApi(
          `/JS/cgl-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );
        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi]
  );

  const handleSubmit = async () => {
    if (!isRemarksLengthValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks are compulsory (2-30 characters).", "error");
      return;
    }

    setIsSubmitting(true);

    const cglCheck = new Map();
    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch ||
        !row.currency ||
        !row.cgl ||
        !row.amount ||
        !row.txnType ||
        !isRemarksLengthValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has invalid remarks. Please fill all required fields (*) and ensure remarks are 2-30 characters.`,
          "error"
        );
        setIsSubmitting(false);
        return;
      }

      const branchCode = row.branch.code;
      const branchName = row.branch.name;
      const currency = row.currency;

      // Duplicate Check
      const key = `${branchCode}-${currency}`;
      const cgl = row.cgl.cglNumber;
      if (!cglCheck.has(key)) cglCheck.set(key, new Set());
      const cglSet = cglCheck.get(key);
      if (cglSet.has(cgl)) {
        showSnackBar(`Duplicate CGL entry: "${cgl}" is used more than once for branch "${branchName}" and currency "${currency}".`, "error");
        setIsSubmitting(false);
        return;
      }
      cglSet.add(cgl);

      // Memo Logic
      const isMemo = String(cgl).startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (row.amount || "0").split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, {
          totalDebit: 0n,
          totalCredit: 0n,
          branchName: branchName,
          branchCode: branchCode,
          currency: currency,
          type: type,
        });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {
        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false, branchName: branchName });
      }
      const branchCheck = branchEntryCheck.get(branchCode);
      if (row.txnType === "Debit" && amountAsBigInt > 0n) branchCheck.hasDebit = true;
      else if (row.txnType === "Credit" && amountAsBigInt > 0n) branchCheck.hasCredit = true;

      rowPayloads.push({
        branch: branchCode,
        currency: currency,
        cgl: cgl,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
      });
    }

    // Branch-level Debit/Credit validation
    for (const [branchCode, totals] of branchEntryCheck.entries()) {
      if (!totals.hasDebit || !totals.hasCredit) {
        showSnackBar(`Submission failed. Branch "${totals.branchName}" (${branchCode}) must have at least one Debit and one Credit entry.`, "error");
        setIsSubmitting(false);
        return;
      }
    }

    // Bucket balance validation
    for (const totals of branchCurrencyTotals.values()) {
      if (totals.totalDebit !== totals.totalCredit) {
        showSnackBar(
          `Submission failed. Totals for ${totals.type} entries in branch "${totals.branchName}" and currency "${totals.currency}" do not match.`,
          "error"
        );
        setIsSubmitting(false);
        return;
      }
    }

    try {
      const response = await callApi("/JS/journals/create-batch", { commonBatchRemarks: commonBatchRemarks.trim(), rows: rowPayloads }, "POST");
      showSnackBar(`Journal entries submitted successfully! Batch ID: ${response?.[0]?.batchId || "N/A"}`, "success");
      setRows([{ ...initialRowState, id: Date.now() }]);
      setCommonBatchRemarks("");
      setChecked(false);
      setBranchInputValues({});
      setCglInputValues({});
    } catch (error) {
      showSnackBar("Journal Batch submission failed", "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Box sx={{ p: 3, maxWidth: "98%" }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: "12px" }}>
        <Box sx={{ mb: 2 }}>
          <Stack direction="row" spacing={1} alignItems="center">
            <Typography variant="body1" fontWeight="bold">Posting Date:</Typography>
            <Typography variant="body1" color="primary" fontWeight="bold">{postingDate}</Typography>
          </Stack>
          <Typography variant="caption" color="error" sx={{ fontWeight: 500 }}>
            Note: All journals will be posted on this date.
          </Typography>
        </Box>

        <Grid container spacing={1} sx={{ mb: 3 }}>
          <Grid item xs={12} md={8}>
            <TextField
              label="Common Batch Remarks *"
              value={commonBatchRemarks}
              onChange={(e) => {
                const newValue = filterRemarks(e.target.value);
                if (newValue.length <= 30) {
                  setCommonBatchRemarks(newValue);
                  if (checked) {
                    setRows(rows.map((row) => ({ ...row, remarks: newValue })));
                  }
                }
              }}
              fullWidth
              required
              multiline
              rows={1}
              inputProps={{ maxLength: 30 }}
              error={commonBatchRemarks.length > 0 && !isRemarksLengthValid(commonBatchRemarks)}
            />
            <FormHelperText sx={{ color: "text.secondary" }}>
              Allowed: 2-30 characters (alphabets, numbers, and spaces only)
            </FormHelperText>
            <FormControlLabel
              control={
                <Checkbox
                  checked={checked}
                  onChange={handleRemarksSyncChange}
                  color="primary"
                  disabled={!isRemarksLengthValid(commonBatchRemarks)}
                />
              }
              label="Apply this remark to all transactions below"
            />
          </Grid>
        </Grid>

        <Box>
          {rows.map((row, index) => (
            <React.Fragment key={row.id}>
              <Grid container spacing={2} alignItems="flex-start" sx={{ mb: 1 }}>
                {/* Branch Search */}
                <Grid item xs={12} md={2.5}>
                  <Autocomplete
                    open={Boolean(branchInputValues[row.id] && branchInputValues[row.id].length > 0)}
                    onClose={() => setBranchInputValues(prev => ({...prev, [row.id]: ""}))}
                    autoHighlight
                    options={branchSearch.options}
                    getOptionLabel={(option) => `${option.code} - ${option.name}`}
                    value={row.branch}
                    onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
                    onInputChange={(event, newInputValue) => {
                      setBranchInputValues(prev => ({...prev, [row.id]: newInputValue}));
                      searchBranches(newInputValue, row.id);
                    }}
                    loading={branchSearch.loadingId === row.id}
                    filterOptions={(x) => x}
                    renderInput={(params) => (
                      <TextField
                        {...params}
                        label="Branch *"
                        placeholder="Type to search..."
                        InputLabelProps={{ shrink: true }}
                        InputProps={{
                          ...params.InputProps,
                          endAdornment: (
                            <React.Fragment>
                              {branchSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                              {params.InputProps.endAdornment}
                            </React.Fragment>
                          ),
                        }}
                      />
                    )}
                  />
                </Grid>

                {/* Currency Selection */}
                <Grid item xs={12} md={1.2}>
                  <TextField
                    select
                    label="Currency *"
                    value={row.currency}
                    onChange={(e) => handleRowChange(row.id, "currency", e.target.value)}
                    fullWidth
                    SelectProps={{
                      MenuProps: {
                        anchorOrigin: { vertical: "bottom", horizontal: "left" },
                        transformOrigin: { vertical: "top", horizontal: "left" },
                        PaperProps: { style: { maxHeight: 250 } }
                      }
                    }}
                  >
                    {currencyOptions.map((c) => (
                      <MenuItem key={c} value={c}>{c}</MenuItem>
                    ))}
                  </TextField>
                </Grid>

                {/* CGL Search */}
                <Grid item xs={12} md={2.2}>
                  <Autocomplete
                    open={Boolean(cglInputValues[row.id] && cglInputValues[row.id].length > 0)}
                    onClose={() => setCglInputValues(prev => ({...prev, [row.id]: ""}))}
                    autoHighlight
                    options={cglSearch.options}
                    getOptionLabel={(option) => `${option.cglNumber} - ${option.description}`}
                    value={row.cgl}
                    onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                    onInputChange={(event, newInputValue) => {
                      setCglInputValues(prev => ({...prev, [row.id]: newInputValue}));
                      searchCgls(newInputValue, row.id);
                    }}
                    loading={cglSearch.loadingId === row.id}
                    filterOptions={(x) => x}
                    renderInput={(params) => (
                      <TextField
                        {...params}
                        label="CGL *"
                        placeholder="Type to search..."
                        InputLabelProps={{ shrink: true }}
                        InputProps={{
                          ...params.InputProps,
                          endAdornment: (
                            <Box sx={{ display: "flex", alignItems: "center" }}>
                              {row.cgl && String(row.cgl.cglNumber).startsWith("5") && (
                                <Chip label="MEMO" size="small" color="warning" sx={{ height: 20, fontSize: "0.65rem", mr: 0.5 }} />
                              )}
                              {cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                              {params.InputProps.endAdornment}
                            </Box>
                          ),
                        }}
                      />
                    )}
                  />
                </Grid>

                {/* Amount */}
                <Grid item xs={12} md={1.4}>
                  <TextField
                    label="Amount *"
                    value={row.amount}
                    onChange={(e) => {
                      const val = e.target.value;
                      if (/^\d{0,21}(\.\d{0,4})?$/.test(val)) handleRowChange(row.id, "amount", val);
                    }}
                    fullWidth
                    placeholder="0.0000"
                  />
                </Grid>

                {/* Transaction Type */}
                <Grid item xs={12} md={1}>
                  <TextField
                    select
                    label="Type *"
                    value={row.txnType}
                    onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)}
                    fullWidth
                  >
                    <MenuItem value="Debit">Debit</MenuItem>
                    <MenuItem value="Credit">Credit</MenuItem>
                  </TextField>
                </Grid>

                {/* Product Code */}
                <Grid item xs={12} md={1.2}>
                  <TextField
                    label="Product"
                    value={row.productCode}
                    onChange={(e) => {
                      if (/^\d{0,8}$/.test(e.target.value)) handleRowChange(row.id, "productCode", e.target.value);
                    }}
                    fullWidth
                    inputProps={{ maxLength: 8 }}
                  />
                </Grid>

                {/* Individual Remarks */}
                <Grid item xs={12} md={2}>
                  <TextField
                    label="Remarks *"
                    value={row.remarks}
                    onChange={(e) => {
                      const newValue = filterRemarks(e.target.value);
                      if (newValue.length <= 30) handleRowChange(row.id, "remarks", newValue);
                    }}
                    fullWidth
                    disabled={checked}
                    inputProps={{ maxLength: 30 }}
                    error={row.remarks.length > 0 && !isRemarksLengthValid(row.remarks)}
                  />
                  <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary" }}>
                    Allowed: 2-30 chars (A-Z, 0-9)
                  </Typography>
                </Grid>

                {/* Delete Action */}
                <Grid item xs={12} md={0.5} sx={{ textAlign: "center", pt: 1 }}>
                  <IconButton onClick={() => handleDeleteRow(row.id)} color="error" size="small">
                    <DeleteIcon />
                  </IconButton>
                </Grid>
              </Grid>

              {index < rows.length - 1 && (
                <Box sx={{ borderBottom: 1, borderColor: "divider", my: 2 }} />
              )}
            </React.Fragment>
          ))}

          <Box sx={{ mt: 4, display: "flex", gap: 2, justifyContent: "flex-end" }}>
            <Button variant="outlined" startIcon={<AddIcon />} onClick={handleAddRow}>
              Add Row
            </Button>

            <Button
              variant="contained"
              color="success"
              onClick={handleSubmit}
              disabled={isSubmitting || !isRemarksLengthValid(commonBatchRemarks)}
            >
              {isSubmitting ? <CircularProgress size={24} /> : "Submit Journal"}
            </Button>
          </Box>
        </Box>
      </Paper>
    </Box>
  );
}
