You are absolutely right. The issue is that BigDecimal.toPlainString() includes the negative sign (e.g., "-123.45") at the start of the string. When we padded it, the sign got "trapped" inside the zeros (e.g., 000-123.45), which is wrong.
To fix this, we must:
 * Strip the sign (take Absolute Value) before padding, so we get a clean number like 000123.45.
 * Append the sign at the end (back) based on your specific rules.
Here is the fixed RuleParser.java.
🛠️ Key Changes
 * applyAmountPadding: Added amount.abs() to ensure we only format the positive number (removing any front -).
 * applySign:
   * NO_SIGN: Returns the clean number (Absolute Value).
   * SHOW_SIGN: Adds + or - at the end.
   * Default: Adds - at the end if negative.
Updated File: RuleParser.java
package com.tcs.fincore.AsciiGenerationService.Service;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RuleParser {

    private static final Pattern RULE_PATTERN = Pattern.compile("\\[\"(.*?)\"\\]\\[(.*?)\\]\\[(.*?)\\]");

    public static BigDecimal applyMathLogic(BigDecimal amount, String head, int colIdx, String logicConfig) {
        if (logicConfig == null) return amount;
        String logic = findFirstMatchingRule(head, colIdx, logicConfig);
        if (logic == null) return amount;

        if (logic.contains("/")) {
            BigDecimal divisor = new BigDecimal(logic.replaceAll("[^0-9.]", ""));
            return amount.divide(divisor, 6, RoundingMode.HALF_UP);
        } else if (logic.contains("*")) {
            BigDecimal multiplier = new BigDecimal(logic.replace("*", "").replace("(", "").replace(")", ""));
            return amount.multiply(multiplier);
        }
        return amount;
    }

    public static BigDecimal applyDecimalLogic(BigDecimal amount, String head, int colIdx, String decimalConfig) {
        if (decimalConfig == null) return amount;
        
        Matcher m = RULE_PATTERN.matcher(decimalConfig);
        while (m.find()) {
            String headRegex = m.group(1);
            String colReq = m.group(2);
            String rule = m.group(3);

            boolean colMatch = colReq.isEmpty() || colReq.equals(String.valueOf(colIdx));
            boolean headMatch = Pattern.compile(headRegex).matcher(head).lookingAt();

            if (colMatch && headMatch) {
                if (rule.equalsIgnoreCase("floor")) {
                    amount = amount.setScale(0, RoundingMode.FLOOR);
                } else if (rule.equalsIgnoreCase("ceil")) {
                    amount = amount.setScale(0, RoundingMode.CEILING);
                } else if (rule.equalsIgnoreCase("round")) {
                    amount = amount.setScale(0, RoundingMode.HALF_UP);
                } else if (rule.equalsIgnoreCase("down")) {
                    amount = amount.setScale(0, RoundingMode.DOWN); 
                } else {
                    try {
                        int scale = Integer.parseInt(rule);
                        amount = amount.setScale(scale, RoundingMode.HALF_UP);
                    } catch (NumberFormatException e) {}
                }
            }
        }
        return amount;
    }

    // --- FIX 1: Always format the ABSOLUTE value (Remove sign from front) ---
    public static String applyAmountPadding(BigDecimal amount, String head, int colIdx, String padConfig) {
        // Use Absolute Value to prevent "-123" becoming "000-123"
        BigDecimal absAmount = amount.abs();
        
        if (padConfig == null) return absAmount.toPlainString();
        String rule = findFirstMatchingRule(head, colIdx, padConfig);
        if (rule == null) return absAmount.toPlainString();

        if (rule.contains(",")) {
            String[] parts = rule.split(",");
            int totalLen = Integer.parseInt(parts[0]);
            int decimalLen = Integer.parseInt(parts[1]);
            
            BigDecimal scaled = absAmount.setScale(decimalLen, RoundingMode.HALF_UP);
            String raw = scaled.toPlainString(); 
            
            return padLeft(raw, totalLen, '0');
        } else {
            int totalLen = Integer.parseInt(rule);
            String raw = absAmount.toBigInteger().toString(); 
            return padLeft(raw, totalLen, '0');
        }
    }

    // --- FIX 2: Strict Back-End Sign Placement ---
    public static String applySign(String fmtAmt, BigDecimal origAmt, String head, int colIdx, String signConfig) {
        // fmtAmt is already "clean" (no sign, just numbers)
        
        if (signConfig == null) {
            // Default: If negative, append "-" at BACK. If positive, nothing.
            return (origAmt.compareTo(BigDecimal.ZERO) < 0) ? fmtAmt + "-" : fmtAmt;
        }

        String rule = findFirstMatchingRule(head, colIdx, signConfig);
        
        // CASE: NO_SIGN -> Return clean string (Absolute value)
        if ("NO_SIGN".equalsIgnoreCase(rule)) {
            return fmtAmt;
        }
        
        // CASE: SHOW_SIGN -> Always append + or - at BACK
        if ("SHOW_SIGN".equalsIgnoreCase(rule)) {
            return fmtAmt + (origAmt.compareTo(BigDecimal.ZERO) >= 0 ? "+" : "-");
        }
        
        // CASE: POS_0 -> Append 0 for positive, - for negative
        if ("POS_0".equalsIgnoreCase(rule)) {
            return fmtAmt + (origAmt.compareTo(BigDecimal.ZERO) >= 0 ? "0" : "-");
        }
        
        // CASE: Default (Rule defined but not matched above)
        // Standard logic: 123.00- for negative, 123.00 for positive
        return (origAmt.compareTo(BigDecimal.ZERO) < 0) ? fmtAmt + "-" : fmtAmt;
    }

    public static boolean shouldIncludeValue(BigDecimal amount, String head, int colIdx, String includeConfig) {
        if (includeConfig == null) return true;
        String rule = findFirstMatchingRule(head, colIdx, includeConfig);
        
        if (rule == null || "ALWAYS".equalsIgnoreCase(rule)) return true;
        
        if (rule.equals(">0")) return amount.compareTo(BigDecimal.ZERO) > 0;
        if (rule.equals("<0")) return amount.compareTo(BigDecimal.ZERO) < 0;
        if (rule.equals("=0") || rule.equals("0")) return amount.compareTo(BigDecimal.ZERO) == 0;
        if (rule.equals("!=0")) return amount.compareTo(BigDecimal.ZERO) != 0;
        
        return true;
    }

    public static String applyHeadPadding(String head, String padConfig) {
        if (padConfig == null || padConfig.length() < 3) return head;
        int len = Integer.parseInt(padConfig.substring(0, padConfig.length() - 2));
        char dir = padConfig.charAt(padConfig.length() - 2);
        char pad = padConfig.endsWith("\" \"") ? ' ' : padConfig.charAt(padConfig.length() - 1);
        return dir == 'L' ? padLeft(head, len, pad) : padRight(head, len, pad);
    }

    private static String findFirstMatchingRule(String head, int colIdx, String configStr) {
        if (configStr == null || configStr.isEmpty()) return null;
        Matcher m = RULE_PATTERN.matcher(configStr);
        while (m.find()) {
            String headRegex = m.group(1);
            String colReq = m.group(2);
            String logic = m.group(3);
            boolean colMatch = colReq.isEmpty() || colReq.equals(String.valueOf(colIdx));
            boolean headMatch = Pattern.compile(headRegex).matcher(head).lookingAt();
            if (colMatch && headMatch) return logic;
        }
        return null;
    }

    private static String padLeft(String str, int len, char pad) {
        StringBuilder sb = new StringBuilder();
        while (sb.length() + str.length() < len) sb.append(pad);
        return sb.append(str).toString();
    }
    private static String padRight(String str, int len, char pad) {
        StringBuilder sb = new StringBuilder(str);
        while (sb.length() < len) sb.append(pad);
        return sb.toString();
    }
}

