import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Button,
  Typography,
  CircularProgress,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  TablePagination,
  Dialog,
  DialogTitle,
  DialogContent,
  IconButton
} from "@mui/material";
import { 
  PlayArrow as PlayArrowIcon, 
  Close as CloseIcon 
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// --- API Constants ---
const TRIGGER_API_URL = "/PS/airflow/trigger";
const INITIAL_DATA_URL = "/PS/process/processes/data/7";
const SUMMARY_API_URL = "/YE/yearend/summary/circle-wise";

export default function TransferDataLho() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);

  // Main table states
  const [isTransferring, setIsTransferring] = useState(false);
  const [tableData, setTableData] = useState([]);
  const [fincoreDate, setFincoreDate] = useState(null);

  // Main Table Pagination - Set to 10 as requested
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  // Summary popup states
  const [summaryOpen, setSummaryOpen] = useState(false);
  const [summaryData, setSummaryData] = useState([]); 
  const [summaryLoading, setSummaryLoading] = useState(false);

  // Summary Pagination States
  const [summaryPage, setSummaryPage] = useState(0);
  const [summaryRowsPerPage, setSummaryRowsPerPage] = useState(5);

  // ---------------- FETCH INITIAL DATA ----------------
  const fetchInitialData = async () => {
    try {
      const response = await callApi(INITIAL_DATA_URL, null, "GET");
      if (isMounted.current && response) {
        setFincoreDate(response.fincoreDate);
        setTableData(response.initialData || []);
      }
    } catch (error) {
      console.error("Error fetching initial data:", error);
    }
  };

  useEffect(() => {
    isMounted.current = true;
    fetchInitialData();
    return () => {
      isMounted.current = false;
    };
  }, []);

  // ---------------- TRANSFER BUTTON ----------------
  const handleTransferLho = async () => {
    setIsTransferring(true);
    const payload = {
      dagId: "cbs_wrap_dag",
      conf: {},
      remarks: "oii;;;p",
      processId: 7
    };
    try {
      await callApi(TRIGGER_API_URL, payload, "POST");
      showSnackBar("LHO Transfer triggered successfully", "success");
    } catch (error) {
      showSnackBar("Failed to trigger LHO Transfer", "error");
    } finally {
      setIsTransferring(false);
    }
  };

  // ---------------- GET SUMMARY ----------------
  const handleGetSummary = async () => {
    setSummaryOpen(true);
    setSummaryLoading(true);
    setSummaryData([]);
    setSummaryPage(0);

    try {
      const response = await callApi(SUMMARY_API_URL, null, "GET");
      const actualData = Array.isArray(response) 
        ? response 
        : (response && Array.isArray(response.data) ? response.data : []);
      setSummaryData(actualData);
    } catch (error) {
      showSnackBar("Failed to fetch summary", "error");
      setSummaryData([]);
    } finally {
      setSummaryLoading(false);
    }
  };

  return (
    <Box p={3} width="100%">
      {/* Transfer Button */}
      <Box display="flex" justifyContent="flex-end" mb={2}>
        <Button
          variant="contained"
          startIcon={isTransferring ? <CircularProgress size={20} color="inherit" /> : <PlayArrowIcon />}
          onClick={handleTransferLho}
          disabled={isTransferring}
        >
          {isTransferring ? "Transferring..." : "Transfer LHO"}
        </Button>
      </Box>

      {/* MAIN TABLE */}
      <TableContainer component={Paper}>
        <Table>
          <TableHead>
            <TableRow>
              <TableCell align="center"><strong>Process Run ID</strong></TableCell>
              <TableCell align="center"><strong>Process ID</strong></TableCell>
              <TableCell align="center"><strong>ETL Date</strong></TableCell>
              <TableCell align="center"><strong>Run ID</strong></TableCell>
              <TableCell align="center"><strong>Process Type</strong></TableCell>
              <TableCell align="center"><strong>Action</strong></TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {Array.isArray(tableData) && tableData
              .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
              .map((row, index) => (
                <TableRow key={index}>
                  <TableCell align="center">{row.processRunId}</TableCell>
                  <TableCell align="center">{row.processId}</TableCell>
                  <TableCell align="center">{row.etlDate}</TableCell>
                  <TableCell align="center">{row.runId}</TableCell>
                  <TableCell align="center">{row.processType}</TableCell>
                  <TableCell align="center">
                    <Button variant="outlined" size="small" onClick={handleGetSummary}>
                      Get Summary
                    </Button>
                  </TableCell>
                </TableRow>
              ))}
          </TableBody>
        </Table>
        <TablePagination
          component="div"
          count={tableData.length}
          page={page}
          onPageChange={(e, newPage) => setPage(newPage)}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={(e) => {
            setRowsPerPage(parseInt(e.target.value, 10));
            setPage(0);
          }}
          rowsPerPageOptions={[10, 25, 50]}
        />
      </TableContainer>

      {/* ---------------- SUMMARY POPUP ---------------- */}
      <Dialog
        open={summaryOpen}
        onClose={() => setSummaryOpen(false)}
        fullWidth
        maxWidth="md"
        // Prevent dialog from closing when clicking outside
        disableEscapeKeyDown
      >
        <DialogTitle sx={{ m: 0, p: 2, fontWeight: 'bold' }}>
          Circle Wise Summary
          <IconButton
            aria-label="close"
            onClick={() => setSummaryOpen(false)}
            sx={{
              position: 'absolute',
              right: 8,
              top: 8,
              color: (theme) => theme.palette.grey[500],
            }}
          >
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        
        <DialogContent dividers sx={{ minHeight: '400px' }}> {/* Fixed minHeight makes it static */}
          {summaryLoading ? (
            <Box display="flex" justifyContent="center" alignItems="center" height="300px">
              <CircularProgress />
            </Box>
          ) : (
            <>
              <TableContainer component={Paper} sx={{ mb: 1, minHeight: '320px' }}>
                <Table size="small" stickyHeader>
                  <TableHead>
                    <TableRow>
                      <TableCell align="center"><strong>Transfer Date</strong></TableCell>
                      <TableCell align="center"><strong>Branch Code</strong></TableCell>
                      <TableCell align="center"><strong>Balance</strong></TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {Array.isArray(summaryData) && summaryData.length > 0 ? (
                      summaryData
                        .slice(summaryPage * summaryRowsPerPage, summaryPage * summaryRowsPerPage + summaryRowsPerPage)
                        .map((row, index) => (
                          <TableRow key={index} sx={{ height: '45px' }}> {/* Fixed row height */}
                            <TableCell align="center">{row.transferDate}</TableCell>
                            <TableCell align="center">{row.circleBranchCode}</TableCell>
                            <TableCell
                              align="center"
                              sx={{
                                color: row.totalProfitLoss < 0 ? "error.main" : "success.main",
                                fontWeight: 600
                              }}
                            >
                              {row.totalProfitLoss}
                            </TableCell>
                          </TableRow>
                        ))
                    ) : (
                      <TableRow>
                        <TableCell colSpan={3} align="center">No Data Available</TableCell>
                      </TableRow>
                    )}
                  </TableBody>
                </Table>
              </TableContainer>
              
              <TablePagination
                component="div"
                count={summaryData.length}
                page={summaryPage}
                onPageChange={(e, newPage) => setSummaryPage(newPage)}
                rowsPerPage={summaryRowsPerPage}
                onRowsPerPageChange={(e) => {
                  setSummaryRowsPerPage(parseInt(e.target.value, 10));
                  setSummaryPage(0);
                }}
                rowsPerPageOptions={[5, 10]}
              />

              <Box display="flex" justifyContent="flex-end" mt={2}>
                <Button
                  variant="contained"
                  onClick={() => {
                    showSnackBar("Submitted Successfully", "success");
                    setSummaryOpen(false);
                  }}
                >
                  Submit
                </Button>
              </Box>
            </>
          )}
        </DialogContent>
      </Dialog>
    </Box>
  );
}
