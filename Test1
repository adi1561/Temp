        } catch (DataAccessException e) {
            redisTemplate.delete(lockKey);
            log.error("BATCH_START_ERROR | ReqID: {} | Message: {}", requestId, e.getMessage());
            throw e;
        }
    }

    /**
     * ASYNCHRONOUS ORCHESTRATOR
     * Parallelizes data ingestion by splitting cached records into chunks for concurrent JDBC inserts.
     */
    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchCreation(String batchId, String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        MDC.put("batchId", batchId);
        log.info("BATCH_CREATION_START | BatchID: {} | SourceReqID: {} | User: {}", batchId, requestId, creatorId);

        try {
            List<ExcelRowData> cachedRows = journalBulkValidationService.getValidRowsFromCache(requestId);
            if (cachedRows == null || cachedRows.isEmpty()) {
                log.error("DATA_LOST | BatchID: {} | Reason: CACHE_MISSING", batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired.");
                return;
            }

            int totalRows = cachedRows.size();
            int batchSize = 5000;
            LongAdder totalDebit = new LongAdder();
            LongAdder totalCredit = new LongAdder();
            AtomicInteger completedChunks = new AtomicInteger(0);
            int totalChunks = (int) Math.ceil((double) totalRows / batchSize);

            List<CompletableFuture<Void>> futures = new ArrayList<>();
            for (int i = 0; i < totalRows; i += batchSize) {
                final int startIdx = i;
                final int endIdx = Math.min(i + batchSize, totalRows);
                final List<ExcelRowData> chunk = cachedRows.subList(startIdx, endIdx);

                CompletableFuture<Void> future = CompletableFuture.runAsync(() ->
                        processChunkRaw(chunk, batchId, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit), bulkExecutor)
                        .thenRun(() -> {
                            int done = completedChunks.incrementAndGet();
                            int percent = 5 + (done * 90 / totalChunks);
                            progressService.sendProgress(batchId, creatorId, percent, "PROCESSING", "Persisting record chunk " + done);
                        });
                futures.add(future);
            }
            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            String sumSql = "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
            jdbcTemplate.update(sumSql, batchId, creatorId, ts, commonRemarks, totalRows,
                    BigDecimal.valueOf(totalDebit.sum()), BigDecimal.valueOf(totalCredit.sum()), "PENDING");

            log.info("BATCH_CREATION_SUCCESS | BatchID: {} | RowsProcessed: {}", batchId, totalRows);
            progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Journal batch created successfully.");

        } catch (CompletionException | DataAccessException e) {
            log.error("BATCH_PROCESS_FATAL | BatchID: {} | Error: {}", batchId, e.getMessage());
            cleanupFailedBatch(batchId);
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = 'Internal processing failure' WHERE BATCH_ID = ?", batchId);
            progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Critical error during data persistence.");
        } finally {
            redisTemplate.delete("LOCK_REQ_" + requestId);
            MDC.clear();
        }
    }

    /**
     * RAW JDBC BATCH INSERTION
     * Direct database communication bypassing the Persistence Context for maximum throughput.
     */
    private void processChunkRaw(List<ExcelRowData> chunk, String batchId, String commonRemarks, String creatorId, Integer creatorRole, int globalOffset, LongAdder debit, LongAdder credit) {
        String sql = "INSERT INTO JOURNAL_REQUEST (REQ_ID, REQ_STATUS, REQ_DATE, CREATOR_ID, CREATOR_ROLE, BATCH_ID, JOURNAL_ID, COMMON_BATCH_REMARKS, PAYLOAD, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_CSV_DATE, REQ_NARRATION, REQ_PRODUCT) VALUES (JOURNAL_REQUEST_SEQ.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

        try (Connection conn = dataSource.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            conn.setAutoCommit(false);
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());

            for (int i = 0; i < chunk.size(); i++) {
                ExcelRowData r = chunk.get(i);
                int globalIdx = globalOffset + i + 1;
                String jId = batchId + "-" + globalIdx;
                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                boolean isCredit = "Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType);
                BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                if (isCredit) credit.add(absAmt.longValue()); else debit.add(absAmt.longValue());

                ps.setString(1, "P");
                ps.setTimestamp(2, ts);
                ps.setString(3, creatorId);
                ps.setInt(4, creatorRole != null ? creatorRole : 0);
                ps.setString(5, batchId);
                ps.setString(6, jId);
                ps.setString(7, commonRemarks);
                ps.setString(8, "{}"); // Payload logic simplified for snippet
                ps.setString(9, r.branch);
                ps.setString(10, r.currency);
                ps.setString(11, r.cgl);
                ps.setBigDecimal(12, signedAmt);
                ps.setDate(13, java.sql.Date.valueOf(r.sysDate.length() == 8 ? LocalDate.now() : LocalDate.now()));
                ps.setString(14, r.remarks);
                ps.setString(15, r.productCode);
                ps.addBatch();
            }
            ps.executeBatch();
            conn.commit();
        } catch (SQLException e) {
            log.error("SQL_CHUNK_FAIL | BatchID: {} | Offset: {} | SQLState: {}", batchId, globalOffset, e.getSQLState());
            throw new CustomExceptions.DatabaseOperationException("Failed to persist database chunk", e);
        }
    }

    private void cleanupFailedBatch(String batchId) {
        try {
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);
            jdbcTemplate.update("DELETE FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", batchId);
        } catch (DataAccessException e) {
            log.warn("CLEANUP_SKIP | BatchID: {} | Reason: {}", batchId, e.getMessage());
        }
    }

    @Override
    @Transactional
    public void processBulkRequestsAsync(BulkProcessJournalRequestDto dto, String executorId, Integer executorRole) {
        String lockSql = "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS = 'PENDING'";
        int updated = jdbcTemplate.update(lockSql, dto.getBatchId());

        if (updated == 0) {
            log.warn("RACE_CONDITION | BatchID: {} | Status: ALREADY_LOCKED", dto.getBatchId());
            throw new IllegalStateException("Batch is already being processed.");
        }
        log.info("APPROVAL_INIT | BatchID: {} | Executor: {}", dto.getBatchId(), executorId);
        self.executeAsyncBatchProcessing(dto, executorId);
    }

    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchProcessing(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        long start = System.currentTimeMillis();
        MDC.put("batchId", batchId);

        try {
            if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                log.info("DB_PROC_CALL | BatchID: {} | Status: ACCEPT_START", batchId);
                // Call PL/SQL logic...
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ACCEPTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP WHERE BATCH_ID = ?", 
                                     executorId, batchId);
                log.info("DB_PROC_SUCCESS | BatchID: {} | Duration: {}ms", batchId, (System.currentTimeMillis() - start));
            } else {
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED' WHERE BATCH_ID = ?", batchId);
                log.info("BATCH_REJECTED | BatchID: {} | User: {}", batchId, executorId);
            }
        } catch (DataAccessException e) {
            log.error("PROC_FATAL | BatchID: {} | Error: {}", batchId, e.getMessage());
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = 'Approval failure' WHERE BATCH_ID = ?", batchId);
        } finally {
            MDC.clear();
        }
    }

    @Override
    public LocalDate getCurrentPostingDate() {
        try {
            String sql = "SELECT USERS_DATE FROM FINCORE_DATE FETCH FIRST 1 ROWS ONLY";
            return jdbcTemplate.queryForObject(sql, (rs, rowNum) -> rs.getTimestamp(1).toLocalDateTime().toLocalDate());
        } catch (EmptyResultDataAccessException e) {
            log.warn("CONFIG_MISSING | Component: POSTING_DATE | Status: USING_SYSTEM_DATE");
            return LocalDate.now();
        } catch (CannotGetJdbcConnectionException e) {
            log.error("DB_UNAVAILABLE | Action: FETCH_DATE | Reason: {}", e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Critical database connection failure", e);
        }
    }

