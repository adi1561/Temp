@GetMapping("/search-pending")
public ResponseEntity<Page<JournalRequest>> searchPendingRequests(
        @RequestParam(required = false) String branch,
        @RequestParam(required = false) String cgl,
        @RequestParam(defaultValue = "0") int page,
        @RequestParam(defaultValue = "10") int size) {
    
    if (branch != null && !branch.isEmpty()) {
        return ResponseEntity.ok(service.searchPendingByBranchPrefix(branch, page, size));
    } else if (cgl != null && !cgl.isEmpty()) {
        return ResponseEntity.ok(service.searchPendingByCglPrefix(cgl, page, size));
    }
    
    return ResponseEntity.badRequest().build();
}

