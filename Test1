package com.tcs.fincore.CommonRequestService.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.Map;

@Slf4j
@Component
@RequiredArgsConstructor
public class LhoTransferStrategy implements RequestTypeStrategy {

    private final KafkaEventPublisherService kafkaEventPublisherService;
    private final ObjectMapper objectMapper;
    
    // --- NEW: Inject JdbcTemplate to run raw SQL commands ---
    private final JdbcTemplate jdbcTemplate;

    @Override
    public RequestType getRequestType() {
        return RequestType.LHO_TRANSFER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        log.info("Processing Approval for LHO Transfer Batch: {}", request.getTargetId());

        switch (request.getChangeType()) {
            case ADD:
                handleLhoApproval(request);
                break;
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " not supported for LHO.");
        }
    }

    private void handleLhoApproval(CommonReq request) throws JsonProcessingException {
        log.info("Constructing tailored Kafka payload for LHO targetId: {}", request.getTargetId());

        // 1. Parse the original payload to extract Airflow-specific IDs
        JsonNode originalPayload = objectMapper.readTree(request.getPayload());
        Long processRunId = originalPayload.has("processRunId") ? originalPayload.get("processRunId").asLong() : null;
        Long processId = originalPayload.has("processId") ? originalPayload.get("processId").asLong() : null;

        // 2. Build the exact payload required by the consumer
        Map<String, Object> customKafkaPayload = new HashMap<>();
        customKafkaPayload.put("requestId" , request.getId());
        customKafkaPayload.put("processRunId", processRunId);
        customKafkaPayload.put("processId", 12);
        customKafkaPayload.put("user", request.getExecutorId());
        customKafkaPayload.put("remarks", request.getExecutorRemarks());

        // 3. Convert back to a JSON string
        String finalPayloadString = objectMapper.writeValueAsString(customKafkaPayload);

        // 4. Trigger the event 
        kafkaEventPublisherService.publishLhoTransferEvent(request.getTargetId(), request.getId(), finalPayloadString);

        request.setReqStatus(RequestStatus.QUEUE);
        request.setExecutionRemarks("Event sent to Kafka. Request is in QUEUE.");

        log.info("LHO Transfer Batch {} placed in QUEUE successfully.", request.getTargetId());
    }

    // --- NEW: Implement processRejection to clear the table ---
    @Override
    public void processRejection(CommonReq request) {
        log.info("Processing Rejection for LHO Transfer Batch: {}. Clearing GL_TRANSITION table.", request.getTargetId());
        
        try {
            // BEST PRACTICE FOR TRANSACTIONAL SAFETY:
            // Use DELETE instead of TRUNCATE so it can be rolled back if the main transaction fails.
            String sql = "DELETE FROM GL_TRANSITION";
            
            // If you strictly need TRUNCATE (and accept the implicit commit risk), use this instead:
            // String sql = "TRUNCATE TABLE GL_TRANSITION";
            
            jdbcTemplate.execute(sql);
            
            log.info("Successfully cleared GL_TRANSITION table for rejected request: {}", request.getId());
            
        } catch (Exception e) {
            log.error("CRITICAL: Failed to clear GL_TRANSITION table during rejection of request: {}", request.getId(), e);
            // Throw a RuntimeException to ensure the Spring @Transactional rolls back the entire rejection
            throw new RuntimeException("Failed to clear GL_TRANSITION table on rejection", e);
        }
    }
}
