        '2148505007',
        '2148505010',
        '2148505011',
        '2148505014',
        '2148505016',
        '2148505018',
        '2148505019',
        '2148505021',
        '2148505022',
        '2148505024',
        '2148505033',
        '2148505035',
        '1260505002'
    )
ORDER BY
    CM.CIRCLE_NAME, -- Added sorting by Circle Name first for better report grouping
    T1.CGL, 
    T1.BRANCH_CODE,
    T1.CURRENCY


