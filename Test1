package com.tcs.fincore.LhoTransferService.controller;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.tcs.fincore.CommonRequestService.dto.ApiResponse;
import com.tcs.fincore.LhoTransferService.model.CommonReq;
import com.tcs.fincore.LhoTransferService.service.LhoTransferService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/lho-transfer")
@RequiredArgsConstructor
@Slf4j
public class LhoTransferController {

    private final LhoTransferService lhoTransferService;

    /**
     * Trigger the LHO Request Creation.
     * Expects payload: { "batchId": "BATCH_2023_001" }
     */
    @PostMapping("/trigger")
    public ResponseEntity<ApiResponse<CommonReq>> triggerLhoProcess(
            @RequestHeader("Authorization") String token, 
            @RequestBody Map<String, String> payload 
    ) throws JsonProcessingException {
        
        String batchId = payload.get("batchId");
        String userId = "USER_001"; // Extract from token in real implementation

        log.info("Trigger received for Batch: {}", batchId);
        
        CommonReq request = lhoTransferService.createLhoTransferRequest(batchId, userId);
        
        return ResponseEntity.ok(ApiResponse.success(request, "LHO Transfer Request Generated Successfully"));
    }

    /**
     * Get Pending Requests for the Approval Screen.
     */
    @GetMapping("/pending")
    public ResponseEntity<ApiResponse<List<CommonReq>>> getPendingRequests() {
        List<CommonReq> requests = lhoTransferService.getPendingLhoRequests();
        return ResponseEntity.ok(ApiResponse.success(requests));
    }
}

