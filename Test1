package com.fincore.ReportService.util;

import jakarta.annotation.PostConstruct;
import lombok.extern.slf4j.Slf4j;
import org.apache.hadoop.fs.FileSystem;
import org.apache.hadoop.fs.Path;
import org.springframework.stereotype.Component;

import java.io.IOException;

@Component
@Slf4j
public class HadoopConnectivityTester {

    // 1. Inject the FileSystem bean directly.
    // Spring has already configured this (Simple vs HA) in HadoopConfig.java.
    // We don't need to manually read properties or create new connections.
    private final FileSystem fileSystem;

    public HadoopConnectivityTester(FileSystem fileSystem) {
        this.fileSystem = fileSystem;
    }

    @PostConstruct
    public void testHdfsConnection() {
        log.info("STARTUP TEST: Verifying HDFS connection...");

        try {
            // 2. Perform a lightweight check
            Path rootPath = new Path("/");
            
            // We use the injected bean. If this works, the whole app works.
            if (fileSystem.exists(rootPath)) {
                log.info("✅ HDFS CONNECTION SUCCESS");
                log.info("   - URI: {}", fileSystem.getUri());
                log.info("   - Home Directory: {}", fileSystem.getHomeDirectory());
                log.info("   - Default Block Size: {}", fileSystem.getDefaultBlockSize(rootPath));
            } else {
                log.error("❌ HDFS CONNECTION FAILURE: Root path '/' was not found.");
            }

        } catch (IOException | IllegalArgumentException e) {
            log.error("❌ HDFS CONNECTION ERROR: Could not talk to the FileSystem.", e);
            // Optional: throw new RuntimeException("HDFS is down, stopping app"); 
        }
    }
}
