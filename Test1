  position: "relative",
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  alignItems: "center",
  border: 2,
  borderStyle: "dashed",
  borderColor: "primary.main",
  borderRadius: "12px",
  padding: "60px 40px 40px 40px",
  cursor: "default", // Changed from pointer to default as the box is no longer clickable
