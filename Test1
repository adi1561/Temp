package com.tcs.fincore.AsciiGenerationService.Service;

import com.tcs.fincore.AsciiGenerationService.Config.AsciiPathConfig;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Pattern;

@Service
public class YsaGenerationService {

    private final AsciiPathConfig asciiConfig;
    private final Pattern numericPattern = Pattern.compile("-?\\d+(\\.\\d+)?");

    public YsaGenerationService(AsciiPathConfig asciiConfig) {
        this.asciiConfig = asciiConfig;
    }

    public String processYsaReport() throws IOException {
        System.out.println(">>> STARTING YSA PROCESS >>>");
        
        // 1. Resolve Path Safely
        String inputPathStr = asciiConfig.getSourceFilePath();
        if (inputPathStr == null || inputPathStr.isEmpty()) {
            throw new IOException("❌ Input file path is NULL in config!");
        }
        
        Path inputPath = Paths.get(inputPathStr).toAbsolutePath(); // FIX: Force absolute path
        System.out.println("Reading file from: " + inputPath);

        if (!Files.exists(inputPath)) {
            throw new IOException("❌ Input file NOT FOUND at: " + inputPath);
        }

        // 2. Read File
        List<String> lines = Files.readAllLines(inputPath);
        System.out.println("Lines read: " + lines.size());
        
        List<String> outputLines = new ArrayList<>();

        // 3. Generate Header
        String dateStr = LocalDate.now().format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        String header = "BYEP100000" + dateStr + "F";
        outputLines.add(header);

        // 4. Process Lines
        int successCount = 0;
        for (int i = 0; i < lines.size(); i++) {
            try {
                String processedLine = convertLineToYsaFormat(lines.get(i));
                if (processedLine != null) {
                    outputLines.add(processedLine);
                    successCount++;
                }
            } catch (Exception e) {
                System.err.println("⚠️ Skipping Line " + (i + 1) + " due to error: " + e.getMessage());
            }
        }
        System.out.println("Processed " + successCount + " valid data lines.");

        // 5. Write Output
        Path parentDir = inputPath.getParent();
        if (parentDir == null) parentDir = Paths.get("."); // Fallback if no parent

        String fileName = inputPath.getFileName().toString();
        Path outputPath = parentDir.resolve("GENERATED_" + fileName);

        System.out.println("Attempting to write to: " + outputPath);
        Files.write(outputPath, outputLines);
        
        System.out.println("✅ FILE GENERATED SUCCESSFULLY!");
        return outputPath.toString();
    }

    private String convertLineToYsaFormat(String rawLine) {
        if (rawLine == null || rawLine.trim().isEmpty()) return null;

        String[] columns = rawLine.split("\\|", -1);

        // Validation: Must have at least 4 columns (up to CompCode)
        if (columns.length < 4) return null;

        String compCodeStr = columns[3].trim();

        // Validation: CompCode must be a number
        if (!isNumeric(compCodeStr)) return null; 

        // Get Amount: Priority Inner (4) -> Outer (5) -> Default 0
        String amountStr = "";
        if (columns.length > 4 && !columns[4].trim().isEmpty()) {
            amountStr = columns[4].trim();
        } else if (columns.length > 5 && !columns[5].trim().isEmpty()) {
            amountStr = columns[5].trim();
        } else {
            amountStr = "0.00";
        }

        // Clean amount (remove commas)
        amountStr = amountStr.replace(",", "").trim();
        if (amountStr.isEmpty()) amountStr = "0.00";

        // Logic: Format Amount
        BigDecimal amount = new BigDecimal(amountStr);
        long plainAmount = amount.multiply(new BigDecimal(100)).longValue();
        String formattedAmount = String.format("%017d", Math.abs(plainAmount));

        // Logic: Calculate Sign
        long compCode = Long.parseLong(compCodeStr);
        String sign = (compCode < 10000) ? "-" : "+";

        // Logic: Ensure CompCode is 5 digits (Pad with leading zeros if needed)
        // e.g., "1" becomes "00001", "1036" becomes "01036"
        String formattedCompCode = String.format("%05d", compCode);

        // Final String
        return formattedCompCode + formattedAmount + sign;
    }

    private boolean isNumeric(String str) {
        if (str == null || str.isEmpty()) return false;
        return numericPattern.matcher(str).matches();
    }
}
