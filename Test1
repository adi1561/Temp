                jsonPayload = (String) payloadObj;
                payloadMap = objectMapper.readValue(jsonPayload, new TypeReference<Map<String, Object>>() {});
            } else {
                payloadMap = (Map<String, Object>) payloadObj;
                jsonPayload = objectMapper.writeValueAsString(payloadMap);
            }
        } catch (Exception e) {
            return buildError(HttpStatus.BAD_REQUEST, "Invalid Payload format");
