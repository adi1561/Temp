import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.time.format.DateTimeParseException;
import java.util.List;

@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private final RedisTemplate<String, Object> redisTemplate;
    private final ProgressService progressService;

    @Async("bulkExecutor")
    public void processAsync(String requestId, List<ExcelRowData> rows) {
        log.info("VALIDATION_START | ReqID: {} | Rows: {}", requestId, rows.size());
        
        try {
            for (ExcelRowData row : rows) {
                // Rule 1: Use specific try-catches for individual row logic
                validateRowInternal(row);
            }
            
            redisTemplate.opsForValue().set("DATA_" + requestId, rows);
            progressService.sendProgress(requestId, "SYSTEM", 100, "VALIDATED", "File validation successful");
            
        } catch (DateTimeParseException e) {
            log.error("VALIDATION_DATE_FAIL | ReqID: {} | Status: Invalid date format in file", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Incorrect date format detected.");
        } catch (NumberFormatException e) {
            log.error("VALIDATION_NUMERIC_FAIL | ReqID: {} | Status: Malformed amount", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Non-numeric values found in amount column.");
        } catch (Exception e) { 
            // Rule 1: We still catch Exception here at the top level as a final safety, 
            // but Rule 2 ensures we don't log e.getMessage()
            log.error("VALIDATION_SYSTEM_CRASH | ReqID: {} | Type: {}", requestId, e.getClass().getSimpleName());
            handleAsyncCrash(requestId, "Internal system error during file validation.");
        }
    }

    private void validateRowInternal(ExcelRowData row) {
        if (row.branch == null || row.branch.isBlank()) {
            throw new IllegalArgumentException("Missing branch code");
        }
        // Logic for amount and date parsing will throw specific RuntimeExceptions caught above
    }

    private void handleAsyncCrash(String requestId, String userMessage) {
        // Rule 2: userMessage is a sanitized string, not a raw exception message
        progressService.sendProgress(requestId, "SYSTEM", 0, "FAILED", userMessage);
    }

    public static class ExcelRowData {
        public String branch;
        public String currency;
        public String cgl;
        public java.math.BigDecimal amount;
        public String txnType;
