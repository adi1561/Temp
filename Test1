    @Override
    @Transactional
    public String createBatchFromCacheAsync(String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        String lockKey = "LOCK_REQ_" + requestId;
        Boolean acquired;

        try {
            acquired = redisTemplate.opsForValue().setIfAbsent(lockKey, new byte[0], 5, TimeUnit.MINUTES);
        } catch (DataAccessException e) {
            log.error("REDIS_LOCK_FAIL | ReqID: {} | Status: Lock service connectivity issue", requestId);
            throw new CustomExceptions.DatabaseOperationException("Distributed lock service unavailable", e);
        }

        if (Boolean.FALSE.equals(acquired)) {
            log.warn("CONCURRENCY_LOCKED | ReqID: {} | Status: Duplicate batch creation attempt", requestId);
            throw new CustomExceptions.ConcurrencyLockException("Batch creation is already in progress for this Request ID.");
        }

        try {
            String batchId = sequenceService.getNextBatchId();
            progressService.sendProgress(batchId, creatorId, 0, "PROCESSING", "Initializing Batch Creation...");
            self.executeAsyncBatchCreation(batchId, requestId, commonRemarks, creatorId, creatorRole);
            return batchId;
        } catch (DataAccessException e) {
            redisTemplate.delete(lockKey);
            log.error("SEQUENCE_GEN_FAIL | ReqID: {} | Status: Sequence generator failure", requestId);
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Batch ID sequence", e);
        }
    }

    @Override
    @Async("bulkExecutor")
    @Transactional
    public void executeAsyncBatchCreation(String batchId, String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        MDC.put("batchId", batchId);
        MDC.put("user", creatorId);

        log.info("ASYNC_BATCH_START | Batch: {} | Source: {}", batchId, requestId);
        long start = System.currentTimeMillis();

        try {
            progressService.sendProgress(batchId, creatorId, 5, "PROCESSING", "Preparing Data...");
            List<JournalBulkValidationService.ExcelRowData> cachedRows = journalBulkValidationService.getValidRowsFromCache(requestId);

            if (cachedRows == null || cachedRows.isEmpty()) {
                logAudit(creatorId, "CREATE_FAIL", "BATCH_ASYNC", "Cache Expired for " + batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired or empty.");
                return;
            }

            int totalRows = cachedRows.size();
            int batchSize = 5000; 

            List<CompletableFuture<Void>> futures = new ArrayList<>();
            LongAdder totalDebit = new LongAdder();
            LongAdder totalCredit = new LongAdder();
            AtomicInteger completedChunks = new AtomicInteger(0);
            int totalChunks = (int) Math.ceil((double) totalRows / batchSize);

            for (int i = 0; i < totalRows; i += batchSize) {
                final int startIdx = i;
                final int endIdx = Math.min(i + batchSize, totalRows);
                final List<JournalBulkValidationService.ExcelRowData> chunk = cachedRows.subList(startIdx, endIdx);

                CompletableFuture<Void> future = CompletableFuture.runAsync(() ->
                                processChunkRaw(chunk, batchId, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit), bulkExecutor)
                        .thenRun(() -> {
                            int done = completedChunks.incrementAndGet();
                            int percent = 5 + (done * 90 / totalChunks);
                            progressService.sendProgress(batchId, creatorId, percent, "PROCESSING",
                                     String.format("Created %d/%d records...", Math.min(done * batchSize, totalRows), totalRows));
                        });
                futures.add(future);
            }

            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            String sumSql = "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
            jdbcTemplate.update(sumSql, batchId, creatorId, ts, commonRemarks, totalRows,
                    BigDecimal.valueOf(totalDebit.sum()), BigDecimal.valueOf(totalCredit.sum()), "PENDING");

            redisTemplate.delete("DATA_" + requestId);
            redisTemplate.delete("LOCK_REQ_" + requestId);
            logAudit(creatorId, "CREATE_SUCCESS", "BATCH_ASYNC", "Successfully created batch " + batchId);

            progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Batch Created Successfully");
            sendNotification(creatorId, null, "Batch " + batchId + " created successfully.", batchId);

            NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
            if (config != null) {
                String msg = String.format("New Batch %s by %s requires approval.", batchId, creatorId);
                sendNotification(creatorId, config.getTargetRoles(), msg, batchId);
            }

            log.info("BATCH_CREATION_FINISHED | Batch: {} | TotalRows: {} | Duration: {}ms", batchId, totalRows, System.currentTimeMillis() - start);

        } catch (CustomExceptions.CacheExpiredException e) {
            log.error("CACHE_ERROR | Batch: {} | Status: Data expired in Redis", batchId);
            handleAsyncFailure(batchId, creatorId, requestId, "Data cache expired. Please re-upload.");
        } catch (CompletionException | DataAccessException e) {
            log.error("DATABASE_ERROR | Batch: {} | Status: Persistence failure during async creation", batchId);
            handleAsyncFailure(batchId, creatorId, requestId, "Database persistence failed. Try again.");
        } catch (NullPointerException | IllegalArgumentException e) {
            log.error("INTERNAL_LOGIC_ERROR | Batch: {} | Type: {}", batchId, e.getClass().getSimpleName());
            handleAsyncFailure(batchId, creatorId, requestId, "Unexpected logic error during creation.");
        } finally {
            MDC.clear();
        }
    }

    private void processChunkRaw(List<JournalBulkValidationService.ExcelRowData> chunk, String batchId, String commonRemarks, String creatorId, Integer creatorRole, int globalOffset, LongAdder debit, LongAdder credit) {
        String sql = "INSERT INTO JOURNAL_REQUEST (REQ_ID, REQ_STATUS, REQ_DATE, CREATOR_ID, CREATOR_ROLE, BATCH_ID, JOURNAL_ID, COMMON_BATCH_REMARKS, PAYLOAD, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_CSV_DATE, REQ_NARRATION, REQ_PRODUCT) VALUES (JOURNAL_REQUEST_SEQ.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
        try (Connection conn = dataSource.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            conn.setAutoCommit(false);
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            final DateTimeFormatter jsonFmt = DateTimeFormatter.ISO_DATE;

            for (int i = 0; i < chunk.size(); i++) {
                JournalBulkValidationService.ExcelRowData r = chunk.get(i);
                int globalIdx = globalOffset + i + 1;
                String jId = batchId + "-" + globalIdx;
                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                boolean isCredit = "Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType);
                BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                if (isCredit) credit.add(absAmt.longValue());
                else debit.add(absAmt.longValue());

                LocalDate rDate = LocalDate.now();
                if (r.isSystemFormat && r.sysDate != null && r.sysDate.length() == 8) {
                    try { rDate = LocalDate.parse(r.sysDate, DateTimeFormatter.ofPattern("ddMMyyyy")); }
                    catch (DateTimeParseException ignored) {}
                }

                ps.setString(1, "P");
                ps.setTimestamp(2, ts);
                ps.setString(3, creatorId);
                ps.setInt(4, creatorRole != null ? creatorRole : 0);
                ps.setString(5, batchId);
                ps.setString(6, jId);
                ps.setString(7, commonRemarks);
                ps.setString(8, buildJsonPayloadFast(r, signedAmt, rDate, batchId, jId, commonRemarks, globalIdx, jsonFmt));
                ps.setString(9, r.branch);
                ps.setString(10, r.currency);
                ps.setString(11, r.cgl);
                ps.setBigDecimal(12, signedAmt);
                ps.setDate(13, java.sql.Date.valueOf(rDate));
                ps.setString(14, r.remarks);
                ps.setString(15, r.productCode);
                ps.addBatch();
            }
            ps.executeBatch();
            conn.commit();
        } catch (SQLException e) {
            log.error("JDBC_SQL_FAIL | Batch: {} | Status: SQL chunk insertion failed", batchId);
            throw new CustomExceptions.DatabaseOperationException("Failed to persist batch chunk", e);
        }
    }

    @Override
    public List<Map<String, Object>> getPendingBatchSummaries() {
        String sql = "SELECT BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS, EXECUTOR_REMARKS FROM JOURNAL_BATCH_MASTER WHERE BATCH_STATUS IN ('PENDING', 'ERROR') ORDER BY REQ_DATE DESC";
        try {
            return jdbcTemplate.query(sql, (rs, rowNum) -> {
                Map<String, Object> map = new HashMap<>();
                map.put("batchId", rs.getString("BATCH_ID"));
                map.put("creatorId", rs.getString("CREATOR_ID"));
                map.put("requestDate", rs.getTimestamp("REQ_DATE"));
                map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
                map.put("requestCount", rs.getLong("TOTAL_ROWS"));
                map.put("totalDebit", rs.getBigDecimal("TOTAL_DEBIT"));
                map.put("totalCredit", rs.getBigDecimal("TOTAL_CREDIT"));
                map.put("requestStatus", rs.getString("BATCH_STATUS"));
                return map;
            });
        } catch (DataAccessException e) {
            log.error("SUMMARY_FETCH_FAIL | Status: Database query error");
            return Collections.emptyList();
        }
    }

    @Override
    public LocalDate getCurrentPostingDate() {
        String sql = "SELECT USERS_DATE FROM FINCORE_DATE FETCH FIRST 1 ROWS ONLY";
        try {
            return jdbcTemplate.queryForObject(sql, (rs, rowNum) -> {
                Timestamp ts = rs.getTimestamp("USERS_DATE");
                return ts != null ? ts.toLocalDateTime().toLocalDate() : LocalDate.now();
            });
        } catch (EmptyResultDataAccessException e) {
            return LocalDate.now();
        } catch (DataAccessException e) {
            log.error("POSTING_DATE_FAIL | Status: Connection unavailable");
            throw new CustomExceptions.DatabaseOperationException("Database connection failure", e);
        }
    }

    @Override
    @Transactional
    public List<JournalRequest> createBatchRequest(BatchRequestDto dto, String creatorId, Integer creatorRole) throws JsonProcessingException {
        String batchId = sequenceService.getNextBatchId();
        Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
        List<JournalRequest> entities = new ArrayList<>();
        BigDecimal tDebit = BigDecimal.ZERO, tCredit = BigDecimal.ZERO;
        int idx = 1;

        for (BatchRequestDto.JournalRequestRow row : dto.getRows()) {
            JournalRequest e = new JournalRequest();
            e.setRequestStatus(RequestStatus.PENDING);
            e.setCreatorId(creatorId);
            e.setCreatorRole(creatorRole);
            e.setBatchId(batchId);
            e.setJournalId(batchId + "-" + idx);
            e.setBranchCode(row.getBranch());
            e.setCurrency(row.getCurrency());
            e.setCgl(row.getCgl());
            e.setAmount(row.getAmount());
            e.setCsvDate(row.getCsvDate() != null ? row.getCsvDate() : LocalDate.now());
            e.setNarration(row.getRemarks());
            e.setProductCode(row.getProductType());
            
            if (row.getAmount().signum() < 0) tCredit = tCredit.add(row.getAmount().abs());
            else tDebit = tDebit.add(row.getAmount());
            
            entities.add(e);
            idx++;
        }
        
        List<JournalRequest> saved = journalRequestRepository.saveAll(entities);
        jdbcTemplate.update("INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                batchId, creatorId, ts, dto.getCommonBatchRemarks(), entities.size(), tDebit, tCredit, "PENDING");
        
        logAudit(creatorId, "CREATE_SUCCESS", "BATCH_MANUAL", "Manual Batch " + batchId);
        return saved;
    }

    private void handleAsyncFailure(String batchId, String creatorId, String requestId, String message) {
        cleanupFailedBatch(batchId);
        redisTemplate.delete("LOCK_REQ_" + requestId);
        jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ERROR', EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", message, batchId);
        progressService.sendProgress(batchId, creatorId, 0, "FAILED", message);
    }

    private void cleanupFailedBatch(String batchId) {
        try {
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);
            jdbcTemplate.update("DELETE FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", batchId);
        } catch (DataAccessException e) {
            log.warn("CLEANUP_WARN | Batch: {} | Status: Partial purge failed", batchId);
        }
    }

    private void sendNotification(String userId, String roles, String message, String batchId) {
        try {
            notificationWriterService.createNotification(userId, roles, message, "/journal-view/" + batchId, batchId, "JournalService");
        } catch (Exception e) {
            log.warn("NOTIFICATION_WARN | Batch: {} | Status: Notification alert failed", batchId);
        }
    }

    private void logAudit(String user, String action, String type, String val) {
        try {
            JournalLog l = new JournalLog();
            l.setUserId(user);
            l.setActionType(action);
            l.setChangeType(type);
            l.setNewValue(val.length() > 3900 ? val.substring(0, 3900) : val);
            l.setActionTime(LocalDateTime.now());
            journalLogRepository.save(l);
        } catch (DataAccessException e) {
            log.error("AUDIT_LOG_FAIL | User: {} | Status: DB persistence error", user);
        }
    }

    private String buildJsonPayloadFast(JournalBulkValidationService.ExcelRowData row, BigDecimal amount, LocalDate pDate, String batchId, String jId, String rem, int count, DateTimeFormatter fmt) {
        return "{\"csvDate\":\"" + pDate.format(fmt) + "\",\"branch\":\"" + row.branch + "\",\"currency\":\"" + row.currency + "\",\"cgl\":\"" + row.cgl + "\",\"amount\":" + amount + "}";
    }

    private String escapeJson(String s) {
        return s == null ? "" : s.replace("\"", "\\\"").replace("\\", "\\\\");
    }

