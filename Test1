package com.tcs.fincore.CommonRequestService.service.strategy;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.kafka.support.SendResult;
import org.springframework.stereotype.Service;

import java.util.concurrent.CompletableFuture;

@Slf4j
@Service
@RequiredArgsConstructor
public class KafkaEventPublisherService {

    // Injects the Spring Boot Kafka Template
    private final KafkaTemplate<String, String> kafkaTemplate;

    // Pulls the topic name from application.yml, defaults to "lho-airflow-topic" if missing
    @Value("${app.kafka.topics.lho-transfer:lho-airflow-topic}")
    private String lhoTopic;

    public void publishLhoTransferEvent(String targetId, String payload) {
        log.info("Attempting to publish LHO Transfer event for targetId: {} to topic: {}", targetId, lhoTopic);

        // --- REAL KAFKA PUBLISH LOGIC ---
        // We pass the targetId as the message "Key". This ensures messages for the same batch 
        // go to the same partition, preserving order.
        CompletableFuture<SendResult<String, String>> future = kafkaTemplate.send(lhoTopic, targetId, payload);

        // --- ASYNC CALLBACK HANDLING ---
        future.whenComplete((result, exception) -> {
            if (exception == null) {
                // Success: Log the exact location in Kafka where the message was saved
                log.info("Successfully published LHO Transfer event! Target ID: {} | Topic: {} | Partition: {} | Offset: {}", 
                        targetId, 
                        lhoTopic, 
                        result.getRecordMetadata().partition(), 
                        result.getRecordMetadata().offset());
            } else {
                // Failure: The broker might be down, or topic doesn't exist
                log.error("CRITICAL: Failed to publish LHO Transfer event for Target ID: {}. Error: {}", 
                        targetId, 
                        exception.getMessage(), 
                        exception);
            }
        });
    }
}
