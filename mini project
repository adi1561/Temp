package org.example.demo1.Service;

import org.example.demo1.DTO.StudentRequest;
import org.example.demo1.DTO.StudentResponce;
import org.example.demo1.Models.StudentResult;
import org.example.demo1.Models.SubjectMark;
import org.example.demo1.Repository.StudentRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class StudentService {


    @Autowired
    private StudentRepo studentRepo;


    public StudentResponce createStudent(StudentRequest studentRequest) {

        StudentResult studentResult = new StudentResult();
        studentResult.setStudentName(studentRequest.getStudentName());
        studentResult.setRollNumber(studentRequest.getRollNumber());
        studentResult.setSubjects(studentRequest.getSubjects());

        double totalMarks = 0;
        boolean hasfail = false;
        String status = "FAIL";

        int totalSubject = 0;
        double  percentage = (totalMarks / (totalSubject * 100.0)) * 100;




        for(SubjectMark item :studentRequest.getSubjects() ) {
            if(item.getMarks() < 30) {
                hasfail = true;
                status = "FAIL";


            } else if (percentage > 75) {
               status = "DISTINCTION";
            }
            else {
               status = "PASS";

            }
            totalSubject += 1;
            totalMarks += item.getMarks();

        }

        studentResult.setTotalMarks(totalMarks);

        studentResult.setPercentage(percentage);

        StudentResult DataSaved = studentRepo.save(studentResult);

        StudentResponce studentResponce = new StudentResponce();
        studentResponce.setStudentId(DataSaved.getId());
        studentResponce.setStudentName(DataSaved.getStudentName());
        studentResponce.setTotalMarks(DataSaved.getTotalMarks());
        studentResponce.setPercentage(DataSaved.getPercentage());
        if(hasfail == true) {
            studentResponce.setFinalResult("FAIL");



        } else if (status == "DISTINCTION") {
            studentResponce.setFinalResult("DISTINCTION");
        }
        else {
            studentResponce.setFinalResult("PASS");
        }


        return studentResponce;
    }







