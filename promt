```java
// 1. Inject the new repository
private final CommonRequestRepository commonRequestRepository;

@Override
public PaginatedResponseDto<CommonRequestDto> searchCommonRequests(SearchRequest request) {
    Sort.Direction direction = Sort.Direction.fromString(
            request.getSortOrder() != null ? request.getSortOrder() : "DESC");
    String sortField = request.getSortField() != null ? request.getSortField() : "requestDate";

    PageRequest pageRequest = PageRequest.of(request.getPage(), request.getSize(), Sort.by(direction, sortField));

    Page<CommonRequest> page = commonRequestRepository.findAll(
            GenericSpecification.build(request.getFilters()), 
            pageRequest
    );

    List<CommonRequestDto> dtoList = page.getContent().stream().map(this::mapToRequestDto).toList();

    return new PaginatedResponseDto<>(
            page.getNumber(), 
            page.getTotalPages(), 
            page.getSize(), 
            page.getTotalElements(), 
            direction.name(), 
            dtoList
    );
}

@Override
public CommonRequestDto getRequestById(Long id) {
    CommonRequest req = commonRequestRepository.findById(id)
            .orElseThrow(() -> new NoDataFoundException("Request not found with ID: " + id));
    return mapToRequestDto(req);
}

// Helper for mapping
private CommonRequestDto mapToRequestDto(CommonRequest entity) {
    CommonRequestDto dto = new CommonRequestDto();
    dto.setId(entity.getId());
    dto.setRequestType(entity.getRequestType());
    dto.setChangeType(entity.getChangeType());
    dto.setStatus(entity.getStatus());
    dto.setRequestDate(entity.getRequestDate());
    dto.setCreatorId(entity.getCreatorId());
    dto.setCreatorRemarks(entity.getCreatorRemarks());
    dto.setExecutionDate(entity.getExecutionDate());
    dto.setExecutionRemarks(entity.getExecutionRemarks());
    dto.setExecutorId(entity.getExecutorId());
    dto.setExecutorRemarks(entity.getExecutorRemarks());
    dto.setPayload(entity.getPayload());
    dto.setTargetId(entity.getTargetId());
    return dto;
}

