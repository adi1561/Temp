// ... existing imports
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonMasterService.model.LhoTransferSummary;
import com.tcs.fincore.CommonMasterService.repository.PLTransferRepository;
import com.tcs.fincore.CommonMasterService.repository.LhoSummaryRepository;

@Slf4j
@Service
@RequiredArgsConstructor
public class CommonMasterServiceImpl implements CommonMasterService {

    // ... existing injections
    private final PLTransferRepository plTransferRepository;
    private final LhoSummaryRepository lhoSummaryRepository;
    private final ObjectMapper objectMapper;

    @Override
    @Transactional
    public String getOrGenerateLhoSummary(Long id) {
        log.info("Processing LHO Summary request for ID: {}", id);

        // 1. Try to fetch from LHO_TRANSFER_SUMMARY table
        return lhoSummaryRepository.findById(id)
                .map(LhoTransferSummary::getPayload)
                .orElseGet(() -> {
                    log.info("Summary not found in cache for ID: {}. Generating new aggregation...", id);
                    
                    // 2. Perform DB aggregation
                    List<Object[]> aggregatedData = plTransferRepository.getAggregatedSummary();
                    
                    if (aggregatedData.isEmpty()) {
                        throw new NoDataFoundException("No transfer records found in P_L_TRANSFER to generate summary.");
                    }

                    // 3. Map result to JSON-friendly format
                    Map<String, Double> summaryMap = new HashMap<>();
                    for (Object[] row : aggregatedData) {
                        summaryMap.put(String.valueOf(row[0]), ((Number) row[1]).doubleValue());
                    }

                    try {
                        String jsonPayload = objectMapper.writeValueAsString(summaryMap);

                        // 4. Save to Summary table for persistence
                        LhoTransferSummary summaryEntity = LhoTransferSummary.builder()
                                .id(id)
                                .payload(jsonPayload)
                                .build();
                        lhoSummaryRepository.save(summaryEntity);

                        return jsonPayload;
                    } catch (Exception e) {
                        log.error("JSON Serialization failed for LHO Summary", e);
                        throw new RuntimeException("Internal Error generating summary payload");
                    }
                });
    }
}

```

