<Paper elevation={1} sx={jbuStyles.controlPanel}>

// REPLACE (Dynamic Wrapper Box):
<Box sx={{ borderColor: resultStatus === "ERROR" ? "error.main" : "primary.main", opacity: (isProcessing || isCreatingBatch) ? 0.6 : 1, }}>
