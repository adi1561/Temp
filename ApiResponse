          {resultStatus === "ERROR" && (
            <Alert
              severity="error"
              sx={{ 
                mt: 3, 
                mx: "auto", 
                maxWidth: "100%", 
                backgroundColor: "#fff5f5",  // Very light, soft red background
                alignItems: "center"         // <-- This perfectly aligns the icon with the text
              }}
            >
              <Typography variant="body1" fontWeight="500">
                {resultMsg} {downloadMsg ? `— ${downloadMsg}` : ""}
              </Typography>
            </Alert>
          )}
