    // ✨ FIX: Keep it 'P' (Pending) while it waits for the scheduler
    posting.setBatchStatus("P"); 
    logWorkflowAction(batchId, posting.getVidFk(), "Final Approval(Scheduled)", executorId, dto.getRemarks(), posting.getScheduledTime());
    jdbcTemplate.update("UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'P' WHERE BATCH_ID = ?", batchId);

} else {
    // ... immediate execution logic
}

```
