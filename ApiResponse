create or replace PROCEDURE PURGE_JOURNAL_BATCH(
    p_batch_id IN VARCHAR2,
    p_user_id  IN VARCHAR2
) AS
    v_status VARCHAR2(20);
BEGIN
    SELECT BATCH_STATUS INTO v_status
    FROM VOUCHER_POSTING
    WHERE BATCH_ID = p_batch_id 
      AND UPPER(TRIM(CREATED_BY)) = UPPER(TRIM(p_user_id));

    IF v_status NOT IN ('P') THEN
        RAISE_APPLICATION_ERROR(-20002, 'Cannot delete batch. Status is ' || v_status);
    END IF;
    DELETE FROM VOUCHER_POSTING_DATA WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P';
    DELETE FROM VOUCHER_POSTING WHERE BATCH_ID = p_batch_id;
    
    
END;
