    @Override
    public void updateBatchSchedule(String batchId, String scheduledTime) {
        // Oracle uses TO_TIMESTAMP to safely insert the string date
        String sql = "UPDATE VOUCHER_POSTING SET SCHEDULED_TIME = TO_TIMESTAMP(?, 'YYYY-MM-DD HH24:MI:SS') WHERE BATCH_ID = ?";

        int rowsAffected = jdbcTemplate.update(sql, scheduledTime, batchId);

        if (rowsAffected == 0) {
            throw new RuntimeException("Batch ID not found or update failed.");
        }
    }

