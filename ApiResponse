const initialRowState = { branch: null, currency: "", cgl: null, amount: "", txnType: "", remarks: "", productCode: "" };

const formatBigIntForDisplay = (val) => {
  if (typeof val !== "bigint") val = BigInt(val || 0);
  const str = val.toString().padStart(5, "0");
  return `${str.slice(0, -4) || "0"}.${str.slice(-4)}`;
};

// ============================================================================
// NEW: ZOD VALIDATION SCHEMA (Business logic lives here now)
// ============================================================================
const rowSchema = z.object({
  branch: z.object({ code: z.string(), name: z.string() }).nullable().refine(val => val !== null, "Branch is required"),
  currency: z.string().min(1, "Select currency"),
  cgl: z.object({ cglNumber: z.string(), description: z.string().optional() }).nullable().refine(val => val !== null, "CGL is required"),
  amount: z.string().min(1, "Amount is required").refine(val => parseFloat(val) > 0, "Amount must be > 0"),
  txnType: z.enum(["Debit", "Credit"], { required_error: "Select type", invalid_type_error: "Select type" }),
  productCode: z.string().max(8, "Max 8 digits").optional(),
  remarks: z.string().min(2, "Min 2 chars").max(30, "Max 30 chars").regex(/^[a-zA-Z0-9 ]+$/, "Only alphabets/numbers"),
}).superRefine((data, ctx) => {
  if (data.currency === "INR" && data.amount && data.amount.includes(".")) {
    if (data.amount.split(".")[1].length > 2) ctx.addIssue({ code: z.ZodIssueCode.custom, message: "INR max 2 decimals", path: ["amount"] });
  }
});

const formSchema = z.object({
  commonBatchRemarks: z.string().max(30).optional(),
  applyToAll: z.boolean().default(false),
  rows: z.array(rowSchema).min(1, "At least one row is required"),
}).superRefine((data, ctx) => {
  if (data.commonBatchRemarks && data.commonBatchRemarks.length > 0 && data.commonBatchRemarks.length < 2) {
    ctx.addIssue({ code: z.ZodIssueCode.custom, message: "Must be 2-30 chars", path: ["commonBatchRemarks"] });
  }

  // --- Real-time Debit/Credit Math Engine ---
  const branchCurrencyTotals = new Map();
  const branchEntryCheck = new Map();

  data.rows.forEach((row) => {
    if (!row.branch || !row.currency || !row.cgl || !row.amount || !row.txnType || isNaN(parseFloat(row.amount))) return;

    const branchCode = row.branch.code;
    const type = String(row.cgl.cglNumber).startsWith("5") ? "MEMO" : "NORMAL";
    const compositeKey = `${branchCode}-${row.currency}-${type}`;

    const [integerPart = "0", fractionalPart = "0"] = row.amount.split(".");
    const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
    const amountAsBigInt = BigInt(integerPart + fractionalPadded);

    if (!branchCurrencyTotals.has(compositeKey)) branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n });
    if (row.txnType === "Debit") branchCurrencyTotals.get(compositeKey).totalDebit += amountAsBigInt;
    else if (row.txnType === "Credit") branchCurrencyTotals.get(compositeKey).totalCredit += amountAsBigInt;

    if (!branchEntryCheck.has(branchCode)) branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false });
    if (row.txnType === "Debit") branchEntryCheck.get(branchCode).hasDebit = true;
    else if (row.txnType === "Credit") branchEntryCheck.get(branchCode).hasCredit = true;
  });

  for (const [branchCode, totals] of branchEntryCheck.entries()) {
    if (!totals.hasDebit || !totals.hasCredit) {
      ctx.addIssue({ code: z.ZodIssueCode.custom, message: `Branch ${branchCode} is missing a matching Debit or Credit entry.`, path: ["root.batchMath"] });
    }
  }

  for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
    if (totals.totalDebit !== totals.totalCredit) {
      const [branchCode, currency, type] = compositeKey.split("-");
      ctx.addIssue({ code: z.ZodIssueCode.custom, message: `Debit/Credit mismatch for Branch ${branchCode} (${currency} - ${type}).`, path: ["root.batchMath"] });
    }
  }
});

