package com.fincore.JournalService.config;

import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.boot.jdbc.DataSourceBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.jdbc.core.JdbcTemplate;
import lombok.extern.slf4j.Slf4j;

import javax.sql.DataSource;

/**
 * Configures the connection to the Data Lake (Delta Lake).
 * Uses JdbcTemplate for direct SQL execution, suitable for high-volume analytics.
 */
@Configuration
@Slf4j
public class HiveDbConfig {

    /**
     * Configures the Hive/Thrift DataSource for Data Lake synchronization.
     * Connection properties are externalized with the prefix 'spring.datasource.hive'.
     */
    @Bean(name = "hiveDataSource")
    @ConfigurationProperties(prefix = "spring.datasource.hive")
    public DataSource hiveDataSource() {
        log.info("HIVE_DB_INIT | Initializing Secondary Hive/Thrift DataSource for Data Lake");
        return DataSourceBuilder.create().build();
    }

    /**
     * Provides a dedicated JdbcTemplate for interacting with the Hive Data Lake.
     * The @Qualifier ensures the correct secondary datasource is injected.
     */
    @Bean(name = "hiveJdbcTemplate")
    public JdbcTemplate hiveJdbcTemplate(@Qualifier("hiveDataSource") DataSource dataSource) {
        log.info("HIVE_JDBC_TEMPLATE_INIT | Providing dedicated Hive JdbcTemplate bean");
        return new JdbcTemplate(dataSource);
    }
}

