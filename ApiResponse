            jdbcTemplate.update("UPDATE VOUCHER_POSTING_DATA SET REQ_STATUS = 'R', EXECUTION_DATE = SYSTIMESTAMP WHERE BATCH_ID = ?", batchId);

            // --- NEW: FETCH ALL PREVIOUS ACTORS FOR REJECTION BLAST ---
            // Grabs everyone who ever took an action on this batch, excluding the current rejector
            String previousActorsSql = "SELECT DISTINCT LAST_ACTION_BY FROM VOUCHER_WORKFLOW WHERE BATCH_ID_FK = ? AND LAST_ACTION_BY != ?";
            List<String> previousActors = jdbcTemplate.queryForList(previousActorsSql, String.class, batchId, executorId);
            
            // Failsafe: Ensure the original creator is always in the blast list
            String creatorId = (String) stepData.get("CREATED_BY");
            if (!previousActors.contains(creatorId)) {
                previousActors.add(creatorId);
            }

            // Fire the notifications
            notificationWriterService.createBatchRejectedNotificationForUsers(batchId, previousActors, executorId, dto.getRemarks());

            if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) {
                updateVidStatus(posting.getVidFk(), VoucherStatus.ACTIVE);
            }
            return;
        }

```
### Why this works perfectly:
 1. **Dynamic Scaling:** If a batch goes through 5 levels of Checkers and is rejected at Level 6, this query instantly identifies all 5 previous people plus the Maker, creating 6 accurate rows in your NOTIFICATIONS table.
 2. **DISTINCT Keyword:** If the same user somehow touched the batch twice (e.g., they hold two roles), DISTINCT ensures they only receive one notification instead of getting spammed.
 3. **Failsafe Included:** Just in case the initial "Submitted" action hasn't fully committed to the workflow table in a weird edge case, the logic explicitly grabs the CREATED_BY from the master table and adds them to the notification list.
