    // ==================================================================================
    // 1. ASYNC BATCH CREATION (PARALLEL OPTIMIZATION)
    // ==================================================================================

    @Override
    @Transactional
    public String createBatchFromCacheAsync(String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        String lockKey = "LOCK_REQ_" + requestId;
        Boolean acquired;

        try {
            acquired = redisTemplate.opsForValue().setIfAbsent(lockKey, new byte[0], 60, TimeUnit.MINUTES);

        } catch (DataAccessException e) {
            log.error("REDIS_LOCK_FAIL | ReqID: {} | Status: Connection to lock service failed", requestId);
            throw new CustomExceptions.DatabaseOperationException("Distributed lock service unavailable", e);
        }

        if (Boolean.FALSE.equals(acquired)) {
            log.warn("CONCURRENCY_LOCKED | ReqID: {} | Status: Processing already in progress", requestId);
            throw new CustomExceptions.ConcurrencyLockException("Batch creation is already in progress for this Request ID.");
        }

        try {
            String batchId = sequenceService.getNextBatchId(); // e.g., 0002356
            String journalPrefix = sequenceService.getNextJournalIdPrefix(); // e.g., 0004977

            progressService.sendProgress(batchId, creatorId, 0, "PROCESSING", "Initializing Batch Creation...");

            // Pass BOTH down!
            self.executeAsyncBatchCreation(batchId, journalPrefix, requestId, commonRemarks, creatorId, creatorRole);
            return batchId;
        }
        catch (DataAccessException e) {
            redisTemplate.delete(lockKey);
            log.error("SEQUENCE_GEN_FAIL | ReqID: {} | Status: Failed to generate sequence", requestId);
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Batch ID sequence", e);
        }
    }

    @Override
    @Async("bulkExecutor")
    public void executeAsyncBatchCreation(String batchId, String journalPrefix, String requestId, String commonRemarks, String creatorId, Integer creatorRole) {
        String lockKey = "LOCK_REQ_" + requestId;
        MDC.put("batchId", batchId);
        MDC.put("user", creatorId);

        // 1. Capture MDC context to ensure worker threads have traceable logs
        Map<String, String> contextMap = MDC.getCopyOfContextMap();
        AtomicInteger successfulRowsCount = new AtomicInteger(0);

        log.info("ASYNC_BATCH_START | Batch: {} | Source: {}", batchId, requestId);
        long start = System.currentTimeMillis();

        try {
            // 2. IDEMPOTENCY: Purge any existing data for this batchId to prevent count inflation
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);
            jdbcTemplate.update("DELETE FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", batchId);

            progressService.sendProgress(batchId, creatorId, 5, "PROCESSING", "Preparing Data...");

            // Retrieve valid rows from the GZIP-compressed Redis cache
            List<JournalBulkValidationService.ExcelRowData> cachedRows = journalBulkValidationService.getValidRowsFromCache(requestId);

            if (cachedRows == null || cachedRows.isEmpty()) {
                log.error("CACHE_MISS | Batch: {} | Status: No valid rows found in Redis", batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired or empty.");
                return;
            }

            int totalRows = cachedRows.size();
            int batchSize = 5000;
            List<CompletableFuture<Void>> futures = new ArrayList<>();

            // High-precision thread-safe counters for financial totals
            AtomicReference<BigDecimal> totalDebit = new AtomicReference<>(BigDecimal.ZERO);
            AtomicReference<BigDecimal> totalCredit = new AtomicReference<>(BigDecimal.ZERO);


            AtomicInteger completedChunks = new AtomicInteger(0);
            int totalChunks = (int) Math.ceil((double) totalRows / batchSize);

            // 3. PARALLEL CHUNKING: Process 5,000 rows at a time
            for (int i = 0; i < totalRows; i += batchSize) {
                final int startIdx = i;
                final int endIdx = Math.min(i + batchSize, totalRows);
                final List<JournalBulkValidationService.ExcelRowData> chunk = new ArrayList<>(cachedRows.subList(startIdx, endIdx));

                // Use 'self' to ensure call goes through Spring proxy for @Transactional(Propagation.REQUIRES_NEW)
                CompletableFuture<Void> future = CompletableFuture.runAsync(() -> {
                            if (contextMap != null) MDC.setContextMap(contextMap);
                            try {
                                self.processChunkRaw(chunk, batchId, journalPrefix, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit);
                                // Increment successfully committed row count
                                successfulRowsCount.addAndGet(chunk.size());
                            } finally {
                                MDC.clear();
                            }
                        }, chunkWorkerExecutor)
                        .thenRun(() -> {
                            int done = completedChunks.incrementAndGet();
                            int percent = 5 + (done * 90 / totalChunks);
                            progressService.sendProgress(batchId, creatorId, percent, "PROCESSING",
                                    String.format("Writing records: %d of %d", Math.min(done * batchSize, totalRows), totalRows));
                        });
                futures.add(future);
            }

            // 4. WAIT FOR COMPLETION: Block until all parallel workers finish (45 min timeout for 500k rows)
            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).get(45, TimeUnit.MINUTES);


            BigDecimal finalDebit = totalDebit.get();
            BigDecimal finalCredit = totalCredit.get();

            // 6. INTEGRITY CHECK: Verify that actual saved rows match expected rows
            int actualCommittedRows = successfulRowsCount.get();
            String batchStatus = "PENDING";
            String finalRemarks = commonRemarks;

            if (actualCommittedRows != totalRows) {
                log.error("BATCH_INTEGRITY_FAILED | Batch: {} | Expected: {} | Actual: {}", batchId, totalRows, actualCommittedRows);
            }

            // 7. FINAL MASTER RECORD: Insert the summary record
            Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
            String sumSql = "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS, EXECUTOR_REMARKS) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)";


            jdbcTemplate.update(sumSql, batchId, creatorId, ts, commonRemarks, actualCommittedRows,
                    finalDebit, finalCredit, batchStatus, null);

            // Audit and Notification Logic (Preserved Business Logic)
            if (actualCommittedRows != totalRows) {
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Integrity Failure: Row count mismatch.");
            } else  {
                logAudit(creatorId, "BATCH_ASYNC", "ADD", "Successfully created batch " + batchId);
                progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Batch Created Successfully");
                sendNotification(creatorId, null, "Batch created Successfully with Batch ID : " + batchId, batchId);

                NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
                if (config != null) {
                    String msg = String.format("New Batch %s by %s requires approval.", batchId, creatorId);
                    sendNotification(null, config.getTargetRoles(), msg, batchId);
                }
            }

            log.info("BATCH_CREATION_FINISHED | Batch: {} | Status: {} | Rows: {} | Duration: {}ms",
                    batchId, batchStatus, actualCommittedRows, System.currentTimeMillis() - start);

        } catch (Exception e) {
            log.error("BATCH_FATAL_ERROR | Batch: {} | Error: {}", batchId, e.getMessage());
            handleAsyncFailure(batchId, creatorId, requestId, "An internal error occurred during batch creation.");
        } finally {
            // 8. OPTIMIZED CLEANUP: Batch delete all Redis keys in one network call
            List<String> keysToDelete = new ArrayList<>();
            keysToDelete.add(lockKey);
            keysToDelete.add("DATA_" + requestId);
            keysToDelete.add("DATA_META_" + requestId);

            // Clean up chunked keys if they exist (assuming max 500k rows / 5k chunk = 100 keys)
            for (int k = 0; k < 110; k++) {
                keysToDelete.add("DATA_CHUNK_" + requestId + "_" + k);
            }
            redisTemplate.delete(keysToDelete);

            MDC.clear();
        }
    }

    private void handleAsyncFailure(String batchId, String creatorId, String requestId, String message) {
        try {
            // 1. First: Delete orphaned journal request rows only so GL stays balanced
            jdbcTemplate.update("DELETE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?", batchId);

            // 2. Then: UPSERT the master record with error status (don't delete it!)
            int updated = jdbcTemplate.update(
                    "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'PENDING', EXECUTOR_REMARKS = NULL WHERE BATCH_ID = ?",
                    batchId);

            // If master record doesn't exist yet, insert it clean
            if (updated == 0) {
                jdbcTemplate.update(
                        "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, BATCH_STATUS, EXECUTOR_REMARKS, REQ_DATE) VALUES (?, 'PENDING', NULL, SYSTIMESTAMP)",
                        batchId);
            }
         } catch (DataAccessException e) {
            log.error("CLEANUP_CRITICAL_FAIL | Batch: {} | Cannot record failure state", batchId);
        }
        progressService.sendProgress(batchId, creatorId, 0, "FAILED", message);

        // --- NEW: Send Bell Notification for Backend Failure ---
        sendNotification(creatorId, null, "Batch creation Failed for Batch ID : " + batchId, batchId);
    }

    /**
     * Rule 3: High-performance JDBC Batch Insertion logic.
     * Directly uses connection pool to avoid JPA overhead for large datasets.
     * Debit is stored as positive, Credit as negative in REQ_AMOUNT.
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void processChunkRaw(List<JournalBulkValidationService.ExcelRowData> chunk,
                                String batchId,
                                String journalPrefix,
                                String commonRemarks,
                                String creatorId,
                                Integer creatorRole,
                                int globalOffset,
                                AtomicReference<BigDecimal> globalDebit,
                                AtomicReference<BigDecimal> globalCredit) {

        String sql = "INSERT INTO JOURNAL_REQUEST (" +
                "REQ_ID, REQ_STATUS, REQ_DATE, CREATOR_ID, CREATOR_ROLE, BATCH_ID, " +
                "JOURNAL_ID, COMMON_BATCH_REMARKS, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, " +
                "REQ_AMOUNT, POSTING_DATE, REQ_NARRATION, REQ_PRODUCT) " +
                "VALUES (JOURNAL_REQUEST_SEQ.NEXTVAL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

        try {
            jdbcTemplate.batchUpdate(sql, new org.springframework.jdbc.core.BatchPreparedStatementSetter() {
                @Override
                public void setValues(java.sql.PreparedStatement ps, int i) throws java.sql.SQLException {
                    JournalBulkValidationService.ExcelRowData r = chunk.get(i);

                    int globalIdx = globalOffset + i + 1;
                    String jId = journalPrefix + "-" + globalIdx;

                    // 1. Case-Insensitive Check for Credit
                    BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                    String safeTxnType = r.txnType != null ? r.txnType.trim() : "";
                    boolean isCredit = "CR".equalsIgnoreCase(safeTxnType) || "CREDIT".equalsIgnoreCase(safeTxnType);
                    BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                    LocalDate rDate = LocalDate.now();
                    if (r.isSystemFormat && r.sysDate != null && r.sysDate.length() == 8) {
                        try {
                            rDate = LocalDate.parse(r.sysDate, DateTimeFormatter.ofPattern("ddMMyyyy"));
                        } catch (DateTimeParseException ignored) {}
                    }

                    // 2. PERFECTLY MAPPED SETTERS (1 through 14 sequentially)
                    ps.setString(1, "P");                                                           // REQ_STATUS
                    ps.setTimestamp(2, java.sql.Timestamp.valueOf(LocalDateTime.now()));            // REQ_DATE
                    ps.setString(3, creatorId);                                                     // CREATOR_ID
                    ps.setInt(4, creatorRole != null ? creatorRole : 0);                            // CREATOR_ROLE
                    ps.setString(5, batchId);                                                       // BATCH_ID
                    ps.setString(6, jId);                                                           // JOURNAL_ID
                    ps.setString(7, commonRemarks);                                                 // COMMON_BATCH_REMARKS
                    ps.setString(8, r.branch);                                                      // REQ_BRANCH_CODE
                    ps.setString(9, r.currency);                                                    // REQ_CURRENCY
                    ps.setString(10, r.cgl);                                                        // REQ_CGL
                    ps.setBigDecimal(11, signedAmt);                                                // REQ_AMOUNT
                    ps.setDate(12, java.sql.Date.valueOf(rDate));                                   // POSTING_DATE
                    ps.setString(13, r.remarks);                                                    // REQ_NARRATION
                    ps.setString(14, r.productCode);                                                // REQ_PRODUCT
                }

                @Override
                public int getBatchSize() {
                    return chunk.size();
                }
            });

            // 3. Update Thread-Safe Aggregates Case-Insensitively
            for (JournalBulkValidationService.ExcelRowData r : chunk) {
                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                String safeTxnType = r.txnType != null ? r.txnType.trim() : "";

                if ("CR".equalsIgnoreCase(safeTxnType) || "CREDIT".equalsIgnoreCase(safeTxnType)) {
                    globalCredit.updateAndGet(curr -> curr.add(absAmt));
                } else {
                    globalDebit.updateAndGet(curr -> curr.add(absAmt));
                }
            }

        } catch (org.springframework.dao.DataAccessException e) {
            log.error("JDBC_BATCH_FAIL | Batch: {} | Offset: {} | Error: {}", batchId, globalOffset, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Database integrity error during chunk insert", e);
        }
    }


