                        sx={{ p: 0, m: 0 }}
                      >
                        {/* The Typography label that was here is completely removed because it is now inside the icon! */}
                      </StepLabel>
                    </Step>
                  </Tooltip>
                );
              })}
            </Stepper>
          </Box>
        );
