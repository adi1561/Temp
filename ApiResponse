    {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        const workflow = params.row.approvalWorkflow || "Workflow_4"; // Added in Phase 2
        const isRejected = state === "REJECTED";

        if (isRejected) {
           return <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />;
        }

        // Determine how many dots to show based on the workflow code we added to the Java API!
        let stepLabels = ['L1', 'L2', 'L3', 'Final']; // Default fallback
        if (workflow === 'Workflow_3') stepLabels = ['L1', 'L2', 'Final'];
        if (workflow === 'Workflow_4') stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];

        // Determine active step safely
        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        if (state.includes("L3")) activeStep = 2;
        if (state.includes("L4")) activeStep = 3;
        
        // Push step to the end if it's completely finished
        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
            activeStep = stepLabels.length - 1; 
        }

        return (
          <Box sx={{ width: '100%', mt: 0.5 }}>
            <Stepper 
              activeStep={activeStep} 
              alternativeLabel 
              connector={<CustomConnector />}
            >
              {stepLabels.map((label, index) => (
                <Step key={label}>
                  <StepLabel 
                    StepIconProps={{ 
                      sx: { 
                        width: 20, 
                        height: 20, 
                        color: activeStep >= index ? 'success.main' : 'text.disabled',
                        '&.Mui-active': { color: 'primary.main' }
                      } 
                    }}
                  >
                    <Typography sx={{ fontSize: '0.65rem', mt: -1, fontWeight: activeStep === index ? 'bold' : 'normal' }}>
                      {label}
                    </Typography>
                  </StepLabel>
                </Step>
              ))}
            </Stepper>
          </Box>
        );
      },
    },
