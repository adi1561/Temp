        const isRejected = state === "REJECTED";

        const stepLabels = workflowStepsMap[workflow] || ["Creator", "Loading..."];
        let activeStep = stepLabels.indexOf(state);

        if (state === "POSTED" || state === "SCHEDULED" || state === "C" || state === "S") {
