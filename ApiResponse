    @Override
    public byte[] generateBatchExcel(String batchId) {
        // Fetch all rows belonging to this batch
        List<JournalRequest> requests = journalRequestRepository.findByBatchId(batchId);

        if (requests == null || requests.isEmpty()) {
            throw new CustomExceptions.InvalidDataException("No records found for batch: " + batchId);
        }

        // Use Apache POI to create the Excel file
        try (org.apache.poi.xssf.usermodel.XSSFWorkbook workbook = new org.apache.poi.xssf.usermodel.XSSFWorkbook();
             java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream()) {

            org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch Details");

            // 1. Create Header Row (Product Code BEFORE Remarks)
            org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "Type", "Product Code", "Remarks", "Date"};

            for (int i = 0; i < headers.length; i++) {
                org.apache.poi.ss.usermodel.Cell cell = headerRow.createCell(i);
                cell.setCellValue(headers[i]);
            }

            // 2. Populate Data Rows
            int rowIdx = 1;
            for (JournalRequest req : requests) {
                org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx++);

                row.createCell(0).setCellValue(req.getBranchCode() != null ? req.getBranchCode() : "");
                row.createCell(1).setCellValue(req.getCurrency() != null ? req.getCurrency() : "");
                row.createCell(2).setCellValue(req.getCgl() != null ? req.getCgl() : "");

                BigDecimal amount = req.getAmount();
                if (amount != null) {
                    row.createCell(3).setCellValue(amount.abs().stripTrailingZeros().toPlainString());
                    // Strictly Output Credit / Debit
                    row.createCell(4).setCellValue(amount.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
                } else {
                    row.createCell(3).setCellValue(0);
                    row.createCell(4).setCellValue("");
                }

                // Swapped Sequence: Product is Cell 5, Narration (Remarks) is Cell 6
                row.createCell(5).setCellValue(req.getProductCode() != null ? req.getProductCode() : "");
                row.createCell(6).setCellValue(req.getNarration() != null ? req.getNarration() : "");

                row.createCell(7).setCellValue(req.getPosting_date() != null ? req.getPosting_date().toString() : "");
            }

            workbook.write(out);
            return out.toByteArray();

        } catch (java.io.IOException e) {
            log.error("EXCEL_GEN_ERROR | Batch: {} | Error: {}", batchId, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Excel file", e);
        }
    }

