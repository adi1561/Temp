-- Create VOUCHER_POSTING Table
CREATE TABLE voucher_posting (
    batch_id VARCHAR2(50) PRIMARY KEY,
    vid_fk VARCHAR2(20) NOT NULL,
    creators_role VARCHAR2(100),
    created_by VARCHAR2(100),
    created_at TIMESTAMP(6) DEFAULT CURRENT_TIMESTAMP,
    current_status VARCHAR2(30),
    next_approval VARCHAR2(100),
    execution_scheduled VARCHAR2(3) CHECK (UPPER(execution_scheduled) IN ('YES', 'NO')),
    scheduled_time TIMESTAMP(6),
    approval_workflow VARCHAR2(100),
    is_schedule_override VARCHAR2(3) CHECK (UPPER(is_schedule_override) IN ('YES', 'NO')),
    executed_at TIMESTAMP(6)
);

-- Create VOUCHER_WORKFLOW Table
CREATE TABLE voucher_workflow (
    workflow_id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    batch_id_fk VARCHAR2(50) NOT NULL,
    vid_fk VARCHAR2(20) NOT NULL,
    last_action VARCHAR2(30),
    last_action_by VARCHAR2(100),
    last_action_at TIMESTAMP(6) DEFAULT CURRENT_TIMESTAMP,
    remarks VARCHAR2(500),
    scheduled_time TIMESTAMP(6),
    CONSTRAINT fk_vp_batch FOREIGN KEY (batch_id_fk) REFERENCES voucher_posting (batch_id)
);
