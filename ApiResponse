package com.fincore.journal.scheduler;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;
import java.util.List;
import java.util.Map;

@Component
public class JournalExecutionScheduler {

    @Autowired
    private JdbcTemplate jdbcTemplate;

    // Runs automatically every 30 seconds to look for due batches
    @Scheduled(cron = "*/30 * * * * *")
    public void processScheduledBatches() {
        // Query to find APPROVED batches where the scheduled time has passed
        String findDueBatchesSql = """
            SELECT BATCH_ID FROM VOUCHER_POSTING 
            WHERE WORKFLOW_STATE = 'APPROVED' 
              AND SCHEDULED_TIME <= CURRENT_TIMESTAMP
        """;

        List<Map<String, Object>> dueBatches = jdbcTemplate.queryForList(findDueBatchesSql);

        for (Map<String, Object> batch : dueBatches) {
            String batchId = String.valueOf(batch.get("BATCH_ID"));
            try {
                // Execute your core ledger posting logic here
                executeJournalPosting(batchId);
            } catch (Exception e) {
                System.err.println("Failed to execute scheduled batch " + batchId + ": " + e.getMessage());
            }
        }
    }

    private void executeJournalPosting(String batchId) {
        // 1. Run your accounting validation checks
        // 2. Insert into final core GL tables
        // 3. Mark state as POSTED
        String updateStateSql = "UPDATE VOUCHER_POSTING SET WORKFLOW_STATE = 'POSTED', EXECUTED_AT = CURRENT_TIMESTAMP WHERE BATCH_ID = ?";
        jdbcTemplate.update(updateStateSql, batchId);
    }
}
