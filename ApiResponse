                    <Paper
                      elevation={0}
                      sx={{
                        p: 3,
                        borderRadius: 2,
                        width: "100%",
                        border: "1px solid",
                        borderColor: "divider",
                        display: "flex",
                        flexDirection: "column",
                      }}
                    >
                      <Typography
                        variant="subtitle1"
                        fontWeight="bold"
                        color="text.primary"
                        gutterBottom
                        sx={{
                          borderBottom: "1px solid",
                          borderColor: "divider",
                          pb: 1,
                          mb: 2,
                        }}
                      >
                        Voucher Request ID : {vidDetails.VID}
                      </Typography>

                      <Typography
                        variant="caption"
                        color="text.secondary"
                        display="block"
                        gutterBottom
                      >
                        Voucher Description
                      </Typography>
                      <Box
                        sx={{
                          maxHeight: 90,
                          mb: "24px",
                          overflowY: "auto",
                          pr: 1,
