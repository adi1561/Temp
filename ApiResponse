package com.fincore.VoucherService.Service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.VoucherService.Models.Notifications;
import com.fincore.VoucherService.Repository.NotificationRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataAccessException;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

@Service
@RequiredArgsConstructor
@Slf4j
public class NotificationWriterService {

    private final NotificationRepository notificationRepository;
    private final StringRedisTemplate stringRedisTemplate;
    private final ObjectMapper objectMapper;

    @Value("${notification.alert.topic:notifications:alerts}")
    private String alertTopic;

    /**
     * Core method to save and broadcast the notification.
     * Uses REQUIRES_NEW so the alert fires instantly during long background tasks.
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void createNotification(String userId, String targetRole, String message, String linkUrl, String aggregateId, String eventSource) {

        if (userId == null && targetRole == null) {
            log.warn("NOTIFICATION_SKIPPED | Reason: Recipient missing | AggregateID: {}", aggregateId);
            return;
        }

        if (message == null || message.isBlank()) {
            throw new IllegalArgumentException("Notification message content is required.");
        }

        try {
            Notifications notification = Notifications.builder()
                    .userId(userId)
                    .targetRole(targetRole)
                    .message(message)
                    .linkUrl(linkUrl)
                    .aggregateId(aggregateId)
                    .eventSource(eventSource)
                    .build();

            // 1. Save to Database (Like your friend's code)
            Notifications savedNotification = notificationRepository.save(notification);

            // 2. Broadcast to Redis for live UI updates (Required for your async architecture)
            try {
                String jsonPayload = objectMapper.writeValueAsString(savedNotification);
                stringRedisTemplate.convertAndSend(alertTopic, jsonPayload);
            } catch (JsonProcessingException e) {
                log.error("NOTIFICATION_BROADCAST_FAIL | AggregateID: {} | Reason: JSON Serialization failed", aggregateId);
            }

            log.info("NOTIFICATION_SENT | User/Role: {} | Ref: {}", (userId != null ? userId : targetRole), aggregateId);

        } catch (DataAccessException e) {
            log.error("NOTIFICATION_DB_FAIL | AggregateID: {} | Reason: Database persistence failure", aggregateId);
            throw e;
        }
    }

    // ==================================================================================
    // HELPER METHODS (Adapted from your friend's architecture for cleaner code)
    // ==================================================================================

    public void createBatchApprovedNotification(String batchId, String creatorId, String approverId) {
        String message = "Your Journal Batch '" + batchId + "' has been APPROVED by " + approverId;
        createNotification(creatorId, null, message, "/journal-view/" + batchId, batchId, "JournalService");
    }

    public void createBatchRejectedNotification(String batchId, String creatorId, String rejectorId, String reason) {
        String message = "Your Journal Batch '" + batchId + "' was REJECTED by " + rejectorId + ". Reason: " + reason;
        createNotification(creatorId, null, message, "/journal-view/" + batchId, batchId, "JournalService");
    }

    /**
     * Alerts the Checkers that a batch is waiting for them.
     * As per architecture, USER_ID is strictly NULL so it maps cleanly to TARGET_ROLE.
     */
    public void createNextStepApprovalNotification(String batchId, String targetRoleId) {
        String message = "Journal Batch '" + batchId + "' has advanced to your stage and requires your review.";
        // First parameter (userId) is explicitly forced to null
        createNotification(null, targetRoleId, message, "/journal-authorization", batchId, "JournalService");
    }

    /**
     * Alerts ALL previous actors (Creator + Previous Checkers) that the batch was rejected.
     */
    public void createBatchRejectedNotificationForUsers(String batchId, List<String> previousActors, String rejectorId, String reason) {
        String message = "Journal Batch '" + batchId + "' was REJECTED by " + rejectorId + ". Reason: " + reason;

        for (String userId : previousActors) {
            // Sends a direct alert to each individual User ID
            createNotification(userId, null, message, "/journal-view/" + batchId, batchId, "JournalService");
        }
    }


    /**
     * Alerts both the Batch Creator and the original VID Creator of any progress.
     */
    public void createBatchUpdateNotificationForCreators(String batchId, String vid, String batchCreator, String vidCreator, String actionName, String executorId) {

        // 1. Notify the Batch Creator
        String batchMsg = "Your Journal Batch '" + batchId + "' was " + actionName + " by " + executorId + ".";
        createNotification(batchCreator, null, batchMsg, "/journal-posting-status", batchId, "JournalService");

        // 2. Notify the original VID Creator (ONLY if they are a different person)
        if (vidCreator != null && !vidCreator.equalsIgnoreCase(batchCreator)) {
            String vidMsg = "A Journal Batch '" + batchId + "' utilizing your Voucher ID '" + vid + "' was " + actionName + " by " + executorId + ".";
            createNotification(vidCreator, null, vidMsg, "/journal-view/" + batchId, batchId, "JournalService");
        }
    }


    /**
     * Alerts the Checkers and the Maker that the SLA time limit has been breached.
     * Uses 'EscalationEngine' as the source to prevent duplicate spamming.
     */
    public void createEscalationNotification(String batchId, String targetRoleId, String stageName, String creatorId) {

        // 1. Send High-Priority Alert to the Checkers responsible for this stage
        String checkerMsg = "ESCALATION: Journal Batch '" + batchId + "' has breached the " + stageName + " SLA limit. Immediate action required.";
        createNotification(null, targetRoleId, checkerMsg, "/journal-authorization", batchId, "EscalationEngine");

        // 2. Keep the Maker informed that there is a delay
        String makerMsg = "UPDATE: Your Batch '" + batchId + "' is taking longer than expected at the " + stageName + " stage. The respective team has been alerted.";
        createNotification(creatorId, null, makerMsg, "/journal-posting-status", batchId, "EscalationEngine");
    }


}

package com.fincore.VoucherService.Service;

import com.fincore.VoucherService.Dto.NotificationConfigDto;
import com.fincore.VoucherService.Repository.PermissionRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.dao.DataAccessException;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.stream.Collectors;

/**
 * Retrieves dynamic notification routing rules (URLs and Target Roles) from the database.
 * Results are cached locally to minimize database overhead during high-volume batch processing.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class PermissionConfigService {

    private final PermissionRepository permissionRepository;

    /**
     * Fetches the routing configuration for a specific request type.
     * Uses Spring Caching to prevent frequent database joins on the permission tables.
     * * @param requestType The identifier for the operation (e.g., 'JOURNAL_AUTH').
     * @return A configuration DTO containing the redirection URL and authorized roles.
     */
    @Cacheable(value = "notification_configs", key = "#requestType")
    public NotificationConfigDto getConfig(String requestType) {

        log.info("PERMISSION_CACHE_MISS | Fetching routing metadata for: {}", requestType);

        try {
            // 1. Database Retrieval via native join query
            List<Object[]> results = permissionRepository.findUrlAndRolesByRequestType(requestType);

            if (results.isEmpty()) {
                log.warn("PERMISSION_CONFIG_NOT_FOUND | No mapping exists for: {}. Applying defaults.", requestType);
                return new NotificationConfigDto("/dashboard", null);
            }

            String url = (String) results.get(0)[0];
            if (url == null || url.isBlank()) {
                url = "/dashboard";
            }

            // 3. Aggregate unique Role IDs into a CSV format string
            String roles = results.stream()
                    .map(row -> String.valueOf(row[1]))
                    .distinct()
                    .collect(Collectors.joining(","));

            if (roles.isEmpty()) {
                log.warn("PERMISSION_ROLES_EMPTY | Mapping exists for {} but no roles are assigned.", requestType);
                return new NotificationConfigDto(url, null);
            }

            log.info("PERMISSION_CONFIG_LOADED | RequestType: {} | RedirectionPath: {}", requestType, url);
            return new NotificationConfigDto(url, roles);

        } catch (DataAccessException e) {
            // Specific exception for database connectivity or SQL syntax issues
            log.error("PERMISSION_DB_FAIL | Could not retrieve metadata for {}: {}", requestType, e.getMessage());
            // Fail safely by returning the default dashboard path without target roles
            return new NotificationConfigDto("/dashboard", null);
        }
    }
}
package com.fincore.VoucherService.Service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.VoucherService.Dto.TaskProgressDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataAccessException;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicLong;

/**
 * Service to manage and publish real-time task progress updates.
 * Uses Redis Pub/Sub to push updates to the frontend with built-in throttling
 * to prevent overwhelming the network during high-volume batch operations.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class ProgressService {

    private final StringRedisTemplate stringRedisTemplate;
    private final ObjectMapper objectMapper;

    @Value("${notification.progress.topic:notifications:progress}")
    private String progressTopic;

    // Local cache to track the last update time per task for throttling logic
    private final ConcurrentHashMap<String, AtomicLong> throttleMap = new ConcurrentHashMap<>();

    /**
     * Publishes task progress asynchronously.
     * Applies a 500ms throttle for intermediate updates (0 < % < 100).
     * Final states (100% or FAILED) are always published immediately.
     */
    @Async("progressExecutor")
    public void sendProgress(String taskId, String userId, int percent, String status, String message) {
        try {
            // 1. Throttling: Skip intermediate updates if sent within the last 500ms
            if (percent > 0 && percent < 100 && !"FAILED".equals(status)) {
                AtomicLong lastTime = throttleMap.computeIfAbsent(taskId, k -> new AtomicLong(0));
                long now = System.currentTimeMillis();
                if (now - lastTime.get() < 500) {
                    return;
                }
                lastTime.set(now);
            }

            // 2. Build Progress DTO
            TaskProgressDto dto = TaskProgressDto.builder()
                    .taskId(taskId)
                    .userId(userId)
                    .percentage(percent)
                    .status(status)
                    .message(message)
                    .build();

            // 3. Serialize and Publish to Redis
            String jsonPayload = objectMapper.writeValueAsString(dto);
            stringRedisTemplate.convertAndSend(progressTopic, jsonPayload);

            // 4. Cleanup throttle cache on task completion or failure
            if (percent == 100 || "FAILED".equals(status)) {
                throttleMap.remove(taskId);
            }

        } catch (JsonProcessingException e) {
            // Specific exception for Jackson serialization failures
            log.error("PROGRESS_SERIALIZATION_FAIL | Task: {} | Reason: Failed to convert DTO to JSON", taskId);
        } catch (DataAccessException e) {
            // Specific exception for Redis connectivity or command failures
            log.error("PROGRESS_REDIS_PUBLISH_FAIL | Task: {} | Reason: Redis service unavailable", taskId);
        }
    }
}

