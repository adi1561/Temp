package com.fincore.VoucherService.Controllers;

import com.fincore.VoucherService.Dto.JsEodMasterDTO;
import com.fincore.VoucherService.Models.JournalRequest;
import com.fincore.VoucherService.Models.RequestVoucher;
import com.fincore.VoucherService.Service.JsEodMasterService;
import com.fincore.VoucherService.Service.RequestVoucherService;
import com.fincore.VoucherService.Service.VoucherRequestService;
import com.fincore.VoucherService.Service.core.VoucherQueryService;
import com.fincore.commonutilities.jwt.JwtUtil;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.domain.PageRequest;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/voucher")
@RequiredArgsConstructor
@Slf4j
public class VoucherQueryController {

    private final VoucherQueryService queryService;
    private final VoucherRequestService voucherRequestService; // Retained for utility methods
    private final JsEodMasterService jsEodMasterService;
    private final RequestVoucherService requestVoucherService;
    private final JwtUtil jwtUtil;

    // ==================================================================================
    // 1. BATCH DATA FETCHING
    // ==================================================================================

    @GetMapping("/by-batch/{batchId}")
    public ResponseEntity<?> getRequestsByBatchId(@PathVariable String batchId) {
        long count = voucherRequestService.getRequestCountByBatchId(batchId);
        if (count > 2000) {
            log.warn("LARGE_FETCH_BLOCKED | Batch: {} | Rows: {}", batchId, count);
            return ResponseEntity.status(HttpStatus.PAYLOAD_TOO_LARGE).body(Map.of(
                    "error", "Batch too large (" + count + " rows). Please use Paginated API.",
                    "suggestion", "/api/voucher/by-batch-paginated/" + batchId
            ));
        }
        return ResponseEntity.ok(voucherRequestService.getRequestsByBatchId(batchId));
    }

    @GetMapping("/by-batch-paginated/{batchId}")
    public ResponseEntity<?> getRequestsByBatchIdPaginated(
            @PathVariable String batchId,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "10") int size) {
        return ResponseEntity.ok(voucherRequestService.getRequestsByBatchIdPaginated(batchId, PageRequest.of(page, size)));
    }

    @GetMapping("/download-batch/{batchId}")
    public ResponseEntity<byte[]> downloadBatchExcel(
            @PathVariable String batchId, @RequestHeader("Authorization") String token) {
        try {
            String userId = jwtUtil.getUserIdFromToken(token.substring(7));
            Integer userRole = jwtUtil.getUserRoleFromToken(token.substring(7));

            if (!voucherRequestService.isUserAuthorizedForBatch(batchId, userId, userRole)) {
                log.warn("SECURITY_VIOLATION | User: {} attempted forced browsing on Batch: {}", userId, batchId);
                return ResponseEntity.status(HttpStatus.FORBIDDEN).build();
            }

            byte[] fileData = voucherRequestService.generateBatchExcel(batchId);

            org.springframework.http.HttpHeaders headers = new org.springframework.http.HttpHeaders();
            headers.setCacheControl(org.springframework.http.CacheControl.noCache().mustRevalidate().sMaxAge(java.time.Duration.ZERO));
            headers.setPragma("no-cache");
            headers.setExpires(0L);
            headers.set("X-Content-Type-Options", "nosniff");
            headers.set("Content-Security-Policy", "default-src 'self'");
            headers.set(org.springframework.http.HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"Batch_" + batchId + ".xlsx\"");
            headers.set(org.springframework.http.HttpHeaders.CONTENT_TYPE, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            return ResponseEntity.ok().headers(headers).body(fileData);
        } catch (Exception e) {
            log.error("DOWNLOAD_ERROR | Batch: {} | Reason: {}", batchId, e.getMessage());
            return ResponseEntity.badRequest().build();
        }
    }

    // ==================================================================================
    // 2. DASHBOARDS & SUMMARIES
    // ==================================================================================

    @GetMapping("/all-requests-summary")
    public ResponseEntity<List<Map<String, Object>>> getAllRequestsSummary(@RequestHeader("Authorization") String token) {
        String userId = jwtUtil.getUserIdFromToken(token);
        return ResponseEntity.ok(queryService.getAllRequestsSummary(userId));
    }

    @GetMapping("/checker/pending-approvals")
    public ResponseEntity<List<Map<String, Object>>> getPendingApprovals(@RequestHeader("Authorization") String token) {
        Integer userRole = jwtUtil.getUserRoleFromToken(token);
        String userId = jwtUtil.getUserIdFromToken(token);
        return ResponseEntity.ok(queryService.getPendingBatchesForChecker(userRole, userId));
    }

    @GetMapping("/pending-requests")
    public List<JournalRequest> getPendingRequests(@RequestHeader("Authorization") String token) {
        return voucherRequestService.getPendingRequests(jwtUtil.getUserIdFromToken(token), jwtUtil.getUserRoleFromToken(token));
    }

    @GetMapping("/batch-summary/{batchId}")
    public ResponseEntity<Map<String, Object>> getBatchSummaryDetails(@PathVariable String batchId) {
        return ResponseEntity.ok(queryService.getBatchSummaryDetails(batchId));
    }

    @GetMapping("/workflow-history/{batchId}")
    public ResponseEntity<List<Map<String, Object>>> getWorkflowHistory(@PathVariable String batchId) {
        return ResponseEntity.ok(queryService.getWorkflowHistory(batchId));
    }

    // ==================================================================================
    // 3. UTILITIES & METADATA
    // ==================================================================================

    @GetMapping("/current-posting-date")
    public String getCurrentPostingDate() {
        return voucherRequestService.getCurrentPostingDate().format(DateTimeFormatter.ISO_LOCAL_DATE);
    }

    @GetMapping("/eod_status")
    public ResponseEntity<List<JsEodMasterDTO>> getEodStatus() {
        return new ResponseEntity<>(jsEodMasterService.getAllData(), HttpStatus.OK);
    }

    @GetMapping("/filter")
    public ResponseEntity<List<RequestVoucher>> getFilteredVouchers(
            @RequestParam(required = false) String category,
            @RequestParam(required = false) String role,
            @RequestParam(required = false) @DateTimeFormat(pattern = "yyyy-MM-dd") LocalDate date) {
        return ResponseEntity.ok(requestVoucherService.getFilteredVouchers(category, role, date));
    }

    @GetMapping("/workflow/steps/{workflowCode}")
    public ResponseEntity<List<Map<String, Object>>> getWorkflowSteps(@PathVariable String workflowCode) {
        return ResponseEntity.ok(voucherRequestService.getWorkflowSteps(workflowCode));
    }

    @GetMapping("/active-roles")
    public ResponseEntity<Map<String, String>> getActiveRoles() {
        return ResponseEntity.ok(voucherRequestService.getActiveRoles());
    }

    @GetMapping("/vid-details/{vid}")
    public ResponseEntity<Map<String, Object>> getVidDetails(@PathVariable String vid) {
        return ResponseEntity.ok(voucherRequestService.getVidDetails(vid));
    }

    @GetMapping("/active")
    public ResponseEntity<Map<String, Object>> getAvailableVouchers(@RequestParam Long roleId) {
        List<Map<String, Object>> records = voucherRequestService.getAvailableVouchersVid(roleId);
        Map<String, Object> response = new HashMap<>();
        response.put("data", records);
        response.put("message", "Success");
        response.put("status", "OK");
        return ResponseEntity.ok(response);
    }
}

