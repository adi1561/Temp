### Step 3: Create the Service Logic
This is where the magic happens. We build a query dynamically based on what the user passes.
**File:** RequestVoucherService.java (in com.fincore.VoucherService.Service)
```java
package com.fincore.VoucherService.Service;

import com.fincore.VoucherService.Models.RequestVoucher;
import com.fincore.VoucherService.Repository.RequestVoucherRepository;
import jakarta.persistence.criteria.Predicate;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

@Service
@RequiredArgsConstructor
@Slf4j
public class RequestVoucherService {

    private final RequestVoucherRepository requestVoucherRepository;

    public List<RequestVoucher> getFilteredVouchers(String category, String role, LocalDate date) {
        log.info("Fetching Request Vouchers | Category: {}, Role: {}, Date: {}", category, role, date);

        Specification<RequestVoucher> spec = (root, query, cb) -> {
            List<Predicate> predicates = new ArrayList<>();

            // 1. Add Category Filter if provided
            if (category != null && !category.trim().isEmpty()) {
                predicates.add(cb.equal(root.get("category"), category.trim()));
            }

            // 2. Add Role Filter if provided
            if (role != null && !role.trim().isEmpty()) {
                predicates.add(cb.equal(root.get("allowedRole"), role.trim()));
            }

            // 3. Add Date Filter if provided (Matches from 00:00:00 to 23:59:59 of that day)
            if (date != null) {
                LocalDateTime startOfDay = date.atStartOfDay();
                LocalDateTime endOfDay = date.atTime(23, 59, 59, 999999999);
                predicates.add(cb.between(root.get("createdAt"), startOfDay, endOfDay));
            }

            // If no filters were added, this returns all records.
            return cb.and(predicates.toArray(new Predicate[0]));
        };

        // Sort by ID or CreatedAt descending so newest records appear first
        return requestVoucherRepository.findAll(spec, org.springframework.data.domain.Sort.by(org.springframework.data.domain.Sort.Direction.DESC, "createdAt"));
    }
}

```
### Step 4: Create the Controller Endpoint
Expose this via a REST API where all parameters are marked as required = false.
**File:** RequestVoucherController.java (in com.fincore.VoucherService.Controllers)
```java
package com.fincore.VoucherService.Controllers;

import com.fincore.VoucherService.Models.RequestVoucher;
import com.fincore.VoucherService.Service.RequestVoucherService;
import lombok.RequiredArgsConstructor;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.time.LocalDate;
import java.util.List;

@RestController
@RequestMapping("/api/request-vouchers")
@RequiredArgsConstructor
public class RequestVoucherController {

    private final RequestVoucherService requestVoucherService;

    @GetMapping("/filter")
    public ResponseEntity<List<RequestVoucher>> getFilteredVouchers(
            @RequestParam(required = false) String category,
            @RequestParam(required = false) String role,
            @RequestParam(required = false) @DateTimeFormat(pattern = "yyyy-MM-dd") LocalDate date) {

        List<RequestVoucher> results = requestVoucherService.getFilteredVouchers(category, role, date);
        return ResponseEntity.ok(results);
    }
}

```
### How to Test This in Postman
Because we used @RequestParam(required = false), Spring Boot will handle all combinations automatically:
 1. **Get ALL Data (No Filters passed):**
   GET http://localhost:8080/api/request-vouchers/filter
 2. **Filter strictly by Category:**
   GET http://localhost:8080/api/request-vouchers/filter?category=TRAVEL
 3. **Filter by Role and Date:**
   GET http://localhost:8080/api/request-vouchers/filter?role=TCSGLIF&date=2026-05-26
 4. **Filter by ALL conditions:**
   GET http://localhost:8080/api/request-vouchers/filter?category=TRAVEL&role=TCSGLIF&date=2026-05-26
