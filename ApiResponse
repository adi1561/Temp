CREATE OR REPLACE TRIGGER TRG_SYNC_JS_EOD_COUNTER
AFTER INSERT OR UPDATE OR DELETE ON JOURNAL_BATCH_MASTER
FOR EACH ROW
DECLARE
    v_diff NUMBER := 0;
BEGIN
    -- 1. Determine if the pending count goes UP or DOWN
    IF INSERTING THEN
        IF :NEW.BATCH_STATUS = 'PENDING' THEN
            v_diff := 1;
        END IF;
        
    ELSIF UPDATING THEN
        -- It was Pending, but now it is something else (e.g. Accepted, Rejected, Queued)
        IF :OLD.BATCH_STATUS = 'PENDING' AND :NEW.BATCH_STATUS != 'PENDING' THEN
            v_diff := -1;
        -- It was something else, but returned to Pending (e.g. Async failure)
        ELSIF :OLD.BATCH_STATUS != 'PENDING' AND :NEW.BATCH_STATUS = 'PENDING' THEN
            v_diff := 1;
        END IF;
        
    ELSIF DELETING THEN
        IF :OLD.BATCH_STATUS = 'PENDING' THEN
            v_diff := -1;
        END IF;
    END IF;

    -- 2. If a change happened, update the master table and the JS boolean flag
    IF v_diff != 0 THEN
        UPDATE JS_EOD_MASTER
        SET 
            JS_PENDING_COUNTER = JS_PENDING_COUNTER + v_diff,
            -- If Counter becomes 0, set JS_STATUS to 1 (True), otherwise 0 (False)
            JS_STATUS = CASE WHEN (JS_PENDING_COUNTER + v_diff) = 0 THEN 1 ELSE 0 END,
            JS_UPDATED_AT = SYSTIMESTAMP
        WHERE ID = 1;
    END IF;
END;
/
