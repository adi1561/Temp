### Step 3: Update Workflow Progression (processWorkflowAction)
We fetch the current stage using PENDING_AT. If approved, we find ORDER + 1 and update PENDING_AT. If rejected, we just change BATCH_STATUS to 'R'.
**Replace your current processWorkflowAction routing block with this:**
```java
        // ==========================================
        // 4. DYNAMIC STATE PROGRESSION (WORKFLOW_ID BASED)
        // ==========================================
        String actionTaken = dto.getStatus().toString();

        // 1. Fetch current step details via PENDING_AT
        Map<String, Object> currentStepData;
        try {
            currentStepData = jdbcTemplate.queryForMap(
                    "SELECT WORKFLOW_CODE, WORKFLOW_ORDER, IS_FINAL_APPROVAL, WORKFLOW_STAGE FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_ID = ?",
                    posting.getPendingAt()
            );
        } catch (EmptyResultDataAccessException e) {
            throw new CustomExceptions.InvalidDataException("Configuration Error: Current stage not found.");
        }

        String workflowCode = (String) currentStepData.get("WORKFLOW_CODE");
        Integer currentOrder = ((Number) currentStepData.get("WORKFLOW_ORDER")).intValue();
        String isFinal = (String) currentStepData.get("IS_FINAL_APPROVAL");
        String currentStageName = (String) currentStepData.get("WORKFLOW_STAGE");

        // 5. Apply the Rule
        if ("REJECTED".equals(actionTaken)) {
            // Leave PENDING_AT as is (so we know WHERE it was rejected), just change status to 'R'
            posting.setBatchStatus("R");
            voucherPostingRepository.save(posting);

            logWorkflowAction(batchId, posting.getVidFk(), "REJECTED", executorId, dto.getRemarks(), null);
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R' WHERE BATCH_ID = ?", batchId);
            notificationWriterService.createBatchRejectedNotification(batchId, posting.getCreatedBy(), executorId, dto.getRemarks());

            if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) {
                updateVidStatus(posting.getVidFk(), VoucherStatus.ACTIVE);
            }
            return;
        }

        if ("Y".equals(isFinal)) {
            // Find the Executor Step (Order + 1)
            Long executorWorkflowId = jdbcTemplate.queryForObject(
                    "SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?",
                    Long.class, workflowCode, currentOrder + 1
            );
            posting.setPendingAt(executorWorkflowId); // Move it to the final Executor step

            // Scheduling Logic
            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime() != null) {
                if (posting.getScheduledTime().isBefore(LocalDateTime.now())) {
                    if (dto.getOverrideScheduleLapse() == null || !dto.getOverrideScheduleLapse()) {
                        throw new CustomExceptions.ScheduleLapsedException("The scheduled execution time has passed.");
                    }
                    if (dto.getNewScheduledTime() != null) {
                        posting.setScheduledTime(dto.getNewScheduledTime());
                        posting.setIsScheduleOverride("YES");
                    } else {
                        posting.setExecutionScheduled("NO");
                    }
                }
            }

            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime().isAfter(LocalDateTime.now())) {
                posting.setBatchStatus("S"); // 'S' = Scheduled
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_SCHEDULED", executorId, dto.getRemarks(), posting.getScheduledTime());
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'SCHEDULED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            } else {
                posting.setBatchStatus("C"); // 'C' = Completed/Posted
                posting.setExecutedAt(LocalDateTime.now());
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_POSTED", executorId, dto.getRemarks(), null);

                if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) {
                    updateVidStatus(posting.getVidFk(), VoucherStatus.COMPLETED);
                }

                // Trigger execution procedure
                BulkProcessVoucherPostingDto execDto = new BulkProcessVoucherPostingDto();
                execDto.setBatchId(batchId);
                execDto.setStatus(RequestStatus.ACCEPTED);
                execDto.setRemarks(dto.getRemarks());
                this.processBulkRequestsAsync(execDto, executorId, executorRole);
            }
            notificationWriterService.createBatchApprovedNotification(batchId, posting.getCreatedBy(), executorId);

        } else {
            // Move to the next approver step
            Long nextApproverId = jdbcTemplate.queryForObject(
                    "SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?",
                    Long.class, workflowCode, currentOrder + 1
            );
            
            posting.setPendingAt(nextApproverId);
            logWorkflowAction(batchId, posting.getVidFk(), "APPROVED_" + currentStageName, executorId, dto.getRemarks(), null);
        }

        voucherPostingRepository.save(posting);

```
### Step 4: Update the Checker Grids (Approver View)
The checker should only see batches where BATCH_STATUS = 'P' AND where WORKFLOW_TRANSITIONS.ALLOWED_ROLE_ID matches their role.
**Update getPendingBatchesForChecker(Integer userRole) (and do the same for getPendingBatchSummaries):**
```java
    @Override
    public List<Map<String, Object>> getPendingBatchesForChecker(Integer userRole) {
        String sql = """
            SELECT 
                b.BATCH_ID, p.VID_FK, b.CREATOR_ID, b.REQ_DATE, b.BATCH_REMARKS, 
                b.TOTAL_ROWS, p.SCHEDULED_TIME,
                w.WORKFLOW_STAGE, w.WORKFLOW_CODE
            FROM JOURNAL_BATCH_MASTER b
            INNER JOIN VOUCHER_POSTING p ON b.BATCH_ID = p.BATCH_ID
            INNER JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            WHERE w.ALLOWED_ROLE_ID = ? AND p.BATCH_STATUS = 'P'
            ORDER BY b.REQ_DATE DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            
            // Map SQL columns directly to frontend expectation
            map.put("workflowState", rs.getString("WORKFLOW_STAGE")); 
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            return map;
        }, userRole);
    }

```
### Step 5: Update the Universal Status Grid (getAllRequestsSummary)
This powers your main tracking screen. We join the tables to dynamically fetch the Stage Name and format it so the React frontend still understands it perfectly.
**Replace getAllRequestsSummary() with this:**
```java
    @Override
    public List<Map<String, Object>> getAllRequestsSummary() {
        String sql = """
            SELECT 
                b.BATCH_ID, b.CREATOR_ID, b.REQ_DATE, b.BATCH_REMARKS, 
                b.TOTAL_ROWS, b.TOTAL_DEBIT, b.TOTAL_CREDIT, 
                p.BATCH_STATUS, w.WORKFLOW_STAGE, w.WORKFLOW_CODE
            FROM JOURNAL_BATCH_MASTER b
            INNER JOIN VOUCHER_POSTING p ON b.BATCH_ID = p.BATCH_ID
            LEFT JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            ORDER BY b.REQ_DATE DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("totalDebit", rs.getBigDecimal("TOTAL_DEBIT"));
            map.put("totalCredit", rs.getBigDecimal("TOTAL_CREDIT"));
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            
            // Format BATCH_STATUS for the Frontend React Stepper
            String bStatus = rs.getString("BATCH_STATUS");
            if ("R".equals(bStatus)) {
                map.put("currentStatus", "REJECTED");
            } else if ("C".equals(bStatus)) {
                map.put("currentStatus", "POSTED");
            } else if ("S".equals(bStatus)) {
                map.put("currentStatus", "SCHEDULED");
            } else {
                // If 'P', just use the actual stage name (e.g., 'Reviewer')
                map.put("currentStatus", rs.getString("WORKFLOW_STAGE"));
            }
            
            return map;
        });
    }

```
