import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination,
  IconButton,
  Tooltip,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  Send as SendIcon,
  FileDownload as FileDownloadIcon,
  ArrowBack as ArrowBackIcon,
  Close as CloseIcon,
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// --- STYLES ---
const mainContainerStyle = { padding: 3, height: "100%", width: "100%" };
const controlPanelStyle = {
  padding: "30px",
  marginBottom: "20px",
  borderRadius: "12px",
  backgroundColor: "background.paper",
  boxShadow: 2,
};
const uploadBoxStyle = {
  position: "relative",
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  alignItems: "center",
  border: 2,
  borderStyle: "dashed",
  borderRadius: "12px",
  padding: "40px",
  cursor: "pointer",
  transition: "all 0.3s ease",
  minHeight: "220px",
};
const iconStyle = { fontSize: "8rem" };
const headerTextStyle = { fontWeight: 600, fontSize: "1.1rem", textAlign: "center", mb: 2 };
const subTextStyle = { color: "text.secondary", fontSize: "0.85rem", textAlign: "center", marginBottom: "25px" };
const descriptionIconStyle = { color: "success.main", mb: 1, fontSize: "6rem" };
const tableContainerStyle = { borderRadius: "12px", border: "1px solid", borderColor: "divider", marginTop: "20px", maxHeight: 600 };
const tableHeaderStyle = { backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08) };
const tableHeaderCellStyle = { color: "text.primary", fontWeight: "bold", fontSize: "0.95rem" };
const actionButtonsContainer = { display: "flex", justifyContent: "center", marginTop: 4, gap: 2 };
const customButtonStyle = { padding: "7px 60px", margin: "0px 20px" };

const mainSteps = ["Upload & Validate", "Preview & Submit"];
const validationSteps = ["Format Validation", "Database Validation", "Balance Validation"];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [activeStep, setActiveStep] = useState(0);
  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [isCsvFile, setIsCsvFile] = useState(false);
  const fileInputRef = useRef(null);

  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [isDebouncing, setIsDebouncing] = useState(false);
  const [isDragging, setIsDragging] = useState(false);

  const [validationStage, setValidationStage] = useState(0);
  const [resultStatus, setResultStatus] = useState(null);
  const [resultMsg, setResultMsg] = useState("");
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);
  const [downloadMsg, setDownloadMsg] = useState("Downloading Error Report...");

  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(50);
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  const handleDateChange = (e) => setSelectedDate(e.target.value);

  const triggerDebounce = () => {
    setIsDebouncing(true);
    setTimeout(() => setIsDebouncing(false), 3000);
  };

  // --- REUSABLE FILE VALIDATION ---
  const processFile = (selected) => {
    if (!selected) return;
    const fileName = selected.name.toLowerCase();
    const fileSize = selected.size;

    const allowedExtensions = [".xlsx", ".xls", ".csv", ".txt"];
    const isValidExt = allowedExtensions.some((ext) => fileName.endsWith(ext));

    if (!isValidExt) {
      showSnackBar("Invalid file type! Use .xlsx, .csv, or .txt", "error");
      return;
    }

    if (fileSize > 50 * 1024 * 1024) {
      showSnackBar("File too large! Max allowed size is 50MB.", "error");
      return;
    }

    if (fileSize === 0) {
      showSnackBar("File is empty (0kb).", "error");
      return;
    }

    const validNameRegex = /^[a-zA-Z0-9\s._-]+$/;
    if (!validNameRegex.test(selected.name)) {
      showSnackBar("Invalid filename! Please remove special characters.", "error");
      return;
    }

    setFile(selected);
    setIsCsvFile(fileName.endsWith(".csv") || fileName.endsWith(".txt"));
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setPreviewRows([]);
    setIsProcessing(false);
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) processFile(e.target.files[0]);
  };

  // --- DRAG AND DROP HANDLERS ---
  const handleDragOver = (e) => {
    e.preventDefault();
    setIsDragging(true);
  };

  const handleDragLeave = () => setIsDragging(false);

  const handleDrop = (e) => {
    e.preventDefault();
    setIsDragging(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      processFile(e.dataTransfer.files[0]);
      e.dataTransfer.clearData();
    }
  };

  const handleClearFile = (e) => {
    e.stopPropagation();
    setFile(null);
    setIsCsvFile(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
    setResultStatus(null);
  };

  const resetAll = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setFile(null);
    setPreviewRows([]);
    setIsProcessing(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const downloadFileHelper = async (url, filename) => {
    try {
      const response = await callApi(url, null, "GET", "blob");
      const blob = new Blob([response.data || response]);
      const link = document.createElement("a");
      link.href = window.URL.createObjectURL(blob);
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      return true;
    } catch (e) {
      showSnackBar("Download failed", "error");
      return false;
    }
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !file) {
      showSnackBar("Select Date and File first.", "warning");
      return;
    }
    triggerDebounce();
    setIsProcessing(true);
    setResultStatus(null);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const data = await callApi("/JS/journals/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      if (data?.requestId) setRequestId(data.requestId);
    } catch (err) {
      setIsProcessing(false);
      setResultStatus("ERROR");
      setResultMsg("Initialization Failed.");
    }
  };

  const handleCreateBatch = async () => {
    triggerDebounce();
    setIsCreatingBatch(true);
    try {
      const payload = { requestId, commonBatchRemarks: `Bulk Upload - ${selectedDate}` };
      const res = await callApi("/JS/journals/create-batch-from-cache", payload, "POST");
      if (res?.batchId || res?.status === "SUCCESS") {
        showSnackBar("Batch creation initiated!", "success");
        setTimeout(resetAll, 1500);
      }
    } catch (e) {
      showSnackBar("Submission failed.", "error");
    } finally {
      setIsCreatingBatch(false);
    }
  };

  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;
          if (res.totalRows) setTotalRows(res.totalRows);

          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setValidationStage(res.currentStage || 1);
            clearInterval(interval);
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              downloadFileHelper(`/JS/journals/download-bulk-file/${requestId}?type=ERROR`, "Error_Report.xlsx");
            }
          } else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setValidationStage(4);
            if (res.previewDataJson) setPreviewRows(JSON.parse(res.previewDataJson));
            clearInterval(interval);
            setTimeout(() => setActiveStep(1), 1000);
          } else {
            setValidationStage(res.currentStage);
          }
        } catch (e) {}
      }, 800);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, autoDlTriggered]);

  const visibleRows = previewRows.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage);

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        <Box sx={{ width: "100%", maxWidth: "80%", margin: "0 auto", mb: 4 }}>
          <Stepper activeStep={activeStep}>
            {mainSteps.map((label) => <Step key={label}><StepLabel>{label}</StepLabel></Step>)}
          </Stepper>
        </Box>

        {activeStep === 0 && (
          <Box>
            <Box
              onDragOver={handleDragOver}
              onDragLeave={handleDragLeave}
              onDrop={handleDrop}
              onClick={() => fileInputRef.current.click()}
              sx={{
                ...uploadBoxStyle,
                borderColor: isDragging ? "secondary.main" : (resultStatus === "ERROR" ? "error.main" : "primary.main"),
                backgroundColor: (theme) => isDragging ? alpha(theme.palette.primary.main, 0.1) : alpha(theme.palette.primary.main, 0.02),
              }}
            >
              <Box sx={boxCenterStyle}>
                {file ? (
                  <Box sx={{ position: "relative" }}>
                    <DescriptionIcon sx={descriptionIconStyle} />
                    <Typography sx={headerTextStyle}>{file.name}</Typography>
                    <IconButton size="small" onClick={handleClearFile} sx={{ position: "absolute", top: -10, right: -40, bgcolor: "background.paper" }}>
                      <CloseIcon fontSize="small" />
                    </IconButton>
                  </Box>
                ) : (
                  <Box sx={{ textAlign: "center" }}>
                    <CloudUploadIcon sx={iconStyle} />
                    <Typography sx={headerTextStyle}>{isDragging ? "Drop it!" : "Click or Drag & Drop File"}</Typography>
                    <Typography sx={subTextStyle}>Max 50MB (.xlsx, .csv, .txt)</Typography>
                  </Box>
                )}
              </Box>
              <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv,.txt" />
            </Box>

            <Stack direction="row" spacing={2} justifyContent="center" sx={{ mt: 3 }}>
              <TextField type="date" label="Posting Date" value={selectedDate} onChange={handleDateChange} InputLabelProps={{ shrink: true }} size="small" sx={{ width: 220 }} />
              <Button variant="contained" size="large" onClick={handleStartValidation} disabled={!file || !selectedDate || isDebouncing || isProcessing} startIcon={isProcessing ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}>
                {isProcessing ? "Validating..." : "Start Validation"}
              </Button>
            </Stack>

            {(isProcessing || resultStatus) && (
              <Box sx={{ mt: 5 }}>
                <Stepper activeStep={validationStage - 1} alternativeLabel>
                  {validationSteps.map((label, index) => (
                    <Step key={label}>
                      <StepLabel error={resultStatus === "ERROR" && index === validationStage - 1}>{label}</StepLabel>
                    </Step>
                  ))}
                </Stepper>
                {resultStatus === "ERROR" && <Alert severity="error" sx={{ mt: 3 }}>{resultMsg}</Alert>}
              </Box>
            )}
          </Box>
        )}

        {activeStep === 1 && (
          <Box>
            <Alert severity="success" sx={{ mb: 2 }}>Validation Passed! Rows: <strong>{totalRows}</strong></Alert>
            <TableContainer sx={tableContainerStyle}>
              <Table stickyHeader size="small">
                <TableHead sx={tableHeaderStyle}>
                  <TableRow>
                    {["Branch", "Currency", "CGL", "Amount", "Type", "Remarks"].map(h => <TableCell key={h} sx={tableHeaderCellStyle} align="center">{h}</TableCell>)}
                  </TableRow>
                </TableHead>
                <TableBody>
                  {visibleRows.map((row, i) => (
                    <TableRow key={i} hover>
                      <TableCell align="center">{row.branch}</TableCell>
                      <TableCell align="center">{row.currency}</TableCell>
                      <TableCell align="center">{row.cgl}</TableCell>
                      <TableCell align="right">{row.amount}</TableCell>
                      <TableCell align="center"><Chip label={row.txnType} color={row.txnType.includes("Credit") ? "error" : "success"} size="small" /></TableCell>
                      <TableCell align="center">{row.remarks}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
            <TablePagination rowsPerPageOptions={[50, 100]} component="div" count={previewRows.length} rowsPerPage={rowsPerPage} page={page} onPageChange={(e, p) => setPage(p)} onRowsPerPageChange={e => setRowsPerPage(e.target.value)} />
            <Stack direction="row" spacing={2} sx={actionButtonsContainer}>
              <Button variant="outlined" onClick={() => setActiveStep(0)} startIcon={<ArrowBackIcon />}>Back</Button>
              <Button variant="contained" color="success" size="large" onClick={handleCreateBatch} disabled={isCreatingBatch || isDebouncing} startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}>
                {isCreatingBatch ? "Creating..." : "Submit Batch"}
              </Button>
            </Stack>
          </Box>
        )}
      </Paper>
    </Box>
  );
};

export default JournalBulkUpload;
