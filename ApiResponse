const formatCurrency = (val) => {
  if (val === null || val === undefined || val === "") return "0.0000";

  // Ensure it's a string without using Number()
  const strVal = String(val).trim();

  // Split into integer and decimal parts
  const parts = strVal.split(".");
  let intPart = parts[0];
  let decPart = parts[1] || "";

  // Pad or truncate to exactly 4 decimal places
  decPart = decPart.padEnd(4, "0").substring(0, 4);

  // Safely add commas to the integer part (e.g. 1000000 -> 1,000,000)
  intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

  return `${intPart}.${decPart}`;
};

