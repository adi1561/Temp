  // --- API & Environment States ---
  const [currencyOptions, setCurrencyOptions] = useState([]);
  const [postingDate, setPostingDate] = useState("");
  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);

  // --- React Hook Form Setup ---
  const { control, handleSubmit: hookFormSubmit, setValue, getValues, reset, formState: { errors, isSubmitting, isValid } } = useForm({
    resolver: zodResolver(formSchema),
    mode: "onChange", // Validates instantly as user types!
    defaultValues: { commonBatchRemarks: "", applyToAll: false, rows: [initialRowState] }
  });

  const { fields, append, remove } = useFieldArray({ control, name: "rows" });

  // Watch for "Apply to all" logic
  const applyToAll = useWatch({ control, name: "applyToAll" });
  const commonBatchRemarks = useWatch({ control, name: "commonBatchRemarks" });

  // Sync remarks if checkbox is checked
  useEffect(() => {
    if (applyToAll) {
      const currentRows = getValues("rows");
      currentRows.forEach((_, idx) => setValue(`rows.${idx}.remarks`, commonBatchRemarks || "", { shouldValidate: true }));
    }
  }, [commonBatchRemarks, applyToAll, setValue, getValues]);

