    @Override
    public List<Map<String, Object>> getPendingBatchesForChecker(Integer userRole) {
        String sql = """
            SELECT 
                b.BATCH_ID, p.VID_FK AS VID, b.CREATOR_ID, b.REQ_DATE, b.BATCH_REMARKS, 
                b.TOTAL_ROWS, p.SCHEDULED_TIME,
                w.WORKFLOW_STAGE, w.WORKFLOW_CODE, w.ESCALATION_TIME, w.WORKFLOW_ORDER,
                COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, b.CREATOR_ID) AS CREATOR_NAME,
                -- DOUBLE VALIDATION: Must be 'Y' in DB AND be the max order for THIS specific workflow code
                CASE 
                    WHEN w.IS_FINAL_APPROVAL = 'Y' AND w.WORKFLOW_ORDER = (
                        SELECT MAX(wt.WORKFLOW_ORDER) 
                        FROM WORKFLOW_TRANSITIONS wt 
                        WHERE wt.WORKFLOW_CODE = w.WORKFLOW_CODE AND wt.ALLOWED_ROLE_ID IS NOT NULL
                    ) THEN 'Y'
                    ELSE 'N'
                END AS SAFE_FINAL_APPROVAL
            FROM JOURNAL_BATCH_MASTER b
            INNER JOIN VOUCHER_POSTING p ON b.BATCH_ID = p.BATCH_ID
            INNER JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            LEFT JOIN USERS u ON b.CREATOR_ID = u.USER_ID
            WHERE w.ALLOWED_ROLE_ID = ? AND p.BATCH_STATUS = 'P'
            ORDER BY b.REQ_DATE DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("vid", rs.getString("VID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("creatorName", rs.getString("CREATOR_NAME"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("escalationTime", rs.getLong("ESCALATION_TIME"));
            map.put("workflowState", rs.getString("WORKFLOW_STAGE"));
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            map.put("currentOrder", rs.getObject("WORKFLOW_ORDER"));
            map.put("isFinalApproval", rs.getString("SAFE_FINAL_APPROVAL")); // The Double-Checked Flag!
            return map;
        }, userRole);
    }

    @Transactional
    public void processWorkflowAction(ProcessVoucherRequestDto dto, String executorId, Integer executorRole) {
        String batchId = dto.getBatchId();

        VoucherPosting posting = voucherPostingRepository.findById(batchId)
                .orElseThrow(() -> new CustomExceptions.InvalidDataException("Batch ID not found in workflow tracking."));

        // 1. Prevent Self-Approval
        if (executorId.equalsIgnoreCase(posting.getCreatedBy())) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You cannot approve a batch you created.");
        }

        // 2. Prevent Duplicate Approvals
        boolean hasAlreadyApproved = voucherWorkflowRepository.findByBatchIdFkOrderByLastActionAtAsc(batchId)
                .stream().anyMatch(w -> executorId.equalsIgnoreCase(w.getLastActionBy()));
        if (hasAlreadyApproved) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You have already approved this batch at a previous level.");
        }

        // ==========================================
        // 3. SECURE FETCH & DOUBLE VALIDATION
        // ==========================================
        Map<String, Object> currentStepData;
        try {
            currentStepData = jdbcTemplate.queryForMap(
                    "SELECT WORKFLOW_CODE, WORKFLOW_ORDER, IS_FINAL_APPROVAL, WORKFLOW_STAGE, ALLOWED_ROLE_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_ID = ?",
                    posting.getPendingAt()
            );
        } catch (EmptyResultDataAccessException e) {
            throw new CustomExceptions.InvalidDataException("Configuration Error: Current stage not found.");
        }

        Integer allowedRoleId = currentStepData.get("ALLOWED_ROLE_ID") != null ? ((Number) currentStepData.get("ALLOWED_ROLE_ID")).intValue() : null;

        if (allowedRoleId != null && !allowedRoleId.equals(executorRole)) {
            throw new CustomExceptions.InvalidDataException("Unauthorized: You do not have the required Role to approve this step.");
        }

        String workflowCode = (String) currentStepData.get("WORKFLOW_CODE");
        Integer currentOrder = ((Number) currentStepData.get("WORKFLOW_ORDER")).intValue();
        String currentStageName = (String) currentStepData.get("WORKFLOW_STAGE");
        String explicitIsFinal = (String) currentStepData.get("IS_FINAL_APPROVAL");

        // --- DOUBLE CHECK: Fetch max human order partitioned by WORKFLOW_CODE ---
        Integer maxApprovalOrder = jdbcTemplate.queryForObject(
                "SELECT MAX(WORKFLOW_ORDER) FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND ALLOWED_ROLE_ID IS NOT NULL",
                Integer.class, workflowCode
        );

        boolean isMathematicalFinal = currentOrder.equals(maxApprovalOrder);
        boolean isFlaggedFinal = "Y".equalsIgnoreCase(explicitIsFinal);

        // --- ENTERPRISE SAFETY CHECK ---
        if (isFlaggedFinal && !isMathematicalFinal) {
            throw new CustomExceptions.InvalidDataException("Database Configuration Error: Stage is flagged as Final Approval, but it is not the last human step in " + workflowCode + ".");
        }

        boolean isFinalStep = isMathematicalFinal && isFlaggedFinal;

        // ==========================================
        // 4. DYNAMIC STATE PROGRESSION & CLEAN LOGGING
        // ==========================================
        String actionTaken = dto.getStatus().toString();

        if ("REJECTED".equals(actionTaken)) {
            posting.setBatchStatus("R");
            voucherPostingRepository.save(posting);

            String actionLog = "Rejected (" + currentStageName + ")";
            logWorkflowAction(batchId, posting.getVidFk(), actionLog, executorId, dto.getRemarks(), null);
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R' WHERE BATCH_ID = ?", batchId);
            notificationWriterService.createBatchRejectedNotification(batchId, posting.getCreatedBy(), executorId, dto.getRemarks());

            if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) {
                updateVidStatus(posting.getVidFk(), VoucherStatus.ACTIVE);
            }
            return;
        }


        if (isFinalStep) { {
            // Find the Executor Step (Order + 1)
            Long executorWorkflowId = jdbcTemplate.queryForObject(
                    "SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?",
                    Long.class, workflowCode, currentOrder + 1
            );
            posting.setPendingAt(executorWorkflowId);

            // --- SCHEDULING OVERRIDE LOGIC ---
            boolean isOverride = Boolean.TRUE.equals(dto.getOverrideScheduleLapse());
            if (isOverride) {
                posting.setIsScheduleOverride("YES"); // Set the flag in main table
                if (dto.getNewScheduledTime() != null) {
                    posting.setExecutionScheduled("YES");
                    posting.setScheduledTime(dto.getNewScheduledTime());
                } else {
                    posting.setExecutionScheduled("NO");
                    posting.setScheduledTime(null);
                }
            } else {
                // Keep Original: Check for lapse
                if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime() != null) {
                    if (posting.getScheduledTime().isBefore(LocalDateTime.now())) {
                        throw new CustomExceptions.ScheduleLapsedException("The scheduled execution time has passed.");
                    }
                }
            }

            // --- EXECUTION ROUTING ---
            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime() != null && posting.getScheduledTime().isAfter(LocalDateTime.now())) {
                posting.setBatchStatus("S");

                String actionLog = isOverride ? "FINAL_APPROVED_WITH_OVERRIDE" : "FINAL_APPROVED_SCHEDULED";
                // Pass scheduled time into history table
                logWorkflowAction(batchId, posting.getVidFk(), actionLog, executorId, dto.getRemarks(), posting.getScheduledTime());
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'SCHEDULED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            } else {
                posting.setBatchStatus("C");
                posting.setExecutedAt(LocalDateTime.now());

                String actionLog = isOverride ? "FINAL_APPROVED_IMMEDIATE_OVERRIDE" : "FINAL_APPROVED_POSTED";
                logWorkflowAction(batchId, posting.getVidFk(), actionLog, executorId, dto.getRemarks(), null);

                if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) {
                    updateVidStatus(posting.getVidFk(), VoucherStatus.COMPLETED);
                }

                BulkProcessVoucherPostingDto execDto = new BulkProcessVoucherPostingDto();
                execDto.setBatchId(batchId);
                execDto.setStatus(RequestStatus.ACCEPTED);
                execDto.setRemarks(dto.getRemarks());
                this.processBulkRequestsAsync(execDto, executorId, executorRole);
            }
            notificationWriterService.createBatchApprovedNotification(batchId, posting.getCreatedBy(), executorId);

        } else {
            // Move to the next approver step
            Long nextApproverId = jdbcTemplate.queryForObject(
                    "SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?",
                    Long.class, workflowCode, currentOrder + 1
            );

            posting.setPendingAt(nextApproverId);
            logWorkflowAction(batchId, posting.getVidFk(), "APPROVED_" + currentStageName, executorId, dto.getRemarks(), null);
        }

        voucherPostingRepository.save(posting);
    }
    public  void logWorkflowAction(String batchId, String vid, String action, String executorId, String remarks, LocalDateTime scheduledTime) {
        VoucherWorkflow wf = new VoucherWorkflow();
        wf.setBatchIdFk(batchId);
        wf.setVidFk(vid != null ? vid : "UNKNOWN");
        wf.setLastAction(action);
        wf.setLastActionBy(executorId);
        wf.setLastActionAt(LocalDateTime.now());
        wf.setRemarks(remarks);
        wf.setScheduledTime(scheduledTime);
        voucherWorkflowRepository.save(wf);
    }

    public List<Map<String, Object>> getWorkflowSteps(String workflowCode) {
        String sql = """
            SELECT w.WORKFLOW_STAGE AS state, 
                   w.WORKFLOW_STAGE AS designation, 
                   w.ALLOWED_ROLE_ID AS role_id, 
                   r.ROLE_NAME 
            FROM WORKFLOW_TRANSITIONS w 
            LEFT JOIN ROLES r ON w.ALLOWED_ROLE_ID = r.ROLE_ID 
            WHERE w.WORKFLOW_CODE = ? 
            ORDER BY w.WORKFLOW_ORDER ASC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> step = new HashMap<>();
            step.put("state", rs.getString("state"));
            step.put("designation", rs.getString("designation"));

            String roleName = rs.getString("ROLE_NAME");
            step.put("role", roleName != null ? roleName : "System");
            return step;
        }, workflowCode);
    }


    @Override
    public Map<String, String> getActiveRoles() {
        String sql = "SELECT ROLE_ID, ROLE_NAME FROM ROLES WHERE ROLE_STATUS = 'ACTIVE'";

