{/* Currency */}
<Grid item size={{ xl: 1.5, lg: 2 }}>
  <Autocomplete
    disableClearable
    options={currencyOptions}
    value={row.currency || null}
    onChange={(event, newValue) => {
      handleRowChange(row.id, "currency", newValue || "");
      handleRowChange(row.id, "amount", "");
    }}
    // 1. Hide options until the user starts typing
    filterOptions={(options, params) => {
      const { inputValue } = params;
      if (inputValue.trim().length === 0) {
        return []; // Returns empty when clicked but nothing is typed
      }
      // Standard filtering once typing begins
      return options.filter((option) =>
        option.toLowerCase().includes(inputValue.toLowerCase())
      );
    }}
    noOptionsText="Type to search..."
    // 2. Force the dropdown to flip upwards if it hits the taskbar
    slotProps={{
      popper: {
        modifiers: [
          { name: 'flip', enabled: true },
          { name: 'preventOverflow', enabled: true }
        ]
      }
    }}
    renderInput={(params) => (
      <TextField
        {...params}
        label="Currency *"
        placeholder={!row.currency ? "Search..." : ""}
        InputLabelProps={{ shrink: true }}
        inputProps={{
          ...params.inputProps,
          maxLength: 3, // 3. Restrict input to a maximum of 3 characters
          style: { textTransform: 'uppercase' } // Automatically capitalizes the input visually
        }}
      />
    )}
  />
</Grid>
