### 1. The Dynamic "Pending Batches" Query
This method now includes the NOT EXISTS check (to stop ghost requests) and retrieves the IS_FINAL_APPROVAL flag directly from the join.
```java
    @Override
    public List<Map<String, Object>> getPendingBatchesForChecker(Integer userRole, String userId) {
        String sql = """
            SELECT 
                b.BATCH_ID, p.VID_FK AS VID, b.CREATOR_ID, b.REQ_DATE, b.BATCH_REMARKS, 
                b.TOTAL_ROWS, p.SCHEDULED_TIME,
                w.WORKFLOW_STAGE, w.WORKFLOW_CODE, w.ESCALATION_TIME, w.WORKFLOW_ORDER, w.IS_FINAL_APPROVAL,
                COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, b.CREATOR_ID) AS CREATOR_NAME
            FROM JOURNAL_BATCH_MASTER b
            INNER JOIN VOUCHER_POSTING p ON b.BATCH_ID = p.BATCH_ID
            INNER JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            LEFT JOIN USERS u ON b.CREATOR_ID = u.USER_ID
            WHERE w.ALLOWED_ROLE_ID = ? AND p.BATCH_STATUS = 'P'
            
            -- FIX 1: Hide batches already approved by this user
            AND NOT EXISTS (
                SELECT 1 FROM VOUCHER_WORKFLOW vw 
                WHERE vw.BATCH_ID_FK = p.BATCH_ID AND vw.LAST_ACTION_BY = ?
            )
            ORDER BY b.REQ_DATE DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("vid", rs.getString("VID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("creatorName", rs.getString("CREATOR_NAME"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("escalationTime", rs.getLong("ESCALATION_TIME"));
            map.put("workflowState", rs.getString("WORKFLOW_STAGE"));
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            map.put("currentOrder", rs.getObject("WORKFLOW_ORDER"));
            // FIX 2: Use the flag defined in the specific transition row
            map.put("isFinalApproval", rs.getString("IS_FINAL_APPROVAL")); 
            return map;
        }, userRole, userId);
    }

```
### 2. The Dynamic "Action Processing" Logic
This logic is now fully dynamic: it ignores complex math and purely obeys the IS_FINAL_APPROVAL column in your WORKFLOW_TRANSITIONS table.
```java
    @Transactional
    public void processWorkflowAction(ProcessVoucherRequestDto dto, String executorId, Integer executorRole) {
        String batchId = dto.getBatchId();

        // 1. Fetch current stage details dynamically via JOIN
        Map<String, Object> stepData = jdbcTemplate.queryForMap("""
            SELECT 
                w.WORKFLOW_CODE, w.WORKFLOW_ORDER, w.IS_FINAL_APPROVAL, 
                w.WORKFLOW_STAGE, w.ALLOWED_ROLE_ID, p.CREATED_BY, p.VID_FK
            FROM VOUCHER_POSTING p
            JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            WHERE p.BATCH_ID = ?
            """, batchId);

        // 2. Validate Authorization
        Integer allowedRoleId = ((Number) stepData.get("ALLOWED_ROLE_ID")).intValue();
        if (!allowedRoleId.equals(executorRole)) {
            throw new CustomExceptions.InvalidDataException("Unauthorized: Role mismatch.");
        }
        if (executorId.equalsIgnoreCase((String) stepData.get("CREATED_BY"))) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You cannot approve your own batch.");
        }

        // 3. Dynamic Logic Extraction
        String workflowCode = (String) stepData.get("WORKFLOW_CODE");
        Integer currentOrder = ((Number) stepData.get("WORKFLOW_ORDER")).intValue();
        String currentStageName = (String) stepData.get("WORKFLOW_STAGE");
        boolean isFinalStep = "Y".equalsIgnoreCase((String) stepData.get("IS_FINAL_APPROVAL"));

        VoucherPosting posting = voucherPostingRepository.findById(batchId)
                .orElseThrow(() -> new CustomExceptions.InvalidDataException("Batch ID not found."));

        // 4. Handle Progression
        if ("REJECTED".equals(dto.getStatus().toString())) {
            // ... (Keep your rejection logic here) ...
            return;
        }

        if (isFinalStep) {
            // Logic for Final Execution (Posting, Scheduling, etc.)
            // ... (Keep your Final Approval logic block) ...
        } else {
            // Move to next step dynamically using the next order
            Long nextApproverId = jdbcTemplate.queryForObject(
                "SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?",
                Long.class, workflowCode, currentOrder + 1
            );
            posting.setPendingAt(nextApproverId);
            logWorkflowAction(batchId, (String)stepData.get("VID_FK"), "Approved (" + currentStageName + ")", executorId, dto.getRemarks(), null);
        }
        voucherPostingRepository.save(posting);
    }

