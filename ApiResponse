### 3. Update the Workflow History (SYSTEM Logs, Names, and IDs)
Find your workflowHistory.map block (around line 1023) and replace the whole map block with this version. It formats the System executor, shows IDs, and adds specific styling for execution failures.
```javascript
                    {workflowHistory.map((history, idx) => {
                      const isSystem = history.LAST_ACTION_BY === "SYSTEM";
                      const userName = history.ACTION_USER_NAME || (isSystem ? "Automated System" : "User");
                      const initial = isSystem ? "S" : userName.charAt(0).toUpperCase();
                      const isOverrideAction = history.LAST_ACTION?.toUpperCase().includes("OVERRIDE");
                      const isExecutionFail = history.LAST_ACTION?.toUpperCase().includes("FAILED");

                      // Identify if this specific log action belongs to a submission or finalization step
                      const isSubmission = history.LAST_ACTION?.toUpperCase().includes("SUBMIT");
                      const isFinalApproval = history.LAST_ACTION?.toUpperCase().includes("FINAL") || history.LAST_ACTION?.toUpperCase().includes("ACCEPT");

                      return (
                        <Box key={idx} sx={{ display: 'flex', gap: 2 }}>
                          <Box>
                            <Avatar sx={{ bgcolor: isSystem ? 'secondary.main' : 'primary.main', width: 40, height: 40, fontWeight: 'bold', fontSize: '1rem' }}>
                              {initial}
                            </Avatar>
                          </Box>
                          <Box sx={{ flexGrow: 1, backgroundColor: "white", p: 2.5, borderRadius: 2, border: "1px solid", borderColor: isExecutionFail ? "#d32f2f" : isSystem ? "#9c27b0" : "#e2e8f0", borderLeftWidth: isExecutionFail || isSystem ? "4px" : "1px", boxShadow: "0 1px 2px 0 rgb(0 0 0 / 0.05)" }}>

                            <Box sx={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 1, mb: 1 }}>
                              <Typography variant="subtitle2" fontWeight="bold" color="text.primary">
                                {/* NEW: Show Name and ID */}
                                {userName} {isSystem ? "" : `(${history.LAST_ACTION_BY})`}
                              </Typography>
                              <Typography variant="caption" color="text.secondary">• {new Date(history.LAST_ACTION_AT).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}</Typography>
                            </Box>

                            <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 1.5, flexWrap: "wrap", gap: 1 }}>
                              <Chip
                                label={history.LAST_ACTION || "System Action"}
                                size="small"
                                sx={{ height: 22, fontSize: "0.7rem", fontWeight: "bold", backgroundColor: isExecutionFail || history.LAST_ACTION?.includes("Reject") ? "#fee2e2" : isSystem ? "#f3e8ff" : "#e0e7ff", color: isExecutionFail || history.LAST_ACTION?.includes("Reject") ? "#991b1b" : isSystem ? "#7e22ce" : "#3730a3" }}
                              />

                              {history.SCHEDULED_TIME ? (
                                <Chip
                                  label={isOverrideAction ? `⚡ Schedule Overridden to: ${new Date(history.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}` : `🕒 Scheduled for: ${new Date(history.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}`}
                                  size="small"
                                  color={isOverrideAction ? "warning" : "info"}
                                  variant="outlined"
                                  sx={{ height: 22, fontSize: "0.7rem", fontWeight: "bold" }}
                                />
                              ) : (
                                (isSubmission || isFinalApproval) && !isSystem && (
                                  <Chip
                                    label="Immediate Execution"
                                    size="small"
                                    color="default"
                                    variant="outlined"
                                    sx={{ height: 22, fontSize: "0.7rem", fontWeight: "bold", backgroundColor: "#f1f5f9" }}
                                  />
                                )
                              )}
                            </Stack>

                            <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>
                              {history.REMARKS || "No remarks provided."}
                            </Typography>
                          </Box>
                        </Box>
                      );
                    })}

