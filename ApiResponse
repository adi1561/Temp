### 1. Update Validation & Add the filterAndWarn Helper
Find where isRemarksValid and filterSearchInput were defined (around line 97) and **replace them completely** with this block. Make sure this goes *inside* the JournalPosting function so it can use showSnackBar:
**Replace Code:**
```javascript
  // 1. Common remarks can be empty. If filled, must be 2-30.
  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);
  
  // 2. Row remarks are STRICTLY compulsory (2-30 chars).
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  // 3. Real-time filter & Snackbar Warning Engine
  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphabets and digits are allowed.";

    if (type === "alphanumeric_space") {
      filtered = val.replace(/[^a-zA-Z0-9 ]/g, ""); // Strip special chars
      if (filtered !== val) {
        hasError = true;
      }
      
      // Strip leading space and collapse double spaces
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Leading or multiple spaces are not allowed.";
      }
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }
    return filtered;
  };

```
