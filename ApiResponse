import React, { useState, useRef, useEffect } from "react";
import dayjs from "dayjs";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination,
  IconButton,
  Tooltip,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  Send as SendIcon,
  FileDownload as FileDownloadIcon,
  ArrowBack as ArrowBackIcon,
  Close as CloseIcon,
  TaskAlt as TaskAltIcon,
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { DatePicker } from "@mui/x-date-pickers/DatePicker";

// --- STYLES ---
const mainContainerStyle = { padding: 3, height: "100%", width: "100%" };
const ALLOWED_FILE_TYPES = [".xlsx"];

const controlPanelStyle = {
  padding: "30px",
  marginBottom: "20px",
  borderRadius: "12px",
  backgroundColor: "background.paper",
  boxShadow: 2,
};

const uploadBoxStyle = {
  position: "relative",
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  alignItems: "center",
  border: 2,
  borderStyle: "dashed",
  borderColor: "primary.main",
  borderRadius: "12px",
  padding: "60px 40px 40px 40px",
  cursor: "default", // Changed from pointer to default as the box is no longer clickable
  backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.02),
  transition: "all 0.3s ease",
  minHeight: "250px",
  "&:hover": {
    backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08),
    borderColor: "primary.dark",
  },
};

const templateSectionStyle = {
  position: "absolute",
  top: 15,
  right: 20,
  textAlign: "right",
  zIndex: 10,
};

const iconStyle = {
  fontSize: "6rem",
  color: "primary.main",
};

const headerTextStyle = {
  fontWeight: 600,
  fontSize: "1.2rem",
  textAlign: "center",
  color: "text.primary",
  mb: 1,
};

const subTextStyle = {
  color: "text.secondary",
  fontSize: "0.85rem",
  textAlign: "center",
  marginBottom: "25px",
};

const descriptionIconStyle = {
  color: "success.main",
  mb: 1,
  fontSize: "5rem",
};

const tableContainerStyle = {
  borderRadius: "12px",
  border: "1px solid",
  borderColor: "divider",
  overflowY: "auto",
  marginTop: "20px",
  boxShadow: 1,
  maxHeight: 600,
};

const tableHeaderStyle = {
  backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08),
};

const tableHeaderCellStyle = {
  color: "text.primary",
  fontWeight: "bold",
  fontSize: "0.95rem",
};

const actionButtonsContainer = {
  display: "flex",
  justifyContent: "center",
  marginTop: 4,
  gap: 2,
};

const customButtonStyle = {
  background: (theme) => alpha(theme.palette.primary.main, 0.8),
  boxShadow: "none",
  color: (theme) => theme.palette.primary.contrastText || "#fff",
  padding: "8px 40px",
  "&:hover": {
    background: (theme) => alpha(theme.palette.primary.main, 1),
  },
};

const boxCenterStyle = {
  display: "flex",
  justifyContent: "center",
  alignItems: "center",
  flexDirection: "column",
  width: "100%",
};

const dateinputfield = {
  display: "flex",
  justifyContent: "center",
  marginRight: "20px",
  "& .MuiTextField-root": { minWidth: "250px" },
};

const mainSteps = ["Upload & Validate", "Preview & Submit"];
const validationSteps = [
  "Format Validation",
  "Database Validation",
  "Balance Validation",
];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [activeStep, setActiveStep] = useState(0);
  const [selectedDate, setSelectedDate] = useState(null);
  const [file, setFile] = useState(null);
  const [isCsvFile, setIsCsvFile] = useState(false);
  const fileInputRef = useRef(null);

  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [isDebouncing, setIsDebouncing] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [showProductColumn, setShowProductColumn] = useState(false);

  const [validationStage, setValidationStage] = useState(0);
  const [resultStatus, setResultStatus] = useState(null);
  const [resultMsg, setResultMsg] = useState("");
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);
  const [downloadMsg, setDownloadMsg] = useState("Downloading error report...");

  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);

  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(50);
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  const triggerDebounce = () => {
    setIsDebouncing(true);
    setTimeout(() => {
      setIsDebouncing(false);
    }, 3000);
  };

  const validateAndSetFile = (selected) => {
    if (!selected) return;
    const fileName = selected.name.toLowerCase();
    const fileSize = selected.size;

    const isValidExt = ALLOWED_FILE_TYPES.some((ext) => fileName.endsWith(ext));

    if (!isValidExt) {
      showSnackBar(`Invalid file type! Only ${ALLOWED_FILE_TYPES.join(", ")} files are supported.`, "error");
      clearInput();
      return;
    }

    const MAX_SIZE_MB = 50;
    if (fileSize > MAX_SIZE_MB * 1024 * 1024) {
      showSnackBar(`File too large! Maximum allowed size is ${MAX_SIZE_MB}MB.`, "error");
      clearInput();
      return;
    }

    if (fileSize === 0) {
      showSnackBar("The selected file is empty. Please upload a valid file.", "error");
      clearInput();
      return;
    }

    const validNameRegex = /^[a-zA-Z0-9\s._-]+$/;
    if (!validNameRegex.test(selected.name)) {
      showSnackBar("Invalid filename! Please remove special characters (e.g., #, %, &).", "error");
      clearInput();
      return;
    }

    setFile(selected);
    setIsCsvFile(fileName.endsWith(".csv"));
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setPreviewRows([]);
    setTotalRows(0);        // FIX: Clear the old row count
    setRequestId(null);     // FIX: Clear the old request ID
    setAutoDlTriggered(false);
    setIsProcessing(false);
    setDownloadMsg("Downloading error report...");
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      validateAndSetFile(e.target.files[0]);
    }
  };

  const handleDragOver = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(true);
  };

  const handleDragLeave = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      validateAndSetFile(e.dataTransfer.files[0]);
      e.dataTransfer.clearData();
    }
  };

  const clearInput = () => {
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleClearFile = (e) => {
    if (e) e.stopPropagation();
    setFile(null);
    setIsCsvFile(false);
    clearInput();
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setIsProcessing(false);
  };

  const resetAll = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setIsCsvFile(false);
    setFile(null);
    setSelectedDate(null);
    setPage(0);
    setDownloadMsg("Downloading error report...");
    clearInput();
  };

  const handleBack = () => {
    setActiveStep(0);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setDownloadMsg("Downloading error report...");
  };

  const downloadFileHelper = async (url, filename) => {
    try {
      const response = await callApi(url, null, "GET", "blob", null, {}, false);
      const blobData = response.data || response;
      if (!blobData) throw new Error("Empty response data");

      const blob = new Blob([blobData], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const link = document.createElement("a");
      const objectUrl = window.URL.createObjectURL(blob);
      link.href = objectUrl;
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(objectUrl);
      return true;
    } catch (e) {
      showSnackBar("File download failed.", "error");
      return false;
    }
  };

  const handleDownloadTemplate = (e) => {
    if (e) e.stopPropagation();
    downloadFileHelper("/JS/journals/download-template", "Journal_Upload_Template.xlsx");
  };

  const handleDownloadFile = async (type, reqId = requestId) => {
    if (type === "ERROR") showSnackBar("Downloading error report...", "info");
    const success = await downloadFileHelper(
      `/JS/journals/download-bulk-file/${reqId}?type=${type}`,
      type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv"
    );
    if (success && type === "SUCCESS") showSnackBar("Downloaded successfully.", "success");
    if (success && type === "ERROR") setDownloadMsg("Error report downloaded.");
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !selectedDate.isValid() || !file) {
      showSnackBar("Please select a valid date and file.", "warning");
      return;
    }
    triggerDebounce();
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setRequestId(null);     // FIX: Prevent the useEffect from polling the old ID
    setIsProcessing(true);
    setAutoDlTriggered(false);
    setDownloadMsg("Downloading error report...");

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate.format("DD/MM/YYYY"));

    try {
      const data = await callApi("/JS/journals/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      if (data && data.requestId) {
        setRequestId(data.requestId);
      } else {
        throw new Error("Invalid response from server.");
      }
    } catch (err) {
      setIsProcessing(false);
      setResultStatus("ERROR");
      setResultMsg("Initialization failed: " + (err.message || "Unknown error"));
    }
  };

  const handleCreateBatch = async () => {
    if (!requestId) {
      showSnackBar("Invalid Request ID. Please try uploading again.", "error");
      return;
    }
    triggerDebounce();
    setIsCreatingBatch(true);
    try {
      const payload = {
        requestId: requestId,
        commonBatchRemarks: `Bulk Upload - ${selectedDate.format("YYYY-MM-DD")}`,
        postingDate: selectedDate.format("DD/MM/YYYY")
      };
      const response = await callApi("/JS/journals/create-batch-from-cache", payload, "POST");
      if (response && (response.status === "SUCCESS" || response.batchId)) {
        showSnackBar("You will be notified once the request has been created.", "success", 5000);
        setTimeout(() => resetAll(), 1500);
      } else {
        throw new Error(response.message || "Failed.");
      }
    } catch (e) {
      let msg = e.message || "Unknown error";
      if (e.response && e.response.data && e.response.data.message) {
        msg = e.response.data.message;
      }
      showSnackBar("Failed to create batch: " + msg, "error");
    } finally {
      setIsCreatingBatch(false);
    }
  };

  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setValidationStage(res.currentStage || 1);
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000);
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              handleDownloadFile("ERROR", res.requestId);
            }
          } else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setValidationStage(4);
            setTotalRows(res.totalRows);
            setShowProductColumn(res.hasProductColumn || false);
            if (res.previewDataJson) setPreviewRows(JSON.parse(res.previewDataJson));
            clearInterval(interval);
            showSnackBar("Validation complete.", "success");
            setTimeout(() => {
              setActiveStep(1);
            }, 1000);
          } else {
            setValidationStage(res.currentStage);
          }
        } catch (e) { }
      }, 800);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, autoDlTriggered, callApi, showSnackBar]);

  const handleChangePage = (event, newPage) => setPage(newPage);
  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const visibleRows = previewRows.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage);
  const isValidationStepFailed = (index) => {
    return resultStatus === "ERROR" && index === validationStage - 1;
  };

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        <Box sx={{ width: "100%", maxWidth: "90%", margin: "0 auto", mb: 4 }}>
          <Stepper activeStep={activeStep}>
            {mainSteps.map((label) => (
              <Step key={label}>
                <StepLabel>{label}</StepLabel>
              </Step>
            ))}
          </Stepper>
        </Box>

        {activeStep === 0 && (
          <Box
            sx={{
              borderColor: resultStatus === "ERROR" ? "error.main" : "primary.main",
              opacity: isProcessing ? 0.6 : 1,
            }}
          >
            <Box
              sx={{
                ...uploadBoxStyle,
                borderColor: isDragging ? "secondary.main" : (resultStatus === "ERROR" ? "error.main" : "primary.main"),
                backgroundColor: (theme) => isDragging ? alpha(theme.palette.primary.main, 0.12) : alpha(theme.palette.primary.main, 0.02),
                transform: isDragging ? "scale(1.01)" : "scale(1)",
              }}
              onDragOver={handleDragOver}
              onDragLeave={handleDragLeave}
              onDrop={handleDrop}
            >
              <Box sx={templateSectionStyle} onClick={(e) => e.stopPropagation()}>
                <Typography variant="caption" sx={{ display: "block", color: "text.secondary", fontWeight: 500, mb: 0.5 }}>
                  Need assistance? Download the template (.xlsx)
                </Typography>
                <Button
                  variant="outlined"
                  size="small"
                  startIcon={<FileDownloadIcon />}
                  onClick={handleDownloadTemplate}
                  sx={{ borderRadius: "8px", textTransform: "none" }}
                >
                  Download Template
                </Button>
              </Box>

              <Box sx={boxCenterStyle}>
                {file ? (
                  <Box sx={{ position: "relative", textAlign: "center" }}>
                    <DescriptionIcon sx={descriptionIconStyle} />
                    <br />
                    <Typography sx={headerTextStyle}>{file.name}</Typography>
                    <Tooltip title="Remove File">
                      <IconButton
                        size="small"
                        onClick={handleClearFile}
                        sx={{
                          position: "absolute",
                          top: -10,
                          right: -40,
                          bgcolor: "background.paper",
                          "&:hover": { bgcolor: "error.light", color: "white" },
                        }}
                      >
                        <CloseIcon fontSize="small" />
                      </IconButton>
                    </Tooltip>
                  </Box>
                ) : (
                  <Box sx={{ textAlign: "center" }}>
                    <CloudUploadIcon sx={iconStyle} />
                    <Typography sx={headerTextStyle}>
                      {isDragging ? "Drop file now" : "Click the button below to upload"}
                    </Typography>
                    <Typography sx={subTextStyle}>
                      Supported file formats: {ALLOWED_FILE_TYPES.join(", ")} (Maximum Size: 50MB)
                    </Typography>
                  </Box>
                )}
              </Box>

              <Box sx={{ ...boxCenterStyle, flexDirection: "row", alignItems: "flex-start", mt: 2 }} onClick={(e) => e.stopPropagation()}>
                <Box sx={dateinputfield}>
                  <LocalizationProvider dateAdapter={AdapterDayjs}>
                    <DatePicker
                      label="Posting Date"
                      value={selectedDate}
                      onChange={(newValue) => setSelectedDate(newValue)}
                      disabled={isProcessing}
                      minDate={dayjs().subtract(1, 'year')}
                      maxDate={dayjs()}
                      slotProps={{
                        textField: {
                          size: "small",
                          onKeyDown: (e) => e.preventDefault(),
                          // Turns red and shows text if file is uploaded 
                          error: Boolean(file && !selectedDate),
                          helperText: file && !selectedDate ? "Select a posting date" : "",
                          inputProps: {
                            readOnly: true,
                            sx: { cursor: 'pointer' }
                          }
                        },
                      }}

                    />
                  </LocalizationProvider>
                </Box>
                <Box>
                  <input
                    type="file"
                    hidden
                    ref={fileInputRef}
                    onChange={handleFileSelect}
                    onClick={(e) => (e.target.value = null)}
                    accept={ALLOWED_FILE_TYPES.join(",")}
                  />

                  {/* file to Upload button  */}
                  <Button
                    sx={customButtonStyle}
                    variant="contained"
                    onClick={() => fileInputRef.current.click()}
                  >
                    {file ? "Change File" : "Upload File"}
                  </Button>
                </Box>
              </Box>
            </Box>

            {(isProcessing || resultStatus) && (
              <Box sx={{ mt: 4, mb: 2 }}>
                <Stepper activeStep={validationStage - 1} alternativeLabel>
                  {validationSteps.map((label, index) => {
                    const labelProps = {};
                    if (isValidationStepFailed(index)) {
                      labelProps.optional = (
                        <Typography variant="caption" color="error">Failed</Typography>
                      );
                      labelProps.error = true;
                    }
                    return (
                      <Step key={label}>
                        <StepLabel {...labelProps}>{label}</StepLabel>
                      </Step>
                    );
                  })}
                </Stepper>
              </Box>
            )}

            {resultStatus === "ERROR" && (
              <Alert
                severity="error"
                sx={{
                  mt: 3,
                  mx: "auto",
                  maxWidth: "100%",
                  backgroundColor: "#ffebee",
                  color: "black",
                  "& .MuiAlert-icon": {
                    color: "error.main"
                  }
                }}
              >
                {resultMsg} — {downloadMsg}
              </Alert>
            )}

            <Stack direction="row" sx={actionButtonsContainer}>
              <Button
                variant="contained"
                size="large"
                onClick={handleStartValidation}
                disabled={!file || !selectedDate || isDebouncing || isProcessing}
                startIcon={isProcessing ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
              >
                {isProcessing ? "Validating..." : "Start Validation"}
              </Button>
            </Stack>
          </Box>
        )}

        {activeStep === 1 && (
          <Box sx={{ textAlign: "center", py: 6 }}>
            <TaskAltIcon sx={{ fontSize: "6rem", color: "success.main", mb: 2 }} />
            <Typography variant="h4" sx={{ fontWeight: "bold", mb: 1 }}>
              Validation Successful!
            </Typography>
            <Typography variant="body1" sx={{ color: "text.secondary", mb: 4 }}>
              Your file has been successfully validated. Total valid records ready for submission: <strong>{totalRows.toLocaleString()}</strong>.
            </Typography>

            <Stack direction="row" sx={actionButtonsContainer}>
              <Button variant="outlined" onClick={handleBack} startIcon={<ArrowBackIcon />}>Back</Button>
              <Button variant="text" onClick={resetAll} startIcon={<RestartAltIcon />}>Cancel</Button>
              <Button
                variant="contained"
                color="success"
                size="large"
                onClick={handleCreateBatch}
                disabled={isCreatingBatch || isDebouncing}
                startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
              >
                {isCreatingBatch ? "Creating batch..." : "Submit Batch"}
              </Button>
            </Stack>
          </Box>
        )}

      </Paper>
    </Box>
  );
};

export default JournalBulkUpload;
