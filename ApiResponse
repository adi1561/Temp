public class DeadlockExplicitDemo {

    private static final String BOOK_1 = "Book1";
    private static final String BOOK_2 = "Book2";

    public static void main(String[] args) {

        // --- STUDENT 1 THREAD ---
        Thread student1 = new Thread(() -> {
            System.out.println("Student 1: Trying to grab " + BOOK_1 + "...");
            synchronized (BOOK_1) {
                System.out.println("Student 1: ✅ Grabbed " + BOOK_1 + ".");
                
                // Sleep to ensure Student 2 has enough time to grab Book 2
                try { Thread.sleep(1000); } catch (InterruptedException e) {}

                System.out.println("\n🚨 WARNING: Student 1 is about to ask for " + BOOK_2);
                System.out.println("🚨 But Student 2 already has the key to " + BOOK_2 + "!");
                System.out.println("Student 1: Trying to grab " + BOOK_2 + "... (I am about to get stuck!)");
                
                // ❌ THE TRAP: Student 1 tries to enter Book 2, but gets BLOCKED forever.
                synchronized (BOOK_2) {
                    System.out.println("Student 1: ✅ Grabbed " + BOOK_2 + ".");
                }
            }
        });

        // --- STUDENT 2 THREAD ---
        Thread student2 = new Thread(() -> {
            System.out.println("Student 2: Trying to grab " + BOOK_2 + "...");
            // ❌ THE TRAP: Student 2 locks them in the REVERSE order!
            synchronized (BOOK_2) { 
                System.out.println("Student 2: ✅ Grabbed " + BOOK_2 + ".");
                
                // Sleep to ensure Student 1 has enough time to grab Book 1
                try { Thread.sleep(1000); } catch (InterruptedException e) {}

                System.out.println("\n🚨 WARNING: Student 2 is about to ask for " + BOOK_1);
                System.out.println("🚨 But Student 1 already has the key to " + BOOK_1 + "!");
                System.out.println("Student 2: Trying to grab " + BOOK_1 + "... (I am about to get stuck!)");
                
                // ❌ THE TRAP: Student 2 tries to enter Book 1, but gets BLOCKED forever.
                synchronized (BOOK_1) {
                    System.out.println("Student 2: ✅ Grabbed " + BOOK_1 + ".");
                }
            }
        });

        student1.start();
        student2.start();
    }
}
