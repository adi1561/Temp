    private void runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) {
                d.formatErrors.add("Amount cannot be zero or null.");
            } else {
                if (d.amount.signum() < 0) d.formatErrors.add("Amount cannot be negative.");
                if (d.amount.precision() > 20 || d.amount.scale() > 4) d.formatErrors.add("Amount exceeds maximum allowed format (16 digits, 4 decimal places).");
                if ("INR".equalsIgnoreCase(d.currency) && d.amount.stripTrailingZeros().scale() > 2) d.formatErrors.add("INR amounts cannot exceed 2 decimal places.");
            }
            
            if (d.productCode != null && !d.productCode.isEmpty() && !d.productCode.equals("A") && !PRODUCT_CODE_REGEX.matcher(d.productCode).matches()) {
                d.formatErrors.add("Product code must be up to 8 digits or left blank.");
            }
            
            if (d.remarks == null || d.remarks.trim().isEmpty()) {
                d.formatErrors.add("Remarks are mandatory.");
            } else if (!d.remarks.matches("^[a-zA-Z0-9 ]{2,30}$")) {
                d.formatErrors.add("Remarks must contain only 2-30 alphanumeric characters and spaces.");
            }
            
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Currency code must be exactly 3 characters.");
            
            if (d.cgl == null || d.cgl.isEmpty()) {
                d.formatErrors.add("CGL is mandatory.");
            } else if (!CGL_FORMAT_REGEX.matcher(d.cgl).matches()) {
                d.formatErrors.add("CGL must be exactly 10 digits.");
            }
            
            if (d.branch == null || d.branch.trim().isEmpty()) {
                d.formatErrors.add("Branch code is mandatory.");
            } else if (d.branch.trim().length() != 5) {
                d.formatErrors.add("Branch code must be exactly 5 characters.");
            }
        });
    }

