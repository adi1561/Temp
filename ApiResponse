<React.Fragment key={row.id}>
  <Grid container spacing={2} alignItems="flex-start">

    {/* Branch */}
    <Grid item xs={12} md={2} sx={{ flexGrow: 1.4 }}>
      <Autocomplete
        popupIcon={null}
        autoHighlight
        options={branchSearch.options}
        getOptionLabel={(option) =>
          option?.code ? `${option.code} - ${option.name}` : ""
        }
        value={row.branch || null}
        onChange={(event, newValue) =>
          handleRowChange(row.id, "branch", newValue)
        }
        inputValue={branchInputValues[row.id] || ""}
        onInputChange={(event, newInputValue, reason) => {
          if (reason === "input") {
            const cleanInput = newInputValue
              .replace(BRANCH_REPLACE_REGEX, "")
              .substring(0, 5);

            setBranchInputValues(prev => ({
              ...prev,
              [row.id]: cleanInput
            }));

            searchBranches(cleanInput, row.id);

          } else {

            setBranchInputValues(prev => ({
              ...prev,
              [row.id]: newInputValue
            }));

          }
        }}
        loading={branchSearch.loadingId === row.id}
        filterOptions={(x) => x}
        isOptionEqualToValue={(option, value) =>
          option?.code === value?.code
        }
        noOptionsText={
          (branchInputValues[row.id] || "").length < 3
            ? "Please enter at least 3 digits"
            : "No Branch found"
        }
        renderInput={(params) => (
          <Tooltip title="Search by Branch Code">
            <TextField
              {...params}
              label="Branch *"
              placeholder="Enter branch code..."
              InputLabelProps={{ shrink: true }}

              sx={{
                "& input": {
                  overflowX: "auto",
                  whiteSpace: "nowrap",
                  textOverflow: "unset"
                }
              }}

              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <Box>

                    {branchSearch.loadingId === row.id ? (
                      <CircularProgress size={20} />
                    ) : null}

                    {params.InputProps.endAdornment}

                  </Box>
                )
              }}
            />
          </Tooltip>
        )}
      />

      <Typography variant="caption"
        sx={{
          fontSize: ".65rem",
          ml: 1.2,
          mt: .5,
          display: "block"
        }}
      >
        Min 3 Digits required
      </Typography>

    </Grid>


    {/* Currency */}
    <Grid item xs={12} md={1}>
      <TextField
        select
        label="Currency *"
        value={row.currency}
        fullWidth
        InputLabelProps={{ shrink: true }}

        onChange={(e) => {

          handleRowChange(
            row.id,
            "currency",
            e.target.value
          );

          handleRowChange(
            row.id,
            "amount",
            ""
          );

        }}
      >

        {currencyOptions.map((c) => (

          <MenuItem
            key={c}
            value={c}
          >
            {c}
          </MenuItem>

        ))}

      </TextField>
    </Grid>


    {/* CGL */}
    <Grid item xs={12} md={2.6} sx={{ flexGrow: 2 }}>

      <Autocomplete
        popupIcon={null}
        autoHighlight
        options={cglSearch.options}

        getOptionLabel={(option) =>
          option?.cglNumber
            ? `${option.cglNumber} - ${option.description}`
            : ""
        }

        value={row.cgl || null}

        onChange={(event, newValue) =>
          handleRowChange(
            row.id,
            "cgl",
            newValue
          )
        }

        inputValue={cglInputValues[row.id] || ""}

        onInputChange={(event, newInputValue, reason) => {

          if (reason === "input") {

            const cleanInput =
              newInputValue
                .replace(CGL_REPLACE_REGEX, "")
                .substring(0, 10);

            setCglInputValues(prev => ({
              ...prev,
              [row.id]: cleanInput
            }));

            searchCgls(
              cleanInput,
              row.id
            );

          } else {

            setCglInputValues(prev => ({
              ...prev,
              [row.id]: newInputValue
            }));

          }

        }}

        loading={cglSearch.loadingId === row.id}

        filterOptions={(x) => x}

        isOptionEqualToValue={(option, value) =>
          option?.cglNumber === value?.cglNumber
        }

        noOptionsText={
          (cglInputValues[row.id] || "").length < 3
            ? "Type at least 3 digits"
            : "CGL not found"
        }

        renderInput={(params) => (

          <Tooltip title="Search by CGL Number">

            <TextField

              {...params}

              label="CGL *"

              placeholder="Search CGL..."

              InputLabelProps={{
                shrink: true
              }}

              sx={{
                "& input": {
                  overflowX: "auto",
                  whiteSpace: "nowrap",
                  textOverflow: "unset"
                }
              }}

              InputProps={{
                ...params.InputProps,

                endAdornment: (

                  <Box
                    display="flex"
                    alignItems="center"
                  >

                    {row.cgl &&
                      String(
                        row.cgl.cglNumber
                      ).startsWith("5") && (

                        <Chip
                          label="MEMO"
                          size="small"
                          color="warning"
                          sx={{ mr: 1 }}
                        />

                      )}

                    {cglSearch.loadingId === row.id
                      ? <CircularProgress size={20}/>
                      : null}

                    {params.InputProps.endAdornment}

                  </Box>

                )
              }}

            />

          </Tooltip>

        )}

      />

    </Grid>


    {/* Amount */}
    <Grid item xs={12} md={2.2}>
      <TextField
        label="Amount *"
        value={row.amount}
        fullWidth
        disabled={!row.currency}
      />
    </Grid>


    {/* Type */}
    <Grid item xs={12} md={1}>
      <TextField
        select
        label="Type *"
        value={row.txnType}
        fullWidth
      >
        <MenuItem value="Debit">
          Debit
        </MenuItem>

        <MenuItem value="Credit">
          Credit
        </MenuItem>

      </TextField>
    </Grid>


    {/* Product Code */}
    <Grid item xs={12} md={1.3}>
      <TextField
        label="Product Code"
        value={row.productCode}
        fullWidth
      />
    </Grid>


    {/* Remarks */}
    <Grid item xs={12} md={1.4}>
      <TextField
        label="Remarks *"
        value={row.remarks}
        fullWidth
      />
    </Grid>


    {/* Delete */}
    <Grid item xs={12} md={0.5}>

      <IconButton
        onClick={() =>
          handleDeleteRow(
            row.id
          )
        }
      >
        <DeleteIcon />
      </IconButton>

    </Grid>

  </Grid>

  {index < rows.length - 1 && (

    <Box
      sx={{
        borderBottom: 1,
        borderColor: "divider",
        my: 2
      }}
    />

  )}

</React.Fragment>