                                    }
                                  }}
                                />
                              </LocalizationProvider>

```
By adding onKeyDown: (e) => e.preventDefault(), you are instructing React to instantly discard every single keyboard event (letters, numbers, backspace, and delete) the second it happens. The user will be physically unable to alter the time unless they click the clock/calendar popup icons.
