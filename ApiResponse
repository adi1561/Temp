    @Override
    public List<Map<String, Object>> getWorkflowHistory(String batchId) {
        // Safe, simplified query using ONLY the columns from your VOUCHER_WORKFLOW schema
        String sql = """
            SELECT 
                LAST_ACTION_BY AS ACTION_USER_NAME, 
                LAST_ACTION, 
                LAST_ACTION_AT, 
                REMARKS 
            FROM VOUCHER_WORKFLOW 
            WHERE BATCH_ID_FK = ? 
            ORDER BY LAST_ACTION_AT ASC
        """;
        
        return jdbcTemplate.queryForList(sql, batchId);
    }




    @ExceptionHandler(org.springframework.dao.DataAccessException.class)
    public ResponseEntity<ApiErrorResponseDto> handleDatabaseOperation(
            org.springframework.dao.DataAccessException ex,
            jakarta.servlet.http.HttpServletRequest request) {

        String errorCode = "DB_TECHNICAL_ERROR";

        // 1. Traverse the entire exception chain to hunt for the SQLException
        Throwable cause = ex;
        while (cause != null) {
            if (cause instanceof java.sql.SQLException sqlEx) {
                // Found it! Grab the Oracle Error Code and stop digging.
                errorCode = "ORA-" + sqlEx.getErrorCode();
                break;
            }
            cause = cause.getCause();
        }

        // 2. Log the sanitized code + the actual message for backend debugging
        log.error("DATABASE_FAULT | Path: {} | ErrorCode: {} | Real Message: {}",
                request.getRequestURI(), errorCode, ex.getMessage());

        // 3. Return a clean, safe response to the frontend
        return buildResponse(
                HttpStatus.INTERNAL_SERVER_ERROR,
                "Database Error",
                "A technical error occurred in the data layer. Reference: " + errorCode,
                request.getRequestURI(),
                null
        );
    }
