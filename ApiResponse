import React, { useState, useEffect, useCallback } from "react";
import {
  Box,
  Typography,
  Grid,
  TextField,
  Button,
  Paper,
  IconButton,
  MenuItem,
  CircularProgress,
  Autocomplete,
  Tooltip,
  Checkbox,
  FormControlLabel,
  Chip,
  FormHelperText,
  Divider,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Card,
  CardContent,
  CardActionArea
} from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import CategoryIcon from "@mui/icons-material/Category";
import ScheduleIcon from "@mui/icons-material/Schedule";
import DateRangeTwoToneIcon from '@mui/icons-material/DateRangeTwoTone';
import ArrowBackIcon from '@mui/icons-material/ArrowBack';
import { debounce } from "lodash";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const initialRowState = {
  id: Date.now(),
  branch: null,
  currency: "",
  cgl: null,
  amount: "",
  txnType: "",
  remarks: "",
  productCode: "",
};

export default function JournalPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // --- WIZARD / SELECTION STATE ---
  const [isSelectionComplete, setIsSelectionComplete] = useState(false);
  const [groupedVouchers, setGroupedVouchers] = useState({});
  const [selectedVoucher, setSelectedVoucher] = useState(null);
  const [scheduledTime, setScheduledTime] = useState("");

  // --- GRID POSTING STATE ---
  const [rows, setRows] = useState([initialRowState]);
  const [currencyOptions, setCurrencyOptions] = useState([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [commonBatchRemarks, setCommonBatchRemarks] = useState("");
  const [postingDate, setPostingDate] = useState("");
  const [checked, setChecked] = useState(false);
  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);

  // --- AUTOCOMPLETE CACHE ---
  const [branchInputValues, setBranchInputValues] = useState({});
  const [cglInputValues, setCglInputValues] = useState({});
  const [branchSearch, setBranchSearch] = useState({ loadingId: null, options: [] });
  const [cglSearch, setCglSearch] = useState({ loadingId: null, options: [] });

  const REMARKS_REPLACE_REGEX = /[^a-zA-Z0-9 ]/g;
  const CGL_REPLACE_REGEX = /[^0-9]/g;
  const BRANCH_REPLACE_REGEX = /[^0-9]/g;

  // ============================================================================
  // 1. INITIAL DATA FETCHING
  // ============================================================================
  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setIsPageLoading(true);

        // 1. EOD Check
        const eodResponse = await callApi("/JS/journals/eod_status", null, "GET");
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
            setIsPageLoading(false);
            return;
          }
        }

        // 2. Fetch Posting Date
        const dateResponse = await callApi("/JS/journals/current-posting-date", null, "GET");
        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            setPostingDate(`${day}-${month}-${year}`);
          } catch (e) {
            setPostingDate(dateResponse);
          }
        }

        // 3. Fetch Currencies
        const currencyResponse = await callApi("/CM/common-master/currency", null, "GET");
        if (currencyResponse?.success && Array.isArray(currencyResponse.data)) {
          setCurrencyOptions([...new Set(currencyResponse.data)]);
        }

        // 4. NEW: Fetch Voucher Types for Selection Screen
        const vouchersResponse = await callApi("/api/request-vouchers/filter", null, "GET");
        if (vouchersResponse && Array.isArray(vouchersResponse)) {
          const grouped = vouchersResponse.reduce((acc, voucher) => {
            const cat = voucher.category || "General";
            if (!acc[cat]) acc[cat] = [];
            acc[cat].push(voucher);
            return acc;
          }, {});
          setGroupedVouchers(grouped);
        }

      } catch (error) {
        console.error("Error fetching initial data:", error);
        showSnackBar("An error occurred while loading page data.", "error");
      } finally {
        setIsPageLoading(false);
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);

  // ============================================================================
  // 2. WIZARD NAVIGATION HANDLERS
  // ============================================================================
  const handleProceedToGrid = () => {
    if (!selectedVoucher) {
      showSnackBar("Please select a voucher type first.", "warning");
      return;
    }
    setIsSelectionComplete(true);
  };

  const handleBackToSelection = () => {
    setIsSelectionComplete(false);
  };

  // ============================================================================
  // 3. GRID VALIDATION & UTILS
  // ============================================================================
  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphabets and numbers are allowed.";

    if (type === "alphanumeric_space") {
      filtered = val.replace(REMARKS_REPLACE_REGEX, "");
      if (filtered !== val) hasError = true;
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Remark should not start with space or contain consecutive spaces.";
      }
    }
    if (hasError) showSnackBar(msg, "warning");
    return filtered;
  };

  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];
    if (!lastRow.branch || !lastRow.currency || !lastRow.cgl || !lastRow.amount || !lastRow.txnType || !isRowRemarksValid(lastRow.remarks)) {
      showSnackBar("Please fill all required fields (*) in the current row before adding a new one.", "warning");
      return;
    }
    setRows([...rows, { ...initialRowState, id: Date.now(), remarks: checked ? commonBatchRemarks : "" }]);
  };

  const handleRemarksSync = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);
    setRows(rows.map((row) => ({ ...row, remarks: isChecked ? commonBatchRemarks : "" })));
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) {
      setRows(rows.filter((row) => row.id !== id));
      const newBranchInputs = { ...branchInputValues }; delete newBranchInputs[id]; setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues }; delete newCglInputs[id]; setCglInputValues(newCglInputs);
    } else {
      showSnackBar("Cannot delete the first row.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    setRows((prevRows) => prevRows.map((row) => (row.id === id ? { ...row, [field]: value } : row)));
  };

  // ============================================================================
  // 4. API SEARCH DEBOUNCERS
  // ============================================================================
  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) { setBranchSearch({ loadingId: null, options: [] }); return; }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(`/JS/branches-journal/search?query=${encodeURIComponent(query)}`, null, "GET");
        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) { setBranchSearch({ loadingId: null, options: [] }); }
    }, 300), [callApi]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) { setCglSearch({ loadingId: null, options: [] }); return; }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(`/JS/cgl-journal/search?query=${encodeURIComponent(query)}`, null, "GET");
        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) { setCglSearch({ loadingId: null, options: [] }); }
    }, 300), [callApi]
  );

  // ============================================================================
  // 5. SUBMIT PAYLOAD TO BACKEND
  // ============================================================================
  const handleSubmit = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }

    setIsSubmitting(true);
    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${year}-${month}-${day}`;
    
    // Formatting the scheduled time if provided
    let formattedSchedule = null;
    if (scheduledTime) {
       const dateObj = new Date(scheduledTime);
       formattedSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' '); // format to yyyy-MM-dd HH:mm:ss
    }

    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (!row.branch || !row.currency || !row.cgl || !row.amount || parseFloat(row.amount) === 0 || !row.txnType || !isRowRemarksValid(row.remarks)) {
        showSnackBar(`Row ${index + 1} is incomplete or has a zero amount.`, "error");
        setIsSubmitting(false);
        return;
      }

      const branchCode = row.branch.code;
      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";
      
      const [integerPart = "0", fractionalPart = "0"] = (row.amount || "0").split(".");
      const amountAsBigInt = BigInt(integerPart + fractionalPart.substring(0, 4).padEnd(4, "0"));
      const compositeKey = `${branchCode}-${row.currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n });
      }
      if (row.txnType === "Debit") branchCurrencyTotals.get(compositeKey).totalDebit += amountAsBigInt;
      else if (row.txnType === "Credit") branchCurrencyTotals.get(compositeKey).totalCredit += amountAsBigInt;

      if (!branchEntryCheck.has(branchCode)) branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false });
      if (row.txnType === "Debit" && amountAsBigInt > 0n) branchEntryCheck.get(branchCode).hasDebit = true;
      else if (row.txnType === "Credit" && amountAsBigInt > 0n) branchEntryCheck.get(branchCode).hasCredit = true;

      rowPayloads.push({
        branch: branchCode,
        currency: row.currency,
        cgl: cglNumber,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        postingDate: formattedBackendDate
      });
    }

    for (const totals of branchEntryCheck.values()) {
      if (!totals.hasDebit || !totals.hasCredit) {
        showSnackBar("Branch must have at least one Debit and one Credit entry.", "error");
        setIsSubmitting(false); return;
      }
    }

    for (const totals of branchCurrencyTotals.values()) {
      if (totals.totalDebit !== totals.totalCredit) {
        showSnackBar("Branch and Currency Debit/Credit Mismatch.", "error");
        setIsSubmitting(false); return;
      }
    }

    const finalPayload = {
      vid: selectedVoucher.vid,         // INJECTED FROM WIZARD
      scheduledTime: formattedSchedule, // INJECTED FROM WIZARD
      commonBatchRemarks: commonBatchRemarks.trim(),
      rows: rowPayloads,
    };

    try {
      await callApi("/JS/journals/create-batch", finalPayload, "POST");
      showSnackBar("Your Request has been initiated. You will be Notified once the Batch is Created/Failed.", "info");
      
      // Reset everything to step 1
      setRows([{ ...initialRowState, id: Date.now() }]);
      setCommonBatchRemarks("");
      setChecked(false);
      setScheduledTime("");
      setSelectedVoucher(null);
      setIsSelectionComplete(false); // Send user back to selection screen

    } catch (error) {
      const errMsg = error?.response?.data?.message || error.message || "System error occurred.";
      showSnackBar(`Failed to initiate request: ${errMsg}`, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  const isFormReadyToSubmit = rows.every((row) => row.branch && row.currency && row.cgl && row.amount && parseFloat(row.amount) > 0 && row.txnType && isRowRemarksValid(row.remarks));

  // ============================================================================
  // RENDER BLOCKS
  // ============================================================================

  if (isPageLoading) {
    return <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '80vh' }}><CircularProgress size={60} /></Box>;
  }

  if (isEodRunning) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'top', height: '25vh', p: 2, marginBottom: '500px' }}>
        <Paper elevation={4} sx={{ p: 6, textAlign: 'center', borderRadius: 4 }}>
          <Typography variant="h4" color="error" fontWeight="bold" gutterBottom>EOD is Currently Running</Typography>
          <Typography variant="h6" color="text.secondary" sx={{ mt: 2 }}>Journal Posting is temporarily disabled.</Typography>
        </Paper>
      </Box>
    );
  }

  // ----------------------------------------------------------------------------
  // VIEW 1: VOUCHER SELECTION SCREEN (WIZARD STEP 1)
  // ----------------------------------------------------------------------------
  if (!isSelectionComplete) {
    return (
      <Box sx={{ p: 2, maxWidth: "1200px", margin: "0 auto" }}>
        <Typography variant="h5" fontWeight="bold" gutterBottom sx={{ mb: 3 }}>
          Select Voucher Type
        </Typography>

        <Box sx={{ mb: 4 }}>
          {Object.entries(groupedVouchers).map(([category, vouchers], index) => (
            <Accordion key={category} defaultExpanded={index === 0} sx={{ mb: 1, borderRadius: 2, '&:before': { display: 'none' }, boxShadow: 1 }}>
              <AccordionSummary expandIcon={<ExpandMoreIcon />} sx={{ backgroundColor: "#f8f9fa", borderRadius: 2 }}>
                <Box sx={{ display: 'flex', alignItems: 'center', width: '100%', justifyContent: 'space-between' }}>
                  <Box sx={{ display: 'flex', alignItems: 'center' }}>
                    <CategoryIcon sx={{ mr: 1, color: "text.secondary" }} />
                    <Typography variant="subtitle1" fontWeight="bold">{category}</Typography>
                  </Box>
                  <Chip label={vouchers.length} size="small" sx={{ fontWeight: 'bold' }} />
                </Box>
              </AccordionSummary>
              <AccordionDetails sx={{ backgroundColor: "#ffffff", pt: 2 }}>
                <Grid container spacing={2}>
                  {vouchers.map((voucher) => {
                    const isSelected = selectedVoucher?.id === voucher.id;
                    return (
                      <Grid item xs={12} sm={6} md={4} key={voucher.id}>
                        <Card 
                          elevation={isSelected ? 4 : 1}
                          sx={{ 
                            border: isSelected ? "2px solid #1976d2" : "1px solid #e0e0e0",
                            backgroundColor: isSelected ? "#f3f8fd" : "#fff",
                            transition: "all 0.2s ease-in-out"
                          }}
                        >
                          <CardActionArea onClick={() => setSelectedVoucher(voucher)} sx={{ p: 2, height: "100%" }}>
                            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 1 }}>
                              <Typography variant="subtitle1" fontWeight="bold">{voucher.vid}</Typography>
                              <Chip label={voucher.allowedRole} size="small" color={isSelected ? "primary" : "default"} sx={{ fontSize: "0.7rem", height: "20px" }} />
                            </Box>
                            <Typography variant="body2" color="text.secondary">{voucher.description}</Typography>
                          </CardActionArea>
                        </Card>
                      </Grid>
                    );
                  })}
                </Grid>
              </AccordionDetails>
            </Accordion>
          ))}
        </Box>

        <Paper elevation={2} sx={{ p: 3, mb: 3, borderRadius: 2 }}>
          <Typography variant="h6" fontWeight="bold" gutterBottom sx={{ display: 'flex', alignItems: 'center' }}>
            <ScheduleIcon sx={{ mr: 1 }} /> Optional: Schedule Execution
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
            If you want this batch to be posted at a specific future date and time, set it below. Leave blank to post immediately upon final approval.
          </Typography>
          <TextField
            type="datetime-local"
            label="Schedule Time"
            InputLabelProps={{ shrink: true }}
            value={scheduledTime}
            onChange={(e) => setScheduledTime(e.target.value)}
            inputProps={{ min: new Date().toISOString().slice(0, 16) }}
          />
        </Paper>

        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mt: 3 }}>
          <Button variant="contained" size="large" onClick={handleProceedToGrid} disabled={!selectedVoucher} sx={{ px: 5, py: 1.5, borderRadius: 2, fontWeight: 'bold' }}>
            Proceed to Data Entry
          </Button>
        </Box>
      </Box>
    );
  }

  // ----------------------------------------------------------------------------
  // VIEW 2: DATA ENTRY GRID (WIZARD STEP 2)
  // ----------------------------------------------------------------------------
  return (
    <Box>
      {/* Header showing selections */}
      <Paper elevation={2} sx={{ p: 2, mb: 2, display: 'flex', justifyContent: 'space-between', alignItems: 'center', backgroundColor: '#e3f2fd' }}>
        <Box>
          <Typography variant="subtitle2" color="text.secondary">Selected Voucher</Typography>
          <Typography variant="h6" fontWeight="bold" color="primary">{selectedVoucher.vid} <Chip label={selectedVoucher.category} size="small" sx={{ ml: 1 }}/></Typography>
        </Box>
        <Box>
          {scheduledTime && (
            <Chip icon={<ScheduleIcon />} label={`Scheduled: ${new Date(scheduledTime).toLocaleString()}`} color="info" variant="outlined" sx={{ mr: 2 }}/>
          )}
          <Button startIcon={<ArrowBackIcon />} onClick={handleBackToSelection} variant="outlined" size="small">
            Change
          </Button>
        </Box>
      </Paper>

      <Box component={Paper} elevation={3} sx={{ p: 2 }}>
        <Box>
          <Box sx={{ display: "flex", alignItems: "center", gap: 0.5 }}>
            <DateRangeTwoToneIcon />
            <Typography variant="h6" fontWeight="500" component="span" sx={{ ml: 0.5 }}>Posting Date:</Typography>
            <Typography variant="body1" fontWeight="500" component="span">{postingDate}</Typography>
          </Box>
          <Typography component="span" sx={{ color: "#ec0101ff", fontSize: "13px" }}>
            Note: All Journals will be Posted on this Date
          </Typography>
        </Box>
        <Divider sx={{ py: 0.5 }} />

        {/* Common Remarks Section */}
        <Grid item xs={12} md={12} sx={{ mt: 3, width: "100%" }}>
          <TextField
            label="Common Batch Remarks"
            value={commonBatchRemarks}
            onChange={(e) => {
              const newValue = filterAndWarn(e.target.value, "alphanumeric_space");
              if (newValue.length <= 30) {
                setCommonBatchRemarks(newValue);
                if (checked) setRows(rows.map((row) => ({ ...row, remarks: newValue })));
              }
            }}
            fullWidth required multiline rows={1} inputProps={{ maxLength: 30 }}
            error={commonBatchRemarks.length > 0 && !isCommonRemarksValid(commonBatchRemarks)}
          />
          <FormHelperText sx={{ color: "text.secondary", ml: 1.5 }}>Allowed 2-30 chars (alphabets, numbers)</FormHelperText>
          <FormControlLabel sx={{ mt: 1 }} control={<Checkbox checked={checked} onChange={handleRemarksSync} color="primary" disabled={commonBatchRemarks.length > 0 && !isRemarksValid(commonBatchRemarks)} />} label="Apply this remark to all below transactions" />
        </Grid>

        {/* Dynamic Grid Rows */}
        <Box sx={{ mt: 2 }}>
          {rows.map((row, index) => {
            const isINR = row.currency === "INR";
            const amountRegex = isINR ? /^\d{0,16}(\.\d{0,2})?$/ : /^\d{0,16}(\.\d{0,4})?$/;

            return (
              <React.Fragment key={row.id}>
                <Grid container spacing={2} alignItems="flex-start">
                  
                  {/* Branch */}
                  <Grid item xs={12} md={3} size={1.8}>
                    <Autocomplete
                      popupIcon={null} autoHighlight options={branchSearch.options}
                      getOptionLabel={(option) => option && option.code ? `${option.code} - ${option.name}` : ""}
                      value={row.branch || null}
                      onChange={(e, newValue) => handleRowChange(row.id, "branch", newValue)}
                      inputValue={branchInputValues[row.id] || ""}
                      onInputChange={(e, newInputValue, reason) => {
                        if (reason === 'input') {
                          const cleanInput = newInputValue.replace(BRANCH_REPLACE_REGEX, "").substring(0, 5);
                          setBranchInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                          searchBranches(cleanInput, row.id);
                        } else { setBranchInputValues(prev => ({ ...prev, [row.id]: newInputValue })); }
                      }}
                      loading={branchSearch.loadingId === row.id} filterOptions={(x) => x}
                      isOptionEqualToValue={(o, v) => o?.code === v?.code}
                      noOptionsText={(branchInputValues[row.id] || "").length < 3 ? "Please enter at least 3 digits" : "No Branch found"}
                      renderInput={(params) => (
                        <Tooltip title="Search by Branch Code" placement="top-start">
                          <TextField {...params} label="Branch *" placeholder="Enter branch code..." InputLabelProps={{ shrink: true }}
                            InputProps={{
                              ...params.InputProps,
                              endAdornment: (<Box>{branchSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}{params.InputProps.endAdornment}</Box>),
                            }}
                          />
                        </Tooltip>
                      )}
                    />
                    <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>Min 3 Digits required</Typography>
                  </Grid>

                  {/* Currency */}
                  <Grid item xs={12} md={1.5} size={1.5}>
                    <TextField select label="Currency *" value={row.currency} onChange={(e) => { handleRowChange(row.id, "currency", e.target.value); handleRowChange(row.id, "amount", ""); }} fullWidth InputLabelProps={{ shrink: true }}
                      SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Select Currency</span> : selected, MenuProps: { PaperProps: { style: { maxHeight: 250 } } } }}>
                      {currencyOptions.map((c) => (<MenuItem key={c} value={c}>{c}</MenuItem>))}
                    </TextField>
                  </Grid>

                  {/* CGL */}
                  <Grid item xs={12} md={2} size={1.8}>
                    <Autocomplete
                      popupIcon={null} autoHighlight options={cglSearch.options}
                      getOptionLabel={(option) => option && option.cglNumber ? `${option.cglNumber} - ${option.description}` : ""}
                      value={row.cgl || null}
                      onChange={(e, newValue) => handleRowChange(row.id, "cgl", newValue)}
                      inputValue={cglInputValues[row.id] || ""}
                      onInputChange={(e, newInputValue, reason) => {
                        if (reason === 'input') {
                          const cleanInput = newInputValue.replace(CGL_REPLACE_REGEX, "").substring(0, 10);
                          setCglInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                          searchCgls(cleanInput, row.id);
                        } else { setCglInputValues(prev => ({ ...prev, [row.id]: newInputValue })); }
                      }}
                      loading={cglSearch.loadingId === row.id} filterOptions={(x) => x}
                      isOptionEqualToValue={(o, v) => o?.cglNumber === v?.cglNumber}
                      noOptionsText={(cglInputValues[row.id] || "").length < 3 ? "Type at least 3 digits..." : "CGL not found"}
                      renderInput={(params) => (
                        <Tooltip title="Search by CGL Number" placement="top-start">
                          <TextField {...params} label="CGL *" placeholder="Search CGL number..." InputLabelProps={{ shrink: true }}
                            InputProps={{
                              ...params.InputProps,
                              endAdornment: (
                                <Box sx={{ display: "flex", alignItems: "center" }}>
                                  {row.cgl && String(row.cgl.cglNumber).startsWith("5") && <Chip label="MEMO" size="small" color="warning" sx={{ height: 20, fontSize: "0.7rem", mr: 1 }} />}
                                  {cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}{params.InputProps.endAdornment}
                                </Box>
                              ),
                            }}
                          />
                        </Tooltip>
                      )}
                    />
                    <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>Min 3 digits required</Typography>
                  </Grid>

                  {/* Amount */}
                  <Grid item xs={12} md={2} size={1.5}>
                    <TextField label="Amount *" value={row.amount} InputLabelProps={{ shrink: true }} disabled={!row.currency} fullWidth placeholder={isINR ? "0.00" : "0.0000"} inputProps={{ style: { textAlign: "right" } }}
                      onChange={(e) => {
                        const rawVal = e.target.value;
                        if (/[^0-9.]/.test(rawVal)) { showSnackBar("Only numbers and decimal point are allowed.", "warning"); return; }
                        if (rawVal === "" || amountRegex.test(rawVal)) { handleRowChange(row.id, "amount", rawVal); } 
                        else { showSnackBar("Exceeded maximum digits or decimal places.", "warning"); }
                      }}
                    />
                    <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>{!row.currency ? "Select Currency first" : isINR ? "Max 16 digits, 2 decimals" : "Max 16 digits, 4 decimals"}</Typography>
                  </Grid>

                  {/* Txn Type */}
                  <Grid item xs={12} md={1} size={1.3}>
                    <TextField select label="Type *" value={row.txnType} onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)} fullWidth InputLabelProps={{ shrink: true }}
                      SelectProps={{ displayEmpty: true, renderValue: (s) => !s ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : s }}>
                      <MenuItem value="Debit">Debit</MenuItem>
                      <MenuItem value="Credit">Credit</MenuItem>
                    </TextField>
                  </Grid>

                  {/* Product Code */}
                  <Grid item xs={12} md={2} size={1.5}>
                    <TextField label="Product Code" value={row.productCode} InputLabelProps={{ shrink: true }} placeholder="Enter Product Code.." fullWidth inputProps={{ maxLength: 8 }}
                      onChange={(e) => {
                        const cleanVal = e.target.value.replace(/[^0-9]/g, "");
                        if (e.target.value !== cleanVal) showSnackBar("Only digits are allowed.", "warning");
                        if (cleanVal.length <= 8) handleRowChange(row.id, "productCode", cleanVal);
                      }}
                    />
                    <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>Max 8 digits</Typography>
                  </Grid>

                  {/* Remarks */}
                  <Grid item xs={12} md={2} size={2}>
                    <TextField label="Remarks *" value={row.remarks} InputLabelProps={{ shrink: true }} placeholder="Enter remarks..." fullWidth inputProps={{ maxLength: 30 }} disabled={checked} error={row.remarks.length > 0 && !isRowRemarksValid(row.remarks)}
                      onChange={(e) => {
                        const val = filterAndWarn(e.target.value, "alphanumeric_space");
                        if (val.length <= 30) handleRowChange(row.id, "remarks", val);
                      }}
                    />
                    <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", ml: 1.2, display: "block" }}>Allowed 2-30 chars</Typography>
                  </Grid>

                  {/* Delete Action */}
                  <Grid item xs={12} md={0.5} sx={{ textAlign: "center" }}>
                    <Tooltip title="Delete row" arrow>
                      <IconButton onClick={() => handleDeleteRow(row.id)} sx={{ "&:hover": { color: "error.main", backgroundColor: "rgba(211, 47, 47, 0.04)" } }}><DeleteIcon /></IconButton>
                    </Tooltip>
                  </Grid>
                </Grid>
                {index < rows.length - 1 && <Box sx={{ borderBottom: 1, borderColor: "divider", my: 2 }} />}
              </React.Fragment>
            );
          })}

          <Box sx={{ mt: 3, display: "flex", gap: 2, justifyContent: "right" }}>
            <Button variant="contained" startIcon={<AddIcon />} onClick={handleAddRow}>Add Row</Button>
            <Button variant="contained" color="success" onClick={handleSubmit} disabled={isSubmitting || !isCommonRemarksValid(commonBatchRemarks) || !isFormReadyToSubmit}>
              {isSubmitting ? <CircularProgress size={24} /> : "Submit"}
            </Button>
          </Box>
        </Box>
      </Box>
    </Box>
  );
}
