import java.util.*;

public class DependencyGraph {
    
    // THIS IS THE GRAPH! It is just a HashMap.
    // The Key is the Task ID.
    // The Value is a List of Task IDs that it points to.
    private final Map<Long, List<Long>> adjacencyList = new HashMap<>();
    
    // We also keep track of the "In-Degree" (how many prerequisites a task has)
    private final Map<Long, Integer> inDegree = new HashMap<>();

    // A method to draw the arrow between two tasks
    public void addDependency(Long prerequisite, Long dependent) {
        
        // 1. Add the dependent task to the prerequisite's list
        adjacencyList.get(prerequisite).add(dependent);
        
        // 2. Increase the in-degree count for the dependent task
        inDegree.put(dependent, inDegree.getOrDefault(dependent, 0) + 1);
    }
}
