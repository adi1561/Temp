package com.fincore.VoucherService.Models; // Fixed uppercase 'P'

import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import java.time.LocalDateTime;

@Entity
@Table(name = "VOUCHER_POSTING")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class VoucherPosting {

    @Id
    @Column(name = "BATCH_ID", length = 50)
    private String batchId;

    @Column(name = "VID_FK", length = 20, nullable = false)
    private String vidFk;

    @Column(name = "CREATORS_ROLE", length = 100)
    private String creatorsRole;

    @Column(name = "CREATED_BY", length = 100)
    private String createdBy;

    @Column(name = "CREATED_AT", updatable = false)
    private LocalDateTime createdAt = LocalDateTime.now();

    @Column(name = "CURRENT_STATUS", length = 30)
    private String currentStatus;

    // FIXED: Removed the 'length' attribute (invalid for Integers) 
    // and mapped to the correct new Database column name!
    @Column(name = "NEXT_APPROVAL_ROLE_ID")
    private Integer nextApprovalRoleId;

    @Column(name = "EXECUTION_SCHEDULED", length = 3)
    private String executionScheduled; // "YES" or "NO"

    @Column(name = "SCHEDULED_TIME")
    private LocalDateTime scheduledTime;

    @Column(name = "APPROVAL_WORKFLOW", length = 100)
    private String approvalWorkflow;

    @Column(name = "IS_SCHEDULE_OVERRIDE", length = 3)
    private String isScheduleOverride; // "YES" or "NO"

    @Column(name = "EXECUTED_AT")
    private LocalDateTime executedAt;
}
