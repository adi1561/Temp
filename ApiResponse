  const handleSubmitBatchCancel = async () => {
    setIsSubmitting(true);
    const targetBatchId = selectedBatch.batchId; // Store it before modal closes
    
    try {
      await callApi(
        `/JS/journals/my-requests/by-batch/${targetBatchId}`,
        null,
        "DELETE"
      );
      showSnackBar(`Batch ${targetBatchId} deletion process started.`, "success");
      
      // 1. OPTIMISTIC UPDATE: Instantly remove the batch from the UI table
      setRows((prevRows) => prevRows.filter((row) => row.batchId !== targetBatchId));
      
      handleCloseModal();
      
      // 2. DELAYED FETCH: Wait 1.5 seconds to give the backend Async PL/SQL 
      // time to completely purge the records before refreshing the list.
      setTimeout(() => {
        fetchMyBatches();
      }, 1500);

    } catch (error) {
      showSnackBar("Failed to delete batch", "error");
    } finally {
      setIsSubmitting(false);
    }
  };
