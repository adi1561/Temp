<React.Fragment key={row.id}>
  <Grid container spacing={2} alignItems="flex-start">

    {/* Branch */}
    <Grid item xs={12} md={3.5} sx={{ flexGrow: 2 }}>
      <Autocomplete
        popupIcon={null}
        autoHighlight
        options={branchSearch.options}
        getOptionLabel={(option) =>
          option && option.code
            ? `${option.code} - ${option.name}`
            : ""
        }
        value={row.branch || null}
        onChange={(event, newValue) =>
          handleRowChange(row.id, "branch", newValue)
        }
        inputValue={branchInputValues[row.id] || ""}
        onInputChange={(event, newInputValue, reason) => {
          if (reason === "input") {
            const cleanInput = newInputValue
              .replace(BRANCH_REPLACE_REGEX, "")
              .substring(0, 5);

            setBranchInputValues((prev) => ({
              ...prev,
              [row.id]: cleanInput,
            }));

            searchBranches(cleanInput, row.id);
          } else {
            setBranchInputValues((prev) => ({
              ...prev,
              [row.id]: newInputValue,
            }));
          }
        }}
        loading={branchSearch.loadingId === row.id}
        filterOptions={(x) => x}
        isOptionEqualToValue={(option, value) =>
          option?.code === value?.code
        }
        noOptionsText={
          (branchInputValues[row.id] || "").length < 3
            ? "Please enter at least 3 digits"
            : "No Branch found"
        }
        renderInput={(params) => (
          <Tooltip title="Search by Branch Code">
            <TextField
              {...params}
              label="Branch *"
              placeholder="Enter branch code..."
              InputLabelProps={{ shrink: true }}
              sx={{
                "& input": {
                  overflowX: "auto",
                  textOverflow: "unset",
                  whiteSpace: "nowrap",
                },
              }}
              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <Box>
                    {branchSearch.loadingId === row.id ? (
                      <CircularProgress size={20} />
                    ) : null}
                    {params.InputProps.endAdornment}
                  </Box>
                ),
              }}
            />
          </Tooltip>
        )}
      />

      <Typography
        variant="caption"
        sx={{
          fontSize: "0.65rem",
          color: "text.secondary",
          mt: 0.5,
          ml: 1.2,
        }}
      >
        Min 3 Digits required
      </Typography>
    </Grid>

    {/* Currency */}
    <Grid item xs={12} md={1.5}>
      <TextField
        select
        label="Currency *"
        value={row.currency}
        fullWidth
        InputLabelProps={{ shrink: true }}
        onChange={(e) => {
          handleRowChange(row.id, "currency", e.target.value);
          handleRowChange(row.id, "amount", "");
        }}
      >
        {currencyOptions.map((c) => (
          <MenuItem key={c} value={c}>
            {c}
          </MenuItem>
        ))}
      </TextField>
    </Grid>

    {/* CGL */}
    <Grid item xs={12} md={2.8} sx={{ flexGrow: 2.2 }}>
      <Autocomplete
        popupIcon={null}
        autoHighlight
        options={cglSearch.options}
        getOptionLabel={(option) =>
          option && option.cglNumber
            ? `${option.cglNumber} - ${option.description}`
            : ""
        }
        value={row.cgl || null}
        onChange={(event, newValue) =>
          handleRowChange(row.id, "cgl", newValue)
        }
        inputValue={cglInputValues[row.id] || ""}
        onInputChange={(event, newInputValue, reason) => {
          if (reason === "input") {
            const cleanInput = newInputValue
              .replace(CGL_REPLACE_REGEX, "")
              .substring(0, 10);

            setCglInputValues((prev) => ({
              ...prev,
              [row.id]: cleanInput,
            }));

            searchCgls(cleanInput, row.id);
          } else {
            setCglInputValues((prev) => ({
              ...prev,
              [row.id]: newInputValue,
            }));
          }
        }}
        loading={cglSearch.loadingId === row.id}
        filterOptions={(x) => x}
        isOptionEqualToValue={(option, value) =>
          option?.cglNumber === value?.cglNumber
        }
        noOptionsText={
          (cglInputValues[row.id] || "").length < 3
            ? "Type at least 3 digits..."
            : "CGL not found"
        }
        renderInput={(params) => (
          <Tooltip title="Search by CGL Number">
            <TextField
              {...params}
              label="CGL *"
              placeholder="Search CGL..."
              InputLabelProps={{ shrink: true }}
              sx={{
                "& input": {
                  overflowX: "auto",
                  textOverflow: "unset",
                  whiteSpace: "nowrap",
                },
              }}
              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <Box display="flex" alignItems="center">

                    {row.cgl &&
                      String(row.cgl.cglNumber).startsWith("5") && (
                        <Chip
                          label="MEMO"
                          size="small"
                          color="warning"
                          sx={{ mr: 1 }}
                        />
                      )}

                    {cglSearch.loadingId === row.id ? (
                      <CircularProgress size={20} />
                    ) : null}

                    {params.InputProps.endAdornment}
                  </Box>
                ),
              }}
            />
          </Tooltip>
        )}
      />

      <Typography
        variant="caption"
        sx={{ fontSize: "0.65rem", ml: 1.2 }}
      >
        Min 3 digits required
      </Typography>
    </Grid>

    {/* Amount */}
    <Grid item xs={12} md={2}>
      <TextField
        label="Amount *"
        value={row.amount}
        fullWidth
        disabled={!row.currency}
      />
    </Grid>

    {/* Txn Type */}
    <Grid item xs={12} md={1}>
      <TextField
        select
        label="Type *"
        value={row.txnType}
        fullWidth
        onChange={(e) =>
          handleRowChange(row.id, "txnType", e.target.value)
        }
      >
        <MenuItem value="Debit">Debit</MenuItem>
        <MenuItem value="Credit">Credit</MenuItem>
      </TextField>
    </Grid>

    {/* Product Code */}
    <Grid item xs={12} md={1.2}>
      <TextField
        label="Product Code"
        value={row.productCode}
        fullWidth
      />
    </Grid>

    {/* Remarks */}
    <Grid item xs={12} md={1.6}>
      <TextField
        label="Remarks *"
        value={row.remarks}
        fullWidth
      />
    </Grid>

    {/* Delete */}
    <Grid item xs={12} md={0.4}>
      <IconButton onClick={() => handleDeleteRow(row.id)}>
        <DeleteIcon />
      </IconButton>
    </Grid>

  </Grid>

  {index < rows.length - 1 && (
    <Box
      sx={{
        borderBottom: 1,
        borderColor: "divider",
        my: 2,
      }}
    />
  )}
</React.Fragment>