                      </Grid>
                      <Grid item xs={12} sm={3}>
                        <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Is Execution Scheduled?</Typography>
                        <Typography variant="body1" fontWeight="500" color={vidDetails.SCHEDULED_TIME ? "info.main" : "text.primary"}>
                          {vidDetails.SCHEDULED_TIME ? `Yes (${new Date(vidDetails.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })})` : "No"}
                        </Typography>
                      </Grid>
                      <Grid item xs={12} sm={2}>
                        <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Download Voucher Batch</Typography>
                        <Button
                          variant="outlined"
                          size="small"
                          startIcon={<FileDownloadIcon />}
                          onClick={handleDownloadExcel}
                          disabled={!viewingBatchId}
                          sx={{ borderColor: "#217346", color: "#217346", "&:hover": { backgroundColor: "#e8f5e9", borderColor: "#1e6b40" } }}
                        >
                          Download Batch
                        </Button>
                      </Grid>
                    </Grid>
                  </Paper>
                </Stack>
              ) : null}
            </Box>

            {/* --- HORIZONTAL TIMELINE --- */}
            <Box sx={{ p: 4, flexGrow: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
              <Typography variant="subtitle1" fontWeight="bold" color="text.primary" sx={{ mb: 3 }}>
                Workflow Progress
              </Typography>
              {viewingBatchState === "REJECTED" ? (
                <Alert severity="error" variant="filled" sx={{ mt: 2, fontWeight: "bold" }}>
                  This batch was REJECTED and the workflow has been terminated.
                </Alert>
              ) : isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 3 }}><CircularProgress /></Box>
              ) : dynamicSteps.length > 0 ? (
                <Stepper
                  activeStep={
                    (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED" || viewingBatchState === "C" || viewingBatchState === "S")
                      ? dynamicSteps.length
                      : dynamicSteps.findIndex(s => s.state === viewingBatchState) + 1
                  }
                  alternativeLabel
                  connector={<BigConnector />}
                >
                  {dynamicSteps.map((step, index) => {
                    const activeStepIndex = (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED" || viewingBatchState === "C" || viewingBatchState === "S") 
                        ? dynamicSteps.length 
                        : dynamicSteps.findIndex(s => s.state === viewingBatchState) + 1;
                    
                    const isCompleted = index < activeStepIndex;
                    const isCurrent = index === activeStepIndex;
                    
                    let statusFlag = 'PENDING';
                    if (isCompleted) statusFlag = 'COMPLETED';
                    if (isCurrent && viewingBatchState === "REJECTED") statusFlag = 'REJECTED';
                    else if (isCurrent) statusFlag = 'ACTIVE';

                    return (
                      <Step key={step.state} completed={isCompleted} active={isCurrent}>
                        <StepLabel StepIconComponent={() => <BigWorkflowIcon statusFlag={statusFlag} label={step.designation} />}>
                          <Chip
                            label={getRoleDisplayName(step.role)}
                            size="small"
                            variant={isCurrent ? "filled" : "outlined"}
                            color={isCurrent ? "primary" : "default"}
                            sx={{ mt: 1, height: 22, fontSize: "0.65rem", fontWeight: "bold" }}
                          />
                        </StepLabel>
                      </Step>
                    );
                  })}
                </Stepper>
              ) : (
                <Alert severity="info" sx={{ mt: 2 }}>Workflow configuration not found.</Alert>
              )}
            </Box>

            {/* --- WORKFLOW HISTORY --- */}
            <Box sx={{ p: 4, borderTop: "1px solid", borderColor: "divider" }}>
              {isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 2 }}><CircularProgress size={24} /></Box>
              ) : (
                <>
                  <Typography variant="subtitle1" fontWeight="bold" color="text.primary" sx={{ mb: 3 }}>
                    Workflow History ({workflowHistory.length})
                  </Typography>
                  <Stack spacing={2.5}>
                    {workflowHistory.map((history, idx) => {
                      const userName = history.ACTION_USER_NAME || "User";
                      const initial = userName.charAt(0).toUpperCase();

                      return (
                        <Box key={idx} sx={{ display: 'flex', gap: 2 }}>
                          <Box><Avatar sx={{ bgcolor: 'primary.main', width: 40, height: 40, fontWeight: 'bold', fontSize: '1rem' }}>{initial}</Avatar></Box>
                          <Box sx={{ flexGrow: 1, backgroundColor: "white", p: 2.5, borderRadius: 2, border: "1px solid", borderColor: "#e2e8f0", boxShadow: "0 1px 2px 0 rgb(0 0 0 / 0.05)" }}>
                            <Box sx={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 1, mb: 1 }}>
                              <Typography variant="subtitle2" fontWeight="bold" color="text.primary">{userName}</Typography>
                              <Typography variant="caption" color="text.secondary">• {new Date(history.LAST_ACTION_AT).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}</Typography>
                            </Box>
                            <Chip label={history.LAST_ACTION || "System Action"} size="small" sx={{ mb: 1.5, height: 22, fontSize: "0.7rem", fontWeight: "bold", backgroundColor: history.LAST_ACTION?.includes("Reject") ? "#fee2e2" : "#e0e7ff", color: history.LAST_ACTION?.includes("Reject") ? "#991b1b" : "#3730a3" }} />
                            <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>{history.REMARKS || "No remarks provided."}</Typography>
                          </Box>
                        </Box>
                      );
                    })}
                  </Stack>
                </>
              )}
            </Box>
          </Box>
        </DialogContent>

        {/* --- STICKY BOTTOM ACTION BAR (Where Delete lives now) --- */}
        <DialogActions sx={{ p: 3, borderTop: "1px solid", borderColor: "divider", backgroundColor: "white", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <Box sx={{ flexGrow: 1 }}>
             {/* Text indicating state if needed */}
          </Box>
          <Stack direction="row" spacing={2} alignItems="center">
            <Button onClick={handleCloseViewModal} sx={{ fontWeight: 'bold', color: 'text.secondary' }}>
              Close Details
            </Button>
            {/* Show Delete Button if it is the creator and batch is strictly PENDING */}
            {(viewingBatchState === "PENDING" || viewingBatchState === "P") && isViewingSelfCreated && (
              <Button
                variant="contained"
                color="error"
                startIcon={<DeleteIcon />}
                onClick={() => {
                  setIsViewModalOpen(false); // Close view
                  handleOpenModal({ batchId: viewingBatchId }); // Open confirm delete
                }}
                sx={{ minWidth: 160, fontWeight: 'bold', py: 1 }}
              >
                Delete Batch
              </Button>
            )}
          </Stack>
        </DialogActions>
      </Dialog>
    </Box>
  );
}






