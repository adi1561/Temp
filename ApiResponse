{/* Currency */}
<Grid item size={{ xl: 1.5, lg: 2 }}>
  <TextField
    select 
    fullWidth
    label="Currency *" 
    value={row.currency} 
    InputLabelProps={{ shrink: true }}
    onChange={(e) => { 
      handleRowChange(row.id, "currency", e.target.value); 
      handleRowChange(row.id, "amount", ""); 
    }}
    SelectProps={{
      displayEmpty: true,
      renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Select Currency</span> : selected,
      MenuProps: {
        PaperProps: { 
          style: { maxHeight: 220 } 
        },
        // ADDED: Forces the dropdown to start exactly below the input box,
        // which allows MUI's collision detection to neatly flip the menu 
        // upwards if it hits the bottom of the viewport.
        anchorOrigin: {
          vertical: 'bottom',
          horizontal: 'left',
        },
        transformOrigin: {
          vertical: 'top',
          horizontal: 'left',
        }
      }
    }}
  >
    {currencyOptions.map((c) => (<MenuItem key={c} value={c}>{c}</MenuItem>))}
  </TextField>
</Grid>
