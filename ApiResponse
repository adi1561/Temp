                            <Typography variant="body1" fontWeight="500">
                              {vidDetails.VID_CREATED_BY_NAME}{" "}
                              <Typography
                                component="span"
                                variant="caption"
                                color="text.secondary"
                              >
                                ({vidDetails.VID_CREATOR_ID})
                              </Typography>
                            </Typography>
                          </Stack>
                        </Grid>
                        <Grid item xs={12} sm={4}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Created At
