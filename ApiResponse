### 4. The Single, Unified Action Engine (processWorkflowAction)
**Delete the old processAdvancedApproval entirely.** Replace your duplicate action methods with this single unified block. It has zero hardcoded roles and completely maps to the database engine.
```java
    @Transactional
    public void processWorkflowAction(ProcessVoucherRequestDto dto, String executorId, Integer executorRole) {
        String batchId = dto.getBatchId();

        VoucherPosting posting = voucherPostingRepository.findById(batchId)
                .orElseThrow(() -> new CustomExceptions.InvalidDataException("Batch ID not found in workflow tracking."));

        // 1. Prevent Self-Approval
        if (executorId.equalsIgnoreCase(posting.getCreatedBy())) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You cannot approve a batch you created.");
        }

        // 2. Prevent Duplicate Approvals
        boolean hasAlreadyApproved = voucherWorkflowRepository.findByBatchIdFkOrderByLastActionAtAsc(batchId)
                .stream().anyMatch(w -> executorId.equalsIgnoreCase(w.getLastActionBy()));
        if (hasAlreadyApproved) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You have already approved this batch at a previous level.");
        }

        // 3. Dynamic Authorization Check
        if (posting.getNextApprovalRoleId() != null && !posting.getNextApprovalRoleId().equals(executorRole)) {
            throw new CustomExceptions.InvalidDataException("Unauthorized: You do not have the required Role to approve this step.");
        }

        // ==========================================
        // 4. DYNAMIC STATE PROGRESSION
        // ==========================================
        String actionTaken = dto.getStatus().toString(); 

        Map<String, Object> transitionRule;
        try {
            transitionRule = jdbcTemplate.queryForMap(
                    "SELECT NEXT_STATE, NEXT_ROLE_ID, IS_FINAL_APPROVAL FROM WORKFLOW_TRANSITIONS " +
                            "WHERE WORKFLOW_CODE = ? AND CURRENT_STATE = ? AND ACTION_TAKEN = ?",
                    posting.getApprovalWorkflow(), posting.getCurrentStatus(), actionTaken
            );
        } catch (EmptyResultDataAccessException e) {
            throw new CustomExceptions.InvalidDataException("Configuration Error: No transition rule found for Action: " + actionTaken + " from State: " + posting.getCurrentStatus());
        }

        String nextState = (String) transitionRule.get("NEXT_STATE");
        String isFinal = (String) transitionRule.get("IS_FINAL_APPROVAL");
        Number nextRoleNum = (Number) transitionRule.get("NEXT_ROLE_ID");
        Integer nextRoleId = nextRoleNum != null ? nextRoleNum.intValue() : null;

        // 5. Apply the Rule
        if ("REJECTED".equals(actionTaken)) {
            posting.setCurrentStatus(nextState);
            posting.setNextApprovalRoleId(null);
            voucherPostingRepository.save(posting);

            logWorkflowAction(batchId, posting.getVidFk(), "REJECTED", executorId, dto.getRemarks(), null);
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R' WHERE BATCH_ID = ?", batchId);
            notificationWriterService.createBatchRejectedNotification(batchId, posting.getCreatedBy(), executorId, dto.getRemarks());
            return;
        }

        if ("Y".equals(isFinal)) {
            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime() != null) {
                if (posting.getScheduledTime().isBefore(LocalDateTime.now())) {
                    if (dto.getOverrideScheduleLapse() == null || !dto.getOverrideScheduleLapse()) {
                        throw new CustomExceptions.ScheduleLapsedException("The scheduled execution time has passed. Do you want to post immediately or set a new schedule?");
                    }
                    if (dto.getNewScheduledTime() != null) {
                        posting.setScheduledTime(dto.getNewScheduledTime());
                        posting.setIsScheduleOverride("YES");
                    } else {
                        posting.setExecutionScheduled("NO");
                    }
                }
            }

            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime().isAfter(LocalDateTime.now())) {
                posting.setCurrentStatus("SCHEDULED");
                posting.setNextApprovalRoleId(null);
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_SCHEDULED", executorId, dto.getRemarks(), posting.getScheduledTime());
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'SCHEDULED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            } else {
                posting.setCurrentStatus("POSTED");
                posting.setExecutedAt(LocalDateTime.now());
                posting.setNextApprovalRoleId(null);
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_POSTED", executorId, dto.getRemarks(), null);

                BulkProcessVoucherPostingDto execDto = new BulkProcessVoucherPostingDto();
                execDto.setBatchId(batchId);
                execDto.setStatus(RequestStatus.ACCEPTED);
                execDto.setRemarks(dto.getRemarks());
                this.processBulkRequestsAsync(execDto, executorId, executorRole);
            }
            notificationWriterService.createBatchApprovedNotification(batchId, posting.getCreatedBy(), executorId);

        } else {
            posting.setCurrentStatus(nextState);
            posting.setNextApprovalRoleId(nextRoleId);
            logWorkflowAction(batchId, posting.getVidFk(), "APPROVED_" + posting.getCurrentStatus(), executorId, dto.getRemarks(), null);
        }

        voucherPostingRepository.save(posting);
    }

    // Consolidated Helper Method
    private void logWorkflowAction(String batchId, String vid, String action, String executorId, String remarks, LocalDateTime scheduledTime) {
        VoucherWorkflow wf = new VoucherWorkflow();
        wf.setBatchIdFk(batchId);
        wf.setVidFk(vid != null ? vid : "UNKNOWN");
        wf.setLastAction(action);
        wf.setLastActionBy(executorId);
        wf.setLastActionAt(LocalDateTime.now());
        wf.setRemarks(remarks);
        wf.setScheduledTime(scheduledTime);
        voucherWorkflowRepository.save(wf);
    }

