private ParsingResult parseCsvStream(InputStream is, LocalDate postingDate) throws IOException {
    List<ExcelRowData> list = new ArrayList<>();
    boolean hasProductCol = false;

    try (BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
        String line;
        int i = 0;
        while ((line = br.readLine()) != null) {
            if (line.trim().isEmpty()) continue;
            String[] c = line.split(",", -1);

            // Header skipping logic preserved
            if (i == 0) {
                String h = c.length > 0 ? c[0].trim().toLowerCase() : "";
                if (h.contains("branch") || h.contains("batch")) {
                    i++; continue;
                }
            }

            ExcelRowData d = new ExcelRowData();
            d.rowIndex = i++;
            String col0Clean = c.length > 0 ? c[0].replace("\uFEFF", "").trim() : "";
            d.sysSite = col0Clean;

            // Logic for System Format (01) preserved exactly
            if ("01".equals(col0Clean)) {
                d.isSystemFormat = true;
                if (c.length > 1) d.sysDate = c[1].trim();
                if (c.length > 2) d.sysYear = c[2].trim();
                if (c.length > 3) d.sysPeriod = c[3].trim();
                if (c.length > 4) d.branch = c[4].trim();
                if (c.length > 5) d.currency = c[5].trim().toUpperCase();
                if (c.length > 6) d.cgl = c[6].trim();
                parseAmount(d, (c.length > 7) ? c[7].trim() : "", (c.length > 8) ? c[8].trim() : "");
                if (c.length > 9) d.remarks = c[9].trim();

                if (c.length > 10) {
                    String rawProd = c[10].trim();
                    d.productCode = rawProd;
                    if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                        hasProductCol = true;
                    }
                } else {
                    d.productCode = "";
                }

                if (c.length != 14) {
                    d.formatErrors.add("Invalid CSV columns (Expected 14)");
                } else {
                    validateSystemColumns(d, d.sysSite, d.sysDate, d.sysYear, d.sysPeriod, c[11].trim(), c[12].trim(), c[13].trim(), postingDate);
                }
            } 
            // Logic for Standard Format preserved exactly
            else {
                if (c.length > 0) d.branch = c[0].trim();
                if (c.length > 1) d.currency = c[1].trim().toUpperCase();
                if (c.length > 2) d.cgl = c[2].trim();
                parseAmount(d, (c.length > 3) ? c[3].trim() : "", (c.length > 4) ? c[4].trim() : "");
                if (c.length > 5) d.remarks = c[5].trim();
                if (c.length > 6) {
                    String rawProd = c[6].trim();
                    d.productCode = rawProd;
                    if (!rawProd.isEmpty() && !"A".equalsIgnoreCase(rawProd)) {
                        hasProductCol = true;
                    }
                } else {
                    d.productCode = "";
                }
            }
            list.add(d);
        }
    }
    return new ParsingResult(list, hasProductCol);
}

