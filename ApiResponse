                      const activeStepIndex = isFullyDone ? dynamicSteps.length : (viewingBatchOrder - 1);
                      const isCompleted = index < activeStepIndex;
                      const isCurrent = index === activeStepIndex;

                      const escalationHours = viewingBatch?.escalationTime || 24;
                      const hoursPending = viewingBatch ? Math.abs(new Date() - new Date(viewingBatch.requestDate)) / 36e5 : 0;
                      const isEscalated = viewingBatchState !== "REJECTED" && (activeStepIndex < dynamicSteps.length) && (hoursPending > escalationHours);

                      let statusFlag = 'PENDING';
                      if (isCompleted) statusFlag = 'COMPLETED';
