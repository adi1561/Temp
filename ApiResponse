import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;

public class ThreadVisibilityDemo {

    private int unsafeBalance = 0;
    private int safeBalance = 0;
    private final Object lock = new Object();

    // ---------------------------------------------------------
    // SCENARIO 1: THE CHAOS (No Lock)
    // ---------------------------------------------------------
    public void depositUnsafe() {
        String threadName = Thread.currentThread().getName();
        System.out.println(threadName + " [UNSAFE] Entering method.");

        // 1. Read the state
        int currentBalance = unsafeBalance;
        System.out.println(threadName + " [UNSAFE] Read balance as: $" + currentBalance);

        // 2. The OS pauses the thread! 
        System.out.println(threadName + " [UNSAFE] 💤 Going to sleep (OS Time-Slice)...");
        try { Thread.sleep(100); } catch (InterruptedException e) {}

        // 3. The thread wakes up and writes the state based on old data
        unsafeBalance = currentBalance + 1;
        System.out.println(threadName + " [UNSAFE] ⏰ Woke up! Wrote balance as: $" + unsafeBalance);
    }

    // ---------------------------------------------------------
    // SCENARIO 2: THE VAULT (Synchronized Block)
    // ---------------------------------------------------------
    public void depositSafe() {
        String threadName = Thread.currentThread().getName();
        System.out.println(threadName + " [SAFE] Arrived at the block. Waiting for key...");

        // Only one thread gets past this line at a time
        synchronized (lock) {
            System.out.println(threadName + " [SAFE] 🔐 GRABBED THE KEY! Current balance: $" + safeBalance);
            
            // 1. Read the state
            int currentBalance = safeBalance;

            // 2. The OS pauses the thread! BUT it takes the key with it.
            System.out.println(threadName + " [SAFE] 💤 Sleeping with key in pocket...");
            try { Thread.sleep(100); } catch (InterruptedException e) {}

            // 3. The thread wakes up and writes the state
            safeBalance = currentBalance + 1;
            System.out.println(threadName + " [SAFE] ⏰ Woke up! Wrote balance as: $" + safeBalance + ". 🔓 DROPPING KEY.");
        } 
    }

    // ---------------------------------------------------------
    // MAIN METHOD
    // ---------------------------------------------------------
    public static void main(String[] args) throws InterruptedException {
        ThreadVisibilityDemo demo = new ThreadVisibilityDemo();

        // Create a pool of 3 workers and give them custom nametags
        ExecutorService threadPool = Executors.newFixedThreadPool(3, runnable -> {
            Thread t = new Thread(runnable);
            // We give them distinct names to track them easily
            t.setName("Worker-" + t.getId()); 
            return t;
        });

        System.out.println("========== STARTING UNSAFE TEST ==========");
        for (int i = 0; i < 3; i++) {
            threadPool.submit(demo::depositUnsafe);
        }

        // Wait a moment for the unsafe test to finish before starting the safe one
        Thread.sleep(1000); 

        System.out.println("\n========== STARTING SAFE TEST ==========");
        for (int i = 0; i < 3; i++) {
            threadPool.submit(demo::depositSafe);
        }

        threadPool.shutdown();
        threadPool.awaitTermination(5, TimeUnit.SECONDS);
        
        System.out.println("\n========== FINAL RESULTS ==========");
        System.out.println("Expected Balance : $3");
        System.out.println("Unsafe Balance   : $" + demo.unsafeBalance + " (Data corrupted by Race Condition)");
        System.out.println("Safe Balance     : $" + demo.safeBalance + " (Data perfectly protected)");
    }
}
