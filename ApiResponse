    @Override
    @Transactional
    public void processBulkRequestsAsync(BulkProcessJournalRequestDto dto, String executorId, Integer executorRole) {

        // 1. Intercept Partial Approvals: The "Batch Split" Pattern
        if (dto.getJournalIdPrefixes() != null && !dto.getJournalIdPrefixes().isEmpty()) {
            String originalBatchId = dto.getBatchId();

            // Generate a unique split ID
            String splitBatchId = originalBatchId + "-P" + (System.currentTimeMillis() % 10000);

            log.info("PARTIAL_APPROVAL_DETECTED | Splitting Batch: {} -> {}", originalBatchId, splitBatchId);

            // Clone the master record so the split batch has a valid audit trail
            jdbcTemplate.update(
                    "INSERT INTO JOURNAL_BATCH_MASTER (BATCH_ID, BATCH_STATUS, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT) " +
                            "SELECT ?, 'PENDING', CREATOR_ID, CURRENT_TIMESTAMP, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT " +
                            "FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?",
                    splitBatchId, originalBatchId
            );

            // Migrate selected rows to the new split batch using high-speed JDBC batch updates
            List<String> prefixes = dto.getJournalIdPrefixes();
            jdbcTemplate.batchUpdate(
                    "UPDATE JOURNAL_REQUEST SET BATCH_ID = ? WHERE BATCH_ID = ? AND JOURNAL_ID LIKE ?",
                    new org.springframework.jdbc.core.BatchPreparedStatementSetter() {
                        @Override
                        public void setValues(java.sql.PreparedStatement ps, int i) throws java.sql.SQLException {
                            ps.setString(1, splitBatchId);
                            ps.setString(2, originalBatchId);
                            ps.setString(3, prefixes.get(i) + "-%"); // Matches exact prefix pattern
                        }

                        @Override
                        public int getBatchSize() {
                            return prefixes.size();
                        }
                    }
            );

            // Re-route the DTO to point to our newly isolated batch!
            dto.setBatchId(splitBatchId);

            // --- ADDED RECALIBRATION LOGIC ---
            log.info("RECALCULATING_TOTALS | Syncing master headers for {} and {}", originalBatchId, splitBatchId);

            // Dynamically recalculate and update the totals for BOTH batches simultaneously
            String recalcSql =
                    "UPDATE JOURNAL_BATCH_MASTER M " +
                            "SET (TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT) = (" +
                            "    SELECT COUNT(1), " +
                            "           NVL(SUM(CASE WHEN REQ_AMOUNT > 0 THEN REQ_AMOUNT ELSE 0 END), 0), " +
                            "           NVL(SUM(CASE WHEN REQ_AMOUNT < 0 THEN ABS(REQ_AMOUNT) ELSE 0 END), 0) " +
                            "    FROM JOURNAL_REQUEST " +
                            "    WHERE BATCH_ID = M.BATCH_ID" +
                            ") " +
                            "WHERE BATCH_ID IN (?, ?)";

            jdbcTemplate.update(recalcSql, originalBatchId, splitBatchId);
            // --- END RECALIBRATION LOGIC ---
        }

        // 2. Lock the target batch (either the original, or the newly split one)
        String lockSql = "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND BATCH_STATUS = 'PENDING'";
        int updated = jdbcTemplate.update(lockSql, dto.getBatchId());

        if (updated == 0) {
            log.warn("APPROVAL_LOCK_FAIL | Batch: {} | Status: Batch already processing", dto.getBatchId());
            throw new IllegalStateException("Batch is already being processed or is not in PENDING status.");
        }

        progressService.sendProgress(dto.getBatchId(), executorId, 0, "PROCESSING", "Approval Queued...");
        self.executeAsyncBatchProcessing(dto, executorId);
    }

    @Override
    @Async("bulkExecutor")
    public void executeAsyncBatchProcessing(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        MDC.put("batchId", batchId);
        MDC.put("user", executorId);
        long start = System.currentTimeMillis();

        try {
            self.executeApprovalInTransaction(dto, executorId);
            log.info("BATCH_PROCESSING_DONE | Batch: {} | Status: {} | Duration: {}ms", batchId, dto.getStatus(), System.currentTimeMillis() - start);
        } catch (org.springframework.dao.PessimisticLockingFailureException e) {
            log.error("DATABASE_LOCK_TIMEOUT | Batch: {} | Status: GL_BALANCE row locked", batchId);
            handleAsyncApprovalError(batchId, executorId, dto.getStatus(), "System is busy. Please retry in 1 minute.");
        } catch (DataAccessException e) {
            log.error("PROCEDURE_EXEC_FAIL | Batch: {} | Type: {}", batchId, e.getClass().getSimpleName());
            handleAsyncApprovalError(batchId, executorId, dto.getStatus(), "Database execution error during approval.");
        } catch (Exception e) {
            log.error("INTERNAL_PROCESSING_FAULT | Batch: {} | Type: {}", batchId, e.getClass().getSimpleName());
            handleAsyncApprovalError(batchId, executorId, dto.getStatus(), "An internal logic error occurred.");
        } finally {
            MDC.clear();
        }
    }

    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void executeApprovalInTransaction(BulkProcessJournalRequestDto dto, String executorId) {
        String batchId = dto.getBatchId();
        String creatorId = jdbcTemplate.queryForObject(
                "SELECT CREATOR_ID FROM JOURNAL_BATCH_MASTER WHERE BATCH_ID = ?", String.class, batchId);

        // Enforce Segregation of Duties (Maker-Checker Rule)
        if (creatorId != null && creatorId.equalsIgnoreCase(executorId)) {
            log.error("SECURITY_VIOLATION | Self-approval attempt blocked | Batch: {} | User: {}", batchId, executorId);
            handleAsyncApprovalError(batchId, executorId, "Security Violation: You cannot approve or reject your own batch.");
            return;
        }

        progressService.sendProgress(batchId, executorId, 20, "PROCESSING", "Executing Oracle Core Business Logic...");

        if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {

            List<HdfsSyncDto> syncData = jdbcTemplate.execute(
                    "{call PROCESS_JOURNAL_BATCH(?, ?, ?, ?, ?)}",
                    (CallableStatementCallback<List<HdfsSyncDto>>) cs -> {
                        cs.setString(1, batchId);
                        cs.setString(2, executorId);
                        cs.setString(3, dto.getRemarks());
                        cs.setString(4, "A");
                        cs.registerOutParameter(5, -10);
                        cs.execute();
                        List<HdfsSyncDto> list = new ArrayList<>();
                        try (ResultSet rs = (ResultSet) cs.getObject(5)) {
                            while (rs.next()) {
                                list.add(new HdfsSyncDto(
                                        rs.getString("BRANCH"), rs.getString("CURRENCY"), rs.getString("CGL"),
                                        rs.getDate("BAL_DATE") != null ? rs.getDate("BAL_DATE").toLocalDate() : null,
                                        rs.getBigDecimal("NEW_BALANCE"), rs.getBigDecimal("NEW_INR_BALANCE")
                                ));
                            }
                        }
                        return list;
                    }
            );

            jdbcTemplate.update(
                    "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'ACCEPTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                    executorId, dto.getRemarks(), batchId);

            try {
                hdfsSyncService.syncToDataLake(syncData);
            } catch (Exception hdfsEx) {
                log.error("HDFS_SYNC_FAIL | Batch: {} | Error: {} | Status: Rolling back Oracle transaction", batchId, hdfsEx.getClass().getSimpleName());
                // Throwing this exception triggers the @Transactional rollback in Oracle!
                throw new CustomExceptions.DatabaseOperationException("Data Lake Sync Failed. Oracle changes rolled back.", hdfsEx);
            }

            progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Approved Successfully");
            notificationWriterService.createBatchApprovedNotification(batchId, creatorId, executorId);

            progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Approved Successfully");
            notificationWriterService.createBatchApprovedNotification(batchId, creatorId, executorId);

        } else if (RequestStatus.REJECTED.equals(dto.getStatus())) {
            jdbcTemplate.update(
                    "UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ?, EXECUTION_DATE = SYSDATE WHERE BATCH_ID = ? AND REQ_STATUS = 'P'",
                    executorId, dto.getRemarks(), batchId);
            jdbcTemplate.update(
                    "UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTION_DATE = SYSTIMESTAMP, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?",
                    executorId, dto.getRemarks(), batchId);

            progressService.sendProgress(batchId, executorId, 100, "COMPLETED", "Batch Rejected");
            notificationWriterService.createBatchRejectedNotification(batchId, creatorId, executorId, dto.getRemarks());
        }
    }

    private void handleAsyncApprovalError(String batchId, String executorId, RequestStatus actionStatus, String msg) {
        // Revert to PENDING and wipe the error message from remarks
        jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'PENDING', EXECUTOR_REMARKS = NULL WHERE BATCH_ID = ?", batchId);
        progressService.sendProgress(batchId, executorId, 0, "FAILED", msg);

        // Send notification to the user who tried to perform the action
        String actionName = (actionStatus == RequestStatus.ACCEPTED) ? "approve" : "reject";
        String notifMsg = String.format("Failed to %s Journal Batch '%s'. It has been returned to PENDING.", actionName, batchId);

        try {
            notificationWriterService.createNotification(executorId, null, notifMsg, "/journal-view/" + batchId, batchId, "JournalService");
        } catch (Exception e) {
            log.warn("NOTIFICATION_WARN | Batch: {} | Could not send failure notification to {}", batchId, executorId);
        }
    }

