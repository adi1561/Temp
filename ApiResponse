### 2. Fix the Mini Stepper vs Outer Stepper Logic
In JournalPostingStatus, the mini stepper inside the DataGrid needs to align perfectly with the backend's workflow order.
**Find the currentStatus (Workflow Progress) column in your columns array, and replace its renderCell with this:**
```javascript
renderCell: (params) => {
  const state = params.value || "";
  const workflow = params.row.approvalWorkflow;
  const isRejected = state === "REJECTED" || params.row.batchStatus === "R";

  const stepLabels = workflowStepsMap[workflow] || ["Step 1", "Loading..."];

  // FIX: Safely use currentOrder if available, otherwise fallback to exact string match
  let activeStep = params.row.currentOrder ? params.row.currentOrder - 1 : stepLabels.findIndex((label) => label === state);

  // Auto-complete timeline if posted or scheduled
  if (state === "POSTED" || state === "SCHEDULED" || state === "C" || state === "S" || state === "APPROVED") {
    activeStep = stepLabels.length;
  }
  if (activeStep === -1) activeStep = 0; // Safe fallback

  const escalationHours = params.row.escalationTime || 24;
  const hoursPending = Math.abs(new Date() - new Date(params.row.requestDate)) / 36e5;
  const isEscalated = !isRejected && activeStep < stepLabels.length && hoursPending > escalationHours;

  return (
    <Box sx={{ width: "100%", display: "flex", alignItems: "center", justifyContent: "flex-start", pl: 2, height: "100%" }}>
      <Stepper activeStep={activeStep} alternativeLabel connector={<CustomConnector />} sx={{ width: "100%", mt: 0.5 }}>
        {stepLabels.map((label, index) => {
          const isCompleted = index < activeStep;
          const isCurrent = index === activeStep;

          let statusFlag = "PENDING";
          if (isCompleted) statusFlag = "COMPLETED";
          if (isCurrent && isRejected) statusFlag = "REJECTED";
          else if (isCurrent && isEscalated) statusFlag = "ESCALATED";
          else if (isCurrent) statusFlag = "ACTIVE";

          return (
            <Tooltip title={label} key={`${label}-${index}`} arrow>
              <Step completed={isCompleted} active={isCurrent} sx={{ px: 0, opacity: isRejected && index > activeStep ? 0.3 : 1 }}>
                <StepLabel
                  StepIconComponent={() => (
                    <CustomWorkflowIcon statusFlag={statusFlag} iconLetter={label.charAt(0).toUpperCase()} label={label} isMini={true} />
                  )}
                  sx={{ p: 0, m: 0 }}
                />
              </Step>
            </Tooltip>
          );
        })}
      </Stepper>
    </Box>
  );
},

```
