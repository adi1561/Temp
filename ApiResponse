import java.util.concurrent.*;

public class CallableDemo {
    public static void main(String[] args) {
        
        // 1. Create a Thread Pool with 2 workers
        ExecutorService threadPool = Executors.newFixedThreadPool(2);

        // 2. Define our Callable (The background task that returns a String)
        Callable<String> databaseTask = () -> {
            System.out.println("Background Thread: Fetching data from Database...");
            Thread.sleep(3000); // Simulate a 3-second DB query
            return "✅ Adesh's User Profile Data"; // It actually returns a value!
        };

        System.out.println("Main Thread: Submitting task to the pool...");
        
        // 3. Submit the task and instantly receive the 'Future' (The Buzzer)
        Future<String> myReceipt = threadPool.submit(databaseTask);

        // 4. Main thread is NOT blocked! It can do other work here.
        System.out.println("Main Thread: Doing other UI work while DB loads...");

        try {
            // 5. Time to get the result. 
            // 🚨 WARNING: future.get() is a BLOCKING call!
            System.out.println("Main Thread: Calling future.get(). Waiting for the result...");
            
            String result = myReceipt.get(); // Main thread goes into WAITING state if not done!
            
            System.out.println("Main Thread: Got the result! " + result);
        } catch (InterruptedException | ExecutionException e) {
            System.out.println("Main Thread: The background task threw an error!");
        }

        threadPool.shutdown();
    }
}
