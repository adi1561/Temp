          <DialogContent>
            <Alert severity="warning" sx={{ mb: 3 }}>
              The originally scheduled execution time{" "}
              <strong>
                {vidDetails?.SCHEDULED_TIME
                  ? new Date(vidDetails.SCHEDULED_TIME).toLocaleString()
                  : "N/A"}
              </strong>{" "}
              for Batch ID <strong>{viewingBatchId}</strong> (Created by{" "}
              <strong>
