/**
 * Finds the critical path — the longest dependency chain.
 * This represents the MINIMUM sprint duration regardless of team size.
 * * @param taskHours map of taskId → estimated hours
 * @return CriticalPathResult with path and total hours
 */
public CriticalPathResult getCriticalPath(Map<Long, Integer> taskHours) {
    List<Long> sorted = topologicalSort();
    
    // dist[task] = longest path ending at this task
    Map<Long, Integer> dist = new HashMap<>();
    Map<Long, Long> predecessor = new HashMap<>();
    
    allTasks.forEach(id -> dist.put(id, taskHours.getOrDefault(id, 0)));
    
    for (Long task : sorted) {
        
        // 1. CLEARLY SEPARATED: Fetch the neighbors/dependents first
        List<Long> dependents = adjacencyList.getOrDefault(task, List.of());
        
        // 2. THE LOOP: Now iterate over that clean variable
        for (Long dependent : dependents) {
            
            int newDist = dist.get(task) + taskHours.getOrDefault(dependent, 0);
            
            if (newDist > dist.get(dependent)) {
                dist.put(dependent, newDist);
                predecessor.put(dependent, task);
            }
        }
    }
    
    // Find the task with the longest path
    Long endTask = dist.entrySet().stream()
        .max(Map.Entry.comparingByValue())
        .map(Map.Entry::getKey)
        .orElse(null);
    
    // Reconstruct the path
    List<Long> path = new ArrayList<>();
    Long current = endTask;
    
    while (current != null) {
        path.add(current);
        current = predecessor.get(current);
    }
    
    Collections.reverse(path);
    
    return new CriticalPathResult(path, dist.get(endTask));
}

public record CriticalPathResult(List<Long> path, int totalHours) {}
