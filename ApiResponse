### Part 2: Frontend Icon Redesign (JournalAuthorization.jsx)
We will rewrite the CustomWorkflowIcon so all circles are exactly 28px. It will dynamically render initials, a red cross for rejections, and an orange exclamation mark if the escalation time is breached.
**FIND your CustomWorkflowIcon component (near the top) and REPLACE it entirely with this:**
```javascript
const CustomWorkflowIcon = (props) => {
  const { statusFlag, iconLetter } = props;

  const baseStyle = {
    width: 28, height: 28, borderRadius: '50%',
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    zIndex: 1, color: '#fff', fontSize: '0.85rem', fontWeight: 'bold'
  };

  if (statusFlag === 'COMPLETED') {
    return <Box sx={{ ...baseStyle, backgroundColor: 'success.main' }}><CheckIcon sx={{ fontSize: 18 }} /></Box>;
  }
  if (statusFlag === 'REJECTED') {
    return <Box sx={{ ...baseStyle, backgroundColor: 'error.main' }}><CloseIcon sx={{ fontSize: 18 }} /></Box>;
  }
  if (statusFlag === 'ESCALATED') {
    return (
      <Tooltip title="Escalation Time Breached - Attention Required">
        <Box sx={{ ...baseStyle, backgroundColor: 'warning.main', border: '3px solid #fff3e0', color: '#fff' }}>!</Box>
      </Tooltip>
    );
  }
  if (statusFlag === 'ACTIVE') {
    return <Box sx={{ ...baseStyle, backgroundColor: 'primary.main', border: '3px solid #e3f2fd' }}>{iconLetter}</Box>;
  }
  
  // FUTURE / PENDING
  return <Box sx={{ ...baseStyle, backgroundColor: '#e2e8f0', color: '#64748b' }}>{iconLetter}</Box>;
};

```
