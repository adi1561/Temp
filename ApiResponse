    {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        // Grab the workflow code safely from the backend row
        const workflow = params.row.approvalWorkflow || "Workflow_3"; 
        const isRejected = state === "REJECTED";

        if (isRejected) {
           return <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />;
        }

        // ==========================================
        // CORRECTED MINI-STEPPER ARRAYS
        // ==========================================
        // Workflow_3 has 3 Checkers + Final Execution = 4 dots total
        let stepLabels = ['L1', 'L2', 'L3', 'Final']; 
        
        // Workflow_4 has 4 Checkers + Final Execution = 5 dots total
        if (workflow === 'Workflow_4' || workflow === 'W2_4_APPROVERS') {
            stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];
        }

        // Safely calculate the active dot based on the state string
        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        else if (state.includes("L3")) activeStep = 2;
        else if (state.includes("L4")) activeStep = 3;
        
        // If the workflow is completely done, jump to the last dot
        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
            activeStep = stepLabels.length - 1; 
        }

        return (
          <Box sx={{ width: '100%', mt: 0.5 }}>
            <Stepper 
              activeStep={activeStep} 
              alternativeLabel 
              connector={<CustomConnector />}
            >
              {stepLabels.map((label, index) => (
                <Step key={label}>
                  <StepLabel 
                    StepIconProps={{ 
                      sx: { 
                        width: 20, 
                        height: 20, 
                        color: activeStep >= index ? 'success.main' : 'text.disabled',
                        '&.Mui-active': { color: 'primary.main' }
                      } 
                    }}
                  >
                    <Typography sx={{ fontSize: '0.65rem', mt: -1, fontWeight: activeStep === index ? 'bold' : 'normal' }}>
                      {label}
                    </Typography>
                  </StepLabel>
                </Step>
              ))}
            </Stepper>
          </Box>
        );
      },
    },
