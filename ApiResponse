const initialRowState = { branch: null, currency: "", cgl: null, amount: "", txnType: "", remarks: "", productCode: "" };

const formatBigIntForDisplay = (val) => {
  if (typeof val !== "bigint") val = BigInt(val || 0);
  const str = val.toString().padStart(5, "0");
  return `${str.slice(0, -4) || "0"}.${str.slice(-4)}`;
};

const rowSchema = z.object({
  branch: z.object({ code: z.string(), name: z.string() }).nullable().refine(val => val !== null, "Branch is required"),
  currency: z.string().min(1, "Select currency"),
  cgl: z.object({ cglNumber: z.string(), description: z.string().optional() }).nullable().refine(val => val !== null, "CGL is required"),
  amount: z.string().min(1, "Amount is required").refine(val => parseFloat(val) > 0, "Amount must be > 0"),
  txnType: z.enum(["Debit", "Credit"], { required_error: "Select type", invalid_type_error: "Select type" }),
  productCode: z.string().max(8, "Max 8 digits").optional(),
  remarks: z.string().min(2, "Min 2 chars").max(30, "Max 30 chars").regex(/^[a-zA-Z0-9 ]+$/, "Only alphabets/numbers"),
}).superRefine((data, ctx) => {
  if (data.currency === "INR" && data.amount && data.amount.includes(".")) {
    if (data.amount.split(".")[1].length > 2) ctx.addIssue({ code: z.ZodIssueCode.custom, message: "INR max 2 decimals", path: ["amount"] });
  }
});


const formSchema = z.object({
  commonBatchRemarks: z.string().max(30).optional(),
  applyToAll: z.boolean().default(false),
  rows: z.array(rowSchema).min(1, "At least one row is required"),
}).superRefine((data, ctx) => {
  if (data.commonBatchRemarks && data.commonBatchRemarks.length > 0 && data.commonBatchRemarks.length < 2) {
    ctx.addIssue({ code: z.ZodIssueCode.custom, message: "Must be 2-30 chars", path: ["commonBatchRemarks"] });
  }

  // --- Real-time Debit/Credit Math Engine ---
  const branchCurrencyTotals = new Map();
  const branchEntryCheck = new Map();

  data.rows.forEach((row) => {
    if (!row.branch || !row.currency || !row.cgl || !row.amount || !row.txnType || isNaN(parseFloat(row.amount))) return;

    const branchCode = row.branch.code;
    const type = String(row.cgl.cglNumber).startsWith("5") ? "MEMO" : "NORMAL";
    const compositeKey = `${branchCode}-${row.currency}-${type}`;

    const [integerPart = "0", fractionalPart = "0"] = row.amount.split(".");
    const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
    const amountAsBigInt = BigInt(integerPart + fractionalPadded);

    if (!branchCurrencyTotals.has(compositeKey)) branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n });
    if (row.txnType === "Debit") branchCurrencyTotals.get(compositeKey).totalDebit += amountAsBigInt;
    else if (row.txnType === "Credit") branchCurrencyTotals.get(compositeKey).totalCredit += amountAsBigInt;

    if (!branchEntryCheck.has(branchCode)) branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false });
    if (row.txnType === "Debit") branchEntryCheck.get(branchCode).hasDebit = true;
    else if (row.txnType === "Credit") branchEntryCheck.get(branchCode).hasCredit = true;
  });

  for (const [branchCode, totals] of branchEntryCheck.entries()) {
    if (!totals.hasDebit || !totals.hasCredit) {
      ctx.addIssue({ code: z.ZodIssueCode.custom, message: `Branch ${branchCode} is missing a matching Debit or Credit entry.`, path: ["root.batchMath"] });
    }
  }

  for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
    if (totals.totalDebit !== totals.totalCredit) {
      const [branchCode, currency, type] = compositeKey.split("-");
      ctx.addIssue({ code: z.ZodIssueCode.custom, message: `Debit/Credit mismatch for Branch ${branchCode} (${currency} - ${type}).`, path: ["root.batchMath"] });
    }
  }
});



export default function JournalPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

   const [currencyOptions, setCurrencyOptions] = useState([]);
  const [postingDate, setPostingDate] = useState("");
  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);
  // --- React Hook Form Setup ---
  const { control, handleSubmit: hookFormSubmit, setValue, getValues, reset, formState: { errors, isSubmitting, isValid } } = useForm({
    resolver: zodResolver(formSchema),
    mode: "onChange", // Validates instantly as user types!
    defaultValues: { commonBatchRemarks: "", applyToAll: false, rows: [initialRowState] }
  });

  const { fields, append, remove } = useFieldArray({ control, name: "rows" });

  // Watch for "Apply to all" logic
  const applyToAll = useWatch({ control, name: "applyToAll" });
  const commonBatchRemarks = useWatch({ control, name: "commonBatchRemarks" });

  // Sync remarks if checkbox is checked
  useEffect(() => {
    if (applyToAll) {
      const currentRows = getValues("rows");
      currentRows.forEach((_, idx) => setValue(`rows.${idx}.remarks`, commonBatchRemarks || "", { shouldValidate: true }));
    }
  }, [commonBatchRemarks, applyToAll, setValue, getValues]);


  // Track input values to prevent empty dropdown tray on focus
  const [branchInputValues, setBranchInputValues] = useState({});
  const [cglInputValues, setCglInputValues] = useState({});

  const [branchSearch, setBranchSearch] = useState({
    loadingId: null,
    options: [],
  });
  const [cglSearch, setCglSearch] = useState({
    loadingId: null,
    options: []
  });

  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setIsPageLoading(true);

        // 1. FIRST: Check the EOD Status from your new API
        const eodResponse = await callApi("/JS/journals/eod_status", null, "GET");

        // The API returns an array: [{ "eodStatus": 0 }]
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
            setIsPageLoading(false);
            return; // STOP loading everything else, block the screen
          }
        }

        // 2. IF EOD IS NOT RUNNING: Continue loading the normal page data
        const dateResponse = await callApi("/JS/journals/current-posting-date", null, "GET");

        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            const formattedDate = `${day}-${month}-${year}`;
            setPostingDate(formattedDate);
          } catch (e) {
            console.error("Could not parse date:", dateResponse, e);
            setPostingDate(dateResponse);
          }
        } else {
          showSnackBar("Failed to load official posting date.", "error");
          setPostingDate("Error");
        }

        const currencyResponse = await callApi("/CM/common-master/currency", null, "GET");
        if (currencyResponse?.success && Array.isArray(currencyResponse.data)) {
          const uniqueCurrencies = [...new Set(currencyResponse.data)];
          setCurrencyOptions(uniqueCurrencies);
        } else {
          showSnackBar("Failed to load currencies.", "error");
        }
      } catch (error) {
        console.error("Error fetching initial data:", error);
        showSnackBar("An error occurred while loading page data.", "error");
      } finally {
        setIsPageLoading(false);
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);



  // 1. Common remarks can be empty. If filled, must be 2-30.
  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);

  // 2. Row remarks are STRICTLY compulsory (2-30 chars).
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphabets and numbers are allowed.";

    if (type === "alphanumeric_space") {
      // 1. Strip any character using the centralized regex
      filtered = val.replace(REMARKS_REPLACE_REGEX, "");

      if (filtered !== val) {
        hasError = true;
      }

      // 2. Strip leading space and collapse double spaces
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Remark should not start with space or contain consecutive spaces.";
      }
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }
    return filtered;
  };

  // Both Common Batch Remarks and Row Remarks are now strictly compulsory (2-30 chars)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];

    if (
      !lastRow.branch ||
      !lastRow.currency ||
      !lastRow.cgl ||
      !lastRow.amount ||
      !lastRow.txnType ||
      !isRowRemarksValid(lastRow.remarks)
    ) {
      showSnackBar(
        "Please fill all required fields (*) in the current row before adding a new one.",
        "warning"
      );
      return;
    }

    const newRow = {
      ...initialRowState,
      id: Date.now(),
      remarks: checked ? commonBatchRemarks : "",
    };
    setRows([...rows, newRow]);
  };

  const handleRemarksSync = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);

    if (isChecked) {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: commonBatchRemarks,
      }));
      setRows(newRows);
    } else {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: "",
      }));
      setRows(newRows);
    }
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) {
      setRows(rows.filter((row) => row.id !== id));
      // Cleanup input tracking
      const newBranchInputs = { ...branchInputValues };
      delete newBranchInputs[id];
      setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues };
      delete newCglInputs[id];
      setCglInputValues(newCglInputs);
    } else {
      showSnackBar("Cannot delete the first row.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    setRows((prevRows) =>
      prevRows.map((row) => {
        if (row.id === id) {
          return { ...row, [field]: value };
        }
        return row;
      })
    );
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) {
        setBranchSearch({ loadingId: null, options: [] });
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(
          `/JS/branches-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("Branch search failed.", "error");
        setBranchSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      // Changed from === 0 to < 3 to enforce the minimum character limit
      if (!query || query.trim().length < 3) {
        setCglSearch({ loadingId: null, options: [] });
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));

      try {
        const response = await callApi(
          `/JS/cgl-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("CGL search failed.", "error");
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const handleSubmit = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }


    setIsSubmitting(true);

    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${year}-${month}-${day}`;


    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch ||
        !row.currency ||
        !row.cgl ||
        !row.amount ||
        parseFloat(row.amount) === 0 ||
        !row.txnType ||
        !isRowRemarksValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has a zero amount. Amount must be greater than 0, and remarks must be 2-30 characters.`,
          "error"
        );
        setIsSubmitting(false);
        return;
      }


      const branchCode = row.branch.code;
      const branchName = row.branch.name;
      const currency = row.currency;

      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (
        row.amount || "0"
      ).split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, {
          totalDebit: 0n,
          totalCredit: 0n,
          branchName: branchName,
          branchCode: branchCode,
          currency: currency,
          type: type,
        });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {
        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, {
          hasDebit: false,
          hasCredit: false,
          branchName: branchName,
        });
      }
      const branchCheck = branchEntryCheck.get(branchCode);

      if (row.txnType === "Debit" && amountAsBigInt > 0n) {
        branchCheck.hasDebit = true;
      } else if (row.txnType === "Credit" && amountAsBigInt > 0n) {
        branchCheck.hasCredit = true;
      }

      const finalAmount =
        row.txnType === "Credit" ? "-" + row.amount : row.amount;

      rowPayloads.push({
        branch: row.branch.code,
        currency: row.currency,
        cgl: row.cgl.cglNumber,
        amount: finalAmount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        postingDate: formattedBackendDate
      });
    }

    for (const [branchCode, totals] of branchEntryCheck.entries()) {
      const { hasDebit, hasCredit } = totals;
      if (!hasDebit || !hasCredit) {
        showSnackBar("Branch must have at least one Debit and one Credit entry.", "error");
        setIsSubmitting(false);
        return;
      }
    }


    for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
      const { totalDebit, totalCredit } = totals;

      if (totalDebit !== totalCredit) {
        showSnackBar("Branch and Currency Debit/Credit Mismatch for Real/Memo CGL.", "error");
        setIsSubmitting(false);
        return;
      }
    }


    const finalPayload = {
      commonBatchRemarks: commonBatchRemarks.trim(),
      rows: rowPayloads,
    };

    try {
      const response = await callApi(
        "/JS/journals/create-batch",
        finalPayload,
        "POST"
      );

      const newBatchId = response?.[0]?.batchId || "N/A";

      showSnackBar(
        "Your Request has been initiated. You will be Notified once the Batch is Created/Failed.",
        "info"
      );

      setRows([{ ...initialRowState, id: Date.now() }]);
      setCommonBatchRemarks("");
      setChecked(false);
      setBranchInputValues({});
      setCglInputValues({});
    } catch (error) {
      // If it fails instantly (e.g. server down, bad network), show an error snackbar
      const errMsg = error?.response?.data?.message || error.message || "System error occurred.";
      showSnackBar(`Failed to initiate request: ${errMsg}`, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  const onSubmit = async (data) => {
    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${year}-${month}-${day}`;

    const rowPayloads = data.rows.map(row => ({
      branch: row.branch.code,
      currency: row.currency,
      cgl: row.cgl.cglNumber,
      amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
      productType: row.productCode || "",
      remarks: row.remarks,
      arFlag: "A",
      postingDate: formattedBackendDate
    }));

    try {
      await callApi("/JS/journals/create-batch", { commonBatchRemarks: data.commonBatchRemarks?.trim() || "", rows: rowPayloads }, "POST");
      showSnackBar("Your Request has been initiated. You will be Notified once the Batch is Created/Failed.", "info");
      reset({ commonBatchRemarks: "", applyToAll: false, rows: [initialRowState] });
      setBranchInputValues({});
      setCglInputValues({});
    } catch (error) {
      showSnackBar(`Failed to initiate request: ${error?.response?.data?.message || error.message}`, "error");
    }
  };



  if (isPageLoading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '80vh' }}>
        <CircularProgress size={60} />
      </Box>
    );
  }
  if (isEodRunning) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'top', height: '25vh', p: 2, marginBottom: '500px' }}>
        <Paper elevation={4} sx={{ p: 6, textAlign: 'center', borderRadius: 4, }}>
          <Typography variant="h4" color="error" fontWeight="bold" gutterBottom>
            EOD is Currently Running
          </Typography>
          <Typography variant="h6" color="text.secondary" sx={{ mt: 2 }}>
            Journal Posting is temporarily disabled.
          </Typography>
          <Typography variant="body1" color="text.secondary" sx={{ mt: 1 }}>
            Please wait until the End of Day process completes to post new transactions.
          </Typography>
        </Paper>
      </Box>
    );
  }
  return (
    <Box >
      <Box component={Paper} elevation={3} sx={{ p: 2 }}>
        <Box>
          <Box sx={{ display: "flex", alignItems: "center", gap: 0.5 }}>
            <DateRangeTwoToneIcon />
            <Typography variant="h6" fontWeight="500" component="span" sx={{ ml: 0.5 }}>
              Posting Date:
            </Typography>
            <Typography variant="body1" fontWeight="500" component="span">
              {postingDate}
            </Typography>
          </Box>
          <Box>
            <Typography
              component="span"
              sx={{ color: "#ec0101ff", fontSize: "13px" }}
            >
              Note: All Journals will be Posted on this Date
            </Typography>
          </Box>
        </Box>
        <form onSubmit={hookFormSubmit(onSubmit)}>
          <Grid item xs={12} md={12} sx={{ mt: 3, width: "100%" }}>
            <Controller
              name="commonBatchRemarks"
              control={control}
              render={({ field, fieldState }) => (
                <TextField
                  {...field}
                  label="Common Batch Remarks"
                  fullWidth multiline rows={1}
                  onChange={(e) => field.onChange(e.target.value.replace(/[^a-zA-Z0-9 ]/g, ""))}
                  error={!!fieldState.error}
                  helperText={fieldState.error ? fieldState.error.message : "Allowed 2-30 chars (alphabets, numbers)"}
                  inputProps={{ maxLength: 30 }}
                />
              )}
            />
            <Box sx={{ display: "flex", alignItems: "center", mt: 2 }}>
              <FormControlLabel
                control={<Controller name="applyToAll" control={control} render={({ field }) => <Checkbox {...field} checked={field.value} />} />}
                label="Apply this remark to all below transactions"
              />
            </Box>
          </Grid>

          <Box sx={{ mt: 2 }}>
            {fields.map((field, index) => {
              const currentCurrency = getValues(`rows.${index}.currency`);
              const isINR = currentCurrency === "INR";
              const amountRegex = isINR ? /^\d{0,16}(\.\d{0,2})?$/ : /^\d{0,16}(\.\d{0,4})?$/;

              return (
                <React.Fragment key={field.id}>
                  <Grid container spacing={2} alignItems="flex-start">
                    
                    {/* Branch */}
                    <Grid item xs={12} md={3} size={1.8}>
                      <Controller
                        name={`rows.${index}.branch`}
                        control={control}
                        render={({ field: { onChange, value }, fieldState }) => (
                          <>
                            <Autocomplete
                              popupIcon={null} autoHighlight options={branchSearch.options}
                              getOptionLabel={(opt) => opt?.code ? `${opt.code} - ${opt.name}` : ""}
                              value={value} onChange={(_, newVal) => onChange(newVal)}
                              inputValue={branchInputValues[field.id] || ""}
                              onInputChange={(_, newInputValue, reason) => {
                                if (reason === 'input') {
                                  const cleanInput = newInputValue.replace(/[^0-9]/g, "").substring(0, 5);
                                  setBranchInputValues(prev => ({ ...prev, [field.id]: cleanInput }));
                                  searchBranches(cleanInput, index);
                                } else {
                                  setBranchInputValues(prev => ({ ...prev, [field.id]: newInputValue }));
                                }
                              }}
                              loading={branchSearch.loadingId === index}
                              isOptionEqualToValue={(opt, val) => opt?.code === val?.code}
                              noOptionsText={(branchInputValues[field.id] || "").length < 3 ? "Please enter at least 3 digits" : "No Branch found"}
                              renderInput={(params) => (
                                <Tooltip title="Search by Branch Code" placement="top-start">
                                  <TextField {...params} label="Branch *" placeholder="Enter branch code..." InputLabelProps={{ shrink: true }} error={!!fieldState.error}
                                    InputProps={{ ...params.InputProps, endAdornment: (<Box>{branchSearch.loadingId === index ? <CircularProgress color="inherit" size={20} /> : null}{params.InputProps.endAdornment}</Box>) }} />
                                </Tooltip>
                              )}
                            />
                            <Typography variant="caption" sx={{ fontSize: "0.65rem", color: fieldState.error ? "error.main" : "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                              {fieldState.error ? fieldState.error.message : "Min 3 Digits required"}
                            </Typography>
                          </>
                        )}
                      />
                    </Grid>

                    {/* Currency */}
                    <Grid item xs={12} md={1.5} size={1.5}>
                      <Controller
                        name={`rows.${index}.currency`}
                        control={control}
                        render={({ field: { onChange, value }, fieldState }) => (
                          <TextField select label="Currency *" value={value}
                            onChange={(e) => { onChange(e.target.value); setValue(`rows.${index}.amount`, "", { shouldValidate: true }); }}
                            fullWidth error={!!fieldState.error} helperText={fieldState.error?.message} InputLabelProps={{ shrink: true }}
                            SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Select Currency</span> : selected }}
                          >
                            {currencyOptions.map(c => <MenuItem key={c} value={c}>{c}</MenuItem>)}
                          </TextField>
                        )}
                      />
                    </Grid>

                    {/* CGL */}
                    <Grid item xs={12} md={2} size={1.8}>
                      <Controller
                        name={`rows.${index}.cgl`}
                        control={control}
                        render={({ field: { onChange, value }, fieldState }) => (
                          <>
                            <Autocomplete
                              popupIcon={null} autoHighlight options={cglSearch.options}
                              getOptionLabel={(opt) => opt?.cglNumber ? `${opt.cglNumber} - ${opt.description}` : ""}
                              value={value} onChange={(_, newVal) => onChange(newVal)}
                              inputValue={cglInputValues[field.id] || ""}
                              onInputChange={(_, newInputValue, reason) => {
                                if (reason === 'input') {
                                  const cleanInput = newInputValue.replace(/[^0-9]/g, "").substring(0, 10);
                                  setCglInputValues(prev => ({ ...prev, [field.id]: cleanInput }));
                                  searchCgls(cleanInput, index);
                                } else {
                                  setCglInputValues(prev => ({ ...prev, [field.id]: newInputValue }));
                                }
                              }}
                              loading={cglSearch.loadingId === index}
                              isOptionEqualToValue={(opt, val) => opt?.cglNumber === val?.cglNumber}
                              noOptionsText={(cglInputValues[field.id] || "").length < 3 ? "Type at least 3 digits..." : "CGL not found"}
                              renderInput={(params) => (
                                <Tooltip title="Search by CGL Number" placement="top-start">
                                  <TextField {...params} label="CGL *" placeholder="Search CGL number..." InputLabelProps={{ shrink: true }} error={!!fieldState.error}
                                    InputProps={{ ...params.InputProps, endAdornment: (<Box sx={{ ml: "2%", display: "flex", alignItems: "center" }}>
                                        {value && String(value.cglNumber).startsWith("5") && <Chip label="MEMO" size="small" color="warning" sx={{ height: 20, fontSize: "0.7rem", mr: 1 }} />}
                                        {cglSearch.loadingId === index ? <CircularProgress size={20} /> : null}{params.InputProps.endAdornment}</Box>) }} />
                                </Tooltip>
                              )}
                            />
                            <Typography variant="caption" sx={{ fontSize: "0.65rem", color: fieldState.error ? "error.main" : "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                              {fieldState.error ? fieldState.error.message : "Min 3 digits required"}
                            </Typography>
                          </>
                        )}
                      />
                    </Grid>

                    {/* Amount */}
                    <Grid item xs={12} md={2} size={1.5}>
                      <Controller
                        name={`rows.${index}.amount`}
                        control={control}
                        render={({ field: { onChange, value }, fieldState }) => (
                          <>
                            <TextField label="Amount *" type="text" value={value} disabled={!currentCurrency}
                              onChange={(e) => {
                                const rawVal = e.target.value.replace(/[^0-9.]/g, "");
                                if (rawVal === "" || amountRegex.test(rawVal)) onChange(rawVal);
                                else showSnackBar("Exceeded max digits", "warning");
                              }}
                              fullWidth error={!!fieldState.error}
                              placeholder={isINR ? "0.00" : "0.0000"} inputProps={{ style: { textAlign: "right" } }} InputLabelProps={{ shrink: true }}
                            />
                            <Typography variant="caption" sx={{ fontSize: "0.65rem", color: fieldState.error ? "error.main" : "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                              {fieldState.error ? fieldState.error.message : (!currentCurrency ? "Select Currency" : isINR ? "Max 16 digits, 2 decimals" : "Max 16 digits, 4 decimals")}
                            </Typography>
                          </>
                        )}
                      />
                    </Grid>

                    {/* Txn Type */}
                    <Grid item xs={12} md={1} size={1.3}>
                      <Controller
                        name={`rows.${index}.txnType`}
                        control={control}
                        render={({ field, fieldState }) => (
                          <TextField select {...field} label="Type *" fullWidth error={!!fieldState.error} helperText={fieldState.error?.message} InputLabelProps={{ shrink: true }}
                             SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : selected }}>
                            <MenuItem value="Debit">Debit</MenuItem>
                            <MenuItem value="Credit">Credit</MenuItem>
                          </TextField>
                        )}
                      />
                    </Grid>

                    {/* Product Code */}
                    <Grid item xs={12} md={2} size={1.5}>
                      <Controller
                        name={`rows.${index}.productCode`}
                        control={control}
                        render={({ field, fieldState }) => (
                          <>
                            <TextField {...field} label="Product Code" placeholder="Enter Product Code.." fullWidth error={!!fieldState.error} InputLabelProps={{ shrink: true }}
                              onChange={(e) => field.onChange(e.target.value.replace(/[^0-9]/g, "").substring(0, 8))} />
                            <Typography variant="caption" sx={{ fontSize: "0.65rem", color: fieldState.error ? "error.main" : "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                              {fieldState.error ? fieldState.error.message : "Max 8 digits (numbers)"}
                            </Typography>
                          </>
                        )}
                      />
                    </Grid>

                    {/* Remarks */}
                    <Grid item xs={12} md={2} size={2}>
                      <Controller
                        name={`rows.${index}.remarks`}
                        control={control}
                        render={({ field, fieldState }) => (
                          <>
                            <TextField {...field} label="Remarks *" placeholder="Enter remarks..." fullWidth disabled={applyToAll} error={!!fieldState.error} InputLabelProps={{ shrink: true }}
                              onChange={(e) => field.onChange(e.target.value.replace(/[^a-zA-Z0-9 ]/g, ""))} inputProps={{ maxLength: 30 }} />
                            <Typography variant="caption" sx={{ fontSize: "0.65rem", color: fieldState.error ? "error.main" : "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                              {fieldState.error ? fieldState.error.message : "Allowed 2-30 chars"}
                            </Typography>
                          </>
                        )}
                      />
                    </Grid>

                    {/* Delete Action */}
                    <Grid item xs={12} md={0.5} sx={{ textAlign: "center" }}>
                      <Tooltip title="Delete row" arrow>
                        <IconButton onClick={() => fields.length > 1 ? remove(index) : showSnackBar("Cannot delete last row.", "warning")}
                          sx={{ "&:hover": { color: "error.main", backgroundColor: "rgba(211, 47, 47, 0.04)" } }}>
                          <DeleteIcon />
                        </IconButton>
                      </Tooltip>
                    </Grid>

                  </Grid>
                  {index < fields.length - 1 && <Box sx={{ borderBottom: 1, borderColor: "divider", my: 2 }} />}
                </React.Fragment>
              );
            })}

            {/* --- ZOD LIVE MATH WARNINGS --- */}
            {errors.root?.batchMath && (
              <Box sx={{ mt: 2, display: "flex", flexDirection: "column", alignItems: "flex-end" }}>
                {Array.isArray(errors.root.batchMath) ? errors.root.batchMath.map((err, i) => (
                  <Alert key={i} severity="warning" sx={{ mb: 1, width: "fit-content", bgcolor: "#fff4e5", color: "#663c00", border: "1px solid #ffe0b2" }}>{err.message}</Alert>
                )) : (
                  <Alert severity="warning" sx={{ mb: 1, width: "fit-content", bgcolor: "#fff4e5", color: "#663c00", border: "1px solid #ffe0b2" }}>{errors.root.batchMath.message}</Alert>
                )}
              </Box>
            )}

            <Box sx={{ mt: 3, display: "flex", gap: 2, justifyContent: "right" }}>
              <Button variant="contained" startIcon={<AddIcon />} onClick={() => append(initialRowState)}>Add Row</Button>
              <Button type="submit" variant="contained" color="success" disabled={isSubmitting || !isValid || !!errors.root?.batchMath}>
                {isSubmitting ? <CircularProgress size={24} /> : "Submit"}
              </Button>
            </Box>
          </Box>
        </form>
      </Box>
    </Box>
  );
}



