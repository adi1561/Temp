@Query(value = """
            SELECT
            RV.ID,
            RV.VID,

            RV.CATEGORY_ID,
            VC.CATEGORY_NAME,

            RV.ALLOWED_ROLE,
            R.ROLE_NAME,

            RV.DESCRIPTION,
            RV.SD_REQ_NO,

            RV.CREATED_BY,
            U.FIRST_NAME,

            RV.CREATED_AT,

            RV.TERMINATED_BY,
            RV.TERMINATED_AT,

            RV.STATUS,
            RV.REMARKS

            FROM REQUEST_VOUCHER RV

            LEFT JOIN VOUCHER_CATEGORY VC
            ON RV.CATEGORY_ID = VC.ID

            LEFT JOIN ROLES R
            ON RV.ALLOWED_ROLE = R.ROLE_ID

            LEFT JOIN USERS U
            ON RV.CREATED_BY = U.USER_ID

            WHERE

            (:status IS NULL
            OR :status = 'ALL'
            OR RV.STATUS = :status)

            AND (:categoryId IS NULL
            OR RV.CATEGORY_ID = :categoryId)

            AND (:allowedRole IS NULL
            OR RV.ALLOWED_ROLE = :allowedRole)

            AND (:vid IS NULL
            OR LOWER(RV.VID)
            LIKE LOWER('%' || :vid || '%'))

            AND (:description IS NULL
            OR LOWER(RV.DESCRIPTION)
            LIKE LOWER('%' || :description || '%'))

            AND (:sdReqNo IS NULL
            OR LOWER(RV.SD_REQ_NO)
            LIKE LOWER('%' || :sdReqNo || '%'))

            AND (:createdBy IS NULL
            OR LOWER(RV.CREATED_BY)
            LIKE LOWER('%' || :createdBy || '%'))

            AND (
                    :startDate IS NULL
                    OR (
                    RV.CREATED_AT >= :startDate
                    AND RV.CREATED_AT < :endDate
                    )
            )

            ORDER BY RV.CREATED_AT DESC
            """, nativeQuery = true)
    List<Object[]> searchVid(
            @Param("status") String status,
            @Param("categoryId") Long categoryId,
            @Param("allowedRole") Long allowedRole,
            @Param("vid") String vid,
            @Param("description") String description,
            @Param("sdReqNo") String sdReqNo,
            @Param("createdBy") String createdBy,
            @Param("startDate") Timestamp startDate,
            @Param("endDate") Timestamp endDate);
			
			
			
			
			@Override
        public List<RequestVidResponseDto> searchVid(
                        String status,
                        Long categoryId,
                        Long allowedRole,
                        String vid,
                        String description,
                        String sdReqNo,
                        String createdBy,
                        LocalDate date) {

                Timestamp startDate = null;
                Timestamp endDate = null;

                if (date != null) {

                        startDate = Timestamp.valueOf(date.atStartOfDay());

                        endDate = Timestamp.valueOf(
                                        date.plusDays(1)
                                                        .atStartOfDay());
                }

                List<Object[]> records = requestVidRepository.searchVid(
                                status,
                                categoryId,
                                allowedRole,
                                vid,
                                description,
                                sdReqNo,
                                createdBy,
                                startDate,
                                endDate);

                List<RequestVidResponseDto> response = records.stream()
                                .map(r -> new RequestVidResponseDto(

                                                ((Number) r[0]).longValue(),
                                                (String) r[1],

                                                r[2] != null
                                                                ? ((Number) r[2]).longValue()
                                                                : null,
                                                (String) r[3],

                                                r[4] != null
                                                                ? ((Number) r[4]).longValue()
                                                                : null,
                                                (String) r[5],

                                                (String) r[6],
                                                (String) r[7],

                                                (String) r[8],
                                                (String) r[9],

                                                r[10] != null ? r[10].toString() : null,

                                                (String) r[11],
                                                r[12] != null ? r[12].toString()
                                                                : null,

                                                (String) r[13],
                                                (String) r[14],

                                                null))
                                .toList();

                List<Long> voucherIds = response.stream()
                                .map(RequestVidResponseDto::getId)
                                .toList();

                if (voucherIds.isEmpty()) {

                        return response;
                }

                List<Object[]> issueResults = requestVoucherIssueCategoryRepository
                                .getIssueCategoriesByVoucherIds(
                                                voucherIds);

                Map<Long, String> issueCategoryMap = new HashMap<>();

                for (Object[] row : issueResults) {

                        issueCategoryMap.put(
                                        ((Number) row[0]).longValue(),
                                        (String) row[1]);
                }

                response.forEach(dto -> dto.setIssueCategories(
                                issueCategoryMap.get(dto.getId())));

                return response;
        }
		
		
