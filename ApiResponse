export default function JournalAuthorization() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState([]);
  const [detailTotalCount, setDetailTotalCount] = useState(0);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [selectedBatch, setSelectedBatch] = useState(null);
  const [modalMode, setModalMode] = useState("ACCEPTED");
  const [executorRemarks, setExecutorRemarks] = useState("");
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [batchDetails, setBatchDetails] = useState([]);
  const [viewingBatch, setViewingBatch] = useState(null);
  const [isScheduleLapseModalOpen, setIsScheduleLapseModalOpen] = useState(false);
  const [newScheduleTime, setNewScheduleTime] = useState("");
  const [detailLoading, setDetailLoading] = useState(false);
  const [viewingBatchId, setViewingBatchId] = useState(null);
  const [viewingBatchCreatorId, setViewingBatchCreatorId] = useState(null);
  const [viewingBatchState, setViewingBatchState] = useState("");
  const [dynamicSteps, setDynamicSteps] = useState([]);
  const [dbRoleMap, setDbRoleMap] = useState({});
  const [isFetchingSteps, setIsFetchingSteps] = useState(false);
  const [vidDetails, setVidDetails] = useState(null);
  const [isFetchingVid, setIsFetchingVid] = useState(false);
  const [workflowHistory, setWorkflowHistory] = useState([]);
    const [isDescExpanded, setIsDescExpanded] = useState(false);
  const handleDownloadExcel = async () => {

    if (!viewingBatchId) {
      showSnackBar("Error: Batch ID is missing!", "error");
      return;
    }

    try {
      showSnackBar("Downloading Excel...", "info");

      const response = await callApi(
        `/JS/voucher/download-batch/${viewingBatchId}`,
        null,
        "GET",
        "blob",
        null,
        {},
        false
      );

      const blobData = response.data || response;
      if (!blobData) {
        throw new Error("No data received from backend");
      }

      const blob = new Blob([blobData], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
      const url = window.URL.createObjectURL(blob);

      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", `Batch_${viewingBatchId}.xlsx`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
      showSnackBar("Download complete.", "success");
    } catch (e) {
      console.error("Download failed:", e);
      let errorMsg = "Failed to download Excel file.";
      if (e.response && e.status === 404) {
        errorMsg = "API endpoint not found (404).";
      }
      showSnackBar(errorMsg, "error");
    }
  };

  const CustomWorkflowIcon = (props) => {
    const { active, completed } = props;

    if (completed) {
      // 1. PAST STEPS (Done): Solid Filled Green Circle with a White Tick
      return (
        <Box sx={{
          width: 24, height: 24, borderRadius: '50%',
          backgroundColor: 'success.main', // Solid filled green background
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          zIndex: 1
        }}>
          {/* Changed the tick to white (#fff) so it stands out against the solid green */}
          <CheckIcon sx={{ color: '#fff', fontSize: 16, strokeWidth: 1 }} />
        </Box>
      );
    }

    if (active) {
      // 2. CURRENT STEP (Waiting): Solid Blue Circle with light-blue halo
      return (
        <Box sx={{
          width: 24, height: 24, borderRadius: '50%',
          backgroundColor: 'primary.main',
          border: '4px solid', borderColor: '#e3f2fd',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          zIndex: 1
        }} />
      );
    }

    // 3. FUTURE STEPS: Simple grey dot
    return (
      <Box sx={{
        width: 12, height: 12, borderRadius: '50%',
        backgroundColor: 'text.disabled', zIndex: 1, m: '6px'
      }} />
    );
  };

  useEffect(() => {
    isMounted.current = true;
    try {
      const auth =
        sessionStorage.getItem("persist:auth") ||
        localStorage.getItem("persist:auth");
      if (auth) {
        const user = JSON.parse(JSON.parse(auth).user);
        if (user?.userId) setCurrentUserId(String(user.userId));
      }
    } catch (e) { }
    return () => {
      isMounted.current = false;
    };
  }, []);

  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphanumeric and / & ( ) , . - are allowed.";

    if (type === "alphanumeric_space") {
      // 1. Strip any character that is NOT alphanumeric or in the allowed special chars list
      filtered = val.replace(/[^a-zA-Z0-9 ]/g, "");
      if (filtered !== val) {
        hasError = true;
      }

      // 2. Strip leading space and collapse double spaces (enforces the (?!.* {2}) regex rule)
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Remark should not start with space or contain consecutive spaces.";
      }
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }
    return filtered;
  };
  const handleRemarksChange = (e, setter) => {
    const val = filterAndWarn(e.target.value, "alphanumeric_space");
    if (val.length <= 30) {
      setter(val);
    }
  };

  // Validation logic: Remarks are strictly compulsory (min 2, max 30)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  const isViewingSelfCreated =
    currentUserId &&
    viewingBatchCreatorId &&
    String(currentUserId).trim().toUpperCase() ===
    String(viewingBatchCreatorId).trim().toUpperCase();

  const isLargeBatch = detailTotalCount > 2000;

  const fetchPendingBatches = useCallback(async () => {
    setLoading(true);
    try {
      const data = await callApi(
        "/JS/voucher/checker/pending-approvals",
        null,
        "GET"
      );
      if (isMounted.current) setRows(Array.isArray(data) ? data : []);
    } catch (err) {
      if (isMounted.current && err.name !== "CanceledError")
        showSnackBar("Failed to load requests", "error");
    } finally {
      if (isMounted.current) setLoading(false);
    }
  }, [callApi, showSnackBar]);

  useEffect(() => {
    const fetchRoles = async () => {
      try {
        // Fetch the { "9001": "TCSGLIF" } map from our new API
        const rolesData = await callApi("/JS/voucher/active-roles", null, "GET");
        if (rolesData && isMounted.current) {
          setDbRoleMap(rolesData);
        }
      } catch (err) {
        console.error("Failed to fetch roles mapping", err);
      }
    };
    fetchRoles();
  }, [callApi]);

  useEffect(() => {
    fetchPendingBatches();
  }, [fetchPendingBatches]);



  const fetchBatchDetailsPaginated = async (batchId, page, size) => {
    setDetailLoading(true);
    try {
      const res = await callApi(
        `/JS/voucher/by-batch-paginated/${batchId}?page=${page}&size=${size}`,
        null,
        "GET"
      );

      const contentArray = res?.content || (Array.isArray(res) ? res : []);

      if (contentArray && isMounted.current) {
        setDetailTotalCount(res?.totalElements || contentArray.length || 0);
        const journalGroups = new Map();

        contentArray.forEach((req, index) => {
          try {
            console.log("Backend Row Data in Authorization:", req);

            const jId = req.journalId || req.id || `UNKNOWN-${index}`;
            const prefix = String(jId).split("-")[0];

            const amountVal = parseFloat(req.amount || req.reqAmount) || 0;

            const row = {
              ...req,
              journalPrefix: prefix, // Save the distinct prefix
              amount: Math.abs(amountVal),
              transactionType: amountVal < 0 ? "Credit" : "Debit",
              branch: req.branchCode || req.reqBranchCode || "-",
              currency: req.currency || req.reqCurrency || "-",
              cgl: req.cgl || req.reqCgl || "-",
              remarks: req.narration || req.reqNarration || "-",
              product: req.productCode || req.reqProduct || "-",
            };

            // FIX: Group explicitly by Branch!
            if (!journalGroups.has(prefix)) journalGroups.set(prefix, []);
            journalGroups.get(prefix).push(row);

          } catch (e) {
            console.error("Failed to map row details:", req, e);
          }
        });
        setBatchDetails(Array.from(journalGroups.values()));
      }
    } catch (e) {
      if (isMounted.current) showSnackBar("Failed to load details", "error");
    } finally {
      if (isMounted.current) setDetailLoading(false);
    }
  };
 const handleOpenViewModal = async (row) => {
    setViewingBatch(row);
    setViewingBatchId(row.batchId);
    setViewingBatchCreatorId(String(row.creatorId));
    setViewingBatchState(row.workflowState || "PENDING_L1");

    setIsViewModalOpen(true);
    setIsFetchingSteps(true);
    setIsFetchingVid(true);

    try {
      const workflowCode = row.approvalWorkflow || "Workflow_3";
      
      // FETCH ALL 3 APIS CONCURRENTLY!
      const [stepsData, summaryData, historyData] = await Promise.all([
        callApi(`/JS/voucher/workflow/steps/${workflowCode}`, null, "GET"),
        callApi(`/JS/voucher/batch-summary/${row.batchId}`, null, "GET"),
        callApi(`/JS/voucher/workflow-history/${row.batchId}`, null, "GET") // <-- NEW API
      ]);
      
      setDynamicSteps(Array.isArray(stepsData) ? stepsData : []);
      setVidDetails(summaryData); 
      setWorkflowHistory(Array.isArray(historyData) ? historyData : []); // <-- SAVE HISTORY
    } catch (err) {
      showSnackBar("Failed to load batch details.", "error");
    } finally {
      setIsFetchingSteps(false);
      setIsFetchingVid(false);
    }
  };

  const handleDetailRowsPerPageChange = (event) => {
    const newSize = parseInt(event.target.value, 10);
    setDetailRowsPerPage(newSize);
    setDetailPage(0);
    fetchBatchDetailsPaginated(viewingBatchId, 0, newSize);
  };


  const getRoleDisplayName = (roleValue) => {
    if (!roleValue || roleValue === "null" || roleValue === "System") return "System Execution";

    // Now it looks inside the dynamic DB map instead of a hardcoded one!
    return dbRoleMap[String(roleValue)] || roleValue;
  };
  const calculateTimeElapsed = (startDateString) => {
    if (!startDateString) return "N/A";
    const start = new Date(startDateString);
    const now = new Date();

    const diffMs = Math.abs(now - start);
    const diffMins = Math.floor(diffMs / 60000);

    if (diffMins === 0) return "Just now";
    if (diffMins < 60) return `${diffMins} min`;

    const hours = Math.floor(diffMins / 60);
    const mins = diffMins % 60;
    return mins > 0 ? `${hours} hr ${mins} min` : `${hours} hr`;
  };

  const handleCloseViewModal = () => {
    setIsViewModalOpen(false);
    setBatchDetails([]);
    setViewingBatchId(null);
    setViewingBatchCreatorId(null);
    setIsDescExpanded(false);
    fetchPendingBatches();
  };

  const handleOpenModal = (batch, mode) => {
    setSelectedBatch(batch);
    setModalMode(mode);
    setExecutorRemarks("");
    setIsModalOpen(true);
  };

  const handleCloseModal = () => {
    if (isSubmitting) return;
    setIsModalOpen(false);
    setSelectedBatch(null);
  };
  const handleSubmitAction = async (overrideLapse = false) => {
    if (!isRemarksValid(executorRemarks)) {
      showSnackBar("Remarks are compulsory (2-30 chars).", "warning");
      return;
    }
    setIsSubmitting(true);

    // Format the new schedule time if they provided one during a lapse override
    let formattedNewSchedule = null;
    if (overrideLapse && newScheduleTime) {
      const dateObj = new Date(newScheduleTime);
      formattedNewSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    try {
      const response = await callApi(
        "/JS/voucher/workflow/action", // <-- NEW ENDPOINT
        {
          batchId: selectedBatch.batchId,
          status: modalMode,
          remarks: executorRemarks.trim(),
          overrideScheduleLapse: overrideLapse,
          newScheduledTime: formattedNewSchedule
        },
        "POST"
      );

      showSnackBar(response?.message || "Workflow action processed successfully.", "success");

      handleCloseModal();
      setIsScheduleLapseModalOpen(false);
      setNewScheduleTime("");
      fetchPendingBatches();

    } catch (e) {
      // --- CATCH THE SCHEDULE LAPSE EDGE CASE ---
      if (e.response && e.response.status === 409) {
        setIsScheduleLapseModalOpen(true);
        setIsModalOpen(false); // Hide the standard modal
        setIsSubmitting(false);
        return;
      }

      let errorMsg = "Failed to process request.";
      if (e.response?.data?.message) {
        errorMsg = e.response.data.message;
      } else if (e.message) {
        errorMsg = e.message;
      }
      showSnackBar(errorMsg, "error");
    } finally {
      setIsSubmitting(false);
    }
  };


  const columns = [
    {
      field: "batchId",
      headerName: "Batch ID",
      width: 125,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
    }, {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        const workflow = params.row.approvalWorkflow || "Workflow_3";
        const isRejected = state === "REJECTED";

        if (isRejected) {
          return (
            <Box sx={{ pl: 2, width: '100%', display: 'flex', justifyContent: 'flex-start' }}>
              <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />
            </Box>
          );
        }

        let stepLabels = ['L1', 'L2', 'L3', 'Final'];
        if (workflow === 'Workflow_4' || workflow === 'W2_4_APPROVERS') {
          stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];
        }

        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        else if (state.includes("L3")) activeStep = 2;
        else if (state.includes("L4")) activeStep = 3;

        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
          activeStep = stepLabels.length;
        }

        return (
          <Box sx={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'flex-start', pl: 2, height: '100%' }}>
            <Stepper
              activeStep={activeStep}
              alternativeLabel
              connector={<CustomConnector />}
              sx={{ width: 'auto', mt: 0.5 }}
            >
              {stepLabels.map((label, index) => {
                // strict < and === logic ensures only past steps get the plain tick
                const isCompleted = index < activeStep;
                const isCurrent = index === activeStep;

                return (
                  <Step
                    key={label}
                    completed={isCompleted}
                    active={isCurrent}
                    sx={{ flex: '0 0 40px', px: 0 }}
                  >
                    {/* Apply the Custom Icon here! */}
                    <StepLabel StepIconComponent={CustomWorkflowIcon} sx={{ p: 0, m: 0 }} />
                  </Step>
                );
              })}
            </Stepper>
          </Box>
        );
      },
    },

    {
      field: "creatorId",
      headerName: "Creator",
      width: 150,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (p) => (
        <Chip icon={<AccountCircleIcon />} label={p.value} size="small" />
      ),
    },
    {
      field: "requestDate",
      headerName: "Submitted On",
      width: 200,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (p) =>
        new Date(p.value).toLocaleString("en-IN", {
          dateStyle: "medium",
          timeStyle: "short",
        }),
    },

    {
      field: "requestCount",
      headerName: "No. of Entries",
      width: 220,  // Increased width to ensure visibility
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
    },

    {
      field: "actions",
      headerName: "Actions",
      flex: 1,
      minWidth: 150,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const isSelf =
          currentUserId &&
          params.row.creatorId &&
          String(currentUserId).trim().toUpperCase() ===
          String(params.row.creatorId).trim().toUpperCase();

        const state = params.row.workflowState || "";

        // FIX: Check if the workflow is fully completed or rejected
        const isDoneOrRejected = state === "POSTED" || state === "SCHEDULED" || state === "APPROVED" || state === "REJECTED";

        // Disable the buttons if it's the user's own batch OR if the process is already done
        const isActionDisabled = isSelf || isDoneOrRejected;

        return (
          <Stack direction="row" spacing={1} justifyContent="center">
            <Tooltip title="View Detailed Status">
              <IconButton onClick={() => handleOpenViewModal(params.row)} color="primary">
                <VisibilityIcon />
              </IconButton>
            </Tooltip>
            <Tooltip title={isActionDisabled ? "Action unavailable" : "Accept"}>
              <span>
                <IconButton
                  onClick={() => handleOpenModal(params.row, "ACCEPTED")}
                  color="success"
                  disabled={isActionDisabled}
                >
                  <CheckIcon />
                </IconButton>
              </span>
            </Tooltip>
            <Tooltip title={isActionDisabled ? "Action unavailable" : "Reject"}>
              <span>
                <IconButton
                  onClick={() => handleOpenModal(params.row, "REJECTED")}
                  color="error"
                  disabled={isActionDisabled}
                >
                  <ClearIcon />
                </IconButton>
              </span>
            </Tooltip>
          </Stack>
        );
      },
    },
  ];

  return (
    <Box sx={styles.mainContainer}>
      <DataGrid
        rows={rows}
        columns={columns}
        loading={loading}
        getRowId={(row) => row.batchId}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25]}
        disableColumnResize
        rowHeight={52}
        initialState={{
          pagination: { paginationModel: { page: 0, pageSize: 10 } },
        }}
        slots={{ noRowsOverlay: CustomNoRowsOverlay }}
        sx={styles.dataGridContainer}
      />

      {/* --- Main Grid Approve/Reject Dialog --- */}

      <Dialog
        open={isModalOpen}
        onClose={handleCloseModal}
        fullWidth
        maxWidth="sm"
      >
        <DialogTitle>
          {modalMode === "ACCEPTED" ? "Accept" : "Reject"} Batch ID
        </DialogTitle>
        <DialogContent>
          <DialogContentText>
            Please provide the remarks to {modalMode === "ACCEPTED" ? "Accept" : "Reject"} Batch ID{" "}
            <strong>{selectedBatch?.batchId}</strong>
          </DialogContentText>
          <TextField
            autoFocus
            required
            margin="dense"
            label="Remarks"
            fullWidth
            variant="standard"
            value={executorRemarks}
            onChange={(e) => handleRemarksChange(e, setExecutorRemarks)}
            disabled={isSubmitting}
            inputProps={{ maxLength: 30 }}
            error={executorRemarks.length > 0 && !isRemarksValid(executorRemarks)}
          />
          <Typography sx={styles.helperText}>
            Allowed 2-30 chars (alphabets, numbers)
          </Typography>
        </DialogContent>
        <DialogActions sx={styles.dialogActions}>
          <Button onClick={handleCloseModal} disabled={isSubmitting}>
            Cancel
          </Button>
          <Button
            onClick={() => handleSubmitAction(false)}
            variant="contained"
            color={modalMode === "ACCEPTED" ? "success" : "error"}
            disabled={isSubmitting || !isRemarksValid(executorRemarks)}
          >
            {isSubmitting ? <CircularProgress size={24} /> : (modalMode === "ACCEPTED" ? "Accept" : "Reject")}
          </Button>
        </DialogActions>
      </Dialog>


      {/* --- Schedule Lapsed Edge Case Modal --- */}
      <Dialog
        open={isScheduleLapseModalOpen}
        onClose={() => setIsScheduleLapseModalOpen(false)}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ color: "error.main", fontWeight: "bold" }}>
          Schedule Lapsed
        </DialogTitle>
        <DialogContent>
          <Alert severity="warning" sx={{ mb: 3 }}>
            The original scheduled execution time for this batch has passed.
          </Alert>
          <Typography variant="body1" gutterBottom>
            Do you want to post this batch <strong>immediately</strong>, or set a <strong>new future schedule</strong>?
          </Typography>

          <Paper elevation={0} sx={{ p: 2, mt: 3, backgroundColor: "action.hover", border: "1px dashed", borderColor: "divider" }}>
            <Typography variant="subtitle2" gutterBottom>Optional: Set New Schedule</Typography>
            <TextField
              type="datetime-local"
              size="small"
              fullWidth
              InputLabelProps={{ shrink: true }}
              value={newScheduleTime}
              onChange={(e) => setNewScheduleTime(e.target.value)}
              inputProps={{ min: new Date().toISOString().slice(0, 16) }}
            />
            <FormHelperText>Leave blank to post immediately upon acceptance.</FormHelperText>
          </Paper>
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button onClick={() => setIsScheduleLapseModalOpen(false)} color="inherit">
            Cancel
          </Button>
          <Button
            onClick={() => handleSubmitAction(true)}
            variant="contained"
            color="primary"
            disabled={isSubmitting}
          >
            {isSubmitting ? <CircularProgress size={20} color="inherit" /> : "Confirm & Proceed"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* --- View Details Modal --- */}
      <Dialog
        open={isViewModalOpen}
        onClose={handleCloseViewModal}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle sx={styles.dialogTitle}>
          <Typography variant="h6" fontWeight="bold">
            Batch Workflow Details: {viewingBatchId}
          </Typography>
          <IconButton onClick={handleCloseViewModal}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>

        <DialogContent dividers sx={{ p: 0, backgroundColor: "#f8fafc" }}>
          {/* Scrollable Container */}
          <Box sx={{ maxHeight: '75vh', overflowY: 'auto', display: "flex", flexDirection: "column" }}>

            {/* ---  HEADER CARDS --- */}
            {/* Increased outer padding to p: 4 for a more spacious look */}
            <Box sx={{ p: 4, backgroundColor: "white", borderBottom: "1px solid", borderColor: "divider" }}>

              {/* --- DYNAMIC DETAILS GRIDS --- */}
              {isFetchingVid ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 4 }}><CircularProgress size={24} /></Box>
              ) : vidDetails && vidDetails.VID ? (
                // Increased spacing between the two main cards to 4
<Grid container spacing={4}>
                  
                  {/* SECTION 1: VOUCHER ORIGIN DETAILS */}
                  <Grid item xs={12} md={6}>
                    <Paper elevation={0} sx={{ p: 3, backgroundColor: "#f8fafc", borderRadius: 2, height: '100%', border: "1px solid #e2e8f0" }}>
                      <Typography variant="subtitle1" fontWeight="bold" color="text.primary" gutterBottom sx={{ borderBottom: "1px solid #cbd5e1", pb: 1, mb: 2 }}>
                        Voucher (VID: {vidDetails.VID})
                      </Typography>
                      <Grid container spacing={3}>
                        <Grid item xs={12} sm={6}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Category</Typography>
                          <Typography variant="body1" fontWeight="500">{vidDetails.CATEGORY_NAME}</Typography>
                        </Grid>
                        <Grid item xs={12} sm={6}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Origin Created At</Typography>
                          <Typography variant="body1" fontWeight="500">
                            {vidDetails.VID_CREATED_AT ? new Date(vidDetails.VID_CREATED_AT).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" }) : "N/A"}
                          </Typography>
                        </Grid>
 <Grid item xs={12}>
                          {/* A dashed line to separate it as a distinct subsection */}
                          <Box sx={{ borderTop: '1px dashed #cbd5e1', pt: 1.5, mt: 1 }}>
                            
                            {/* The Clickable Header */}
                            <Box 
                              onClick={() => setIsDescExpanded(!isDescExpanded)}
                              sx={{ 
                                display: 'flex', 
                                alignItems: 'center', 
                                justifyContent: 'space-between', 
                                cursor: 'pointer',
                                '&:hover': { opacity: 0.8 } // Small hover effect for UX
                              }}
                            >
                              <Typography variant="subtitle2" color="primary.main" fontWeight="bold">
                                View Voucher Description
                              </Typography>
                              <Typography variant="caption" color="primary.main" fontWeight="bold">
                                {isDescExpanded ? "Close ?" : "Expand ?"}
                              </Typography>
                            </Box>

                            {/* The Animated Dropdown Content */}
                            <Collapse in={isDescExpanded}>
                              <Box sx={{ 
                                mt: 1.5, 
                                backgroundColor: '#ffffff', 
                                border: '1px solid #cbd5e1', 
                                borderRadius: 1, 
                                p: 1.5 
                              }}>
                                <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.5 }}>
                                  {vidDetails.DESCRIPTION || "No description provided."}
                                </Typography>
                              </Box>
                            </Collapse>
                            
                          </Box>
                        </Grid>
                        <Grid item xs={12}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Description</Typography>
                          {/* PROFESSIONAL LONG-TEXT SCROLL BOX */}
                          <Box sx={{ 
                            maxHeight: 110, 
                            overflowY: 'auto', 
                            p: 1.5, 
                            backgroundColor: '#ffffff', 
                            border: '1px solid #cbd5e1', 
                            borderRadius: 1,
                            '&::-webkit-scrollbar': { width: '6px' },
                            '&::-webkit-scrollbar-thumb': { backgroundColor: '#cbd5e1', borderRadius: '4px' }
                          }}>
                            <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.5 }}>
                              {vidDetails.DESCRIPTION || "No description provided."}
                            </Typography>
                          </Box>
                        </Grid>
                      </Grid>
                    </Paper>
                  </Grid>

                  

                  {/* SECTION 2: BATCH EXECUTION DETAILS */}
                  <Grid item xs={12} md={6}>
                    <Paper elevation={0} sx={{ p: 3, backgroundColor: "#f8fafc", borderRadius: 2, height: '100%', border: "1px solid #e2e8f0" }}>
                      <Typography variant="subtitle1" fontWeight="bold" color="text.primary" gutterBottom sx={{ borderBottom: "1px solid #cbd5e1", pb: 1, mb: 2 }}>
                        Batch Execution Details
                      </Typography>
                      <Grid container spacing={3}>
                        <Grid item xs={12}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Created By</Typography>
                          <Stack direction="row" spacing={1} alignItems="center">
                            <AccountCircleIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                            {/* Uses the Full Name from the new Database Join */}
                            <Typography variant="body1" fontWeight="500">
                              {vidDetails.BATCH_CREATED_BY_NAME} <Typography component="span" variant="caption" color="text.secondary">({vidDetails.BATCH_CREATOR_ID})</Typography>
                            </Typography>
                          </Stack>
                        </Grid>
                        <Grid item xs={6}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Creator Role</Typography>
                          <Typography variant="body1" fontWeight="500">{vidDetails.CREATORS_ROLE || "N/A"}</Typography>
                        </Grid>
                        <Grid item xs={6}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Created At</Typography>
                          <Typography variant="body1" fontWeight="500">
                             {vidDetails.BATCH_CREATED_AT ? new Date(vidDetails.BATCH_CREATED_AT).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" }) : "N/A"}
                          </Typography>
                        </Grid>
                        <Grid item xs={6}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Scheduled Time</Typography>
                          <Typography variant="body1" fontWeight="500" color={vidDetails.SCHEDULED_TIME ? "info.main" : "text.primary"}>
                             {vidDetails.SCHEDULED_TIME ? new Date(vidDetails.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" }) : "Immediate"}
                          </Typography>
                        </Grid>
                        {vidDetails.EXECUTED_AT && (
                          <Grid item xs={12}>
                            <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Executed At</Typography>
                            <Typography variant="body1" fontWeight="500" color="success.main">
                               {new Date(vidDetails.EXECUTED_AT).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}
                            </Typography>
                          </Grid>
                        )}
                      </Grid>
                    </Paper>
                  </Grid>

                </Grid>

              ) : null}
            </Box>

            {/* --- HORIZONTAL TIMELINE --- */}
            
            <Box sx={{ p: 4, flexGrow: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
              {viewingBatchState === "REJECTED" ? (
                <Alert severity="error" variant="filled" sx={{ mt: 2, fontWeight: "bold" }}>
                  This batch was REJECTED and the workflow has been terminated.
                </Alert>
              ) : isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 3 }}><CircularProgress /></Box>
              ) : dynamicSteps.length > 0 ? (
                <Stepper
                  activeStep={
                    (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED")
                      ? dynamicSteps.length
                      : dynamicSteps.findIndex(s => s.state === viewingBatchState)
                  }
                  alternativeLabel
                  connector={<CustomConnector />}
                >
                  {dynamicSteps.map((step, index) => {
                    const isFullyDone = viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED";
                    const activeStepIndex = isFullyDone ? dynamicSteps.length : dynamicSteps.findIndex(s => s.state === viewingBatchState);

                    const isCompleted = index < activeStepIndex;
                    const isCurrent = index === activeStepIndex;

                    return (
                      <Step key={step.state} completed={isCompleted} active={isCurrent}>
                        <StepLabel StepIconComponent={CustomWorkflowIcon}>
                          <Typography variant="subtitle2" sx={{ fontWeight: isCurrent ? 'bold' : 'normal', color: isCurrent ? 'primary.main' : 'text.primary', mt: 1 }}>
                            {step.designation}
                          </Typography>

                          <Chip
                            label={getRoleDisplayName(step.role)}
                            size="small"
                            variant={isCurrent ? "filled" : "outlined"}
                            color={isCurrent ? "primary" : "default"}
                            sx={{ mt: 1, height: 22, fontSize: "0.65rem", fontWeight: "bold" }}
                          />

                          {/* Keeping the time pending under the active step */}
                          {isCurrent && (
                            <Typography variant="caption" display="block" color="warning.main" fontWeight="bold" sx={{ mt: 1 }}>
                              Pending: {calculateTimeElapsed(viewingBatch?.requestDate)}
                            </Typography>
                          )}
                        </StepLabel>
                      </Step>
                    );
                  })}
                </Stepper>
              ) : (
                <Alert severity="info" sx={{ mt: 2 }}>Workflow configuration not found.</Alert>
              )}
            </Box>
{/* --- WORKFLOW HISTORY / COMMENTS SECTION (FLOWBITE DESIGN) --- */}
            <Box sx={{ p: 4,  borderTop: "1px solid", borderColor: "divider" }}>
              <Typography variant="subtitle1" fontWeight="bold" color="text.primary" sx={{ mb: 3 }}>
                Action History & Remarks ({workflowHistory.length})
              </Typography>
              
              {isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 2 }}><CircularProgress size={24}/></Box>
              ) : workflowHistory.length === 0 ? (
                <Alert severity="info" sx={{ borderRadius: 2 }}>No action history found for this batch.</Alert>
              ) : (
                <Stack spacing={2.5}>
                  {workflowHistory.map((history, idx) => {
                    // Extract initials for the Avatar
                    const userName = history.ACTION_USER_NAME || "User";
                    const initial = userName.charAt(0).toUpperCase();

                    return (
                      <Box key={idx} sx={{ display: 'flex', gap: 2 }}>
                         {/* Avatar Profile Picture */}
                         <Box>
                           <Avatar sx={{ bgcolor: 'primary.main', width: 40, height: 40, fontWeight: 'bold', fontSize: '1rem' }}>
                             {initial}
                           </Avatar>
                         </Box>

                         {/* Comment Card Container */}
                         <Box sx={{ 
                           flexGrow: 1, 
                           backgroundColor: "white", 
                           p: 2.5, 
                           borderRadius: 2, 
                           border: "1px solid", 
                           borderColor: "#e2e8f0",
                           boxShadow: "0 1px 2px 0 rgb(0 0 0 / 0.05)"
                         }}>
                            {/* Header: Name and Date */}
                            <Box sx={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 1, mb: 1 }}>
                              <Typography variant="subtitle2" fontWeight="bold" color="text.primary">
                                {userName}
                              </Typography>
                              <Typography variant="caption" color="text.secondary">
                                • {new Date(history.LAST_ACTION_AT).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}
                              </Typography>
                            </Box>

                            {/* Badge: The Action Taken (e.g. Approved by Verifier) */}
                            <Chip 
                              label={history.LAST_ACTION || "System Action"} 
                              size="small" 
                              sx={{ 
                                mb: 1.5, height: 22, fontSize: "0.7rem", fontWeight: "bold",
                                backgroundColor: history.LAST_ACTION?.includes("Reject") ? "#fee2e2" : "#e0e7ff",
                                color: history.LAST_ACTION?.includes("Reject") ? "#991b1b" : "#3730a3"
                              }} 
                            />

                            {/* Body: The Remarks Text */}
                            <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>
                               {history.REMARKS || "No remarks provided."}
                            </Typography>
                         </Box>
                      </Box>
                    );
                  })}
                </Stack>
              )}
            </Box>
            {/* --- PROFESSIONAL DOWNLOAD FOOTER --- */}
            <Box sx={{ p: 2, backgroundColor: "white", borderTop: "1px solid", borderColor: "divider", display: "flex", justifyContent: "flex-end" }}>
              <Button
                variant="outlined"
                startIcon={<FileDownloadIcon />}
                onClick={handleDownloadExcel}
                disabled={!viewingBatchId}
                sx={{ borderColor: "#217346", color: "#217346", "&:hover": { backgroundColor: "#e8f5e9", borderColor: "#1e6b40" } }}
              >
                Download Full Batch Report
              </Button>
            </Box>

          </Box>
        </DialogContent>
      </Dialog>
    </Box>
  );
}
