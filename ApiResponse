              sx={{ width: "100%", mt: 0.5 }}
            >
              {stepLabels.map((label, index) => {
                const isCompleted = index < activeStep;
                const isCurrent = index === activeStep;

                let statusFlag = "PENDING";
                if (isCompleted) statusFlag = "COMPLETED";
                if (isCurrent && isRejected) statusFlag = "REJECTED";
                else if (isCurrent && isEscalated) statusFlag = "ESCALATED";
                else if (isCurrent) statusFlag = "ACTIVE";

                return (
                  <Tooltip title={label} key={`${label}-${index}`} arrow>
                    {/* Removed the rigid flex width so it perfectly adjusts to the pill size */}
                    <Step
                      completed={isCompleted}
                      active={isCurrent}
                      sx={{
                        px: 0,
                        opacity: isRejected && index > activeStep ? 0.3 : 1,
                      }}
                    >
                      {/* Pass isMini={true} and the label down to the icon */}
                      <StepLabel
                        StepIconComponent={() => (
                          <CustomWorkflowIcon
                            statusFlag={statusFlag}
                            iconLetter={label.charAt(0).toUpperCase()}
                            label={label}
                            isMini={true}
                          />
