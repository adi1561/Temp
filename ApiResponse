### 6. Currency Data Grid Updates (Req 1, 2, 3 & 8)
This removes the icon, forces the dropdown downwards, strips out numbers natively, and adds a tooltip.
```jsx
{/* Currency */}
<Grid item size={{ xl: 1.5, lg: 2 }}>
  <Tooltip title="Type 3 letters to search currency" placement="top-start">
    <Autocomplete
      disableClearable
      autoHighlight
      popupIcon={null} // Req 1: Removes dropdown icon
      options={currencyOptions}
      value={row.currency || null}
      onChange={(event, newValue) => {
        handleRowChange(row.id, "currency", newValue || "");
        handleRowChange(row.id, "amount", "");
      }}
      onKeyDown={(e) => {
        if (e.key === 'Tab' && !row.currency) {
          const inputVal = e.target.value; 
          if (inputVal && inputVal.trim() !== "") {
            const match = currencyOptions.find(c => c.toLowerCase().includes(inputVal.trim().toLowerCase()));
            if (match) {
              handleRowChange(row.id, "currency", match);
              handleRowChange(row.id, "amount", ""); 
            }
          }
        }
      }}
      filterOptions={(options, params) => {
        const { inputValue } = params;
        if (inputValue.trim().length === 0) return [];
        return options.filter((option) =>
          option.toLowerCase().includes(inputValue.toLowerCase())
        );
      }}
      noOptionsText="Type to search..."
      slotProps={{
        popper: { 
          placement: 'bottom-start', // Req 2: Always opens at bottom
          modifiers: [{ name: 'flip', enabled: false }, { name: 'preventOverflow', enabled: false }] 
        }
      }}
      renderInput={(params) => (
        <TextField
          {...params}
          label="Currency *"
          placeholder={!row.currency ? "Search..." : ""}
          InputLabelProps={{ shrink: true }}
          onInput={(e) => {
            // Req 3: Disable numbers instantly on keystroke
            e.target.value = e.target.value.replace(/[^A-Za-z]/g, '');
          }}
          inputProps={{
            ...params.inputProps,
            maxLength: 3,
            style: { textTransform: 'uppercase' }
          }}
        />
      )}
    />
  </Tooltip>
</Grid>

```
