                        <Button
                          variant="contained"
                          color={actionSelection === 'ACCEPTED' ? 'success' : 'error'}
                          disabled={!isRemarksValid(executorRemarks) || isSubmitting || (actionSelection === 'ACCEPTED' && viewingBatch?.isFinalApproval === 'Y' && scheduleOverrideType === "OVERRIDE" && !finalScheduleTime)}
                          onClick={() => {
                            const isOverriding = actionSelection === 'ACCEPTED' && viewingBatch?.isFinalApproval === 'Y' && scheduleOverrideType === "OVERRIDE";
                            handleSubmitAction(actionSelection, isOverriding);
                          }}
                          sx={{ minWidth: 160, fontWeight: 'bold', py: 1 }}
                        >
                          {isSubmitting ? <CircularProgress size={20} color="inherit" /> : "Confirm & Submit"}
                        </Button>
                      </>
                    )}
                  </Stack>
                </>
              );
            })()}
          </DialogActions>
        </Dialog>

      </Box>
    </Paper>
  );
