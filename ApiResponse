import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public byte[] generateExcelTemplateWithGuidelines() throws IOException {
    try (Workbook workbook = new XSSFWorkbook()) {
        
        // ==============================================================================
        // SHEET 1: GUIDELINES & VALIDATION STAGES
        // ==============================================================================
        Sheet guidelineSheet = workbook.createSheet("Upload Guidelines");
        guidelineSheet.setColumnWidth(0, 12000); // Clean, comfortable spacing
        guidelineSheet.setColumnWidth(1, 24000);

        // Define Professional Header Font & Styles
        Font headerFont = workbook.createFont();
        headerFont.setBold(true);
        headerFont.setColor(IndexedColors.WHITE.getIndex());
        headerFont.setFontHeightInPoints((short) 11);
        
        CellStyle headerStyle = workbook.createCellStyle();
        headerStyle.setFillForegroundColor(IndexedColors.NAVY.getIndex());
        headerStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);
        headerStyle.setFont(headerFont);
        headerStyle.setAlignment(HorizontalAlignment.LEFT);
        headerStyle.setVerticalAlignment(VerticalAlignment.CENTER);

        // Row 0: Guidelines Title Row
        Row titleRow = guidelineSheet.createRow(0);
        titleRow.setHeightInPoints(24);
        Cell titleCellA = titleRow.createCell(0);
        Cell titleCellB = titleRow.createCell(1);
        titleCellA.setCellValue("VALIDATION STAGE");
        titleCellB.setCellValue("STAGE REQUIREMENTS & DESCRIPTION");
        titleCellA.setCellStyle(headerStyle);
        titleCellB.setCellStyle(headerStyle);

        // Standard Wrapped Body Text Style
        CellStyle textStyle = workbook.createCellStyle();
        textStyle.setWrapText(true);
        textStyle.setVerticalAlignment(VerticalAlignment.TOP);

        // Row 2: Stage 1 Definition
        Row stage1Row = guidelineSheet.createRow(2);
        stage1Row.createCell(0).setCellValue("Stage 1: Format Validation");
        stage1Row.createCell(1).setCellValue("Verifies structural system data layout. Ensures mandatory fields are populated, date inputs are properly formatted, and monetary transaction amounts are purely numeric.");
        
        // Row 3: Stage 2 Definition
        Row stage2Row = guidelineSheet.createRow(3);
        stage2Row.createCell(0).setCellValue("Stage 2: Database Integrity Check");
        stage2Row.createCell(1).setCellValue("Cross-references record fields against active system reference masters. Validates that the requested Branch Code, Currency Identifier, and CGL exist and are active.");

        // Row 4: Stage 3 Definition
        Row stage3Row = guidelineSheet.createRow(4);
        stage3Row.createCell(0).setCellValue("Stage 3: Balance Verification");
        stage3Row.createCell(1).setCellValue("Applies balanced ledger control rules. Aggregates values row-by-row ensuring total active Debits equal total Credits exactly prior to scheduling submission.");

        // Apply formatting across the guidelines block entries
        for (int i = 2; i <= 4; i++) {
            Row r = guidelineSheet.getRow(i);
            if (r != null) {
                r.setHeightInPoints(40); // Gives ample vertical room for text wrapping
                if (r.getCell(0) != null) r.getCell(0).setCellStyle(textStyle);
                if (r.getCell(1) != null) r.getCell(1).setCellStyle(textStyle);
            }
        }

        // ==============================================================================
        // SHEET 2: EXCEL JOURNAL TEMPLATE (INTEGRATED HEADERS WITH A SAMPLE DATA ROW)
        // ==============================================================================
        Sheet templateSheet = workbook.createSheet("Journal Template");
        
        // EXACT Headers and Order from your original production template method
        String[] headers = {"Branch*", "Currency*", "CGL*", "Amount*", "Type*", "Product Code", "Remarks*"};
        
        // Format Template Header Row
        Row templateHeaderRow = templateSheet.createRow(0);
        templateHeaderRow.setHeightInPoints(24);
        for (int i = 0; i < headers.length; i++) {
            Cell cell = templateHeaderRow.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
            templateSheet.setColumnWidth(i, 5000); // Consistent visibility width per system column
        }

        // Add a line matching the exact structural layout sequence for reference
        Row sampleRow = templateSheet.createRow(1);
        sampleRow.createCell(0).setCellValue("1001");
        sampleRow.createCell(1).setCellValue("INR");
        sampleRow.createCell(2).setCellValue("1102003001");
        sampleRow.createCell(3).setCellValue(55000.00); // Plain numeric value matching Amount* rules
        sampleRow.createCell(4).setCellValue("D");          // Type* field flag example (Debit/Credit marker)
        sampleRow.createCell(5).setCellValue("PRD099");     // Optional Product Code value
        sampleRow.createCell(6).setCellValue("Bulk upload sample entry row"); // Mandatory Remarks* string

        // Write complete multi-sheet assembly data directly out to the streaming pipe
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        workbook.write(bos);
        return bos.toByteArray();
    }
}
