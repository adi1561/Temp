  @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void processChunkRaw(List<JournalBulkValidationService.ExcelRowData> chunk,
                                String batchId,
                                String journalPrefix,
                                String commonRemarks,
                                String creatorId,
                                Integer creatorRole,
                                int globalOffset,
                                LongAdder globalDebit,
                                LongAdder globalCredit) {

        // 1. PAYLOAD removed from INSERT statement
        String sql = "INSERT INTO JOURNAL_REQUEST (BATCH_ID, REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_DATE, REQ_NARRATION, POSTING_DATE, REQ_STATUS) " +
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'P')";
        Timestamp ts = Timestamp.valueOf(LocalDateTime.now());
        final BigDecimal SCALE_FACTOR = new BigDecimal("10000");

        try {
            jdbcTemplate.batchUpdate(sql, new org.springframework.jdbc.core.BatchPreparedStatementSetter() {
                @Override
                public void setValues(java.sql.PreparedStatement ps, int i) throws java.sql.SQLException {
                    JournalBulkValidationService.ExcelRowData r = chunk.get(i);

                    int globalIdx = globalOffset + i + 1;
                    // FIX: Use distinct prefix! Result: 0004977-1
                    String jId = journalPrefix + "-" + globalIdx;

                    BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                    boolean isCredit = "Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType);
                    BigDecimal signedAmt = isCredit ? absAmt.negate() : absAmt;

                    LocalDate rDate = LocalDate.now();
                    if (r.isSystemFormat && r.sysDate != null && r.sysDate.length() == 8) {
                        try {
                            rDate = LocalDate.parse(r.sysDate, DateTimeFormatter.ofPattern("ddMMyyyy"));
                        } catch (DateTimeParseException ignored) {}
                    }

                    ps.setString(1, "P");
                    ps.setTimestamp(2, ts);
                    ps.setString(3, creatorId);
                    ps.setInt(4, creatorRole != null ? creatorRole : 0);
                    ps.setString(5, batchId);
                    ps.setString(6, jId);
                    ps.setString(7, commonRemarks);

                    ps.setTimestamp(5, java.sql.Timestamp.valueOf(LocalDateTime.now()));

                    // 2. Indexes shifted up since Payload is gone
                    ps.setString(8, r.branch);
                    ps.setString(9, r.currency);
                    ps.setString(10, r.cgl);
                    ps.setBigDecimal(11, signedAmt);
                    ps.setDate(12, java.sql.Date.valueOf(rDate));
                    ps.setString(13, r.remarks);
                    ps.setString(14, r.productCode);
                }

                @Override
                public int getBatchSize() {
                    return chunk.size();
                }
            });

            for (JournalBulkValidationService.ExcelRowData r : chunk) {
                BigDecimal absAmt = (r.amount != null) ? r.amount.abs() : BigDecimal.ZERO;
                long scaledValue = absAmt.multiply(SCALE_FACTOR).longValue();

                if ("Credit".equalsIgnoreCase(r.txnType) || "Cr".equalsIgnoreCase(r.txnType)) {
                    globalCredit.add(scaledValue);
                } else {
                    globalDebit.add(scaledValue);
                }
