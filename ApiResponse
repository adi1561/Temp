        jdbcTemplate.update(sumSql, batchId, creatorId, ts, dto.getCommonBatchRemarks(), entities.size(), totalDebit, totalCredit, "PENDING");

        // 2. Initialize New Workflow Engine
        String roleName = (creatorRole == 51) ? "TCSGLIF" : (creatorRole == 52 ? "SBIGLIF" : "OTHER");
        
        VoucherPosting posting = new VoucherPosting();
        posting.setBatchId(batchId);
        posting.setVidFk(dto.getVid()); // From DTO
        posting.setCreatorsRole(roleName);
        posting.setCreatedBy(creatorId);
        posting.setCurrentStatus("PENDING_L1");

        // Determine Workflow Route
        if ("TCSGLIF".equalsIgnoreCase(roleName)) {
            posting.setApprovalWorkflow("W1_3_APPROVERS"); // Route 1: 1 TCS, 2 SBI
            posting.setNextApproval("TCSGLIF"); // First step is TCSGLIF
        } else {
            posting.setApprovalWorkflow("W2_4_APPROVERS"); // Route 2: 2 TCS, 2 SBI
            posting.setNextApproval("TCSGLIF"); // First step is TCSGLIF
        }

        // Handle Maker Scheduling (Fixed LocalDateTime check)
        if (dto.getScheduledTime() != null) {
            posting.setExecutionScheduled("YES");
            posting.setScheduledTime(dto.getScheduledTime()); // It is already a LocalDateTime object
            posting.setIsScheduleOverride("NO");
        } else {
            posting.setExecutionScheduled("NO");
        }

        voucherPostingRepository.save(posting);

        // 3. Notifications & Audits
        // If logAudit and sendNotification are missing, make sure they exist in your service, 
        // or comment them out if you handle notifications differently.
        logAudit(creatorId, "BATCH_MANUAL", "ADD", "Manual Batch " + batchId + " Created under workflow " + posting.getApprovalWorkflow());
        sendNotification(creatorId, null, "Batch created Successfully with Batch ID : " + batchId, batchId);

        // Alert the Next Approver (TCSGLIF in both scenarios)
        NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
        if (config != null) {
            String msg = String.format("New Batch %s by %s requires Level 1 approval.", batchId, creatorId);
            sendNotification(null, config.getTargetRoles(), msg, batchId);
        }

        return savedEntities;
    }

