package com.fincore.VoucherService.Model; // Adjust package as needed

import jakarta.persistence.*; // Or javax.persistence.* depending on your Spring Boot version
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDateTime;

@Entity
@Table(name = "VOUCHER_POSTING")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class VoucherPosting {

    @Id
    @Column(name = "BATCH_ID", length = 50, nullable = false)
    private String batchId;

    @Column(name = "VID_FK", length = 20, nullable = false)
    private String vidFk;

    @Column(name = "WORKFLOW_CODE", length = 100)
    private String workflowCode;

    @Column(name = "CREATED_BY", length = 100)
    private String createdBy;

    @Column(name = "CREATED_AT", insertable = false, updatable = false)
    private LocalDateTime createdAt; // Maps to TIMESTAMP(6) with CURRENT_TIMESTAMP default

    @Column(name = "PENDING_AT")
    private Long pendingAt;

    // --- SCHEDULING FIELDS ---
    @Column(name = "IS_EXECUTION_SCHEDULED", length = 3)
    private String executionScheduled; // Maps to 'YES' / 'NO'

    @Column(name = "SCHEDULED_TIME")
    private LocalDateTime scheduledTime;

    @Column(name = "IS_SCHEDULE_OVERRIDE", length = 3)
    private String isScheduleOverride; // Maps to 'YES' / 'NO'

    // --- EXECUTION & STATUS FIELDS ---
    @Column(name = "EXECUTED_AT")
    private LocalDateTime executedAt;

    @Column(name = "BATCH_STATUS", length = 20)
    private String batchStatus; // Now strictly using 'P', 'A', 'R', 'QUEUED', 'ERROR'

    @Column(name = "RECORDS_COUNT")
    private Long recordsCount;

    // =========================================================
    // ✨ THE 3 NEW MASTER COLUMNS FOR PERFORMANCE & AUDIT ✨
    // =========================================================

    @Column(name = "COMMON_BATCH_REMARKS", length = 50)
    private String commonBatchRemarks;

    @Column(name = "CREATOR_ROLE")
    private Integer creatorRole;

    @Column(name = "EXECUTOR_ID", length = 100)
    private String executorId;
}
