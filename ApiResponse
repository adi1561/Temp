import React, { useState, useEffect, useCallback, useRef } from "react";
import {
  Box,
  Typography,
  Grid,
  TextField,
  Button,
  Paper,
  IconButton,
  MenuItem,
  CircularProgress,
  Autocomplete,
  Tooltip,
  Checkbox,
  FormControlLabel,
  Chip,
  FormHelperText,
  Divider,
  Card,
  CardActionArea,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination,
  Collapse,
  Radio,
  Stack,
  Stepper
} from "@mui/material";
import { useNavigate } from "react-router-dom";
import AddIcon from "@mui/icons-material/Add";
import TaskAltIcon from '@mui/icons-material/TaskAlt';
import DeleteIcon from "@mui/icons-material/Delete";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import KeyboardArrowUpIcon from '@mui/icons-material/KeyboardArrowUp';
import KeyboardArrowDownIcon from '@mui/icons-material/KeyboardArrowDown';
import ScheduleIcon from "@mui/icons-material/Schedule";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import DateRangeTwoToneIcon from '@mui/icons-material/DateRangeTwoTone';
import EditNoteIcon from '@mui/icons-material/EditNote';
import UploadFileIcon from '@mui/icons-material/UploadFile';
import TableChartIcon from '@mui/icons-material/TableChart';
import { debounce } from "lodash";
import useApi from "../../hooks/useApi";
import JournalBulkUpload from "./VoucherBulkUpload";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import dayjs from "dayjs";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { TimePicker } from "@mui/x-date-pickers/TimePicker";
import { jpStyles } from "./VoucherStyle";
const createNewRow = () => ({
  id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + Math.random(),
  branch: null,
  currency: "",
  cgl: null,
  amount: "",
  txnType: "",
  remarks: "",
  productCode: "",
});


const formatBigIntForDisplay = (val) => {
  if (typeof val !== "bigint") {
    val = BigInt(val || 0);
  }
  const str = val.toString().padStart(5, "0");
  const integer = str.slice(0, -4);
  const fractional = str.slice(-4);
  return `${integer || "0"}.${fractional}`;
};
export default function VoucherPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const navigate = useNavigate();
  // --- INTERNAL WIZARD STATE ---
  const [activeStep, setActiveStep] = useState(0);
  const [entryMethod, setEntryMethod] = useState("MANUAL");

  const [submittedBatchId, setSubmittedBatchId] = useState(null);
  const [showSchedulePicker, setShowSchedulePicker] = useState(false);
  const [isApplyingSchedule, setIsApplyingSchedule] = useState(false);



  // --- VOUCHER TABLE STATE ---
  const [voucherList, setVoucherList] = useState([]);
  const [selectedVoucher, setSelectedVoucher] = useState(null);
  const [expandedRow, setExpandedRow] = useState(null); // Tracks which row is clicked open
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(5);

  const isMounted = useRef(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  // --- STEPPER & WIZARD STATE ---
  const steps = ['Select Voucher', 'Entry Method', 'Data Entry'];

  const [groupedVouchers, setGroupedVouchers] = useState({});
  const [scheduledTime, setScheduledTime] = useState(() =>
    dayjs().add(32, 'minute').second(0).millisecond(0) // Initialize to min allowed time
  );

  const [rows, setRows] = useState([createNewRow()]);

  const [currencyOptions, setCurrencyOptions] = useState([]);

  const [isSubmitting, setIsSubmitting] = useState(false);

  const [commonBatchRemarks, setCommonBatchRemarks] = useState("");
  const [postingDate, setPostingDate] = useState("");

  const [checked, setChecked] = useState(false);

  const [isPageLoading, setIsPageLoading] = useState(true);
  const [isEodRunning, setIsEodRunning] = useState(false);

  // Replaces anything that is NOT an alphabet, number, or space
  const REMARKS_REPLACE_REGEX = /[^a-zA-Z0-9 ]/g;

  // Replaces anything that is NOT a digit (CGL is strictly digits)
  const CGL_REPLACE_REGEX = /[^0-9]/g;

  // Replaces anything that is NOT alphanumeric (Branch is strictly alphanumeric)
  const BRANCH_REPLACE_REGEX = /[^0-9]/g;


  const [currentRoleId, setCurrentRoleId] = useState(null);


  // Track input values to prevent empty dropdown tray on focus
  const [branchInputValues, setBranchInputValues] = useState({});
  const [cglInputValues, setCglInputValues] = useState({});

  const [branchSearch, setBranchSearch] = useState({
    loadingId: null,
    options: [],
  });
  const [cglSearch, setCglSearch] = useState({
    loadingId: null,
    options: []
  });

  useEffect(() => {
    isMounted.current = true;
    try {
      const auth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (auth) {
        const user = JSON.parse(JSON.parse(auth).user);
        if (user?.userId) setCurrentUserId(String(user.userId));
        // Assuming your auth object holds the role ID. Adjust the property name if needed.
        if (user?.roleId) setCurrentRoleId(user.roleId);
      }
    } catch (e) { }
    return () => { isMounted.current = false; };
  }, []);

  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setIsPageLoading(true);

        const roleToFetch = currentRoleId || 9001;
        const vouchersResponse = await callApi(`/JS/voucher/active?roleId=${roleToFetch}`, null, "GET");
        // const vouchersResponse = await callApi(`/JE/voucher-transactions/search-vid`, null, "GET");

         // Defensively extract the array whether your callApi unwraps the { data: [...] } or not
        if (vouchersResponse && Array.isArray(vouchersResponse.data)) {
          setVoucherList(vouchersResponse.data);
        } else if (Array.isArray(vouchersResponse)) {
          setVoucherList(vouchersResponse);
        } else {
          setVoucherList([]); // Safe fallback
        }

 
        // 1. FIRST: Check the EOD Status from your new API
        const eodResponse = await callApi("/JS/voucher/eod_status", null, "GET");

        // The API returns an array: [{ "eodStatus": 0 }]
        if (eodResponse && Array.isArray(eodResponse) && eodResponse.length > 0) {
          if (eodResponse[0].eodStatus === 1) {
            setIsEodRunning(true);
            setIsPageLoading(false);
            return; // STOP loading everything else, block the screen
          }
        }

        // 2. IF EOD IS NOT RUNNING: Continue loading the normal page data
        const dateResponse = await callApi("/JS/voucher/current-posting-date", null, "GET");

        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            const formattedDate = `${day}-${month}-${year}`;
            setPostingDate(formattedDate);
          } catch (e) {
            console.error("Could not parse date:", dateResponse, e);
            setPostingDate(dateResponse);
          }
        } else {
          showSnackBar("Failed to load official posting date.", "error");
          setPostingDate("Error");
        }

        const currencyResponse = await callApi("/CM/common-master/currency", null, "GET");
        if (currencyResponse?.success && Array.isArray(currencyResponse.data)) {
          const uniqueCurrencies = [...new Set(currencyResponse.data)];
          setCurrencyOptions(uniqueCurrencies);
        } else {
          showSnackBar("Failed to load currencies.", "error");
        }


      } catch (error) {
        console.error("Error fetching initial data:", error);
        showSnackBar("An error occurred while loading page data.", "error");
      } finally {
        setIsPageLoading(false);
      }
    };

    fetchInitialData();
  }, [callApi, showSnackBar]);

  const handleNext = () => {
    if (activeStep === 0 && !selectedVoucher) {
      showSnackBar("Please select a voucher from the list first.", "warning");
      return;
    }
    setActiveStep((prevStep) => prevStep + 1);
  };

  const handleMethodSelection = (method) => {
    setEntryMethod(method);
    handleNext();
  };

  const handleResetWizard = () => {
    setSelectedVoucher(null);
    setEntryMethod("MANUAL");
    setRows([createNewRow()]);
    setCommonBatchRemarks("");
    setScheduledTime(null);
    setChecked(false);
    setSubmittedBatchId(null);
    setShowSchedulePicker(false);
    navigate("/voucher-posting-status");
  };

  const handleApplySchedule = async () => {
    if (!scheduledTime || !scheduledTime.isValid()) {
      showSnackBar("Please select a valid time.", "warning");
      return;
    }

    // Force the date to strictly be TODAY, merging it with the selected time
    const today = dayjs();
    const finalSchedule = scheduledTime
      .year(today.year())
      .month(today.month())
      .date(today.date());

    const minAllowed = dayjs().add(30, 'minute'); // 2 min network buffer
    const maxAllowed = dayjs().endOf('day'); // 11:59:59 PM today

    if (finalSchedule.isBefore(minAllowed)) {
      showSnackBar("Schedule time must be at least 30 minutes from now.", "warning");
      return;
    }

    if (finalSchedule.isAfter(maxAllowed)) {
      showSnackBar("Schedule time cannot exceed today's end of day (11:59 PM).", "warning");
      return;
    }

    setIsApplyingSchedule(true);
    try {
      // Formats it cleanly for the Oracle Backend
      const formattedSchedule = finalSchedule.format('YYYY-MM-DD HH:mm:ss');

      await callApi("/JS/voucher/update-schedule", {
        batchId: submittedBatchId,
        scheduledTime: formattedSchedule
      }, "POST");

      showSnackBar("Schedule applied successfully!", "success");
      handleResetWizard();
    } catch (e) {
      showSnackBar(e.message, "error");
    } finally {
      setIsApplyingSchedule(false);
    }
  };

  const handleChangePage = (event, newPage) => {
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const handleRowExpand = (id) => {
    setExpandedRow(expandedRow === id ? null : id);
  };
  const handleBack = () => {
    setActiveStep((prevStep) => prevStep - 1);
  };

  const filterRemarks = (val) => {
    let filtered = val.replace(/[^a-zA-Z0-9 ]/g, ""); // Allow only alphanumeric and spaces
    filtered = filtered.replace(/^\s+/, ""); // Remove leading spaces
    filtered = filtered.replace(/\s{2,}/g, " "); // Replace multiple consecutive spaces with a single space
    return filtered;
  };


  // 1. Common remarks can be empty. If filled, must be 2-30.
  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);

  // 2. Row remarks are STRICTLY compulsory (2-30 chars).
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphabets and numbers are allowed.";

    if (type === "alphanumeric_space") {
      // 1. Strip any character using the centralized regex
      filtered = val.replace(REMARKS_REPLACE_REGEX, "");

      if (filtered !== val) {
        hasError = true;
      }

      // 2. Strip leading space and collapse double spaces
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Remark should not start with space or contain consecutive spaces.";
      }
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }
    return filtered;
  };

  // Both Common Batch Remarks and Row Remarks are now strictly compulsory (2-30 chars)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];

    if (
      !lastRow.branch ||
      !lastRow.currency ||
      !lastRow.cgl ||
      !lastRow.amount ||
      !lastRow.txnType ||
      !isRowRemarksValid(lastRow.remarks)
    ) {
      showSnackBar(
        "Please fill all required fields (*) in the current row before adding a new one.",
        "warning"
      );
      return;
    }

    const newRow = {
      ...createNewRow(),
      remarks: checked ? commonBatchRemarks : "",
    };

    setRows([...rows, newRow]);
  };

  const handleRemarksSync = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);

    if (isChecked) {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: commonBatchRemarks,
      }));
      setRows(newRows);
    } else {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: "",
      }));
      setRows(newRows);
    }
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) {
      setRows(rows.filter((row) => row.id !== id));
      // Cleanup input tracking
      const newBranchInputs = { ...branchInputValues };
      delete newBranchInputs[id];
      setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues };
      delete newCglInputs[id];
      setCglInputValues(newCglInputs);
    } else {
      showSnackBar("Cannot delete the first row.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    setRows((prevRows) =>
      prevRows.map((row) => {
        if (row.id === id) {
          return { ...row, [field]: value };
        }
        return row;
      })
    );
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) {
        setBranchSearch({ loadingId: null, options: [] });
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(
          `/JS/branches-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("Branch search failed.", "error");
        setBranchSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      // Changed from === 0 to < 3 to enforce the minimum character limit
      if (!query || query.trim().length < 3) {
        setCglSearch({ loadingId: null, options: [] });
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));

      try {
        const response = await callApi(
          `/JS/cgl-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("CGL search failed.", "error");
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const handleSubmit = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }


    setIsSubmitting(true);

    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${year}-${month}-${day}`;


    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch ||
        !row.currency ||
        !row.cgl ||
        !row.amount ||
        parseFloat(row.amount) === 0 ||
        !row.txnType ||
        !isRowRemarksValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has a zero amount. Amount must be greater than 0, and remarks must be 2-30 characters.`,
          "error"
        );
        setIsSubmitting(false);
        return;
      }


      const branchCode = row.branch.code;
      const branchName = row.branch.name;
      const currency = row.currency;

      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (
        row.amount || "0"
      ).split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, {
          totalDebit: 0n,
          totalCredit: 0n,
          branchName: branchName,
          branchCode: branchCode,
          currency: currency,
          type: type,
        });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {
        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, {
          hasDebit: false,
          hasCredit: false,
          branchName: branchName,
        });
      }
      const branchCheck = branchEntryCheck.get(branchCode);

      if (row.txnType === "Debit" && amountAsBigInt > 0n) {
        branchCheck.hasDebit = true;
      } else if (row.txnType === "Credit" && amountAsBigInt > 0n) {
        branchCheck.hasCredit = true;
      }

      const finalAmount =
        row.txnType === "Credit" ? "-" + row.amount : row.amount;

      rowPayloads.push({
        branch: row.branch.code,
        currency: row.currency,
        cgl: row.cgl.cglNumber,
        amount: finalAmount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        postingDate: formattedBackendDate
      });
    }

    for (const [branchCode, totals] of branchEntryCheck.entries()) {
      const { hasDebit, hasCredit } = totals;
      if (!hasDebit || !hasCredit) {
        showSnackBar("Branch must have at least one Debit and one Credit entry.", "error");
        setIsSubmitting(false);
        return;
      }
    }


    for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
      const { totalDebit, totalCredit } = totals;

      if (totalDebit !== totalCredit) {
        showSnackBar("Branch and Currency Debit/Credit Mismatch for Real/Memo CGL.", "error");
        setIsSubmitting(false);
        return;
      }
    }

    let formattedSchedule = null;
    if (scheduledTime) {
      const dateObj = new Date(scheduledTime);
      formattedSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    const finalPayload = {
      vid: selectedVoucher?.vid,
      scheduledTime: null, // Handled in Step 3 now
      commonBatchRemarks: commonBatchRemarks.trim(),
      rows: rowPayloads,
    };
    try {
      const response = await callApi(
        "/JS/voucher/create-batch",
        finalPayload,
        "POST"
      );

      // Extract the Batch ID created by the backend
      const newBatchId = response?.[0]?.batchId || response?.batchId || "N/A";
      setSubmittedBatchId(newBatchId);

      setRows([createNewRow()]);
      setCommonBatchRemarks("");
      setChecked(false);
      setBranchInputValues({});
      setCglInputValues({});
      setActiveStep(3);
    } catch (error) {
      // If it fails instantly (e.g. server down, bad network), show an error snackbar
      const errMsg = error?.response?.data?.message || error.message || "System error occurred.";
      showSnackBar(`Failed to initiate request: ${errMsg}`, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  const isFormReadyToSubmit = rows.every(
    (row) =>
      row.branch &&
      row.currency &&
      row.cgl &&
      row.amount &&
      parseFloat(row.amount) > 0 &&
      row.txnType &&
      isRowRemarksValid(row.remarks)
  );

  const SelectedVoucherCard = () => {
    if (!selectedVoucher) return null;

    return (
      <Paper elevation={0} sx={jpStyles.svPaper}>
        <Box sx={jpStyles.svHeaderBox}>
          <Typography variant="subtitle1" fontWeight="bold" color="text.primary">
            Selected Voucher Details
          </Typography>

        </Box>

        <Grid container>
          <Grid item sx={{ mb: 2 }} size={12}>
            <Stack direction="row" spacing={10}>
              <Box>
                <Typography variant="caption" color="text.secondary" display="block" gutterBottom>VID</Typography>
                <Typography variant="body1" fontWeight="bold" color="primary">{selectedVoucher.vid}</Typography>
              </Box>
              <Box>
                <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Category</Typography>
                <Typography variant="body1" fontWeight="500">{selectedVoucher.categoryName || "General"}</Typography>
              </Box>
            </Stack>
          </Grid>
          <Grid item xs={12}>
            <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Description</Typography>
            <Typography variant="body2" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6, fontWeight: 300 }}>
              {selectedVoucher.description || "No description provided."}
            </Typography>
          </Grid>
        </Grid>

      </Paper>
    );
  };


  if (isPageLoading) {
    return (
      <Box sx={jpStyles.loadingBox}>
        <CircularProgress size={60} />
      </Box>
    );
  }
  if (isEodRunning) {
    return (
      <Box sx={jpStyles.eodBox}>
        <Paper elevation={4} sx={jpStyles.eodPaper}>
          <Typography variant="h4" color="error" fontWeight="bold" gutterBottom>EOD is Currently Running</Typography>
          <Typography variant="h6" color="text.secondary" sx={{ mt: 2 }}>Journal Posting is temporarily disabled.</Typography>
          <Typography variant="body1" color="text.secondary" sx={{ mt: 1 }}>Please wait until the End of Day process completes to post new transactions.</Typography>
        </Paper>
      </Box>
    );
  }




  return (
    <Paper sx={jpStyles.mainPaper}>

      {/* INTERNAL STEP 0: VOUCHER SELECTION TABLE */}
      {activeStep === 0 && (
        <Box>
          <Typography variant="h6" fontWeight="bold" gutterBottom color="primary.main" sx={jpStyles.stepHeader}>
            Select Voucher Id (VID)
          </Typography>


          <Paper elevation={2} sx={jpStyles.tablePaper}>
            <TableContainer sx={jpStyles.tableContainer}>
              <Table size="medium" sx={jpStyles.table}>
                <TableHead sx={jpStyles.tableHead}>
                  <TableRow>
                    <TableCell padding="checkbox" sx={{ width: '5%' }}></TableCell>
                    <TableCell sx={{ fontWeight: 'bold', width: '20%' }}>VID</TableCell>
                    <TableCell sx={{ fontWeight: 'bold', width: '25%' }}>Category</TableCell>
                    <TableCell sx={{ fontWeight: 'bold', width: '25%' }}>Created By</TableCell>
                    <TableCell sx={{ fontWeight: 'bold', width: '25%' }}>Created At</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {voucherList
                    .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
                    .map((row) => {
                      // FIX: Using clean camelCase keys exactly as mapped by the backend RowMapper
                      const rowId = row.id;
                      const rowVid = row.vid;
                      const rowCategory = row.categoryName || "General";
                      const rowCreatorName = row.createdByName || "System";
                      const rowCreatorId = row.createdBy || "N/A";
                      const rowCreatedAt = row.createdAt;
                      const rowDescription = row.description || "No description provided for this voucher configuration.";
                      const rowIssueCategories = row.issueCategories;

                      const isSelected = selectedVoucher?.id === rowId;
                      const isExpanded = expandedRow === rowId;
                      return (
                        <React.Fragment key={row.id}>
                          {/* MAIN ROW */}
                          <TableRow
                            hover
                            onClick={() => {
                              setSelectedVoucher(row);
                              handleRowExpand(row.id);
                            }}
                            sx={{
                              cursor: 'pointer',
                              backgroundColor: isSelected ? "action.selected" : "inherit",
                              '& > *': { borderBottom: isExpanded ? 'none' : '1px solid rgba(224, 224, 224, 1)' }
                            }}
                          >
                            <TableCell padding="checkbox">
                              <Radio checked={isSelected} color="primary" />
                            </TableCell>
                            <TableCell sx={jpStyles.ellipsisCell}>
                              {row.vid}
                            </TableCell>
                            <TableCell sx={jpStyles.ellipsisCell}>
                              {row.categoryName || "General"}
                            </TableCell>
                            <TableCell sx={jpStyles.ellipsisCell}>
                              {row.createdByName} <Typography component="span" variant="caption" color="text.secondary">({row.createdBy})</Typography>
                            </TableCell>
                            <TableCell sx={jpStyles.ellipsisCell}>
                              {row.createdAt ? (
                                new Date(row.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })
                                + ", " +
                                new Date(row.createdAt).toLocaleTimeString("en-IN", { hour: "numeric", minute: "2-digit", hour12: true }).toLowerCase()
                              ) : "N/A"}
                            </TableCell>
                          </TableRow>

                          <TableRow sx={{ backgroundColor: "background.default" }}>
                            {/* colSpan is now 5 to match the new column count */}
                            <TableCell style={{ paddingBottom: 0, paddingTop: 0, borderBottom: isExpanded ? '1px solid rgba(224, 224, 224, 1)' : 'none' }} colSpan={5}>
                              <Collapse in={isExpanded} timeout="auto" unmountOnExit>
                                <Grid container sx={jpStyles.collapseGrid}>
                                  <Grid item size={{ lg: 1.3, md: 1.5 }}>
                                    <Typography variant="body2" color="text.secondary">
                                      <strong>Description:</strong>
                                    </Typography>
                                  </Grid>
                                  <Grid item size={{ lg: 10.7, md: 10.5 }}>
                                    <Typography variant="body2" color="text.secondary">
                                      {row.description || "No description provided for this voucher configuration."}
                                    </Typography>
                                  </Grid>
                                  <Grid item size={{ lg: 1.3, md: 1.5 }}>
                                    <Typography variant="body2" color="text.secondary">
                                      <strong> Issue Categories: </strong>
                                    </Typography>
                                  </Grid>
                                  <Grid item size={{ lg: 10.7, md: 10.5 }}>
                                    <Box>
                                      {row.issueCategories?.split(",")
                                        .map((cat) => (
                                          <Chip label={cat.trim()} sx={jpStyles.issueCategoryChip} />
                                        ))}
                                    </Box>
                                  </Grid>
                                  {/* </Box> */}
                                </Grid>
                              </Collapse>
                            </TableCell>
                          </TableRow>
                        </React.Fragment>
                      );
                    })}
                  {voucherList.length === 0 && (
                    <TableRow>
                      <TableCell colSpan={4} align="center" sx={{ py: 3 }}>
                        No configurations found.
                      </TableCell>
                    </TableRow>
                  )}
                </TableBody>
              </Table>
            </TableContainer>
            <TablePagination
              rowsPerPageOptions={[5, 10, 25]}
              component="div"
              count={voucherList.length}
              rowsPerPage={rowsPerPage}
              page={page}
              onPageChange={handleChangePage}
              onRowsPerPageChange={handleChangeRowsPerPage}
            />
          </Paper>

          <Box sx={jpStyles.buttonRightAlign}>
            <Button variant="contained" onClick={handleNext} disabled={!selectedVoucher} endIcon={<ArrowForwardIcon />} sx={{ px: 4 }}>
              Next
            </Button>
          </Box>
        </Box>
      )
      }

      {/* INTERNAL STEP 1: CHOOSE ENTRY METHOD */}
      {
        activeStep === 1 && (
          <Box sx={jpStyles.methodContainer}>

            <Typography variant="h5" align="center" fontWeight="bold" gutterBottom sx={{ mt: 2 }}>
              How would you like to input the data?
            </Typography>
            <Typography variant="body1" align="center" color="text.secondary" sx={{ mb: 6 }}>
              Selected VID : <b>{selectedVoucher?.vid}</b>
            </Typography>
            {/* Using Flexbox with fixed widths instead of dynamic Grids for perfect symmetry */}
            <Box sx={jpStyles.cardsWrapper}>

              {/* MANUAL ENTRY CARD */}
              <Card elevation={2} sx={jpStyles.methodCard}>
                <CardActionArea onClick={() => handleMethodSelection("MANUAL")} sx={jpStyles.methodCardArea}>
                  <EditNoteIcon color="primary" sx={jpStyles.manualIcon} />
                  <Typography variant="h6" fontWeight="bold" gutterBottom>Manual Entry</Typography>
                  <Typography variant="body2" color="text.secondary">
                    Manual Voucher Posting
                  </Typography>
                </CardActionArea>
              </Card>

              {/* EXCEL UPLOAD CARD */}
              <Card elevation={2} sx={jpStyles.methodCard}>
                <CardActionArea onClick={() => handleMethodSelection("BULK")} sx={jpStyles.methodCardArea}>
                  {/* Standard Excel Green Hex Code */}
                  <TableChartIcon sx={jpStyles.excelIcon} />
                  <Typography variant="h6" fontWeight="bold" gutterBottom>Excel Upload</Typography>
                  <Typography variant="body2" color="text.secondary">
                    Upload an Excel file (.xlsx or .xls) to process hundreds of voucher entries instantly.
                  </Typography>
                </CardActionArea>
              </Card>

            </Box>

            <Box sx={jpStyles.backButtonBox}>
              <Button variant="outlined" onClick={handleBack} startIcon={<ArrowBackIcon />}>
                Previous
              </Button>
            </Box>
          </Box>
        )
      }

      {/* INTERNAL STEP 2: DATA ENTRY GRID */}
      {
        activeStep === 2 && entryMethod === "MANUAL" && (
          <Box>
            {/* Replaces the old basic header with the professional detailed card */}
            <SelectedVoucherCard onBackClick={handleBack} showBackButton={true} />

            <Box component={Paper} elevation={3} sx={jpStyles.dataEntryPaper}>
              {/* ... EXISTING GRID START ... */}
              <Grid item xs={12} md={12} sx={jpStyles.gridContainer}>
                <TextField
                  label="Common Batch Remarks"
                  value={commonBatchRemarks}
                  onChange={(e) => {
                    const newValue = filterAndWarn(e.target.value, "alphanumeric_space");
                    if (newValue.length <= 30) {
                      setCommonBatchRemarks(newValue);
                      if (checked) {
                        setRows(rows.map((row) => ({ ...row, remarks: newValue })));
                      }
                    }
                  }}
                  fullWidth required multiline rows={1} inputProps={{ maxLength: 30 }}
                  error={commonBatchRemarks.length > 0 && !isCommonRemarksValid(commonBatchRemarks)}
                />
                <FormHelperText sx={jpStyles.commonRemarksHelper}>
                  Allowed 2-30 chars (alphabets, numbers)
                </FormHelperText>
                <Box sx={jpStyles.checkboxBox}>
                  <FormControlLabel
                    control={<Checkbox checked={checked} onChange={handleRemarksSync} color="primary" disabled={commonBatchRemarks.length > 0 && !isRemarksValid(commonBatchRemarks)} />}
                    label="Apply this remark to all below transactions"
                  />
                </Box>
              </Grid>

              <Box sx={{ mt: 2 }}>
                {rows.map((row, index) => {
                  // Universal Regex: Up to 16 digits, up to 4 decimal places
                  const amountRegex = /^\d{0,16}(\.\d{0,4})?$/;

                  return (
                    <React.Fragment key={row.id}>
                      <Grid container spacing={2} alignItems="flex-start">
                        {/* Branch */}
                        <Grid item
                          // xs={12} md={3}
                          size={{ xl: 1.5, lg: 2 }}
                        >
                          <Autocomplete
                            popupIcon={null} autoHighlight options={
                              row.branch && !branchSearch.options.some((o) => o.code === row.branch.code)
                                ? [row.branch, ...branchSearch.options]
                                : branchSearch.options
                            }
                            getOptionLabel={(option) => option && option.code ? `${option.code} - ${option.name}` : ""}
                            slotProps={{
                              popper: {
                                placement: 'bottom-start',
                                modifiers: [{ name: 'flip', enabled: false }, { name: 'preventOverflow', enabled: false }],
                              },
                            }}
                            value={row.branch || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
                            inputValue={branchInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(BRANCH_REPLACE_REGEX, "").substring(0, 5);
                                setBranchInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchBranches(cleanInput, row.id);
                              } else {
                                setBranchInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            loading={branchSearch.loadingId === row.id} filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => option?.code === value?.code}
                            noOptionsText={(branchInputValues[row.id] || "").length < 3 ? "Please enter at least 3 digits" : "No Branch found"}
                            renderInput={(params) => (
                              <Tooltip title="Search by Branch Code" placement="top-start">
                                <TextField
                                  {...params}
                                  label="Branch *"
                                  placeholder="Enter branch code..."
                                  InputLabelProps={{ shrink: true }}
                                  inputProps={{
                                    ...params.inputProps,
                                    style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' }
                                  }}
                                  InputProps={{
                                    ...params.InputProps,
                                    endAdornment: (
                                      <Box>
                                        {branchSearch.loadingId === row.id ? (<CircularProgress color="inherit" size={20} />) : null}
                                        {params.InputProps.endAdornment}
                                      </Box>
                                    )
                                  }}
                                />
                              </Tooltip>
                            )}
                          />
                          <Typography variant="caption" sx={jpStyles.captionText}>
                            Min 3 Digits Required Search
                          </Typography>
                        </Grid>

                        {/* Currency */}
                        <Grid item
                          size={{ xl: 1.5, lg: 2 }}
                          fontSize={1}
                        >
                          <TextField
                            select label="Currency *" value={row.currency} InputLabelProps={{ shrink: true }}
                            slotProps={{
                              root: {
                                sx: {
                                  minWidth: "100%"
                                }
                              }
                            }}
                            onChange={(e) => { handleRowChange(row.id, "currency", e.target.value); handleRowChange(row.id, "amount", ""); }}
                            SelectProps={{
                              displayEmpty: true,
                              renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Select Currency</span> : selected,
                              MenuProps: {
                                anchorOrigin: { vertical: "bottom", horizontal: "left" },
                                transformOrigin: { vertical: "top", horizontal: "left" },
                                marginThreshold: 0,
                                PaperProps: { style: { maxHeight: 180 } }
                              }
                            }}
                          >

                            {currencyOptions.map((c) => (<MenuItem key={c} value={c}>{c}</MenuItem>))}
                          </TextField>
                        </Grid>

                        {/* CGL */}
                        <Grid item
                          //  xs={12} md={2}
                          size={{ xl: 2, lg: 2.8 }} >
                          <Autocomplete
                            popupIcon={null} autoHighlight options={
                              row.cgl && !cglSearch.options.some((o) => o.cglNumber === row.cgl.cglNumber)
                                ? [row.cgl, ...cglSearch.options]
                                : cglSearch.options
                            }
                            slotProps={{
                              popper: {
                                placement: 'bottom-start',
                                modifiers: [
                                  {
                                    name: 'flip',
                                    enabled: false, // Forces it to never flip upwards
                                  },
                                  {
                                    name: 'preventOverflow',
                                    enabled: false, // Prevents it from jumping around
                                  }
                                ],
                              },
                            }}
                            getOptionLabel={(option) => option && option.cglNumber ? `${option.cglNumber} - ${option.description}` : ""}
                            value={row.cgl || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                            inputValue={cglInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(CGL_REPLACE_REGEX, "").substring(0, 10);
                                setCglInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchCgls(cleanInput, row.id);
                              } else {
                                setCglInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            loading={cglSearch.loadingId === row.id} filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => option?.cglNumber === value?.cglNumber}
                            noOptionsText={(cglInputValues[row.id] || "").length < 3 ? "Please enter at least 3 digits.." : "CGL not found"}
                            renderInput={(params) => (
                              <Tooltip title="Search by CGL Number" placement="top-start">
                                <TextField {...params} label="CGL *" placeholder="Search CGL number..." InputLabelProps={{ shrink: true }} InputProps={{ ...params.InputProps, endAdornment: (<Box sx={jpStyles.memoChipBox}>{row.cgl && String(row.cgl.cglNumber).startsWith("5") && (<Chip label="MEMO" size="small" color="warning" sx={jpStyles.memoChip} />)}{cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}{params.InputProps.endAdornment}</Box>) }} />
                              </Tooltip>
                            )}
                          />
                          <Typography variant="caption" sx={jpStyles.captionText}>
                            Min 3 digits Required Search
                          </Typography>
                        </Grid>

                        {/* Amount */}
                        <Grid item size={{ xl: 2, lg: 2.8 }}>
                          <TextField
                            label="Amount *" type="text" value={row.amount} InputLabelProps={{ shrink: true }}
                            fullWidth placeholder="0.0000" inputProps={{ style: { textAlign: "right" } }}
                            onChange={(e) => {
                              const rawVal = e.target.value;
                              if (/[^0-9.]/.test(rawVal)) {
                                showSnackBar("Only numbers and decimal point are allowed.", "warning"); return;
                              }
                              if (rawVal === "" || amountRegex.test(rawVal)) { handleRowChange(row.id, "amount", rawVal); }
                              else { showSnackBar("Exceeded maximum digits or decimal places.", "warning"); }
                            }}
                          />
                          <Typography variant="caption" sx={jpStyles.captionText}>
                            Max 16 digits, 4 decimals
                          </Typography>
                        </Grid>


                        {/* Txn Type */}
                        <Grid item
                          size={{ xl: 1, lg: 1.5 }}
                        >
                          <TextField
                            slotProps={{
                              root: {
                                sx: {
                                  minWidth: "100%"
                                }
                              }
                            }}
                            select label="Type *" value={row.txnType} fullWidth InputLabelProps={{ shrink: true }} onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)} SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : selected }}>
                            <MenuItem value="Debit">Debit</MenuItem>
                            <MenuItem value="Credit">Credit</MenuItem>
                          </TextField>
                        </Grid>

                        {/* Product Code */}
                        <Grid item
                          // xs={12} md={2}
                          size={{ xl: 1, lg: 1.5 }} >
                          <TextField label="Product Code" value={row.productCode} InputLabelProps={{ shrink: true }} placeholder="Enter Product Code.." fullWidth inputProps={{ maxLength: 8 }} onChange={(e) => { const rawVal = e.target.value; const cleanVal = rawVal.replace(/[^0-9]/g, ""); if (rawVal !== cleanVal) { showSnackBar("Only digits are allowed.", "warning"); } if (cleanVal.length <= 8) { handleRowChange(row.id, "productCode", cleanVal); } }} />
                          <Typography variant="caption" sx={jpStyles.captionText}>Max 8 digits</Typography>
                        </Grid>

                        {/* Remarks (Individual) */}
                        <Grid item
                          size={{ xl: 2.5, lg: 3.5 }}
                        //  sx={{ flexGrow: 2 }}
                        >
                          <TextField label="Remarks *" value={row.remarks} InputLabelProps={{ shrink: true }} placeholder="Enter remarks..." fullWidth inputProps={{ maxLength: 30 }} disabled={checked} error={row.remarks.length > 0 && !isRowRemarksValid(row.remarks)} onChange={(e) => { const val = filterAndWarn(e.target.value, "alphanumeric_space"); if (val.length <= 30) { handleRowChange(row.id, "remarks", val); } }} />
                          <Typography variant="caption" sx={jpStyles.captionText}>Allowed 2-30 chars (alphabets, numbers)</Typography>
                        </Grid>

                        {/* Delete Action */}
                        <Grid item size={{ xl: 0.5, lg: 0.8 }} sx={{ textAlign: "center" }}>
                          {rows.length > 1 && (
                            <Tooltip title="Delete row" arrow>
                              <IconButton
                                onClick={() => handleDeleteRow(row.id)}
                                aria-label="delete row"
                                sx={jpStyles.deleteIconButton}
                              >
                                <DeleteIcon />
                              </IconButton>
                            </Tooltip>
                          )}
                        </Grid>
                      </Grid>

                      {index < rows.length - 1 && (<Box sx={jpStyles.rowDivider} />)}
                    </React.Fragment>
                  );
                })}



                {/* ACTION BUTTONS */}
                <Box sx={jpStyles.actionButtonsWrapper}>

                  <Button variant="outlined" startIcon={<ArrowBackIcon />} onClick={handleBack}>
                    Back
                  </Button>
                  <Box sx={{ display: "flex", gap: 2 }}>
                    <Button variant="contained" startIcon={<AddIcon />} onClick={handleAddRow}>
                      Add Row
                    </Button>
                    <Button variant="contained" color="success" onClick={handleSubmit} disabled={isSubmitting || !isCommonRemarksValid(commonBatchRemarks) || !isFormReadyToSubmit}>
                      {isSubmitting ? <CircularProgress size={24} color="inherit" /> : "Submit Request"}
                    </Button>
                  </Box>
                </Box>
              </Box>
            </Box>
          </Box>
        )
      }

      {/* EXTERNAL STEP 2: BULK UPLOAD EXCEL COMPONENT */}
      {
        activeStep === 2 && entryMethod === "BULK" && (
          <JournalBulkUpload
            selectedVoucher={selectedVoucher}
            onBack={handleBack}
            onReset={handleResetWizard}
            // Triggered automatically when Bulk Excel completes
            onSuccessSubmit={(batchId) => {
              setSubmittedBatchId(batchId);
              setActiveStep(3);
            }}
          />
        )
      }

      {/* NEW STEP 3: POST-SUBMISSION SUCCESS & SCHEDULING SCREEN */}
      {
        activeStep === 3 && (
          <Box sx={jpStyles.successBox}>
            <Paper elevation={3} sx={jpStyles.successPaper}>

              <TaskAltIcon sx={jpStyles.successIconProps} />

              <Typography variant="h5" fontWeight="bold" gutterBottom>
                Your request has been submitted!
              </Typography>
              <Typography variant="body1" color="text.secondary" sx={{ mb: 4 }}>
                Batch ID <b>{submittedBatchId}</b> is now pending for approvals.
              </Typography>

              <Divider sx={{ my: 3 }} />

              <Typography variant="h6" fontWeight="bold" color="primary.main" gutterBottom>
                Do you want to schedule this execution?
              </Typography>
              <Typography variant="body2" color="text.secondary" sx={{ mb: 4 }}>
                By default, this batch will post immediately after the final approval. You can choose to delay the posting to a specific future date and time.
              </Typography>

              {!showSchedulePicker ? (
                <Box sx={{ display: 'flex', gap: 3, justifyContent: 'center' }}>
                  <Button variant="outlined" size="large" onClick={handleResetWizard} sx={jpStyles.largeBtn}>
                    Execute Immediately
                  </Button>
                  <Button
                    variant="contained"
                    size="large"
                    startIcon={<ScheduleIcon />}
                    onClick={() => {
                      // FIX: Generate a fresh, valid time (+35 mins) exactly when they click the button
                      setScheduledTime(dayjs().add(35, 'minute').second(0).millisecond(0));
                      setShowSchedulePicker(true);
                    }}
                    sx={jpStyles.largeBtn}
                  >
                    Schedule Execution
                  </Button>
                </Box>
              ) : (
                <Box sx={jpStyles.scheduleContainer}>
                  <Typography variant="subtitle2" gutterBottom>Select Future Date & Time</Typography>

                  <LocalizationProvider dateAdapter={AdapterDayjs}>

                    <TimePicker
                      label="Select Execution Time (Today)"
                      value={scheduledTime}
                      onChange={(newValue) => setScheduledTime(newValue)}
                      minTime={dayjs().add(30, 'minute')}
                      maxTime={dayjs().endOf('day')}
                      timeSteps={{ minutes: 1 }}
                      slotProps={{
                        textField: {
                          size: 'small',
                          fullWidth: true,
                          sx: { mb: 3, caretColor: 'transparent' },
                          helperText: "Execution must be scheduled at least 30 mins from now, and before 11:59 PM today.",
                          onKeyDown: (e) => e.preventDefault(),
                          onPaste: (e) => e.preventDefault(),
                          inputProps: { readOnly: true }
                        }
                      }}
                    />


                  </LocalizationProvider> <Box sx={jpStyles.LocalizationProvider}>
                    <Button onClick={() => setShowSchedulePicker(false)} color="inherit" disabled={isApplyingSchedule}>
                      Cancel
                    </Button>
                    <Button
                      variant="contained"
                      color="primary"
                      onClick={handleApplySchedule}
                      disabled={!scheduledTime || isApplyingSchedule}
                    >
                      {isApplyingSchedule ? <CircularProgress size={24} color="inherit" /> : "Confirm Schedule"}
                    </Button>
                  </Box>
                </Box>
              )}

            </Paper>
          </Box>
        )
      }

    </Paper >

  );
}
