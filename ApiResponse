    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void createNotification(String userId, String targetRole, String message, String linkUrl, String aggregateId, String eventSource) {

        if (userId == null && targetRole == null) {
            log.warn("NOTIFICATION_SKIPPED | Reason: Recipient missing | AggregateID: {}", aggregateId);
            return;
        }

        if (message == null || message.isBlank()) {
            // Rule 2: Descriptive log without logging the context of the blank message
            log.error("NOTIFICATION_VALIDATION_FAIL | Status: BLANK_MESSAGE | AggregateID: {}", aggregateId);
            throw new IllegalArgumentException("Notification message content is required.");
        }

        try {
            Notifications notification = Notifications.builder()
                    .userId(userId)
                    .targetRole(targetRole)
                    .message(message)
                    .linkUrl(linkUrl)
                    .aggregateId(aggregateId)
                    .eventSource(eventSource)
                    .build();
            notificationRepository.save(notification);

            log.info("NOTIFICATION_SAVED | Ref: {} | User: {}", aggregateId, userId != null ? userId : targetRole);

        } catch (DataAccessException e) {
            [span_8](start_span)// Rule 1 & 2: Catching specific Spring DAO exception and logging safely[span_8](end_span)
            log.error("NOTIFICATION_DB_FAIL | AggregateID: {} | Reason: Database persistence failed", aggregateId);
            throw e;
        }
    }
}

Why this fixes your issue:
 * Build Error: The constructor addition in CustomExceptions resolves the actual and formal argument lists differ in length error.
 * Notification Bug: By using Propagation.REQUIRES_NEW, the notification logic no longer waits for a transaction that doesn't exist on the async thread. It creates its own small transaction, saves the notification, and commits immediately.
