This implements the zero-padding logic for 1-2 digit entries and updates the tooltip.
```jsx
{/* Branch */}
<Grid item size={{ xl: 1.5, lg: 2 }}>
  <Autocomplete
    autoHighlight
    popupIcon={null}
    options={ /* ... existing options logic ... */ }
    getOptionLabel={(option) => option && option.code ? `${option.code} - ${option.name}` : ""}
    slotProps={{
      popper: {
        placement: 'bottom-start',
        modifiers: [{ name: 'flip', enabled: false }, { name: 'preventOverflow', enabled: false }],
      },
    }}
    value={row.branch || null}
    onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
    inputValue={branchInputValues[row.id] || ""}
    onInputChange={(event, newInputValue, reason) => {
      if (reason === 'input') {
        const cleanInput = newInputValue.replace(BRANCH_REPLACE_REGEX, "").substring(0, 5);
        setBranchInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
        
        let queryForSearch = cleanInput;
        // APPEND ZEROS: If they enter 1 or 2 digits, pad it to 5 digits for the search
        if (cleanInput.length > 0 && cleanInput.length <= 2) {
          queryForSearch = cleanInput.padStart(5, '0');
        }
        
        searchBranches(queryForSearch, row.id);
      } else {
        setBranchInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
      }
    }}
    onKeyDown={(e) => {
      if (e.key === 'Tab' && !row.branch && branchSearch.options?.length > 0) {
        handleRowChange(row.id, "branch", branchSearch.options[0]);
      }
    }}
    loading={branchSearch.loadingId === row.id} 
    filterOptions={(x) => x}
    isOptionEqualToValue={(option, value) => option?.code === value?.code}
    noOptionsText="Type to search branch..."
    renderInput={(params) => (
      <Tooltip title="Search by Branch Code" placement="top-start">
        <TextField
          {...params}
          label="Branch *"
          placeholder="Enter branch code..."
          InputLabelProps={{ shrink: true }}
