Here is the complete, updated code for both methods. You can copy and paste these directly into your JournalRequestServiceImpl.java file.
These methods guarantee that the frontend will **never** see QUEUED, PROCESSING, or ERROR statuses, and any background error messages are completely hidden from the user interface.
```java
    @Override
    public List<Map<String, Object>> getPendingBatchSummaries() {
        // Query QUEUED and ERROR to catch any locked/legacy records so they don't vanish from the UI
        String sql = "SELECT BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS, EXECUTOR_REMARKS " +
                "FROM JOURNAL_BATCH_MASTER WHERE BATCH_STATUS IN ('PENDING', 'QUEUED', 'ERROR') ORDER BY REQ_DATE DESC";

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("totalDebit", rs.getBigDecimal("TOTAL_DEBIT"));
            map.put("totalCredit", rs.getBigDecimal("TOTAL_CREDIT"));
            
            // Strictly force the frontend to only see "PENDING"
            map.put("requestStatus", "PENDING");
            
            // Completely hide any error messages from the frontend UI
            map.put("errorMessage", null);
            
            return map;
        });
    }

    @Override
    public List<Map<String, Object>> getAllBatchSummaries() {
        String sql = "SELECT BATCH_ID, CREATOR_ID, REQ_DATE, BATCH_REMARKS, TOTAL_ROWS, TOTAL_DEBIT, TOTAL_CREDIT, BATCH_STATUS, EXECUTOR_ID, EXECUTOR_REMARKS " +
                "FROM JOURNAL_BATCH_MASTER ORDER BY REQ_DATE DESC FETCH FIRST 100 ROWS ONLY";

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("totalDebit", rs.getBigDecimal("TOTAL_DEBIT"));
            map.put("totalCredit", rs.getBigDecimal("TOTAL_CREDIT"));
            
            // Map QUEUED and legacy ERROR rows back to PENDING for the UI
            String dbStatus = rs.getString("BATCH_STATUS");
            if ("QUEUED".equals(dbStatus) || "ERROR".equals(dbStatus)) {
                map.put("requestStatus", "PENDING");
                map.put("executorRemarks", null); // Wipe error remarks so they don't show in the grid
            } else {
                map.put("requestStatus", dbStatus);
                map.put("executorRemarks", rs.getString("EXECUTOR_REMARKS"));
            }
            
            map.put("executorId", rs.getString("EXECUTOR_ID"));
            return map;
        });
    }

