                                : "Immediate Execution"}
                            </Typography>
                          </Box>

                          <Stack spacing={2}>
                            <Box onClick={() => setScheduleOverrideType("KEEP")} sx={{ p: 2, borderRadius: 2, border: "2px solid", borderColor: scheduleOverrideType === "KEEP" ? "success.main" : "divider", backgroundColor: scheduleOverrideType === "KEEP" ? "#f0fdf4" : "transparent", cursor: "pointer", display: "flex", alignItems: "center", gap: 2, transition: '0.2s' }}>
                              <Box sx={{ width: 18, height: 18, borderRadius: "50%", border: "5px solid", borderColor: scheduleOverrideType === "KEEP" ? "success.main" : "divider", backgroundColor: "white" }} />
                              <Box>
                                <Typography variant="subtitle2" fontWeight="bold">Keep Original Routing</Typography>
                              </Box>
                            </Box>
                            <Box onClick={() => setScheduleOverrideType("OVERRIDE")} sx={{ p: 2, borderRadius: 2, border: "2px solid", borderColor: scheduleOverrideType === "OVERRIDE" ? "warning.main" : "divider", backgroundColor: scheduleOverrideType === "OVERRIDE" ? "#fffbeb" : "transparent", cursor: "pointer", display: "flex", alignItems: "center", gap: 2, transition: '0.2s' }}>
                              <Box sx={{ width: 18, height: 18, borderRadius: "50%", border: "5px solid", borderColor: scheduleOverrideType === "OVERRIDE" ? "warning.main" : "divider", backgroundColor: "white" }} />
                              <Box>
                                <Typography variant="subtitle2" fontWeight="bold">Override Schedule</Typography>
                              </Box>
                            </Box>
                          </Stack>

                          {scheduleOverrideType === "OVERRIDE" && (
                            <Box sx={{ mt: 3, animation: "fadeIn 0.2s ease-in-out" }}>
                              <TextField fullWidth size="small" label="New Execution Date & Time" type="datetime-local" value={finalScheduleTime} onChange={(e) => setFinalScheduleTime(e.target.value)} InputLabelProps={{ shrink: true }} inputProps={{ min: new Date().toISOString().slice(0, 16) }} required />
                            </Box>
                          )}
                        </Box>
                      )}
                    </Box>
                  )}
                </Paper>
              </Box>
            )}

          </DialogContent>
          {/* --- STICKY BOTTOM ACTION BAR --- */}
          <DialogActions sx={{ p: 3, borderTop: "1px solid", borderColor: "divider", backgroundColor: "white", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            {(() => {
              const isWorkflowFinished = viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED" || viewingBatchState === "REJECTED";
              const isActionDisabled = isViewingSelfCreated || isWorkflowFinished;

              return (
                <>
                  <Box sx={{ flexGrow: 1 }}>
                    {isViewingSelfCreated && !isWorkflowFinished && (
                      <Typography variant="body2" color="error.main" fontWeight="bold">
