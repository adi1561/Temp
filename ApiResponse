📦 1. The Wrapper (The "FedEx Box")
Create this file first. It defines the standard JSON structure for ALL responses.
File: org/example/demo1/DTO/ApiResponse.java
package org.example.demo1.DTO;

import lombok.Data;
import java.time.LocalDateTime;

@Data
public class ApiResponse<T> {

    private boolean success;
    private String message;
    private T data;
    private LocalDateTime timestamp;

    // Constructor 1: SUCCESS (We have data)
    public ApiResponse(boolean success, String message, T data) {
        this.success = success;
        this.message = message;
        this.data = data;
        this.timestamp = LocalDateTime.now();
    }

    // Constructor 2: ERROR (No data, just a message)
    public ApiResponse(boolean success, String message) {
        this.success = success;
        this.message = message;
        this.data = null;
        this.timestamp = LocalDateTime.now();
    }
}

