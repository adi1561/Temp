    setDownloadMsg("Downloading error report...");
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      validateAndSetFile(e.target.files[0]);
    }
  };

  const handleDragOver = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(true);
  };

  const handleDragLeave = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    e.stopPropagation();
    setIsDragging(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      validateAndSetFile(e.dataTransfer.files[0]);
      e.dataTransfer.clearData();
    }
  };

  const clearInput = () => {
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleClearFile = (e) => {
    if (e) e.stopPropagation();
    setFile(null);
    setIsCsvFile(false);
    clearInput();
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setIsProcessing(false);
    setIsErrorDownloaded(false);
    setBatchCreated(false);
  };
 const resetAll = () => {
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setIsCsvFile(false);
    setIsErrorDownloaded(false);
    setBatchCreated(false); 
    setFile(null);
    setPage(0);
    setDownloadMsg("Downloading error report...");
    clearInput();
    if (onReset) onReset(); // Tells JournalPosting.jsx to go back to Step 0
  };
  const handleBackNavigation = () => {
    if (onBack) onBack(); // Tells JournalPosting.jsx to go back to Step 1
  };

  const handleBack = () => {
    setActiveStep(0);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setDownloadMsg("Downloading error report...");
  };

  const downloadFileHelper = async (url, filename) => {
    try {
      const response = await callApi(url, null, "GET", "blob", null, {}, false);
      const blobData = response.data || response;
      if (!blobData) throw new Error("Empty response data");

      const blob = new Blob([blobData], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const link = document.createElement("a");
      const objectUrl = window.URL.createObjectURL(blob);
      link.href = objectUrl;
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(objectUrl);
      return true;
    } catch (e) {
      showSnackBar("File download failed.", "error");
      return false;
    }
  };

  const handleDownloadTemplate = (e) => {
    if (e) e.stopPropagation();
    downloadFileHelper("/JS/voucher/download-template", "Journal_Upload_Template.xlsx");
  };

  const handleDownloadFile = async (type, reqId = requestId) => {
    if (type === "ERROR") showSnackBar("Downloading error report...", "info");
    const success = await downloadFileHelper(
      `/JS/voucher/download-bulk-file/${reqId}?type=${type}`,
      type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv"
    );
    if (success && type === "SUCCESS") showSnackBar("Downloaded successfully.", "success");
    if (success && type === "ERROR") {
      setDownloadMsg("Error report downloaded.");
       setIsErrorDownloaded(true);
    }
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !selectedDate.isValid() || !file) {
      showSnackBar("Please select a valid date and file.", "warning");
      return;
    }
    triggerDebounce();
    setResultStatus(null);
    setResultMsg("");
    setValidationStage(0);
    setRequestId(null);     // FIX: Prevent the useEffect from polling the old ID
    setIsProcessing(true);
    setAutoDlTriggered(false);
    setDownloadMsg("Downloading error report...");

   const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate.format("DD/MM/YYYY"));
    if (scheduledTime) {
        formData.append("scheduledTime", scheduledTime.format('YYYY-MM-DD HH:mm:ss'));
    }

    // Automatically appends the globally selected VID to your upload request payload context
    if (selectedVoucher) {
      formData.append("vid", selectedVoucher.VID || selectedVoucher.vid);
    }

    try {
      const data = await callApi("/JS/voucher/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      if (data && data.requestId) {
        setRequestId(data.requestId);
      } else {
        throw new Error("Invalid response from server.");
      }
    } catch (err) {
      setIsProcessing(false);
      setResultStatus("ERROR");
      setResultMsg("Initialization failed: " + (err.message || "Unknown error"));
    }
  };


   const autoSubmitBatch = async (reqId) => {
    setIsCreatingBatch(true);
    try {
      const payload = {
        requestId: reqId,
        commonBatchRemarks: `Bulk Upload - ${selectedDate.format("YYYY-MM-DD")}`,
        postingDate: selectedDate.format("DD/MM/YYYY"),
        scheduledTime: scheduledTime ? scheduledTime.format('YYYY-MM-DD HH:mm:ss') : null,
        vid: selectedVoucher?.VID
      };
       const response = await callApi("/JS/voucher/create-batch-from-cache", payload, "POST");
      if (response && (response.status === "SUCCESS" || response.batchId)) {
        
        const newBatchId = response.batchId || "N/A";
        
        // Push the user to the brand new Schedule Screen (Step 3)!
        if (onSuccessSubmit) {
          onSuccessSubmit(newBatchId);
        } else {
          setBatchCreated(true);
        }
      } else {
        throw new Error(response.message || "Failed.");
      }
    } catch (e) {
      let msg = e.message || "Unknown error";
      if (e.response && e.response.data && e.response.data.message) {
        msg = e.response.data.message;
      }
      showSnackBar("Failed to submit batch: " + msg, "error");
    } finally {
      setIsCreatingBatch(false);
    }
  };

  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/voucher/bulk-status/${requestId}`, null, "GET");
          if (!res) return;
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setValidationStage(res.currentStage || 1);
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000);
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              handleDownloadFile("ERROR", res.requestId);
            }
          }   else if (res.status === "SUCCESS") {
            setResultStatus("SUCCESS");
            setValidationStage(4);
            setTotalRows(res.totalRows);
            clearInterval(interval);
            setIsProcessing(false);
            
            // Instantly trigger submission without an extra snackbar message
            autoSubmitBatch(res.requestId); 
          } else {
            setValidationStage(res.currentStage);
          }
        } catch (e) { }
      }, 800);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, autoDlTriggered, callApi, showSnackBar]);

  const handleChangePage = (event, newPage) => setPage(newPage);
  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const visibleRows = previewRows.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage);
  const isValidationStepFailed = (index) => {
    return resultStatus === "ERROR" && index === validationStage - 1;
  };
  if (isPageLoading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '80vh' }}>
        <CircularProgress size={60} />
      </Box>
    );
  }

  if (isEodRunning) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'top', height: '25vh', p: 3 }}>
        <Paper elevation={4} sx={{ p: 6, textAlign: 'center', borderRadius: 4, }}>
          <Typography variant="h4" color="error" fontWeight="bold" gutterBottom>
            EOD is Currently Running
          </Typography>
          <Typography variant="h6" color="text.secondary" sx={{ mt: 2 }}>
            Bulk Upload is temporarily disabled.
          </Typography>
          <Typography variant="body1" color="text.secondary" sx={{ mt: 1 }}>
            Please wait until the End of Day process completes to upload new transactions.
          </Typography>
        </Paper>
      </Box>
    );
  }

  // --- ORIGINAL UI RENDER (Cleaned up without activeSteps) ---
  return (
<Box sx={mainContainerStyle}>
      {/* --- STANDARDIZED HORIZONTAL SELECTION HEADER --- */}
      {selectedVoucher && (
        <Paper elevation={0} sx={{ p: 3, mb: 4, backgroundColor: "#f8fafc", borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: "1px solid", borderColor: "divider", pb: 1, mb: 2 }}>
            <Typography variant="subtitle1" fontWeight="bold" color="text.primary">
              Selected Voucher Details
            </Typography>
            <Button startIcon={<ArrowBackIcon />} onClick={handleBackNavigation} variant="outlined" size="small">
              Change Method
            </Button>
          </Box>
          
          <Grid container spacing={3}>
            <Grid item xs={12} sm={6}>
              <Typography variant="caption" color="text.secondary" display="block" gutterBottom>VID</Typography>
              <Typography variant="body1" fontWeight="bold" color="primary">{selectedVoucher.VID || selectedVoucher.vid}</Typography>
            </Grid>
            <Grid item xs={12} sm={6}>
              <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Category</Typography>
              <Typography variant="body1" fontWeight="500">{selectedVoucher.CATEGORY_NAME || selectedVoucher.category || "General"}</Typography>
            </Grid>
            <Grid item xs={12}>
              <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Description</Typography>
              <Box sx={{ backgroundColor: "white", p: 2, borderRadius: 1, border: "1px solid", borderColor: "divider" }}>
                <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>
                  {selectedVoucher.DESCRIPTION || selectedVoucher.description || "No description provided."}
                </Typography>
              </Box>
            </Grid>
          </Grid>
        </Paper>
      )}

      <Paper elevation={1} sx={controlPanelStyle}>

        <Box
          sx={{
            borderColor: resultStatus === "ERROR" ? "error.main" : "primary.main",
            opacity: (isProcessing || isCreatingBatch) ? 0.6 : 1,
          }}
        >
          <Box
            sx={{
              ...uploadBoxStyle,
              borderColor: isDragging ? "secondary.main" : (resultStatus === "ERROR" ? "error.main" : "primary.main"),
              backgroundColor: (theme) => isDragging ? alpha(theme.palette.primary.main, 0.12) : alpha(theme.palette.primary.main, 0.02),
              transform: isDragging ? "scale(1.01)" : "scale(1)",
            }}
            onDragOver={handleDragOver}
            onDragLeave={handleDragLeave}
            onDrop={handleDrop}
          >
            <Box sx={templateSectionStyle} onClick={(e) => e.stopPropagation()}>
              <Typography variant="caption" sx={{ display: "block", color: "text.secondary", fontWeight: 500, mb: 0.5 }}>
                Need assistance? Download the template (.xlsx)
              </Typography>
              <Button
                variant="outlined"
                size="small"
                startIcon={<FileDownloadIcon />}
                onClick={handleDownloadTemplate}
                sx={{ borderRadius: "8px", textTransform: "none" }}
              >
                Download Template
              </Button>
            </Box>
 <Box sx={boxCenterStyle}>
              <Box sx={{ position: "relative", textAlign: "center" }}>
                 <CloudUploadIcon sx={{ fontSize: "6rem", color: "primary.main", mb: 1 }} />
                <Typography sx={headerTextStyle}>
                  {file ? file.name : (isDragging ? "Drop file now" : "Drag or Browse the File")}
                </Typography>
                {!file && (
                  <Typography sx={subTextStyle}>
                    Supported file formats: {ALLOWED_FILE_TYPES.join(", ")} (Maximum Size: 50MB)
                  </Typography>
                )}
                
                {/* 1. RESTORED: The "Remove File" (X) button is back! */}
                {file && (
                  <Tooltip title="Remove File">
                    <IconButton
                      size="small"
                      onClick={handleClearFile}
                      sx={{
                        position: "absolute",
                        top: -10,
                        right: -40,
                        bgcolor: "background.paper",
                        "&:hover": { bgcolor: "error.light", color: "white" },
                      }}
                    >
                      <CloseIcon fontSize="small" />
                    </IconButton>
                  </Tooltip>
                )}
              </Box>
            </Box>


             <Box sx={{ ...boxCenterStyle, flexDirection: "row", alignItems: "flex-start", mt: 2 }} onClick={(e) => e.stopPropagation()}>
              
              {/* DatePicker Column */}
              <Box sx={{ display: "flex", flexDirection: "column", marginRight: "20px" }}>
                <Box sx={{ "& .MuiTextField-root": { minWidth: "250px" } }}>
                  <LocalizationProvider dateAdapter={AdapterDayjs}>
                    <DatePicker
                      label="Posting Date"
                      value={selectedDate}
                      onChange={(newValue) => {
                        if (allowManualDateSelection) setSelectedDate(newValue);
                      }}
                      disabled={isProcessing || isCreatingBatch}
                      readOnly={!allowManualDateSelection} 
                      minDate={dayjs().subtract(1, 'year')}
                      maxDate={dayjs()}
                      slotProps={{
                        textField: {
                          size: "small",
                          onKeyDown: (e) => e.preventDefault(),
                          helperText: file && !selectedDate ? "Please select a posting date" : "",
                          FormHelperTextProps: { sx: { color: "primary.main", fontWeight: 500 } },
                          sx: file && !selectedDate ? { "& .MuiOutlinedInput-root": { "& fieldset": { borderColor: "primary.main", borderWidth: "2px" } } } : {},
                          inputProps: { 
                            readOnly: true, 
                            sx: { cursor: allowManualDateSelection ? 'pointer' : 'default' } 
                          }
                        },
                      }}
                    />
                  </LocalizationProvider>
                </Box>
                
               
                <Typography
                  variant="caption"
                  sx={{ color: "#ec0101ff", mt: 0.8, textAlign: "left" }}
                >
                  Note: All Journals will be Posted on this Date
                </Typography>
              </Box>
              
              {/* Browse File Button Column */}

              {!file && (
                <Box>
                  <input
                    type="file"
                    hidden
                    ref={fileInputRef}
                    onChange={handleFileSelect}
                    onClick={(e) => (e.target.value = null)}
                    accept={ALLOWED_FILE_TYPES.join(",")}
                  />
                  <Button
                    sx={customButtonStyle}
                    variant="contained"
                    onClick={() => fileInputRef.current.click()}
                    disabled={isProcessing || isCreatingBatch}
                  >
                    Browse File
                  </Button>
                </Box>
              )}
            </Box>
          </Box>

          {(isProcessing || resultStatus) && (
            <Box sx={{ mt: 4, mb: 2 }}>
              <Stepper activeStep={validationStage - 1} alternativeLabel>
                {validationSteps.map((label, index) => {
                  const labelProps = {};
                  if (isValidationStepFailed(index)) {
                    labelProps.optional = <Typography variant="caption" color="error">Failed</Typography>;
                    labelProps.error = true;
                  }
                  return (
                    <Step key={label}>
                      <StepLabel {...labelProps}>{label}</StepLabel>
                    </Step>
                  );
                })}
              </Stepper>
            </Box>
          )}

          {resultStatus === "ERROR" && (
            <Alert
              severity="error"
              sx={{ 
                mt: 3, 
                mx: "auto", 
                maxWidth: "100%", 
                backgroundColor: "#fff5f5",  
                alignItems: "center"         
              }}
            >
              <Typography variant="body1" fontWeight="500">
                {resultMsg} {downloadMsg ? `— ${downloadMsg}` : ""}
              </Typography>
            </Alert>
          )}

          {batchCreated && (
            <Alert 
              severity="success" 
              sx={{ 
                mt: 3, 
                mx: "auto", 
                maxWidth: "100%", 
                backgroundColor: "transparent", 
                '& .MuiAlert-message': { width: '100%' } 
              }}
            >
              <Typography variant="body1" fontWeight="bold">Batch Successfully Validated and Submitted!</Typography>
              <Typography variant="body2">Total valid records processed: <strong>{totalRows.toLocaleString()}</strong>.</Typography>
            </Alert>
          )}

          <Stack direction="row" sx={{ ...actionButtonsContainer, alignItems: "center" }}>
            {/* Download CSV Button */}
            {batchCreated && !isCsvFile && (
              <Button
                variant="outlined"
                color="primary"
                size="large"
                startIcon={<FileDownloadIcon />}
                onClick={() => handleDownloadFile("SUCCESS")}
              >
                Download CSV
              </Button>
            )}

            {!batchCreated && (
              <Button
                variant="contained"
                size="large"
                onClick={handleStartValidation}
                disabled={!file || !selectedDate || isDebouncing || isProcessing || isCreatingBatch || isErrorDownloaded}
                startIcon={(isProcessing || isCreatingBatch) ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
              >
                {isProcessing ? "Validating..." : isCreatingBatch ? "Submitting..." : "Validate & Submit"}
              </Button>
            )}

            {batchCreated && (
              <Tooltip title="Clear and Upload New File" placement="top">
                <IconButton 
                  onClick={resetAll} 
                  color="primary" 
                  size="large"
                  sx={{ 
                    ml: 1, 
                    border: '1px solid', 
                    borderColor: 'primary.main',
                    bgcolor: (theme) => alpha(theme.palette.primary.main, 0.05),
                    '&:hover': {
                       bgcolor: (theme) => alpha(theme.palette.primary.main, 0.15),
                    }
                  }}
                >
                  <RestartAltIcon />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        </Box>
      </Paper>
    </Box>
  );
};

