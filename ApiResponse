        } else {
            // Move to next intermediate step
            Map<String, Object> nextStepInfo = jdbcTemplate.queryForMap(
                "SELECT WORKFLOW_ID, ALLOWED_ROLE_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?", 
                workflowCode, currentOrder + 1
            );
            
            Long nextStepId = ((Number) nextStepInfo.get("WORKFLOW_ID")).longValue();
            String nextRoleId = String.valueOf(nextStepInfo.get("ALLOWED_ROLE_ID"));

            posting.setPendingAt(nextStepId);
            logWorkflowAction(batchId, posting.getVidFk(), "Approved (" + currentStageName + ")", executorId, dto.getRemarks(), null);
            
            // --- NOTIFY NEXT CHECKER TIER ---
            // Passes executorId to exclude the person who just approved it from getting the next alert
            notificationWriterService.createNextStepApprovalNotification(batchId, executorId, nextRoleId);
        }

        voucherPostingRepository.save(posting);

