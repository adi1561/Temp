### 1. Update the DTOs (The Firewall)
By adding jakarta.validation.constraints (or javax.validation.constraints if you are on an older Spring Boot version), Spring will automatically block malicious payloads before they even reach your service layer.
Update your **BatchPostingDto.java** to include these exact annotations:
```java
import jakarta.validation.Valid;
import jakarta.validation.constraints.*;
import java.math.BigDecimal;
import java.util.List;
import lombok.Data;

@Data
public class BatchPostingDto {

    private String vid;
    private String scheduledTime;

    @Size(max = 30, message = "Common remarks cannot exceed 30 characters")
    private String commonBatchRemarks;

    @Valid // <-- Forces validation on the rows inside the list
    @NotEmpty(message = "Batch must contain at least one entry")
    private List<JournalRequestRow> rows;

    @Data
    public static class JournalRequestRow {
        @NotBlank(message = "Branch code is required")
        @Pattern(regexp = "^[0-9]{3,5}$", message = "Branch must be 3-5 digits")
        private String branch;

        @NotBlank(message = "Currency is required")
        @Size(min = 3, max = 3, message = "Currency must be exactly 3 characters")
        private String currency;

        @NotBlank(message = "CGL is required")
        @Pattern(regexp = "^[0-9]{10}$", message = "CGL must be exactly 10 digits")
        private String cgl;

        @NotNull(message = "Amount is required")
        @DecimalMin(value = "0.0001", message = "Amount must be greater than zero")
        @Digits(integer = 16, fraction = 4, message = "Amount exceeds precision bounds (Max 16 digits, 4 decimals)")
        private BigDecimal amount;

        @NotBlank(message = "Transaction type is required")
        @Pattern(regexp = "^(Debit|Credit)$", message = "Type must be 'Debit' or 'Credit'")
        private String txnType; // Maps to frontend row.txnType

        @Pattern(regexp = "^[0-9]{0,8}$", message = "Product code must be up to 8 digits")
        private String productType; // Maps to frontend row.productCode

        @NotBlank(message = "Remarks are mandatory")
        @Size(min = 2, max = 30, message = "Remarks must be 2-30 characters")
        @Pattern(regexp = "^[a-zA-Z0-9 ]+$", message = "Remarks contain invalid characters")
        private String remarks;
    }
}

```
