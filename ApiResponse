To achieve this exact visual behavior—where past steps are just a pure **Green Tick**, the current active step is a **Filled Circle with a Green Tick**, and future steps are grey dots—we need to stop fighting Material UI's default CSS overrides and simply give it a custom Icon Component.
This gives you 100% control over exactly what draws inside the stepper at every stage.
Here is the step-by-step implementation.
### Step 1: Add the Custom Icon Component & Adjust Connector
Place this code near the top of your JournalAuthorization.jsx file (right under your getTxnTypeColor function, around line 133). This replaces the old CustomConnector and adds the new CustomWorkflowIcon.
```javascript
// --- NEW: Custom Icon Logic ---
const CustomWorkflowIcon = (props) => {
  const { active, completed } = props;

  if (active) {
    // Current Step: Filled light-green circle, dark-green border, green tick inside
    return (
      <Box sx={{
        width: 24, height: 24, borderRadius: '50%',
        backgroundColor: '#e8f5e9', 
        border: '2px solid', borderColor: 'success.main',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        zIndex: 1
      }}>
        <CheckIcon sx={{ color: 'success.main', fontSize: 16, stroke: 'success.main', strokeWidth: 1 }} />
      </Box>
    );
  }
  if (completed) {
    // Past Steps: Just a bold green tick (no circle)
    return (
      <Box sx={{
        width: 24, height: 24,
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        zIndex: 1, backgroundColor: 'background.paper'
      }}>
        <CheckIcon sx={{ color: 'success.main', fontSize: 26, stroke: 'success.main', strokeWidth: 1 }} />
      </Box>
    );
  }
  // Future Steps: Simple grey dot
  return (
    <Box sx={{
      width: 12, height: 12, borderRadius: '50%',
      backgroundColor: 'text.disabled', zIndex: 1, m: '6px' // m:6px centers the 12px dot inside the 24px space
    }} />
  );
};

// --- UPDATED: Aligned to the new 24px Custom Icons ---
const CustomConnector = styled(StepConnector)(({ theme }) => ({
  [`&.${stepConnectorClasses.alternativeLabel}`]: {
    top: 12, // Exactly half of the 24px icon height
    left: 'calc(-50% + 12px)',
    right: 'calc(50% + 12px)',
  },
  [`&.${stepConnectorClasses.active}`]: {
    [`& .${stepConnectorClasses.line}`]: { borderColor: theme.palette.success.main },
  },
  [`&.${stepConnectorClasses.completed}`]: {
    [`& .${stepConnectorClasses.line}`]: { borderColor: theme.palette.success.main },
  },
  [`& .${stepConnectorClasses.line}`]: {
    borderColor: theme.palette.divider,
    borderTopWidth: 2,
    borderRadius: 1,
  },
}));

```
### Step 2: Update the Mini-Stepper (DataGrid)
Now we apply this new icon to the DataGrid. Find the workflowState column in your columns array and replace its renderCell with this greatly simplified version:
```javascript
    {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        const workflow = params.row.approvalWorkflow || "Workflow_3";
        const isRejected = state === "REJECTED";

        if (isRejected) {
          return (
            <Box sx={{ pl: 2, width: '100%', display: 'flex', justifyContent: 'flex-start' }}>
              <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />
            </Box>
          );
        }

        let stepLabels = ['L1', 'L2', 'L3', 'Final'];
        if (workflow === 'Workflow_4' || workflow === 'W2_4_APPROVERS') {
          stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];
        }

        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        else if (state.includes("L3")) activeStep = 2;
        else if (state.includes("L4")) activeStep = 3;

        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
          activeStep = stepLabels.length;
        }

        return (
          <Box sx={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'flex-start', pl: 2, height: '100%' }}>
            <Stepper
              activeStep={activeStep}
              alternativeLabel
              connector={<CustomConnector />} 
              sx={{ width: 'auto', mt: 0.5 }}
            >
              {stepLabels.map((label, index) => {
                // strict < and === logic ensures only past steps get the plain tick
                const isCompleted = index < activeStep; 
                const isCurrent = index === activeStep;
                
                return (
                  <Step 
                    key={label} 
                    completed={isCompleted}
                    active={isCurrent}
                    sx={{ flex: '0 0 40px', px: 0 }} 
                  >
                    {/* Apply the Custom Icon here! */}
                    <StepLabel StepIconComponent={CustomWorkflowIcon} sx={{ p: 0, m: 0 }} />
                  </Step>
                );
              })}
            </Stepper>
          </Box>
        );
      },
    },

