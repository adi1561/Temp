    @Override
    @Transactional
    public void cancelMyRequestsByBatchIdAsync(String batchId, String userId) {
        // Added CREATOR_ID check to prevent unauthorized users from locking other users' batches
        int updated = jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND CREATOR_ID = ? AND BATCH_STATUS IN ('PENDING', 'ERROR')", batchId, userId);

        if (updated == 0) {
            log.warn("DELETE_LOCK_FAIL_OR_UNAUTHORIZED | Batch: {} | User: {}", batchId, userId);
            throw new IllegalStateException("Batch not found, unauthorized, or already being processed.");
        }
        progressService.sendProgress(batchId, userId, 0, "PROCESSING", "Purging Batch Data...");
        self.executeAsyncBatchCancellation(batchId, userId);
    }

    @Override
    @Async("bulkExecutor")
    public void executeAsyncBatchCancellation(String batchId, String userId) {
        MDC.put("batchId", batchId);
        MDC.put("user", userId);
        long start = System.currentTimeMillis();

        try {
            progressService.sendProgress(batchId, userId, 20, "PROCESSING", "Purging Data Rows...");
            jdbcTemplate.execute("{call PURGE_JOURNAL_BATCH(?, ?)}", (CallableStatementCallback<Object>) cs -> {
                cs.setString(1, batchId);
                cs.setString(2, userId);
                cs.execute();
                return null;
            });

            logAudit(userId, "CANCEL_SUCCESS", "DELETE", "Purged Batch " + batchId);
            progressService.sendProgress(batchId, userId, 100, "COMPLETED", "Batch Deleted");
            sendNotification(userId, null, "Batch " + batchId + " deleted successfully.", batchId);
            log.info("BATCH_PURGE_COMPLETE | Batch: {} | Duration: {}ms", batchId, System.currentTimeMillis() - start);

        } catch (DataAccessException e) {
            log.error("PURGE_DB_ERROR | Batch: {} | Status: SQL operation failed", batchId);
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'PENDING', EXECUTOR_REMARKS = NULL WHERE BATCH_ID = ?", batchId);
            progressService.sendProgress(batchId, userId, 0, "FAILED", "Delete Failed: System error");
        } finally {
            MDC.clear();
        }
    }

