                          <Typography variant="body1" fontWeight="500">
                            {vidDetails.VID_CREATED_AT
                              ? new Date(
                                  vidDetails.VID_CREATED_AT
                                ).toLocaleString("en-IN", {
                                  dateStyle: "short",
                                  timeStyle: "short",
                                })
                              : "N/A"}
                          </Typography>
                        </Grid>
                      </Grid>
                    </Paper>

                    {/* SECTION 2: BATCH EXECUTION DETAILS + DOWNLOAD BUTTON */}
                    <Paper
                      elevation={0}
                      sx={{
                        p: 3,
                        borderRadius: 2,
                        width: "100%",
                        border: "1px solid",
                        borderColor: "divider",
                        display: "flex",
                        flexDirection: "column",
                      }}
                    >
                      <Typography
                        variant="subtitle1"
                        fontWeight="bold"
                        color="text.primary"
                        gutterBottom
                        sx={{
                          borderBottom: "1px solid",
                          borderColor: "divider",
                          pb: 1,
                          mb: 2,
                        }}
                      >
                        Voucher Details
                      </Typography>

                      <Grid container spacing={3} alignItems="center">
                        <Grid item xs={12} sm={3}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Created By
                          </Typography>
                          <Stack
                            direction="row"
                            spacing={1}
                            alignItems="center"
                          >
                            <AccountCircleIcon
                              sx={{ fontSize: 20, color: "text.secondary" }}
                            />
                            <Typography variant="body1" fontWeight="500">
                              {vidDetails.BATCH_CREATED_BY_NAME}{" "}
                              <Typography
                                component="span"
                                variant="caption"
                                color="text.secondary"
                              >
                                ({vidDetails.BATCH_CREATOR_ID})
                              </Typography>
                            </Typography>
                          </Stack>
                        </Grid>

                        <Grid item xs={12} sm={2}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Created At
                          </Typography>
                          <Typography variant="body1" fontWeight="500">
                            {vidDetails.BATCH_CREATED_AT
                              ? new Date(
                                  vidDetails.BATCH_CREATED_AT
                                ).toLocaleString("en-IN", {
                                  dateStyle: "short",
                                  timeStyle: "short",
                                })
                              : "N/A"}
                          </Typography>
                        </Grid>

                        <Grid item xs={12} sm={2}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            No. of Entries
                          </Typography>
                          <Typography
                            variant="body1"
                            fontWeight="600"
                            color="primary.main"
                          >
                            {viewingBatch?.requestCount || 0} 
                          </Typography>
                        </Grid>

                        <Grid item xs={12} sm={3}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Is Execution Scheduled?
                          </Typography>
                          <Typography
                            variant="body1"
                            fontWeight="500"
                            color={
                              vidDetails.SCHEDULED_TIME
                                ? "info.main"
                                : "text.primary"
                            }
                          >
                            {vidDetails.SCHEDULED_TIME
                              ? `Yes (${new Date(
                                  vidDetails.SCHEDULED_TIME
                                ).toLocaleString("en-IN", {
                                  dateStyle: "short",
                                  timeStyle: "short",
                                })})`
                              : "No"}
                          </Typography>
                        </Grid>

                        <Grid item xs={12} sm={2}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Download Voucher Batch
                          </Typography>
                          <Button
                            variant="outlined"
                            size="small"
                            startIcon={<FileDownloadIcon />}
                            onClick={handleDownloadExcel}
                            disabled={!viewingBatchId}
                            sx={{
                              borderColor: "#217346",
                              color: "#217346",
                              "&:hover": {
                                backgroundColor: "#e8f5e9",
                                borderColor: "#1e6b40",
                              },
                            }}
                          >
                            Download Batch
                          </Button>
                        </Grid>
                      </Grid>
                    </Paper>
                  </Stack>
                ) : null}
              </Box>

              {/* --- HORIZONTAL TIMELINE --- */}
              <Box
                sx={{
                  p: 4,
                  flexGrow: 1,
                  display: "flex",
                  flexDirection: "column",
                  justifyContent: "center",
                }}
              >
                <Typography
                  variant="subtitle1"
                  fontWeight="bold"
                  color="text.primary"
                  sx={{ mb: 3 }}
                >
                  Workflow Progress
                </Typography>
                {viewingBatchState === "REJECTED" ? (
                  <Alert
                    severity="error"
                    variant="filled"
                    sx={{ mt: 2, fontWeight: "bold" }}
                  >
                    This batch was REJECTED and the workflow has been
                    terminated.
                  </Alert>
                ) : isFetchingSteps ? (
                  <Box sx={{ display: "flex", justifyContent: "center", p: 3 }}>
                    <CircularProgress />
                  </Box>
                ) : dynamicSteps.length > 0 ? (
                  <Stepper
                    activeStep={
                      viewingBatchState === "POSTED" ||
                      viewingBatchState === "SCHEDULED" ||
                      viewingBatchState === "APPROVED" ||
                      viewingBatchState === "C" ||
                      viewingBatchState === "S"
                        ? dynamicSteps.length
                        : viewingBatchOrder - 1
                    }
                    alternativeLabel
                    connector={<BigConnector />}
                  >
                    {dynamicSteps.map((step, index) => {
                      const isFullyDone =
                        viewingBatchState === "POSTED" ||
                        viewingBatchState === "SCHEDULED" ||
                        viewingBatchState === "APPROVED" ||
                        viewingBatchState === "C" ||
                        viewingBatchState === "S";
                      const activeStepIndex = isFullyDone
                        ? dynamicSteps.length
                        : viewingBatchOrder - 1;
                      const isCompleted = index < activeStepIndex;
                      const isCurrent = index === activeStepIndex;

                      const escalationHours =
                        viewingBatch?.escalationTime || 24;
                      const hoursPending = viewingBatch
                        ? Math.abs(
                            new Date() - new Date(viewingBatch.requestDate)
                          ) / 36e5
                        : 0;
                      const isEscalated =
                        viewingBatchState !== "REJECTED" &&
                        activeStepIndex < dynamicSteps.length &&
                        hoursPending > escalationHours;

                      let statusFlag = "PENDING";
                      if (isCompleted) statusFlag = "COMPLETED";
                      if (isCurrent && viewingBatchState === "REJECTED")
                        statusFlag = "REJECTED";
                      else if (isCurrent && isEscalated)
                        statusFlag = "ESCALATED";
                      else if (isCurrent) statusFlag = "ACTIVE";

                      return (
                        <Step
                          key={step.state}
                          completed={isCompleted}
                          active={isCurrent}
                          sx={{
                            opacity:
                              viewingBatchState === "REJECTED" &&
                              index > activeStepIndex
                                ? 0.3
                                : 1,
