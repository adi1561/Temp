import React, { useState, useEffect, useCallback, useRef } from "react";
import {
  Box,
  Typography,
  Grid,
  TextField,
  Button,
  Paper,
  IconButton,
  MenuItem,
  CircularProgress,
  Autocomplete,
  Tooltip,
  Checkbox,
  FormControlLabel,
  Chip,
  FormHelperText
} from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";
import { debounce } from "lodash";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const initialRowState = {
  id: Date.now(),
  branch: null,
  currency: "",
  cgl: null,
  amount: "",
  txnType: "",
  remarks: "",
  productCode: "",
};

const formatBigIntForDisplay = (val) => {
  if (typeof val !== "bigint") {
    val = BigInt(val || 0);
  }
  const str = val.toString().padStart(5, "0");
  const integer = str.slice(0, -4);
  const fractional = str.slice(-4);
  return `${integer || "0"}.${fractional}`;
};

export default function JournalPosting() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [rows, setRows] = useState([initialRowState]);
  const [currencyOptions, setCurrencyOptions] = useState([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [commonBatchRemarks, setCommonBatchRemarks] = useState("");
  const [postingDate, setPostingDate] = useState("");
  const [checked, setChecked] = useState(false);

  // States to control search dropdown visibility
  const [activeBranchSearchId, setActiveBranchSearchId] = useState(null);
  const [activeCglSearchId, setActiveCglSearchId] = useState(null);

  const [branchSearch, setBranchSearch] = useState({
    loadingId: null,
    options: [],
  });
  const [cglSearch, setCglSearch] = useState({ 
    loadingId: null, 
    options: [] 
  });

  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        const dateResponse = await callApi(
          "/JS/journals/current-posting-date",
          null,
          "GET"
        );

        if (dateResponse) {
          try {
            const [year, month, day] = dateResponse.split("-");
            const formattedDate = `${day}-${month}-${year}`;
            setPostingDate(formattedDate);
          } catch (e) { 
            setPostingDate(dateResponse);
          }
        } else {
          showSnackBar("Failed to load official posting date.", "error");
          setPostingDate("Error");
        }

        const currencyResponse = await callApi("/CM/common-master/currency", null, "GET");
        if (currencyResponse?.success && Array.isArray(currencyResponse.data)) {
          setCurrencyOptions([...new Set(currencyResponse.data)]);
        } else {
          showSnackBar("Failed to load currencies.", "error");
        }
      } catch (error) {
        showSnackBar("An error occurred while loading page data.", "error");
      }
    };
    fetchInitialData();
  }, [callApi, showSnackBar]);

  // Filtering function: allows only a-z, A-Z, 0-9 and space
  const filterRemarks = (val) => val.replace(/[^a-zA-Z0-9 ]/g, "");
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];
    if (!lastRow.branch || !lastRow.currency || !lastRow.cgl || !lastRow.amount || !lastRow.txnType) {
      showSnackBar("Please fill all required fields (*) in the current row before adding a new one.", "warning");
      return;
    }
    const newRow = { ...initialRowState, id: Date.now(), remarks: checked ? commonBatchRemarks : "" };
    setRows([...rows, newRow]);
  };
  
  const handleCheckboxChange = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);
    setRows(rows.map((row) => ({ ...row, remarks: isChecked ? commonBatchRemarks : "" })));
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) setRows(rows.filter((row) => row.id !== id));
    else showSnackBar("Cannot delete the first row.", "warning");
  };

  const handleRowChange = (id, field, value) => {
    setRows(rows.map((row) => (row.id === id ? { ...row, [field]: value } : row)));
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length === 0) {
        setBranchSearch({ loadingId: null, options: [] });
        setActiveBranchSearchId(null);
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      setActiveBranchSearchId(rowId);
      try {
        const response = await callApi(`/JS/branches-journal/search?query=${encodeURIComponent(query)}`, null, "GET");
        setBranchSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        setBranchSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi]
  );

  const searchCgls = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length === 0) {
        setCglSearch({ loadingId: null, options: [] });
        setActiveCglSearchId(null);
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));
      setActiveCglSearchId(rowId);
      try { 
        const response = await callApi(`/JS/cgl-journal/search?query=${encodeURIComponent(query)}`, null, "GET");
        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi]
  );

  const handleSubmit = async () => {
    if (!isRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks are compulsory (2-30 characters).", "error");
      return;
    }
    
    setIsSubmitting(true);
    const cglCheck = new Map();
    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (!row.branch || !row.currency || !row.cgl || !row.amount || !row.txnType) {
        showSnackBar(`Row ${index + 1} is incomplete. Please fill all required fields.`, "error");
        setIsSubmitting(false);
        return;
      }

      // Duplicate Check
      const key = `${row.branch.code}-${row.currency}`;
      const cglNum = row.cgl.cglNumber;
      if (!cglCheck.has(key)) cglCheck.set(key, new Set());
      if (cglCheck.get(key).has(cglNum)) {
        showSnackBar(`Duplicate CGL entry: "${cglNum}" is used more than once for branch "${row.branch.name}" and currency "${row.currency}".`, "error");
        setIsSubmitting(false); return;
      }
      cglCheck.get(key).add(cglNum);

      // Totals & Memo Logic
      const isMemo = String(cglNum).startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";
      const [intPart = "0", fracPart = "0"] = (row.amount || "0").split(".");
      const amountAsBigInt = BigInt(intPart + fracPart.substring(0, 4).padEnd(4, "0"));
      const compositeKey = `${row.branch.code}-${row.currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n, branchName: row.branch.name, branchCode: row.branch.code, currency: row.currency, type });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);
      if (row.txnType === "Debit") currencyTotals.totalDebit += amountAsBigInt;
      else currencyTotals.totalCredit += amountAsBigInt;

      if (!branchEntryCheck.has(row.branch.code)) {
        branchEntryCheck.set(row.branch.code, { hasDebit: false, hasCredit: false, branchName: row.branch.name });
      }
      const bCheck = branchEntryCheck.get(row.branch.code);
      if (row.txnType === "Debit") bCheck.hasDebit = true;
      else bCheck.hasCredit = true;

      rowPayloads.push({
        branch: row.branch.code,
        currency: row.currency,
        cgl: row.cgl.cglNumber,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
      });
    }

    // Validation Loops
    for (const [code, totals] of branchEntryCheck.entries()) {
      if (!totals.hasDebit || !totals.hasCredit) {
        showSnackBar(`Branch "${totals.branchName}" (${code}) must have at least one Debit and one Credit entry.`, "error");
        setIsSubmitting(false); return;
      }
    }

    for (const totals of branchCurrencyTotals.values()) {
      if (totals.totalDebit !== totals.totalCredit) {
        showSnackBar(`Totals for ${totals.type} in branch "${totals.branchName}" and currency "${totals.currency}" do not match.`, "error");
        setIsSubmitting(false); return;
      }
    }

    try {
      const response = await callApi("/JS/journals/create-batch", { commonBatchRemarks: commonBatchRemarks.trim(), rows: rowPayloads }, "POST");
      showSnackBar(`Journal entries submitted successfully! Batch ID: ${response?.[0]?.batchId || "N/A"}`, "success");
      setRows([{ ...initialRowState, id: Date.now() }]);
      setCommonBatchRemarks("");
      setChecked(false);
    } catch (error) {
      showSnackBar("Journal Batch submission failed", "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Box sx={{ p: 3, maxWidth: "98%" }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: '12px' }}>
        <Box sx={{ mb: 3 }}>
          <Stack direction="row" spacing={1} alignItems="center">
            <Typography variant="body1" fontWeight="bold">Posting Date:</Typography>
            <Typography variant="body1" color="primary" fontWeight="bold">{postingDate}</Typography>
          </Stack>
          <Typography variant="caption" color="error" sx={{ fontWeight: 500 }}>
            Note: All journals will be posted on this date.
          </Typography>
        </Box>

        <Grid container sx={{ mb: 2 }}>
          <Grid item xs={12} md={8}>
            <TextField
              label="Common Batch Remarks *"
              value={commonBatchRemarks}
              onChange={(e) => {
                const filtered = filterRemarks(e.target.value);
                if (filtered.length <= 30) {
                  setCommonBatchRemarks(filtered);
                  if (checked) setRows(rows.map(r => ({ ...r, remarks: filtered })));
                }
              }}
              fullWidth
              required
              multiline
              rows={1}
              inputProps={{ maxLength: 30 }}
              error={commonBatchRemarks.length > 0 && !isRemarksValid(commonBatchRemarks)}
            />
            <FormHelperText sx={{ color: 'text.secondary' }}>
              Allowed: 2-30 characters (alphabets, numbers, and spaces only)
            </FormHelperText>
            <FormControlLabel
              control={<Checkbox checked={checked} onChange={handleCheckboxChange} disabled={!isRemarksValid(commonBatchRemarks)} />}
              label="Apply this remark to all transactions below"
            />
          </Grid>
        </Grid>

        <Box>
          {rows.map((row, index) => (
            <React.Fragment key={row.id}>
              <Grid container spacing={2} alignItems="flex-start" sx={{ mb: 1 }}>
                {/* Branch */}
                <Grid item xs={12} md={2.5}>
                  <Autocomplete
                    open={activeBranchSearchId === row.id && branchSearch.options.length > 0}
                    onOpen={() => {}}
                    onClose={() => setActiveBranchSearchId(null)}
                    autoHighlight
                    options={branchSearch.options}
                    getOptionLabel={(option) => `${option.code} - ${option.name}`}
                    value={row.branch}
                    onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
                    onInputChange={(event, newInputValue) => searchBranches(newInputValue, row.id)}
                    loading={branchSearch.loadingId === row.id}
                    filterOptions={(x) => x}
                    renderInput={(params) => (
                      <TextField
                        {...params}
                        label="Branch *"
                        InputLabelProps={{ shrink: true }}
                        placeholder="Type to search..."
                        InputProps={{
                          ...params.InputProps,
                          endAdornment: (
                            <React.Fragment>
                              {branchSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                              {params.InputProps.endAdornment}
                            </React.Fragment>
                          ),
                        }}
                      />
                    )}
                  />
                </Grid>

                {/* Currency */}
                <Grid item xs={12} md={1.3}>
                  <TextField
                    select
                    label="Currency *"
                    value={row.currency}
                    onChange={(e) => handleRowChange(row.id, "currency", e.target.value)}
                    fullWidth
                    SelectProps={{
                      MenuProps: {
                        PaperProps: { style: { maxHeight: 250 } },
                        anchorOrigin: { vertical: "bottom", horizontal: "left" },
                        transformOrigin: { vertical: "top", horizontal: "left" },
                      }
                    }}
                  >
                    {currencyOptions.map((c) => <MenuItem key={c} value={c}>{c}</MenuItem>)}
                  </TextField>
                </Grid>

                {/* CGL */}
                <Grid item xs={12} md={2.2}>
                  <Autocomplete
                    open={activeCglSearchId === row.id && cglSearch.options.length > 0}
                    onClose={() => setActiveCglSearchId(null)}
                    autoHighlight
                    options={cglSearch.options}
                    getOptionLabel={(option) => `${option.cglNumber} - ${option.description}`}
                    value={row.cgl}
                    onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                    onInputChange={(event, newInputValue) => searchCgls(newInputValue, row.id)}
                    loading={cglSearch.loadingId === row.id}
                    filterOptions={(x) => x}
                    renderInput={(params) => (
                      <TextField
                        {...params}
                        label="CGL *"
                        InputLabelProps={{ shrink: true }}
                        placeholder="Type to search..."
                        InputProps={{
                          ...params.InputProps,
                          endAdornment: (
                            <Box sx={{ display: "flex", alignItems: "center" }}>
                              {row.cgl && String(row.cgl.cglNumber).startsWith("5") && (
                                <Chip label="MEMO" size="small" color="warning" sx={{ height: 20, fontSize: "0.65rem", mr: 0.5 }} />
                              )}
                              {cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                              {params.InputProps.endAdornment}
                            </Box>
                          ),
                        }}
                      />
                    )}
                  />
                </Grid>

                {/* Amount */}
                <Grid item xs={12} md={1.5}>
                  <TextField
                    label="Amount *"
                    value={row.amount}
                    onChange={(e) => { if (/^\d{0,21}(\.\d{0,4})?$/.test(e.target.value)) handleRowChange(row.id, "amount", e.target.value); }}
                    fullWidth
                    placeholder="0.0000"
                  />
                </Grid>

                {/* Txn Type */}
                <Grid item xs={12} md={1.2}>
                  <TextField select label="Type *" value={row.txnType} onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)} fullWidth>
                    <MenuItem value="Debit">Debit</MenuItem>
                    <MenuItem value="Credit">Credit</MenuItem>
                  </TextField>
                </Grid>

                {/* Remarks (Individual) */}
                <Grid item xs={12} md={2.3}>
                  <TextField
                    label="Remarks *"
                    value={row.remarks}
                    onChange={(e) => {
                      const filtered = filterRemarks(e.target.value);
                      if (filtered.length <= 30) handleRowChange(row.id, "remarks", filtered);
                    }}
                    fullWidth
                    disabled={checked}
                    inputProps={{ maxLength: 30 }}
                    error={row.remarks.length > 0 && !isRemarksValid(row.remarks)}
                  />
                  <Typography variant="caption" sx={{ fontSize: '0.65rem', color: 'text.secondary' }}>
                    Allowed: 2-30 chars (A-Z, 0-9)
                  </Typography>
                </Grid>

                <Grid item xs={12} md={1} sx={{ textAlign: "center", pt: 1 }}>
                  <IconButton onClick={() => handleDeleteRow(row.id)} color="error" size="small"><DeleteIcon /></IconButton>
                </Grid>
              </Grid>
              {index < rows.length - 1 && <Box sx={{ borderBottom: 1, borderColor: "divider", my: 2 }} />}
            </React.Fragment>
          ))}

          <Box sx={{ mt: 4, display: "flex", gap: 2, justifyContent: "flex-end" }}>
            <Button variant="outlined" startIcon={<AddIcon />} onClick={handleAddRow}>Add Row</Button>
            <Button variant="contained" color="success" onClick={handleSubmit} disabled={isSubmitting || !isRemarksValid(commonBatchRemarks)}>
              {isSubmitting ? <CircularProgress size={24} /> : "Submit Journal"}
            </Button>
          </Box>
        </Box>
      </Paper>
    </Box>
  );
}
