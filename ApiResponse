  const handleSubmitAction = async (overrideLapse = false) => {
    if (!isRemarksValid(executorRemarks)) {
      showSnackBar("Remarks are compulsory (2-30 chars).", "warning");
      return;
    }
    setIsSubmitting(true);
    
    // Format the new schedule time if they provided one during a lapse override
    let formattedNewSchedule = null;
    if (overrideLapse && newScheduleTime) {
       const dateObj = new Date(newScheduleTime);
       formattedNewSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    try {
      const response = await callApi(
        "/JS/voucher/workflow/action", // <-- NEW ENDPOINT
        {
          batchId: selectedBatch.batchId,
          status: modalMode,
          remarks: executorRemarks.trim(),
          overrideScheduleLapse: overrideLapse,
          newScheduledTime: formattedNewSchedule
        },
        "POST"
      );

      showSnackBar(response?.message || "Workflow action processed successfully.", "success");

      handleCloseModal();
      setIsScheduleLapseModalOpen(false);
      setNewScheduleTime("");
      fetchPendingBatches();

    } catch (e) {
      // --- CATCH THE SCHEDULE LAPSE EDGE CASE ---
      if (e.response && e.response.status === 409) {
         setIsScheduleLapseModalOpen(true);
         setIsModalOpen(false); // Hide the standard modal
         setIsSubmitting(false);
         return;
      }

      let errorMsg = "Failed to process request.";
      if (e.response?.data?.message) {
        errorMsg = e.response.data.message;
      } else if (e.message) {
        errorMsg = e.message;
      }
      showSnackBar(errorMsg, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

```
