@Async("bulkExecutor")
public void processAsync(String requestId, String tempFilePath, String filename, LocalDate postingDate) {
    MDC.put("requestId", requestId);
    File tempFile = new File(tempFilePath);
    List<ExcelRowData> fullDataToValidate = new ArrayList<>(); // This will be processed in chunks now

    try {
        updateState(requestId, s -> s.setMessage("Streaming and Parsing..."));
        
        boolean isCsv = filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"));
        ParsingResult result;

        try (InputStream is = new FileInputStream(tempFile)) {
            // We pass a 'Consumer' that collects rows and periodically flushes them to your validation logic
            result = isCsv ? 
                parseCsvStream(is, postingDate, fullDataToValidate::add) : 
                parseExcelStream(is, postingDate, fullDataToValidate::add);
        }

        if (fullDataToValidate.isEmpty()) {
            throw new CustomExceptions.InvalidDataException("File data is empty.");
        }

        // Now run your existing validations on the processed data
        runFormatCheck(fullDataToValidate);
        if (fullDataToValidate.stream().anyMatch(ExcelRowData::hasErrors)) {
            failRequest(requestId, fullDataToValidate, "Format Validation Failed", 1, result.hasProductColumn);
            return;
        }

        // ... continue with runDbCheck and runBalanceCheck as before ...
        // (These now use the data we streamed into fullDataToValidate)

        completeRequest(requestId, fullDataToValidate, postingDate, isCsv, result.hasProductColumn);

    } catch (Exception e) {
        handleAsyncCrash(requestId, e.getMessage());
    } finally {
        if (tempFile.exists()) tempFile.delete();
        MDC.clear();
    }
}

