      {/* --- View Details Modal --- */}
      <Dialog
        open={isViewModalOpen}
        onClose={handleCloseViewModal}
        fullWidth
        maxWidth="md" // Made it slightly smaller since we don't have a wide table anymore
      >
        <DialogTitle sx={styles.dialogTitle}>
          <Typography variant="h6" fontWeight="bold">
            Batch Workflow Details: {viewingBatchId}
          </Typography>
          <IconButton onClick={handleCloseViewModal}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        
        <DialogContent dividers sx={{ p: 0 }}>
          <Box sx={{ minHeight: 350, display: "flex", flexDirection: "column" }}>

            {/* --- DETAILED LIVE STEPPER --- */}
            <Paper elevation={0} sx={{ p: 3, mb: 1, backgroundColor: "#f8f9fa", borderBottom: "1px solid", borderColor: "divider" }}>
              <Typography variant="subtitle1" fontWeight="bold" gutterBottom color="primary.main" sx={{ display: 'flex', alignItems: 'center' }}>
                <CheckIcon sx={{ mr: 1 }} /> Live Approval Progress
              </Typography>
              
              {viewingBatchState === "REJECTED" ? (
                <Alert severity="error" sx={{ mt: 2 }}>This batch was REJECTED and the workflow has been terminated.</Alert>
              ) : (
                <Box sx={{ width: '100%', mt: 4, mb: 3 }}>
                  <Stepper 
                    activeStep={
                      viewingBatchState.includes("L2") ? 1 :
                      viewingBatchState.includes("L3") ? 2 :
                      viewingBatchState.includes("L4") ? 3 :
                      (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED") ? 4 : 0
                    } 
                    alternativeLabel
                    connector={<CustomConnector />}
                  >
                    {[
                      { label: "Level 1 Approval", role: "TCSGLIF Checker" },
                      { label: "Level 2 Approval", role: "Pending Check" },
                      { label: "Level 3 Approval", role: "SBIGLIF Approver" },
                      { label: "Final Execution", role: "System / Sched." }
                    ].map((step, index) => {
                      let currentActive = 0;
                      if (viewingBatchState.includes("L2")) currentActive = 1;
                      if (viewingBatchState.includes("L3")) currentActive = 2;
                      if (viewingBatchState.includes("L4")) currentActive = 3;
                      if (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED") currentActive = 4;
                      
                      const isCompleted = currentActive > index;
                      const isCurrent = currentActive === index;

                      return (
                        <Step key={step.label}>
                          <StepLabel 
                            StepIconProps={{ 
                              sx: { 
                                width: 32, height: 32, 
                                color: isCompleted ? 'success.main' : (isCurrent ? 'primary.main' : 'text.disabled') 
                              } 
                            }}
                          >
                            <Typography variant="body1" sx={{ fontWeight: isCurrent ? 'bold' : 'normal', color: isCurrent ? 'primary.main' : 'text.primary' }}>
                              {step.label}
                            </Typography>
                            <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mt: 0.5 }}>
                              {step.role}
                            </Typography>
                          </StepLabel>
                        </Step>
                      );
                    })}
                  </Stepper>
                </Box>
              )}
            </Paper>

            {/* --- DOWNLOAD TO REVIEW CALL-TO-ACTION --- */}
            <Box sx={{ p: 4, textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", flexGrow: 1 }}>
               {/* You will need to import TableChartIcon at the top if you haven't: import TableChartIcon from '@mui/icons-material/TableChart'; */}
               <Box sx={{ p: 2, borderRadius: "50%", backgroundColor: "rgba(33, 115, 70, 0.1)", mb: 2 }}>
                 <FileDownloadIcon sx={{ fontSize: 50, color: "#217346" }} />
               </Box>
               <Typography variant="h6" fontWeight="bold" gutterBottom>Review Transaction Data</Typography>
               <Typography variant="body2" color="text.secondary" sx={{ mb: 4, maxWidth: 450 }}>
