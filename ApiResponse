To integrate these two workflows seamlessly without hardcoding multiple views into a single, bloated file, the standard enterprise architecture is to introduce a **Parent Router/Wizard file** (e.g., JournalPostingWizard.jsx).
This parent component manages the top-level stepper ('Select Voucher', 'Entry Method', 'Data Entry'), tracks the selected voucher payload globally, and conditionally swops your two specialized children files into step 2:
 * **JournalManualPosting.jsx** (Your manual data entry table file)
 * **JournalBulkUpload.jsx** (The file you just provided)
Here is how to reorganize your files and manage the stepper state smoothly.
### Step 1: Create the Parent Component (JournalPostingWizard.jsx)
Create a new file in features folder. This file will host the main activeStep control logic and serve as the single entry point.
```javascript
import React, { useState, useEffect, useRef } from "react";
import { Box, Stepper, Step, StepLabel, Paper, Typography } from "@mui/material";

// Import your sub-screens
import JournalVoucherSelection from "./JournalVoucherSelection";
import JournalEntryMethodSelection from "./JournalEntryMethodSelection";
import JournalManualPosting from "./JournalManualPosting"; // Your existing manual table code
import JournalBulkUpload from "./JournalBulkUpload"; // The code you just provided

const steps = ["Select Voucher", "Entry Method", "Data Entry"];

export default function JournalPostingWizard() {
  const [activeStep, setActiveStep] = useState(0);
  const [selectedVoucher, setSelectedVoucher] = useState(null);
  const [entryMethod, setEntryMethod] = useState(null); // 'MANUAL' or 'BULK'

  const handleNext = () => setActiveStep((prev) => prev + 1);
  const handleBack = () => setActiveStep((prev) => prev - 1);
  
  const handleReset = () => {
    setActiveStep(0);
    setSelectedVoucher(null);
    setEntryMethod(null);
  };

  return (
    <Box sx={{ p: 3, width: "100%" }}>
      {/* GLOBAL STEPPER HOISTED TO PARENT LEVEL */}
      <Paper elevation={0} sx={{ p: 3, mb: 4, borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
        <Stepper activeStep={activeStep} alternativeLabel>
          {steps.map((label) => (
            <Step key={label}>
              <StepLabel>{label}</StepLabel>
            </Step>
          ))}
        </Stepper>
      </Paper>

      {/* CONDITIONAL ROUTING BASED ON ACTIVE STEP */}
      <Box sx={{ mt: 2 }}>
        {activeStep === 0 && (
          <JournalVoucherSelection
            selectedVoucher={selectedVoucher}
            setSelectedVoucher={setSelectedVoucher}
            onNext={handleNext}
          />
        )}

        {activeStep === 1 && (
          <JournalEntryMethodSelection
            selectedVoucher={selectedVoucher}
            setEntryMethod={setEntryMethod}
            onNext={handleNext}
            onBack={handleBack}
          />
        )}

        {activeStep === 2 && (
          entryMethod === "MANUAL" ? (
            <JournalManualPosting 
              selectedVoucher={selectedVoucher} 
              onBack={handleBack} 
              onReset={handleReset}
            />
          ) : (
            <JournalBulkUpload 
              selectedVoucher={selectedVoucher} 
              onBack={handleBack} 
              onReset={handleReset}
            />
          )
        )}
      </Box>
    </Box>
  );
}

```
