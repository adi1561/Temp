export default function JournalAuthorization() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const isMounted = useRef(true);
  const [currentUserId, setCurrentUserId] = useState(null);
  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState([]);
  const [detailTotalCount, setDetailTotalCount] = useState(0);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [selectedBatch, setSelectedBatch] = useState(null);
  const [modalMode, setModalMode] = useState("ACCEPTED");
  const [executorRemarks, setExecutorRemarks] = useState("");
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [batchDetails, setBatchDetails] = useState([]);
  const [viewingBatch, setViewingBatch] = useState(null);
  const [isScheduleLapseModalOpen, setIsScheduleLapseModalOpen] = useState(false);
  const [newScheduleTime, setNewScheduleTime] = useState("");
  const [detailLoading, setDetailLoading] = useState(false);
  const [viewingBatchId, setViewingBatchId] = useState(null);
  const [viewingBatchCreatorId, setViewingBatchCreatorId] = useState(null);
  const [viewingBatchState, setViewingBatchState] = useState("");
  const [dynamicSteps, setDynamicSteps] = useState([]);
  const [isFetchingSteps, setIsFetchingSteps] = useState(false);
  const handleDownloadExcel = async () => {

    if (!viewingBatchId) {
      showSnackBar("Error: Batch ID is missing!", "error");
      return;
    }

    try {
      showSnackBar("Downloading Excel...", "info");

      const response = await callApi(
        `/JS/voucher/download-batch/${viewingBatchId}`,
        null,
        "GET",
        "blob",
        null,
        {},
        false
      );

      const blobData = response.data || response;
      if (!blobData) {
        throw new Error("No data received from backend");
      }

      const blob = new Blob([blobData], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
      const url = window.URL.createObjectURL(blob);

      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", `Batch_${viewingBatchId}.xlsx`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
      showSnackBar("Download complete.", "success");
    } catch (e) {
      console.error("Download failed:", e);
      let errorMsg = "Failed to download Excel file.";
      if (e.response && e.status === 404) {
        errorMsg = "API endpoint not found (404).";
      }
      showSnackBar(errorMsg, "error");
    }
  };

  useEffect(() => {
    isMounted.current = true;
    try {
      const auth =
        sessionStorage.getItem("persist:auth") ||
        localStorage.getItem("persist:auth");
      if (auth) {
        const user = JSON.parse(JSON.parse(auth).user);
        if (user?.userId) setCurrentUserId(String(user.userId));
      }
    } catch (e) { }
    return () => {
      isMounted.current = false;
    };
  }, []);

  const filterAndWarn = (val, type) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphanumeric and / & ( ) , . - are allowed.";

    if (type === "alphanumeric_space") {
      // 1. Strip any character that is NOT alphanumeric or in the allowed special chars list
      filtered = val.replace(/[^a-zA-Z0-9 ]/g, "");
      if (filtered !== val) {
        hasError = true;
      }

      // 2. Strip leading space and collapse double spaces (enforces the (?!.* {2}) regex rule)
      const beforeSpaceTrim = filtered;
      filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");
      if (beforeSpaceTrim !== filtered && !hasError) {
        hasError = true;
        msg = "Remark should not start with space or contain consecutive spaces.";
      }
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }
    return filtered;
  };
  const handleRemarksChange = (e, setter) => {
    const val = filterAndWarn(e.target.value, "alphanumeric_space");
    if (val.length <= 30) {
      setter(val);
    }
  };

  // Validation logic: Remarks are strictly compulsory (min 2, max 30)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;

  const isViewingSelfCreated =
    currentUserId &&
    viewingBatchCreatorId &&
    String(currentUserId).trim().toUpperCase() ===
    String(viewingBatchCreatorId).trim().toUpperCase();

  const isLargeBatch = detailTotalCount > 2000;

  const fetchPendingBatches = useCallback(async () => {
    setLoading(true);
    try {
      const data = await callApi(
        "/JS/voucher/checker/pending-approvals",
        null,
        "GET"
      );
      if (isMounted.current) setRows(Array.isArray(data) ? data : []);
    } catch (err) {
      if (isMounted.current && err.name !== "CanceledError")
        showSnackBar("Failed to load requests", "error");
    } finally {
      if (isMounted.current) setLoading(false);
    }
  }, [callApi, showSnackBar]);

  useEffect(() => {
    fetchPendingBatches();
  }, [fetchPendingBatches]);



  const fetchBatchDetailsPaginated = async (batchId, page, size) => {
    setDetailLoading(true);
    try {
      const res = await callApi(
        `/JS/voucher/by-batch-paginated/${batchId}?page=${page}&size=${size}`,
        null,
        "GET"
      );

      const contentArray = res?.content || (Array.isArray(res) ? res : []);

      if (contentArray && isMounted.current) {
        setDetailTotalCount(res?.totalElements || contentArray.length || 0);
        const journalGroups = new Map();

        contentArray.forEach((req, index) => {
          try {
            console.log("Backend Row Data in Authorization:", req);

            const jId = req.journalId || req.id || `UNKNOWN-${index}`;
            const prefix = String(jId).split("-")[0];

            const amountVal = parseFloat(req.amount || req.reqAmount) || 0;

            const row = {
              ...req,
              journalPrefix: prefix, // Save the distinct prefix
              amount: Math.abs(amountVal),
              transactionType: amountVal < 0 ? "Credit" : "Debit",
              branch: req.branchCode || req.reqBranchCode || "-",
              currency: req.currency || req.reqCurrency || "-",
              cgl: req.cgl || req.reqCgl || "-",
              remarks: req.narration || req.reqNarration || "-",
              product: req.productCode || req.reqProduct || "-",
            };

            // FIX: Group explicitly by Branch!
            if (!journalGroups.has(prefix)) journalGroups.set(prefix, []);
            journalGroups.get(prefix).push(row);

          } catch (e) {
            console.error("Failed to map row details:", req, e);
          }
        });
        setBatchDetails(Array.from(journalGroups.values()));
      }
    } catch (e) {
      if (isMounted.current) showSnackBar("Failed to load details", "error");
    } finally {
      if (isMounted.current) setDetailLoading(false);
    }
  };
  const handleOpenViewModal = async (row) => {
    setViewingBatch(row);
    setViewingBatchId(row.batchId);
    setViewingBatchCreatorId(String(row.creatorId));
    setViewingBatchState(row.workflowState || "PENDING_L1");

    setIsViewModalOpen(true);
    setIsFetchingSteps(true);

    try {
      // Dynamically fetch the steps from the DB based on this batch's workflow code!
      const workflowCode = row.approvalWorkflow || "Workflow_3";
      const stepsData = await callApi(`/JS/voucher/workflow/steps/${workflowCode}`, null, "GET");
      setDynamicSteps(Array.isArray(stepsData) ? stepsData : []);
    } catch (err) {
      console.error("Failed to load workflow steps", err);
      showSnackBar("Failed to load dynamic workflow steps.", "error");
    } finally {
      setIsFetchingSteps(false);
    }
  };
  const handleDetailPageChange = (event, newPage) => {
    setDetailPage(newPage);
    fetchBatchDetailsPaginated(viewingBatchId, newPage, detailRowsPerPage);
  };

  const handleDetailRowsPerPageChange = (event) => {
    const newSize = parseInt(event.target.value, 10);
    setDetailRowsPerPage(newSize);
    setDetailPage(0);
    fetchBatchDetailsPaginated(viewingBatchId, 0, newSize);
  };
  const calculateTimeElapsed = (startDateString) => {
    if (!startDateString) return "N/A";
    const start = new Date(startDateString);
    const now = new Date();

    const diffMs = Math.abs(now - start);
    const diffMins = Math.floor(diffMs / 60000);

    if (diffMins === 0) return "Just now";
    if (diffMins < 60) return `${diffMins} min`;

    const hours = Math.floor(diffMins / 60);
    const mins = diffMins % 60;
    return mins > 0 ? `${hours} hr ${mins} min` : `${hours} hr`;
  };

  const handleCloseViewModal = () => {
    setIsViewModalOpen(false);
    setBatchDetails([]);
    setViewingBatchId(null);
    setViewingBatchCreatorId(null);
    fetchPendingBatches();
  };

  const handleOpenModal = (batch, mode) => {
    setSelectedBatch(batch);
    setModalMode(mode);
    setExecutorRemarks("");
    setIsModalOpen(true);
  };

  const handleCloseModal = () => {
    if (isSubmitting) return;
    setIsModalOpen(false);
    setSelectedBatch(null);
  };
  const handleSubmitAction = async (overrideLapse = false) => {
    if (!isRemarksValid(executorRemarks)) {
      showSnackBar("Remarks are compulsory (2-30 chars).", "warning");
      return;
    }
    setIsSubmitting(true);

    // Format the new schedule time if they provided one during a lapse override
    let formattedNewSchedule = null;
    if (overrideLapse && newScheduleTime) {
      const dateObj = new Date(newScheduleTime);
      formattedNewSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    try {
      const response = await callApi(
        "/JS/voucher/workflow/action", // <-- NEW ENDPOINT
        {
          batchId: selectedBatch.batchId,
          status: modalMode,
          remarks: executorRemarks.trim(),
          overrideScheduleLapse: overrideLapse,
          newScheduledTime: formattedNewSchedule
        },
        "POST"
      );

      showSnackBar(response?.message || "Workflow action processed successfully.", "success");

      handleCloseModal();
      setIsScheduleLapseModalOpen(false);
      setNewScheduleTime("");
      fetchPendingBatches();

    } catch (e) {
      // --- CATCH THE SCHEDULE LAPSE EDGE CASE ---
      if (e.response && e.response.status === 409) {
        setIsScheduleLapseModalOpen(true);
        setIsModalOpen(false); // Hide the standard modal
        setIsSubmitting(false);
        return;
      }

      let errorMsg = "Failed to process request.";
      if (e.response?.data?.message) {
        errorMsg = e.response.data.message;
      } else if (e.message) {
        errorMsg = e.message;
      }
      showSnackBar(errorMsg, "error");
    } finally {
      setIsSubmitting(false);
    }
  };


  const columns = [
    {
      field: "batchId",
      headerName: "Batch ID",
      width: 125,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
    },
    {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        const workflow = params.row.approvalWorkflow || "Workflow_3";
        const isRejected = state === "REJECTED";

        if (isRejected) {
          return <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />;
        }

        let stepLabels = ['L1', 'L2', 'L3', 'Final'];
        if (workflow === 'Workflow_4' || workflow === 'W2_4_APPROVERS') {
          stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];
        }

        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        else if (state.includes("L3")) activeStep = 2;
        else if (state.includes("L4")) activeStep = 3;

        // FIX: Push activeStep PAST the array length so the final circle gets a Tick!
        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
          activeStep = stepLabels.length;
        }

        return (
          <Box sx={{ width: '100%', mt: 0.5 }}>
            <Stepper
              activeStep={activeStep}
              alternativeLabel
              connector={<CustomConnector />}
            >
              {stepLabels.map((label, index) => {
                // Determine if this specific step is completed
                const isCompleted = index <= activeStep;
                const isCurrent = index === activeStep;

                return (
                  <Step key={label} completed={isCompleted}>
                    <StepLabel
                      StepIconProps={{
                        sx: {
                          width: 22, // Slightly larger dots since the text is gone
                          height: 22,
                          color: isCompleted ? 'success.main' : 'text.disabled',
                          '&.Mui-completed': { color: 'success.main' },
                          '&.Mui-active': { color: isCompleted ? 'success.main' : 'primary.main' }
                        }
                      }}
                    />
                  </Step>
                );
              })}
            </Stepper>
          </Box>
        );
      },
    },
    {
      field: "creatorId",
      headerName: "Creator",
      width: 150,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (p) => (
        <Chip icon={<AccountCircleIcon />} label={p.value} size="small" />
      ),
    },
    {
      field: "requestDate",
      headerName: "Submitted On",
      width: 200,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (p) =>
        new Date(p.value).toLocaleString("en-IN", {
          dateStyle: "medium",
          timeStyle: "short",
        }),
    },

    {
      field: "requestCount",
      headerName: "No. of Entries",
      width: 220,  // Increased width to ensure visibility
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
    },

    {
      field: "actions",
      headerName: "Actions",
      flex: 1,
      minWidth: 150,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const isSelf =
          currentUserId &&
          params.row.creatorId &&
          String(currentUserId).trim().toUpperCase() ===
          String(params.row.creatorId).trim().toUpperCase();

        const state = params.row.workflowState || "";

        // FIX: Check if the workflow is fully completed or rejected
        const isDoneOrRejected = state === "POSTED" || state === "SCHEDULED" || state === "APPROVED" || state === "REJECTED";

        // Disable the buttons if it's the user's own batch OR if the process is already done
        const isActionDisabled = isSelf || isDoneOrRejected;

        return (
          <Stack direction="row" spacing={1} justifyContent="center">
            <Tooltip title="View Detailed Status">
              <IconButton onClick={() => handleOpenViewModal(params.row)} color="primary">
                <VisibilityIcon />
              </IconButton>
            </Tooltip>
            <Tooltip title={isActionDisabled ? "Action unavailable" : "Accept"}>
              <span>
                <IconButton
                  onClick={() => handleOpenModal(params.row, "ACCEPTED")}
                  color="success"
                  disabled={isActionDisabled}
                >
                  <CheckIcon />
                </IconButton>
              </span>
            </Tooltip>
            <Tooltip title={isActionDisabled ? "Action unavailable" : "Reject"}>
              <span>
                <IconButton
                  onClick={() => handleOpenModal(params.row, "REJECTED")}
                  color="error"
                  disabled={isActionDisabled}
                >
                  <ClearIcon />
                </IconButton>
              </span>
            </Tooltip>
          </Stack>
        );
      },
    },
  ];

  return (
    <Box sx={styles.mainContainer}>
      <DataGrid
        rows={rows}
        columns={columns}
        loading={loading}
        getRowId={(row) => row.batchId}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25]}
        disableColumnResize
        rowHeight={52}
        initialState={{
          pagination: { paginationModel: { page: 0, pageSize: 10 } },
        }}
        slots={{ noRowsOverlay: CustomNoRowsOverlay }}
        sx={styles.dataGridContainer}
      />

      {/* --- Main Grid Approve/Reject Dialog --- */}

      <Dialog
        open={isModalOpen}
        onClose={handleCloseModal}
        fullWidth
        maxWidth="sm"
      >
        <DialogTitle>
          {modalMode === "ACCEPTED" ? "Accept" : "Reject"} Batch ID
        </DialogTitle>
        <DialogContent>
          <DialogContentText>
            Please provide the remarks to {modalMode === "ACCEPTED" ? "Accept" : "Reject"} Batch ID{" "}
            <strong>{selectedBatch?.batchId}</strong>
          </DialogContentText>
          <TextField
            autoFocus
            required
            margin="dense"
            label="Remarks"
            fullWidth
            variant="standard"
            value={executorRemarks}
            onChange={(e) => handleRemarksChange(e, setExecutorRemarks)}
            disabled={isSubmitting}
            inputProps={{ maxLength: 30 }}
            error={executorRemarks.length > 0 && !isRemarksValid(executorRemarks)}
          />
          <Typography sx={styles.helperText}>
            Allowed 2-30 chars (alphabets, numbers)
          </Typography>
        </DialogContent>
        <DialogActions sx={styles.dialogActions}>
          <Button onClick={handleCloseModal} disabled={isSubmitting}>
            Cancel
          </Button>
          <Button
            onClick={() => handleSubmitAction(false)}
            variant="contained"
            color={modalMode === "ACCEPTED" ? "success" : "error"}
            disabled={isSubmitting || !isRemarksValid(executorRemarks)}
          >
            {isSubmitting ? <CircularProgress size={24} /> : (modalMode === "ACCEPTED" ? "Accept" : "Reject")}
          </Button>
        </DialogActions>
      </Dialog>


      {/* --- Schedule Lapsed Edge Case Modal --- */}
      <Dialog
        open={isScheduleLapseModalOpen}
        onClose={() => setIsScheduleLapseModalOpen(false)}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ color: "error.main", fontWeight: "bold" }}>
          Schedule Lapsed
        </DialogTitle>
        <DialogContent>
          <Alert severity="warning" sx={{ mb: 3 }}>
            The original scheduled execution time for this batch has passed.
          </Alert>
          <Typography variant="body1" gutterBottom>
            Do you want to post this batch <strong>immediately</strong>, or set a <strong>new future schedule</strong>?
          </Typography>

          <Paper elevation={0} sx={{ p: 2, mt: 3, backgroundColor: "action.hover", border: "1px dashed", borderColor: "divider" }}>
            <Typography variant="subtitle2" gutterBottom>Optional: Set New Schedule</Typography>
            <TextField
              type="datetime-local"
              size="small"
              fullWidth
              InputLabelProps={{ shrink: true }}
              value={newScheduleTime}
              onChange={(e) => setNewScheduleTime(e.target.value)}
              inputProps={{ min: new Date().toISOString().slice(0, 16) }}
            />
            <FormHelperText>Leave blank to post immediately upon acceptance.</FormHelperText>
          </Paper>
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button onClick={() => setIsScheduleLapseModalOpen(false)} color="inherit">
            Cancel
          </Button>
          <Button
            onClick={() => handleSubmitAction(true)}
            variant="contained"
            color="primary"
            disabled={isSubmitting}
          >
            {isSubmitting ? <CircularProgress size={20} color="inherit" /> : "Confirm & Proceed"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* --- View Details Modal --- */}
      <Dialog
        open={isViewModalOpen}
        onClose={handleCloseViewModal}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle sx={styles.dialogTitle}>
          <Typography variant="h6" fontWeight="bold">
            Batch Workflow Details: {viewingBatchId}
          </Typography>
          <IconButton onClick={handleCloseViewModal}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>

        <DialogContent dividers sx={{ p: 0, backgroundColor: "#f8fafc" }}>
          <Box sx={{ minHeight: 350, display: "flex", flexDirection: "column" }}>

            {/* --- PROFESSIONAL HEADER CARD --- */}
            <Box sx={{ p: 3, backgroundColor: "white", borderBottom: "1px solid", borderColor: "divider" }}>
              <Grid container spacing={2} alignItems="center">
                <Grid item xs={12} sm={6}>
                  <Typography variant="body2" color="text.secondary">Creator ID</Typography>
                  <Typography variant="subtitle1" fontWeight="bold">
                    <AccountCircleIcon sx={{ fontSize: 18, verticalAlign: "middle", mr: 0.5, color: "primary.main" }} />
                    {viewingBatchCreatorId}
                  </Typography>
                </Grid>
                <Grid item xs={12} sm={6} sx={{ textAlign: { sm: "right" } }}>

                </Grid>
              </Grid>
            </Box>

            {/* --- HORIZONTAL TIMELINE --- */}
            <Box sx={{ p: 4, flexGrow: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
              {viewingBatchState === "REJECTED" ? (
                <Alert severity="error" variant="filled" sx={{ mt: 2, fontWeight: "bold" }}>
                  This batch was REJECTED and the workflow has been terminated.
                </Alert>
              ) : isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 3 }}><CircularProgress /></Box>
              ) : dynamicSteps.length > 0 ? (
                <Stepper
                  activeStep={
                    (viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED")
                      ? dynamicSteps.length
                      : dynamicSteps.findIndex(s => s.state === viewingBatchState)
                  }
                  alternativeLabel
                  connector={<CustomConnector />}
                >
                  {dynamicSteps.map((step, index) => {
                    const isFullyDone = viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED";
                    const currentIndex = dynamicSteps.findIndex(s => s.state === viewingBatchState);

                    const isCompleted = isFullyDone || index <= currentIndex;
                    const isCurrent = !isFullyDone && index === currentIndex;

                    return (
                      <Step key={step.state} completed={isCompleted}>
                        <StepLabel
                          StepIconProps={{
                            sx: {
                              width: 32, height: 32,
                              color: isCompleted ? 'success.main' : 'text.disabled',
                              '&.Mui-completed': { color: 'success.main' },
                              '&.Mui-active': { color: isCompleted ? 'success.main' : 'primary.main' }
                            }
                          }}
                        >
                          <Typography variant="subtitle2" sx={{ fontWeight: isCurrent ? 'bold' : 'normal', color: isCurrent ? 'primary.main' : 'text.primary', mt: 1 }}>
                            {step.label}
                          </Typography>

                          <Chip
                            label={step.role}
                            size="small"
                            variant={isCurrent ? "filled" : "outlined"}
                            color={isCurrent ? "primary" : "default"}
                            sx={{ mt: 1, height: 22, fontSize: "0.65rem", fontWeight: "bold" }}
                          />

                          {/* Show time pending underneath the active step */}
                          {isCurrent && (
                            <Typography variant="caption" display="block" color="warning.main" fontWeight="bold" sx={{ mt: 1 }}>
                              Pending: {calculateTimeElapsed(viewingBatch?.requestDate)}
                            </Typography>
                          )}
                        </StepLabel>
                      </Step>
                    );
                  })}
                </Stepper>
              ) : (
                <Alert severity="info" sx={{ mt: 2 }}>Workflow configuration not found.</Alert>
              )}
            </Box>

            {/* --- PROFESSIONAL DOWNLOAD FOOTER --- */}
            <Box sx={{ p: 2, backgroundColor: "white", borderTop: "1px solid", borderColor: "divider", display: "flex", justifyContent: "flex-end" }}>
              <Button
                variant="outlined"
                startIcon={<FileDownloadIcon />}
                onClick={handleDownloadExcel}
                disabled={!viewingBatchId}
                sx={{ borderColor: "#217346", color: "#217346", "&:hover": { borderColor: "#1e6b40" } }}
              >
                Download Full Batch Report
              </Button>
            </Box>

          </Box>
        </DialogContent>
      </Dialog>
    </Box>
  );
}
