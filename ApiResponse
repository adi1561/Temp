import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.apache.poi.xssf.usermodel.XSSFRichTextString;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public byte[] generateExcelTemplateWithGuidelines() throws IOException {
    try (Workbook workbook = new XSSFWorkbook()) {

        // ==============================================================================
        // SHEET 1: GUIDELINES & VALIDATION STAGES
        // ==============================================================================
        Sheet guidelineSheet = workbook.createSheet("Upload Guidelines");
        guidelineSheet.setColumnWidth(0, 10000); // Stage Name Column
        guidelineSheet.setColumnWidth(1, 35000); // Details Column

        // --- 1. Define Professional Fonts & Colors ---
        Font headerFont = workbook.createFont();
        headerFont.setBold(true);
        headerFont.setColor(IndexedColors.WHITE.getIndex());
        headerFont.setFontHeightInPoints((short) 11);

        Font boldRed = workbook.createFont();
        boldRed.setBold(true);
        boldRed.setColor(IndexedColors.DARK_RED.getIndex());

        Font boldGreen = workbook.createFont();
        boldGreen.setBold(true);
        boldGreen.setColor(IndexedColors.DARK_GREEN.getIndex());

        Font boldBlue = workbook.createFont();
        boldBlue.setBold(true);
        boldBlue.setColor(IndexedColors.DARK_BLUE.getIndex());

        // --- 2. Define Cell Styles (With Borders for a clean look) ---
        CellStyle headerStyle = workbook.createCellStyle();
        headerStyle.setFillForegroundColor(IndexedColors.DARK_BLUE.getIndex());
        headerStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);
        headerStyle.setFont(headerFont);
        headerStyle.setAlignment(HorizontalAlignment.LEFT);
        headerStyle.setVerticalAlignment(VerticalAlignment.CENTER);
        headerStyle.setBorderBottom(BorderStyle.MEDIUM);
        headerStyle.setBorderTop(BorderStyle.MEDIUM);
        headerStyle.setBorderLeft(BorderStyle.MEDIUM);
        headerStyle.setBorderRight(BorderStyle.MEDIUM);

        CellStyle bodyStyle = workbook.createCellStyle();
        bodyStyle.setWrapText(true);
        bodyStyle.setVerticalAlignment(VerticalAlignment.TOP);
        bodyStyle.setBorderBottom(BorderStyle.THIN);
        bodyStyle.setBorderTop(BorderStyle.THIN);
        bodyStyle.setBorderLeft(BorderStyle.THIN);
        bodyStyle.setBorderRight(BorderStyle.THIN);

        // --- 3. Build Guidelines Header ---
        Row titleRow = guidelineSheet.createRow(0);
        titleRow.setHeightInPoints(26);
        Cell titleCellA = titleRow.createCell(0);
        Cell titleCellB = titleRow.createCell(1);
        titleCellA.setCellValue("VALIDATION STAGE");
        titleCellB.setCellValue("STAGE REQUIREMENTS & COLUMN-WISE FORMAT DETAILS");
        titleCellA.setCellStyle(headerStyle);
        titleCellB.setCellStyle(headerStyle);

        // --- 4. Stage 1: Dynamic Rich Text Generation ---
        Row stage1Row = guidelineSheet.createRow(1);
        stage1Row.setHeightInPoints(180); // Fixed height to fit all text beautifully
        
        Cell s1Title = stage1Row.createCell(0);
        s1Title.setCellValue("Stage 1: Format Validation\n(Pre-Database Check)");
        s1Title.setCellStyle(bodyStyle);

        String stage1Text = 
            "Verifies structural and data-type integrity before hitting the core database. Every cell must comply:\n\n" +
            " • Branch* - Mandatory. String format. Clean, numeric branch code identifier (strictly 4-digits, e.g., '1001').\n" +
            " • Currency* - Mandatory. String format. Standard 3-letter alphabetic ISO code (e.g., 'INR', 'USD').\n" +
            " • CGL* - Mandatory. String format. Core General Ledger identifier. Exactly a 10-digit numerical string.\n" +
            " • Amount* - Mandatory. Numeric layout. Valid non-zero amount. No commas or text (e.g., '55000.00').\n" +
            " • Type* - Mandatory. Single-character marker. Strictly 'D' (Debit) or 'C' (Credit).\n" +
            " • Product Code - Optional. Alphanumeric string. Max 20 characters length.\n" +
            " • Remarks* - Mandatory. Text string for business narration. Min 3, Max 255 characters.";

        XSSFRichTextString richText = new XSSFRichTextString(stage1Text);

        // Dynamic Highlighting Helper (Finds all occurrences automatically)
        applyHighlighting(richText, stage1Text, "Mandatory", boldRed);
        applyHighlighting(richText, stage1Text, "Optional", boldGreen);
        applyHighlighting(richText, stage1Text, "Branch*", boldBlue);
        applyHighlighting(richText, stage1Text, "Currency*", boldBlue);
        applyHighlighting(richText, stage1Text, "CGL*", boldBlue);
        applyHighlighting(richText, stage1Text, "Amount*", boldBlue);
        applyHighlighting(richText, stage1Text, "Type*", boldBlue);
        applyHighlighting(richText, stage1Text, "Product Code", boldBlue);
        applyHighlighting(richText, stage1Text, "Remarks*", boldBlue);

        Cell s1Desc = stage1Row.createCell(1);
        s1Desc.setCellValue(richText);
        s1Desc.setCellStyle(bodyStyle);

        // --- 5. Stage 2 & 3 Setup ---
        Row stage2Row = guidelineSheet.createRow(2);
        stage2Row.setHeightInPoints(40);
        createStyledCell(stage2Row, 0, "Stage 2: Database Integrity Check", bodyStyle);
        createStyledCell(stage2Row, 1, "Cross-references record fields against active system reference masters. Validates that the requested Branch Code, Currency Identifier, and CGL exist and are active in the database.", bodyStyle);

        Row stage3Row = guidelineSheet.createRow(3);
        stage3Row.setHeightInPoints(40);
        createStyledCell(stage3Row, 0, "Stage 3: Balance Verification", bodyStyle);
        createStyledCell(stage3Row, 1, "Applies balanced ledger control rules. Aggregates values row-by-row ensuring total active Debits equal total Credits exactly prior to allowing final scheduling submission.", bodyStyle);

        // ==============================================================================
        // SHEET 2: EXCEL JOURNAL TEMPLATE
        // ==============================================================================
        Sheet templateSheet = workbook.createSheet("Journal Template");
        templateSheet.createFreezePane(0, 1); // FREEZES THE HEADER ROW!

        String[] headers = {"Branch*", "Currency*", "CGL*", "Amount*", "Type*", "Product Code", "Remarks*"};
        
        Row templateHeaderRow = templateSheet.createRow(0);
        templateHeaderRow.setHeightInPoints(24);
        for (int i = 0; i < headers.length; i++) {
            Cell cell = templateHeaderRow.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
            templateSheet.setColumnWidth(i, 5500); 
        }

        // --- Professional Sample Data Row ---
        CellStyle sampleStyle = workbook.createCellStyle();
        Font italicFont = workbook.createFont();
        italicFont.setItalic(true);
        italicFont.setColor(IndexedColors.GREY_50_PERCENT.getIndex());
        sampleStyle.setFont(italicFont);
        sampleStyle.setFillForegroundColor(IndexedColors.LIGHT_YELLOW.getIndex());
        sampleStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);

        Row sampleRow = templateSheet.createRow(1);
        createStyledCell(sampleRow, 0, "1001", sampleStyle);
        createStyledCell(sampleRow, 1, "INR", sampleStyle);
        createStyledCell(sampleRow, 2, "1102003001", sampleStyle);
        
        Cell amtCell = sampleRow.createCell(3);
        amtCell.setCellValue(55000.00); 
        amtCell.setCellStyle(sampleStyle);
        
        createStyledCell(sampleRow, 4, "D", sampleStyle);
        createStyledCell(sampleRow, 5, "PRD099", sampleStyle);
        createStyledCell(sampleRow, 6, "Sample bulk upload entry row (Overwrite this)", sampleStyle);

        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        workbook.write(bos);
        return bos.toByteArray();
    }
}

