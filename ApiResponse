    @Override
    @Transactional
    public void cancelMyRequestsByBatchIdAsync(String batchId, String userId) {
        // Added CREATOR_ID check to prevent unauthorized users from locking other users' batches
        int updated = jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ? AND CREATOR_ID = ? AND BATCH_STATUS IN ('PENDING', 'ERROR')", batchId, userId);

        if (updated == 0) {
            log.warn("DELETE_LOCK_FAIL_OR_UNAUTHORIZED | Batch: {} | User: {}", batchId, userId);
            throw new IllegalStateException("Batch not found, unauthorized, or already being processed.");
        }
        progressService.sendProgress(batchId, userId, 0, "PROCESSING", "Purging Batch Data...");
        self.executeAsyncBatchCancellation(batchId, userId);
    }

    @Override
    public List<Map<String, Object>> getPendingBatchSummaries(Integer userRole) {
        String sql = """
            SELECT 
                b.BATCH_ID, b.CREATOR_ID, b.REQ_DATE, b.BATCH_REMARKS, 
                b.TOTAL_ROWS, b.TOTAL_DEBIT, b.TOTAL_CREDIT, 
                p.CURRENT_STATUS, p.NEXT_APPROVAL_ROLE_ID
            FROM JOURNAL_BATCH_MASTER b
            INNER JOIN VOUCHER_POSTING p ON b.BATCH_ID = p.BATCH_ID
           WHERE p.NEXT_APPROVAL_ROLE_ID = ? 
            ORDER BY b.REQ_DATE DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
