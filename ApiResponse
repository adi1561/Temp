        if (activeStep === -1) activeStep = 0;

        // --- NEW: Escalation Calculation ---
        const escalationHours = params.row.escalationTime || 24;
        const hoursPending =
          Math.abs(new Date() - new Date(params.row.requestDate)) / 36e5;
        const isEscalated =
          !isRejected &&
          activeStep < stepLabels.length &&
          hoursPending > escalationHours;

        return (
          <Box
            sx={{
