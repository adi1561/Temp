// REPLACE (Dynamic Upload Box):
<Box sx={{ ...uploadBoxStyle, borderColor: isDragging ? "secondary.main" : (resultStatus === "ERROR" ? "error.main" : "primary.main"), backgroundColor: (theme) => isDragging ? alpha(theme.palette.primary.main, 0.12) : alpha(theme.palette.primary.main, 0.02), transform: isDragging ? "scale(1.01)" : "scale(1)", }} onDragOver={handleDragOver} onDragLeave={handleDragLeave} onDrop={handleDrop}>
// WITH:
<Box sx={jbuStyles.uploadBox(isDragging, resultStatus === "ERROR")} onDragOver={handleDragOver} onDragLeave={handleDragLeave} onDrop={handleDrop}>

