import React, { useState, useEffect, useRef } from "react";
import { Box, Stepper, Step, StepLabel, Paper, Typography } from "@mui/material";
import VoucherSelection from "./VoucherSelection";

// Import your sub-screens


const steps = ["Select Voucher", "Entry Method", "Data Entry"];

export default function JournalPostingWizard() {
  const [activeStep, setActiveStep] = useState(0);
  const [selectedVoucher, setSelectedVoucher] = useState(null);
  const [entryMethod, setEntryMethod] = useState(null); // 'MANUAL' or 'BULK'

  const handleNext = () => setActiveStep((prev) => prev + 1);
  const handleBack = () => setActiveStep((prev) => prev - 1);
  
  const handleReset = () => {
    setActiveStep(0);
    setSelectedVoucher(null);
    setEntryMethod(null);
  };

  return (
    <Box sx={{ p: 3, width: "100%" }}>
      {/* GLOBAL STEPPER HOISTED TO PARENT LEVEL */}
      <Paper elevation={0} sx={{ p: 3, mb: 4, borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
        <Stepper activeStep={activeStep} alternativeLabel>
          {steps.map((label) => (
            <Step key={label}>
              <StepLabel>{label}</StepLabel>
            </Step>
          ))}
        </Stepper>
      </Paper>

      {/* CONDITIONAL ROUTING BASED ON ACTIVE STEP */}
      <Box sx={{ mt: 2 }}>
        {activeStep === 0 && (
          <VoucherSelection
            selectedVoucher={selectedVoucher}
            setSelectedVoucher={setSelectedVoucher}
            onNext={handleNext}
          />
        )}

        {activeStep === 1 && (
          <JournalEntryMethodSelection
            selectedVoucher={selectedVoucher}
            setEntryMethod={setEntryMethod}
            onNext={handleNext}
            onBack={handleBack}
          />
        )}

        {activeStep === 2 && (
          entryMethod === "MANUAL" ? (
            <JournalManualPosting 
              selectedVoucher={selectedVoucher} 
              onBack={handleBack} 
              onReset={handleReset}
            />
          ) : (
            <JournalBulkUpload 
              selectedVoucher={selectedVoucher} 
              onBack={handleBack} 
              onReset={handleReset}
            />
          )
        )}
      </Box>
    </Box>
  );
}
