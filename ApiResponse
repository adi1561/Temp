### 3. Currency Update
```jsx
{/* Currency */}
<Grid item size={{ xl: 1.5, lg: 2 }}>
  <Autocomplete
    disableClearable
    autoHighlight 
    // autoSelect REMOVED
    options={currencyOptions}
    value={row.currency || null}
    onChange={(event, newValue) => {
      handleRowChange(row.id, "currency", newValue || "");
      handleRowChange(row.id, "amount", "");
    }}
    // --- ADDED INTERCEPTOR FOR TAB KEY ---
    onKeyDown={(e) => {
      if (e.key === 'Tab' && !row.currency) {
        const inputVal = e.target.value; 
        if (inputVal && inputVal.trim() !== "") {
          // Find the first option that matches what they typed
          const match = currencyOptions.find(c => c.toLowerCase().includes(inputVal.trim().toLowerCase()));
          if (match) {
            handleRowChange(row.id, "currency", match);
            handleRowChange(row.id, "amount", ""); 
          }
        }
      }
    }}
    filterOptions={(options, params) => {
      const { inputValue } = params;
      if (inputValue.trim().length === 0) return [];
      return options.filter((option) =>
        option.toLowerCase().includes(inputValue.toLowerCase())
      );
    }}
    noOptionsText="Type to search..."
    slotProps={{
      popper: { modifiers: [{ name: 'flip', enabled: true }, { name: 'preventOverflow', enabled: true }] }
    }}
    renderInput={(params) => (
      <TextField
        {...params}
        label="Currency *"
        placeholder={!row.currency ? "Search..." : ""}
        InputLabelProps={{ shrink: true }}
        inputProps={{
          ...params.inputProps,
          maxLength: 3,
          style: { textTransform: 'uppercase' }
        }}
      />
    )}
  />
</Grid>

```
### Why this fixes it:
By removing autoSelect, the default behavior of simply clicking on another part of the page will clear the input (which is exactly what a user expects when they abort typing). The onKeyDown hook explicitly watches for the Tab key and updates your state using the very first array item [0] immediately before the browser shifts focus to the next element.
