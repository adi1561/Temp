import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

public class BankSynchronizationDemo {

    // Our shared data
    private int unsafeBalance = 0;
    private int safeBalance = 0;

    // The physical padlock object for our synchronized block
    private final Object lock = new Object();

    // ---------------------------------------------------------
    // SCENARIO 1: NO SYNCHRONIZATION (The Danger Zone)
    // ---------------------------------------------------------
    public void depositUnsafe() {
        // Read the current balance
        int currentBalance = unsafeBalance;

        // Force the OS to time-slice/pause this thread for 1 millisecond!
        // This guarantees a massive race condition because other threads 
        // will rush in while this thread is asleep.
        try {
            Thread.sleep(1);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        // Write the new balance
        unsafeBalance = currentBalance + 1;
    }

    // ---------------------------------------------------------
    // SCENARIO 2: WITH SYNCHRONIZED BLOCK (The Vault)
    // ---------------------------------------------------------
    public void depositSafe() {
        // Only one thread at a time can grab this lock and enter the block
        synchronized (lock) {
            int currentBalance = safeBalance;

            // The OS STILL pauses the thread here for 1 millisecond!
            // BUT, because it holds the 'lock' key in its pocket while it sleeps,
            // no other thread can enter this block to mess up the data.
            try {
                Thread.sleep(1);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }

            safeBalance = currentBalance + 1;
        } // The thread drops the key here so the next thread can enter
    }

    // ---------------------------------------------------------
    // MAIN METHOD (Let's run 1,000 threads!)
    // ---------------------------------------------------------
    public static void main(String[] args) throws InterruptedException {
        BankSynchronizationDemo bank = new BankSynchronizationDemo();
        int totalDeposits = 1000;

        // We create a Thread Pool with 100 active workers
        ExecutorService threadPool = Executors.newFixedThreadPool(100);
        
        // This is just a countdown timer so the main thread waits for all workers to finish
        CountDownLatch latch = new CountDownLatch(totalDeposits * 2);

        System.out.println("Starting the test. Firing 1,000 threads...");

        for (int i = 0; i < totalDeposits; i++) {
            // Tell the workers to run the unsafe method
            threadPool.submit(() -> {
                bank.depositUnsafe();
                latch.countDown();
            });

            // Tell the workers to run the safe method
            threadPool.submit(() -> {
                bank.depositSafe();
                latch.countDown();
            });
        }

        // Wait here until all 2,000 tasks are done
        latch.await();
        threadPool.shutdown();

        // Print the results
        System.out.println("\n--- FINAL RESULTS ---");
        System.out.println("Expected Balance : 1000");
        System.out.println("Unsafe Balance   : " + bank.unsafeBalance + "  <-- MASSIVE DATA LOSS!");
        System.out.println("Safe Balance     : " + bank.safeBalance + "  <-- PERFECTLY ACCURATE!");
        System.out.println("---------------------");
    }
}
