  const fetchMyBatches = useCallback(async () => {
    setLoading(true);
    try {
      console.log("1. Starting API call to /JS/voucher/all-requests-summary");
      const response = await callApi("/JS/voucher/all-requests-summary", null, "GET");
      console.log("2. Raw API Response:", response);

      // DEFENSIVE EXTRACTION: Handles raw arrays, {data: []}, or {content: []}
      let fetchedRows = [];
      if (Array.isArray(response)) {
        fetchedRows = response;
      } else if (response && Array.isArray(response.data)) {
        fetchedRows = response.data;
      } else if (response && Array.isArray(response.content)) {
        fetchedRows = response.content;
      }
      
      console.log("3. Extracted Rows:", fetchedRows);

      // SAFE MAPPING: Prevent crashes if approvalWorkflow is missing or null
      const uniqueWorkflows = [...new Set(fetchedRows.map(row => row?.approvalWorkflow).filter(Boolean))];
      console.log("4. Unique Workflows to fetch steps for:", uniqueWorkflows);

      const stepsMap = {};
      await Promise.all(
        uniqueWorkflows.map(async (wfCode) => {
          try {
            const stepsResponse = await callApi(`/JS/voucher/workflow/steps/${wfCode}`, null, "GET");
            // Defensively extract steps array
            const steps = Array.isArray(stepsResponse) ? stepsResponse : (stepsResponse?.data || []);
            stepsMap[wfCode] = steps.map(s => s?.designation || s?.state || "Unknown");
          } catch (e) {
            console.warn(`Failed to fetch steps for ${wfCode}`, e);
            stepsMap[wfCode] = ["Creator", "Approver"]; // Fallback
          }
        })
      );

      console.log("5. Final Steps Map:", stepsMap);

      if (isMounted.current) {
        setWorkflowStepsMap(stepsMap);
        setRows(fetchedRows);
      }
    } catch (err) {
      // THIS WILL TELL US EXACTLY WHY IT CRASHED
      console.error("🔥 CATCH BLOCK TRIGGERED. Full Error Object:", err);
      console.error("Error Message:", err.message);
      
      if (isMounted.current && err.name !== "CanceledError") {
        showSnackBar(`Failed to load: ${err.message || "Unknown JS Error"}`, "error");
      }
    } finally {
      if (isMounted.current) setLoading(false);
    }
  }, [callApi, showSnackBar]);
