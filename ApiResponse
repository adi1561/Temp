### 2. Update fetchPendingBatches to be dynamic
Now, we take that dynamic step-mapping logic and put it inside your fetchPendingBatches function.
**FIND your existing fetchPendingBatches and REPLACE it with this:**
```javascript
  const fetchPendingBatches = useCallback(async () => {
    setLoading(true);
    try {
      // 1. Fetch only pending approvals for THIS user's role
      const data = await callApi("/JS/voucher/checker/pending-approvals", null, "GET");
      const fetchedRows = Array.isArray(data) ? data : [];

      // 2. Extract unique workflow codes 
      const uniqueWorkflows = [...new Set(fetchedRows.map(row => row.approvalWorkflow).filter(Boolean))];

      // 3. Dynamically fetch the step configurations for each workflow
      const stepsMap = {};
      await Promise.all(
        uniqueWorkflows.map(async (wfCode) => {
          try {
            const steps = await callApi(`/JS/voucher/workflow/steps/${wfCode}`, null, "GET");
            stepsMap[wfCode] = steps.map(s => s.designation || s.state);
          } catch (e) {
            stepsMap[wfCode] = ["Creator", "Approver"]; // Fallback
          }
        })
      );

      // 4. Update states
      if (isMounted.current) {
        setWorkflowStepsMap(stepsMap);
        setRows(fetchedRows);
      }
    } catch (err) {
      if (isMounted.current && err.name !== "CanceledError")
        showSnackBar("Failed to load requests", "error");
    } finally {
      if (isMounted.current) setLoading(false);
    }
  }, [callApi, showSnackBar]);

```
*(Your existing useEffect for fetchPendingBatches is already perfect, leave it as is!)*
