    public List<Map<String, Object>> getAllRequestsSummary(String userId) {
        String sql = """
            SELECT 
                p.BATCH_ID, 
                p.VID_FK,
                p.CREATED_BY AS CREATOR_ID, 
                COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, p.CREATED_BY) AS CREATOR_NAME,
                p.CREATED_AT AS REQ_DATE, 
                p.RECORDS_COUNT AS TOTAL_ROWS, 
                p.BATCH_STATUS, 
                w.WORKFLOW_STAGE, 
                w.WORKFLOW_CODE,
                w.WORKFLOW_ORDER
            FROM VOUCHER_POSTING p
            LEFT JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            LEFT JOIN USERS u ON p.CREATED_BY = u.USER_ID
            WHERE UPPER(TRIM(p.CREATED_BY)) = UPPER(TRIM(?)) -- SECURITY FIX: Only fetch batches owned by the logged-in user
            ORDER BY p.CREATED_AT DESC
        """;

        return jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("vid", rs.getString("VID_FK"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("creatorName", rs.getString("CREATOR_NAME"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            map.put("workflowState", rs.getString("WORKFLOW_STAGE"));
            map.put("currentOrder", rs.getObject("WORKFLOW_ORDER"));

            String bStatus = rs.getString("BATCH_STATUS");
            map.put("batchStatus", bStatus); // UI FIX: Explicitly send this flag so the frontend triggers the Red Cross

            if ("R".equals(bStatus)) map.put("currentStatus", "REJECTED");
            else if ("A".equals(bStatus) || "C".equals(bStatus)) map.put("currentStatus", "POSTED");
            else map.put("currentStatus", rs.getString("WORKFLOW_STAGE") != null ? rs.getString("WORKFLOW_STAGE") : "PENDING");

            return map;
        }, userId); // Pass the user ID into the SQL query
    }
    /**
     * Validates that the scheduled time is between 30 minutes and 24 hours from now.
     * Includes a 2-minute network buffer to prevent strict boundary rejections.
     */
    public void validateScheduledTime(LocalDateTime scheduledTime) {
        if (scheduledTime == null) return;

        LocalDateTime minTime = LocalDateTime.now().plusMinutes(28);
        LocalDateTime maxTime = LocalDateTime.now().plusHours(24).plusMinutes(2);

        if (scheduledTime.isBefore(minTime)) {
            throw new CustomExceptions.InvalidDataException("Scheduled time must be at least 30 minutes from the current time.");
        }

        if (scheduledTime.isAfter(maxTime)) {
            throw new CustomExceptions.InvalidDataException("Scheduled time cannot exceed 24 hours from the current time.");
        }
    }

    /**
     * Synchronous Validation: Checks rules before allowing deletion.
     */
    @Override
    public void deleteBatchRequest(String batchId, String userId) {
        // 1. Fetch the batch
        VoucherPosting batch = voucherPostingRepository.findById(batchId)
                .orElseThrow(() -> new CustomExceptions.InvalidDataException("Batch not found."));

        // 2. SECURITY CHECK: Only the creator can delete it
        if (!batch.getCreatedBy().equalsIgnoreCase(userId)) {
            log.warn("SECURITY_VIOLATION | User {} attempted to delete batch {} owned by {}", userId, batchId, batch.getCreatedBy());
            throw new IllegalStateException("You do not have permission to delete this batch.");
        }

        // 3. STATE CHECK: Can only delete if it is still PENDING ('P')
        if (!"P".equalsIgnoreCase(batch.getBatchStatus())) {
            throw new IllegalStateException("Only Pending batches can be deleted. Current status: " + batch.getBatchStatus());
        }

        // 4. Update status to QUEUED so nobody else can touch it while it's being deleted
        jdbcTemplate.update("UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'QUEUED' WHERE BATCH_ID = ?", batchId);

        // 5. Hand off to the background thread to do the heavy database deletion
        self.executeAsyncBatchCancellation(batchId, userId);
    }

    @Override
    public boolean isUserAuthorizedForBatch(String batchId, String userId, Integer roleId) {
        // 1. Check if the user is the original Maker (Creator) of the batch
        String creatorSql = "SELECT COUNT(*) FROM VOUCHER_POSTING WHERE BATCH_ID = ? AND CREATED_BY = ?";
        Integer isCreator = jdbcTemplate.queryForObject(creatorSql, Integer.class, batchId, userId);
        if (isCreator != null && isCreator > 0) {
            return true;
        }

        // 2. Check if the user's role is authorized to view this batch in its current workflow stage
        String roleSql = """
            SELECT COUNT(*)
            FROM VOUCHER_POSTING vp
            JOIN WORKFLOW_TRANSITIONS wt ON vp.PENDING_AT = wt.WORKFLOW_ID
            WHERE vp.BATCH_ID = ? AND wt.ALLOWED_ROLE_ID = ?
        """;
        Integer isAuthorizedRole = jdbcTemplate.queryForObject(roleSql, Integer.class, batchId, roleId);

        return isAuthorizedRole != null && isAuthorizedRole > 0;
    }
