                    color="primary"
                    onClick={handleApplySchedule}
                    disabled={!scheduledTime || isApplyingSchedule}
                  >
                    {isApplyingSchedule ? (
                      <CircularProgress size={24} color="inherit" />
                    ) : (
                      "Confirm Schedule"
                    )}
                  </Button>
                </Box>
              </Box>
            )}
          </Paper>
        </Box>
      )}
    </Box>
  );
}




