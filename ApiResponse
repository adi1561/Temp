    /**
     * Safeguard: Forces pagination if batch rows exceed 2000 to avoid Server OOM.
     */
    @GetMapping("/by-batch/{batchId}")
    public ResponseEntity<?> getRequestsByBatchId(@PathVariable String batchId) {
        long count = voucherRequestService.getRequestCountByBatchId(batchId);

        if (count > 2000) {
            log.warn("LARGE_FETCH_BLOCKED | Batch: {} | Rows: {}", batchId, count);
            return ResponseEntity.status(HttpStatus.PAYLOAD_TOO_LARGE).body(Map.of(
                    "error", "Batch too large (" + count + " rows). Please use Paginated API.",
                    "suggestion", "/api/journals/by-batch-paginated/" + batchId
            ));
        }
        return ResponseEntity.ok(voucherRequestService.getRequestsByBatchId(batchId));
    }

