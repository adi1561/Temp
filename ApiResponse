CREATE OR REPLACE PROCEDURE PURGE_JOURNAL_BATCH(
    p_batch_id IN VARCHAR2,
    p_user_id  IN VARCHAR2
) AS
    v_status VARCHAR2(20);
BEGIN
    -- 1. Security + Ownership Check using VOUCHER_POSTING
    BEGIN
        SELECT BATCH_STATUS INTO v_status
        FROM VOUCHER_POSTING
        WHERE BATCH_ID = p_batch_id 
          AND UPPER(TRIM(CREATED_BY)) = UPPER(TRIM(p_user_id));
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE_APPLICATION_ERROR(-20003, 'Batch not found or access denied.');
    END;

    -- Standardized checks for your new short-status codes ('P' = Pending, 'QUEUED', 'ERROR')
    IF v_status NOT IN ('P', 'PENDING', 'QUEUED', 'ERROR') THEN
        RAISE_APPLICATION_ERROR(-20002, 'Cannot delete batch. Status is ' || v_status);
    END IF;

    -- 2. Delete lines from your new row-level table VOUCHER_POSTING_DATA
    DELETE FROM VOUCHER_POSTING_DATA
    WHERE BATCH_ID = p_batch_id
      AND REQ_STATUS IN ('P', 'R');

    -- 3. Delete Parent Batch Record from VOUCHER_POSTING
    DELETE FROM VOUCHER_POSTING WHERE BATCH_ID = p_batch_id;

    -- NO EXPLICIT COMMIT — Spring @Transactional handles it

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END;
/
