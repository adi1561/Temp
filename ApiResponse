Here is the complete React code for the new **Voucher Selection** screen and the exact modifications needed in your **Journal Posting** screen to catch and submit the new data.
### Step 1: Create the New Selection Screen
Create a new file named VoucherSelection.jsx (or .js) in your components folder. This screen fetches the API data, groups it into accordions (exactly like your reference image), allows selection, and handles the scheduling.
**File:** VoucherSelection.jsx
```jsx
import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Card,
  CardContent,
  CardActionArea,
  Grid,
  Chip,
  Button,
  CircularProgress,
  TextField,
  Divider
} from "@mui/material";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import CategoryIcon from "@mui/icons-material/Category";
import ScheduleIcon from "@mui/icons-material/Schedule";
import { useNavigate } from "react-router-dom";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

export default function VoucherSelection() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const navigate = useNavigate();

  const [loading, setLoading] = useState(true);
  const [groupedVouchers, setGroupedVouchers] = useState({});
  const [selectedVid, setSelectedVid] = useState(null);
  const [scheduledTime, setScheduledTime] = useState("");

  useEffect(() => {
    fetchVouchers();
  }, []);

  const fetchVouchers = async () => {
    try {
      setLoading(true);
      // Fetching without filters to get ALL active voucher configs
      const response = await callApi("/api/request-vouchers/filter", null, "GET");
      
      if (response && Array.isArray(response)) {
        // Group the data by category
        const grouped = response.reduce((acc, voucher) => {
          const category = voucher.category || "General";
          if (!acc[category]) {
            acc[category] = [];
          }
          acc[category].push(voucher);
          return acc;
        }, {});
        
        setGroupedVouchers(grouped);
      }
    } catch (error) {
      console.error("Error fetching vouchers:", error);
      showSnackBar("Failed to load voucher categories.", "error");
    } finally {
      setLoading(false);
    }
  };

  const handleProceed = () => {
    if (!selectedVid) {
      showSnackBar("Please select a voucher type first.", "warning");
      return;
    }

    // Format the date for the backend if provided, otherwise null
    let formattedSchedule = null;
    if (scheduledTime) {
       // Assuming backend expects yyyy-MM-dd HH:mm:ss
       const dateObj = new Date(scheduledTime);
       formattedSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    // Navigate to the posting screen and pass the state
    navigate("/journal-posting", {
      state: {
        vid: selectedVid.vid,
        scheduledTime: formattedSchedule,
        voucherDetails: selectedVid // passing full object just in case
      }
    });
  };

  if (loading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '80vh' }}>
        <CircularProgress size={60} />
      </Box>
    );
  }

  return (
    <Box sx={{ p: 3, maxWidth: "1200px", margin: "0 auto" }}>
      <Typography variant="h5" fontWeight="bold" gutterBottom sx={{ mb: 3 }}>
        Select Voucher Type
      </Typography>

      {/* Accordion List grouped by Category */}
      <Box sx={{ mb: 4 }}>
        {Object.entries(groupedVouchers).map(([category, vouchers], index) => (
          <Accordion key={category} defaultExpanded={index === 0} sx={{ mb: 1, borderRadius: 2, '&:before': { display: 'none' }, boxShadow: 1 }}>
            <AccordionSummary expandIcon={<ExpandMoreIcon />} sx={{ backgroundColor: "#f8f9fa", borderRadius: 2 }}>
              <Box sx={{ display: 'flex', alignItems: 'center', width: '100%', justifyContent: 'space-between' }}>
                <Box sx={{ display: 'flex', alignItems: 'center' }}>
                  <CategoryIcon sx={{ mr: 1, color: "text.secondary" }} />
                  <Typography variant="subtitle1" fontWeight="bold">
                    {category}
                  </Typography>
                </Box>
                <Chip label={vouchers.length} size="small" sx={{ fontWeight: 'bold' }} />
              </Box>
            </AccordionSummary>
            <AccordionDetails sx={{ backgroundColor: "#ffffff", pt: 2 }}>
              <Grid container spacing={2}>
                {vouchers.map((voucher) => {
                  const isSelected = selectedVid?.id === voucher.id;
                  return (
                    <Grid item xs={12} sm={6} md={4} key={voucher.id}>
                      <Card 
                        elevation={isSelected ? 4 : 1}
                        sx={{ 
                          border: isSelected ? "2px solid #1976d2" : "1px solid #e0e0e0",
                          backgroundColor: isSelected ? "#f3f8fd" : "#fff",
                          transition: "all 0.2s ease-in-out"
                        }}
                      >
                        <CardActionArea onClick={() => setSelectedVid(voucher)} sx={{ p: 2, height: "100%" }}>
                          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 1 }}>
                            <Typography variant="subtitle1" fontWeight="bold">
                              {voucher.vid}
                            </Typography>
                            <Chip 
                              label={voucher.allowedRole} 
                              size="small" 
                              color={isSelected ? "primary" : "default"}
                              sx={{ fontSize: "0.7rem", height: "20px" }} 
                            />
                          </Box>
                          <Typography variant="body2" color="text.secondary">
                            {voucher.description}
                          </Typography>
                        </CardActionArea>
                      </Card>
                    </Grid>
                  );
                })}
              </Grid>
            </AccordionDetails>
          </Accordion>
        ))}
      </Box>

      <Divider sx={{ my: 3 }} />

      {/* Optional Scheduling Section */}
      <Paper elevation={2} sx={{ p: 3, mb: 3, borderRadius: 2 }}>
        <Typography variant="h6" fontWeight="bold" gutterBottom sx={{ display: 'flex', alignItems: 'center' }}>
          <ScheduleIcon sx={{ mr: 1 }} /> Optional: Schedule Execution
        </Typography>
        <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
          If you want this batch to be posted at a specific future date and time, set it below. Otherwise, leave it blank to post immediately upon final approval.
        </Typography>
        <Box sx={{ maxWidth: 300 }}>
          <TextField
            fullWidth
            type="datetime-local"
            label="Schedule Time"
            InputLabelProps={{ shrink: true }}
            value={scheduledTime}
            onChange={(e) => setScheduledTime(e.target.value)}
            inputProps={{
              // Prevent selecting past dates
              min: new Date().toISOString().slice(0, 16)
            }}
          />
        </Box>
      </Paper>

      {/* Actions */}
      <Box sx={{ display: 'flex', justifyContent: 'flex-end', mt: 3 }}>
        <Button 
          variant="contained" 
          color="primary" 
          size="large"
          onClick={handleProceed}
          disabled={!selectedVid}
          sx={{ px: 5, py: 1.5, borderRadius: 2, fontWeight: 'bold' }}
        >
          Proceed to Data Entry
        </Button>
      </Box>
    </Box>
  );
}

```
