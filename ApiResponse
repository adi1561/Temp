
public class SafeLibraryDemoWithSleep {

    private static final String BOOK_1 = "Java Concurrency";
    private static final String BOOK_2 = "Clean Code";

    public static void main(String[] args) {
        
        // --- STUDENT 1 THREAD ---
        Thread student1 = new Thread(() -> {
            System.out.println("Student 1: Trying to grab " + BOOK_1 + "...");
            synchronized (BOOK_1) {
                System.out.println("Student 1: ✅ Grabbed " + BOOK_1 + ".");
                
                // 1. SIMULATING WORK: Student 1 reads Book 1 for 2 seconds.
                System.out.println("Student 1: 📖 Reading " + BOOK_1 + " for 2 seconds...");
                try { Thread.sleep(2000); } catch (InterruptedException e) {}

                System.out.println("Student 1: Trying to grab " + BOOK_2 + "...");
                synchronized (BOOK_2) {
                    System.out.println("Student 1: ✅ Grabbed " + BOOK_2 + ".");
                    
                    // 2. SIMULATING WORK: Student 1 reads Book 2 for 2 seconds.
                    System.out.println("Student 1: 📖 Reading " + BOOK_2 + " for 2 seconds...");
                    try { Thread.sleep(2000); } catch (InterruptedException e) {}
                    
                    System.out.println("Student 1: Finished reading both! Dropping both locks.");
                } // Drops Book 2
            } // Drops Book 1
        });

        // --- STUDENT 2 THREAD ---
        Thread student2 = new Thread(() -> {
            // Student 2 MUST lock Book 1 first, following our strict rule.
            System.out.println("Student 2: Trying to grab " + BOOK_1 + "...");
            synchronized (BOOK_1) { 
                System.out.println("Student 2: ✅ Grabbed " + BOOK_1 + ".");
                
                // 3. SIMULATING WORK: Student 2 reads Book 1 for 2 seconds.
                System.out.println("Student 2: 📖 Reading " + BOOK_1 + " for 2 seconds...");
                try { Thread.sleep(2000); } catch (InterruptedException e) {}

                System.out.println("Student 2: Trying to grab " + BOOK_2 + "...");
                synchronized (BOOK_2) {
                    System.out.println("Student 2: ✅ Grabbed " + BOOK_2 + ".");
                    
                    // 4. SIMULATING WORK: Student 2 reads Book 2 for 2 seconds.
                    System.out.println("Student 2: 📖 Reading " + BOOK_2 + " for 2 seconds...");
                    try { Thread.sleep(2000); } catch (InterruptedException e) {}
                    
                    System.out.println("Student 2: Finished reading both! Dropping both locks.");
                } // Drops Book 2
            } // Drops Book 1
        });

        student1.start();
        
        // Give Student 1 a tiny head start so they grab the first book first
        try { Thread.sleep(100); } catch (InterruptedException e) {}
        
        student2.start();
    }
}
