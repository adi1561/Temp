    {
      field: "workflowState",
      headerName: "Workflow Progress",
      width: 250,
      align: "center",
      headerAlign: "center",
      disableColumnMenu: true,
      sortable: false,
      renderCell: (params) => {
        const state = params.value || "PENDING_L1";
        const workflow = params.row.approvalWorkflow || "Workflow_3";
        const isRejected = state === "REJECTED";

        if (isRejected) {
          return (
            <Box sx={{ pl: 2, width: '100%', display: 'flex', justifyContent: 'flex-start' }}>
              <Chip label="REJECTED" color="error" size="small" variant="filled" sx={{ mt: 1.5, fontWeight: "bold" }} />
            </Box>
          );
        }

        let stepLabels = ['L1', 'L2', 'L3', 'Final'];
        if (workflow === 'Workflow_4' || workflow === 'W2_4_APPROVERS') {
          stepLabels = ['L1', 'L2', 'L3', 'L4', 'Final'];
        }

        let activeStep = 0;
        if (state.includes("L2")) activeStep = 1;
        else if (state.includes("L3")) activeStep = 2;
        else if (state.includes("L4")) activeStep = 3;

        if (state === "POSTED" || state === "SCHEDULED" || state === "APPROVED") {
          activeStep = stepLabels.length;
        }

        return (
          // pl: 2 adds a fixed left padding so it matches the other columns beautifully
          <Box sx={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'flex-start', pl: 2, height: '100%' }}>
            <Stepper
              activeStep={activeStep}
              alternativeLabel
              connector={<CustomConnector />} 
              sx={{ width: 'auto', mt: 0.5 }} // width: 'auto' stops it from stretching across the cell
            >
              {stepLabels.map((label, index) => {
                const isCompleted = index <= activeStep;
                
                return (
                  <Step 
                    key={label} 
                    completed={isCompleted}
                    // FIX: This forces every single dot to take up exactly 40 pixels. 
                    // This guarantees left-alignment and stops the lines from breaking!
                    sx={{ flex: '0 0 40px', px: 0 }} 
                  >
                    <StepLabel
                      StepIconProps={{
                        sx: {
                          width: 22,
                          height: 22,
                          color: isCompleted ? 'success.main' : 'text.disabled',
                          '&.Mui-completed': { color: 'success.main' },
                          '&.Mui-active': { color: isCompleted ? 'success.main' : 'primary.main' }
                        }
                      }}
                      sx={{ p: 0, m: 0 }} 
                    />
                  </Step>
                );
              })}
            </Stepper>
          </Box>
        );
      },
    },
