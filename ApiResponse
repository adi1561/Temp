package org.example.demo1.Service;

import org.example.demo1.ExceptionHandling.ProductNotFoundException;
import org.example.demo1.Models.Product;
import org.example.demo1.Repository.ProductRepo;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class ProductService {

    @Autowired
    private ProductRepo productRepo;

    // A simple method to simulate buying/finding a product
    public Product findProduct(Long id) {
        return productRepo.findById(id)
                .orElseThrow(() -> new ProductNotFoundException("Product with ID " + id + " not found!"));
    }
    
    // Helper to create dummy data for testing
    public Product createDummyProduct() {
        Product p = new Product();
        p.setName("iPhone 15");
        p.setStock(10);
        p.setPrice(999.99);
        return productRepo.save(p);
    }
}

🛡️ 4. The Safety Net (Global Handler)
Crucial Part: Notice how we wrap the error in ApiResponse so it returns JSON, not a string.
File: org/example/demo1/ExceptionHandling/GlobalExceptionHandler.java
package org.example.demo1.ExceptionHandling;

import org.example.demo1.DTO.ApiResponse;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

@RestControllerAdvice
public class GlobalExceptionHandler {

    @ExceptionHandler(ProductNotFoundException.class)
    public ResponseEntity<ApiResponse<String>> handleProductNotFound(ProductNotFoundException ex) {
        
        // 1. Create the ERROR Box (success = false)
        ApiResponse<String> response = new ApiResponse<>(false, ex.getMessage());

        // 2. Return the Box with 404 Status
        return new ResponseEntity<>(response, HttpStatus.NOT_FOUND);
    }
}

🎮 5. The Controller (The Interface)
Crucial Part: Notice how we wrap the success data in ApiResponse.
File: org/example/demo1/Controller/ProductController.java
package org.example.demo1.Controller;

import org.example.demo1.DTO.ApiResponse;
import org.example.demo1.Models.Product;
import org.example.demo1.Service.ProductService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/product")
public class ProductController {

    @Autowired
    private ProductService productService;

    // Endpoint to create dummy data so we can test
    @PostMapping("/create")
    public ResponseEntity<ApiResponse<Product>> createDummy() {
        Product created = productService.createDummyProduct();
        ApiResponse<Product> response = new ApiResponse<>(true, "Dummy Product Created", created);
        return new ResponseEntity<>(response, HttpStatus.CREATED);
    }

    // The Main Test Endpoint
    @GetMapping("/{id}")
    public ResponseEntity<ApiResponse<Product>> getProduct(@PathVariable Long id) {
        
        // 1. Call Service (May throw exception)
        Product product = productService.findProduct(id);

        // 2. Wrap the Result in the SUCCESS Box
        ApiResponse<Product> response = new ApiResponse<>(true, "Product Found Successfully", product);

        // 3. Return 200 OK
        return new ResponseEntity<>(response, HttpStatus.OK);
    }
}

🧪 How to Test in Postman
Test 1: Create Data (Success)
 * Method: POST
 * URL: http://localhost:8080/product/create
 * Result: You will see success: true and the product data.
Test 2: Find Existing Product (Success)
 * Method: GET
 * URL: http://localhost:8080/product/1
 * Result:
   {
    "success": true,
    "message": "Product Found Successfully",
    "data": { "id": 1, "name": "iPhone 15", ... },
    "timestamp": "..."
}

Test 3: Find Missing Product (Error Handling)
 * Method: GET
 * URL: http://localhost:8080/product/999
 * Result:
   {
    "success": false,
    "message": "Product with ID 999 not found!",
    "data": null,
    "timestamp": "..."
}

See how the JSON structure stays exactly the same? That is Professional Grade API Design. 🚀
