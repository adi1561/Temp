  // Normalize batch state to capture variations ('P' vs 'PENDING')
  // FIX: Only allow deletion if strictly PENDING and no one else has acted on it (history length <= 1).
  // If anyone approves or rejects it, history length becomes > 1, and the button disappears.
  const isBatchDeletable =
    (viewingBatchState?.trim().toUpperCase() === "PENDING" ||
     viewingBatchState?.trim().toUpperCase() === "P") &&
    workflowHistory.length <= 1;
