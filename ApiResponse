                                    ? "warning.main"
                                    : "text.secondary"
                                }
                                fontWeight="bold"
                                sx={{ mt: 1 }}
                              >
                                Pending:{" "}
                                {calculateTimeElapsed(
                                  viewingBatch?.requestDate
                                )}
                              </Typography>
                            )}
                          </StepLabel>
                        </Step>
