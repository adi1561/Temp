    @Override
    public byte[] generateBatchExcel(String batchId) {
        // Fetch all rows belonging to this batch
        List<JournalRequest> requests = journalRequestRepository.findByBatchId(batchId);

        if (requests == null || requests.isEmpty()) {
            throw new CustomExceptions.InvalidDataException("No records found for batch: " + batchId);
        }

        // Use Apache POI to create the Excel file
        try (org.apache.poi.xssf.usermodel.XSSFWorkbook workbook = new org.apache.poi.xssf.usermodel.XSSFWorkbook();
             java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream()) {

            org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch Details");

            // 1. Create Header Row (Product Code BEFORE Remarks)
            org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "Type", "Product Code", "Remarks", "Date"};

            for (int i = 0; i < headers.length; i++) {
                org.apache.poi.ss.usermodel.Cell cell = headerRow.createCell(i);
                cell.setCellValue(headers[i]);
            }

            // 2. Populate Data Rows
            int rowIdx = 1;
            for (JournalRequest req : requests) {
                org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx++);

                row.createCell(0).setCellValue(req.getBranchCode() != null ? req.getBranchCode() : "");
                row.createCell(1).setCellValue(req.getCurrency() != null ? req.getCurrency() : "");
                row.createCell(2).setCellValue(req.getCgl() != null ? req.getCgl() : "");

                BigDecimal amount = req.getAmount();
                if (amount != null) {
                    row.createCell(3).setCellValue(amount.abs().stripTrailingZeros().toPlainString());
                    // Strictly Output Credit / Debit
                    row.createCell(4).setCellValue(amount.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
                } else {
                    row.createCell(3).setCellValue(0);
                    row.createCell(4).setCellValue("");
                }

                // Swapped Sequence: Product is Cell 5, Narration (Remarks) is Cell 6
                row.createCell(5).setCellValue(req.getProductCode() != null ? req.getProductCode() : "");
                row.createCell(6).setCellValue(req.getNarration() != null ? req.getNarration() : "");

                row.createCell(7).setCellValue(req.getPosting_date() != null ? req.getPosting_date().toString() : "");
            }

            workbook.write(out);
            return out.toByteArray();

        } catch (java.io.IOException e) {
            log.error("EXCEL_GEN_ERROR | Batch: {} | Error: {}", batchId, e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Excel file", e);
        }
    }

    @Transactional
    public void processAdvancedApproval(ProcessVoucherRequestDto dto, String executorId, Integer executorRole) {
        String batchId = dto.getBatchId();

        // 1. Fetch the Voucher Posting State
        VoucherPosting posting = voucherPostingRepository.findById(batchId)
                .orElseThrow(() -> new CustomExceptions.InvalidDataException("Batch ID not found in workflow tracking."));

        // 2. Validate Workflow Status
        if (posting.getCurrentStatus().equals("POSTED") || posting.getCurrentStatus().equals("REJECTED") || posting.getCurrentStatus().equals("SCHEDULED")) {
            throw new CustomExceptions.InvalidDataException("This batch is already processed. Current Status: " + posting.getCurrentStatus());
        }

        // 3. Prevent Self-Approval
        if (executorId.equalsIgnoreCase(posting.getCreatedBy())) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You cannot approve a batch you created.");
        }

        // 4. Prevent Duplicate Approvals by the same user
        List<VoucherWorkflow> history = voucherWorkflowRepository.findByBatchIdFkOrderByLastActionAtAsc(batchId);
        boolean hasAlreadyApproved = history.stream()
                .anyMatch(w -> executorId.equalsIgnoreCase(w.getLastActionBy()));
        if (hasAlreadyApproved) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You have already approved this batch at a previous level.");
        }

        // 5. Map the Executor Role ID to Role Name (Adjust IDs to match your DB)
        String roleName = executorRole == 51 ? "TCSGLIF" : (executorRole == 52 ? "SBIGLIF" : "OTHER");

        // 6. Validate Role Authorization for current step
        if (!roleName.equalsIgnoreCase(posting.getNextApproval())) {
            throw new CustomExceptions.InvalidDataException("Unauthorized: Current step requires approval from " + posting.getNextApproval());
        }

        // ==========================================
        // 7. HANDLE REJECTION
        // ==========================================
        if (dto.getStatus() == RequestStatus.REJECTED) {
            posting.setCurrentStatus("REJECTED");
            posting.setNextApproval(null);
            voucherPostingRepository.save(posting);

            logWorkflowAction(batchId, posting.getVidFk(), "REJECTED", executorId, dto.getRemarks(), null);

            // Sync with Legacy Tables
            jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'REJECTED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);
            jdbcTemplate.update("UPDATE JOURNAL_REQUEST SET REQ_STATUS = 'R' WHERE BATCH_ID = ?", batchId);

            notificationWriterService.createBatchRejectedNotification(batchId, posting.getCreatedBy(), executorId, dto.getRemarks());
            return;
        }

        // ==========================================
        // 8. HANDLE APPROVAL STATE MACHINE
        // ==========================================
        boolean isFinalApproval = false;
        String nextState = "";
        String nextRoleRequired = "";

        if ("W1_3_APPROVERS".equals(posting.getApprovalWorkflow())) {
            switch (posting.getCurrentStatus()) {
                case "PENDING_L1": nextState = "PENDING_L2"; nextRoleRequired = "SBIGLIF"; break; // TCS approved, next is SBI
                case "PENDING_L2": nextState = "PENDING_L3"; nextRoleRequired = "SBIGLIF"; break; // SBI approved, next is SBI
                case "PENDING_L3": isFinalApproval = true; break; // Final SBI approval
            }
        } else if ("W2_4_APPROVERS".equals(posting.getApprovalWorkflow())) {
            switch (posting.getCurrentStatus()) {
                case "PENDING_L1": nextState = "PENDING_L2"; nextRoleRequired = "TCSGLIF"; break;
                case "PENDING_L2": nextState = "PENDING_L3"; nextRoleRequired = "SBIGLIF"; break;
                case "PENDING_L3": nextState = "PENDING_L4"; nextRoleRequired = "SBIGLIF"; break;
                case "PENDING_L4": isFinalApproval = true; break;
            }
        }

        // 9. Process Final Approval & Schedule Edge Cases
        if (isFinalApproval) {

            // Check Schedule Time Lapse Edge Case
            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime() != null) {
                if (posting.getScheduledTime().isBefore(LocalDateTime.now())) {

                    // If the user hasn't explicitly overridden the lapse, throw the Conflict exception
                    if (dto.getOverrideScheduleLapse() == null || !dto.getOverrideScheduleLapse()) {
                        throw new CustomExceptions.ScheduleLapsedException("The scheduled execution time has passed. Do you want to post immediately or set a new schedule?");
                    }

                    // If they overrode it, handle their choice
                    if (dto.getNewScheduledTime() != null) {
                        posting.setScheduledTime(dto.getNewScheduledTime());
                        posting.setIsScheduleOverride("YES");
                    } else {
                        // They chose to post immediately, clear the schedule
                        posting.setExecutionScheduled("NO");
                    }
                }
            }

            // Decide Final Execution Path
            if ("YES".equalsIgnoreCase(posting.getExecutionScheduled()) && posting.getScheduledTime().isAfter(LocalDateTime.now())) {
                // Future Schedule
                posting.setCurrentStatus("SCHEDULED");
                posting.setNextApproval(null);
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_SCHEDULED", executorId, dto.getRemarks(), posting.getScheduledTime());

                // Update legacy table
                jdbcTemplate.update("UPDATE JOURNAL_BATCH_MASTER SET BATCH_STATUS = 'SCHEDULED', EXECUTOR_ID = ?, EXECUTOR_REMARKS = ? WHERE BATCH_ID = ?", executorId, dto.getRemarks(), batchId);

            } else {
                // Post Immediately
                posting.setCurrentStatus("POSTED");
                posting.setExecutedAt(LocalDateTime.now());
                posting.setNextApproval(null);
                logWorkflowAction(batchId, posting.getVidFk(), "FINAL_APPROVED_POSTED", executorId, dto.getRemarks(), null);

                // Execute Oracle Procedure via existing async logic
                BulkProcessVoucherPostingDto legacyDto = new BulkProcessVoucherPostingDto();
                legacyDto.setBatchId(batchId);
                legacyDto.setStatus(RequestStatus.ACCEPTED);
                legacyDto.setRemarks(dto.getRemarks());
                this.processBulkRequestsAsync(legacyDto, executorId, executorRole);
            }

            notificationWriterService.createBatchApprovedNotification(batchId, posting.getCreatedBy(), executorId);

        } else {
            // Not final approval, just move to next state
            posting.setCurrentStatus(nextState);
            posting.setNextApproval(nextRoleRequired);
            logWorkflowAction(batchId, posting.getVidFk(), "APPROVED_" + posting.getCurrentStatus(), executorId, dto.getRemarks(), null);

            // Notify next level
            String msg = String.format("Batch %s requires %s approval.", batchId, nextState);
            // Example Notification Route (Update with your actual target role logic)
            String targetRoleIds = "SBIGLIF".equals(nextRoleRequired) ? "52" : "51";
            notificationWriterService.createNotification(null, targetRoleIds, msg, "/journal-view/" + batchId, batchId, "VoucherService");
        }

        voucherPostingRepository.save(posting);
    }

