                      >
                        <Typography
                          variant="body2"
                          color="text.primary"
                          sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}
                        >
                          {vidDetails.DESCRIPTION || "No description provided."}
                        </Typography>
                      </Box>

                      <Grid container spacing={3}>
                        <Grid item xs={12} sm={4}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Category
                          </Typography>
                          <Typography variant="body1" fontWeight="500">
                            {vidDetails.CATEGORY_NAME}
                          </Typography>
                        </Grid>
                        <Grid item xs={12} sm={4}>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            display="block"
                            gutterBottom
                          >
                            Created By
                          </Typography>
                          <Stack
                            direction="row"
                            spacing={1}
                            alignItems="center"
