This is a fantastic UX design decision. Moving the description inside the related card, ensuring the cards are perfectly symmetrical, and creating an inline "sticky" comment box in the footer completely removes the need for annoying popups. It turns your modal into a sleek, single-page review workspace.
Here is how to make all these structural changes seamlessly.
### Step 1: Update the Submit Logic
Since we are removing the popup and making the actions inline inside the View Modal, we need to update the submit function to use the viewingBatchId and accept the action directly from the button click.
Find your handleSubmitAction function and **replace it entirely** with this updated version:
```javascript
  const handleSubmitAction = async (actionStatus, overrideLapse = false) => {
    // If it's a lapse override, we use the saved modalMode, otherwise use the fresh button click
    const statusToSubmit = typeof actionStatus === "string" ? actionStatus : modalMode;

    if (!isRemarksValid(executorRemarks)) {
      showSnackBar("Remarks are compulsory (2-30 chars).", "warning");
      return;
    }
    
    setIsSubmitting(true);
    setModalMode(statusToSubmit); // Save for edge cases like schedule lapse

    let formattedNewSchedule = null;
    if (overrideLapse && newScheduleTime) {
      const dateObj = new Date(newScheduleTime);
      formattedNewSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    try {
      const response = await callApi(
        "/JS/voucher/workflow/action", 
        {
          batchId: viewingBatchId, // Now securely pulls from the currently viewed batch
          status: statusToSubmit,
          remarks: executorRemarks.trim(),
          overrideScheduleLapse: overrideLapse,
          newScheduledTime: formattedNewSchedule
        },
        "POST"
      );

      showSnackBar(response?.message || "Workflow action processed successfully.", "success");

      setIsScheduleLapseModalOpen(false);
      setIsViewModalOpen(false);
      setNewScheduleTime("");
      setExecutorRemarks(""); // Clear remarks on success
      fetchPendingBatches();

    } catch (e) {
      if (e.response && e.response.status === 409) {
        setIsScheduleLapseModalOpen(true);
        setIsSubmitting(false);
        return;
      }

      let errorMsg = "Failed to process request.";
      if (e.response?.data?.message) {
        errorMsg = e.response.data.message;
      } else if (e.message) {
        errorMsg = e.message;
      }
      showSnackBar(errorMsg, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

```
*(Also, find handleCloseViewModal and add setExecutorRemarks(""); inside it so the text box clears out if they close the modal without saving).*
