#### 2. The Ugly Action Toggle Buttons
*This cleans up ~30 lines of inline styling inside the Action Card.*
```javascript
// REPLACE THIS ENTIRE TOGGLE GROUP:
<ToggleButtonGroup
  value={actionSelection}
  exclusive
  onChange={(e, newVal) => {
    if (newVal) setActionSelection(newVal);
  }}
  fullWidth
  sx={{ mb: 4, height: 48 }}
>
  <ToggleButton
    value="ACCEPTED"
    sx={{
      fontWeight: "bold",
      color: actionSelection === "ACCEPTED" ? "white !important" : "success.main",
      backgroundColor: actionSelection === "ACCEPTED" ? "success.main !important" : "transparent",
      borderColor: "success.main",
      "&:hover": {
        backgroundColor: actionSelection === "ACCEPTED" ? "success.dark !important" : "#e8f5e9",
      },
    }}
  >
    <CheckIcon sx={{ mr: 1, fontSize: 20 }} /> Accept
  </ToggleButton>
  <ToggleButton
    value="REJECTED"
    sx={{
      fontWeight: "bold",
      color: actionSelection === "REJECTED" ? "white !important" : "error.main",
      backgroundColor: actionSelection === "REJECTED" ? "error.main !important" : "transparent",
      borderColor: "error.main",
      "&:hover": {
        backgroundColor: actionSelection === "REJECTED" ? "error.dark !important" : "#ffebee",
      },
    }}
  >
    <CloseIcon sx={{ mr: 1, fontSize: 20 }} /> Reject
  </ToggleButton>
</ToggleButtonGroup>

// WITH THIS:
<ToggleButtonGroup
  value={actionSelection}
  exclusive
  onChange={(e, newVal) => {
    if (newVal) setActionSelection(newVal);
  }}
  fullWidth
  sx={jaStyles.toggleGroup}
>
  <ToggleButton value="ACCEPTED" sx={jaStyles.toggleBtn(actionSelection, "ACCEPTED")}>
    <CheckIcon sx={{ mr: 1, fontSize: 20 }} /> Accept
  </ToggleButton>
  <ToggleButton value="REJECTED" sx={jaStyles.toggleBtn(actionSelection, "REJECTED")}>
    <CloseIcon sx={{ mr: 1, fontSize: 20 }} /> Reject
  </ToggleButton>
</ToggleButtonGroup>

