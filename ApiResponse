            {/* --- WRAPPER TO FORCE SINGLE-LINE HORIZONTAL LAYOUT --- */}
            <Box sx={{ mt: 2, overflowX: "auto", width: "100%", pb: 2 }}>
              <Box sx={{ minWidth: 1100 }}> {/* Minimum width ensures fields are never squished */}
                
                {rows.map((row, index) => {
                  const isINR = row.currency === "INR";
                  const amountRegex = isINR ? /^\d{0,16}(\.\d{0,2})?$/ : /^\d{0,16}(\.\d{0,4})?$/;

                  return (
                    <React.Fragment key={row.id}>
                      {/* wrap="nowrap" and xs={...} guarantees it stays on one line forever */}
                      <Grid container spacing={1.5} alignItems="flex-start" columns={24} wrap="nowrap">
                        
                        {/* Branch (6 chars -> xs=3) */}
                        <Grid item xs={3}>
                          <Autocomplete
                            popupIcon={null} autoHighlight options={branchSearch.options}
                            getOptionLabel={(option) => option && option.code ? `${option.code} - ${option.name}` : ""}
                            value={row.branch || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
                            inputValue={branchInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(BRANCH_REPLACE_REGEX, "").substring(0, 6);
                                setBranchInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchBranches(cleanInput, row.id);
                              } else {
                                setBranchInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            loading={branchSearch.loadingId === row.id} filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => option?.code === value?.code}
                            noOptionsText={(branchInputValues[row.id] || "").length < 3 ? "Enter 3 digits" : "No Branch"}
                            renderInput={(params) => (
                              <Tooltip title="Search by Branch Code" placement="top-start">
                                <TextField {...params} label="Branch *" placeholder="Code..." InputLabelProps={{ shrink: true }} 
                                  // Forces ellipses (...) so long names never stretch the box
                                  inputProps={{ ...params.inputProps, style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' } }}
                                  InputProps={{ ...params.InputProps, endAdornment: (<Box>{branchSearch.loadingId === row.id ? (<CircularProgress color="inherit" size={20} />) : null}{params.InputProps.endAdornment}</Box>) }} />
                              </Tooltip>
                            )}
                          />
                          <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                            Max 6 chars
                          </Typography>
                        </Grid>

                        {/* Currency (4 chars -> xs=2) */}
                        <Grid item xs={2}>
                          <TextField
                            select label="Curr *" value={row.currency} fullWidth InputLabelProps={{ shrink: true }}
                            onChange={(e) => { handleRowChange(row.id, "currency", e.target.value); handleRowChange(row.id, "amount", ""); }}
                            SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Curr</span> : selected, MenuProps: { PaperProps: { style: { maxHeight: 250 } } } }}
                          >
                            {currencyOptions.map((c) => (<MenuItem key={c} value={c}>{c}</MenuItem>))}
                          </TextField>
                        </Grid>

                        {/* CGL (11 digits -> xs=4) */}
                        <Grid item xs={4}>
                          <Autocomplete
                            popupIcon={null} autoHighlight options={cglSearch.options}
                            getOptionLabel={(option) => option && option.cglNumber ? `${option.cglNumber} - ${option.description}` : ""}
                            value={row.cgl || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                            inputValue={cglInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(CGL_REPLACE_REGEX, "").substring(0, 11);
                                setCglInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchCgls(cleanInput, row.id);
                              } else {
                                setCglInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            loading={cglSearch.loadingId === row.id} filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => option?.cglNumber === value?.cglNumber}
                            noOptionsText={(cglInputValues[row.id] || "").length < 3 ? "Enter 3 digits..." : "No CGL"}
                            renderInput={(params) => (
                              <Tooltip title="Search by CGL Number" placement="top-start">
                                <TextField {...params} label="CGL *" placeholder="Search..." InputLabelProps={{ shrink: true }} 
                                  inputProps={{ ...params.inputProps, style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' } }}
                                  InputProps={{ ...params.InputProps, endAdornment: (<Box sx={{ marginLeft: "2%", display: "flex", alignItems: "center" }}>{row.cgl && String(row.cgl.cglNumber).startsWith("5") && (<Chip label="MEMO" size="small" color="warning" sx={{ height: 20, fontSize: "0.7rem", mr: 1 }} />)}{cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}{params.InputProps.endAdornment}</Box>) }} />
                              </Tooltip>
                            )}
                          />
                          <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                            Max 11 digits
                          </Typography>
                        </Grid>

                        {/* Amount (16.4 -> xs=4) */}
                        <Grid item xs={4}>
                          <TextField
                            label="Amount *" type="text" value={row.amount} InputLabelProps={{ shrink: true }} disabled={!row.currency} fullWidth placeholder={isINR ? "0.00" : "0.0000"} inputProps={{ style: { textAlign: "right" } }}
                            onChange={(e) => {
                              const rawVal = e.target.value;
                              if (/[^0-9.]/.test(rawVal)) {
                                showSnackBar("Only numbers and decimal point are allowed.", "warning"); return;
                              }
                              if (rawVal === "" || amountRegex.test(rawVal)) { handleRowChange(row.id, "amount", rawVal); }
                              else { showSnackBar("Exceeded maximum digits or decimal places.", "warning"); }
                            }}
                          />
                          <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>
                            {isINR ? "Max 16.2 dec" : "Max 16.4 dec"}
                          </Typography>
                        </Grid>

                        {/* Txn Type (xs=2) */}
                        <Grid item xs={2}>
                          <TextField select label="Type *" value={row.txnType} fullWidth InputLabelProps={{ shrink: true }} onChange={(e) => handleRowChange(row.id, "txnType", e.target.value)} SelectProps={{ displayEmpty: true, renderValue: (selected) => !selected ? <span style={{ color: 'gray', opacity: 0.8 }}>Type</span> : selected }}>
                            <MenuItem value="Debit">Debit</MenuItem>
                            <MenuItem value="Credit">Credit</MenuItem>
                          </TextField>
                        </Grid>

                        {/* Product Code (6 chars -> xs=2) */}
                        <Grid item xs={2}>
                          <TextField label="Prod Code" value={row.productCode} InputLabelProps={{ shrink: true }} placeholder="Code.." fullWidth 
                            inputProps={{ maxLength: 6 }}
                            onChange={(e) => { const rawVal = e.target.value; const cleanVal = rawVal.replace(/[^0-9]/g, ""); if (rawVal !== cleanVal) { showSnackBar("Only digits are allowed.", "warning"); } if (cleanVal.length <= 6) { handleRowChange(row.id, "productCode", cleanVal); } }} />
                          <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", mt: 0.5, ml: 1.2, display: "block" }}>Max 6 digits</Typography>
                        </Grid>

                        {/* Remarks (Remaining -> xs=6) */}
                        <Grid item xs={6}>
                          <TextField label="Remarks *" value={row.remarks} InputLabelProps={{ shrink: true }} placeholder="Remarks..." fullWidth inputProps={{ maxLength: 30 }} disabled={checked} error={row.remarks.length > 0 && !isRowRemarksValid(row.remarks)} onChange={(e) => { const val = filterAndWarn(e.target.value, "alphanumeric_space"); if (val.length <= 30) { handleRowChange(row.id, "remarks", val); } }} />
                          <Typography variant="caption" sx={{ fontSize: "0.65rem", color: "text.secondary", ml: 1.2, display: "block", textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>Allowed 2-30 chars</Typography>
                        </Grid>

                        {/* Delete Action (xs=1) */}
                        <Grid item xs={1} sx={{ textAlign: "center", pt: 1 }}>
                          <Tooltip title="Delete row" arrow>
                            <IconButton onClick={() => handleDeleteRow(row.id)} aria-label="delete row" sx={{ color: "inherit", "&:hover": { color: "error.main", backgroundColor: "action.hover" } }}>
                              <DeleteIcon />
                            </IconButton>
                          </Tooltip>
                        </Grid>
                      </Grid>

                      {index < rows.length - 1 && (<Box sx={{ borderBottom: 1, borderColor: "divider", my: 2 }} />)}
                    </React.Fragment>
                  );
                })}
              </Box>
            </Box>

            {/* ACTION BUTTONS (Keep this exactly where it is) */}
            <Box sx={{ mt: 3, display: "flex", gap: 2, justifyContent: "right" }}>
