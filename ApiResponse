                          </Typography>
                        </Grid>
                        <Grid item xs={12} sm={4}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Origin Created By</Typography>
                          <Stack direction="row" spacing={1} alignItems="center">
                            <AccountCircleIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                            <Typography variant="body1" fontWeight="500">
                              {vidDetails.VID_CREATED_BY_NAME} <Typography component="span" variant="caption" color="text.secondary">({vidDetails.VID_CREATOR_ID})</Typography>
                            </Typography>
                          </Stack>
                        </Grid>
                      </Grid>
                      <Box sx={{ backgroundColor: "background.paper", p: 2, borderRadius: 1, border: "1px solid", borderColor: "divider" }}>
                        <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Voucher Description</Typography>
                        <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>
                          {vidDetails.DESCRIPTION && vidDetails.DESCRIPTION.length > 250 && !isDescExpanded
                            ? `${vidDetails.DESCRIPTION.substring(0, 250)}...` : (vidDetails.DESCRIPTION || "No description provided.")}
                        </Typography>
                        {vidDetails.DESCRIPTION && vidDetails.DESCRIPTION.length > 250 && (
                          <Box sx={{ mt: 1 }}>
                            <Button variant="text" color="primary" disableRipple onClick={() => setIsDescExpanded(!isDescExpanded)} sx={{ textTransform: 'none', p: 0, fontWeight: 'bold' }}>
                              {isDescExpanded ? "Show Less" : "Show More"}
                            </Button>
                          </Box>
                        )}
                      </Box>
                    </Paper>
                  </Grid>

                  {/* Batch Execution Details */}
                  <Grid item xs={12}>
                    <Paper elevation={0} sx={{ p: 3, backgroundColor: "#f8fafc", borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
                      <Typography variant="subtitle1" fontWeight="bold" color="text.primary" gutterBottom sx={{ borderBottom: "1px solid", borderColor: "divider", pb: 1, mb: 2 }}>
                        Batch Execution Details
                      </Typography>
                      <Grid container spacing={3}>
                        <Grid item xs={12} sm={3}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Created By</Typography>
                          <Stack direction="row" spacing={1} alignItems="center">
                            <AccountCircleIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                            <Typography variant="body1" fontWeight="500">
                              {vidDetails.BATCH_CREATED_BY_NAME} <Typography component="span" variant="caption" color="text.secondary">({vidDetails.BATCH_CREATOR_ID})</Typography>
                            </Typography>
                          </Stack>
                        </Grid>
                        <Grid item xs={12} sm={3}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Created At</Typography>
                          <Typography variant="body1" fontWeight="500">
                            {vidDetails.BATCH_CREATED_AT ? new Date(vidDetails.BATCH_CREATED_AT).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" }) : "N/A"}
                          </Typography>
                        </Grid>

                         {/* No. of Entries Column */}
                        <Grid item xs={12} sm={2}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>No. of Entries</Typography>
                          <Typography variant="body1" fontWeight="600" color="primary.main">
                            {viewingBatchRequestCount} Records
                          </Typography>
                        </Grid>
                        <Grid item xs={12} sm={3}>
                          <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Scheduled Time</Typography>
                          <Typography variant="body1" fontWeight="500" color={vidDetails.SCHEDULED_TIME ? "info.main" : "text.primary"}>
                            {vidDetails.SCHEDULED_TIME ? new Date(vidDetails.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" }) : "Immediate"}
                          </Typography>
                        </Grid>
                        {vidDetails.EXECUTED_AT && (
                          <Grid item xs={12} sm={3}>
                            <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Executed At</Typography>
                            <Typography variant="body1" fontWeight="500" color="success.main">
                              {new Date(vidDetails.EXECUTED_AT).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}
                            </Typography>
                          </Grid>
                        )}
                      </Grid>
                      <Box sx={{ mt: 3, pt: 2, borderTop: "1px solid", borderColor: "divider", display: "flex", justifyContent: "flex-end" }}>
                        <Button variant="outlined" startIcon={<FileDownloadIcon />} onClick={handleDownloadExcel} disabled={!viewingBatchId} sx={{ borderColor: "#217346", color: "#217346", "&:hover": { backgroundColor: "#e8f5e9", borderColor: "#1e6b40" } }}>
                          Download Full Batch Report
                        </Button>
                      </Box>
                    </Paper>
                  </Grid>
                </Grid>
              ) : null}
            </Box>

            {/* --- BIG WORKFLOW STEPPER TIMELINE --- */}
            <Box sx={{ p: 4, flexGrow: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
              {viewingBatchState === "REJECTED" ? (
                <Typography color="error" variant="subtitle1" fontWeight="bold" textAlign="center" sx={{ mt: 2 }}>
                  This batch was REJECTED and the workflow has been terminated.
                </Typography>
              ) : isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 3 }}><CircularProgress /></Box>
              ) : dynamicSteps.length > 0 ? (
                <Stepper
                  activeStep={(viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED") ? dynamicSteps.length : dynamicSteps.findIndex(s => s.state === viewingBatchState)}
                  alternativeLabel connector={<CustomConnector />}
                >
                  {dynamicSteps.map((step, index) => {
                    const isFullyDone = viewingBatchState === "POSTED" || viewingBatchState === "SCHEDULED" || viewingBatchState === "APPROVED";
                    const activeStepIndex = isFullyDone ? dynamicSteps.length : dynamicSteps.findIndex(s => s.state === viewingBatchState);
                    const isCompleted = index < activeStepIndex;
                    const isCurrent = index === activeStepIndex;

                    return (
                      <Step key={step.state} completed={isCompleted} active={isCurrent}>
                        <StepLabel StepIconComponent={CustomWorkflowIcon}>
                          <Typography variant="subtitle2" sx={{ fontWeight: isCurrent ? 'bold' : 'normal', color: isCurrent ? 'primary.main' : 'text.primary', mt: 1 }}>{step.designation}</Typography>
                          <Chip label={getRoleDisplayName(step.role)} size="small" variant={isCurrent ? "filled" : "outlined"} color={isCurrent ? "primary" : "default"} sx={{ mt: 1, height: 22, fontSize: "0.65rem", fontWeight: "bold" }} />
                        </StepLabel>
                      </Step>
                    );
                  })}
                </Stepper>
              ) : null}
            </Box>

            {/* --- WORKFLOW ACTION HISTORY --- */}
            <Box sx={{ p: 4, borderTop: "1px solid", borderColor: "divider" }}>
              <Typography variant="subtitle1" fontWeight="bold" color="text.primary" sx={{ mb: 3 }}>
                Action History & Remarks ({workflowHistory.length})
              </Typography>

              {isFetchingSteps ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', p: 2 }}><CircularProgress size={24} /></Box>
              ) : workflowHistory.length === 0 ? (
                <Typography color="text.secondary">No action history found for this batch.</Typography>
              ) : (
                <Stack spacing={2.5}>
                 {workflowHistory.map((history, idx) => {
                    const userName = history.ACTION_USER_NAME || "User";
                    const initial = userName.charAt(0).toUpperCase();
                    // Check if this action was an override
                    const isOverrideAction = history.LAST_ACTION?.toUpperCase().includes("OVERRIDE");

                    return (
                      <Box key={idx} sx={{ display: 'flex', gap: 2 }}>
                         <Box><Avatar sx={{ bgcolor: 'primary.main', width: 40, height: 40, fontWeight: 'bold', fontSize: '1rem' }}>{initial}</Avatar></Box>
                         <Box sx={{ flexGrow: 1, backgroundColor: "white", p: 2.5, borderRadius: 2, border: "1px solid", borderColor: "#e2e8f0", boxShadow: "0 1px 2px 0 rgb(0 0 0 / 0.05)" }}>
                            <Box sx={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 1, mb: 1 }}>
                              <Typography variant="subtitle2" fontWeight="bold" color="text.primary">{userName}</Typography>
                              <Typography variant="caption" color="text.secondary">• {new Date(history.LAST_ACTION_AT).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}</Typography>
                            </Box>
                            
                            <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 1.5, flexWrap: 'wrap', gap: 1 }}>
                              <Chip label={history.LAST_ACTION || "System Action"} size="small" sx={{ height: 22, fontSize: "0.7rem", fontWeight: "bold", backgroundColor: history.LAST_ACTION?.includes("Reject") ? "#fee2e2" : "#e0e7ff", color: history.LAST_ACTION?.includes("Reject") ? "#991b1b" : "#3730a3" }} />
                              
                              {/* Display active routing alerts when schedules are loaded or changed */}
                              {history.SCHEDULED_TIME && (
                                <Chip 
                                  label={isOverrideAction ? `?? Schedule Overridden to: ${new Date(history.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}` : `? Scheduled for: ${new Date(history.SCHEDULED_TIME).toLocaleString("en-IN", { dateStyle: "short", timeStyle: "short" })}`}
                                  size="small"
                                  color={isOverrideAction ? "warning" : "info"}
                                  variant="outlined"
                                  sx={{ height: 22, fontSize: "0.7rem", fontWeight: "bold" }}
                                />
                              )}
                            </Stack>

                            <Typography variant="body2" color="text.primary" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>{history.REMARKS || "No remarks provided."}</Typography>
                         </Box>
                      </Box>
                    );
                  })}
                </Stack>
              )}
            </Box>
          </Box>
        </DialogContent>
      </Dialog>
    </Box>
  );
}


