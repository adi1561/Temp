        </Box>
      </Tooltip>
    );
  }
  if (statusFlag === 'ACTIVE') {
    return (
      <Box sx={{ ...baseStyle, backgroundColor: 'white', border: '3px solid', borderColor: 'warning.main', color: 'warning.main' }}>
        {showTextInside ? label : iconLetter}
      </Box>
    );
  }
  return <Box sx={{ ...baseStyle, backgroundColor: '#e2e8f0', color: '#64748b' }}>{iconLetter}</Box>;
